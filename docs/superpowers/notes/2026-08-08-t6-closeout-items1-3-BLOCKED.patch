diff --git a/engine/level/page_cache.emp b/engine/level/page_cache.emp
index ba359ce..7f5214d 100644
--- a/engine/level/page_cache.emp
+++ b/engine/level/page_cache.emp
@@ -283,6 +283,7 @@ pub proc PageCache_Publish (d0: u16, d1: u8) clobbers(d0-d2/a0/a3) {
         // them); LruLinkTail OWNS setting PF_IN_LRU as it links — never set it here
         // (that split ownership was the Task-6 boot audit failure).
         clr.b   PF_FLAGS(a3, d2.w)             // defensive: guarantee no stale PF_PINNED
+        moveq   #0, d0                          // zero-extend: d1's upper byte is stale (see above)
         move.b  d1, d0                          // LruLinkTail takes frame in d0
         jbra    PageCache_LruLinkTail          // links + sets PF_IN_LRU atomically
 }
diff --git a/engine/level/page_in.emp b/engine/level/page_in.emp
index 2ba4550..25661e1 100644
--- a/engine/level/page_in.emp
+++ b/engine/level/page_in.emp
@@ -386,6 +386,19 @@ pub proc PageIn_Flush () clobbers() {
         clr.b   PageIn_InFlight
         clr.b   PageIn_Land_Pending
         clr.b   PageIn_Queue_Count
+        // Clear the request-FIFO dedupe bitset: a flush cancels the queue, so a
+        // stale queued bit would block a later re-request of that page. Done here
+        // (not just in PageCache_Init) because Task-4 callers issue bare flushes.
+        // Register-free absolute clears keep this proc's clobbers() == none.
+        // Page_Queued_Bits is PAGE_TABLE_MAX/8 = 32 bytes (8 longs), long-aligned.
+        clr.l   Page_Queued_Bits
+        clr.l   Page_Queued_Bits+4
+        clr.l   Page_Queued_Bits+8
+        clr.l   Page_Queued_Bits+12
+        clr.l   Page_Queued_Bits+16
+        clr.l   Page_Queued_Bits+20
+        clr.l   Page_Queued_Bits+24
+        clr.l   Page_Queued_Bits+28
     if DEBUG == 1 {
         addq.w  #1, Dbg_PageIn_Flushes
     }
