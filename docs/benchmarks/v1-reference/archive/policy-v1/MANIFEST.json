 "schema": {
  "coverage": "leg_drive.coverage(leg, status, drive rows, listing equates) computed at record time from the drive's own rows (which carry gspeed and player state, not kept in the frame rows); met=false is DID NOT COVER",
  "fb": "the framebuffer digest of the state_hash method with includeFramebuffer:true (FNV-1a-64 of RGB); framebufferSource must be 'raster' on every row or the recording is refused",
  "framebuffer_source": "raster",
  "identical_to": "set when this entry's inputs and frames sha256 both equal an earlier leg's of the same shape (computed, never typed)",
  "lag_before": "dFrame_Counter - dLogic_Tick into this tick",
  "ram_blocks": {
   "game_ram": [
    "Engine_RAM_End",
    "Game_RAM_End"
   ],
   "obj_ram": [
    "Object_RAM",
    "Object_RAM_End"
   ]
  },
  "ram_hash": "the fnv1a64 of the memory_hash method over {symbol, len}",
  "raw_hashes": [
   "fb",
   "vdp",
   "obj_ram",
   "game_ram"
  ],
  "row_fields": [
   "tick",
   "held",
   "fb",
   "vdp",
   "obj_ram",
   "game_ram",
   "px",
   "py",
   "xvel",
   "yvel",
   "status",
   "cx",
   "cy",
   "lag_before"
  ],
  "semantic": [
   "held",
   "px",
   "py",
   "xvel",
   "yvel",
   "status",
   "cx",
   "cy",
   "lag_before"
  ],
  "status": "the leader's SST status byte (raw); bit n is set when the named flag is",
  "status_bits": {
   "ST_IN_AIR": 3,
   "ST_ON_OBJECT": 5,
   "ST_PUSHING": 6,
   "ST_ROLLING": 4,
   "ST_UNDERWATER": 7,
   "ST_XFLIP": 1,
   "ST_YFLIP": 2
  },
  "tick": "Logic_Tick at the Input_Tick hit; held = the byte written at that hit",
  "v2_comparable": "fb is the ONE raw hash a v2 engine can be compared on: it is the picture, independent of RAM and VRAM layout. vdp, obj_ram and game_ram are same-layout regression only; across layouts diff the SEMANTIC fields (--semantic), optionally plus fb",
  "vdp": "the combined digest of the state_hash method",
  "what": "v1 behaviour reference (Empyrean v2 E1), tools/v1_reference.py"
 },
