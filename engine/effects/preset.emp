// engine/effects/preset.emp — EffectsPreset: one struct naming every visual-effect
// channel a level section binds (palette, parallax, raster program, a "patched"
// template, cycling script, palette variants).
//
// A later task writes Effects_InstallPreset, which sets EVERY channel on section
// entry — TOTAL BINDING. That replaces three legacy installers that each did "0
// means keep whatever the last section had", a semantic that lets water render at
// a stale line forever after one crossing (the section that turned it on is long
// gone, but nothing ever turns it back off).
//
// This module is a TYPE-ONLY twin, same precedent as engine.objects.sst / Sst and
// engine.objects.entity_window / EntityScanState: it emits ZERO bytes (no section,
// no placement). EffectsPreset is read at runtime by a later task (through
// Sec.sec_effects, engine/structs.emp:124), so — matching pal_variant
// (engine/effects/palette.emp:126) and RasterGradientProgram (engine/effects/
// raster.emp:279) — the wire-format struct and its comptime constructor both live
// HERE in the CODE module, not in a *_dsl helper. Consumers import explicitly:
// `use engine.effects.preset.{EffectsPreset, preset}`.
//
// Design: docs/superpowers/2026-08-11-effects-suite-design.md §5.
module engine.effects.preset in preset

use engine.effects.palette.{PAL_MAX_VARIANTS}
use engine.structs.{Sec, Act}

// Field order deliberately avoids an odd run of u8 before a pointer — sigil does
// NOT auto-align, and even alignment is all the 68000 needs.
pub struct EffectsPreset (size: 36) {
    ep_pal:            *u8      @ $00,   // required; the preset CARRIES the palette
    ep_parallax:       *u8      @ $04,   // 0 = act default (the one legal 0)
    ep_raster:         *u8      @ $08,   // static program; 0 illegal, use Raster_Program_None
    ep_patched:        *u8      @ $0C,   // patched template (water / world-anchored gradient); 0 = none
    ep_cycle:          *u8      @ $10,   // 0 illegal, use Pal_Cycle_None
    ep_variants:       [*u8; 2] @ $14,   // PAL_MAX_VARIANTS; unused slots 0 = clear
    ep_patch_world_y:  u16      @ $1C,   // meaningful only when ep_patched != 0
    ep_transition:     u16      @ $1E,   // cross-fade arm; unused by every C2 fixture
}

// ⚠ THE TOP-LEVEL `ensure` BELOW IS CURRENTLY DEAD, AND THAT IS MEASURED, NOT FEARED.
//
// This module is parsed but NOT EVALUATED while nothing references it. Measured
// 2026-08-14, on this file, with all four shapes building clean throughout:
//
//   * `ensure(PAL_MAX_VARIANTS == 99, ...)` — two comptime ints, trivially FALSE —
//     BUILT SUCCESSFULLY. So it is not that the predicate is subtle; no top-level
//     `ensure` here is evaluated at all.
//   * A deliberate syntax error in this same file DID fail the build, so the file is
//     genuinely parsed. Parsed, not evaluated.
//
// RE-VERIFIED Task 8, still on this file, after Effects_InstallPreset existed AND
// "Effects_InstallPreset" was added to games/sonic4/map.toml's `order` array: the
// `== 99` inversion STILL built clean (`sigil build`'s own `module.unreachable`
// warning names this file explicitly: "module engine.effects.preset is outside
// this profile's use closure, so its 1 ensure guard(s) are never evaluated for
// this target"). So `order` placement is NOT what reachability means here —
// `order` only says where a module's bytes land IF it is lowered; a module is
// lowered only once something in the `use` closure actually `use`s it. Nothing
// does yet: Effects_InstallPreset exists and compiles but is uncalled, so no
// reachable module names `engine.effects.preset`. It comes alive at Task 9, when
// the crossing site adds `use engine.effects.preset.{...}` and calls
// Effects_InstallPreset. **Re-run the inversion probe then**: flip the `== 2` to
// `== 99`, confirm the build FAILS, flip it back. Until someone does that, treat
// this guard as documentation.
//
// `preset()`'s OWN ensures are a different story and ARE live: they were verified at
// authoring time by deliberately violating each one from a real call site in
// configs.emp and confirming the build failed with the intended message. A comptime
// fn's body evaluates where it is CALLED, so it does not share this module's problem.
//
// A witness for the Label-vs-int comparison the exclusivity ensure depends on was
// attempted here and REMOVED: `ensure(Raster_Program_None != 0, ...)` and its exact
// inverse `== 0` BOTH built clean, so an `ensure` comparing an imported data symbol
// to an integer is unevaluable and silently always-passes. That construct is a
// vacuous-guard generator; do not reach for it. The live proof of that mechanism
// remains the call-site violation probe described above.
//
// PAL_MAX_VARIANTS cannot be raised past 2 without a fix first: palette.emp's
// `andi.w #(PAL_MAX_VARIANTS - 1), d0` (Palette_SetVariant) is a power-of-two mask,
// so 3 would silently fold slot 2 onto slot 0 — and ep_variants's fixed [*u8; 2]
// shape would go stale under that raise too.
ensure(PAL_MAX_VARIANTS == 2,
       "EffectsPreset spells ep_variants as [*u8; 2]; palette.emp's andi.w #(PAL_MAX_VARIANTS-1) mask is power-of-two only, so raising this needs that mask fixed FIRST")

// preset() — build an EffectsPreset. `pal` is required (the preset always carries a
// palette); everything else defaults to 0/none.
pub comptime fn preset(pal: Label, parallax: Label = 0, raster: Label = 0,
                       patched: Label = 0, cycle: Label = 0,
                       variants: [Label; 2] = [0, 0],
                       patch_world_y: int = 0, transition: int = 0) -> EffectsPreset {
    // ep_raster and ep_patched are mutually exclusive. Whichever installs last wins
    // DESTRUCTIVELY: Raster_InstallWater clears Raster_Pending (killing a staged
    // static program), and the reverse order lets VBlank re-point Active_Buf at
    // Buf_A while the patch keeps writing Buf_B.
    ensure(raster == 0 || patched == 0,
           "preset(): ep_raster and ep_patched are mutually exclusive. Whichever installs last wins DESTRUCTIVELY — Raster_InstallWater clears Raster_Pending (killing a staged static program), and the reverse order lets VBlank re-point Active_Buf at Buf_A while the patch keeps writing Buf_B.")
    ensure(patched != 0 || patch_world_y == 0,
           "preset(): patch_world_y is meaningful only with a patched template")
    return EffectsPreset{ ep_pal: pal, ep_parallax: parallax, ep_raster: raster,
                          ep_patched: patched, ep_cycle: cycle, ep_variants: variants,
                          ep_patch_world_y: patch_world_y, ep_transition: transition }
}

// Displacements into ep_variants[0]/[1] — PAL_MAX_VARIANTS is locked to 2 by the
// ensure() above, so a fixed pair of named offsets (rather than an indexed loop)
// matches how Palette_SetVariant's own slot pair is spelled.
const EP_VARIANT_0 = offsetof(EffectsPreset, ep_variants)
const EP_VARIANT_1 = EP_VARIANT_0 + 4

// -----------------------------------------------
// Effects_InstallPreset — TOTAL BINDING. Replaces the three legacy per-channel
// installers (Palette_LoadSection / Palette_InstallCycleSection /
// Raster_InstallSection), each of which read a NULL descriptor field as "keep
// whatever the previous section had". A preset instead names EVERY channel,
// using explicit _None sentinels to mean "off" — the semantic that stops water
// (or any other effect) installed by one section from surviving forever past the
// section that turned it on.
//
//   a0 = Sec*   (sec_effects is known non-zero — the caller already checked)
//
// Returns (a0) = the resolved parallax config pointer: ep_parallax, or the act
// default when ep_parallax is 0 — mirrors the fallback parallax.emp:194-199 does
// today. Returning the pointer rather than tail-calling Parallax_StartTransition
// ourselves keeps the dependency one-way (parallax -> preset -> palette/raster);
// the caller (the crossing site, Task 9) makes that tail call.
//
// Register hazard: Palette_LoadPal's own clobber list includes a2 (d1/a1-a2), so
// the preset pointer is held in a3 instead — the only address register none of
// the six callees below (Palette_ArmFade/LoadPal/LoadCycle/SetVariant,
// Raster_Install/InstallPatchedWorldY) clobber.
//
// Order is load-bearing:
//   1. ep_transition -> Palette_ArmFade BEFORE the palette load. Pal_Fade_Request
//      is one-shot, consumed by Palette_LoadPal; arming after the load would
//      apply to the NEXT crossing instead of this one.
//   2. ep_raster / ep_patched are mutually exclusive (enforced at comptime by
//      preset()'s own ensure). ep_raster == 0 in a present preset means OFF
//      (Raster_Program_None), NEVER "keep" — Raster_Install(0) stages
//      Raster_Pending = 0, which Raster_VBlank reads as "no install this frame",
//      i.e. keep whatever program is already live. That is the exact stale-water
//      defect this parcel exists to remove, so a bare 0 is redirected to the
//      explicit off program rather than passed through.
//
// Everything else is a straight write: ep_pal -> Palette_LoadPal, ep_cycle ->
// Palette_LoadCycle (its own a0=0 path already turns cycling off cleanly, so no
// redirect is needed there), ep_variants[i] -> Palette_SetVariant(slot i, ptr).
//
// Variant guard (required, not an optimisation): Palette_SetVariant sets
// PAL_ACT_VARIANT_STALE on EVERY call, even a rebind to an identical pointer,
// forcing a full variant re-derive measured at ~19,332 cycles (15.1% of a frame).
// Both sibling installers already guard this way — Raster_InstallSection
// (`cmp.l Raster_Program, d0 / beq .keep`) and Palette_InstallCycleSection
// (`cmp.l Pal_Cycle_Script, d0 / beq .keep`) — so each slot is compared against
// the live Pal_Variant_Ptr entry and the call is skipped when unchanged.
// -----------------------------------------------
pub proc Effects_InstallPreset (a0: u32) clobbers(d0-d1/a0-a3) {
        movea.l Sec.sec_effects(a0), a3         // a3 = EffectsPreset* — survives every callee below

        // ---- ep_transition: arm the cross-fade BEFORE the palette load ----
        tst.w   EffectsPreset.ep_transition(a3)
        beq     .no_fade_arm
        jbsr    Palette_ArmFade
    .no_fade_arm:

        // ---- ep_pal: required, always present ----
        movea.l EffectsPreset.ep_pal(a3), a1
        jbsr    Palette_LoadPal

        // ---- ep_cycle: straight write, 0 already means "off" cleanly ----
        movea.l EffectsPreset.ep_cycle(a3), a0
        jbsr    Palette_LoadCycle

        // ---- ep_variants[0]: write, but skip the call when already bound ----
        move.l  EP_VARIANT_0(a3), d1
        cmp.l   Pal_Variant_Ptr, d1
        beq     .variant0_same
        movea.l d1, a0
        moveq   #0, d0
        jbsr    Palette_SetVariant
    .variant0_same:

        // ---- ep_variants[1]: same guard, slot 1 ----
        move.l  EP_VARIANT_1(a3), d1
        cmp.l   Pal_Variant_Ptr + 4, d1
        beq     .variant1_same
        movea.l d1, a0
        moveq   #1, d0
        jbsr    Palette_SetVariant
    .variant1_same:

        // ---- ep_raster / ep_patched: mutually exclusive, whichever is set wins ----
        movea.l EffectsPreset.ep_patched(a3), a0
        cmpa.w  #0, a0
        beq     .no_patch
        move.w  EffectsPreset.ep_patch_world_y(a3), d0
        jbsr    Raster_InstallPatchedWorldY
        bra     .raster_done
    .no_patch:
        movea.l EffectsPreset.ep_raster(a3), a0
        cmpa.w  #0, a0
        bne     .have_raster
        lea     Raster_Program_None, a0         // 0 here means OFF, never "keep"
    .have_raster:
        jbsr    Raster_Install
    .raster_done:

        // ---- resolve the return value: ep_parallax, or the act default ----
        movea.l EffectsPreset.ep_parallax(a3), a0
        cmpa.w  #0, a0
        bne     .have_config
        movea.l Current_Act_Ptr, a0
        movea.l Act.act_parallax_config(a0), a0
    .have_config:
        rts
}

