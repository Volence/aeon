// engine/effects/raster_dsl.emp — the Phase-3 sparse-tier raster authoring vocabulary.
//
// The general constructor covers the SPARSE tier only. A [u16; N] array cannot hold a
// link-time symbol, so a program carrying the gradient's stream pointer is not
// expressible as a word array at any spelling: the DENSE tier keeps
// raster_gradient_program in engine.effects.raster. A program mixing sparse events
// with a dense run is deliberately NOT authorable in Phase 3 (design spec 4.1) even
// though the wire format permits it — a section takes one tier or the other.
//
// This module owns the encoding arithmetic and its validation; engine.effects.raster
// owns only the decoding. Pure comptime — emits no ROM bytes; glob-imported into every
// module (the native comptime-helper set).
//
// THE LITERALS IN THE FUNCTION BODIES BELOW ARE DELIBERATE. A comptime fn's free names
// resolve at its CALL SITE, so a body spelling OP_CRAM would force every author's
// module to import engine.effects.raster's constants or get `unknown name` — and in
// struct-literal position a missing import degrades SILENTLY to a label reference. The
// module-level ensures immediately below keep the single source of truth without
// imposing that on callers. Those pins ARE the codebase's reference example of the
// pattern now: the sparse-tier helper it was originally taken from was deleted along
// with the rest of the authoring block this module replaced, so the rule outlived its
// exemplar. Follow the pins below.
//
// vdp_comm / VdpTarget / VdpOp ARE safe to name in a body: engine.vdp is itself a
// COMPTIME_HELPERS member, so it is glob-injected at every call site.
module engine.effects.raster_dsl

use engine.effects.raster.{OP_SET_REG, OP_CRAM, OP_PAL_REGION, OP_RUN_GRADIENT, OP_RUN_RAMP,
                          OP_PAL_RESTORE,
                          RASTER_OPS_END, RASTER_ARM_PARK, RASTER_CRAM_MAX,
                          RASTER_BUF_SIZE, RASTER_MIN_FIRE_LINE, RASTER_MAX_FIRE_LINE,
                          pal_stage_off}

// ---- the inlined-literal pins (see the module note above) -------------------
ensure(OP_SET_REG == 0 && OP_CRAM == 2 && OP_PAL_REGION == 4 && OP_RUN_GRADIENT == 6 && OP_RUN_RAMP == 8 && OP_PAL_RESTORE == 10,
       "raster_dsl's inlined opcodes drifted from engine.effects.raster")
ensure(RASTER_OPS_END == $FFFF, "raster_dsl's inlined terminator drifted from RASTER_OPS_END")
ensure(RASTER_ARM_PARK == $8AFF, "raster_dsl's inlined park word drifted from RASTER_ARM_PARK")
ensure(RASTER_CRAM_MAX == 3, "raster_dsl's inlined per-fire colour ceiling drifted from RASTER_CRAM_MAX")
ensure(RASTER_BUF_SIZE == 128, "raster_dsl's inlined buffer bound drifted from RASTER_BUF_SIZE")
// NOTE the message spells both constant names out. `RASTER_{MIN,MAX}_FIRE_LINE` would
// be parsed as an INTERPOLATION and emit `unknown name MIN` at span 0..3 instead of the
// diagnostic — latent while the pin passes, broken exactly when it fires.
ensure(RASTER_MIN_FIRE_LINE == 3 && RASTER_MAX_FIRE_LINE == 223,
       "raster_dsl's inlined screen-line bounds drifted from RASTER_MIN_FIRE_LINE / RASTER_MAX_FIRE_LINE")
// WHY arm_at CARRIES NO PER-CALL RANGE CHECK. Reg $0A holds one 8-bit reload, so an arm
// word can express a gap of at most 255 lines. That is not a constraint an author can
// reach: the widest gap constructible is from priming fire line 1 to the last legal fire
// line, and the bound below is what makes every per-call check dead code. Assert it ONCE,
// here, where it fires if someone raises the screen-line ceiling — the only way it breaks.
ensure((RASTER_MAX_FIRE_LINE - 1) - 1 <= 255,
       "raster screen-line ceiling raised past what one reg $0A reload can span (255): arm_at drops its per-call gap check on the strength of this bound, so restore one there before raising it")
// NOTE this reasoning does NOT transfer to raster.emp's raster_arm, which keeps both of
// its guards. It is `pub` and takes unconstrained fire lines, so its checks are dead only
// for today's callers rather than structurally — the distinction that decides whether
// removing a guard is a cleanup or a silent loss of coverage.
// stream_pal_region inlines the staging arithmetic rather than calling pal_stage_off (a
// call-site name); this pins the formula against its authority.
ensure(pal_stage_off(1, 3, 5) == 1 * 128 + 3 * 32 + 5 * 2,
       "raster_dsl's inlined Pal_Variant_Stage arithmetic drifted from pal_stage_off")

// ===========================================================================
// DESCRIPTORS
//
// The enum is plumbing; the AUTHORING surface is the constructors below it, which
// are where every bound is checked. The payload slots are spelled truthfully —
// `array` where the payload is an array — but that spelling is DOCUMENTATION, not a
// check: measured at Task 7, `RasterOp.Cram(addr, 5)` binds an int to the `array`
// slot without complaint, and the build only fails downstream, at the first `.len`
// or `++` (`` `len` is not a field or `.len` of int ``). The constructors' ensures
// are what actually enforce the shapes. Same class as the parameter annotations.
// ===========================================================================

// Vsram is its OWN variant rather than a target field on Cram, deliberately. The wire
// body is byte-identical in SHAPE (same OP_CRAM opcode — the handler never inspects the
// command longword, see `stream_vsram` below), but every DERIVED fact differs: op_mask is 0 for
// VSRAM and `1 << (addr >> 5)` for CRAM, the address ceiling is 78 not 126, the "not line
// 0" rule is meaningless off CRAM, and the run-past-the-end arithmetic counts bytes of an
// 80-byte VSRAM instead of entries of a 16-colour line. A `Cram(addr, target, cols)` would
// have made every one of those an `if` inside a shared arm — the shape that lets a future
// target inherit a bound that was only ever true for CRAM. Separate variants make the
// match arms exhaustive-checked instead, which is what caught the op_mask trap.
pub comptime enum RasterOp {
    SetReg(int),                          // (mid-frame $8xxx word)
    Cram(int, array),                     // (CRAM byte address, colour-word ARRAY)
    PalRegion(int, int, int, int, int),   // (CRAM byte address, slot, pal line, entry, count)
    Vsram(int, array),                    // (VSRAM byte address, scroll-word ARRAY)
    PalRestore(int, int),                 // (CRAM byte address, count) — the snapshot
                                          // offset IS the address (BuildStaticDMA's 1:1
                                          // mapping); one fact, one field (claim D-F)
                                          // no hand-building: use pal_restore() (C-D ensures live there)
}

pub comptime enum RasterFire {
    Fire(int, array),                     // (screen line the effect lands on, RasterOp ARRAY)
    // (screen line, channel, band lo, band hi, offscreen_ship, RasterOp ARRAY) — a fire whose
    // line MOVES at runtime within [lo, hi]. The band is in SCREEN lines, like `line`; the
    // encoder converts to fire lines exactly once, in patch_table.
    //
    // offscreen_ship (0/1): when this channel's anchor leaves the TOP of the screen, re-ship
    // this fire's colours at frame top so they cover the whole screen instead of the fire
    // pinning at the band floor. Named for the GEOMETRY, not for water: the mechanism is
    // "the boundary is above the screen", and water is only its first client.
    Patch(int, int, int, int, int, array),
}

// ---- op constructors --------------------------------------------------------

// reg_set — a mid-frame VDP register write. It carries NO frame-top reset, because it
// does not need one: Flush_VDP_Shadow re-blits all 19 shadowed registers from
// VDP_Shadow_Table unconditionally at the top of every VBlank, so a mid-frame register
// change is undone at frame top whichever register it named. "A mode change cannot latch
// past the frame" is a property of the ENGINE now, not of this constructor's bookkeeping.
//
// That is also what makes presets compose. Two independently-authored effects touching
// the same register used to have to AGREE on a reset word or fail the build (the old
// prog_init disagreeing-resets check); now they simply layer.
pub comptime fn reg_set(word: int) -> RasterOp {
    ensure(word >= $8000 && word <= $97FF,
           "reg_set: {word} is not a VDP register write word ($8000..$97FF)")
    // Reg $0A is the SCHEDULE's, not the author's. Raster_HInt writes the record's arm
    // word to reg $0A FIRST and only then runs the record's ops (engine/effects/raster.emp,
    // Raster_HInt: `move.w (a1)+, (a2)` before `.op_loop`), so an op that writes $8Axx
    // overwrites the arm the encoder just scheduled. The counter then reloads with the
    // author's value at the next HInt and every remaining fire in the frame lands on the
    // wrong line — silently, and only from that fire onward, which is the worst shape a
    // schedule bug can take.
    //
    // REG $0F (autoincrement) IS BANNED TOO, and the reason is this module's own
    // arithmetic rather than the hardware's. Gunstar Heroes and Alien Soldier both change
    // autoincrement mid-frame as ordinary technique and the blanket frame-top restore
    // bounds the change to the frame that made it — which is why it was NOT banned until
    // Parcel R1. What changed is that op_cram_span, op_mask and the ship destination all
    // compute spans as `addr + 2 * count`, so a mid-frame stride change makes every one of
    // them describe something other than what the VDP does, silently and only for the ops
    // after it. Revocable behind a stride-aware span model (spec §4.2b, claim D-C).
    //
    // NOT ROUTED THROUGH VDP_Shadow_Table, and that is now correct BY CONSTRUCTION. The
    // word goes straight to VDP_CTRL from Raster_HInt's .op_set_reg and nothing here
    // touches the shadow, so the shadow keeps describing the SETTLED frame-top state —
    // exactly what it is for — while this op describes a transient excursion from it. The
    // old hazard is not merely absent, it is unrepresentable: there is no per-program reset
    // word for the flush to fight and no dirty bit for it to miss, so a reg_set on a
    // shadowed register can no longer diverge the shadow from the hardware.
    //
    // A register change meant to PERSIST is not a raster op at all. Call Set_VDP_Reg
    // (engine/system/vdp_init.emp): it writes the shadow byte and the frame-top flush
    // delivers it.
    ensure((word >> 8) != $8A,
           "reg_set: writes VDP reg $0A, the HInt line counter the raster SCHEDULE owns — Raster_HInt writes the record's arm word before running the ops, so this op would overwrite it and desynchronise every later fire in the frame. Change the SCHEDULE instead: the fires' screen lines are the input, and the encoder derives every arm word from them.")
    ensure((word >> 8) != $8F,
           "reg_set: writes reg $0F (autoincrement) — every span/mask computation in this module assumes stride 2 (op_cram_span, op_mask, the ship destination), so a mid-frame stride change silently voids them all. Revocable behind a stride-aware span model (spec §4.2b).")
    return RasterOp.SetReg(word)
}

// RASTER_SH_BASE / RASTER_SH_BIT — boot's H40 reg $0C word and the Shadow/Highlight
// enable bit, spelled ONCE so the on/off pair below cannot drift apart. The base is
// boot's own value ($0C = $81, engine/system/boot_data.emp — the VDP register table's
// `dc.b $81 // $0C: H40 (320px), no interlace`); that table is a `.asm`-side byte blob
// with no importable name, so this is a literal held by its comment the way the opcode
// literals at the top of this module are held by their pins.
const RASTER_SH_BASE = $8C81
const RASTER_SH_BIT  = 8                        // reg $0C bit 3

// reg_sh_on — Shadow/Highlight ON below the fire line; the frame-top flush restores whatever
// the shadow holds for reg $0C at the top of the next frame, which is boot's H40 base
// $8C81 (engine/system/boot_data.emp:140) unless a section deliberately changed it via
// Set_VDP_Reg. $8C89 is $8C81 | bit 3: the resolution bits are untouched, per the V28/V30
// quirk ruling in the raster survey.
pub comptime fn reg_sh_on() -> RasterOp {
    return reg_set(RASTER_SH_BASE | RASTER_SH_BIT)
}

// reg_sh_off — the S/H band's OFF word, derived from the SAME boot base as reg_sh_on so
// the pair cannot drift: one const carries the resolution bits and one bit-name carries
// the mode, so a section that re-bases reg $0C moves both words together or neither.
// It is what an S/H band's de-mix fire writes a line above the restore (spec §4.2a: the
// restore's fire carries the restore ONLY, so the register write cannot ride with it).
//
// CENSUS, same CLAIM-2 class as the base itself: no live writer of reg $0C exists in the
// tree today outside this pair, so "off" means boot's settled word and nothing else can
// have moved it mid-frame. That is a census, not an invariant — a future Set_VDP_Reg($0C)
// caller changes what the shadow restores at frame top, and this word with it.
pub comptime fn reg_sh_off() -> RasterOp {
    return reg_set(RASTER_SH_BASE)
}

// stream_cram — an inline CRAM write: `colours` words starting at CRAM byte address `addr`.
pub comptime fn stream_cram(addr: int, colours: array) -> RasterOp {
    ensure(addr >= 0 && addr <= 126, "stream_cram: CRAM byte address {addr} outside 0..126")
    ensure((addr & 1) == 0, "stream_cram: CRAM byte address {addr} is odd — colours are words")
    ensure((addr >> 5) != 0,
           "stream_cram: address {addr} is on CRAM line 0, the character's line (CharacterDef.cd_palette) — a raster write there repaints the active character")
    ensure(colours.len >= 1 && colours.len <= 3,
           "stream_cram: {colours.len} colours exceeds RASTER_CRAM_MAX (3) — that is the ~60-cycle per-fire budget, not a FIFO limit")
    ensure(((addr >> 1) & 15) + colours.len <= 16,
           "stream_cram: {colours.len} colours from entry {(addr >> 1) & 15} runs past the end of CRAM line {addr >> 5}")
    return RasterOp.Cram(addr, colours)
}

// stream_pal_region — a SCOPED colour swap streamed from a variant's Pal_Variant_Stage bytes.
// The destination CRAM address and the staging source must name the same line and
// entry; hand authoring had no such check.
pub comptime fn stream_pal_region(addr: int, slot: int, pal_line: int, entry: int, count: int) -> RasterOp {
    ensure(addr >= 0 && addr <= 126, "stream_pal_region: CRAM byte address {addr} outside 0..126")
    ensure((addr & 1) == 0, "stream_pal_region: CRAM byte address {addr} is odd — colours are words")
    ensure(slot >= 0 && slot < 2, "stream_pal_region: slot {slot} outside 0..PAL_MAX_VARIANTS(2)")
    ensure(pal_line >= 1 && pal_line <= 3,
           "stream_pal_region: staging line {pal_line} outside 1..3 (line 0 is the character's)")
    ensure(entry >= 0 && entry <= 15, "stream_pal_region: entry {entry} outside 0..15")
    ensure(count >= 1 && count <= 3,
           "stream_pal_region: {count} colours exceeds RASTER_CRAM_MAX (3)")
    ensure(entry + count <= 16,
           "stream_pal_region: {count} colours from entry {entry} runs past the end of line {pal_line}")
    ensure((addr >> 5) == pal_line,
           "stream_pal_region: destination CRAM address {addr} is on line {addr >> 5} but the staging source is line {pal_line}")
    ensure(((addr >> 1) & 15) == entry,
           "stream_pal_region: destination CRAM address {addr} is entry {(addr >> 1) & 15} but the staging source is entry {entry}")
    return RasterOp.PalRegion(addr, slot, pal_line, entry, count)
}

// stream_vsram — a mid-frame VERTICAL SCROLL write: `values` words starting at VSRAM byte
// address `addr`. Per-band vertical scroll, i.e. the effect the whole Genesis corpus
// actually reaches for HInt to do (Batman & Robin's handlers write VSRAM and touch CRAM
// zero times; Thunder Force IV writes VSRAM only). Aeon has one vertical scroll factor
// for the whole BG plane and no vertical banding at all without this.
//
// IT NEEDED NO RUNTIME CHANGE, and that is a fact about the decoder, not luck:
// Raster_HInt's `.op_cram` does `move.l (a1)+, (a2)` with whatever command longword the
// program carries and then streams words to VDP_DATA — it never inspects the target bits.
// The ONLY thing that made those ops CRAM ops was `stream_cram`/`stream_pal_region` hardcoding
// VdpTarget.Cram in this encoder. So this constructor emits OP_CRAM (the literal 2, per
// the module note on inlined literals) with a VSRAM command instead.
//
// VSRAM is 80 bytes = 40 word entries: in per-column vertical scroll mode entry 2n is
// plane A and entry 2n+1 is plane B for the n-th 16-pixel column; in full-screen mode
// only entries 0 and 1 are read. Addresses are BYTE addresses into that, like `stream_cram`'s.
//
// ---------------------------------------------------------------------------------
// MEASURED ON ORACLE 2026-08-14: A VSRAM WRITE FROM HINT LANDS ON N+1, LIKE CRAM.
// OJZ_TestVsram authored at screen line 112 → first differing pixel row is exactly 112,
// rows 108-111 pixel-identical — measured for entry 0 (plane A) and entry 1 (plane B).
// `fire` owns the single -1 and this op inherits it unchanged; there is no
// VSRAM-specific line rule. Caveat: oracle is Exodus-derived (consults VSRAM
// continuously); GensKMod latches at HBlank start, and this project has no real
// hardware, so N+1 is the standard of evidence available, not a silicon fact. If a
// latching implementation ever measures N+2, THE FIX IS IN THIS CONSTRUCTOR'S LINE
// ARITHMETIC (return a fire scheduled one line earlier, or carry a per-op line bias
// into fire_lines), NOT in the runtime: the handler is target-agnostic by design and
// must stay that way. Evidence: docs/benchmarks/effects-p3/GATE-EVIDENCE.md.
//
// AUTHORING CAUTIONS, both learned on the gate fixture:
//   - Byte 0 (plane A, full-screen mode) is UNSAFE to scroll mid-frame in this engine:
//     the rows around the camera window are the streamer's working margin, and a large
//     shift displays that scratch space as stale/half-written tiles. Band plane B.
//   - Pick the offset against the art: a shift equal to the BG's vertical repeat
//     period is pixel-invisible (the OJZ trunks repeat every 64 px — a $0040 shift
//     showed literally nothing; $0043 banded cleanly).
// ---------------------------------------------------------------------------------
pub comptime fn stream_vsram(addr: int, values: array) -> RasterOp {
    ensure(addr >= 0 && addr <= 78,
           "stream_vsram: VSRAM byte address {addr} outside 0..78 (VSRAM is 80 bytes = 40 word entries; entry 2n is plane A of the n-th 16-pixel column, 2n+1 is plane B)")
    ensure((addr & 1) == 0, "stream_vsram: VSRAM byte address {addr} is odd — scroll values are words")
    ensure(values.len >= 1 && values.len <= 3,
           "stream_vsram: {values.len} words exceeds RASTER_CRAM_MAX (3). The ceiling is the per-fire CYCLE budget, not a CRAM or FIFO limit, so a VSRAM write spends it exactly like a colour write does: same dispatch, same EFX_BLANK_DELAY, same word loop.")
    ensure(addr + 2 * values.len <= 80,
           "stream_vsram: {values.len} words from byte {addr} runs past the end of VSRAM (80 bytes)")
    return RasterOp.Vsram(addr, values)
}

// pal_restore — the band's OFF edge: stream `count` words of Palette_Ship_Snap (this
// frame's base-DMA payload) back to CRAM at `addr`. The snapshot offset IS the CRAM
// address (BuildStaticDMA's 1:1 mapping — claim D-F), so one field carries both.
// Authors do not call this directly in normal content — band() (R1 Task 9) derives it
// from the ON op so the composition guard's partner spans are equal by construction.
pub comptime fn pal_restore(addr: int, count: int) -> RasterOp {
    ensure(addr >= 0 && addr <= 126, "pal_restore: CRAM byte address {addr} outside 0..126")
    ensure((addr & 1) == 0, "pal_restore: CRAM byte address {addr} is odd — colours are words (and the handler's (a2)+ reads would address-error)")
    ensure((addr >> 5) != 0,
           "pal_restore: address {addr} is on CRAM line 0, the character's line — a restore there repaints the active character AND forces a per-frame line-0 re-assert via op_mask")
    ensure(count >= 1 && count <= 3,
           "pal_restore: {count} colours exceeds RASTER_CRAM_MAX (3) — the per-fire cycle budget; a band restores at most 3 entries (spec §1)")
    ensure(((addr >> 1) & 15) + count <= 16,
           "pal_restore: {count} colours from entry {(addr >> 1) & 15} runs past the end of CRAM line {addr >> 5} — the span would WRAP into the next line (at $7C+3, into line 0, the character's) and op_mask marks only the START line")
    return RasterOp.PalRestore(addr, count)
}

// ---- fire constructors ------------------------------------------------------

// fire — one scheduled event. `line` is the SCREEN line the effect lands on; the DSL
// derives the fire line (line - 1) and the arm schedule. The floor of 3 is the priming
// records': fires 0/1 prime on lines 0-1, so the earliest real fire is 2, landing on 3.
// An effect that must cover lines 0-2 as well is not a raster op — it is settled frame
// state, so set it with Set_VDP_Reg (engine/system/vdp_init.emp) and let the frame-top
// flush deliver it.
pub comptime fn fire(line: int, ops: array) -> RasterFire {
    ensure(line >= 3 && line <= 223,
           "fire: screen line {line} outside 3..223 (lines 0-2 belong to the priming records)")
    ensure(ops.len >= 1, "fire: a fire with no ops — drop the fire rather than authoring an empty one")
    // ---- THE THREE PER-FIRE CEILINGS, AND WHAT THEY DO NOT DO -------------------
    // These are STRUCTURAL COUNTS — the same class of guard as RASTER_CRAM_MAX itself —
    // and NOT a cycle model. A cycle model was considered and rejected: the only measured
    // figures in the tree (docs/benchmarks/effects-p2/GATE-EVIDENCE.md) are per-frame upper
    // bounds that include profiler instrumentation and exception entry, so a per-op cycle
    // table derived from them would be authoritative-looking fiction. Counts are honest.
    //
    //   1. ops per fire        <= 4   every op walks the handler's compare chain, and
    //                                 OP_SET_REG — the op with no other cost — is that
    //                                 chain's FALL-THROUGH (raster.emp, Raster_HInt
    //                                 .op_loop), so it is the most expensive to DISPATCH.
    //   2. stream ops      <= 2   each of stream_cram/stream_pal_region/stream_vsram/pal_restore pays its own
    //                                 dispatch AND its own EFX_BLANK_DELAY spin (.op_cram /
    //                                 .op_region), and that spin is the whole mechanism
    //                                 that parks a write in HBlank (the restore op deliberately
    //                                 has NO spin — its landing is bracket-calibrated separately,
    //                                 spec §3.2).
    //   3. stream words    <= 3   RASTER_CRAM_MAX — the writes themselves.
    // All three are PER-FIRE. `stream_cram`/`stream_pal_region`/`stream_vsram`/`pal_restore` also bound their OWN word count,
    // which is necessary and not sufficient: three 3-word ops satisfy every per-op guard.
    //
    // WHAT IS STILL NOT ENFORCED — read no cycle guarantee into the above. The COST of a
    // fire is not modelled at all: a 4-op fire of reg_sets and a 1-op fire of one stream_cram both
    // pass, and the first is certainly slower. Whether even the permitted maxima finish
    // before active display is UNMEASURED — nothing in this tree has ever run more than two
    // ops or more than ONE stream op in a single fire (both shipped fixtures are
    // reg_set + one stream op), and adjacent-fire density is unmeasured too. These
    // ceilings bound the DAMAGE of a mistake; they do not certify the shapes they admit.
    // The predecessor of this comment claimed RASTER_CRAM_MAX was "a PER-FIRE cycle budget
    // … on the whole fire" while the code counted only CRAM words and no ops at all; that
    // gap is exactly why a 20-reg_set fire passed every guard.
    comptime var stream_words = 0
    comptime var stream_ops = 0
    for o in ops {
        stream_words = stream_words + op_stream_words(o)
        if op_is_reg(o) == 0 { stream_ops = stream_ops + 1 }
    }
    ensure(ops.len <= 4,
           "fire at screen line {line}: {ops.len} ops exceeds the per-fire ceiling of 4. Every op costs a walk of Raster_HInt's compare chain before it does any work, and OP_SET_REG — the cheap-looking one — is the chain's fall-through, so it is the most expensive op to dispatch. Four is a structural ceiling, not a measured one: the richest fire anything has ever run is two ops. Split the work across consecutive fires.")
    ensure(stream_ops <= 2,
           "fire at screen line {line}: {stream_ops} stream ops (stream_cram / stream_pal_region / stream_vsram / pal_restore) exceeds the per-fire ceiling of 2. Each one issues its own command longword and burns its own EFX_BLANK_DELAY spin (the restore op deliberately has NO spin — its landing is bracket-calibrated separately, spec §3.2), and that spin is what parks the write offscreen. WHAT IS ACTUALLY MEASURED TO LAND IN HBLANK is ONE stream op sitting SECOND, after a reg_set: the row-119 evidence is the fixture fire(120, [reg_sh_on(), stream_cram($4A, [$000E])]) reading 1px -> 0px (docs/benchmarks/effects-p2/GATE-EVIDENCE.md). Correcting this text 2026-08-18: it used to say the FIRST op's writes were the measured ones, which is the opposite of that fixture's op order. A LEADING stream op is NOT covered by any measurement and is a KNOWN OPEN DEFECT rather than a handled case — EFX_BLANK_DELAY = 4 was fitted to the ~168-cycle reg_set-prefixed shape, while a fire whose first op streams carries only ~58 cycles of pre-burst delay and was measured spilling at x~170 of 320, i.e. mid-active-display (raster.emp's .op_pal_restore calibration note; booked in docs/DEFERRED_WORK.md, raster substrate sweep item 1). Until that lands: author ONE stream op per fire, SECOND, after a reg_set, and use consecutive fires for more. A single-op stream fire — which band(sh: 0), region_boundary(sh: 0) and fx_tint_band(sh: 0) all still produce — is expected to paint a visible dot, and NOTHING here refuses it. A second stream op on the same line is likewise admitted only for the case where you have measured that you can live with its dot.")
    ensure(stream_words <= 3,
           "fire at screen line {line}: {stream_words} stream words across {ops.len} ops exceeds RASTER_CRAM_MAX (3). That is a PER-FIRE budget: split the writes across consecutive fires — a full 16-colour line takes ceil(16/3) = 6 of them, one per scanline. That six-fire idiom is OURS, not a reference's: S3K's HInt3 swaps a whole water palette in ONE interrupt (park the counter, stop the Z80, then repeat: fresh CRAM command, 3 colours, a cycle-counted ~370-cycle dbf spin), and S3K's HInt2, Sonic 2's PalToCRAM and S.C.E.'s HInt each write 64 CRAM words in a single fire with no delay at all. Ours is dot-free by construction and pays six exception entries for it; the spacing in S3K comes from the spin, not from multiple interrupts.")
    return RasterFire.Fire(line, ops)
}

// region_boundary — the composite the water cluster is: at `line`, optionally turn
// Shadow/Highlight on, then swap the region. SET_REG comes first BY CONSTRUCTION here,
// so the mixed-fire invariant is structural for this constructor and only checked for
// hand-assembled fires.
//
// `sh` HAS NO DEFAULT, and the reason has changed. It used to be a SAFETY requirement:
// sh:0 yielded a program with zero init words, which moved the priming arm word off the
// word the old single-channel water patcher wrote unconditionally, and a patched template then had an
// arm word written over a record's op_count. That failure is gone — the header is one
// word for every program now, so arm0 is always word 1 and the old WATER_TEMPLATE_ARM0_OFF is
// structural rather than conditional. The parameter stays required because whether an
// effect changes a mode register is worth stating at the call site, not because omitting
// it can corrupt anything.
pub comptime fn region_boundary(line: int, addr: int, slot: int, pal_line: int,
                                entry: int, count: int, sh: int) -> RasterFire {
    ensure(sh == 0 || sh == 1, "region_boundary: sh {sh} must be 0 or 1")
    if sh == 1 {
        return fire(line, [reg_sh_on(), stream_pal_region(addr, slot, pal_line, entry, count)])
    }
    return fire(line, [stream_pal_region(addr, slot, pal_line, entry, count)])
}

// patchable — mark a fire as one whose screen line MOVES at runtime, within [lo, hi].
//
// IT TAKES AND RETURNS A FIRE LIST, not a fire, and that is the whole ergonomic point:
// every fx_ preset returns a LIST, so a fire-level spelling would be a type error at exactly
// the call an author reaches for first — patchable(fx_tint_band(...), ...). List-level
// composes with the preset library and feeds straight into compose.
//
// THE CHANNEL IS AUTHORED, not an encoder-assigned ordinal. `ch` selects which world-anchor
// slot drives this fire at runtime (a later parcel). Ordinals would leave an author counting
// patchable fires in program order to find their own slot, and the count changes under
// compose merging.
//
// The screen-line bounds below are inlined literals per this module's opening note (3 and 223
// are held by the module-level RASTER_MIN_FIRE_LINE / RASTER_MAX_FIRE_LINE pin near the top of
// this file); RASTER_MAX_PATCH is DEFINED in this module and so is safe to name.
pub comptime fn patchable(fires: array, ch: int, lo: int, hi: int, offscreen_ship: int = 0) -> array {
    ensure(fires.len == 1,
           "patchable: got {fires.len} fires — mark exactly one. Marking a multi-fire preset would clamp all of its fires onto one line, because they would share a single world anchor.")
    ensure(ch >= 0 && ch < RASTER_MAX_PATCH,
           "patchable: channel {ch} outside the legal range — the channel selects a runtime world-anchor slot, and RASTER_MAX_PATCH is the ceiling")
    ensure(lo >= 3 && hi <= 223,
           "patchable: band {lo}..{hi} outside screen lines 3..223 (lines 0-2 belong to the priming records)")
    ensure(lo <= hi, "patchable: band {lo}..{hi} is inverted")
    let f = fires[0]
    ensure(fire_is_patch(f) == 0,
           "patchable: this fire is already patchable — marking it twice would silently discard the first band")
    let line = fire_screen_line(f)
    // The authored line is the template's DEFAULT schedule. If it sits outside its own band the
    // shipped template violates the invariant it declares, and the first runtime patch would
    // move the boundary somewhere the author never saw.
    ensure(line >= lo && line <= hi,
           "patchable: the authored line {line} is outside its own band {lo}..{hi}")
    ensure(offscreen_ship == 0 || offscreen_ship == 1,
           "patchable: offscreen_ship {offscreen_ship} must be 0 or 1")
    // The ship re-issues THIS FIRE'S colours as a frame-top DMA, so the fire has to have
    // colours to re-issue — exactly one stream_pal_region op, which is what carries the staging
    // source, the CRAM address and the count the entry is built from. A fire without one
    // (a bare vscroll split, say) has nothing to ship, and a fire with two would need two
    // entries and a rule about which wins. Both fail the BUILD here rather than producing a
    // garbage DMA entry or silently shipping nothing.
    if offscreen_ship == 1 {
        ensure(count_stream_pal_region_ops(fire_ops(f)) == 1,
               "patchable: offscreen_ship needs exactly ONE stream_pal_region op on the fire to re-ship at frame top, but this fire has {count_stream_pal_region_ops(fire_ops(f))}. The frame-top entry is BUILT from that op's staging source, CRAM address and count — there is nothing else for it to ship.")
    }
    return [ RasterFire.Patch(line, ch, lo, hi, offscreen_ship, fire_ops(f)) ]
}

// ---- composition -------------------------------------------------------------

// compose — merge N fire lists into one program's fire list. THE point of a preset
// library: presets that do not combine force a combinatorial pile of hand-merged
// variants, which is the thing a preset library exists to avoid.
//
// It walks screen lines in ascending order rather than sorting, which buys three
// properties without a sort's off-by-ones:
//   - the result is in strictly ascending line order, which fire_lines requires;
//   - two presets firing on the SAME line become ONE fire rather than a duplicate-line
//     error, which is what "layer these two effects" has to mean;
//   - every SetReg is emitted before every stream op, so ruling 14's prefix
//     invariant holds BY CONSTRUCTION for merged fires (check_mixed_fire still runs,
//     but it can no longer be tripped by the act of composing).
// Each merged op list goes back through `fire`, so the per-fire ceilings apply to the
// COMPOSITION and not merely to its parts — composing two legal presets into an illegal
// fire is a build error, not a surprise at runtime.
//
// THE REGISTER NEGOTIATION IS GONE. Two presets touching the same VDP register used to
// be refused unless they agreed on a frame-top reset word, so composition was a
// negotiation between preset authors. The blanket VBlank register restore (the corpus
// answer — Gunstar re-blits its whole shadow every frame) made per-op resets unnecessary,
// `reg_set` lost its `reset` parameter, and presets now layer without having to know
// about each other. What composition still cannot reconcile is two ops writing the same
// register on the SAME line: they both execute, in preset order, and the last one wins.
//
// PATCHABILITY SURVIVES MERGING, and it takes explicit work. This function rebuilds every
// merged fire, so a mark carried only in the input variant is lost by construction —
// exhaustive matching cannot catch it, because the loss is in reconstruction, not
// destructuring. Merging patchable with static yields PATCHABLE (the static op layers onto
// the moving line); merging two patchables requires identical channel and band (guard 9).
pub comptime fn compose(progs: array) -> array {
    ensure(progs.len >= 1, "compose: nothing to compose")
    comptime var out = []
    // THE BOUNDS ARE INLINED LITERALS, per this module's opening note, and the first
    // version of this function proved why the hard way. A comptime fn's free names
    // resolve at the CALL SITE, and RASTER_MIN_FIRE_LINE / RASTER_MAX_FIRE_LINE are
    // IMPORTED here rather than defined here — imports do not travel with a helper, only
    // locally-defined names do. Spelled as constants, the range collapsed to empty at
    // every call site and compose returned ZERO fires with no diagnostic at all: the
    // program simply lost its event records. (Constants DEFINED in this module, such as
    // RASTER_SCANLINE_CYC above, are injected and are safe to name.) 3 and 224 below are
    // held to their authority by the module-level pin near the top of this file.
    for line in 3..224 {
        comptime var ops   = []
        comptime var found = 0
        comptime var is_p  = 0
        comptime var p_ch  = 0
        comptime var p_lo  = 0
        comptime var p_hi  = 0
        comptime var p_sh  = 0
        for p in progs {
            for f in p {
                if fire_screen_line(f) == line {
                    found = 1
                    if fire_is_patch(f) == 1 {
                        // Guard 9. Two patchable fires merged onto one line become ONE record
                        // and therefore ONE moving boundary, so they must agree on which
                        // channel drives it and how far it may travel. Disagreement is not
                        // reconcilable at runtime: the record has a single arm word.
                        if is_p == 1 {
                            ensure(p_ch == fire_channel(f) && p_lo == fire_band_lo(f) && p_hi == fire_band_hi(f),
                                   "compose: two patchable fires merged onto screen line {line} disagree about channel or band — a merged fire is ONE record with ONE arm word, so it can only have one anchor and one band. Give them the same channel and band, or author them on different lines.")
                            // Same argument, one field over: a merged fire is ONE record and
                            // the trailer carries at most one entry per record, so "ship at
                            // frame top" is not a property two merged fires can hold different
                            // opinions about. It sits INSIDE the is_p test with its sibling:
                            // outside, it would compare the FIRST patchable fire against the
                            // initial p_sh of 0 and refuse every legitimate shipped fire.
                            ensure(p_sh == fire_offscreen_ship(f),
                                   "compose: two patchable fires merged onto screen line {line} disagree about offscreen_ship — the merged fire is ONE record and gets at most ONE frame-top entry, so both must declare it the same way.")
                        }
                        is_p = 1
                        p_ch = fire_channel(f)
                        p_lo = fire_band_lo(f)
                        p_hi = fire_band_hi(f)
                        p_sh = fire_offscreen_ship(f)
                    }
                    for o in fire_ops(f) {
                        if op_is_reg(o) == 1 { ops = ops ++ [o] }
                    }
                }
            }
        }
        for p in progs {
            for f in p {
                if fire_screen_line(f) == line {
                    for o in fire_ops(f) {
                        if op_is_reg(o) == 0 { ops = ops ++ [o] }
                    }
                }
            }
        }
        if found == 1 {
            // fire() FIRST, unconditionally: it is what applies the per-fire ceilings and the
            // mixed-fire ordering rule to the COMPOSITION rather than merely to its parts. The
            // patchable case then re-wraps the same op list, so it inherits every one of those
            // checks instead of quietly bypassing them.
            comptime var merged = fire(line, ops)
            if is_p == 1 { merged = RasterFire.Patch(line, p_ch, p_lo, p_hi, p_sh, ops) }
            out = out ++ [merged]
        }
    }
    return out
}

// ---- the starter preset library ----------------------------------------------
// A preset is a comptime fn returning a FIRE LIST, so presets take parameters and
// compose (see `compose`). No new type was needed for this — the language already
// allowed it and only `compose` was missing.
//
// The `fx_` prefix is a namespace, not decoration: this module is a COMPTIME_HELPERS
// member, so every public name here is glob-injected into EVERY module in the tree, and
// tools/emp_helper_closure.py is the collision gate. Run it when adding a preset.

// fx_sh_below — Shadow/Highlight ON from `line` down, H40 base restored at frame top.
// The cheapest dramatic effect the hardware has: one register write, no CRAM traffic,
// and it darkens everything below the line including sprites.
pub comptime fn fx_sh_below(line: int) -> array {
    return [ fire(line, [ reg_sh_on() ]) ]
}

// fx_vscroll_split — plane B's vertical scroll snaps to `offset` from `line` down, so the
// background stops tracking the camera below it. Vertical scroll BANDING.
//
// PICK THE OFFSET AGAINST THE ART. A shift equal to the background's vertical repeat
// period is pixel-invisible: the OJZ trunks repeat every 64 px, and a $0040 shift showed
// literally nothing while $0043 banded cleanly. That cost a full session on 2026-08-14 —
// read the period off the nametable before choosing.
//
// PLANE B, NOT PLANE A. Mid-frame vertical scroll of plane A displays the streamer's
// working margin (TILE_CACHE_ROWS = 60) as stale/half-written tiles.
pub comptime fn fx_vscroll_split(line: int, offset: int) -> array {
    return [ fire(line, [ stream_vsram(2, [offset]) ]) ]
}

// fx_tint_band — from `line` down, swap `count` colours of the palette variant staged in
// `slot` into CRAM, optionally turning Shadow/Highlight on at the same line. This is the
// water-boundary shape generalised, and the CRAM destination is DERIVED from
// pal_line/entry rather than asked for a second time — stream_pal_region's address/line/entry
// agreement checks then cannot fail, because there is only one source of the fact.
//
// THE STAGING ARITHMETIC IS INLINED, not a pal_stage_off call, and that is not style. A
// comptime fn's free names resolve at the CALL SITE, and pal_stage_off is IMPORTED into
// this module rather than defined here — so a call here compiled fine and then failed in
// every author's module with `unknown function pal_stage_off` unless that author added an
// import for a helper they never named. Measured 2026-08-15: OJZ_TwoChannel was the FIRST
// call site of this preset anywhere in the tree, and it hit exactly that, four times over.
// The preset shipped broken in Parcel C1 and nothing noticed for two parcels because
// nothing had ever called it.
//
// This is the same rule the module header states and that stream_pal_region already follows (see
// its note near the top); the module-level ensure beside the other pins holds this copy of
// the formula to pal_stage_off's authority, so there is still exactly one source of truth.
// (The slot term is 0 deliberately: the CRAM destination is slot-independent; `slot`
// selects the staging SOURCE and is passed through below.)
//
// UNCHECKABLE HERE, AND REAL: the variant bound to `slot` at runtime must cover
// `pal_line` in its `lines` mask, or Palette_DeriveVariant never writes that staging line
// and this streams whatever the buffer holds — zeros, or a previous variant's colours
// after a rebind. Binding is a runtime call (Palette_SetVariant), so a comptime guard
// cannot see it. Booked; see the vocabulary review §5.
pub comptime fn fx_tint_band(line: int, slot: int, pal_line: int, entry: int,
                             count: int, sh: int) -> array {
    return [ region_boundary(line:     line,
                             addr:     0 * 128 + pal_line * 32 + entry * 2,
                             slot:     slot,
                             pal_line: pal_line,
                             entry:    entry,
                             count:    count,
                             sh:       sh) ]
}

// band — an effect that turns ON at screen line `top` and OFF at `bot`: the ON op, and a
// restore streaming this frame's base-DMA payload back over exactly the ON op's span
// (partner equality BY CONSTRUCTION — the composition guard's uniqueness rule is satisfied
// structurally, never by author care; there is no second place to write the span, so the
// two cannot disagree). `sh: 1` emits the full three-fire S/H shape, and the constructor
// must see the WHOLE shape because the MERGED ON fire is what check_density charges
// (claim E-C: v5's one-op band() admitted S/H programs the density guard then refused,
// with a message about a fire pair band() had never mentioned).
//
// "Band height" = bot - top in SCREEN lines = the fire-line gap. NOT an inclusive row
// count. The two spellings coincide because fire_lines applies a UNIFORM -1: the gap
// check_density measures between two static fires is (bot - 1) - (top - 1) = bot - top.
// A band restores at most 3 CRAM entries (the stream ceiling x one restore — spec §1).
// Static by construction — BOTH fires (spec §4.2 rule 6); not handable to `patchable`.
//
// THE MINIMA BELOW ARE check_density's OWN ARITHMETIC, deliberately: `cost <= gap *
// RASTER_SCANLINE_CYC` over the fires this function actually emits, with the gap spelled
// the way check_density derives it. That is the whole claim — a band() that admits a
// height check_density then refuses is worse than no check at all, because the refusal
// names fires the author never wrote. They are cost-keyed rather than table-keyed (CLAIM
// D-D) so they re-price themselves the day the model does; the F-series fixture pins are
// what hold the model. Consequence worth stating at the call site: `fx_tint_band`'s
// pal_region ON op costs 506 cyc even at ONE colour, so even a 1-colour tint band needs
// height 2, and its S/H form needs 3.
pub comptime fn band(top: int, bot: int, on: RasterOp, sh: int) -> array {
    ensure(sh == 0 || sh == 1, "band: sh must be 0 or 1")
    ensure(top < bot, "band: top {top} must be above bot {bot}")
    // The restore's payload is the ON op's span, read back off the op. `sb` is a BYTE
    // length (op_cram_span's contract) and pal_restore counts WORDS, hence sb / 2.
    let (sa, sb) = op_cram_span(on)
    ensure(sa >= 0,
           "band: the ON op has no CRAM span (a reg-only or VSRAM band needs no restore — a register band is already two plain fires, spec §9)")
    // inert on the refused path: without this, the poisoned pal_restore(-1, 0) cascades five more diagnostics incl. a raw evaluator shift error — the ensure above already said the true thing (Task 9 review, measured 6 -> 1).
    if sa < 0 { return [fire(top, [on])] }
    if sh == 0 {
        // Bound ONCE and reused: `fire()` runs the per-fire ceilings, so constructing it
        // twice (here and in the return) would report every ceiling violation twice.
        let f_on = fire(top, [on])
        ensure(fire_cost_cycles(f_on) <= (bot - top) * RASTER_SCANLINE_CYC,
               "band: height {bot - top} is below this ON op's minimum — the ON fire costs {fire_cost_cycles(f_on)} cyc against {(bot - top) * RASTER_SCANLINE_CYC} available; a 1-word pal_region tint needs height 2 (spec §6.2, measured model)")
        return [f_on, fire(bot, [pal_restore(sa, sb / 2)])]
    }
    let min_sh_height = 3
    ensure(bot - top >= min_sh_height,
           "band: an S/H band needs height >= {min_sh_height} — the merged [reg, tint] ON fire is charged against the gap to the S/H-off fire at bot-1 (spec §6.2, measured model)")
    let f_on_sh = fire(top, [reg_sh_on(), on])
    // GATED ON THE HEIGHT RULE ABOVE, the way raster_program's band block is gated on
    // restore_n == 1 and for the same reason: `ensure` is non-aborting, so an ungated cost
    // check would ALSO fire at height 2 — the merged fire is at minimum 568 cyc (a 1-word
    // cram ON op) so it cannot fit a one-line gap for ANY legal ON op — and the author
    // would read two band() sentences stating one fact. The height rule is the one written
    // in the author's own numbers, so it speaks alone.
    //
    // AND IT CANNOT FIRE TODAY — stated rather than left to be rediscovered. band()'s
    // merged fire is exactly two ops, `reg_sh_on` (110 cyc) plus the ON op, and the
    // dearest ON op the constructors admit is a 3-word `stream_pal_region` at 264, so the
    // merged fire tops out at 302 + 110 + 264 = 676 against the 2 x 488 = 976 that height
    // 3 buys. It is kept anyway, and NOT as belt-and-braces: `>= 3` is a LITERAL and 676
    // is a fact about six measured constants, two of which moved this week (the dispatch
    // chain grew a rung, and RASTER_WORK_RESTORE_CYC was measured at all). This is the
    // cost-keyed half CLAIM D-D asks for — the thing that notices when the model moves the
    // real minimum past the literal — which is the opposite of an unreachable guard: it is
    // reachable exactly when the number above it goes stale.
    if bot - top >= min_sh_height {
        ensure(fire_cost_cycles(f_on_sh) <= (bot - top - 1) * RASTER_SCANLINE_CYC,
               "band: S/H height {bot - top} is below this ON op's minimum — the merged ON fire costs {fire_cost_cycles(f_on_sh)} cyc against the gap to bot-1 (spec §6.2)")
    }
    // The de-mix fire sits at bot-1 and carries the register write ALONE, because the
    // restore's fire may carry the restore only (spec §4.2a, claim D-B). Its own gap to
    // the restore is one line and a single reg fire models at 412 cyc, inside a 488-cycle
    // line — so that pair needs no minimum of its own beyond the height >= 3 above.
    return [f_on_sh,
            fire(bot - 1, [reg_sh_off()]),
            fire(bot, [pal_restore(sa, sb / 2)])]
}

// ===========================================================================
// ENCODING
// ===========================================================================

comptime fn fire_screen_line(f: RasterFire) -> int {
    return match f {
        Fire(m, ops) => m,
        Patch(m, ch, lo, hi, sh, ops) => m,
    }
}
comptime fn fire_ops(f: RasterFire) {
    return match f {
        Fire(m, ops) => ops,
        Patch(m, ch, lo, hi, sh, ops) => ops,
    }
}
// fire_band_lo / fire_band_hi return a STATIC fire's own line, so its interval is the
// degenerate [L, L]. That is what lets the later interval and density walks run one formula
// over both record classes with no branch — and it is why the density guard automatically
// becomes a worst-case guard once a fire can move.
comptime fn fire_band_lo(f: RasterFire) -> int {
    return match f {
        Fire(m, ops) => m,
        Patch(m, ch, lo, hi, sh, ops) => lo,
    }
}
comptime fn fire_band_hi(f: RasterFire) -> int {
    return match f {
        Fire(m, ops) => m,
        Patch(m, ch, lo, hi, sh, ops) => hi,
    }
}
comptime fn fire_is_patch(f: RasterFire) -> int {
    return match f {
        Fire(m, ops) => 0,
        Patch(m, ch, lo, hi, sh, ops) => 1,
    }
}
comptime fn fire_channel(f: RasterFire) -> int {
    return match f {
        Fire(m, ops) => -1,
        Patch(m, ch, lo, hi, sh, ops) => ch,
    }
}
// A static fire can never carry the off-screen ship: it has no channel, so there is no
// anchor to be off-screen. Returning 0 rather than -1 keeps callers' `== 1` tests total.
comptime fn fire_offscreen_ship(f: RasterFire) -> int {
    return match f {
        Fire(m, ops) => 0,
        Patch(m, ch, lo, hi, sh, ops) => sh,
    }
}

// ---- the per-op blanking spin ------------------------------------------------
// EVERY STREAM OP CARRIES ITS OWN dbf ITERATION COUNT, emitted here and read by
// Raster_HInt with `move.w (a1)+, d1`. It used to be one constant in raster.emp
// (EFX_BLANK_DELAY = 4, plus EFX_RESTORE_DELAY = 13 for the restore); substrate sweep
// item 1 is what killed that.
//
// THE REASON A CONSTANT CANNOT WORK. The spin exists to push the burst out of active
// display and into horizontal blanking. The distance from the handler's entry to that
// window is fixed, but the distance from THIS OP'S delay site to it is not: it shrinks
// by everything that ran ahead of the op inside the same fire, and by the op's own
// dispatch depth. A CRAM op sitting second, after an OP_SET_REG, arrives 110 cycles
// later than the same op sitting first. Fitting one constant to one of those shapes
// leaves the other ~150 cycles early, which is precisely the measured defect: R1's §7.3
// capture recorded the bare single-op fire "spilled ... row 99 tinted from x~170", i.e.
// mid-active-display, while the two-op shape it was fitted to read clean.
//
// Only the lowering knows an op's position and depth, so the lowering computes the spin.
//
// ITERATIONS, NOT CYCLES. `moveq #N` + `dbf` costs 4 + N*10 + 14 (N taken at 10, one
// expired at 14); reading N from the stream makes the prologue 8 instead of 4, so a
// stream op costs 4 cycles more than it did and carries 2 more bytes. That tax buys the
// defect's removal for every op shape rather than the two the sweep happened to name.
comptime fn spin_cyc(n: int) -> int { return n * 10 + 14 }

// The values below are STILL the hand-calibrated ones, per class, exactly as shipped --
// this step changes only WHERE the count comes from, so the emitted timing is unchanged
// and the wire-format change is measurable in isolation. The centered-target solver that
// replaces them needs the blanking window located on hardware first; until that lands, a
// LEADING stream op is still mis-timed and raster_dsl's fire() guard still says so.
const RASTER_SPIN_CRAM    = 4      // calibrated for a CRAM op sitting AFTER an OP_SET_REG
const RASTER_SPIN_REGION  = 4      // shares cram's calibration; dispatches one rung deeper
const RASTER_SPIN_RESTORE = 13     // R1 §7.3, depth 4, no preceding op -- its own datum

// op_words — the emitted body of one op.
comptime fn op_words(o: RasterOp) {
    return match o {
        SetReg(w) => [0, w],
        Cram(a, cols)    => [2,
                             vdp_comm(a, VdpTarget.Cram, VdpOp.Write) >> 16,
                             vdp_comm(a, VdpTarget.Cram, VdpOp.Write) & $FFFF,
                             RASTER_SPIN_CRAM,
                             cols.len - 1] ++ cols,
        PalRegion(a, slot, pl, e, n) => [4,
                             vdp_comm(a, VdpTarget.Cram, VdpOp.Write) >> 16,
                             vdp_comm(a, VdpTarget.Cram, VdpOp.Write) & $FFFF,
                             RASTER_SPIN_REGION,
                             n - 1,
                             slot * 128 + pl * 32 + e * 2],
        // OP_CRAM (2) with a VSRAM command longword — the handler decodes the opcode,
        // never the target bits inside the command (see `stream_vsram`).
        Vsram(a, vals)   => [2,
                             vdp_comm(a, VdpTarget.Vsram, VdpOp.Write) >> 16,
                             vdp_comm(a, VdpTarget.Vsram, VdpOp.Write) & $FFFF,
                             RASTER_SPIN_CRAM,
                             vals.len - 1] ++ vals,
        PalRestore(a, cnt) => [10,
                             vdp_comm(a, VdpTarget.Cram, VdpOp.Write) >> 16,
                             vdp_comm(a, VdpTarget.Cram, VdpOp.Write) & $FFFF,
                             RASTER_SPIN_RESTORE,
                             cnt - 1, a],
    }
}

// op_size — the SAME fact by an independent path from op_words. The cross-check that
// actually runs is raster_program's own `ensure(out.len == raster_words(fires))` at the
// bottom of this module: it fires on EVERY call, and it is what catches header/record
// FRAMING drift. The `data X: [u16; raster_words(P)] = raster_program(P)` annotation adds
// one narrower thing on top — it catches `[u16; raster_words(A)] = raster_program(B)`,
// an annotation naming a DIFFERENT program, which is a realistic copy-paste between two
// adjacent fixtures — and it pins the declared ROM footprint at the linker seam. Writing
// `[u16; P.len] = P` instead would be tautological and is forbidden. A wrong word VALUE
// inside a correctly-sized body is caught by neither; that is the hand-word twins' job,
// with the goldens behind them.
comptime fn op_size(o: RasterOp) -> int {
    return match o {
        // Every stream op carries one extra word since the spin moved into the program
        // (substrate item 1): [op][cmd hi][cmd lo][SPIN][count-1][payload...].
        SetReg(w)             => 2,
        Cram(a, cols)                => 5 + cols.len,
        PalRegion(a, slot, pl, e, n) => 6,
        Vsram(a, vals)               => 5 + vals.len,
        PalRestore(a, cnt)           => 6,
    }
}

// op_stream_words — data words this op streams to the VDP data port, which `fire` sums
// against the per-fire ceiling. Distinct from op_size (wire words): a PalRegion is 5 wire
// words but streams `n` colours, and a SetReg is 2 wire words but streams none. The name
// says CRAM for the ceiling it feeds (RASTER_CRAM_MAX); a Vsram op counts here too,
// because the ceiling is a CYCLE budget and a VSRAM word costs exactly what a colour does.
comptime fn op_stream_words(o: RasterOp) -> int {
    return match o {
        SetReg(w)             => 0,
        Cram(a, cols)                => cols.len,
        PalRegion(a, slot, pl, e, n) => n,
        Vsram(a, vals)               => vals.len,
        PalRestore(a, cnt)           => cnt,
    }
}

// op_mask — the pal_dirty_mask bit an op needs re-asserted at frame top. CRAM byte
// address >> 5 is the palette line (32 bytes = 16 words per line). THIS is what makes
// a mid-frame write transient; a mask naming any other line leaves the write latched
// forever, which is the observed P1 bug (the red covered the whole ground, not just
// below the split, when the mask said %0001 and the op wrote line 2).
// ---- the off-screen frame-top ship -------------------------------------------
// A patched fire marked `offscreen_ship` gets a ready-made DMAEntry emitted into the
// program's ROM trailer, re-issuing that fire's OWN stream_pal_region as a frame-top transfer.
// The runtime ships it on the frames the channel's anchor is above the screen, which is
// where the fire itself can only pin at its band floor.
//
// EVERYTHING BELOW IS DERIVED FROM THE FIRE'S OP, NEVER AUTHORED A SECOND TIME. That is the
// whole design: the entry and the op words are two generated artifacts of ONE set of
// arguments, produced in the same pass, so they cannot drift. The rejected alternative was a
// runtime walk that decoded the op words at install — which would have made a SECOND reader
// of the variable-length op format (today only Raster_HInt decodes ops) that had to track it
// forever.
comptime fn count_stream_pal_region_ops(ops: array) -> int {
    comptime var n = 0
    for o in ops {
        n = n + match o {
            SetReg(w)                      => 0,
            Cram(a, cols)                  => 0,
            PalRegion(a, slot, pl, e, cnt) => 1,
            Vsram(a, vals)                 => 0,
            PalRestore(a, cnt)             => 0,
        }
    }
    return n
}
// The three facts an entry needs, each read off the op that already carries it. -1 / 0 for
// the non-PalRegion arms are unreachable in practice — patchable's guard refuses a shipped
// fire without exactly one — but the match must be total.
comptime fn op_ship_cram_addr(o: RasterOp) -> int {
    return match o {
        SetReg(w)                      => -1,
        Cram(a, cols)                  => -1,
        PalRegion(a, slot, pl, e, cnt) => a,
        Vsram(a, vals)                 => -1,
        PalRestore(a, cnt)             => -1,
    }
}
comptime fn op_ship_stage_off(o: RasterOp) -> int {
    return match o {
        SetReg(w)                      => -1,
        Cram(a, cols)                  => -1,
        PalRegion(a, slot, pl, e, cnt) => slot * 128 + pl * 32 + e * 2,
        Vsram(a, vals)                 => -1,
        PalRestore(a, cnt)             => -1,
    }
}
// The SetReg word itself, for the ops the ship re-issues at frame top.
comptime fn op_reg_word(o: RasterOp) -> int {
    return match o {
        SetReg(w)                      => w,
        Cram(a, cols)                  => 0,
        PalRegion(a, slot, pl, e, cnt) => 0,
        Vsram(a, vals)                 => 0,
        PalRestore(a, cnt)             => 0,
    }
}
comptime fn op_ship_count(o: RasterOp) -> int {
    return match o {
        SetReg(w)                      => 0,
        Cram(a, cols)                  => 0,
        PalRegion(a, slot, pl, e, cnt) => cnt,
        Vsram(a, vals)                 => 0,
        PalRestore(a, cnt)             => 0,
    }
}

// op_cram_span — (CRAM byte address, byte length) of the entries an op WRITES; (-1, 0)
// for ops with no CRAM span. ADDRESS-keyed, never class-keyed: Vsram dispatches at the
// CRAM rung but its address is scroll space, not palette space (the op_mask precedent).
// The composition guard (raster_program) is the only consumer. Claim C-A.
// DESTRUCTURE ONLY — let (a, n) = op_cram_span(o); tuples are not indexable in .emp and this is the tree's only tuple-returning fn.
comptime fn op_cram_span(o: RasterOp) -> (int, int) {
    return match o {
        SetReg(w)                      => (-1, 0),
        Cram(a, cols)                  => (a, 2 * cols.len),
        PalRegion(a, slot, pl, e, cnt) => (a, 2 * cnt),
        Vsram(a, vals)                 => (-1, 0),
        PalRestore(a, cnt)             => (a, 2 * cnt),
    }
}
// op_is_restore — 1 for the restore op only. The one-band count (spec §4.1).
comptime fn op_is_restore(o: RasterOp) -> int {
    return match o {
        SetReg(w)                      => 0,
        Cram(a, cols)                  => 0,
        PalRegion(a, slot, pl, e, cnt) => 0,
        Vsram(a, vals)                 => 0,
        PalRestore(a, cnt)             => 1,
    }
}

// ELABORATION ANCHOR — uncalled comptime fns are never elaborated, so without this a
// broken arm in either helper ships green (proven by poison, Task 4 review). Zero bytes.
// Module-level `let (a, b) = ...` tuple destructuring is not a valid top-level item
// (item() only accepts `comptime enum` / `comptime test` / `comptime fn` after the
// `comptime` keyword — see sigil's parser.rs item()), so the two facts are checked
// inside a tiny helper and pulled to module level through its return value.
comptime fn zz_elaboration_anchor() -> int {
    let (zz_span_a, zz_span_n) = op_cram_span(pal_restore($40, 3))
    ensure(zz_span_a == $40 && zz_span_n == 6 && op_is_restore(pal_restore($40, 3)) == 1 && op_is_restore(RasterOp.SetReg($8C89)) == 0,
           "op_cram_span/op_is_restore elaboration anchor broke — a helper arm is wrong")
    return 1
}
ensure(zz_elaboration_anchor() == 1, "op_cram_span/op_is_restore elaboration anchor broke — a helper arm is wrong")

comptime fn op_mask(o: RasterOp) -> int {
    return match o {
        SetReg(w)             => 0,
        Cram(a, cols)                => 1 << (a >> 5),
        PalRegion(a, slot, pl, e, n) => 1 << (a >> 5),
        // ZERO, and not by omission: a VSRAM op writes no palette, so there is no line to
        // re-assert. `1 << (a >> 5)` on a VSRAM address computes a palette line from a
        // scroll offset — nonsense in general, and at VSRAM offset 0 it yields bit 0, the
        // CHARACTER's CRAM line, which would force a spurious full re-assert of the
        // character palette every single frame. Silent, and per-frame.
        Vsram(a, vals)               => 0,
        // start-line-only is EXACT for a restore because pal_restore() (C-D) refuses spans crossing a 32-byte line — the same reasoning as the Vsram note below, but enforced at the constructor.
        PalRestore(a, cnt)           => 1 << (a >> 5),
    }
}

// op_is_reg — 1 for the one op that writes a register with NO blanking delay, 0 for
// every "stream" op (stream_cram / stream_pal_region / stream_vsram / pal_restore: command longword, EFX_BLANK_DELAY,
// word loop). That split is the runtime's, not a taxonomy: it is what makes both the
// ordering rule (check_mixed_fire) and the stream op ceiling (fire) mean something.
comptime fn op_is_reg(o: RasterOp) -> int {
    return match o {
        SetReg(w)             => 1,
        Cram(a, cols)                => 0,
        PalRegion(a, slot, pl, e, n) => 0,
        Vsram(a, vals)               => 0,
        PalRestore(a, cnt)           => 0,
    }
}

// prog_mask — OR of every op's mask bit.
comptime fn prog_mask(fires: array) -> int {
    comptime var m = 0
    for f in fires {
        for o in fire_ops(f) {
            m = m | op_mask(o)
        }
    }
    return m
}

// ============================================================================
// THE MEASURED PER-FIRE COST MODEL
// Evidence: docs/benchmarks/effects-p3/DENSITY-EVIDENCE.md, "The F-series" (2026-08-16).
// Rig: tools/raster_cost_probe.py.
//
//     fire_cost = RASTER_FIRE_BASE_CYC + sum over ops of
//                 ( fetch + dispatch(depth) + class work + word slope x stream words + tail )
//
// WHAT THE PREDECESSOR GOT WRONG, and it is NOT what the parcel brief predicted. The old
// model was `418 + 36 x stream_words`, summed OVER STREAM OPS ONLY, and it was believed to
// under-charge by ~2x on the strength of a differencing measurement. That measurement was
// contaminated: it read oracle's `interrupts.hint` counter, which in this ROM is
// HBlank + VBlank summed (oracle classifies an interrupt by comparing the handler's entry
// address against $78 and a fixed ROM window; Aeon's VBlank_Handler at $2310 matches
// neither, so it lands in the HInt bucket). Suppressing a record removes VBlank schedule-
// build work as well as the fire, so the "cost of a fire" it produced carried a few hundred
// cycles of VBlank with it. Measured against the per-ROUTINE row instead — which oracle
// keys by that same entry address, so the two handlers are separate rows — the old model's
// two anchors are accurate to within 1.5%: 454 modelled against 458 measured, 526 against
// 518. IT WAS NOT UNDER-CHARGING BY HALF.
//
// It was mis-STRUCTURED, which is a different fault and the one this replaces:
//   1. `reg` ops were charged ZERO, so a reg-only fire was unmodelled and could never be
//      refused. Measured: a fire of one reg_set costs 412 cycles (302 base + 110 SetReg).
//      This read 396 until 2026-08-18 — the RUNGS=4 figure, stale since the chain grew its
//      fifth rung. The F1 pin below is the live authority; see its "was 396 at RUNGS=4" note.
//   2. Every stream op was charged the same, though stream_pal_region costs 48 cycles more
//      than stream_cram at equal word count (a second dispatch rung, a `lea`/`adda` source
//      setup and a `lea` restore).
//   3. Dispatch DEPTH was invisible, so adding an opcode silently re-priced every op behind
//      it with nothing able to see the change.
//   4. The per-fire BASE was charged once per STREAM OP rather than once per fire, so a
//      two-stream-op fire was over-charged by a whole base while a reg-heavy one was charged
//      nothing. Two errors in opposite directions is why the single shape it was fitted to
//      came out right.
//
// EVERY CONSTANT BELOW IS CONFIRMED TWICE, by measurement and by hand-counting the emitted
// 68000 instruction stream (s4.debug.bin $79CC..$7A5C). The dispatch chain is four `beq.s`
// rungs, so a failed rung is `cmpi.w #imm,d1` (8) + `beq.s` not taken (8) = 16 and a matched
// one is 8 + 10 = 18 — the two derivations agree to the cycle on every op term. Only
// RASTER_FIRE_BASE_CYC is measurement-only: the hand count lands ~10 cycles off, inside the
// exception-entry/`movem`/`rte` timings this emulator models and this project cannot check
// against silicon. The measured number is the authority; the fixture pins below are what
// hold it.
//
// An NTSC scanline is 128000/262 = 488.5; 488 is used, floored, so the comparison is
// conservative in the direction that ADMITS rather than refuses.
//
// IT STILL LUMPS VSRAM IN WITH CRAM, AND THAT IS NOW MEASURED RATHER THAN ASSUMED: fixture
// F7 (a 1-word stream_vsram fire) read 458 cycles, byte-for-byte the same as F2's 1-word
// stream_cram fire. The handler is target-agnostic — a VSRAM op IS an OP_CRAM with a
// different command longword — so the two costs are the same instruction path and there is
// nothing to split on the CYCLE side. The open op-class split (booked) is about
// EFX_BLANK_DELAY and the RASTER_CRAM_MAX ceiling, i.e. whether a VSRAM write needs to be
// parked in HBlank at all; if that lands it removes work and only makes fires CHEAPER, so
// nothing this model admits today becomes illegal under it.
pub const RASTER_SCANLINE_CYC       = 488

// The per-fire constant: everything a fire costs that is not an op. The prologue (`ints_off`,
// the movem, the VDP_CTRL lea, the dense-run test), the arm write, the op_count read, the
// loop entry and exit, the epilogue and the `rte`. Measured as F0's two priming fires
// (572 / 2 = 286) plus the 16 cycles a record WITH ops pays over a no-op record — a
// not-taken `bmi` instead of a taken one (+2) and the last op's not-taken `dbf` plus the
// `bra.s .advance` beyond the loop tail already charged per op (+14).
pub const RASTER_FIRE_BASE_CYC      = 302

// The per-op terms. Each op pays all four.
pub const RASTER_OP_FETCH_CYC       = 8      // move.w (a1)+, d1
pub const RASTER_DISPATCH_RUNG_CYC  = 16     // a FAILED rung: cmpi.w #imm,d1 + beq.s not taken
pub const RASTER_DISPATCH_HIT_CYC   = 18     // the MATCHING rung: cmpi.w + beq.s taken
pub const RASTER_OP_TAIL_CYC        = 10     // dbf d0, .op_loop, taken
pub const RASTER_STREAM_WORD_CYC    = 30     // one streamed word: move.w to VDP_DATA + dbf

// Per-class work, dispatch excluded — what the op's own arm does.
//
// SPLIT INTO A SPINLESS BASE + spin_cyc(N) (substrate item 1). The spin used to be folded
// into these constants at its one hand-fitted value; it is now per-op data, so it has to
// be priced per op. The base terms are unchanged EXCEPT that reading the count from the
// stream costs `move.w (a1)+, d1` (8) where `moveq #imm, d1` cost 4 — every stream op is
// 4 cycles dearer, and that is the whole runtime price of the fix.
//
//   reg         : move.w (a1)+, (a2)
//   cram base   : move.l command (20) + spin read (8) + count read (8)
//                 + the stream loop's final not-taken dbf (4)                   = 40
//   region base : all of the above plus lea Pal_Variant_Stage (8, short form)
//                 + adda.w (12) + lea VDP_CTRL restore (12)                     = 72
//   restore base: region's shape, measured spinless at 64 (R1, F8 two-stage), + the
//                 4-cycle stream read                                           = 72
//
// Cross-check against the pre-split constants, which were measured: cram 40 + spin_cyc(4)
// = 40 + 54 = 94, i.e. the old 90 plus the 4-cycle read. Region 72 + 54 = 126 = old 122
// + 4. Restore 72 + spin_cyc(13) = 72 + 144 = 216 = old 212 + 4. All three move by the
// same +4 and by nothing else, which is what makes the wire change auditable.
const RASTER_WORK_REG_CYC           = 12
const RASTER_WORK_CRAM_BASE_CYC     = 40
const RASTER_WORK_REGION_BASE_CYC   = 72
// The restore body: region's shape, spinless base.
// MEASURED 2026-08-17 (claim 9 CLOSED), in two stages: the spinless body read 556.0/fire
// (3 boots, spread 0 — work exactly the derived 122 - 58 = 64, hand-verified 20+8+8+12+
// 4+12); the §7.3 landing capture then calibrated the spin (zero delay landed the burst
// at x~180 of the row ABOVE the authored edge), giving 64 + (moveq 4 + 13*10 + 14
// expired) = 212 — F8 re-measured at 704/fire after calibration, again spread 0.
// Evidence: docs/benchmarks/effects-r1/.
//
// That measured 64 is a SPINLESS base and survives the split intact; the +8 below is the
// stream read replacing the moveq, so the restore's total at its shipped spin of 13 is
// 72 + spin_cyc(13) = 216, the old 212 plus the same +4 every stream op now pays.
const RASTER_WORK_RESTORE_BASE_CYC = 72

// ---- dispatch depth ---------------------------------------------------------
// Raster_HInt tests opcodes in ASCENDING order — OP_CRAM, OP_PAL_REGION, OP_RUN_GRADIENT,
// OP_RUN_RAMP — with OP_SET_REG as the fall-through, so an op's depth is derivable from its
// opcode: (opcode - OP_CRAM) / 2 rungs failed before its own. THAT is what makes the model
// re-price automatically when an opcode is inserted: a new dense op between the region and
// gradient rungs pushes every later op one rung deeper AND lengthens the fall-through, and
// both fall out of the pin below rather than needing an edit here.
//
// LITERALS with a module-level pin, per this module's opening note — these are named inside
// comptime fn bodies, and a body's free names resolve at the CALL SITE, so a value spelled
// as an arithmetic expression over the IMPORTED opcodes would not resolve in an author's
// module. The pin is what keeps the literals honest.
pub const RASTER_DISPATCH_RUNGS     = 5      // chain length; OP_SET_REG falls through all of it
const RASTER_DEPTH_CRAM             = 0      // rungs FAILED before this op matches
const RASTER_DEPTH_REGION           = 1
const RASTER_DEPTH_RESTORE          = 4      // rungs FAILED before this op matches
// TRAP for opcode 12's author: this pin names the LAST opcode BY NAME. Appending
// past OP_PAL_RESTORE leaves it green while the chain grows — it must be re-spelled
// against the new last opcode, and F1/F5 re-measured, or every SetReg is silently
// under-charged by 16 cyc/rung (the exact miss the R1 sweeps caught here once already).
// AND check the new rung's beq still assembles .s — the restore target sits at disp $76 of $7F; opcode 12's own rung will be past the byte cliff (Bcc.w not-taken = 20, a 4-cyc mispricing the pin cannot see).
// If the chain is ever REORDERED (not appended), this whole derivation dies — each depth must be spelled by hand against Raster_HInt's compare sequence.
ensure(RASTER_DEPTH_CRAM == (OP_CRAM - OP_CRAM) / 2 && RASTER_DEPTH_REGION == (OP_PAL_REGION - OP_CRAM) / 2 && RASTER_DEPTH_RESTORE == (OP_PAL_RESTORE - OP_CRAM) / 2 && RASTER_DISPATCH_RUNGS == (OP_PAL_RESTORE - OP_CRAM) / 2 + 1,
       "dispatch depth pins drifted from the opcode chain — update these FOUR literals together (and re-measure F1/F5: the SetReg fall-through pays every rung)")

comptime fn op_dispatch_cyc(o: RasterOp) -> int {
    return match o {
        // The fall-through pays every rung and no matching branch at all.
        SetReg(w)                    => RASTER_DISPATCH_RUNG_CYC * RASTER_DISPATCH_RUNGS,
        Cram(a, cols)                => RASTER_DISPATCH_RUNG_CYC * RASTER_DEPTH_CRAM + RASTER_DISPATCH_HIT_CYC,
        PalRegion(a, slot, pl, e, n) => RASTER_DISPATCH_RUNG_CYC * RASTER_DEPTH_REGION + RASTER_DISPATCH_HIT_CYC,
        // A Vsram op EMITS OP_CRAM (see stream_vsram), so it dispatches at the cram rung.
        Vsram(a, vals)               => RASTER_DISPATCH_RUNG_CYC * RASTER_DEPTH_CRAM + RASTER_DISPATCH_HIT_CYC,
        PalRestore(a, cnt)           => RASTER_DISPATCH_RUNG_CYC * RASTER_DEPTH_RESTORE + RASTER_DISPATCH_HIT_CYC,
    }
}

// The spin is per-op DATA now, so the work term is base + the spin the op actually
// carries. Keeping the two visibly separate is what stops the spin from silently
// re-entering the constants the way it did before.
comptime fn op_work_cyc(o: RasterOp) -> int {
    return match o {
        SetReg(w)                    => RASTER_WORK_REG_CYC,
        Cram(a, cols)                => RASTER_WORK_CRAM_BASE_CYC + spin_cyc(RASTER_SPIN_CRAM),
        PalRegion(a, slot, pl, e, n) => RASTER_WORK_REGION_BASE_CYC + spin_cyc(RASTER_SPIN_REGION),
        Vsram(a, vals)               => RASTER_WORK_CRAM_BASE_CYC + spin_cyc(RASTER_SPIN_CRAM),
        PalRestore(a, cnt)           => RASTER_WORK_RESTORE_BASE_CYC + spin_cyc(RASTER_SPIN_RESTORE),
    }
}

// op_cost_cycles — one op's whole contribution, dispatch included.
comptime fn op_cost_cycles(o: RasterOp) -> int {
    return RASTER_OP_FETCH_CYC + op_dispatch_cyc(o) + op_work_cyc(o) + RASTER_STREAM_WORD_CYC * op_stream_words(o) + RASTER_OP_TAIL_CYC
}

// RASTER_MAX_PATCH — patchable channels per program. DEFINED HERE on purpose: this module
// is a COMPTIME_HELPERS member, so a name defined here is glob-injected into every module
// (engine.effects.raster and engine.ram included) AND is safe to spell inside a comptime fn
// body. A constant imported FROM raster.emp would be neither — imports do not travel into a
// body, and this codebase has a measured case of that collapsing a range to empty and
// silently emitting zero fires.
//
// FOUR IS NOT A RAM DECISION. The binding constraint is the BAND BUDGET under density:
// disjoint bands over screen lines 3..223 must satisfy sum(hi_i - lo_i + 1) + (N-1) <= 221,
// so four channels each free to traverse the screen is not expressible — one water line with
// 200px of travel spends the budget alone. Raising this without widening the band budget buys
// nothing.
pub const RASTER_MAX_PATCH = 4
// The runtime patcher masks a channel index with RASTER_MAX_PATCH - 1, which is only an index
// bound for a power of two.
ensure((RASTER_MAX_PATCH & (RASTER_MAX_PATCH - 1)) == 0,
       "RASTER_MAX_PATCH must be a power of two — the runtime patcher masks the channel index with RASTER_MAX_PATCH minus 1, which only bounds the index for a power of two")

// PATCH_ANCHOR_NONE — the world Y a preset gives a patch channel it does not use.
//
// LARGE AND POSITIVE, not 0, and the reason is Parcel W's parallax overlay: it derives a
// screen line as `anchor - Camera_Y`, so a 0 anchor reads as -Camera_Y, i.e. ABOVE the
// screen top, i.e. "fully submerged" — the most invasive possible state as the default for
// a channel nobody asked for. $7FFF keeps the subtraction positive for every real camera Y
// (no sign flip) and lands in the off-screen-below branch, which is the inert answer.
// The raster patcher itself is indifferent: it only walks channels a live patch table names.
pub const PATCH_ANCHOR_NONE = $7FFF

// fire_cost_cycles — modelled cost of one fire: the per-fire constant ONCE, plus every op.
// EVERY op, reg_set included — the predecessor summed over stream ops only, which is why a
// fire of nothing but register writes modelled at zero and could not be refused however many
// it carried.
comptime fn fire_cost_cycles(f: RasterFire) -> int {
    comptime var c = RASTER_FIRE_BASE_CYC
    for o in fire_ops(f) {
        c = c + op_cost_cycles(o)
    }
    return c
}

// ---- THE FIXTURE PINS -------------------------------------------------------
// The model against every point it was built from. These are the whole reason the constants
// above may be trusted: eight measurements, four free parameters, and ZERO residual — the
// model reproduces all seven fire shapes exactly, so it is not a curve fitted through its own
// anchors the way `418 + 36 x words` was (that one had two anchors and two parameters, so it
// could not fail to reproduce them and had never been tested against a third shape).
//
// Rig: tools/raster_cost_probe.py, s4.debug.bin, oracle, 2026-08-16. Each figure is
// (fixture total - F0 total) / fire count, read off the profiler's PER-ROUTINE row for the
// HBlank trampoline — never `interrupts.hint`, which in this ROM is HBlank + VBlank summed.
// FIVE independent boots per fixture agreed to the CYCLE (spread 0 on all eight), so there is
// no noise floor to allow for and no difference here is within one.
//
// Each pin names its fixture so a failure says which measurement the change contradicts.
//
// RE-PINNED 2026-08-18 (substrate item 1), and every value below marked is
// exactly that until the probe re-runs: moving the blanking spin into the program stream
// replaced `moveq #imm, d1` (4 cyc) with `move.w (a1)+, d1` (8 cyc), so EVERY STREAM OP
// COSTS +4 AND NOTHING ELSE MOVES. The deltas are therefore a count of stream ops, and
// that is the claim the re-measurement tests:
//   F1 412 -> 412  (no stream op)      F5 628 -> 632  (1)
//   F2 458 -> 462  (1)                 F6 614 -> 622  (2 — the only two-op fixture)
//   F3 518 -> 522  (1)                 F7 458 -> 462  (1)
//   F4 566 -> 570  (1)                 F8 704 -> 708  (1)
// F1 staying PUT is the load-bearing half: OP_SET_REG streams nothing, so if it had moved,
// the change leaked somewhere it had no business going. It measured 412.0, unmoved.
//
// F3 and F5 were re-measured at FEWER fires (6->5 and 5->4): the wider stream ops pushed
// the old counts past RASTER_BUF_SIZE. They reproduce the same per-fire figures at the new
// counts, which is an independent check on the (fixture - F0)/n marginal method itself.
ensure(fire_cost_cycles(fire(3, [reg_set($8C81)])) == 412,
       "cost model vs fixture F1 (one reg_set): model says {fire_cost_cycles(fire(3, [reg_set($8C81)]))}, measured 412")  // measured 2026-08-17 at RUNGS=5, 3 boots spread 0 (was 396 at RUNGS=4)
ensure(fire_cost_cycles(fire(3, [stream_cram($22, [0])])) == 462,
       "cost model vs fixture F2 (stream_cram, 1 word): model says {fire_cost_cycles(fire(3, [stream_cram($22, [0])]))}, measured 462")
ensure(fire_cost_cycles(fire(3, [stream_cram($22, [0, 0, 0])])) == 522,
       "cost model vs fixture F3 (stream_cram, 3 words): model says {fire_cost_cycles(fire(3, [stream_cram($22, [0, 0, 0])]))}, measured 522")
ensure(fire_cost_cycles(fire(3, [stream_pal_region($22, 0, 1, 1, 3)])) == 570,
       "cost model vs fixture F4 (stream_pal_region, 3 words): model says {fire_cost_cycles(fire(3, [stream_pal_region($22, 0, 1, 1, 3)]))}, measured 570")
ensure(fire_cost_cycles(fire(3, [reg_set($8C81), stream_cram($22, [0, 0, 0])])) == 632,
       "cost model vs fixture F5 (reg_set + stream_cram 3): model says {fire_cost_cycles(fire(3, [reg_set($8C81), stream_cram($22, [0, 0, 0])]))}, measured 632 — a mixed fire IS additive, so this failing means the per-op decomposition is wrong, not the mixing rule")  // measured 2026-08-17 at RUNGS=5, 3 boots spread 0 (was 612 at RUNGS=4)
ensure(fire_cost_cycles(fire(3, [stream_cram($22, [0]), stream_cram($26, [0])])) == 622,
       "cost model vs fixture F6 (two 1-word stream_cram ops in one fire): model says {fire_cost_cycles(fire(3, [stream_cram($22, [0]), stream_cram($26, [0])]))}, measured 622 — this is the pin that separates the PER-FIRE constant from the PER-OP cost, so a failure here means one of the two absorbed the other")
ensure(fire_cost_cycles(fire(3, [stream_vsram(2, [0])])) == 462,
       "cost model vs fixture F7 (stream_vsram, 1 word): model says {fire_cost_cycles(fire(3, [stream_vsram(2, [0])]))}, measured 462 — identical to F2, which is the measurement behind charging a VSRAM word exactly what a colour word costs")
ensure(fire_cost_cycles(fire(3, [pal_restore($22, 3)])) == 708,
       "cost model vs fixture F8 (pal_restore, 3 words): model says {fire_cost_cycles(fire(3, [pal_restore($22, 3)]))}, measured 708 (calibrated body) — claim 9 closed: the restore's work constant is the measured one, and this pin is what keeps the band() minima honest")  // measured 2026-08-17, 3 boots spread 0
// F0 is the per-fire base's own anchor and cannot be spelled as a `fire` (a fire with no ops
// is refused). Its two priming records read 572 cycles, i.e. 286 per no-op record; the +16 to
// RASTER_FIRE_BASE_CYC is derived in that constant's note above.
ensure(RASTER_FIRE_BASE_CYC == 572 / 2 + 16,
       "RASTER_FIRE_BASE_CYC no longer derives from fixture F0 (572 cycles for two priming records) plus the 16 cycles a record WITH ops pays over a no-op one")

// ---- WHICH SIDE OF THE LINE, both directions ---------------------------------
// A cost model is only a guard if something falls on each side of it. These state, as build-
// time facts, exactly what check_density admits and refuses — so a change that quietly made
// the guard accept everything (or nothing) fails HERE, with a sentence saying which case
// moved, instead of showing up as content that renders wrong or content that stopped
// building. Zero ROM bytes: `fire` and `fire_cost_cycles` are both comptime.
//
// REFUSED — a 3-colour stream_cram fire does not finish inside one scanline. This is the
// measured overrun the guard exists for: the next fire's writes are pushed into active
// display and paint a visible mid-row colour change (DENSITY-EVIDENCE rows 111-113).
ensure(fire_cost_cycles(fire(3, [stream_cram($22, [0, 0, 0])])) > 1 * RASTER_SCANLINE_CYC,
       "a 3-colour stream_cram fire now models at {fire_cost_cycles(fire(3, [stream_cram($22, [0, 0, 0])]))} cycles, which FITS inside one {RASTER_SCANLINE_CYC}-cycle scanline — so check_density would admit two of them on consecutive lines, the exact overrun it was built to refuse")
// ADMITTED — the same fire two scanlines apart. If this flips, the guard has become
// unsatisfiable and every colour boundary in the tree is now a build error.
ensure(fire_cost_cycles(fire(3, [stream_cram($22, [0, 0, 0])])) <= 2 * RASTER_SCANLINE_CYC,
       "a 3-colour stream_cram fire now models at {fire_cost_cycles(fire(3, [stream_cram($22, [0, 0, 0])]))} cycles, which does NOT fit in two scanlines — check_density has become unsatisfiable for the shape the whole sparse tier is built around")
// REFUSED — and this one is the behaviour change. A fire of four register writes carries no
// stream word at all, so the retired model scored it ZERO and could never refuse it however
// many registers it wrote. It costs more than a scanline.
ensure(fire_cost_cycles(fire(3, [reg_set($8C81), reg_set($8C81), reg_set($8C81), reg_set($8C81)])) > RASTER_SCANLINE_CYC,
       "a four-reg_set fire models at {fire_cost_cycles(fire(3, [reg_set($8C81), reg_set($8C81), reg_set($8C81), reg_set($8C81)]))} cycles, inside one scanline — reg ops have stopped costing anything again, which is the exact hole this model was written to close")
// ADMITTED — one register write is cheap, and must stay so: fx_sh_below is a single reg_set
// and is the cheapest dramatic effect the hardware has.
ensure(fire_cost_cycles(fire(3, [reg_set($8C81)])) <= RASTER_SCANLINE_CYC,
       "a single reg_set fire models at {fire_cost_cycles(fire(3, [reg_set($8C81)]))} cycles, past a whole scanline — fx_sh_below would no longer compose with anything")

// check_intervals — GUARD 2, the invariant every other property rests on. Stated ONCE, in
// FIRE-LINE space, matching fire_lines: each record has a possible fire-line interval, a
// point [L, L] for a static fire and [lo-1, hi-1] for a patchable one, and the intervals
// must be strictly ascending and disjoint. Priming records occupy fire lines 0 and 1, so the
// walk starts at prev_hi = 1.
//
// WHAT A VIOLATION DOES, and why the message says so: the runtime patcher stores
// L[k] - L[k-1] - 1 as the LOW BYTE of an $8Axx arm word. Two records able to reach the same
// fire line make that -1, whose byte is $FF — and $8AFF is RASTER_ARM_PARK. So an overlap of
// a single line does not merely mis-place a boundary, it parks the counter and kills every
// remaining fire in the frame, with no other symptom.
//
// OVERLAP IS DESIGNED, NOT IMPOSSIBLE (owner ruling 2026-08-17: banked, demand-pull). If you
// are here because you WANT two patchable bands to overlap: a complete, three-times-swept
// runtime collision-resolution design exists and is revival-ready —
// docs/superpowers/specs/2026-08-17-effects-tail-design-v3.md (r3.1). Do NOT weaken this
// guard ad hoc; the design exists precisely because every naive relaxation was proven unsound
// (three adjudications, 38 accepted defects, incl. two latent regressions a green test suite
// would not have caught). Revival condition: a real program (Parcel D was the expected one)
// that needs overlapping patchable bands. See also DEFERRED_WORK.md "Effects tail Part A".
comptime fn check_intervals(fires: array) -> int {
    comptime var prev_hi = 1                     // priming record 1 sits at fire line 1
    for f in fires {
        let lo_fl = fire_band_lo(f) - 1
        let hi_fl = fire_band_hi(f) - 1
        ensure(lo_fl > prev_hi,
               "raster program: the record reachable at fire lines {lo_fl}..{hi_fl} can collide with the previous record, which reaches up to fire line {prev_hi}. Records must occupy STRICTLY ASCENDING, DISJOINT fire-line intervals (a static fire's interval is its own line; a patchable fire's is its band). This is not a tidiness rule: the arm gap is stored as the low byte of an $8Axx word, so two records on one fire line make the gap -1, whose byte is $FF — the PARK word. That kills every fire after it in the frame, silently. IF YOU NEED OVERLAPPING PATCHABLE BANDS: a swept runtime-resolution design is banked and revival-ready — docs/superpowers/specs/2026-08-17-effects-tail-design-v3.md (r3.1). Do not relax this guard by hand; every naive relaxation was proven unsound there.")
        prev_hi = hi_fl
    }
    return 0
}

// check_density — a fire must finish before the next one is due. The budget between two
// fires is the number of scanlines between them. Overrunning does NOT drop the next fire
// (the counter is already armed) but pushes its writes into active display, which is
// measured as a visible mid-row colour change (DENSITY-EVIDENCE rows 111-113, transitions
// at x = 232/248/294 of 320). The last fire has nothing after it and is unconstrained.
//
// THIS CANNOT LIVE IN `fire`. Density is a property of the SCHEDULE — one fire cannot see
// its neighbour — which is exactly why the per-fire ceilings above could not catch it.
//
// IT IS NOW A WORST-CASE CHECK, and that took no branch. The gap is measured from this
// record's HIGHEST reachable fire line to the next record's LOWEST — and because a static
// fire's band is its own line, the formula reduces to exactly the old authored-line
// difference for a program with no patchable records. Bytes for static programs are
// unchanged.
//
// WITHOUT THIS, THE GUARD GOES VACUOUS THE MOMENT A FIRE CAN MOVE. Two channels banded
// 40..120 and 121..200 with authored lines 100 apart pass the AUTHORED-line check trivially
// (gap 100 lines) and then clamp to 120 and 121 at runtime — one scanline apart, two
// 3-word stream_cram fires at a measured 518 cycles against a 488-cycle line, which is
// precisely the overrun this guard exists to refuse.
comptime fn check_density(fires: array) -> int {
    comptime var i = 0
    for f in fires {
        if i + 1 < fires.len {
            let this_hi = fire_band_hi(f) - 1
            let next_lo = fire_band_lo(fires[i + 1]) - 1
            let gap  = next_lo - this_hi
            let cost = fire_cost_cycles(f)
            // The message names the BAND EDGES as well as the authored lines, because those
            // are the two numbers that explain each other. Measured against the arithmetic
            // alone the diagnostic reads absurdly for a patchable pair — "only 1 scanline
            // remains" between fires authored 130 lines apart — since the 1 scanline is
            // between the edges the records can actually reach, not between where they sit
            // today. For an all-static program the edges ARE the authored lines and the two
            // halves of the sentence agree, which is why this went unnoticed until a fire
            // could move.
            ensure(cost <= gap * RASTER_SCANLINE_CYC,
                   "raster program: the fire at screen line {fire_screen_line(f)} models at {cost} cycles but only {gap} scanline(s) = {gap * RASTER_SCANLINE_CYC} cycles remain before the fire at {fire_screen_line(fires[i + 1])}. The gap is measured WORST CASE, between the fire lines these two records can actually reach — {this_hi} and {next_lo} — which for a patchable record is its band edge, not the line it is authored at. MEASURED 2026-08-16: a 3-colour stream_cram fire costs 518 cycles against a 488-cycle line, so consecutive colour fires overrun and paint a visible mid-line colour change. The cost above counts EVERY op including reg_set, each op's dispatch depth in Raster_HInt's compare chain, and the per-fire constant exactly once — so it is a whole-fire figure and not a floor. Either space these fires further apart, drop an op from this fire, or move per-line colour work to the DENSE tier (raster_gradient_program), which stays inside ONE interrupt instead of paying an exception entry per line — that is how S3K writes 3 colours per line at 484.")
        }
        i = i + 1
    }
    return 0
}

// fire_lines — the full fire-line list: the two priming fires on lines 0 and 1, then
// one per authored event at (screen line - 1). Ruling 1a: the event fire must be at
// M-1 so its writes land on M. This is the SPARSE rule; the dense tier's T-1 setup
// line is a different, measured fact and must not be applied here.
comptime fn fire_lines(fires: array) {
    comptime var out = [0, 1]
    comptime var prev = 1
    for f in fires {
        let fl = fire_screen_line(f) - 1
        ensure(fl > prev,
               "raster program: fires must be in strictly ascending screen-line order, and two events cannot share a fire line (fire line {fl} follows {prev})")
        out = out ++ [fl]
        prev = fl
    }
    return out
}

// arm_at — the arm word for record i. Ruling 1b: the word WRITTEN at record i is
// consumed at the next reload and schedules gap(L[i+1] -> L[i+2]); past the end it
// parks the counter 255 lines away, i.e. never within active display.
// BOTH HALVES OF THE OLD PER-CALL ensure WERE UNREACHABLE, so it is gone and the fact it
// was reaching for is asserted ONCE, at module level, against the bounds that make it true
// (see RASTER_FIRE_SPAN below). `gap <= 255` could not fire because `fire` bounds screen
// lines to 3..223, capping any gap at 220; `gap >= 0` could not fire because
// raster_program calls fire_lines FIRST, and fire_lines already ensures strict ascent.
// A guard that cannot fire is not free — this codebase has a documented history of them,
// and each one reads as protection that is not there. The module-level version DOES fire
// if someone raises the screen-line ceiling, which is the only way the fact can break.
comptime fn arm_at(L: array, i: int) -> int {
    if i + 2 >= L.len { return $8AFF }
    return $8A00 | (L[i + 2] - L[i + 1] - 1)
}

// check_mixed_fire — ruling 14. In a fire mixing OP_SET_REG with a stream op, the
// SET_REGs must form a PREFIX: every one of them before every stream op. OP_SET_REG
// writes with no delay while every stream op burns EFX_BLANK_DELAY first, so a SET_REG
// placed after one executes strictly later in the line — a worse artifact than the measured
// one, and invisible to an author.
//
// THE PREDICATE IS A PREFIX TEST, not "a SetReg is first". The original spelling
// (`first_set == 0`) passed `[reg_sh_on(), stream_pal_region(..), reg_set(..)]` — two SetRegs, the
// first at index 0, the second running after the CRAM op, i.e. exactly the ordering this
// guard exists to forbid — and then reported "it is at index 0", which pointed at the one
// op that was fine. Test the LAST SetReg against the FIRST stream op.
comptime fn check_mixed_fire(f: RasterFire) -> int {
    comptime var n_set = 0
    comptime var n_cram = 0
    comptime var last_set = -1
    comptime var first_cram = -1
    comptime var i = 0
    for o in fire_ops(f) {
        if op_is_reg(o) == 1 {
            n_set = n_set + 1
            last_set = i
        }
        if op_is_reg(o) == 0 {
            n_cram = n_cram + 1
            if first_cram < 0 { first_cram = i }
        }
        i = i + 1
    }
    ensure(n_set == 0 || n_cram == 0 || last_set < first_cram,
           "raster fire at screen line {fire_screen_line(f)}: in a mixed fire EVERY OP_SET_REG must precede EVERY stream op, but the SET_REG at index {last_set} runs after the stream op at index {first_cram}. A mixed fire already switches its mode register ~45% across the line (measured, engine/effects/raster.emp, the row-119 note); a SET_REG placed after a stream op is pushed strictly later still, because those ops burn EFX_BLANK_DELAY and SET_REG does not. Move the register writes to the front of the op list, or schedule a pixel-clean mode change a line earlier.")
    return 0
}

// ---- the two public entry points --------------------------------------------

// raster_words — the word count, computed from op_size. Use it as the length
// annotation on the `pub data`:
//     pub data P: [u16; raster_words(PROG)] = raster_program(PROG)
// NOT `[u16; PROG.len] = PROG`, which is tautological. Note the guard only bites on a
// `data` declaration — `const` does not enforce its declared array length.
pub comptime fn raster_words(fires: array) -> int {
    comptime var n = 1 + 4 + 2            // mask, two priming records, terminator
    for f in fires {
        n = n + 2                          // the record's arm word + op_count
        for o in fire_ops(f) {
            n = n + op_size(o)
        }
    }
    return n
}

// raster_program — the flat program. Header, two priming records, one record per
// authored fire in ascending screen-line order, terminator.
pub comptime fn raster_program(fires: array) {
    ensure(fires.len >= 1, "raster_program: a program with no fires — use Raster_Program_None")
    let L = fire_lines(fires)
    check_intervals(fires)
    check_density(fires)
    // GUARD 11 — one patchable record per channel. Raster_GetChannelBand answers with the FIRST
    // record matching a channel, so a second record on the same channel is invisible to the
    // parallax overlay: past the first record's band the scroll boundary would follow one record
    // while the palette follows the other. The runtime cannot disambiguate two answers to "where
    // is channel N", so this is refused at build time rather than resolved at runtime.
    //
    // A BITMASK, NOT AN INDEXED ARRAY: this evaluator's `Assign` target is a bare path
    // (parser.rs stmt(), the `path = expr` arm) with no indexing form, so `ch_seen[c] = 1`
    // does not parse here — only a whole-variable reassignment does (the same reason
    // `prog_mask` above accumulates through `m = m | ...` rather than into a table). A
    // per-channel seen-bit folds into that same shape: `ch_mask | (1 << c)` is one plain
    // reassignment, and the read is `(ch_mask & (1 << c)) == 0`, so no index-assignment is
    // needed at all. RASTER_MAX_PATCH is small (4, asserted a power of two above) and
    // `patchable`'s own guard already bounds every channel to 0..RASTER_MAX_PATCH-1
    // (raster_dsl.emp, the `patchable` ensure against RASTER_MAX_PATCH), so the mask never
    // needs more bits than that ceiling provides.
    comptime var ch_mask = 0
    for f in fires {
        if fire_is_patch(f) == 1 {
            let c = fire_channel(f)
            let bit = 1 << c
            ensure((ch_mask & bit) == 0,
                   "raster program: two patchable records both drive channel {c}. Raster_GetChannelBand returns the first match, so the parallax overlay would follow one record while the palette follows the other. Give them separate channels.")
            ch_mask = ch_mask | bit
        }
    }
    // ---- E-D: the reg $0F scan, tree-wide (spec §4.2b) ------------------------
    // UNCONDITIONAL — outside the band block below, because a stride change voids
    // op_cram_span and op_mask for every program, band or no band. reg_set already
    // refuses this word with a better sentence; this is the layer underneath it, for
    // the ops that never went through reg_set. `RasterOp` is `pub` (the match arms are
    // the wire contract), so `RasterOp.SetReg($8F04)` is a spelling the language admits
    // and the constructor cannot see.
    //
    // op_reg_word is 0 for every non-SetReg op, and 0 >> 8 is 0, so this is total over
    // the enum without a second match.
    //
    // The same clause applies to reg $0A, the SCHEDULE's own register (Task 8 review,
    // spec §4.2b precedent: constructor-only refusals are not refusals — the $8F/$8A
    // precedent). `RasterOp.SetReg($8A05)` bypasses reg_set's ban exactly the way
    // `RasterOp.SetReg($8F04)` does, and here the payload is not merely a voided span
    // computation — it is the arm word Raster_HInt just wrote for THIS fire, clobbered
    // before the next reload, which detonates the relative-arm chain for every fire
    // remaining in the frame.
    for f in fires {
        for o in fire_ops(f) {
            ensure((op_reg_word(o) >> 8) != $8F,
                   "raster_program: an op writes reg $0F (autoincrement) at line {fire_screen_line(f)} — refused tree-wide; direct RasterOp.SetReg construction bypasses reg_set's ensure, this scan is the layer that cannot be dodged (spec §4.2b, claim E-D)")
            ensure((op_reg_word(o) >> 8) != $8A,
                   "raster_program: an op writes reg $0A — the SCHEDULE's register (the arm word the encoder just wrote); a direct RasterOp.SetReg($8Axx) bypasses reg_set's ban and detonates the relative-arm chain from that fire down (spec §4.2b precedent: constructor-only refusals are not refusals)")
        }
    }

    // ---- 8a: ONE BAND PER PROGRAM (spec §4.1) --------------------------------
    // The count comes FIRST of the band guards because every one that follows is
    // written in the singular: "the restore", "its partner", "the restore's line".
    // With two restores in a program those phrases name nothing, so the composition
    // guard below is gated on this count being exactly 1 rather than trying to
    // adjudicate a set. This is a REFUSAL, not a limitation of the encoder — the
    // wire format would happily carry two — because a second band's ON op and its
    // OFF edge cannot be checked against each other by span alone once two restores
    // compete for the same partner candidates.
    comptime var restore_n = 0
    for f in fires { for o in fire_ops(f) { restore_n = restore_n + op_is_restore(o) } }
    ensure(restore_n <= 1,
           "raster_program: {restore_n} restore ops — one band per program (spec §4.1). The FIRST restore in authored order is the one every later diagnostic describes; ensure is non-aborting, so fix this count first.")

    if restore_n == 1 {
        // Gating on ==1 deviates from spec §4.1's "two clean diagnostics" sentence
        // DELIBERATELY: a two-restore program reports only the count (one clean
        // diagnostic beats two half-relevant ones); consequence: the r_line == -1
        // first-restore selector below can never select among candidates —
        // unreachable-by-construction, kept for the day the gate relaxes.
        // ---- C-A: the equal-span-partner composition guard (spec §4.2). ----
        // GROUNDING, load-bearing: patchable fire lines MOVE at runtime; this guard's
        // earlier/later comparison is sound ONLY because check_intervals forces strictly
        // ascending disjoint band intervals, so every reachable line of a patchable
        // record stays on one side of the restore. FALSIFIER: any relaxation of
        // check_intervals silently voids this guard.
        comptime var r_line = -1
        comptime var r_a = -1
        comptime var r_b = 0
        comptime var r_patch = 0
        for f in fires {
            for o in fire_ops(f) {
                if op_is_restore(o) == 1 && r_line == -1 {
                    r_line = fire_screen_line(f)
                    let (sa, sb) = op_cram_span(o)
                    r_a = sa
                    r_b = sb
                    r_patch = fire_is_patch(f)
                }
            }
        }
        // Rule 6 half 1 (claim E-A): the restore's OWN fire is static — a patchable
        // restore record hits .suppress above band_hi and the tint runs to the bottom
        // of the screen, silently (sweep 5 K1, raster.emp .suppress).
        ensure(r_patch == 0,
               "raster_program: the restore's carrying fire must be static — a patchable restore is the split spelling of a moving-bottom band, whose suppressed restore leaves the tint running to screen bottom (spec §4.2 rule 6)")
        // isect_earlier — NOT a count of equal-span partners. It tallies every
        // strictly-earlier op whose span INTERSECTS the restore's, whether or not it
        // passed the equal-span ensure just above (ensure is non-aborting, so a failed
        // ensure does not stop the increment). A true partner is one instance of this
        // set; an intersecting-but-unequal "would bury" op is another. The final ensure
        // below reports this raw count, not a partner count — see its message.
        comptime var isect_earlier = 0
        for f in fires {
            for o in fire_ops(f) {
                if op_is_restore(o) == 0 {
                    let (sa, sb) = op_cram_span(o)
                    if sa >= 0 && sa < r_a + r_b && r_a < sa + sb {
                        // Same-line intersection: order-decided winner. REDUNDANT once
                        // D-B ships — it can never refuse a program D-B does not already
                        // refuse (both fire together; probed in the Task 8 review) —
                        // kept because deleting it couples C-A's completeness to D-B's
                        // continued existence.
                        ensure(fire_screen_line(f) != r_line,
                               "raster_program: a CRAM op on the restore's own line {r_line} — the merge order would decide which write wins (spec §4.2)")
                        if fire_screen_line(f) < r_line {
                            ensure(sa == r_a && sb == r_b,
                                   "raster_program: the op at line {fire_screen_line(f)} intersects the restore's span but is not its equal-span partner — the restore writes BASE and would bury it from line {r_line} down (spec §4.2)")
                            // Rule 6 half 2: the partner is static too (a patchable
                            // partner is the split spelling of a moving-TOP band).
                            ensure(fire_is_patch(f) == 0,
                                   "raster_program: the restore's partner at line {fire_screen_line(f)} must be static — a patchable partner is the split spelling of a moving-top band (spec §4.2 rule 6)")
                            isect_earlier = isect_earlier + 1
                        }
                    }
                }
            }
        }
        ensure(isect_earlier == 1,
               "raster_program: {isect_earlier} strictly-earlier op(s) intersect the restore's span at line {r_line} — at most one may exist and it must be the equal-span partner (its own ON op; zero = base-over-base authoring nonsense, two+ = one of them gets buried) (spec §4.2)")

        // ---- D-B: the restore's fire is a SINGLE-OP fire (spec §4.2a) ----------
        // Not a tidiness rule and not covered by the per-fire ceilings above: two ops
        // is legal for every other fire in the tree. What is special about this one is
        // that the restore has no EFX_BLANK_DELAY of its own — its landing inside the
        // blanking bracket is calibrated as the FIRST thing the record does (spec
        // §3.2) — so anything ahead of it spends the bracket and nothing behind it can
        // give the time back. This is also what deadens the same-line ensure above.
        for f in fires {
            comptime var has_r = 0
            comptime var n_ops = 0
            for o in fire_ops(f) {
                has_r = has_r + op_is_restore(o)
                n_ops = n_ops + 1
            }
            ensure(has_r == 0 || n_ops == 1,
                   "raster_program: the fire at line {fire_screen_line(f)} carries the restore plus {n_ops - 1} other op(s) — the restore's fire carries the restore ONLY: a SetReg ahead of it costs 110 cyc no delay can recover, and a second stream op races it for the one measured HBlank slot (spec §4.2a, claim D-B). S/H bands end with the static de-mix pair: reg_set a line above, restore alone on the bottom line.")
        }

        // ---- CLAIM 6: no band in a program that ships (spec §4.3) --------------
        // NOT a span or interval property, which is why C-A cannot see it and this is
        // a separate walk: the two can be disjoint in both and still be incompatible.
        // On a shipping frame the frame-top DMA has already put VARIANT colours in
        // CRAM while Palette_Ship_Snap — what the restore streams — still holds BASE.
        for f in fires {
            ensure(fire_offscreen_ship(f) == 0,
                   "raster_program: a band cannot share a program with an offscreen_ship fire — on a shipping frame CRAM holds VARIANT colours while the snapshot holds BASE, so the restore would paint the dry palette over a submerged screen (spec §4.3). Note: this excludes Sec0 (OJZ_TwoChannel) from bands — doubly: its [3,220] channel band also leaves no legal interval (spec §4.3).")
        }
    }

    // The header is ONE word. arm0 therefore sits at word 1 (byte offset 2) for every
    // program without exception — which is what lets patch_table pre-resolve a rec_off at all,
    // and what makes the builder's fixed 5-word prologue (header + both priming records) a
    // constant rather than a computed skip.
    comptime var out = [prog_mask(fires)]
    out = out ++ [arm_at(L, 0), 0]        // fire 0 — priming, line 0
    out = out ++ [arm_at(L, 1), 0]        // fire 1 — priming, line 1
    comptime var i = 0
    for f in fires {
        check_mixed_fire(f)
        comptime var body = []
        for o in fire_ops(f) {
            body = body ++ op_words(o)
        }
        out = out ++ [arm_at(L, i + 2), fire_ops(f).len] ++ body
        i = i + 1
    }
    out = out ++ [$8AFF, $FFFF]           // terminator — reached only by a stray fire
    // Raster_VBlank's static-program path copies a FIXED RASTER_BUF_SIZE bytes into Buf_A, and
    // Raster_BuildSchedule re-records a patched program into the same fixed-size buffer every
    // VBlank, so a program longer than the buffer would be truncated live on either path.
    // (The converse over-read of a short template is pre-existing and harmless — the
    // walker never reaches past the terminator. Booked as EFX-4 in docs/BUGS.md; the
    // ensure below closes that entry's overflow half and the over-read half stays open.)
    ensure(out.len * 2 <= 128,
           "raster_program: {out.len} words = {out.len * 2} bytes exceeds RASTER_BUF_SIZE (128) — Raster_VBlank and Raster_BuildSchedule both copy into a fixed 128-byte buffer")
    ensure(out.len == raster_words(fires),
           "raster_program: emitted {out.len} words but raster_words counted {raster_words(fires)} — the two encoding paths disagree")
    return out
}

// ---- the patch table ----------------------------------------------------------

// arm_word_index — the WORD index of record k's arm word inside the emitted program. The
// header is one word; the two priming records are [arm, opc] pairs at words 1-2 and 3-4; each
// authored record is [arm, opc] plus its op bodies. Records 0 and 1 are the priming pair.
//
// This is a SECOND, INDEPENDENT path to a fact raster_program computes while emitting, and
// check_arm_layout below cross-checks them against each other. A layout function that merely
// restated the emitter would prove nothing.
comptime fn arm_word_index(fires: array, k: int) -> int {
    if k == 0 { return 1 }
    if k == 1 { return 3 }
    comptime var idx = 5
    comptime var j   = 2
    for f in fires {
        if j == k { return idx }
        idx = idx + 2
        for o in fire_ops(f) { idx = idx + op_size(o) }
        j = j + 1
    }
    return idx
}

// record_words — the WORD length of record k's emitted form: its arm word, its op_count, and
// its op bodies. The builder copies exactly this many words, so this number and
// arm_word_index's are the two halves of "where is this record and how big is it".
comptime fn record_words(f: RasterFire) -> int {
    comptime var n = 2                      // arm word + op_count
    for o in fire_ops(f) { n = n + op_size(o) }
    return n
}

// patch_table — the self-describing patch descriptor appended at byte 128 of a patched template.
// One entry per authored record, FIVE WORDS each:
//
//     [line_src][band_lo_fl][band_hi_fl][rec_off][rec_len]
//
//   line_src    a literal fire line (high bit clear) for a static record, or $8000|channel for a
//               patchable one. FIRST because the builder decides emit-or-suppress from it before
//               it needs anything else, and Raster_GetChannelBand matches on it.
//   band_lo_fl  the band in fire lines. A static record writes its own fire line into both, so
//   band_hi_fl  every field of every entry is in ONE coordinate system.
//   rec_off     byte offset of THIS record's own arm word inside the emitted body.
//   rec_len     the record's byte length, arm word through last op word.
//
// THERE IS NO arm_off ANY MORE. It named the arm word this entry REWRITES — the arm of record
// k-2, pre-resolved into ROM because the in-place patcher kept no offset history. The builder
// emits records itself and therefore knows where it put every arm word, so the pre-resolution
// has nothing left to buy.
comptime fn patch_table(fires: array) -> array {
    comptime var out = [fires.len]
    comptime var k   = 2
    for f in fires {
        comptime var src = fire_screen_line(f) - 1
        if fire_is_patch(f) == 1 { src = $8000 | fire_channel(f) }
        out = out ++ [src,
                      fire_band_lo(f) - 1,
                      fire_band_hi(f) - 1,
                      2 * arm_word_index(fires, k),
                      2 * record_words(f)]
        k = k + 1
    }
    return out
}

// ship_trailer — the off-screen ship descriptors, appended AFTER the patch table.
//
//     [n (word)][n x (channel, stage offset, colour count, CRAM addr, reg count, reg words...)]
//
// The count word is emitted ALWAYS, zero included, so the runtime reads one fixed shape and
// never branches on whether a program has a trailer.
//
// IT CARRIES PARAMETERS, NOT A BUILT DMAEntry, and that is forced rather than chosen. The
// first version emitted the finished 14-byte entry, folding Pal_Variant_Stage's absolute
// address in through extern(). It cannot work: an address is a LINK-time value, and putting
// one inside the emitted image makes the whole image non-comptime — which breaks
// `first_mismatch(patched_program(...), hand_twin)`, the existing whole-image pin. Measured
// three ways (a const, an equ, and a const bound to patched_program's result); all three
// produced `here.provisional` errors. The install-time builder adds the base instead.
//
// It is also the better shape for an unrelated reason: the runtime already owns ONE DMAEntry
// builder (BuildStaticDMA's movep sequence), so building there means no second site knows the
// interleaved byte layout. The emitter version needed a third one, and a pin to hold it.
//
// IT RE-ISSUES THE WHOLE FIRE, not just its colours. A fire is an op LIST, and the ship's job
// is "apply this fire from line 0" — so every SetReg the fire carries travels here too and is
// replayed at frame top. Shipping only the stream_pal_region was the first version's defect: OJZ's
// water fire also carries reg_sh_on(), so the rows above the clamped fire line came out tinted but
// UNSHADOWED. Found in play, not by a gate.
//
// THE CHANNEL TRAVELS WITH THE ENTRY because nothing else carries it: the preset deliberately
// has no field naming the shipping channel (a cell that is a pure function of the installed
// program cannot express "the previous section's effect survived", which a field would need a
// guard for), so the runtime learns which channel to test for off-screen from right here.
//
// IT GOES AFTER THE PATCH TABLE, not before: P-b resolves the table at a CONSTANT +128, and
// the runtime's fixed 128-byte template copy stops exactly at that boundary. The trailer's own
// offset is 128 + 2 + 10*records, which the runtime computes from the count word it already
// reads.
//
// TEN, NOT EIGHT — this line said 8*records until 2026-08-18 and the runtime never agreed. A
// patch-table record is FIVE words, not four: line_src, band_lo_fl, band_hi_fl, rec_off,
// rec_len (see OJZ_TC_TABLE_HAND, whose rows are five values wide). The stride was 8n while
// the record was four words; the fifth word (rec_off/rec_len replacing arm_off) made it 10n,
// and Raster_InstallPatched steps 10n as `lsl.w #3` + two adds because `mulu` is forbidden.
// Nothing read this figure — the runtime computes its own — so the drift stayed invisible.
//
// Nothing here is ever patched — the descriptor is static — so it must be read through
// the ROM template and never through the RAM working copy.
comptime fn ship_trailer(fires: array) -> array {
    comptime var entries = []
    comptime var n = 0
    for f in fires {
        if fire_offscreen_ship(f) == 1 {
            n = n + 1
            for o in fire_ops(f) {
                if op_ship_cram_addr(o) >= 0 {
                    // The fire's SetReg ops ride WITH the palette parameters, because the ship
                    // has to re-issue the WHOLE fire at frame top, not just its colours. The
                    // OJZ water fire is the worked example: it carries reg_sh_on() as well as the
                    // stream_pal_region, and a ship that moved only the colours left the rows above
                    // the clamped fire line tinted but UNSHADOWED — reported from play as
                    // "the top row has the jiggle but not the shadow, it's still lighter".
                    comptime var regs = []
                    for r in fire_ops(f) {
                        if op_is_reg(r) == 1 { regs = regs ++ [op_reg_word(r)] }
                    }
                    entries = entries ++ [fire_channel(f),
                                          op_ship_stage_off(o),
                                          op_ship_count(o),
                                          op_ship_cram_addr(o),
                                          regs.len] ++ regs
                }
            }
        }
    }
    // ONE per program today, and the limit is this ensure rather than the wire format: the
    // count word already lets a reader loop, so a second shipping channel needs this relaxed
    // and the runtime's single test turned into a walk — no format change.
    ensure(n <= 1,
           "patched_program: {n} fires declare offscreen_ship, and the runtime tests exactly one. The WIRE FORMAT already carries a count and could hold more — relax this ensure and turn Enqueue_Dirty_Buffers' single test into a loop if a second shipping channel is real content.")
    return [n] ++ entries
}

// ship_trailer_words — the trailer's emitted word count, by an independent path.
comptime fn ship_trailer_words(fires: array) -> int {
    comptime var w = 0
    for f in fires {
        if fire_offscreen_ship(f) == 1 {
            comptime var regs = 0
            for r in fire_ops(f) { if op_is_reg(r) == 1 { regs = regs + 1 } }
            w = w + 5 + regs
        }
    }
    return 1 + w
}

// check_arm_layout — GUARD 6. Every word `arm_word_index` names must be a word the emitter
// actually wrote as an arm word, AND the RIGHT one. Both halves are needed: an index that
// happens to land on an op_count fails the $8A00 test, while one landing on a DIFFERENT
// record's arm passes it — and would corrupt the schedule in a way nothing else here can see.
// Testing the VALUE against arm_at closes that.
//
// IT NO LONGER GUARDS A TABLE FIELD. The table used to carry a pre-resolved `arm_off` per
// record and this guard checked it; local removal deleted that field, because the builder
// emits the records itself and therefore knows where every arm word landed. What survives is
// still worth its bytes: `arm_word_index` remains the layout authority `patch_table`'s
// `rec_off` is computed from, so proving it against the emitted image proves the offsets the
// table DOES carry. GUARD 10 (check_rec_layout) then checks the table's own two words against
// that same derivation, and the emitted body against the fire — table -> derivation -> image.
comptime fn check_arm_layout(fires: array, out: array) -> int {
    let L = fire_lines(fires)
    for j in 0..fires.len {
        let w = out[arm_word_index(fires, j)]
        ensure((w & $FF00) == $8A00,
               "patched_program: the word the patch table points at for record {j} is not a VDP reg $0A write. The runtime patcher stores a byte there sight-unseen, so a wrong offset silently rewrites a record's op_count and sends the walker through ROM as opcodes inside a raw interrupt handler.")
        ensure(w == arm_at(L, j),
               "patched_program: the patch table's offset for record {j} points at an arm word, but not that record's — the emitted word does not match the arm the schedule derives for it.")
    }
    return 0
}

// check_rec_layout — GUARD 10. For every record the table describes, the emitted image at
// [rec_off, rec_off+rec_len) must BE that record: an $8Axx-class arm word, the op_count, and the
// op bodies, and the span must end exactly where the next record's arm word begins.
//
// WHY IT INDEXES `out` AND NOT JUST THE OFFSETS. Under the builder a wrong rec_off/rec_len does
// not misplace one byte — it copies a MISALIGNED SLICE of the template into the live program, and
// the handler then reads an op payload word as an opcode, falls through the compare chain to
// OP_SET_REG, writes an arbitrary word to VDP_CTRL from inside a raw interrupt handler, and walks
// arbitrary bytes for the rest of the frame. An offset-only cross-check cannot see any of that.
//
// IT READS THE EMITTED TABLE, NOT ONLY THE DERIVATION. Checking arm_word_index/record_words
// against the image proves the image is self-consistent, but the runtime reads the TABLE — so a
// patch_table that emitted something else entirely would sail through. The two table words are
// therefore compared against the same derivation the image was checked with, which closes
// table -> derivation -> image. Without this the only thing standing between a wrong rec_off and
// the handler is a hand twin, and hand twins exist for pinned fixtures only.
comptime fn check_rec_layout(fires: array, out: array) -> int {
    let tab = patch_table(fires)
    comptime var k = 2
    for f in fires {
        let off = arm_word_index(fires, k)
        let len = record_words(f)
        let e   = 1 + 5 * (k - 2)           // this record's entry: count word, then 5 per record
        ensure(tab[e + 3] == 2 * off,
               "raster program: the patch table says record {k} starts at byte {tab[e + 3]} but the emitted body puts its arm word at byte {2 * off}. The builder copies from the TABLE's offset, so this is the difference between copying the record and copying a misaligned slice of its neighbour.")
        ensure(tab[e + 4] == 2 * len,
               "raster program: the patch table says record {k} is {tab[e + 4]} bytes but the emitted record is {2 * len} bytes")
        ensure((out[off] & $FF00) == $8A00,
               "raster program: record {k}'s rec_off points at word {off}, which holds {out[off]} — not an $8Axx arm word. The builder copies rec_len bytes from here into the live program, so a misaligned rec_off feeds the HInt handler an op payload word as an opcode.")
        ensure(out[off + 1] == fire_ops(f).len,
               "raster program: record {k} at word {off} declares {out[off + 1]} ops but the fire has {fire_ops(f).len}")
        comptime var body = []
        for o in fire_ops(f) { body = body ++ op_words(o) }
        comptime var i = 0
        for w in body {
            ensure(out[off + 2 + i] == w,
                   "raster program: record {k}'s emitted body diverges from the fire at word {off + 2 + i} — image has {out[off + 2 + i]}, the fire says {w}")
            i = i + 1
        }
        ensure(off + len == arm_word_index(fires, k + 1),
               "raster program: record {k} spans words {off}..{off + len} but the next record's arm word is at {arm_word_index(fires, k + 1)} — rec_len and the emitted layout disagree, so the builder would copy a misaligned slice")
        k = k + 1
    }
    return 0
}

// patched_words — the emitted word count of a patched template: the program padded to the
// 64-word buffer, then the table. Use it as the length annotation on the `pub data`.
//
// HONEST SCOPE AS A CROSS-CHECK: the program body's own word count is checked by
// raster_program's `out.len == raster_words(fires)`, which runs on every call and is the
// independent-path check. Once padded the body is 64 words by construction, so what THIS adds
// is the table's framing — one count word plus five per record — and it pins the declared ROM
// footprint at the linker seam.
pub comptime fn patched_words(fires: array) -> int {
    return 64 + 1 + 5 * fires.len + ship_trailer_words(fires)
}

// patched_program — a raster program a runtime patcher can move. The ordinary program, padded
// to exactly the 64-word working buffer, then the patch table.
//
// WHY THE PADDING IS NOT WASTE. The runtime's copy routine copies a FIXED 128 bytes from every
// template, so a patched template is already read to +128 — padding makes that read defined,
// and it puts the table at a CONSTANT address (+128) so nothing needs a second symbol or a
// descriptor field to find it. The copy stops exactly at the table boundary, so the table
// itself is never partially copied into the working buffer.
pub comptime fn patched_program(fires: array) -> array {
    comptime var out = raster_program(fires)     // every existing guard runs here
    check_arm_layout(fires, out)
    check_rec_layout(fires, out)
    comptime var pad = 64 - out.len
    ensure(pad >= 0,
           "patched_program: the program body is {out.len} words, which does not fit the 64-word buffer the runtime copies")
    for i in 0..pad { out = out ++ [0] }
    out = out ++ patch_table(fires)
    out = out ++ ship_trailer(fires)
    ensure(out.len == patched_words(fires),
           "patched_program: emitted {out.len} words but patched_words counted {patched_words(fires)} — the emitter and the length annotation disagree")
    return out
}

// ---- development instruments -------------------------------------------------

// first_mismatch — -1 when the two word lists are equal, else the index of the first
// differing element. The development instrument for re-expressing a hand-authored
// program through the DSL (design spec 8.1).
//
// PRECONDITION — it MUST be paired with a separate `.len` ensure, and that is not just
// "a length difference is a different failure than a value difference". It walks only
// `a`'s indices and skips any index past the end of `b`, so it returns -1 whenever `a`
// is a PREFIX of `b` — a DSL program that is short by a trailing record compares EQUAL
// to its hand-word twin. Nothing inside this function can see that; only the length
// check can.
//
// IT IS BLIND IN BOTH DIRECTIONS, which the paragraph above understated until it was
// measured. `for i in 0..a.len` never visits an index past the end of `a`, and the
// `i < b.len` test skips every index past the end of `b`, so a SHORTER `b` is equally
// invisible — the comparison simply stops early and reports agreement. Measured
// 2026-08-15 on the OJZ_TwoChannel gate: deleting the last four-word entry from the hand
// TABLE produced no mismatch report at all, and only the separate length ensure caught it.
// Read that as the general rule: this function answers "do the words they share agree",
// never "are these the same array".
// (In this codebase the chain also holds one rung deeper, because
// raster_program asserts `out.len == raster_words(fires)` on every call, but callers
// must not rely on that: it is a fact about raster_program, not about first_mismatch.)
pub comptime fn first_mismatch(a: array, b: array) -> int {
    for i in 0..a.len {
        if i < b.len {
            if a[i] != b[i] { return i }
        }
    }
    return -1
}

// ---- band()'s hand-word twin (spec §10 gate 5) --------------------------------
//
// The ONLY thing that elaborates `band` on an ordinary build. An uncalled comptime fn is
// never elaborated (the op_cram_span anchor above learned this the hard way), so without
// a call site every ensure inside band — and every wrong word it could emit — ships green.
// This is that call site AND the value check, and it lives here rather than game-side
// because band() has no content client yet: the OJZ programs are all patchable/shipping
// fixtures, which §4.3 refuses a band. Zero ROM bytes: a `const` emits nothing and every
// name below is comptime.
//
// THE WORDS ARE HAND-DERIVED FROM THE ENCODER RULES, never pasted from a run — a twin
// generated by the thing it pins proves only that the encoder agrees with itself (the
// Gate-3 sin the R1 sweeps killed). The derivation, for
// `band(100, 140, stream_cram($48, [$0E42, $0A20, $0640]), 0)`:
//
//   fires        Fire(100, [Cram($48, 3 words)]), Fire(140, [PalRestore($48, 3)])
//                the restore's (addr, count) is op_cram_span(on) = ($48, 6 bytes) -> 3 words
//   fire lines   L = [0, 1, 99, 139]              (priming pair, then screen line - 1)
//   header       op_mask is 1 << (addr >> 5) for both ops; $48 >> 5 = 2 -> %0100
//   arm 0        $8A00 | (L[2] - L[1] - 1) = $8A00 | 97 = $8A61
//   arm 1        $8A00 | (L[3] - L[2] - 1) = $8A00 | 39 = $8A27
//   arms 2, 3    past the end of L -> $8AFF, the park word
//   ON body      op_words(Cram) = [OP_CRAM, comm>>16, comm&$FFFF, SPIN, len-1] ++ colours,
//                vdp_comm($48, Cram, Write) = $C0480000 (pinned game-side, ojz_effects)
//   restore body op_words(PalRestore) = [OP_PAL_RESTORE, comm>>16, comm&$FFFF, SPIN, cnt-1, addr]
//                — the snapshot offset IS the CRAM address (claim D-F), hence the $48 tail
//   SPIN         the per-op blanking spin (substrate item 1) — RASTER_SPIN_CRAM = 4 on the
//                ON op, RASTER_SPIN_RESTORE = 13 on the restore. It sits between the
//                command longword and count-1 because that is the order Raster_HInt reads
//                them: command, spin, count.
//   terminator   park + RASTER_OPS_END
//
// Height 40 is far above the 3-word cram ON op's minimum of 2 (518 cyc <= 2 x 488), so the
// twin pins the ENCODING and leaves the minima to the poison lane, which is the split the
// other twins in this tree use.
const RASTER_BAND_TWIN = band(100, 140, stream_cram($48, [$0E42, $0A20, $0640]), 0)

const RASTER_BAND_TWIN_HAND = [
    %0100,                      // pal_dirty_mask — the WHOLE header, one word; CRAM line 2
    $8A61, 0,                   // fire 0 — priming; arm = $8A00 | (99 - 1 - 1)
    $8A27, 0,                   // fire 1 — priming; arm = $8A00 | (139 - 99 - 1)
    $8AFF, 1,                   // fire 2 — the band's ON edge at screen 100, one op
      2, $C048, $0000,          // OP_CRAM, command longword split
                 4,             // spin — RASTER_SPIN_CRAM
                 2,             // count-1
                 $0E42, $0A20, $0640,
    $8AFF, 1,                   // fire 3 — the OFF edge at screen 140, the restore ALONE
      10, $C048, $0000,         // OP_PAL_RESTORE, same command longword (same span)
                 13,            // spin — RASTER_SPIN_RESTORE
                 2,             // count-1
                 $48,           // Palette_Ship_Snap offset == the CRAM address
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
// The .len ensure is REQUIRED alongside first_mismatch, not belt-and-braces: first_mismatch
// walks only its FIRST argument's indices and skips any index past the end of the second,
// so a program that is a prefix of the twin — or a twin that is a prefix of the program —
// compares EQUAL. Nothing inside it can see that.
ensure(raster_words(RASTER_BAND_TWIN) == RASTER_BAND_TWIN_HAND.len,
       "band(): the DSL counts {raster_words(RASTER_BAND_TWIN)} words, the hand twin is {RASTER_BAND_TWIN_HAND.len}")
ensure(first_mismatch(raster_program(RASTER_BAND_TWIN), RASTER_BAND_TWIN_HAND) == -1,
       "band(): the emitted program diverges from the hand twin at index {first_mismatch(raster_program(RASTER_BAND_TWIN), RASTER_BAND_TWIN_HAND)}")

// ---- band()'s sh:1 hand-word twin (Task 9 review, I-1) ------------------------
//
// The sh:0 twin above elaborates ONE of band()'s two shapes. sh:1 is a different code
// path start to finish — three fires instead of two, a merged [reg, ON] fire, a bare
// de-mix fire carrying reg_sh_off() alone, and a THIRD arm word (the fire-record arm for
// the merged ON fire itself, not one of the two priming arms) — so the sh:0 twin proves
// nothing about it; it needs its own hand-derived pin.
//
// THE WORDS ARE HAND-DERIVED FROM THE ENCODER RULES, never pasted from a run, for the same
// reason the sh:0 twin gives (a twin generated by the thing it pins proves only that the
// encoder agrees with itself). The derivation, for
// `band(100, 140, stream_cram($48, [$0E42, $0A20, $0640]), 1)`:
//
//   fires        Fire(100, [SetReg($8C89), Cram($48, 3 words)]),
//                Fire(139, [SetReg($8C81)]),
//                Fire(140, [PalRestore($48, 3)])
//                — reg_sh_on() = reg_set($8C81 | 8) = SetReg($8C89); reg_sh_off() = SetReg($8C81);
//                the restore's (addr, count) is op_cram_span(on) = ($48, 6 bytes) -> 3 words
//   fire lines   L = [0, 1, 99, 138, 139]          (priming pair, then screen line - 1 per fire:
//                100-1=99, 139-1=138, 140-1=139)
//   header       op_mask is 1 << (addr >> 5) for every non-reg op; $48 >> 5 = 2 -> %0100
//                (SetReg contributes 0, so the merged fire's reg op does not touch it)
//   arm 0        arm_at(L,0) = $8A00 | (L[2] - L[1] - 1) = $8A00 | (99 - 1 - 1) = $8A00 | 97 = $8A61
//   arm 1        arm_at(L,1) = $8A00 | (L[3] - L[2] - 1) = $8A00 | (138 - 99 - 1) = $8A00 | 38 = $8A26
//   arm 2        arm_at(L,2) = $8A00 | (L[4] - L[3] - 1) = $8A00 | (139 - 138 - 1) = $8A00 | 0 = $8A00
//                — THE ZERO-RELOAD ARM. L[3]=138 and L[4]=139 are ADJACENT fire lines (the
//                de-mix fire at bot-1=139 and the restore fire at bot=140, both one line apart
//                in fire-line space), so arm_at computes a gap of exactly 0 and reloads $8A00 —
//                not $8AFF (past-end park) and not some larger gap. This is the fire-record
//                arm word for fire 0 (the merged ON fire), not a priming arm; no other twin in
//                this tree exercises an adjacent-fire zero reload.
//   arms 3, 4    i+2 >= L.len(5) for i=3,4 -> $8AFF (past the end -> the park word), covering
//                fire 1 (the de-mix reg-off fire) and fire 2 (the restore fire)
//   fire 0 body  op_words(SetReg($8C89)) ++ op_words(Cram($48, [$0E42,$0A20,$0640]))
//                = [OP_SET_REG, $8C89] ++ [OP_CRAM, comm>>16, comm&$FFFF, SPIN, len-1] ++ colours
//                vdp_comm($48, Cram, Write) = $C0480000 (same pinned command as the sh:0 twin)
//   fire 1 body  op_words(SetReg($8C81)) = [OP_SET_REG, $8C81]                — the bare de-mix
//   fire 2 body  op_words(PalRestore($48, 3)) = [OP_PAL_RESTORE, comm>>16, comm&$FFFF, SPIN, cnt-1, addr]
//   SPIN         the per-op blanking spin (substrate item 1): RASTER_SPIN_CRAM = 4 on the
//                ON op, RASTER_SPIN_RESTORE = 13 on the restore. SetReg carries none — it
//                streams nothing, so it has no burst to park.
//   terminator   park + RASTER_OPS_END, hardcoded (not arm_at-derived)
//
// Word count: 1 (mask) + 4 (two priming records) + 2 (terminator)
//           + (2 + 2 + 8)   fire 0: arm+count, SetReg(2 words), Cram(8 words incl. spin)
//           + (2 + 2)       fire 1: arm+count, SetReg(2 words)
//           + (2 + 6)       fire 2: arm+count, PalRestore(6 words incl. spin)
//           = 7 + 12 + 4 + 8 = 31
//
// Height 40 is far above the S/H minimum of 3 (spec §6.2), so this twin pins the ENCODING
// and leaves the minima to the poison lane, matching the split the sh:0 twin uses.
const RASTER_BAND_TWIN_SH1 = band(100, 140, stream_cram($48, [$0E42, $0A20, $0640]), 1)

const RASTER_BAND_TWIN_SH1_HAND = [
    %0100,                       // pal_dirty_mask — CRAM line 2; the reg ops contribute nothing
    $8A61, 0,                    // fire 0 — priming; arm = $8A00 | (99 - 1 - 1)
    $8A26, 0,                    // fire 1 — priming; arm = $8A00 | (138 - 99 - 1)
    $8A00, 2,                    // fire 2 — the merged S/H-on + ON edge at screen 100, two ops;
                                  // arm = $8A00 | (139 - 138 - 1) = $8A00 | 0 — the zero-reload arm
      0, $8C89,                  // OP_SET_REG, reg_sh_on() = $8C81 | bit 3
      2, $C048, $0000,           // OP_CRAM, command longword split
                 4,              // spin — RASTER_SPIN_CRAM
                 2,              // count-1
                 $0E42, $0A20, $0640,
    $8AFF, 1,                    // fire 3 — the de-mix fire at screen 139, reg write ALONE
      0, $8C81,                  // OP_SET_REG, reg_sh_off() = $8C81
    $8AFF, 1,                    // fire 4 — the OFF edge at screen 140, the restore ALONE
      10, $C048, $0000,          // OP_PAL_RESTORE, same command longword (same span)
                 13,             // spin — RASTER_SPIN_RESTORE
                 2,              // count-1
                 $48,            // Palette_Ship_Snap offset == the CRAM address
    $8AFF, $FFFF,                // park + RASTER_OPS_END
]
// Same requirement as the sh:0 twin: the .len ensure catches what first_mismatch structurally
// cannot (a program that is a prefix of the twin, or vice versa, compares equal to it).
ensure(raster_words(RASTER_BAND_TWIN_SH1) == RASTER_BAND_TWIN_SH1_HAND.len,
       "band(sh:1): the DSL counts {raster_words(RASTER_BAND_TWIN_SH1)} words, the hand twin is {RASTER_BAND_TWIN_SH1_HAND.len}")
ensure(first_mismatch(raster_program(RASTER_BAND_TWIN_SH1), RASTER_BAND_TWIN_SH1_HAND) == -1,
       "band(sh:1): the emitted program diverges from the hand twin at index {first_mismatch(raster_program(RASTER_BAND_TWIN_SH1), RASTER_BAND_TWIN_SH1_HAND)}")
