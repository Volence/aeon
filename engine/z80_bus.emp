// Z80 bus-control templates — shared module.
//
// The shared `stop_z80`/`start_z80` bus-control templates (hygienic per-site
// labels). Consumers `use engine.z80_bus.{stop_z80, start_z80}`; each site
// splices the template inline.
//
// `Z80_BUS_REQUEST` is a bare link-resolved hardware address (truth:
// engine/system/constants.emp) — each splice site resolves it through the link.
//
// Pure comptime module: opens no section and emits ZERO bytes anywhere in the
// ROM — bytes appear only where a consumer splices the templates.
module engine.z80_bus

// stop_z80: request the Z80 bus and spin until granted — the only way the 68k
// reads/writes Z80 RAM or drives blocking VDP copies reliably. Pair with
// start_z80.
pub comptime fn stop_z80() -> Code {
    return asm {
        move.w  #$0100, Z80_BUS_REQUEST
    .wait_z80:
        btst    #0, Z80_BUS_REQUEST
        bne     .wait_z80
    }
}

// start_z80: release the bus.
pub comptime fn start_z80() -> Code {
    return asm {
        move.w  #$0000, Z80_BUS_REQUEST
    }
}
