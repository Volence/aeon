// Section streaming engine (§4)
// Continuous-scroll: the camera, player, and all entities live in WORLD
// coordinates and the level scrolls live with no section rebases. World ==
// engine throughout; the nametable is a 64-cell ring the world wraps through.

module engine.section in section

use engine.constants.{SECTION_SIZE_SHIFT, PLANE_H_CELLS, VRAM_PLANE_B_BYTES, MAX_ACT_SECTIONS}
use engine.constants.{TILE_CACHE_COLS, TILE_CACHE_ROWS, TILE_CACHE_STRIDE, TILE_CACHE_NT_SIZE}
use engine.constants.{VRAM_PLANE_A, PLANE_V_CELLS, PLANE_BUFFER_SIZE, VDP_DATA, VDP_CTRL}
use engine.structs.{Act, Sec, Act_grid_w_lo, Act_grid_h_lo}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm, vdp_comm_reg}
use engine.z80_bus.{z80_stopped}
// SND_DMA_ACTIVE_SLOT (the 68k-side DMA-window flag slot) is a global linker
// symbol defined by engine.vblank; referenced bare below for the poke-storm bracket.

// ---- Sec / Act field access comes from the shared engine.structs module
// (`Sec.field(aN)` / `Act.field(aN)`, the grid-dim low-byte views via
// Act_grid_w_lo / Act_grid_h_lo) — the file-local offset-const mirrors are gone. ----

// ---- VRAM_PLANE_A / PLANE_V_CELLS / PLANE_BUFFER_SIZE + the TILE_CACHE_* /
// Sec-Act layout all come from the shared engine.constants + engine.structs
// modules (`use`d above), which carry the drift locks. ----
// (Act/Sec field-offset drift guards now live in engine.structs' per-field wall.)
// Section_GetSecPtrXY multiplies the flat id by sizeof(Sec) = 66; the `ensure`
// keeps 66 the real stride.
ensure(sizeof(Sec) == 66, "Section_GetSecPtrXY multiplies by #66 — keep sizeof(Sec)=66 or the stride is wrong")
// Section_GetSecPtrXY's `adda.w d0, a0` (d0 = flat × 66) sign-extends the word
// offset: once flat × 66 crosses $7FFF the pointer wraps negative, capping an act
// at $7FFF / 66 = 496 sections. That MAX_ACT_SECTIONS ≤ 496 ceiling is asserted at
// its owner (games/.../act_descriptor.emp, beside the other mega-act grid
// ceilings) — MAX_ACT_SECTIONS is a drift-guarded const there, so the check stays
// comptime and doesn't demand the extern when section is compiled standalone.
// MAX_ACT_SECTIONS (48) is far under 496 today.

// ---- VDP command macros (truth: engine/macros.asm). First .emp consumer. ----

// The typed VDP command interface (VdpTarget/VdpOp sum types + vdp_comm /
// vdp_comm_reg derivations) lives in the shared engine.vdp module — hoisted
// there when plane_buffer became the 2nd consumer (gap-ledger row 1073).

// -----------------------------------------------
// Section_Init — record the act, fill nametable, init the entity window
// In:  a0 = act descriptor pointer (Act struct)
// Out: none
// Clobbers: d0–d7, a0–a4   (transitive via EntityWindow_Init)
// -----------------------------------------------
pub proc Section_Init (a0: *Act) clobbers(d0-d7/a0-a4) {
        move.l  a0, Current_Act_Ptr             // (Current_Act_Ptr).w — ram.asm; abs.w by the width rule

        // -- set up column/row trackers; first frame streams the plane --
        jbsr    Section_FillInitial

        // -- §4.9: camera-driven entity window init --
        jbsr    EntityWindow_Init
        rts
}

// -----------------------------------------------
// Section_FillInitial — set up trackers; let Section_UpdateColumns
// fill plane on first frame.
//
// Trackers are seeded one column/row tight on each side of the camera so
// Section_UpdateColumns streams the visible window outward in scroll-
// direction order on the first frames (avoids a left-edge content pop).
//
// Out: Section_Right_Col_Written, Section_Left_Col_Written initialised
// Clobbers: d0 (the original AS header claimed "none", but the body scratches d0)
// -----------------------------------------------
pub proc Section_FillInitial () clobbers(d0) {
        move.l  Camera_X, d0                    // (Camera_X).w
        swap    d0
        lsr.w   #3, d0                          // d0 = camera world tile col
        subq.w  #1, d0
        move.w  d0, Section_Right_Col_Written
        addq.w  #1, d0
        move.w  d0, Section_Left_Col_Written

        move.l  Camera_Y, d0
        swap    d0
        lsr.w   #3, d0                          // d0 = camera world tile row
        subq.w  #1, d0
        move.w  d0, Section_Bottom_Row_Written
        addq.w  #1, d0
        move.w  d0, Section_Top_Row_Written
        rts
}

// -----------------------------------------------
// Section_FlatIDXY — flat section id from grid coordinates.
// In:  d2 = sec_x, d3 = sec_y (GridY), a2 = Act ptr
// Out: d0 = sec_y * grid_w + sec_x (SectionId)
// Clobbers: d1     (d2/d3/a2 preserved)
// NOTE: d2 (sec_x) is left u8, NOT GridX. At the 3×3-window build site
// (EntityWindow_BuildEntries) this is called immediately after
// Section_GetSecPtrXY, whose body no longer touches d2 at all but whose
// contract still DECLARES d2 clobbered — so a typed GridX in d2 still cannot be
// proven to survive that call. The GridY axis DOES survive (GetSecPtrXY
// preserves d3), so d3 carries the axis-split swap guard here; typing d2 GridX
// is BANKED until GetSecPtrXY's declaration narrows to match its body.
// -----------------------------------------------
pub proc Section_FlatIDXY (d2: u8, d3: GridY, a2: *Act) clobbers(d1) out(d0: SectionId) {
        moveq   #0, d0
        moveq   #0, d1
        move.b  d3, d1                          // d1 = sec_y
        subq.w  #1, d1
        bmi     .fxy_add_x
    .fxy_mul:
        add.w   Act.grid_w(a2), d0
        dbf     d1, .fxy_mul
    .fxy_add_x:
        moveq   #0, d1
        move.b  d2, d1                          // d1 = sec_x
        add.w   d1, d0
        rts
}

// -----------------------------------------------
// Section_GetSecPtrXY — Sec ptr lookup by grid coordinates (§4.2).
// In:  d2 = sec_x (GridX), d3 = sec_y (GridY), a2 = Act ptr
// Out: a0 = Sec ptr; d0 = found flag (Z clear if found, Z set if out of range,
//      a0 = 0) — a boolean, NOT a SectionId, so d0 is untyped here.
// Clobbers: d1, d2     (the body preserves d2 — sec_x rides through it and the
//      bounded multiply needs no loop counter — but the declared contract keeps
//      d2 clobbered so a caller cannot carry a typed GridX in d2 across this
//      call; the declaration stays uniform with Section_FlatIDXY's d2.)
// -----------------------------------------------
pub proc Section_GetSecPtrXY (d2: GridX, d3: GridY, a2: *Act) clobbers(d1-d2) out(d0, a0, zero: none) {
        cmp.b   Act_grid_w_lo(a2), d2
        bcc     .out_of_range                   // sec_x >= grid_w (unsigned)
        cmp.b   Act_grid_h_lo(a2), d3
        bcc     .out_of_range                   // sec_y >= grid_h (unsigned)

        // flat_id = sec_y * grid_w + sec_x. The bound constrains the COUNTER
        // operand, which here is d1 = grid_w: the range checks above passed, so
        // grid_h >= 1 and therefore grid_w <= grid_w*grid_h <= MAX_ACT_SECTIONS.
        // The bounded multiply prices the WORST case, so mulu's flat 70 beats a
        // repeated-add loop's 24 + 14*grid_w from grid_w = 4 up; a small grid_w
        // would still run cheaper as a loop, and worst-case cost is what the
        // construct budgets. This is not a hot path — one call per section
        // lookup, off the per-frame streaming path.
        moveq   #0, d0
        move.b  d3, d0                          // d0 = sec_y
        move.w  Act.grid_w(a2), d1              // d1 = grid_w
        mul_bounded.w d0, d1, #MAX_ACT_SECTIONS // d0 = sec_y * grid_w
        moveq   #0, d1
        move.b  d2, d1                          // d1 = sec_x (d2 = sec_x input, preserved)
        add.w   d1, d0                          // d0 = flat section index

        movea.l Act.sec_grid_ptr(a2), a0
        mul_const.w d0, #66, d1                  // d0 = flat × sizeof(Sec) = 66 (d1 = multiply scratch)
        adda.w  d0, a0                          // sign-extends d0 → ≤496 sections (module ensure guards it)

        tst.l   (a0)
        beq     .out_of_range

        moveq   #1, d0                          // Z clear (success)
        rts
    .out_of_range:
        suba.l  a0, a0                          // a0 = 0
        moveq   #0, d0                          // Z set (not found)
        rts
}

// -----------------------------------------------
// Section_RedrawPlanes — camera-aware atomic full-plane rewrite (§4.2).
// Level-init draw + cache-recovery path only (via Section_Plane_Dirty);
// continuous-scroll streams the plane incrementally, so this never fires
// mid-traversal (~3 frames synchronous when it does run).
//
// Models sonic_hack's Dirty_flag → Draw_All pattern: the entire visible
// plane content is rewritten in one synchronous pass via direct VDP
// pokes. No multi-frame scroll-across.
//
// Camera-aware: fills 64 plane cols starting at Camera_X/8 (world col),
// reading each col straight from the tile cache. Nametable cell =
// world_col & 63 (continuous-scroll: world == engine, the plane is a
// 64-cell ring the world wraps through).
//
// Z80 POSTURE — THIS ROUTINE OWNS IT; DO NOT WRAP THE CALL.
// The storm is a ~3-frame direct-VDP poke run, so a caller-side bus hold is
// both wrong and unenforceable:
//   * sound ON  — halting the Z80 for ~3 frames starves the DAC outright. The
//     correct posture is the engine-wide SND_CTRL_DMA_ACTIVE flag bracket (the
//     same one VInt_Level uses): the Z80 keeps running but takes its DRAIN path
//     and issues no banked ROM read, so it never touches the 68k bus window
//     while the storm pokes VDP. That is the property bus-holding would buy,
//     without killing sound.
//   * sound OFF — no driver to hand that contract to, so the bus IS held for
//     the whole storm.
// Both are raised/lowered INSIDE this proc. A caller-side bus hold is actively
// harmful under sound ON: the flag bracket's own release frees the caller's hold
// (a bus request is not a counting lock), so the caller would run the rest of
// the storm believing it holds a bus it does not.
//
// In:  none (reads Camera_X, Cache_*, Current_Act_Ptr; Plane B derives the
//      on-screen section from the world camera for the BG layout ptr)
// Out: d5.w = start_world_col (for tracker reset by caller)
//      d7.w = start_world_col + 63 (for tracker reset by caller)
// Clobbers: d0–d4/d6, a0–a6, plus the CCR half of SR — the body saves the full
//   SR (`move.w sr,-(sp)`), masks to $2700 for the poke storm, then restores it
//   (`move.w (sp)+,sr`); the mask round-trips with no return inside the span.
//   The post-restore cmp/bge clamp dirties only CCR. So `preserves(sr.mask)`
//   (the interrupt mask is caller-safe) partitions against `clobbers(sr.ccr)`
//   (the tail clamp's flags escape) — the QueueDMA_Deferrable / Sound_DrainSfxRing
//   split.
// -----------------------------------------------
pub proc Section_RedrawPlanes () clobbers(d0-d4/d6/a0-a6/sr.ccr) out(d5, d7: u16) preserves(sr.mask) {
        lea     VDP_CTRL, a5                    // (VDP_CTRL).l — engine.vdp const; abs.l by the width rule
        lea     VDP_DATA, a6
        move.w  sr, -(sp)
        move.w  #$2700, sr

        // Sound (flag bracket): this redraw masks IRQs for a ~3-frame VDP poke
        // storm, so VInt_Level cannot manage the DMA-window flag across it. Raise
        // SND_CTRL_DMA_ACTIVE=1 (the same bracket VInt_Level uses) so the Z80
        // producer takes its DRAIN path and never issues a banked ROM read that
        // would contend with the storm and underrun the DAC. The raise's own
        // bus-held write sits inside the SR mask, so a mid-bracket IRQ6 can't
        // release the bus under it. Lowered before the SR restore below.
        // Sound-OFF build: there is no driver to hand the DRAIN contract to, so
        // the flag write is meaningless and the Z80 is unmanaged for the whole
        // storm. Hold the bus across it instead (nothing to starve without a
        // driver). This routine owns its Z80 posture in BOTH shapes — see the
        // Z80-POSTURE note in the header — so callers must NOT wrap it.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #1, SND_DMA_ACTIVE_SLOT // raise: poke storm open (Z80 -> DRAIN)
            }
        }
        // Comptime-gated so ONE body serves both shapes (see the Z80-POSTURE note).
        with z80_stopped if SOUND_DRIVER_ENABLED == 0 {
            // -- Plane A: column-major write --
            move.w  #$8F80, (a5)

            // compute start nametable row from Cache_Top_Row (world_row & 63)
            move.w  Cache_Top_Row, d6
            andi.w  #63, d6                         // d6 = start_nt_row (preserved)

            // compute start world col = Camera_X >> 3
            move.l  Camera_X, d5
            swap    d5
            lsr.w   #3, d5                          // d5 = start_world_col

            moveq   #0, d3                          // col counter (0..63)
            lea     Tile_Cache_Nametable+TILE_CACHE_NT_SIZE, a0   // row-wrap sentinel
                                                    // (a0 free until the Plane B pass)

        .pla_fill:
            move.w  d5, d7
            add.w   d3, d7                          // d7 = world_col

            // check cache range BEFORE setting VDP address — skip entirely
            // on miss so off-screen columns retain old nametable content
            // instead of flashing black/zero tiles
            cmp.w   Cache_Left_Col, d7
            blt     .pla_next
            cmp.w   Cache_Head_Col, d7
            bgt     .pla_next

            // convert world col → plane col (world_col & 63)
            move.w  d7, d0
            andi.w  #63, d0                         // d0 = plane_col = world_col & 63
            add.w   d0, d0                          // d0 = col byte offset
            move.w  d0, -(sp)                       // save for Part B

            // read from tile cache — compute cache column pointer
            move.w  d7, d0
            sub.w   Cache_Left_Col, d0
            add.w   Cache_Origin_Col, d0
            cmpi.w  #TILE_CACHE_COLS, d0
            blt     .col_nowrap
            subi.w  #TILE_CACHE_COLS, d0
        .col_nowrap:
            add.w   d0, d0                          // byte offset = col × 2
            move.w  Cache_Origin_Row, d1
            mul_const.w d1, #160, d2                // origin_row × 160 (stride bytes; d2 = scratch)
            add.w   d1, d0
            lea     Tile_Cache_Nametable, a1
            adda.w  d0, a1                          // a1 = cache[logical row 0][col]

            // -- Part A: nametable rows start_nt_row to 63 --
            move.w  (sp), d4                        // col byte offset
            move.w  d6, d2
            lsl.w   #7, d2                          // start_nt_row × 128
            add.w   d2, d4
            moveq   #0, d2
            move.w  d4, d2
            addi.l  #VRAM_PLANE_A, d2
            vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
            move.l  d2, (a5)

            move.w  #64, d2
            sub.w   d6, d2                          // d2 = count_A (rows in Part A)
            moveq   #TILE_CACHE_ROWS, d4
            cmp.w   d2, d4
            ble     .pA_clamp
            move.w  d2, d4                          // d4 = data_A = min(cache_rows, count_A)
        .pA_clamp:
            move.w  d4, d0
            subq.w  #1, d0
            bmi     .pA_dskip
        .pA_data:
            move.w  (a1), (a6)
            lea     TILE_CACHE_STRIDE*2(a1), a1
            cmpa.l  a0, a1
            blo     .pa_nowrap
            suba.w  #TILE_CACHE_NT_SIZE, a1         // physical row 59 → 0
        .pa_nowrap:
            dbf     d0, .pA_data
        .pA_dskip:
            move.w  d2, d0
            sub.w   d4, d0                          // zero_A = count_A - data_A
            subq.w  #1, d0
            bmi     .pA_zskip
            moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
        .pA_zero:
            move.w  d1, (a6)
            dbf     d0, .pA_zero
        .pA_zskip:

            // -- Part B: nametable rows 0 to start_nt_row - 1 --
            tst.w   d6
            beq     .pB_skip
            moveq   #0, d2
            move.w  (sp), d2                        // col byte offset
            addi.l  #VRAM_PLANE_A, d2
            vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
            move.l  d2, (a5)
            move.w  d6, d2                          // d2 = count_B = start_nt_row
            move.w  #TILE_CACHE_ROWS, d0
            sub.w   d4, d0                          // remaining cache rows
            ble     .pB_allz
            cmp.w   d2, d0
            ble     .pB_dok
            move.w  d2, d0
        .pB_dok:
            move.w  d0, d4
            subq.w  #1, d0
        .pB_data:
            move.w  (a1), (a6)
            lea     TILE_CACHE_STRIDE*2(a1), a1
            cmpa.l  a0, a1
            blo     .pb_nowrap
            suba.w  #TILE_CACHE_NT_SIZE, a1         // physical row 59 → 0
        .pb_nowrap:
            dbf     d0, .pB_data
            move.w  d2, d0
            sub.w   d4, d0
            subq.w  #1, d0
            bmi     .pB_skip
            moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
        .pB_zfill:
            move.w  d1, (a6)
            dbf     d0, .pB_zfill
            jbra    .pB_skip
        .pB_allz:
            move.w  d2, d0
            subq.w  #1, d0
            moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
        .pB_az:
            move.w  d1, (a6)
            dbf     d0, .pB_az
        .pB_skip:
            addq.l  #2, sp                          // pop col byte offset

        .pla_next:
            addq.w  #1, d3
            cmpi.w  #64, d3
            blt     .pla_fill

            // -- Plane B: column-major write (BG layout is act-wide, not position-dependent) --
            // Continuous-scroll: derive the on-screen section straight from the
            // world camera (sec_x = Camera_X >> SECTION_SIZE_SHIFT, sec_y likewise).
            // At level init the camera sits in the start section, so this returns the
            // start section's BG.
            movea.l Current_Act_Ptr, a2
            move.w  Camera_X, d2                    // world X px (16.16 high word)
            moveq   #SECTION_SIZE_SHIFT, d0
            asr.w   d0, d2 as GridX                 // d2.w = sec_x
            move.w  Camera_Y, d3                    // world Y px
            asr.w   d0, d3 as GridY                 // d3.w = sec_y
            jbsr    Section_GetSecPtrXY             // a0 = on-screen Sec ptr (Z set = none)
            beq     .plb_use_act_layout
            movea.l Sec.sec_bg_layout(a0), a1
            cmpa.w  #0, a1
            bne     .plb_have_layout
        .plb_use_act_layout:
            movea.l Act.act_bg_layout(a2), a1       // T1 fallback to act-level BG
            cmpa.w  #0, a1
            beq     .plb_done
        .plb_have_layout:
            // Column-major blit. The layout blob is column-contiguous
            // (blob[col*128 + row*2], 64 rows/column). Per column: set the VDP
            // address to the column's top cell and drain ALL 64 rows with autoinc
            // $80, so one move.l = two VERTICALLY-adjacent cells — exactly two
            // adjacent source words. 32 move.l per column (NEW-5, 2026-08-05:
            // the maintainers used to stop at 32 rows, silently half-reverting
            // any BG art in rows 32-63 — which shipped OJZ art carries and the
            // full-plane vscroll wrap shows on screen). 64 per-column command
            // setups are init/recovery-only noise, not a per-frame cost; the
            // storm grows ~3 -> ~4 frames, init/cache-recovery only.
            move.w  #$8F80, (a5)                    // autoincrement $80 (step one plane row/word)
            moveq   #0, d3                          // d3 = column index 0..63
        .plb_col:
            moveq   #0, d2
            move.w  d3, d2
            add.w   d2, d2                          // d2 = col*2 (byte offset of row 0)
            addi.l  #VRAM_PLANE_B_BYTES, d2
            vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
            move.l  d2, (a5)
            moveq   #32-1, d2                       // 32 longwords = 64 words = rows 0..63
        .plb_word:
            move.l  (a1)+, (a6)
            dbf     d2, .plb_word                   // a1 lands on the next column (stride 128 B)
            addq.w  #1, d3
            cmpi.w  #64, d3
            blt     .plb_col
        .plb_done:
            // Restore default autoincrement (matches VInt_DrawLevel cleanup)
            move.w  #$8F02, (a5)
        }

        // Sound (flag bracket close): the poke storm is finished — ROM is safe to
        // read again. Clear SND_CTRL_DMA_ACTIVE=0 so the Z80 producer leaves DRAIN
        // and resumes FILL read-ahead. Still inside the SR mask (the bus-held write
        // stays IRQ-protected); the mask is released immediately below.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #0, SND_DMA_ACTIVE_SLOT // lower: poke storm closed (Z80 -> FILL)
            }
        }

        // Restore interrupt mask (allow VBlank again)
        move.w  (sp)+, sr

        // -- return tracker bounds in d5/d7 for caller --
        // Clamp to cache range so Section_UpdateColumns streams any
        // columns we skipped (outside cache at redraw time).
        move.w  Cache_Left_Col, d0
        cmp.w   d0, d5
        bge     .track_left_ok
        move.w  d0, d5
    .track_left_ok:
        move.w  Cache_Head_Col, d7
        rts
}

// -----------------------------------------------
// Section_UpdateColumns — per-frame nametable ring-buffer streaming
// Writes newly-revealed tile columns on right and left edges each frame.
// Must be called AFTER Camera_X is updated each frame.
//
// CROSS-CLAMP: each edge, after streaming, clamps the OPPOSITE tracker to its
// value ± 63 (the VDP 64-cell plane-wrap span). So streaming the right edge
// pulls the left tracker forward (right − 63) and vice-versa — the trackers
// bound each other to one wrap window; the .{left,right,top,bottom} clamp-skips
// write the sibling tracker, not their own.
// In:  none
// Out: none
// Clobbers: d0–d7, a0–a3, a5–a6 (a5/a6 only when Plane_Dirty triggers redraw)
// -----------------------------------------------
pub proc Section_UpdateColumns () clobbers(d0-d7/a0-a3/a5-a6) {
        // -- §4.2: full-plane redraw if dirty (level init + cache recovery only) --
        tst.b   Section_Plane_Dirty
        beq     .not_dirty
        clr.b   Section_Plane_Dirty
        jbsr    Section_RedrawPlanes
        move.w  d7, Section_Right_Col_Written
        move.w  d5, Section_Left_Col_Written
        // mem-to-mem: two width-PINNED abs operands. Explicit .w (not the bare
        // house spelling) — the bare form would demand two-way RelaxAbsSym
        // (unbuilt; ledgered). Zero byte cost: RAM syms, the asl width rule
        // converges to abs.w anyway.
        move.w  (Cache_Top_Row).w, (Section_Top_Row_Written).w        // widths pinned: mem-to-mem two-symbolic operands
        move.w  (Cache_Bottom_Row).w, (Section_Bottom_Row_Written).w  // widths pinned: mem-to-mem two-symbolic operands
        rts
    .not_dirty:
        movem.l d2-d7/a0-a2, -(sp)              // a3 is preserved across the whole span (Draw_TileColumn/Draw_TileRow_FromCache clobber d0-d5/a0-a2)

        move.l  Camera_X, d6
        swap    d6                              // d6.w = Camera_X pixels

        // -------- right side --------
        move.w  d6, d7
        addi.w  #327, d7
        lsr.w   #3, d7                          // d7 = right_needed world col

        // clamp to act boundary
        movea.l Current_Act_Ptr, a0
        moveq   #0, d0
        move.w  Act.grid_w(a0), d0
        lsl.w   #8, d0
        subq.w  #1, d0
        cmp.w   d0, d7
        ble     .right_clamp_ok
        move.w  d0, d7
    .right_clamp_ok:
        // clamp to cache bounds
        move.w  Cache_Head_Col, d0
        cmp.w   d0, d7
        ble     .right_cache_ok
        move.w  d0, d7
    .right_cache_ok:
        // clamp to VDP plane wrap: max right = visible_left_world + 63
        move.w  d6, d0
        lsr.w   #3, d0                          // camera tile col (world)
        addi.w  #63, d0                         // max right = visible_left + 63 VDP cells
        cmp.w   d0, d7
        ble     .right_wrap_ok
        move.w  d0, d7
    .right_wrap_ok:

        move.w  Section_Right_Col_Written, d5
    .right_loop:
        cmp.w   d7, d5
        bge     .right_done
        // reserve Draw_TileColumn's worst case: 2 headers (8) + 64 words —
        // a column split at the NT row 63/0 seam emits two entries
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (8 + PLANE_V_CELLS*2), Plane_Buffer_Ptr
        bhi     .right_done
        addq.w  #1, d5

        // convert world col → nametable position (world_col & 63)
        move.w  d5, d0
        andi.w  #63, d0                         // d0 = nametable col = world_col & 63

        move.w  d5, d1                          // d1 = world col
        move.w  d5, -(sp)
        jbsr    Draw_TileColumn
        move.w  (sp)+, d5
        jbra    .right_loop
    .right_done:
        move.w  d5, Section_Right_Col_Written
        move.w  d5, d3
        subi.w  #63, d3                         // left = right - 63 (VDP wrap span)
        cmp.w   Cache_Left_Col, d3             // clamp to cache: left = max(., Cache_Left_Col)
        bge     .right_done_cache_ok
        move.w  Cache_Left_Col, d3
    .right_done_cache_ok:
        cmp.w   Section_Left_Col_Written, d3
        ble     .left_clamp_skip
        move.w  d3, Section_Left_Col_Written
    .left_clamp_skip:

        // -------- left side --------
        move.w  d6, d7
        lsr.w   #3, d7                          // d7 = left_needed world col

        // clamp to cache and act bounds
        move.w  Cache_Left_Col, d0
        cmp.w   d0, d7
        bge     .left_cache_ok
        move.w  d0, d7
    .left_cache_ok:
        // clamp to VDP plane wrap: min left = visible_right_world - 63
        move.w  d6, d0
        addi.w  #327, d0                        // visible_right_px = Camera_X + screen−1
        lsr.w   #3, d0
        subi.w  #63, d0                         // min left = visible_right − 63 VDP cells
        cmp.w   d0, d7
        bge     .left_wrap_ok
        move.w  d0, d7
    .left_wrap_ok:

        move.w  Section_Left_Col_Written, d5
    .left_loop:
        cmp.w   d7, d5
        ble     .left_done
        // reserve Draw_TileColumn's worst case: 2 headers (8) + 64 words —
        // a column split at the NT row 63/0 seam emits two entries
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (8 + PLANE_V_CELLS*2), Plane_Buffer_Ptr
        bhi     .left_done
        subq.w  #1, d5

        move.w  d5, d0
        andi.w  #63, d0                         // nametable col = world_col & 63

        move.w  d5, d1
        move.w  d5, -(sp)
        jbsr    Draw_TileColumn
        move.w  (sp)+, d5
        jbra    .left_loop
    .left_done:
        move.w  d5, Section_Left_Col_Written
        move.w  d5, d3
        addi.w  #63, d3                         // right = left + 63 (VDP wrap span)
        cmp.w   Cache_Head_Col, d3             // clamp to cache: right = min(., Cache_Head_Col)
        ble     .left_done_cache_ok
        move.w  Cache_Head_Col, d3
    .left_done_cache_ok:
        cmp.w   Section_Right_Col_Written, d3
        bge     .right_clamp_skip2
        move.w  d3, Section_Right_Col_Written
    .right_clamp_skip2:

        // -------- bottom side (vertical row streaming) --------
        move.l  Camera_Y, d6
        swap    d6
        move.w  d6, d7
        addi.w  #231, d7                        // 224 + 7
        lsr.w   #3, d7                          // d7 = bottom_needed world row

        // clamp to cache bounds
        move.w  Cache_Bottom_Row, d0
        cmp.w   d0, d7
        ble     .bot_cache_ok
        move.w  d0, d7
    .bot_cache_ok:

        move.w  Section_Bottom_Row_Written, d5
    .bot_loop:
        cmp.w   d7, d5
        bge     .bot_done
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (4 + PLANE_H_CELLS*2), Plane_Buffer_Ptr
        bhi     .bot_done
        addq.w  #1, d5

        // convert world row → nametable row (world_row & 63)
        move.w  d5, d0
        andi.w  #63, d0                         // d0 = nametable row = world_row & 63

        move.w  d5, d1                          // d1 = world row
        move.w  d5, -(sp)
        jbsr    Draw_TileRow_FromCache
        move.w  (sp)+, d5
        jbra    .bot_loop
    .bot_done:
        move.w  d5, Section_Bottom_Row_Written
        move.w  d5, d3
        subi.w  #63, d3                         // top = bottom - 63 (VDP wrap span)
        cmp.w   Cache_Top_Row, d3              // clamp to cache: top = max(., Cache_Top_Row)
        bge     .bot_done_cache_ok
        move.w  Cache_Top_Row, d3
    .bot_done_cache_ok:
        cmp.w   Section_Top_Row_Written, d3
        ble     .top_row_clamp_skip
        move.w  d3, Section_Top_Row_Written
    .top_row_clamp_skip:

        // -------- top side --------
        lsr.w   #3, d6
        move.w  d6, d7                          // d7 = top_needed world row

        move.w  Cache_Top_Row, d0
        cmp.w   d0, d7
        bge     .top_cache_ok
        move.w  d0, d7
    .top_cache_ok:

        move.w  Section_Top_Row_Written, d5
    .top_loop:
        cmp.w   d7, d5
        ble     .top_done
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (4 + PLANE_H_CELLS*2), Plane_Buffer_Ptr
        bhi     .top_done
        subq.w  #1, d5

        move.w  d5, d0
        andi.w  #63, d0                         // nametable row = world_row & 63

        move.w  d5, d1
        move.w  d5, -(sp)
        jbsr    Draw_TileRow_FromCache
        move.w  (sp)+, d5
        jbra    .top_loop
    .top_done:
        move.w  d5, Section_Top_Row_Written
        move.w  d5, d3
        addi.w  #63, d3                         // bottom = top + 63 (VDP wrap span)
        cmp.w   Cache_Bottom_Row, d3          // clamp to cache: bottom = min(., Cache_Bottom_Row)
        ble     .top_done_cache_ok
        move.w  Cache_Bottom_Row, d3
    .top_done_cache_ok:
        cmp.w   Section_Bottom_Row_Written, d3
        bge     .bot_row_clamp_skip
        move.w  d3, Section_Bottom_Row_Written
    .bot_row_clamp_skip:

        movem.l (sp)+, d2-d7/a0-a2
        rts
}
