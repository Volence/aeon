// Section streaming engine (§4)
// Continuous-scroll: the camera, player, and all entities live in WORLD
// coordinates and the level scrolls live with no section rebases. World ==
// engine throughout; the nametable is a 64-cell ring the world wraps through.

module engine.section in section

use engine.constants.{SECTION_SIZE_SHIFT}

// ---- ENGINE constants not yet in the shared twin (truth: engine/constants.asm,
// except VRAM_PLANE_B_BYTES from engine/level/bg.asm). Mirrored local +
// drift-locked to keep this port byte-isolated; hoist each into the shared
// engine.constants twin when a 2nd .emp file consumes it (the SECTION_SIZE_SHIFT
// precedent — it consolidated once section became its 2nd consumer). ----
const VRAM_PLANE_A       = $C000        // Plane A nametable VRAM byte address
const VRAM_PLANE_B_BYTES = $E000        // Plane B nametable VRAM byte address
const PLANE_H_CELLS      = 64
const PLANE_V_CELLS      = 64
const PLANE_BUFFER_SIZE  = 1536         // plane-update ring buffer bytes
const TILE_CACHE_COLS    = 80
const TILE_CACHE_ROWS    = 60
const TILE_CACHE_STRIDE  = TILE_CACHE_COLS
const TILE_CACHE_NT_SIZE = TILE_CACHE_COLS * TILE_CACHE_ROWS * 2

// ---- Sec / Act field offsets used here (DEFERRED struct-twin; truth:
// engine/structs.asm). The Sec/Act structs are multi-consumer (section,
// tile_cache, camera, parallax) so they earn a SHARED struct module, not a
// file-local twin — adopt-when-that-module-stands-up (ledgered). Until then,
// mirror the consumed offsets + drift-lock, the pre-adoption entity_window
// shape. ----
const Act_sec_grid_ptr   = $00
const Act_grid_w         = $04
const Act_grid_h         = $06
const Act_act_bg_layout  = $0E
const Sec_sec_bg_layout  = $1C
const Sec_len            = $42

// ---- Drift guards — engine/constants.asm (+ bg.asm, structs.asm) are the
// source of truth; each compares this twin's value against the real AS-side
// equ through the link seam. A mismatch fails the link naming the constant. ----
ensure(extern("VRAM_PLANE_A") == VRAM_PLANE_A, "engine/constants.asm and section.emp disagree on VRAM_PLANE_A — update the twin")
ensure(extern("VRAM_PLANE_B_BYTES") == VRAM_PLANE_B_BYTES, "engine/level/bg.asm and section.emp disagree on VRAM_PLANE_B_BYTES — update the twin")
ensure(extern("PLANE_H_CELLS") == PLANE_H_CELLS, "engine/constants.asm and section.emp disagree on PLANE_H_CELLS — update the twin")
ensure(extern("PLANE_V_CELLS") == PLANE_V_CELLS, "engine/constants.asm and section.emp disagree on PLANE_V_CELLS — update the twin")
ensure(extern("PLANE_BUFFER_SIZE") == PLANE_BUFFER_SIZE, "engine/constants.asm and section.emp disagree on PLANE_BUFFER_SIZE — update the twin")
ensure(extern("TILE_CACHE_COLS") == TILE_CACHE_COLS, "engine/constants.asm and section.emp disagree on TILE_CACHE_COLS — update the twin")
ensure(extern("TILE_CACHE_ROWS") == TILE_CACHE_ROWS, "engine/constants.asm and section.emp disagree on TILE_CACHE_ROWS — update the twin")
ensure(extern("TILE_CACHE_STRIDE") == TILE_CACHE_STRIDE, "engine/constants.asm and section.emp disagree on TILE_CACHE_STRIDE — update the twin")
ensure(extern("TILE_CACHE_NT_SIZE") == TILE_CACHE_NT_SIZE, "engine/constants.asm and section.emp disagree on TILE_CACHE_NT_SIZE — update the twin")
ensure(extern("Act_sec_grid_ptr") == Act_sec_grid_ptr, "engine/structs.asm and section.emp disagree on Act_sec_grid_ptr — update the twin")
ensure(extern("Act_grid_w") == Act_grid_w, "engine/structs.asm and section.emp disagree on Act_grid_w — update the twin")
ensure(extern("Act_grid_h") == Act_grid_h, "engine/structs.asm and section.emp disagree on Act_grid_h — update the twin")
ensure(extern("Act_act_bg_layout") == Act_act_bg_layout, "engine/structs.asm and section.emp disagree on Act_act_bg_layout — update the twin")
ensure(extern("Sec_sec_bg_layout") == Sec_sec_bg_layout, "engine/structs.asm and section.emp disagree on Sec_sec_bg_layout — update the twin")
ensure(extern("Sec_len") == Sec_len, "engine/structs.asm and section.emp disagree on Sec_len — update the twin")
// The ×66 stride trick in Section_GetSecPtrXY (lsl #6 + lsl #1) assumes the Sec
// struct is 66 bytes — the AS twin's `if Sec_len <> 66 / error` guard.
ensure(Sec_len == 66, "Section_GetSecPtrXY stride (lsl #6 + lsl #1 = ×66) assumes Sec_len=66 — update the shifts")

// ---- VDP command macros (truth: engine/macros.asm). First .emp consumer. ----

// VDP command target/op as pure sum types: an out-of-vocabulary target or
// op cannot compile. Discriminants live ONCE — in the mapper fns below, not on
// the variants — so the enum is the vocabulary and the mapper is the single
// source of the %-encodings that feed the AS `(type & rwd)` derivation verbatim.
// Comptime-only (never emitted as data). (§4 pokes use Vram/Write; the full
// vocabulary is declared so a future consumer is type-checked and the exhaustive
// mappers force an update when a variant is added.)
comptime enum VdpTarget { Vram, Cram, Vsram }
comptime enum VdpOp     { Read, Write, Dma }

// The %-encodings (truth: engine/constants.asm). Exhaustive match — Plan-3
// totality checks it, so a new variant FORCES the mapper to grow.
comptime fn target_bits(t: VdpTarget) -> int {
    match t {
        Vram  => %100001,
        Cram  => %101011,
        Vsram => %100101,
    }
}
comptime fn op_bits(o: VdpOp) -> int {
    match o {
        Read  => %001100,
        Write => %000111,
        Dma   => %100111,
    }
}

// Drift-lock the MAPPING, not just the constants: each arm is pinned to its
// AS-side equ through the link seam, so the match itself can't drift.
ensure(target_bits(VdpTarget.Vram) == extern("VRAM"), "engine/constants.asm and section.emp disagree on VRAM — update target_bits")
ensure(target_bits(VdpTarget.Cram) == extern("CRAM"), "engine/constants.asm and section.emp disagree on CRAM — update target_bits")
ensure(target_bits(VdpTarget.Vsram) == extern("VSRAM"), "engine/constants.asm and section.emp disagree on VSRAM — update target_bits")
ensure(op_bits(VdpOp.Read) == extern("READ"), "engine/constants.asm and section.emp disagree on READ — update op_bits")
ensure(op_bits(VdpOp.Write) == extern("WRITE"), "engine/constants.asm and section.emp disagree on WRITE — update op_bits")
ensure(op_bits(VdpOp.Dma) == extern("DMA"), "engine/constants.asm and section.emp disagree on DMA — update op_bits")

// vdp_comm — build-time VDP command longword from a VRAM/CRAM/VSRAM byte
// address (mirrors the AS `vdpComm` function). The typed target/op feed the
// mappers; the derivation is the AS bit-trick verbatim.
comptime fn vdp_comm(addr: int, target: VdpTarget, op: VdpOp) -> int {
    let type = target_bits(target)
    let rwd = op_bits(op)
    return (((type & rwd) & 3) << 30) | ((addr & $3FFF) << 16) | (((type & rwd) & $FC) << 2) | ((addr & $C000) >> 14)
}

// vdp_comm_reg — convert a VRAM/CRAM/VSRAM byte address in `reg` to a VDP
// command longword IN PLACE (mirrors the AS `vdpCommReg` macro). The four guards
// below all select ENCODING CASES (which instructions to emit for the resolved
// bit pattern) — none are vocabulary validation, so the sum types added no
// unreachable guard to delete; they add call-site safety. Each guard is a small
// helper spliced into the one asm block (the lead_move/aabb pattern), so a
// not-taken arm emits nothing. `clr` defaults to `true`, the dominant vdpCommReg
// value ENGINE-WIDE (3:2 — section ×2 + one DMA-queue write pass clr=1; two
// DMA-queue `VRAM,DMA,0` sites pass clr=0). The clr=0 minority lives in the
// DMA-queue path (ports next), so future consumers WILL pass `clr: false` — the
// default is a mild convenience at a marginal 3:2, not a norm.
comptime fn vcr_addq(tr: int, reg: Reg) -> Code {
    let bits = tr & 3
    if bits != 0 { return asm { addq.w  #{bits}, {reg} } }
    return asm { }
}
comptime fn vcr_clr(clr: bool, reg: Reg) -> Code {
    if clr { return asm { andi.w  #3, {reg} } }
    return asm { }
}
comptime fn vcr_type(tr: int, reg: Reg) -> Code {
    let hi = tr & $FC
    if hi == $20 { return asm { tas.b   {reg} } }
    if hi != 0 { return asm { ori.w   #{hi << 2}, {reg} } }
    return asm { }
}
comptime fn vdp_comm_reg(reg: Reg, target: VdpTarget, op: VdpOp, clr: bool = true) -> Code {
    let tr = target_bits(target) & op_bits(op)
    return asm {
        lsl.l   #2, {reg}
        {vcr_addq(tr, reg)}
        ror.w   #2, {reg}
        swap    {reg}
        {vcr_clr(clr, reg)}
        {vcr_type(tr, reg)}
    }
}

// -----------------------------------------------
// Section_Init — record the act, fill nametable, init the entity window
// In:  a0 = act descriptor pointer (Act struct)
// Out: none
// Clobbers: d0–d7, a0–a4   (transitive via EntityWindow_Init)
// -----------------------------------------------
pub proc Section_Init () clobbers(d0-d7/a0-a4) {
        move.l  a0, Current_Act_Ptr             // (Current_Act_Ptr).w — ram.asm; abs.w by the width rule

        // -- set up column/row trackers; first frame streams the plane --
        jbsr    Section_FillInitial

        // -- §4.9: camera-driven entity window init --
        jbsr    EntityWindow_Init
        rts
}

// -----------------------------------------------
// Section_FillInitial — set up trackers; let Section_UpdateColumns
// fill plane on first frame.
//
// Trackers are seeded one column/row tight on each side of the camera so
// Section_UpdateColumns streams the visible window outward in scroll-
// direction order on the first frames (avoids a left-edge content pop).
//
// Out: Section_Right_Col_Written, Section_Left_Col_Written initialised
// Clobbers: d0 (the original AS header claimed "none", but the body scratches d0)
// -----------------------------------------------
pub proc Section_FillInitial () clobbers(d0) {
        move.l  Camera_X, d0                    // (Camera_X).w
        swap    d0
        lsr.w   #3, d0                          // d0 = camera world tile col
        subq.w  #1, d0
        move.w  d0, Section_Right_Col_Written
        addq.w  #1, d0
        move.w  d0, Section_Left_Col_Written

        move.l  Camera_Y, d0
        swap    d0
        lsr.w   #3, d0                          // d0 = camera world tile row
        subq.w  #1, d0
        move.w  d0, Section_Bottom_Row_Written
        addq.w  #1, d0
        move.w  d0, Section_Top_Row_Written
        rts
}

// -----------------------------------------------
// Section_FlatIDXY — flat section id from grid coordinates.
// In:  d2.b = sec_x, d3.b = sec_y, a2 = Act ptr
// Out: d0.w = sec_y * grid_w + sec_x
// Clobbers: d1     (d2/d3/a2 preserved)
// -----------------------------------------------
pub proc Section_FlatIDXY () clobbers(d1) out(d0) {
        moveq   #0, d0
        moveq   #0, d1
        move.b  d3, d1                          // d1 = sec_y
        subq.w  #1, d1
        bmi     .fxy_add_x
    .fxy_mul:
        add.w   Act_grid_w(a2), d0
        dbf     d1, .fxy_mul
    .fxy_add_x:
        moveq   #0, d1
        move.b  d2, d1                          // d1 = sec_x
        add.w   d1, d0
        rts
}

// -----------------------------------------------
// Section_GetSecPtrXY — Sec ptr lookup by grid coordinates (§4.2).
// In:  d2.b = sec_x, d3.b = sec_y, a2 = Act ptr
// Out: a0 = Sec ptr; Z clear if found, Z set if out of range (a0 = 0)
// Clobbers: d0, d1     (d2/d3/a2 preserved — sec_x stack-saved across multiply)
// -----------------------------------------------
pub proc Section_GetSecPtrXY () clobbers(d1) out(d0, a0) {
        cmp.b   Act_grid_w+1(a2), d2
        bcc     .out_of_range                   // sec_x >= grid_w (unsigned)
        cmp.b   Act_grid_h+1(a2), d3
        bcc     .out_of_range                   // sec_y >= grid_h (unsigned)

        // flat_id = sec_y * grid_w + sec_x (repeated-add, no multiply)
        moveq   #0, d0
        move.b  d3, d0                          // d0 = sec_y
        beq     .gxy_add_x
        move.w  d2, -(sp)                       // save sec_x input
        move.w  Act_grid_w(a2), d1              // d1 = grid_w
        move.w  d0, d2                          // d2 = sec_y counter
        moveq   #0, d0                          // d0 = accumulator
        subq.w  #1, d2
    .gxy_mul:
        add.w   d1, d0
        dbf     d2, .gxy_mul
        move.w  (sp)+, d2                       // restore sec_x
    .gxy_add_x:
        moveq   #0, d1
        move.b  d2, d1
        add.w   d1, d0                          // d0 = flat section index

        // d0 × Sec_len ($42 = 66 = 64 + 2)   [stride guard: module-level ensure]
        movea.l Act_sec_grid_ptr(a2), a0
        move.w  d0, d1
        lsl.w   #6, d0                          // flat × 64
        lsl.w   #1, d1                          // flat × 2
        add.w   d1, d0                          // flat × 66
        adda.w  d0, a0

        tst.l   (a0)
        beq     .out_of_range

        moveq   #1, d0                          // Z clear (success)
        rts
    .out_of_range:
        suba.l  a0, a0                          // a0 = 0
        moveq   #0, d0                          // Z set (not found)
        rts
}

// -----------------------------------------------
// Section_RedrawPlanes — camera-aware atomic full-plane rewrite (§4.2).
// Level-init draw + cache-recovery path only (via Section_Plane_Dirty);
// continuous-scroll streams the plane incrementally, so this never fires
// mid-traversal (~3 frames synchronous when it does run).
//
// Models sonic_hack's Dirty_flag → Draw_All pattern: the entire visible
// plane content is rewritten in one synchronous pass via direct VDP
// pokes. No multi-frame scroll-across.
//
// Camera-aware: fills 64 plane cols starting at Camera_X/8 (world col),
// reading each col straight from the tile cache. Nametable cell =
// world_col & 63 (continuous-scroll: world == engine, the plane is a
// 64-cell ring the world wraps through).
//
// In:  none (reads Camera_X, Cache_*, Current_Act_Ptr; Plane B derives the
//      on-screen section from the world camera for the BG layout ptr)
// Out: d5.w = start_world_col (for tracker reset by caller)
//      d7.w = start_world_col + 63 (for tracker reset by caller)
// Clobbers: d0–d7, a0–a4, a5–a6
// -----------------------------------------------
pub proc Section_RedrawPlanes () clobbers(d0-d4/d6/a0-a6) out(d5, d7) {
        lea     VDP_CTRL, a5                    // (VDP_CTRL).l — engine/constants.asm; abs.l by the width rule
        lea     VDP_DATA, a6
        move.w  sr, -(sp)
        move.w  #$2700, sr

        // -- Plane A: column-major write --
        move.w  #$8F80, (a5)

        // compute start nametable row from Cache_Top_Row (world_row & 63)
        move.w  Cache_Top_Row, d6
        andi.w  #63, d6                         // d6 = start_nt_row (preserved)

        // compute start world col = Camera_X >> 3
        move.l  Camera_X, d5
        swap    d5
        lsr.w   #3, d5                          // d5 = start_world_col

        moveq   #0, d3                          // col counter (0..63)
        lea     Tile_Cache_Nametable+TILE_CACHE_NT_SIZE, a0   // row-wrap sentinel
                                                // (a0 free until the Plane B pass)

    .pla_fill:
        move.w  d5, d7
        add.w   d3, d7                          // d7 = world_col

        // check cache range BEFORE setting VDP address — skip entirely
        // on miss so off-screen columns retain old nametable content
        // instead of flashing black/zero tiles
        cmp.w   Cache_Left_Col, d7
        blt     .pla_next
        cmp.w   Cache_Head_Col, d7
        bgt     .pla_next

        // convert world col → plane col (world_col & 63)
        move.w  d7, d0
        andi.w  #63, d0                         // d0 = plane_col = world_col & 63
        add.w   d0, d0                          // d0 = col byte offset
        move.w  d0, -(sp)                       // save for Part B

        // read from tile cache — compute cache column pointer
        move.w  d7, d0
        sub.w   Cache_Left_Col, d0
        add.w   Cache_Origin_Col, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .col_nowrap
        subi.w  #TILE_CACHE_COLS, d0
    .col_nowrap:
        add.w   d0, d0                          // byte offset = col × 2
        move.w  Cache_Origin_Row, d1
        move.w  d1, d2
        lsl.w   #7, d1                          // × 128
        lsl.w   #5, d2                          // × 32
        add.w   d2, d1                          // origin_row × 160 (stride bytes)
        add.w   d1, d0
        lea     Tile_Cache_Nametable, a1
        adda.w  d0, a1                          // a1 = cache[logical row 0][col]

        // -- Part A: nametable rows start_nt_row to 63 --
        move.w  (sp), d4                        // col byte offset
        move.w  d6, d2
        lsl.w   #7, d2                          // start_nt_row × 128
        add.w   d2, d4
        moveq   #0, d2
        move.w  d4, d2
        addi.l  #VRAM_PLANE_A, d2
        vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
        move.l  d2, (a5)

        move.w  #64, d2
        sub.w   d6, d2                          // d2 = count_A (rows in Part A)
        moveq   #TILE_CACHE_ROWS, d4
        cmp.w   d2, d4
        ble     .pA_clamp
        move.w  d2, d4                          // d4 = data_A = min(cache_rows, count_A)
    .pA_clamp:
        move.w  d4, d0
        subq.w  #1, d0
        bmi     .pA_dskip
    .pA_data:
        move.w  (a1), (a6)
        lea     TILE_CACHE_STRIDE*2(a1), a1
        cmpa.l  a0, a1
        blo     .pa_nowrap
        suba.w  #TILE_CACHE_NT_SIZE, a1         // physical row 59 → 0
    .pa_nowrap:
        dbf     d0, .pA_data
    .pA_dskip:
        move.w  d2, d0
        sub.w   d4, d0                          // zero_A = count_A - data_A
        subq.w  #1, d0
        bmi     .pA_zskip
        moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
    .pA_zero:
        move.w  d1, (a6)
        dbf     d0, .pA_zero
    .pA_zskip:

        // -- Part B: nametable rows 0 to start_nt_row - 1 --
        tst.w   d6
        beq     .pB_skip
        moveq   #0, d2
        move.w  (sp), d2                        // col byte offset
        addi.l  #VRAM_PLANE_A, d2
        vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
        move.l  d2, (a5)
        move.w  d6, d2                          // d2 = count_B = start_nt_row
        move.w  #TILE_CACHE_ROWS, d0
        sub.w   d4, d0                          // remaining cache rows
        ble     .pB_allz
        cmp.w   d2, d0
        ble     .pB_dok
        move.w  d2, d0
    .pB_dok:
        move.w  d0, d4
        subq.w  #1, d0
    .pB_data:
        move.w  (a1), (a6)
        lea     TILE_CACHE_STRIDE*2(a1), a1
        cmpa.l  a0, a1
        blo     .pb_nowrap
        suba.w  #TILE_CACHE_NT_SIZE, a1         // physical row 59 → 0
    .pb_nowrap:
        dbf     d0, .pB_data
        move.w  d2, d0
        sub.w   d4, d0
        subq.w  #1, d0
        bmi     .pB_skip
        moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
    .pB_zfill:
        move.w  d1, (a6)
        dbf     d0, .pB_zfill
        jbra    .pB_skip
    .pB_allz:
        move.w  d2, d0
        subq.w  #1, d0
        moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
    .pB_az:
        move.w  d1, (a6)
        dbf     d0, .pB_az
    .pB_skip:
        addq.l  #2, sp                          // pop col byte offset

    .pla_next:
        addq.w  #1, d3
        cmpi.w  #64, d3
        blt     .pla_fill

        // -- Plane B: row-major linear write (BG layout is act-wide, not position-dependent) --
        // Continuous-scroll: derive the on-screen section straight from the
        // world camera (sec_x = Camera_X >> SECTION_SIZE_SHIFT, sec_y likewise).
        // At level init the camera sits in the start section, so this returns the
        // start section's BG.
        movea.l Current_Act_Ptr, a2
        move.w  Camera_X, d2                    // world X px (16.16 high word)
        moveq   #SECTION_SIZE_SHIFT, d0
        asr.w   d0, d2                          // d2.w = sec_x
        move.w  Camera_Y, d3                    // world Y px
        asr.w   d0, d3                          // d3.w = sec_y
        jbsr    Section_GetSecPtrXY             // a0 = on-screen Sec ptr (Z set = none)
        beq     .plb_use_act_layout
        movea.l Sec_sec_bg_layout(a0), a1
        cmpa.w  #0, a1
        bne     .plb_have_layout
    .plb_use_act_layout:
        movea.l Act_act_bg_layout(a2), a1       // T1 fallback to act-level BG
        cmpa.w  #0, a1
        beq     .plb_done
    .plb_have_layout:
        move.w  #$8F02, (a5)                    // autoincrement $02 (row-major)
        move.l  #vdp_comm(VRAM_PLANE_B_BYTES, VdpTarget.Vram, VdpOp.Write), (a5)
        move.w  #1024-1, d3                     // 4096 bytes / 4 = 1024 longwords - 1
    .plb_loop:
        move.l  (a1)+, (a6)
        dbf     d3, .plb_loop
    .plb_done:
        // Restore default autoincrement (matches VInt_DrawLevel cleanup)
        move.w  #$8F02, (a5)

        // Restore interrupt mask (allow VBlank again)
        move.w  (sp)+, sr

        // -- return tracker bounds in d5/d7 for caller --
        // Clamp to cache range so Section_UpdateColumns streams any
        // columns we skipped (outside cache at redraw time).
        move.w  Cache_Left_Col, d0
        cmp.w   d0, d5
        bge     .track_left_ok
        move.w  d0, d5
    .track_left_ok:
        move.w  Cache_Head_Col, d7
        rts
}

// -----------------------------------------------
// Section_UpdateColumns — per-frame nametable ring-buffer streaming
// Writes newly-revealed tile columns on right and left edges each frame.
// Must be called AFTER Camera_X is updated each frame.
//
// CROSS-CLAMP: each edge, after streaming, clamps the OPPOSITE tracker to its
// value ± 63 (the VDP 64-cell plane-wrap span). So streaming the right edge
// pulls the left tracker forward (right − 63) and vice-versa — the trackers
// bound each other to one wrap window; the .{left,right,top,bottom} clamp-skips
// write the sibling tracker, not their own.
// In:  none
// Out: none
// Clobbers: d0–d7, a0–a3, a5–a6 (a5/a6 only when Plane_Dirty triggers redraw)
// -----------------------------------------------
pub proc Section_UpdateColumns () clobbers(d0-d7/a0-a3/a5-a6) {
        // -- §4.2: full-plane redraw if dirty (level init + cache recovery only) --
        tst.b   Section_Plane_Dirty
        beq     .not_dirty
        clr.b   Section_Plane_Dirty
        jbsr    Section_RedrawPlanes
        move.w  d7, Section_Right_Col_Written
        move.w  d5, Section_Left_Col_Written
        // mem-to-mem: two width-PINNED abs operands. Explicit .w (not the bare
        // house spelling) — the bare form would demand two-way RelaxAbsSym
        // (unbuilt; ledgered). Zero byte cost: RAM syms, the asl width rule
        // converges to abs.w anyway.
        move.w  (Cache_Top_Row).w, (Section_Top_Row_Written).w
        move.w  (Cache_Bottom_Row).w, (Section_Bottom_Row_Written).w
        rts
    .not_dirty:
        movem.l d2-d7/a0-a3, -(sp)

        move.l  Camera_X, d6
        swap    d6                              // d6.w = Camera_X pixels

        // -------- right side --------
        move.w  d6, d7
        addi.w  #327, d7
        lsr.w   #3, d7                          // d7 = right_needed world col

        // clamp to act boundary
        movea.l Current_Act_Ptr, a0
        moveq   #0, d0
        move.w  Act_grid_w(a0), d0
        lsl.w   #8, d0
        subq.w  #1, d0
        cmp.w   d0, d7
        ble     .right_clamp_ok
        move.w  d0, d7
    .right_clamp_ok:
        // clamp to cache bounds
        move.w  Cache_Head_Col, d0
        cmp.w   d0, d7
        ble     .right_cache_ok
        move.w  d0, d7
    .right_cache_ok:
        // clamp to VDP plane wrap: max right = visible_left_world + 63
        move.w  d6, d0
        lsr.w   #3, d0                          // camera tile col (world)
        addi.w  #63, d0                         // max right = visible_left + 63 VDP cells
        cmp.w   d0, d7
        ble     .right_wrap_ok
        move.w  d0, d7
    .right_wrap_ok:

        move.w  Section_Right_Col_Written, d5
    .right_loop:
        cmp.w   d7, d5
        bge     .right_done
        // reserve Draw_TileColumn's worst case: 2 headers (8) + 64 words —
        // a column split at the NT row 63/0 seam emits two entries
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (8 + PLANE_V_CELLS*2), Plane_Buffer_Ptr
        bhi     .right_done
        addq.w  #1, d5

        // convert world col → nametable position (world_col & 63)
        move.w  d5, d0
        andi.w  #63, d0                         // d0 = nametable col = world_col & 63

        move.w  d5, d1                          // d1 = world col
        move.w  d5, -(sp)
        jbsr    Draw_TileColumn
        move.w  (sp)+, d5
        jbra    .right_loop
    .right_done:
        move.w  d5, Section_Right_Col_Written
        move.w  d5, d3
        subi.w  #63, d3                         // left = right - 63 (VDP wrap span)
        cmp.w   Cache_Left_Col, d3             // clamp to cache: left = max(., Cache_Left_Col)
        bge     .right_done_cache_ok
        move.w  Cache_Left_Col, d3
    .right_done_cache_ok:
        cmp.w   Section_Left_Col_Written, d3
        ble     .left_clamp_skip
        move.w  d3, Section_Left_Col_Written
    .left_clamp_skip:

        // -------- left side --------
        move.w  d6, d7
        lsr.w   #3, d7                          // d7 = left_needed world col

        // clamp to cache and act bounds
        move.w  Cache_Left_Col, d0
        cmp.w   d0, d7
        bge     .left_cache_ok
        move.w  d0, d7
    .left_cache_ok:
        // clamp to VDP plane wrap: min left = visible_right_world - 63
        move.w  d6, d0
        addi.w  #327, d0                        // visible_right_px = Camera_X + screen−1
        lsr.w   #3, d0
        subi.w  #63, d0                         // min left = visible_right − 63 VDP cells
        cmp.w   d0, d7
        bge     .left_wrap_ok
        move.w  d0, d7
    .left_wrap_ok:

        move.w  Section_Left_Col_Written, d5
    .left_loop:
        cmp.w   d7, d5
        ble     .left_done
        // reserve Draw_TileColumn's worst case: 2 headers (8) + 64 words —
        // a column split at the NT row 63/0 seam emits two entries
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (8 + PLANE_V_CELLS*2), Plane_Buffer_Ptr
        bhi     .left_done
        subq.w  #1, d5

        move.w  d5, d0
        andi.w  #63, d0                         // nametable col = world_col & 63

        move.w  d5, d1
        move.w  d5, -(sp)
        jbsr    Draw_TileColumn
        move.w  (sp)+, d5
        jbra    .left_loop
    .left_done:
        move.w  d5, Section_Left_Col_Written
        move.w  d5, d3
        addi.w  #63, d3                         // right = left + 63 (VDP wrap span)
        cmp.w   Cache_Head_Col, d3             // clamp to cache: right = min(., Cache_Head_Col)
        ble     .left_done_cache_ok
        move.w  Cache_Head_Col, d3
    .left_done_cache_ok:
        cmp.w   Section_Right_Col_Written, d3
        bge     .right_clamp_skip2
        move.w  d3, Section_Right_Col_Written
    .right_clamp_skip2:

        // -------- bottom side (vertical row streaming) --------
        move.l  Camera_Y, d6
        swap    d6
        move.w  d6, d7
        addi.w  #231, d7                        // 224 + 7
        lsr.w   #3, d7                          // d7 = bottom_needed world row

        // clamp to cache bounds
        move.w  Cache_Bottom_Row, d0
        cmp.w   d0, d7
        ble     .bot_cache_ok
        move.w  d0, d7
    .bot_cache_ok:

        move.w  Section_Bottom_Row_Written, d5
    .bot_loop:
        cmp.w   d7, d5
        bge     .bot_done
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (4 + PLANE_H_CELLS*2), Plane_Buffer_Ptr
        bhi     .bot_done
        addq.w  #1, d5

        // convert world row → nametable row (world_row & 63)
        move.w  d5, d0
        andi.w  #63, d0                         // d0 = nametable row = world_row & 63

        move.w  d5, d1                          // d1 = world row
        move.w  d5, -(sp)
        jbsr    Draw_TileRow_FromCache
        move.w  (sp)+, d5
        jbra    .bot_loop
    .bot_done:
        move.w  d5, Section_Bottom_Row_Written
        move.w  d5, d3
        subi.w  #63, d3                         // top = bottom - 63 (VDP wrap span)
        cmp.w   Cache_Top_Row, d3              // clamp to cache: top = max(., Cache_Top_Row)
        bge     .bot_done_cache_ok
        move.w  Cache_Top_Row, d3
    .bot_done_cache_ok:
        cmp.w   Section_Top_Row_Written, d3
        ble     .top_row_clamp_skip
        move.w  d3, Section_Top_Row_Written
    .top_row_clamp_skip:

        // -------- top side --------
        lsr.w   #3, d6
        move.w  d6, d7                          // d7 = top_needed world row

        move.w  Cache_Top_Row, d0
        cmp.w   d0, d7
        bge     .top_cache_ok
        move.w  d0, d7
    .top_cache_ok:

        move.w  Section_Top_Row_Written, d5
    .top_loop:
        cmp.w   d7, d5
        ble     .top_done
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (4 + PLANE_H_CELLS*2), Plane_Buffer_Ptr
        bhi     .top_done
        subq.w  #1, d5

        move.w  d5, d0
        andi.w  #63, d0                         // nametable row = world_row & 63

        move.w  d5, d1
        move.w  d5, -(sp)
        jbsr    Draw_TileRow_FromCache
        move.w  (sp)+, d5
        jbra    .top_loop
    .top_done:
        move.w  d5, Section_Top_Row_Written
        move.w  d5, d3
        addi.w  #63, d3                         // bottom = top + 63 (VDP wrap span)
        cmp.w   Cache_Bottom_Row, d3          // clamp to cache: bottom = min(., Cache_Bottom_Row)
        ble     .top_done_cache_ok
        move.w  Cache_Bottom_Row, d3
    .top_done_cache_ok:
        cmp.w   Section_Bottom_Row_Written, d3
        bge     .bot_row_clamp_skip
        move.w  d3, Section_Bottom_Row_Written
    .bot_row_clamp_skip:

        movem.l (sp)+, d2-d7/a0-a3
        rts
}
