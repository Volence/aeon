// Section streaming engine (§4)
// Continuous-scroll: the camera, player, and all entities live in WORLD
// coordinates and the level scrolls live with no section rebases. World ==
// engine throughout; the nametable is a 64-cell ring the world wraps through.

module engine.section in section

use engine.constants.{SECTION_SIZE_SHIFT, PLANE_H_CELLS, VRAM_PLANE_B_BYTES, MAX_ACT_SECTIONS}
use engine.constants.{TILE_CACHE_COLS, TILE_CACHE_ROWS, TILE_CACHE_STRIDE, TILE_CACHE_NT_SIZE}
use engine.constants.{VRAM_PLANE_A, PLANE_V_CELLS, PLANE_BUFFER_SIZE, VDP_DATA, VDP_CTRL}
use engine.constants.{SECTION_H_REACH_PX, SECTION_V_REACH_PX}
// Canopy-gap capture instrument (DEBUG only) — see Canopy_Probe at the foot of this file.
use engine.constants.{SCREEN_LAST_COL_MAX, SCREEN_LAST_ROW_MAX, VDP_HV_COUNTER}
use engine.constants.{CANOPY_C1, CANOPY_C4, CANOPY_PERSIST_FRAMES}
use engine.structs.{Act, Sec, Act_grid_w_lo, Act_grid_h_lo}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm, vdp_comm_reg}
use engine.z80_bus.{z80_stopped}
// SND_DMA_ACTIVE_SLOT (the 68k-side DMA-window flag slot) is a global linker
// symbol defined by engine.vblank; referenced bare below for the poke-storm bracket.

// ---- Sec / Act field access comes from the shared engine.structs module
// (`Sec.field(aN)` / `Act.field(aN)`, the grid-dim low-byte views via
// Act_grid_w_lo / Act_grid_h_lo) — the file-local offset-const mirrors are gone. ----

// ---- VRAM_PLANE_A / PLANE_V_CELLS / PLANE_BUFFER_SIZE + the TILE_CACHE_* /
// Sec-Act layout all come from the shared engine.constants + engine.structs
// modules (`use`d above), which carry the drift locks. ----
// (Act/Sec field-offset drift guards now live in engine.structs' per-field wall.)
// Section_GetSecPtrXY multiplies the flat id by sizeof(Sec) = 66; the `ensure`
// keeps 66 the real stride.
ensure(sizeof(Sec) == 66, "Section_GetSecPtrXY's stride pin: sizeof(Sec) moved off 66. The walk now spells #sizeof(Sec) so the STRIDE follows automatically — this pin exists because the section GRID and its generated tables assume 66, so a struct change is a data-format change, not just a stride change")
// Section_GetSecPtrXY's `adda.w d0, a0` (d0 = flat × 66) sign-extends the word
// offset: once flat × 66 crosses $7FFF the pointer wraps negative, capping an act
// at $7FFF / 66 = 496 sections. That MAX_ACT_SECTIONS ≤ 496 ceiling is asserted at
// its owner (games/.../act_descriptor.emp, beside the other mega-act grid
// ceilings) — MAX_ACT_SECTIONS is a drift-guarded const there, so the check stays
// comptime and doesn't demand the extern when section is compiled standalone.
// MAX_ACT_SECTIONS (48) is far under 496 today.

// ---- VDP command macros (truth: engine/macros.asm). First .emp consumer. ----

// The typed VDP command interface (VdpTarget/VdpOp sum types + vdp_comm /
// vdp_comm_reg derivations) lives in the shared engine.vdp module — hoisted
// there when plane_buffer became the 2nd consumer (gap-ledger row 1073).

// -----------------------------------------------
// Section_Init — record the act, fill nametable, init the entity window
// In:  a0 = act descriptor pointer (Act struct)
// Out: none
// Clobbers: d0–d7, a0–a4   (transitive via EntityWindow_Init)
// -----------------------------------------------
pub proc Section_Init (a0: *Act) clobbers(d0-d7/a0-a4) {
        move.l  a0, Current_Act_Ptr             // (Current_Act_Ptr).w — ram.asm; abs.w by the width rule

        // -- set up column/row trackers; first frame streams the plane --
        jbsr    Section_FillInitial

        // -- §4.9: camera-driven entity window init --
        jbsr    EntityWindow_Init
        rts
}

// -----------------------------------------------
// Section_FillInitial — set up trackers; let Section_UpdateColumns
// fill plane on first frame.
//
// Trackers are seeded one column/row tight on each side of the camera so
// Section_UpdateColumns streams the visible window outward in scroll-
// direction order on the first frames (avoids a left-edge content pop).
//
// Out: Section_Right_Col_Written, Section_Left_Col_Written initialised
// Clobbers: d0 (the original AS header claimed "none", but the body scratches d0)
// -----------------------------------------------
pub proc Section_FillInitial () clobbers(d0) {
        move.l  Camera_X, d0                    // (Camera_X).w
        swap    d0
        lsr.w   #3, d0                          // d0 = camera world tile col
        subq.w  #1, d0
        move.w  d0, Section_Right_Col_Written
        addq.w  #1, d0
        move.w  d0, Section_Left_Col_Written

        move.l  Camera_Y, d0
        swap    d0
        lsr.w   #3, d0                          // d0 = camera world tile row
        subq.w  #1, d0
        move.w  d0, Section_Bottom_Row_Written
        addq.w  #1, d0
        move.w  d0, Section_Top_Row_Written
        rts
}

// -----------------------------------------------
// Section_FlatIDXY — flat section id from grid coordinates.
// In:  d2 = sec_x, d3 = sec_y (GridY), a2 = Act ptr
// Out: d0 = sec_y * grid_w + sec_x (SectionId)
// Clobbers: d1     (d2/d3/a2 preserved)
// NOTE: d2 (sec_x) is left u8, NOT GridX. At the 3×3-window build site
// (EntityWindow_BuildEntries) this is called immediately after
// Section_GetSecPtrXY, whose body no longer touches d2 at all but whose
// contract still DECLARES d2 clobbered — so a typed GridX in d2 still cannot be
// proven to survive that call. The GridY axis DOES survive (GetSecPtrXY
// preserves d3), so d3 carries the axis-split swap guard here; typing d2 GridX
// is BANKED until GetSecPtrXY's declaration narrows to match its body.
// -----------------------------------------------
pub proc Section_FlatIDXY (d2: u8, d3: GridY, a2: *Act) clobbers(d1) out(d0: SectionId) {
        moveq   #0, d0
        moveq   #0, d1
        move.b  d3, d1                          // d1 = sec_y
        subq.w  #1, d1
        bmi     .fxy_add_x
    .fxy_mul:
        add.w   Act.grid_w(a2), d0
        dbf     d1, .fxy_mul
    .fxy_add_x:
        moveq   #0, d1
        move.b  d2, d1                          // d1 = sec_x
        add.w   d1, d0
        rts
}

// -----------------------------------------------
// Section_GetSecPtrXY — Sec ptr lookup by grid coordinates (§4.2).
// In:  d2 = sec_x (GridX), d3 = sec_y (GridY), a2 = Act ptr
// Out: a0 = Sec ptr; d0 = found flag (Z clear if found, Z set if out of range,
//      a0 = 0) — a boolean, NOT a SectionId, so d0 is untyped here.
// Clobbers: d1, d2     (the body preserves d2 — sec_x rides through it and the
//      bounded multiply needs no loop counter — but the declared contract keeps
//      d2 clobbered so a caller cannot carry a typed GridX in d2 across this
//      call; the declaration stays uniform with Section_FlatIDXY's d2.)
// -----------------------------------------------
pub proc Section_GetSecPtrXY (d2: GridX, d3: GridY, a2: *Act) clobbers(d1-d2) out(d0, a0, zero: none) {
        cmp.b   Act_grid_w_lo(a2), d2
        bcc     .out_of_range                   // sec_x >= grid_w (unsigned)
        cmp.b   Act_grid_h_lo(a2), d3
        bcc     .out_of_range                   // sec_y >= grid_h (unsigned)

        // flat_id = sec_y * grid_w + sec_x. The bound constrains the COUNTER
        // operand, which here is d1 = grid_w: the range checks above passed, so
        // grid_h >= 1 and therefore grid_w <= grid_w*grid_h <= MAX_ACT_SECTIONS.
        // The bounded multiply prices the WORST case, so mulu's flat 70 beats a
        // repeated-add loop's 24 + 14*grid_w from grid_w = 4 up; a small grid_w
        // would still run cheaper as a loop, and worst-case cost is what the
        // construct budgets. This is not a hot path — one call per section
        // lookup, off the per-frame streaming path.
        moveq   #0, d0
        move.b  d3, d0                          // d0 = sec_y
        move.w  Act.grid_w(a2), d1              // d1 = grid_w
        mul_bounded.w d0, d1, #MAX_ACT_SECTIONS // d0 = sec_y * grid_w
        moveq   #0, d1
        move.b  d2, d1                          // d1 = sec_x (d2 = sec_x input, preserved)
        add.w   d1, d0                          // d0 = flat section index

        movea.l Act.sec_grid_ptr(a2), a0
        mul_const.w d0, #sizeof(Sec), d1         // d0 = flat × the Sec stride (d1 = multiply scratch)
        adda.w  d0, a0                          // sign-extends d0 → ≤496 sections (module ensure guards it)

        tst.l   (a0)
        beq     .out_of_range

        moveq   #1, d0                          // Z clear (success)
        rts
    .out_of_range:
        suba.l  a0, a0                          // a0 = 0
        moveq   #0, d0                          // Z set (not found)
        rts
}

// -----------------------------------------------
// Section_RedrawPlanes — camera-aware atomic full-plane rewrite (§4.2).
// Level-init draw + cache-recovery path only (via Section_Plane_Dirty);
// continuous-scroll streams the plane incrementally, so this never fires
// mid-traversal (~3 frames synchronous when it does run).
//
// Models sonic_hack's Dirty_flag → Draw_All pattern: the entire visible
// plane content is rewritten in one synchronous pass via direct VDP
// pokes. No multi-frame scroll-across.
//
// Camera-aware: fills 64 plane cols starting at Camera_X/8 (world col),
// reading each col straight from the tile cache. Nametable cell =
// world_col & 63 (continuous-scroll: world == engine, the plane is a
// 64-cell ring the world wraps through).
//
// Z80 POSTURE — THIS ROUTINE OWNS IT; DO NOT WRAP THE CALL.
// The storm is a ~3-frame direct-VDP poke run, so a caller-side bus hold is
// both wrong and unenforceable:
//   * sound ON  — halting the Z80 for ~3 frames starves the DAC outright. The
//     correct posture is the engine-wide SND_CTRL_DMA_ACTIVE flag bracket (the
//     same one VInt_Level uses): the Z80 keeps running but takes its DRAIN path
//     and issues no banked ROM read, so it never touches the 68k bus window
//     while the storm pokes VDP. That is the property bus-holding would buy,
//     without killing sound.
//   * sound OFF — no driver to hand that contract to, so the bus IS held for
//     the whole storm.
// Both are raised/lowered INSIDE this proc. A caller-side bus hold is actively
// harmful under sound ON: the flag bracket's own release frees the caller's hold
// (a bus request is not a counting lock), so the caller would run the rest of
// the storm believing it holds a bus it does not.
//
// In:  none (reads Camera_X, Cache_*, Current_Act_Ptr; Plane B derives the
//      on-screen section from the world camera for the BG layout ptr)
// Out: d5.w = max(start_world_col, Cache_Left_Col)          (tracker reset by caller)
//      d7.w = min(start_world_col + 63, Cache_Head_Col)      (tracker reset by caller)
//      i.e. EXACTLY the extent `.pla_fill` drew: the 64-column run from
//      start_world_col, intersected with the cache range. Both halves are
//      clamps; d7's was an ASSIGNMENT until 2026-08-29 (see the tail).
//      Both are WORDS and nothing above them is a result: d5's high word is
//      whatever `swap` left there (Camera_X's sub-pixel fraction), so a caller
//      that reads either long reads garbage.
// Clobbers: d0–d4/d6, a0–a6, plus the CCR half of SR — the body saves the full
//   SR (`move.w sr,-(sp)`), masks to $2700 for the poke storm, then restores it
//   (`move.w (sp)+,sr`); the mask round-trips with no return inside the span.
//   The post-restore cmp/bge clamp dirties only CCR. So `preserves(sr.mask)`
//   (the interrupt mask is caller-safe) partitions against `clobbers(sr.ccr)`
//   (the tail clamp's flags escape) — the QueueDMA_Deferrable / Sound_DrainSfxRing
//   split.
// -----------------------------------------------
pub proc Section_RedrawPlanes () clobbers(d0-d4/d6/a0-a6/sr.ccr) out(d5: u16, d7: u16) preserves(sr.mask) {
        lea     VDP_CTRL, a5                    // (VDP_CTRL).l — engine.vdp const; abs.l by the width rule
        lea     VDP_DATA, a6
        move.w  sr, -(sp)
        move.w  #$2700, sr

        // Sound (flag bracket): this redraw masks IRQs for a ~3-frame VDP poke
        // storm, so VInt_Level cannot manage the DMA-window flag across it. Raise
        // SND_CTRL_DMA_ACTIVE=1 (the same bracket VInt_Level uses) so the Z80
        // producer takes its DRAIN path and never issues a banked ROM read that
        // would contend with the storm and underrun the DAC. The raise's own
        // bus-held write sits inside the SR mask, so a mid-bracket IRQ6 can't
        // release the bus under it. Lowered before the SR restore below.
        // Sound-OFF build: there is no driver to hand the DRAIN contract to, so
        // the flag write is meaningless and the Z80 is unmanaged for the whole
        // storm. Hold the bus across it instead (nothing to starve without a
        // driver). This routine owns its Z80 posture in BOTH shapes — see the
        // Z80-POSTURE note in the header — so callers must NOT wrap it.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #1, SND_DMA_ACTIVE_SLOT // raise: poke storm open (Z80 -> DRAIN)
            }
        }
        // The $2700 mask above is now load-bearing for a SECOND consumer. Both
        // plane passes below take an autoincrement excursion ($8F80 direct to
        // VDP_CTRL, restored to $8F02 at the end), bypassing the VDP shadow —
        // and Flush_VDP_Shadow re-blits reg $0F from that shadow every VBlank.
        // A VBlank landing inside either excursion would push $02 back under
        // this routine's feet and the remaining column writes would stride by 2
        // instead of $80, scribbling rows across the nametable. One masked span
        // covers both excursions.
        if DEBUG == 1 {
            move.w  sr, d0
            andi.w  #$0700, d0
            assert.w d0, hs, #$0600     // IPL >= 6: no VBlank can land mid-excursion
        }
        // Comptime-gated so ONE body serves both shapes (see the Z80-POSTURE note).
        with z80_stopped if SOUND_DRIVER_ENABLED == 0 {
            // -- Plane A: column-major write --
            move.w  #$8F80, (a5)

            // compute start nametable row from Cache_Top_Row (world_row & 63)
            move.w  Cache_Top_Row, d6
            andi.w  #63, d6                         // d6 = start_nt_row (preserved)

            // compute start world col = Camera_X >> 3
            move.l  Camera_X, d5
            swap    d5
            lsr.w   #3, d5                          // d5 = start_world_col

            moveq   #0, d3                          // col counter (0..63)
            lea     Tile_Cache_Nametable+TILE_CACHE_NT_SIZE, a0   // row-wrap sentinel
                                                    // (a0 free until the Plane B pass)

        .pla_fill:
            move.w  d5, d7
            add.w   d3, d7                          // d7 = world_col

            // check cache range BEFORE setting VDP address — skip entirely
            // on miss so off-screen columns retain old nametable content
            // instead of flashing black/zero tiles
            cmp.w   Cache_Left_Col, d7
            blt     .pla_next
            cmp.w   Cache_Head_Col, d7
            bgt     .pla_next

        if DEBUG == 1 {
            // CANOPY SHADOW. This column IS about to be poked into plane A, so the
            // shadow records it here and not from the extent d7 returns at the tail —
            // recording from the returned extent would make the shadow agree with the
            // claim by construction, which is exactly the claim under suspicion.
            // No `assert` in this block: it sits inside `with z80_stopped` (EMP_PITFALLS
            // §6 Trap A), and plain stores are all it needs. a3 is free for the whole
            // pass (a2 is not touched until the Plane B section below); d0 and d4 are
            // both assigned before use below.
            move.w  d7, d4
            andi.w  #PLANE_H_CELLS-1, d4
            add.w   d4, d4                      // d4 = plane col × 2 (dead by .pA_clamp below)
            lea     Canopy_ColW, a3
            move.w  d7, (a3, d4.w)
            lea     Canopy_ColTop, a3
            move.w  Cache_Top_Row, d0
            move.w  d0, (a3, d4.w)
            lea     Canopy_ColFrame, a3
            move.w  Frame_Counter, d0
            move.w  d0, (a3, d4.w)
        }

            // convert world col → plane col (world_col & 63)
            move.w  d7, d0
            andi.w  #63, d0                         // d0 = plane_col = world_col & 63
            add.w   d0, d0                          // d0 = col byte offset
            move.w  d0, -(sp)                       // save for Part B

            // read from tile cache — compute cache column pointer
            move.w  d7, d0
            sub.w   Cache_Left_Col, d0
            add.w   Cache_Origin_Col, d0
            cmpi.w  #TILE_CACHE_COLS, d0
            blt     .col_nowrap
            subi.w  #TILE_CACHE_COLS, d0
        .col_nowrap:
            add.w   d0, d0                          // byte offset = col × 2
            move.w  Cache_Origin_Row, d1
            mul_const.w d1, #160, d2                // origin_row × 160 (stride bytes; d2 = scratch)
            add.w   d1, d0
            lea     Tile_Cache_Nametable, a1
            adda.w  d0, a1                          // a1 = cache[logical row 0][col]

            // -- Part A: nametable rows start_nt_row to 63 --
            move.w  (sp), d4                        // col byte offset
            move.w  d6, d2
            lsl.w   #7, d2                          // start_nt_row × 128
            add.w   d2, d4
            moveq   #0, d2
            move.w  d4, d2
            addi.l  #VRAM_PLANE_A, d2
            vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
            move.l  d2, (a5)

            move.w  #64, d2
            sub.w   d6, d2                          // d2 = count_A (rows in Part A)
            moveq   #TILE_CACHE_ROWS, d4
            cmp.w   d2, d4
            ble     .pA_clamp
            move.w  d2, d4                          // d4 = data_A = min(cache_rows, count_A)
        .pA_clamp:
            move.w  d4, d0
            subq.w  #1, d0
            bmi     .pA_dskip
        .pA_data:
            move.w  (a1), (a6)
            lea     TILE_CACHE_STRIDE*2(a1), a1
            cmpa.l  a0, a1
            blo     .pa_nowrap
            suba.w  #TILE_CACHE_NT_SIZE, a1         // physical row 59 → 0
        .pa_nowrap:
            dbf     d0, .pA_data
        .pA_dskip:
            move.w  d2, d0
            sub.w   d4, d0                          // zero_A = count_A - data_A
            subq.w  #1, d0
            bmi     .pA_zskip
            moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
        .pA_zero:
            move.w  d1, (a6)
            dbf     d0, .pA_zero
        .pA_zskip:

            // -- Part B: nametable rows 0 to start_nt_row - 1 --
            tst.w   d6
            beq     .pB_skip
            moveq   #0, d2
            move.w  (sp), d2                        // col byte offset
            addi.l  #VRAM_PLANE_A, d2
            vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
            move.l  d2, (a5)
            move.w  d6, d2                          // d2 = count_B = start_nt_row
            move.w  #TILE_CACHE_ROWS, d0
            sub.w   d4, d0                          // remaining cache rows
            ble     .pB_allz
            cmp.w   d2, d0
            ble     .pB_dok
            move.w  d2, d0
        .pB_dok:
            move.w  d0, d4
            subq.w  #1, d0
        .pB_data:
            move.w  (a1), (a6)
            lea     TILE_CACHE_STRIDE*2(a1), a1
            cmpa.l  a0, a1
            blo     .pb_nowrap
            suba.w  #TILE_CACHE_NT_SIZE, a1         // physical row 59 → 0
        .pb_nowrap:
            dbf     d0, .pB_data
            move.w  d2, d0
            sub.w   d4, d0
            subq.w  #1, d0
            bmi     .pB_skip
            moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
        .pB_zfill:
            move.w  d1, (a6)
            dbf     d0, .pB_zfill
            jbra    .pB_skip
        .pB_allz:
            move.w  d2, d0
            subq.w  #1, d0
            moveq   #0, d1                          // zero source (clr.w would RMW-read VDP)
        .pB_az:
            move.w  d1, (a6)
            dbf     d0, .pB_az
        .pB_skip:
            addq.l  #2, sp                          // pop col byte offset

        .pla_next:
            addq.w  #1, d3
            cmpi.w  #64, d3
            blt     .pla_fill

            // -- Plane B: column-major write (BG layout is act-wide, not position-dependent) --
            // Continuous-scroll: derive the on-screen section straight from the
            // world camera (sec_x = Camera_X >> SECTION_SIZE_SHIFT, sec_y likewise).
            // At level init the camera sits in the start section, so this returns the
            // start section's BG.
            movea.l Current_Act_Ptr, a2
            move.w  Camera_X, d2                    // world X px (16.16 high word)
            moveq   #SECTION_SIZE_SHIFT, d0
            asr.w   d0, d2 as GridX                 // d2.w = sec_x
            move.w  Camera_Y, d3                    // world Y px
            asr.w   d0, d3 as GridY                 // d3.w = sec_y
            jbsr    Section_GetSecPtrXY             // a0 = on-screen Sec ptr (Z set = none)
            beq     .plb_use_act_layout
            movea.l Sec.sec_bg_layout(a0), a1
            cmpa.w  #0, a1
            bne     .plb_have_layout
        .plb_use_act_layout:
            movea.l Act.act_bg_layout(a2), a1       // T1 fallback to act-level BG
            cmpa.w  #0, a1
            beq     .plb_done
        .plb_have_layout:
            // Column-major blit. The layout blob is column-contiguous
            // (blob[col*128 + row*2], 64 rows/column). Per column: set the VDP
            // address to the column's top cell and drain ALL 64 rows with autoinc
            // $80, so one move.l = two VERTICALLY-adjacent cells — exactly two
            // adjacent source words. 32 move.l per column (NEW-5, 2026-08-05:
            // the maintainers used to stop at 32 rows, silently half-reverting
            // any BG art in rows 32-63 — which shipped OJZ art carries and the
            // full-plane vscroll wrap shows on screen). 64 per-column command
            // setups are init/recovery-only noise, not a per-frame cost; the
            // storm grows ~3 -> ~4 frames, init/cache-recovery only.
            move.w  #$8F80, (a5)                    // autoincrement $80 (step one plane row/word)
            moveq   #0, d3                          // d3 = column index 0..63
        .plb_col:
            moveq   #0, d2
            move.w  d3, d2
            add.w   d2, d2                          // d2 = col*2 (byte offset of row 0)
            addi.l  #VRAM_PLANE_B_BYTES, d2
            vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Write)
            move.l  d2, (a5)
            moveq   #32-1, d2                       // 32 longwords = 64 words = rows 0..63
        .plb_word:
            move.l  (a1)+, (a6)
            dbf     d2, .plb_word                   // a1 lands on the next column (stride 128 B)
            addq.w  #1, d3
            cmpi.w  #64, d3
            blt     .plb_col
        .plb_done:
            // Restore default autoincrement (matches VInt_DrawLevel cleanup)
            move.w  #$8F02, (a5)
        }

        // Sound (flag bracket close): the poke storm is finished — ROM is safe to
        // read again. Clear SND_CTRL_DMA_ACTIVE=0 so the Z80 producer leaves DRAIN
        // and resumes FILL read-ahead. Still inside the SR mask (the bus-held write
        // stays IRQ-protected); the mask is released immediately below.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #0, SND_DMA_ACTIVE_SLOT // lower: poke storm closed (Z80 -> FILL)
            }
        }

        // Restore interrupt mask (allow VBlank again)
        move.w  (sp)+, sr

        // -- return tracker bounds in d5/d7 for caller --
        // Clamp BOTH to the cache range so Section_UpdateColumns streams any
        // columns we skipped (outside cache at redraw time).
        //
        // SECTION-HEAD-CLAMP (2026-08-29). The d7 half used to be a bare
        // `move.w Cache_Head_Col, d7` — an ASSIGNMENT where the d5 half beside it
        // is a real `max`, and the comment above has said "clamp" since the day
        // only one of the two was one. INVARIANT: the recorded head never exceeds
        // the extent `.pla_fill` actually drew. `.pla_fill` walks exactly 64
        // columns from start_world_col (`moveq #0,d3` .. `cmpi.w #64,d3`) and
        // skips those outside [Cache_Left_Col, Cache_Head_Col], so the drawn
        // extent is `[start_world_col, start_world_col+63] ∩ [Left, Head]` and its
        // right end is `min(start_world_col + 63, Head)`. Head alone over-claims
        // by `16 - cam_col` columns whenever `cam_col < 16` (at cam_col 16..19 the
        // drawn extent already reaches Head, so there is no over-claim there —
        // Tile_Cache_Init sets Left = max(0, cam_col-20), Head = Left + 79).
        //
        // COMPUTED BEFORE THE d5 CLAMP, FROM THE UNCLAMPED d5, and that ordering is
        // the derivation and not a convenience: the fill's right end is set by the
        // 64-column run's own start, not by where the cache cut its left edge, so
        // `Cache_Left_Col + 63` would over-claim again on exactly the redraws the
        // left clamp exists for (cam_col below the cache's left edge).
        //
        // IT CANNOT REACH THE SCREEN TODAY and it is fixed anyway. The redraw's
        // call site returns before the streaming loops, and the first frame that
        // runs them cross-clamps Right down to the drawn extent at `.left_done`
        // below; on top of that, both Section_Plane_Dirty setters guarantee a
        // camera at rest. It goes live the moment the cache-recovery path this
        // proc's own header advertises actually exists — a recovery redraw fired
        // mid-traversal, at speed, near the act's left edge is the uncovered case.
        // Desk-checked in full at DEFERRED_WORK "CANOPY GAP", which refuted the
        // over-claim as that bug's cause and booked this residual.
        move.w  d5, d7
        addi.w  #63, d7                         // d7 = start_world_col + 63 (.pla_fill's 64 cols)
        cmp.w   Cache_Head_Col, d7
        ble     .track_right_ok
        move.w  Cache_Head_Col, d7
    .track_right_ok:
        move.w  Cache_Left_Col, d0
        cmp.w   d0, d5
        bge     .track_left_ok
        move.w  d0, d5
    .track_left_ok:
        rts
}

// -----------------------------------------------
// Section_UpdateColumns — per-frame nametable ring-buffer streaming
// Writes newly-revealed tile columns on right and left edges each frame.
// Must be called AFTER Camera_X is updated each frame.
//
// CROSS-CLAMP: each edge, after streaming, clamps the OPPOSITE tracker to its
// value ± 63 (the VDP 64-cell plane-wrap span). So streaming the right edge
// pulls the left tracker forward (right − 63) and vice-versa — the trackers
// bound each other to one wrap window; the .{left,right,top,bottom} clamp-skips
// write the sibling tracker, not their own. Every cross-clamp only ever SHRINKS
// its sibling's claim (LW/TW rise, RW/BW fall), so the four loops below are the
// only sites that can widen one — which is why the filled-extent stop lives in
// them and nowhere else.
//
// THE TRACKERS ARE A PROMISE (2026-08-29). A cell inside
// Section_{Left,Right}_Col_Written × Section_{Top,Bottom}_Row_Written is not
// revisited until the 64-cell plane ring wraps onto it, tens of seconds of
// travel later. So the invariant these four loops must keep is exactly: A CELL
// RECORDED AS WRITTEN WAS ACTUALLY WRITTEN. Anything drawn from cache the fill
// had not populated, and then recorded, is a permanent hole on screen.
//
// DECLARED IS NOT FILLED. Tile_Cache_Fill commits Cache_Head_Col /
// Cache_Left_Col / Cache_Bottom_Row / Cache_Top_Row BEFORE running the fill for
// the column/row it just added (the resume machinery is keyed by that committed
// coordinate). A budget-out or a demand stall therefore leaves the DECLARED
// window advertising one column and/or one row the fill only partly wrote. At
// most one of each can be outstanding — a partial exhausts the frame budget,
// which stops all further work on that axis, and the two resume preambles finish
// it before any new extension — and the fill publishes precisely which one:
// Cache_Fill_Resume_Col and Cache_Fill_RowResume_Row, both $FFFF when there is
// none. That pair IS the filled extent (declared minus the pending partial); it
// needs no parallel bookkeeping, because the same instruction that creates a
// partial is the one that names it.
//
// So each loop STOPS at a partial rather than drawing it, and stops WITHOUT
// advancing its tracker. The cell is drawn a frame or two later, once the resume
// preamble has completed it. Declining inside Draw_TileColumn instead would not
// work and is the shape of the original defect: the callee's decline is silent
// and the caller records the column either way.
// In:  none
// Out: none
// Clobbers: d0–d7, a0–a3, a5–a6 (a5/a6 only when Plane_Dirty triggers redraw)
// -----------------------------------------------
pub proc Section_UpdateColumns () clobbers(d0-d7/a0-a3/a5-a6) {
        // -- §4.2: full-plane redraw if dirty (level init + cache recovery only) --
        tst.b   Section_Plane_Dirty
        beq     .not_dirty
        clr.b   Section_Plane_Dirty
    if DEBUG == 1 {
        // Section_RedrawPlanes draws the WHOLE declared cache window and the four
        // tracker writes below record all of it, so a pending partial here would be
        // recorded as written — the very thing the four loops now refuse. It cannot
        // happen today: the only two Section_Plane_Dirty setters (level init and the
        // DEBUG warp) both run immediately after Tile_Cache_Init → TileCache_FillAll,
        // which is unbudgeted, runs with the display off and stores the $FFFF
        // no-partial sentinel on both axes. Assert it rather than leave the redraw
        // path's correctness resting on where the flag happens to be set from.
        move.w  Cache_Fill_Resume_Col, d0
        assert.w d0, eq, #$FFFF
        move.w  Cache_Fill_RowResume_Row, d0
        assert.w d0, eq, #$FFFF
    }
        // CANOPY INSTRUMENT: clear the shadow before the redraw, so anything the redraw
        // does NOT draw reads as $FFFF ("nothing ever wrote this plane cell") rather than
        // as a stale value from before. $FFFF is not a plausible world coordinate, so the
        // sweep's ordinary compare fires on it with no special case — and a visible plane
        // column nothing ever wrote IS the shape of an over-claimed tracker, which is the
        // thing the sweep is here to see. The row shadow is cleared for the opposite
        // reason: a redraw writes COLUMNS, so every plane row is column-owned afterwards
        // and its stale row anchor must not be tested against the new camera.
    if DEBUG == 1 {
        lea     Canopy_ColW, a0
        lea     Canopy_RowR, a1
        lea     Canopy_ColFrame, a2
        lea     Canopy_RowFrame, a3
        moveq   #PLANE_H_CELLS-1, d0
        moveq   #0, d1
    .canopy_clear:
        move.w  #$FFFF, (a0)+
        move.w  #$FFFF, (a1)+
        move.w  d1, (a2)+
        move.w  d1, (a3)+
        dbf     d0, .canopy_clear
    }
        jbsr    Section_RedrawPlanes
    if DEBUG == 1 {
        // Latch what the redraw CLAIMED, before the two lines below turn the claim into
        // the trackers. Canopy_Redraw_R against the shadow the sweep later reads is the
        // whole of the (b) attribution: a d7 further right than any column the redraw's
        // .pla_fill actually stamped is an over-claim, and nothing else in the machine
        // records that d7 after these two stores overwrite the trackers with it.
        move.w  Frame_Counter, d0
        move.w  d0, Canopy_Redraw_Fr
        move.w  d5, Canopy_Redraw_L
        move.w  d7, Canopy_Redraw_R
    }
        move.w  d7, Section_Right_Col_Written
        move.w  d5, Section_Left_Col_Written
        // mem-to-mem: two width-PINNED abs operands. Explicit .w (not the bare
        // house spelling) — the bare form would demand two-way RelaxAbsSym
        // (unbuilt; ledgered). Zero byte cost: RAM syms, the asl width rule
        // converges to abs.w anyway.
        move.w  (Cache_Top_Row).w, (Section_Top_Row_Written).w        // widths pinned: mem-to-mem two-symbolic operands
        move.w  (Cache_Bottom_Row).w, (Section_Bottom_Row_Written).w  // widths pinned: mem-to-mem two-symbolic operands
        rts
    .not_dirty:
        movem.l d2-d7/a0-a2, -(sp)              // a3 is preserved across the whole span (Draw_TileColumn/Draw_TileRow_FromCache clobber d0-d5/a0-a2)

        move.l  Camera_X, d6
        swap    d6                              // d6.w = Camera_X pixels

        // -------- right side --------
        move.w  d6, d7
        addi.w  #SECTION_H_REACH_PX, d7
        lsr.w   #3, d7                          // d7 = right_needed world col (= last visible col + 1)

        // clamp to act boundary
        movea.l Current_Act_Ptr, a0
        moveq   #0, d0
        move.w  Act.grid_w(a0), d0
        lsl.w   #8, d0
        subq.w  #1, d0
        cmp.w   d0, d7
        ble     .right_clamp_ok
        move.w  d0, d7
    .right_clamp_ok:
        // clamp to cache bounds
        move.w  Cache_Head_Col, d0
        cmp.w   d0, d7
        ble     .right_cache_ok
        move.w  d0, d7
    .right_cache_ok:
        // clamp to VDP plane wrap: max right = visible_left_world + 63
        move.w  d6, d0
        lsr.w   #3, d0                          // camera tile col (world)
        addi.w  #63, d0                         // max right = visible_left + 63 VDP cells
        cmp.w   d0, d7
        ble     .right_wrap_ok
        move.w  d0, d7
    .right_wrap_ok:

        move.w  Section_Right_Col_Written, d5
    .right_loop:
        cmp.w   d7, d5
        bge     .right_done
        // reserve Draw_TileColumn's worst case: 2 headers (8) + 64 words —
        // a column split at the NT row 63/0 seam emits two entries
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (8 + PLANE_V_CELLS*2), Plane_Buffer_Ptr
        bhi     .right_done
        // filled, not merely declared (see the header): stop before a column the
        // tile-cache fill left half-written, so .right_done does not record it
        move.w  d5, d0
        addq.w  #1, d0
        cmp.w   Cache_Fill_Resume_Col, d0
        beq     .right_done
        addq.w  #1, d5

        // convert world col → nametable position (world_col & 63)
        move.w  d5, d0
        andi.w  #63, d0                         // d0 = nametable col = world_col & 63

        move.w  d5, d1                          // d1 = world col
        move.w  d5, -(sp)
        jbsr    Draw_TileColumn
        move.w  (sp)+, d5
        jbra    .right_loop
    .right_done:
        move.w  d5, Section_Right_Col_Written
        move.w  d5, d3
        subi.w  #63, d3                         // left = right - 63 (VDP wrap span)
        cmp.w   Cache_Left_Col, d3             // clamp to cache: left = max(., Cache_Left_Col)
        bge     .right_done_cache_ok
        move.w  Cache_Left_Col, d3
    .right_done_cache_ok:
        cmp.w   Section_Left_Col_Written, d3
        ble     .left_clamp_skip
        move.w  d3, Section_Left_Col_Written
    .left_clamp_skip:

        // -------- left side --------
        move.w  d6, d7
        lsr.w   #3, d7                          // d7 = left_needed world col

        // clamp to cache and act bounds
        move.w  Cache_Left_Col, d0
        cmp.w   d0, d7
        bge     .left_cache_ok
        move.w  d0, d7
    .left_cache_ok:
        // clamp to VDP plane wrap: min left = visible_right_world - 63
        move.w  d6, d0
        addi.w  #SECTION_H_REACH_PX, d0        // visible_right_px = Camera_X + screen−1, rounded up one tile
        lsr.w   #3, d0
        subi.w  #63, d0                         // min left = visible_right − 63 VDP cells
        cmp.w   d0, d7
        bge     .left_wrap_ok
        move.w  d0, d7
    .left_wrap_ok:

        move.w  Section_Left_Col_Written, d5
    .left_loop:
        cmp.w   d7, d5
        ble     .left_done
        // reserve Draw_TileColumn's worst case: 2 headers (8) + 64 words —
        // a column split at the NT row 63/0 seam emits two entries
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (8 + PLANE_V_CELLS*2), Plane_Buffer_Ptr
        bhi     .left_done
        // filled, not merely declared (see the header) — the left fill commits
        // Cache_Left_Col before filling it, so the partial can sit on this edge too
        move.w  d5, d0
        subq.w  #1, d0
        cmp.w   Cache_Fill_Resume_Col, d0
        beq     .left_done
        subq.w  #1, d5

        move.w  d5, d0
        andi.w  #63, d0                         // nametable col = world_col & 63

        move.w  d5, d1
        move.w  d5, -(sp)
        jbsr    Draw_TileColumn
        move.w  (sp)+, d5
        jbra    .left_loop
    .left_done:
        move.w  d5, Section_Left_Col_Written
        move.w  d5, d3
        addi.w  #63, d3                         // right = left + 63 (VDP wrap span)
        cmp.w   Cache_Head_Col, d3             // clamp to cache: right = min(., Cache_Head_Col)
        ble     .left_done_cache_ok
        move.w  Cache_Head_Col, d3
    .left_done_cache_ok:
        cmp.w   Section_Right_Col_Written, d3
        bge     .right_clamp_skip2
        move.w  d3, Section_Right_Col_Written
    .right_clamp_skip2:

        // -------- bottom side (vertical row streaming) --------
        move.l  Camera_Y, d6
        swap    d6
        move.w  d6, d7
        addi.w  #SECTION_V_REACH_PX, d7        // SCREEN_HEIGHT + 7
        lsr.w   #3, d7                          // d7 = bottom_needed world row

        // clamp to cache bounds
        move.w  Cache_Bottom_Row, d0
        cmp.w   d0, d7
        ble     .bot_cache_ok
        move.w  d0, d7
    .bot_cache_ok:

        move.w  Section_Bottom_Row_Written, d5
    .bot_loop:
        cmp.w   d7, d5
        bge     .bot_done
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (4 + PLANE_H_CELLS*2), Plane_Buffer_Ptr
        bhi     .bot_done
        // filled, not merely declared (see the header). IDENTICAL exposure on the row
        // axis: .v_bottom_fill commits Cache_Bottom_Row before calling TileCache_FillRow,
        // whose partial leaves the cols from Cache_Fill_RowResume_Col rightward unwritten
        move.w  d5, d0
        addq.w  #1, d0
        cmp.w   Cache_Fill_RowResume_Row, d0
        beq     .bot_done
        addq.w  #1, d5

        // convert world row → nametable row (world_row & 63)
        move.w  d5, d0
        andi.w  #63, d0                         // d0 = nametable row = world_row & 63

        move.w  d5, d1                          // d1 = world row
        move.w  d5, -(sp)
        jbsr    Draw_TileRow_FromCache
        move.w  (sp)+, d5
        jbra    .bot_loop
    .bot_done:
        move.w  d5, Section_Bottom_Row_Written
        move.w  d5, d3
        subi.w  #63, d3                         // top = bottom - 63 (VDP wrap span)
        cmp.w   Cache_Top_Row, d3              // clamp to cache: top = max(., Cache_Top_Row)
        bge     .bot_done_cache_ok
        move.w  Cache_Top_Row, d3
    .bot_done_cache_ok:
        cmp.w   Section_Top_Row_Written, d3
        ble     .top_row_clamp_skip
        move.w  d3, Section_Top_Row_Written
    .top_row_clamp_skip:

        // -------- top side --------
        lsr.w   #3, d6
        move.w  d6, d7                          // d7 = top_needed world row

        move.w  Cache_Top_Row, d0
        cmp.w   d0, d7
        bge     .top_cache_ok
        move.w  d0, d7
    .top_cache_ok:

        move.w  Section_Top_Row_Written, d5
    .top_loop:
        cmp.w   d7, d5
        ble     .top_done
        cmpi.w  #PLANE_BUFFER_SIZE - 2 - (4 + PLANE_H_CELLS*2), Plane_Buffer_Ptr
        bhi     .top_done
        // filled, not merely declared (see the header) — .v_top_fill commits
        // Cache_Top_Row before filling the new top row, same as the bottom edge
        move.w  d5, d0
        subq.w  #1, d0
        cmp.w   Cache_Fill_RowResume_Row, d0
        beq     .top_done
        subq.w  #1, d5

        move.w  d5, d0
        andi.w  #63, d0                         // nametable row = world_row & 63

        move.w  d5, d1
        move.w  d5, -(sp)
        jbsr    Draw_TileRow_FromCache
        move.w  (sp)+, d5
        jbra    .top_loop
    .top_done:
        move.w  d5, Section_Top_Row_Written
        move.w  d5, d3
        addi.w  #63, d3                         // bottom = top + 63 (VDP wrap span)
        cmp.w   Cache_Bottom_Row, d3          // clamp to cache: bottom = min(., Cache_Bottom_Row)
        ble     .top_done_cache_ok
        move.w  Cache_Bottom_Row, d3
    .top_done_cache_ok:
        cmp.w   Section_Bottom_Row_Written, d3
        bge     .bot_row_clamp_skip
        move.w  d3, Section_Bottom_Row_Written
    .bot_row_clamp_skip:

    if DEBUG == 1 {
        // The canopy sweep runs HERE — after all four loops, so the frame's plane content
        // is final — and NOT on the `.not_dirty` early-return path above, where the redraw
        // has just made everything consistent by construction. Its clobbers (d0-d7/a0-a3)
        // are inside this proc's own declared set and land above the movem restore below.
        jbsr    Canopy_Probe
    }
        movem.l (sp)+, d2-d7/a0-a2
        rts
}

// =================================================================================
// THE CANOPY-GAP CAPTURE INSTRUMENT (DEBUG only — zero bytes in release)
// =================================================================================
//
// WHY IT EXISTS, and why it is a capture and not a check. The reported canopy gap has
// outlived two derived explanations (`docs/DEFERRED_WORK.md`, "CANOPY GAP"): the
// declared-before-filled defect was real, was fixed, and did not account for the
// sighting; the vertical fill path was then exercised plain and starved and came back
// clean. Derivation is 0-for-2 here. So this records the state a third derivation would
// need, at the moment a disagreement occurs, and offers no verdict about which of the
// two live candidates — or of some third thing — is the cause. THE FIRST FIRE IS LATCHED
// AND NEVER OVERWRITTEN, because later fires are consequences of the first.
//
// WHAT MAKES A SHADOW NECESSARY, and it is the load-bearing fact of the whole design:
// which world cell a plane cell holds CANNOT be read back out of VRAM. The act's tileset
// is globally deduplicated, so a given tile word legitimately belongs to many world
// cells and the plane records no provenance. The writers are the only things that ever
// know, and only at the instant they write. Everything here follows from that —
// `Canopy_ColW`/`Canopy_ColTop` are written by the column writers (`Draw_TileColumn`,
// `Section_RedrawPlanes`' `.pla_fill`), `Canopy_RowR` by the row writer
// (`Draw_TileRow_FromCache`), each at the last point before its bytes are committed and
// after every one of its bails.
//
// THE TWO WRITERS USE DIFFERENT ANCHORS FOR THE SAME 2D CONTENT, and that is the whole
// source of the disagreements this measures:
//
//   * a COLUMN write puts world column W at plane column `W & 63` — self-consistent by
//     construction on the column axis — and maps its 64 rows from `Cache_Top_Row`,
//     filling `TILE_CACHE_ROWS` of cache data and zeroing the rest;
//   * a ROW write puts world row V at plane row `V & 63` — self-consistent on the row
//     axis — and maps its 64 columns from `R = min(Section_Right_Col_Written,
//     Cache_Head_Col)`, choosing for each plane column the one world column congruent to
//     it mod 64 that lies in `[R-63, R]`.
//
// So each writer is right about its OWN axis and is asserting something about the
// OTHER's. TWO predicates are shipped, one per candidate:
//
//   C1 (the sweep, engine-side)   — a visible plane column does not hold the world
//        column the camera says it holds. Every column write puts W at `W & 63`, so any
//        disagreement is a whole multiple of 64: the plane is showing the wrap twin from
//        512 px away, in a full-height stripe, or (`$FFFF`) nothing ever wrote it. That
//        is the shape a tracker recording columns no writer reached would leave —
//        candidate (b) — but the instrument does not say so, it says what it measured.
//   C4 (at the row write's own site) — the anchor a row write is about to impose does
//        not cover the visible columns. That write is about to source ~40 of the row's
//        41 visible cells from 512 px away, and only later column writes repair them one
//        column at a time. That is candidate (a)'s shape, caught where the anchor and
//        the camera actually met rather than reconstructed afterwards.
//
// C1 IS ATTRIBUTED, and without the attribution it would be a false-positive generator.
// A plane column whose stored world column is stale may nonetheless be showing correct
// cells: a ROW write rewrites every column of its row, repairing them. So C1 fires only
// where at least one VISIBLE plane row is older than the column write — `Canopy_ColFrame`
// beats the minimum `Canopy_RowFrame` over the visible rows — which is exactly "some
// visible cell of this column is still owned by that stale column write". The comparison
// is a signed difference, not an unsigned compare, so `Frame_Counter`'s 16-bit wrap
// (every ~18 minutes) cannot invert it.
//
// TWO FURTHER PREDICATES WERE WRITTEN AND DROPPED as unsound; the reasoning is at
// CANOPY_C1 in `engine/system/constants.emp` and it is a finding, not an omission. Both
// questions survive in the capture, which snapshots all four shadow arrays.
//
// WHAT IT DELIBERATELY DOES NOT DO: judge. The record carries the trackers, the cache
// window, the fill's partial sentinels, the last redraw's returned extent and a frozen
// copy of the whole shadow, so the attribution is done off the machine, by a reader,
// against the numbers — not here, by a predicate. A fire whose numbers match NEITHER
// candidate is the outcome worth the most.

// -----------------------------------------------
// Canopy_Fire — latch one disagreement. DEBUG only; zero bytes in release.
// In:  d0.w = fire code (CANOPY_C1 / CANOPY_C4)
//      d1.w = plane index the fire is about (column for C1, row for C4)
//      d2.w = the world coordinate the fire was looking at
//      d3.w = what the shadow says instead (the anchor R, for C4)
// Out: none
// PRESERVES EVERY REGISTER, deliberately: it is called from inside
// `Draw_TileRow_FromCache`, whose `clobbers` contract is declared for BOTH shapes and
// must not widen because a DEBUG probe was added under it. The movem is paid only on the
// fire path, which never runs in a correct frame.
// -----------------------------------------------
pub proc Canopy_Fire (d0: u16, d1: u16, d2: u16, d3: u16) {
    if DEBUG == 1 {
        movem.l d0-d7/a0-a6, -(sp)

        // Per-code counting happens whether or not this fire wins the latch. How often a
        // code fires is a measurement the single latch cannot carry.
        move.w  d0, d4
        subq.w  #1, d4
        add.w   d4, d4                          // d4 = (code - 1) × 2
        lea     Canopy_Hits, a0
        addq.w  #1, (a0, d4.w)
        cmpi.w  #1, (a0, d4.w)
        bne     .counted                        // not this code's first fire
        lea     Canopy_First_Fr, a0
        move.w  Frame_Counter, d5
        move.w  d5, (a0, d4.w)
    .counted:

        tst.w   Canopy_Rec_Code
        bne     .already                        // first fire wins; this one is only counted

        move.w  d0, Canopy_Rec_Code
        move.w  d1, Canopy_Rec_Idx
        move.w  d2, Canopy_Rec_Want
        move.w  d3, Canopy_Rec_Got

        // The stamp is read HERE, from the shadow, by code — never passed in. A caller
        // that computed it separately could hand over a stamp belonging to a different
        // index than the one it named, and the record would be self-inconsistent with
        // nothing in it to reveal that.
        add.w   d1, d1                          // plane index -> byte offset
        cmpi.w  #CANOPY_C4, d0
        beq     .stamp_row
        lea     Canopy_ColFrame, a0
        jbra    .stamp_read
    .stamp_row:
        lea     Canopy_RowFrame, a0
    .stamp_read:
        move.w  (a0, d1.w), d4
        move.w  d4, Canopy_Rec_Stamp

        move.w  Frame_Counter, d4
        move.w  d4, Canopy_Rec_Frame
        move.l  Camera_X, d5
        move.l  d5, Canopy_Rec_CamX
        move.l  Camera_Y, d5
        move.l  d5, Canopy_Rec_CamY

        // The trackers and the cache window, verbatim. Every copy goes through d4 rather
        // than mem-to-mem: two symbolic RAM operands need both widths pinned by hand and
        // these span two regions, so the round trip buys the spelling out of the question
        // on a path that runs once.
        move.w  Section_Right_Col_Written, d4
        move.w  d4, Canopy_Rec_SecR
        move.w  Section_Left_Col_Written, d4
        move.w  d4, Canopy_Rec_SecL
        move.w  Section_Bottom_Row_Written, d4
        move.w  d4, Canopy_Rec_SecB
        move.w  Section_Top_Row_Written, d4
        move.w  d4, Canopy_Rec_SecT
        move.w  Cache_Head_Col, d4
        move.w  d4, Canopy_Rec_CacheHead
        move.w  Cache_Left_Col, d4
        move.w  d4, Canopy_Rec_CacheLeft
        move.w  Cache_Top_Row, d4
        move.w  d4, Canopy_Rec_CacheTop
        move.w  Cache_Bottom_Row, d4
        move.w  d4, Canopy_Rec_CacheBot
        move.w  Cache_Origin_Col, d4
        move.w  d4, Canopy_Rec_OrgCol
        move.w  Cache_Origin_Row, d4
        move.w  d4, Canopy_Rec_OrgRow
        move.w  Cache_Fill_Resume_Col, d4
        move.w  d4, Canopy_Rec_ResumeCol
        move.w  Cache_Fill_RowResume_Row, d4
        move.w  d4, Canopy_Rec_ResumeRow
        move.w  Plane_Buffer_Ptr, d4
        move.w  d4, Canopy_Rec_PBPtr
        move.w  Cache_Art_Stall, d4
        move.w  d4, Canopy_Rec_Stall
        move.w  Canopy_Redraw_Fr, d4
        move.w  d4, Canopy_Rec_RedrawFr
        move.w  Canopy_Redraw_L, d4
        move.w  d4, Canopy_Rec_RedrawL
        move.w  Canopy_Redraw_R, d4
        move.w  d4, Canopy_Rec_RedrawR

        // Freeze the whole shadow. The scalars above name ONE offending index; this says
        // how many there are, whether they are contiguous, which side of the window they
        // fall on, and — through the two frame-stamp arrays — which writer owns every
        // visible cell. A record read minutes after a sighting reads a live shadow that
        // has long since moved on, so without this the shape of the damage, and the two
        // predicates that were dropped as unsound, are all unrecoverable.
        lea     Canopy_ColW,          a0
        lea     Canopy_Snap_ColW,     a1
        jbsr    .snap
        lea     Canopy_ColTop,        a0
        lea     Canopy_Snap_ColTop,   a1
        jbsr    .snap
        lea     Canopy_ColFrame,      a0
        lea     Canopy_Snap_ColFrame, a1
        jbsr    .snap
        lea     Canopy_RowR,          a0
        lea     Canopy_Snap_RowR,     a1
        jbsr    .snap
        lea     Canopy_RowFrame,      a0
        lea     Canopy_Snap_RowFrame, a1
        jbsr    .snap

    .already:
        // The owner-armed halt. Default 0 = latch silently and keep playing, because a
        // predicate this parcel could not test against a real sighting must not be able
        // to end a session on a false positive. Set Canopy_Halt nonzero from the bus
        // before an unattended run and the machine stops itself on the next fire instead,
        // which is the only way a sighting survives nobody watching.
        tst.w   Canopy_Halt
        beq     .out
        raise_error "Canopy_Fire: a plane cell disagrees with the camera - read Canopy_Rec_* and the Canopy_Snap_* arrays (tools/canopy_record.py)"
    .out:
        movem.l (sp)+, d0-d7/a0-a6
        rts

    // -- copy one 64-word shadow array (a0) to its snapshot (a1). Clobbers d0/a0/a1. --
    .snap:
        moveq   #PLANE_H_CELLS/2 - 1, d0        // 32 longwords = 64 words
    .snap_loop:
        move.l  (a0)+, (a1)+
        dbf     d0, .snap_loop
        rts
    }
}

// -----------------------------------------------
// Canopy_Persist — the C1 persistence gate. DEBUG only; zero bytes in release.
// Same argument registers as Canopy_Fire, and it preserves every register for the same
// reason. A disagreement latches only after CANOPY_PERSIST_FRAMES consecutive sweeps
// report the SAME (code, plane index): the reported symptom is a hole that stays, and a
// streamer one column behind for a frame is not it. Past the threshold every subsequent
// sweep fires too, so Canopy_Hits counts FRAMES the condition has held, which is the
// number that says whether a capture is a lasting hole or a blip.
// -----------------------------------------------
pub proc Canopy_Persist (d0: u16, d1: u16, d2: u16, d3: u16) {
    if DEBUG == 1 {
        movem.l d0-d7/a0-a6, -(sp)
        cmp.w   Canopy_Pend_Code, d0
        bne     .fresh
        cmp.w   Canopy_Pend_Idx, d1
        bne     .fresh
        addq.w  #1, Canopy_Pend_Age
        cmpi.w  #CANOPY_PERSIST_FRAMES, Canopy_Pend_Age
        blo     .out
        jbsr    Canopy_Fire                     // d0-d3 are still the arguments (movem does not alter them)
        jbra    .out
    .fresh:
        move.w  d0, Canopy_Pend_Code
        move.w  d1, Canopy_Pend_Idx
        move.w  #1, Canopy_Pend_Age
    .out:
        movem.l (sp)+, d0-d7/a0-a6
        rts
    }
}

// -----------------------------------------------
// Canopy_Probe — the once-per-frame half of the instrument. DEBUG only; zero bytes in
// release. Called from Section_UpdateColumns after all four streaming loops, and NOT on
// its `.not_dirty` early-return path, where a redraw has just made everything consistent
// by construction.
//
// PASS 1, over the 29 visible plane rows: the minimum `Canopy_RowFrame` across them.
// That single number is C1's attribution — see the block comment above. A visible row
// that has never been row-written carries stamp 0, which drives the minimum to 0 and
// makes C1's ownership test trivially true, correctly: that row is column-owned.
//
// PASS 2, over the 41 visible plane columns: C1. `Canopy_ColW[P]` must be the world
// column the camera says plane column P holds. `$FFFF` (nothing has written this plane
// column since the last full redraw) reads as a disagreement through the same compare,
// with no special case — and a visible plane column nothing ever wrote is precisely the
// shape of an over-claimed tracker.
//
// NEITHER PASS CONSULTS A TRACKER, which is the point: `Section_*_Written` is one of the
// two things under suspicion, so a predicate built on it could not see the suspicion.
// Both passes are built from the camera and the shadow alone.
//
// SELF-PRICED. The sweep brackets itself with the V counter (the house profiling idiom,
// games/sonic4/test/object_test_state.emp) and leaves the cost in `Canopy_Cost` /
// `Canopy_Cost_Peak`, in scanlines. It is written this way because the cost of an
// instrument left armed across ordinary play is the one number nobody should take on
// trust from a cycle table — and this tree's cycle tables have been wrong by 2.5x, 6x and
// 33% on consecutive parcels. A difference above 100 lines is a V-counter wrap across the
// frame boundary, not a measurement, and is discarded rather than recorded as a peak.
// DERIVED PREDICTION, recorded so the reading can refute it. Decoded from the emitted
// encodings of THIS build, not from the source:
//   pass 1   29 iterations × 54-56 cyc   = 1,599
//   pass 2   41 iterations × 52 cyc      = 2,136
//   fixed    prologues 92 + 68, tail 34, epilogue 126, the caller's bsr.w 18  =  338
//   ------------------------------------------------------------------------------
//   sweep total                          = 4,073 cycles, no violation found
// That is 8.3 scanlines at 488.57 68000 cycles/line, and 3.2% of a 128,006-cycle NTSC
// frame. The two per-write halves add 106 cycles per column write and 254 per on-screen
// row write (158 for an off-screen one), so an ordinary frame with one of each is ~4,433
// cycles, 3.5%. Bus contention is NOT in these figures; they are the instruction stream
// alone. SO: Canopy_Cost should read 8, occasionally 9, and Canopy_Cost_Peak 9 or 10. If
// it reads materially higher, the derivation is wrong and the machine is right — this
// tree's cycle tables have been wrong by 2.5x, 6x and 33% on consecutive parcels, which
// is exactly why the number is measured at runtime and not merely written down here.
//
// In:  none
// Out: none
// Clobbers: d0-d7, a0-a3
// -----------------------------------------------
pub proc Canopy_Probe () clobbers(d0-d7/a0-a3) {
    if DEBUG == 1 {
        move.w  VDP_HV_COUNTER, -(sp)           // self-price, entry (V counter in the high byte)

        // ---- pass 1: the minimum row-write stamp over the visible plane rows ----
        move.l  Camera_Y, d4
        swap    d4
        lsr.w   #3, d4                          // d4 = camRow, the topmost visible world row
        move.w  d4, d0
        andi.w  #PLANE_V_CELLS-1, d0
        add.w   d0, d0                          // d0 = plane row × 2, walked with wrap
        move.w  Frame_Counter, d5               // d5 = running minimum; no stamp can be newer than now
        lea     Canopy_RowFrame, a0
        moveq   #SCREEN_LAST_ROW_MAX, d6
    .row_min:
        move.w  (a0, d0.w), d3
        move.w  d3, d2
        sub.w   d5, d2                          // signed difference: wrap-safe past Frame_Counter's 16-bit roll
        bpl     .row_keep
        move.w  d3, d5
    .row_keep:
        addq.w  #2, d0
        andi.w  #PLANE_V_CELLS*2-1, d0
        dbf     d6, .row_min
        // d5 = the oldest row write owning any visible plane row

        // ---- pass 2: C1 over the visible plane columns ----
        move.l  Camera_X, d0
        swap    d0
        lsr.w   #3, d0                          // camCol, the leftmost visible world column
        move.w  d0, d1                          // d1 = world column walked
        andi.w  #PLANE_H_CELLS-1, d0
        add.w   d0, d0                          // d0 = plane column × 2, walked with wrap
        lea     Canopy_ColW, a0
        lea     Canopy_ColFrame, a1
        moveq   #SCREEN_LAST_COL_MAX, d6
    .col_loop:
        move.w  (a0, d0.w), d3
        cmp.w   d1, d3
        bne     .col_bad
    .col_next:
        addq.w  #1, d1
        addq.w  #2, d0
        andi.w  #PLANE_H_CELLS*2-1, d0
        dbf     d6, .col_loop

        // Nothing disagreed this sweep: any pending episode is over, not merely paused.
        clr.w   Canopy_Pend_Code
        clr.w   Canopy_Pend_Age
        jbra    .priced

    .col_bad:
        // ATTRIBUTION, on the rare path so the loop above pays nothing for it. This
        // column's stored world column is stale — but if EVERY visible plane row has been
        // row-written since that column write, every visible cell of the column has been
        // repaired by those row writes and there is nothing on screen to see. Fire only
        // when the column write is newer than the OLDEST visible row write, i.e. when at
        // least one visible cell of this column is still owned by it.
        move.w  (a1, d0.w), d2
        sub.w   d5, d2                          // signed, for the same wrap reason as pass 1
        ble     .col_next
        move.w  d1, d2                          // d2 = want  = the world column that belongs here
        move.w  d0, d1
        lsr.w   #1, d1                          // d1 = idx   = the plane column
        moveq   #CANOPY_C1, d0                  // d3 is still the stored world column = got
        jbsr    Canopy_Persist                  // preserves every register
        // One report per sweep. A disagreement is almost never alone — a stale window
        // takes a run of columns with it — and reporting all of them would make
        // Canopy_Hits count columns instead of frames. The snapshot carries the run.

    .priced:
        move.w  VDP_HV_COUNTER, d0
        move.w  (sp)+, d1
        sub.w   d1, d0
        lsr.w   #8, d0                          // d0 = scanlines the sweep occupied
        cmpi.w  #100, d0
        bhi     .price_wrapped                  // a V-counter wrap, not a measurement
        move.w  d0, Canopy_Cost
        cmp.w   Canopy_Cost_Peak, d0
        bls     .price_wrapped
        move.w  d0, Canopy_Cost_Peak
    .price_wrapped:
        rts
    }
}
