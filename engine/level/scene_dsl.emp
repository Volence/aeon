// engine/level/scene_dsl.emp — the authored scene model (spec 2026-08-17 §2/§3).
//
// Pure comptime: constructors, capability fold, lowering to parallax_config/band_entry.
// GUARDS LIVE HERE: this module belongs in the use closure of every scene author, so
// its ensures evaluate on every authored scene (the preset.emp reachability lesson).
//
// THAT CLOSURE DOES NOT EXIST YET, AND THE COVERAGE BOUNDARY IS EXACTLY THIS: the file
// has PARSE + SCAN coverage today and ZERO body-elaboration coverage. Measured from both
// sides. A syntax error here fails the build (`error: expected an expression, found
// AndAnd`), so the file cannot rot into garbage unnoticed — but `return unknown_name +
// MISSING_CONST` inside an uncalled `pub comptime fn` builds GREEN with an identical CRC,
// and so does a module-level `ensure(1 == 0)`. So every ensure in this file, module-level
// pins included, is dead until something reaches it: Task 5's registry, or Task 7's
// permanent equivalence witness, whichever lands first. Nothing here may be trusted on
// the strength of a green build; every guard below was red-first verified through a
// temporary probe that forced elaboration from a placed module.
//
// Pure comptime — this module emits no ROM bytes.
module engine.level.scene_dsl

use engine.structs.{parallax_config}
use engine.parallax.{band_entry, band_record, band_ext, BAND_EXT_N, PLANE_B_SPAN, BAND_OP_BIT_A, BAND_OP_BIT_B}
use engine.constants.{MAX_PARALLAX_BANDS, PARALLAX_ANCHOR_NONE}
use engine.effects.raster_dsl.{RASTER_MAX_PATCH}

// ---- the inlined-literal pins (the call-site resolution rule) ----
// A comptime fn's free names resolve at the CALL SITE, and this module is NOT a
// COMPTIME_HELPERS member (sigil crates/sigil-harness/src/native.rs:1942 holds that
// list; scene_dsl is not on it), so nothing here is glob-injected. Names IMPORTED
// above therefore do NOT travel into a body a GAME module calls: spelled as constants
// inside scene()/scene_hdr(), MAX_PARALLAX_BANDS / PARALLAX_ANCHOR_NONE /
// RASTER_MAX_PATCH would resolve to nothing at a game call site — exactly the failure
// raster_dsl.emp:449-457 records, where an imported bound collapsed a range to empty
// and compose() emitted ZERO fires with no diagnostic. Every body below spells the
// NUMBER; these three pins hold the numbers to their authorities.
//
// Names DEFINED here (the CAP_*/PRECISION_*/TRANS_* consts, the enums, and every helper
// below) ARE safe to name in a body — but only because a scene author reaches them
// through a GLOB import. THAT IS A REQUIREMENT ON CALLERS: a scene module must
// `use engine.level.scene_dsl.*`, never a selective `use ...{scene, layer}`.
//
// THE TWO AXES FAIL VERY DIFFERENTLY, which is the whole reason bodies inline numbers
// but keep calling helpers by name. A selective import is LOUD on the function axis —
// one `unknown function` error per call site (measured twice, at 217 and 152 errors; the
// count is a property of the probe, the SHAPE is the fact), so that constraint enforces
// itself and no build can slip past it. It is SILENT on the constant axis: a name that resolves to
// nothing inside a body does not error, it degrades (raster_dsl.emp:449-457 — an
// imported bound collapsed a range to empty and compose() emitted zero fires). Loud is
// tolerable; silent is not. Hence: helpers by name (all `pub`, for this reason and no
// other), constants as literals held by the pins below.
//
// TWO SPECIES OF PIN, kept apart on purpose. These three watch constants owned by OTHER
// modules, where drift is a real event nobody editing this file would see:
ensure(MAX_PARALLAX_BANDS == 8, "scene_dsl's inlined band ceiling (8) drifted from MAX_PARALLAX_BANDS")
ensure(PARALLAX_ANCHOR_NONE == $FF, "scene_dsl's inlined no-anchor sentinel ($FF) drifted from PARALLAX_ANCHOR_NONE")
ensure(RASTER_MAX_PATCH == 4, "scene_dsl's inlined patch-channel width (4) drifted from RASTER_MAX_PATCH")
// P3 Task 7 added three more of the same species. PLANE_B_SPAN and the two op bits are
// parallax's; LAYER_WORLD_Y_MAX is defined here because it is a property of the AUTHORED
// coordinate space, not of the walker.
ensure(PLANE_B_SPAN == 512, "scene_dsl's inlined Plane-B span (512) drifted from engine.parallax.PLANE_B_SPAN — scene_plane_line()'s range guard and Step 4a's rotation modulus must be the same number")
ensure(BAND_OP_BIT_A == 0 && BAND_OP_BIT_B == 1, "scene_dsl's inlined band factor-op bit positions (0, 1) drifted from engine.parallax.BAND_OP_BIT_A/B — scene_band() packs the two flags into band_factor_ops and Decode_Factor_A/B btst them back out")

// LAYER_WORLD_Y_MAX — the engine-wide ceiling on an act's vertical extent, and the bound
// `layer()` replaced its `world_y < 512` with. It is NOT a parallax number and NOT a
// plane number: every act descriptor already asserts
// `(GRID_H << SECTION_SIZE_SHIFT) <= $8000` (games/.../act_descriptor.emp:86, cited by
// camera.emp:115 as the reason the camera's clamp arithmetic stays inside a signed word),
// so $8000 is the largest Y any act can declare and the largest the camera can reach.
// A top above it names a coordinate no camera state can produce.
//
// THIS IS THE LOOSE BOUND ON PURPOSE. The tight one is the act's OWN span, which layer()
// cannot see — it is handed to `assert_act_relative_tagged(scenes, act_span)` at the
// registry, where the act descriptor is in scope. Two guards, and the loose one is not
// decoration: it is what catches a `SceneLayer{ ly_world_y: … }` back-door value that
// never went through the registry fold.
pub const LAYER_WORLD_Y_MAX = $8000
// The other two sit beside their own definitions below and watch a RENUMBERING of the
// selectors this file both defines and inlines — a smaller risk, but a live one: adding
// a `PRECISION_DENSE` between CELL and LINE is exactly the edit that would silently
// re-point scene()'s `precision != 1` fence at the wrong tier.

// ---- capability bits (spec §3: the per-game cap mask the lowering folds against) ----
//
// THESE SEVEN DECLARATIONS ARE THE AUTHORITY, and P2 makes that literal rather than
// aspirational: tools/test_scene_span_labels.py and tools/effects_gates.py both PARSE
// the `pub const CAP_*` lines below and derive their expectations from what they find.
// Neither carries a copy of the mask, so adding a bit here (with a lowering and a
// bracketed block) needs no edit in either tool, and naming a span after a bit that is
// not declared here fails. The reserved block underneath is a COMMENT on purpose — a
// reserved bit has no lowering, so a span named for one would bracket a block that
// cannot exist, and the parse must not see it.
//
// WHY ONLY TWO OF THE SEVEN RESERVED BITS WERE PROMOTED (P3 Task 5). The promotion is
// what lets a span gate SEE a bit at all, so it has to precede the lowering that raises
// it — CAP_MULTI_DEFORM_TABLE is Task 7's per-layer deform refs and CAP_FACTOR_CURVE is
// Task 10's curves, and each of those tasks lands its gated block against a bit that is
// already parseable. The other five stayed in the comment for the symmetric reason:
// promoting a bit NOTHING raises manufactures a span gate with no subject, which is the
// vacuous-gate shape this suite keeps rediscovering. In the window between this parcel
// and Tasks 7/10 the two new bits are declared-but-ungated, and that state is REPORTED
// rather than hidden — effects_gates.py's scanline_spans lane emits an explicit
// "NOT GATED ANYWHERE" informational row per capability with no bracketed span, the same
// row CAP_TRANSITIONS carried before its parcel landed. If either bit is still showing
// that row after Task 10, the lowering did not happen.
//
// ---- THE BRACKETING-LABEL EMISSION CONVENTION (P2 §3.3 / §8.2) ----
//
// Every capability-gated block in the ENGINE carries a pair of boundary labels:
//
//     if (Game.SCANLINE_CAPS & CAP_ANCHORS) != 0 {
//     .cap_anchors_overlay_begin:
//             ... the elidable region ...
//     .cap_anchors_overlay_end:
//     }
//
// SPAN NAME = `cap_<capability>_<site>`, the capability half lowercased from the
// CAP_* name below, the site half a short discriminator. The site token is not
// decoration: two labels of the same name in one proc is a redefinition, and several
// capabilities are gated at more than one site. Resolution back to a capability is by
// LONGEST matching prefix (`per_col_vsram_emit` -> CAP_PER_COL_VSRAM), which the test
// proves unambiguous over the declared set rather than assuming it.
//
// WHY LABELS COME FIRST AND GATING SECOND. §8.2's path-level span gates measure a
// gated region by its boundary symbols, and the flat `.lst` drops `$`-mangled locals
// unless something names them — which is why raster_source_gate had to hand-roll a
// resolver. A gate added without brackets is a specialisation no gate can see; a
// bracket added without a gate reports a specialisation that never happens. Both
// directions are checked in tools/test_scene_span_labels.py.
//
// The convention is documented HERE, beside the bits, because this file is the one a
// reader reaches for when asking what a capability means — not in the engine modules
// that happen to carry today's spans.
pub const CAP_PER_LINE       = $0001
pub const CAP_PER_COL_VSRAM  = $0002
pub const CAP_DEFORM         = $0004
pub const CAP_ANCHORS        = $0008
pub const CAP_TRANSITIONS    = $0010
// P3 (Task 5): declared ahead of their lowerings — see the promotion note above.
pub const CAP_MULTI_DEFORM_TABLE = $0020
pub const CAP_FACTOR_CURVE       = $0040
// Reserved (P4+): CAP_FG_SPRITE_STRIPS=$0080, CAP_BGANIM_BOUND=$0100,
// CAP_DENSE_TIER=$0200, CAP_COMPUTED=$0400, CAP_DEGRADE=$0800

// ---- attachment enums (spec §2) ----
// Comptime enums with payloads, per the RasterOp precedent: variants are the
// authoring vocabulary; every attachment defaults to its explicit None variant,
// never to a `Label = 0` sentinel (a Label compared to an int is silently
// unevaluable — the preset.emp lesson — so 0-sentinels can never be guarded).
// Payload slots are positional; the order is documented per variant.

pub comptime enum SceneDeform {
    None,                       // no H-deform on this scene
    Shared(Label, int),         // (deform table Label, sample speed) — one table both planes
}

pub comptime enum SceneVDeform {
    None,                       // no per-column V-deform
    Columns(Label, int, int),   // (column table Label, sample speed, amplitude shift)
}

pub comptime enum SceneAnchor {
    None,                       // no world-anchored band split
    At(int, int, int),          // (patch channel, anchored dsa, anchored dsb)
}

// ---- lowering-tier and transition selectors ----
pub const PRECISION_CELL = 0    // band tops land on 8-px plane cells (P1 tier)
pub const PRECISION_LINE = 1    // per-line band tops (reserved: P2+)

// WHAT `precision` MEANS IS NOT SETTLED, AND IN P1 IT DOES NOT MATTER — BUT IT WILL.
// Two readings are documented in this file and they are not the same claim:
//   (a) the two lines above — the granularity of BAND TOPS (8-px cells vs per-line);
//   (b) the scene() fence below — whether the scene rides the per-line HSCROLL PIPELINE,
//       which today is selected by a non-NULL BG deform table, not by this field.
// They coincide only because a per-line pipeline is what would ALLOW per-line tops.
//
// In P1 the field is inert: `sc_precision` is not emitted, not read by scene_caps(), and
// `layer()` requires every top on the 8-px grid anyway, so NO shipped scene can want (a).
// The 20 migrated scenes therefore carry values that are NOT a considered tier claim —
// two are PRECISION_LINE because the migration plan said so, eighteen are PRECISION_CELL
// by default, and five of those eighteen (OJZ_Caves, OJZ_LockedClouds, Rocking x3) use the
// identical flat-pathed-zero-table idiom as the two that are marked LINE. Nothing
// distinguishes them today.
//
// SO: whoever gives precision a standalone lowering (P2/P3, the same event that retires
// the fence) must FIRST settle which reading is meant and then RE-DERIVE all 20 — these
// values are a default, not evidence. Deriving it outright is the likelier right answer,
// since (b) is already computable from the BG table and (a) from the tops; a hand-authored
// field with no consumer and no derivation is how the mask started, and the mask now has
// both a derivation and a verify ensure.
pub const TRANS_SMOOTH   = 0    // lerp the section transition
pub const TRANS_INSTANT  = 1    // snap on the promote frame
// These four are DEFINED here, but scene()'s defaults and the fence that tests them are
// spelled `0` / `1` so a caller's import style cannot change what a defaulted argument
// means. Same pin discipline as the imported-name block above.
ensure(PRECISION_CELL == 0 && PRECISION_LINE == 1, "scene_dsl's inlined precision selectors drifted from PRECISION_CELL / PRECISION_LINE")
ensure(TRANS_SMOOTH == 0 && TRANS_INSTANT == 1, "scene_dsl's inlined transition selectors drifted from TRANS_SMOOTH / TRANS_INSTANT")

// -----------------------------------------------
// SceneLayer — one authored world-Y layer (comptime-only; never emitted:
// the Task-3 lowering folds SceneLayers into parallax_config/band_entry).
//
// no hand-building: use layer() or no_layer() (the span ensure lives there).
// This type has to be `pub` — it is the element type in scene()'s signature — so the
// back door is open by construction: `SceneLayer{ ly_world_y: 5, .. }` type-checks and
// skips layer()'s range guard entirely. Same convention as raster_dsl.emp:90, and for the
// same reason: the guards are in the constructor.
//
// SINCE P3 TASK 7 THE BACK DOOR IS NARROWER, and worth stating because the old note here
// claimed something that is no longer the failure mode. It used to say a hand-built value
// "truncates to a band top 5 px off, because the `>> 3` in scene_band() is exact only for
// a world_y that layer() already checked" — there is no `>> 3` any more, and an off-grid
// top is legal. What a back-door value now escapes is only the RANGE check, and
// `scene_plane_line()` catches an unmappable one at the lowering AND at the registry fold
// (assert_act_relative_tagged calls it). A value that is in range is simply a legal top.
// -----------------------------------------------
pub struct SceneLayer {
    ly_world_y:  u16,   // authored layer top, ACT world pixels (was plane pixels pre-P3-T7)
    ly_fa:       u16,   // packed FACTOR_* (9 bits), plane A
    ly_fb:       u16,   // packed FACTOR_* (9 bits), plane B
    ly_dsa:      u8,    // deform-amplitude shift, plane A (15 = none)
    ly_dsb:      u8,    // deform-amplitude shift, plane B (15 = none)
    ly_phase:    u8,    // deform sample-index desync
    ly_enabled:  u8,    // 0 = dormant layer
}

// -----------------------------------------------
// layer — one scene layer at an authored world-Y top.
// world_y: layer top in ACT world pixels. Free of the 8-px grid since P3 Task 7.
// fa/fb:   packed FACTOR_* scroll factors for planes A/B (parallax_dsl)
// dsa/dsb: per-plane deform-amplitude shifts (15 = no deform on that plane)
// phase:   deform sample-index desync; enabled: 0 authors a dormant layer
//
// ---- P3 TASK 7 RELAXED BOTH GUARDS. NEITHER WAS DELETED. ----
//
// (1) `world_y % 8 == 0` IS GONE, AND ITS JOB MOVED RATHER THAN VANISHING. The guard
//     existed because P1's `band_top_cell` was a Plane-B CELL ROW, so an off-grid top
//     silently truncated. The record now carries a PLANE LINE (parallax.emp's
//     `band_top_plane`, u16) and Step 4a rebases in lines, so an off-cell top is
//     REPRESENTABLE. What replaces the ensure is `scene_forces_per_line()` ARM 5: a top
//     whose plane image is off the 8-px cell grid forces the per-line HScroll pipeline,
//     because a per-cell fill can only place a cell edge and would re-quantise the very
//     thing the wider field exists to express. The guard became a LOWERING CONSEQUENCE.
//     Arm 5 was authored dead by Task 6 and this parcel is what wakes it up.
//
// (2) `world_y < 512` BECAME A DERIVED CEILING, and the 512 was the wrong space anyway:
//     it was the BG PLANE's span, and world_y is an ACT coordinate. The bound here is
//     the engine-wide act-axis ceiling (LAYER_WORLD_Y_MAX, below); the TIGHT per-act
//     bound cannot live in this fn — layer() sees one layer and knows nothing about the
//     act — so it is enforced by `assert_act_relative_tagged(scenes, act_span)` at the
//     registry, where the act descriptor's own `GRID_H << SECTION_SIZE_SHIFT` reaches it.
//     Two bounds, both derived, neither typed out of the air.
// -----------------------------------------------
pub comptime fn layer(world_y: int, fa: int, fb: int, dsa: int = 15, dsb: int = 15,
                      phase: int = 0, enabled: int = 1) -> SceneLayer {
    // $8000 is inlined per the pin block at the top of this file (LAYER_WORLD_Y_MAX).
    ensure(world_y >= 0 && world_y < $8000,
           "layer(): world_y {world_y} is outside the engine's act-axis span (0 .. $8000). Every act descriptor asserts (GRID_H << SECTION_SIZE_SHIFT) <= $8000 and the camera's world coordinates are signed words, so a top above it names a Y the camera can never reach. NOTE this is the ENGINE-WIDE ceiling: the tight bound is this game's own act span and it is checked at the registry by assert_act_relative_tagged()")
    return SceneLayer{ ly_world_y: world_y, ly_fa: fa, ly_fb: fb, ly_dsa: dsa,
                       ly_dsb: dsb, ly_phase: phase, ly_enabled: enabled }
}

// no_layer — the padding element. `Scene.sc_layers` is a FIXED [SceneLayer; 8] (a
// struct field needs a concrete type; `array` is a parameter type only), so an author
// with four real layers still spells eight elements. This is the fifth through eighth:
// dormant, factor-locked, at world-Y 0. It is never lowered — scene_band() only ever
// indexes 0..sc_count — so its field values are inert with ONE exception: `ly_fa == 0`
// is load-bearing, and it is what scene()'s pad guard discriminates on. Every FACTOR_*
// is nonzero (parallax_dsl.emp:25-40; even FACTOR_LOCKED is $0FF), so a zero fa cannot
// come from any authored layer. Do not "tidy" it to FACTOR_LOCKED.
pub comptime fn no_layer() -> SceneLayer {
    return SceneLayer{ ly_world_y: 0, ly_fa: 0, ly_fb: 0, ly_dsa: 15,
                       ly_dsb: 15, ly_phase: 0, ly_enabled: 0 }
}

// derived_mask — the layer mask the model implies: bit i per enabled layer below count.
//
// SHARED BY scene() AND scene_hdr() ON PURPOSE, not for brevity. scene() checks the
// sc_mask_raw bridge against it and scene_hdr() emits it; two copies of the loop could
// drift into a guard that approves a mask the lowering then does not produce, which is
// the one failure this pair of call sites exists to make impossible.
//
// Takes the ARRAY, not a Scene: scene() has no Scene yet when it needs this.
pub comptime fn derived_mask(layers: [SceneLayer; 8], count: int) -> int {
    comptime var mask = 0
    for i in 0..count {
        let l = layers[i]
        if l.ly_enabled != 0 {
            mask = mask | (1 << i)
        }
    }
    return mask
}

// =====================================================================
// Attachment accessors — the ONLY way a body reads an enum payload.
//
// `match` in .emp is EXPRESSION-form (ast.rs Expr::Match; there is no statement
// match), so a guard cannot be written inside an arm the way the spec sketch drew it.
// These accessors are the shape that survives: each destructures exhaustively into a
// plain int/Label, and scene() then does its `ensure`s at the top level over INTS.
//
// That is not merely a workaround, it is the correct spelling for the guards: an
// `ensure` comparing a `Label` to an int is silently unevaluable and always passes
// (preset.emp:105-111; configs.emp's hdr() says the same at its own guards). Every
// guard below therefore reads exactly like hdr()'s — `anchor_ch == $FF || ...` — which
// is also what keeps Task 7's hdr()/scene_hdr() equivalence proof honest: the two are
// comparing the same integers, not two different encodings of "no anchor".
//
// Each accessor's None arm returns hdr()'s OWN DEFAULT for that field, so the lowering
// is a straight copy and the byte-identity contract lives in one place per field.
// =====================================================================

// deform table Label; hdr() default 0 (= no table).
pub comptime fn scene_deform_table(d: SceneDeform) -> Label {
    return match d {
        None                => 0,
        Shared(tbl, speed)  => tbl,
    }
}
// deform sample speed; hdr() default ONE, not zero — a speed of 0 is a static table,
// which is a different (and shipped: v_deform_speed_bg) meaning.
pub comptime fn scene_deform_speed(d: SceneDeform) -> int {
    return match d {
        None                => 1,
        Shared(tbl, speed)  => speed,
    }
}
// 1 when no table is attached. Exists so the P1 precision fence and the capability
// fold can test "is there a table?" without ever touching the Label.
pub comptime fn scene_deform_is_none(d: SceneDeform) -> int {
    return match d {
        None                => 1,
        Shared(tbl, speed)  => 0,
    }
}

// V-column table Label; hdr() default 0 (= whole-plane V-scroll).
pub comptime fn scene_vdeform_table(v: SceneVDeform) -> Label {
    return match v {
        None                       => 0,
        Columns(tbl, speed, shift) => tbl,
    }
}
// V-column sample speed; hdr() default ZERO (static column shape). Note this is the
// opposite default from the H-deform speed above — both are reproduced literally.
pub comptime fn scene_vdeform_speed(v: SceneVDeform) -> int {
    return match v {
        None                       => 0,
        Columns(tbl, speed, shift) => speed,
    }
}
// V-column amplitude shift; hdr() default 4.
pub comptime fn scene_vdeform_shift(v: SceneVDeform) -> int {
    return match v {
        None                       => 4,
        Columns(tbl, speed, shift) => shift,
    }
}
pub comptime fn scene_vdeform_is_none(v: SceneVDeform) -> int {
    return match v {
        None                       => 1,
        Columns(tbl, speed, shift) => 0,
    }
}

// Anchor patch channel; hdr() default PARALLAX_ANCHOR_NONE = $FF (inlined per the pin
// block at the top of this file). THE INT THE GUARDS COMPARE.
pub comptime fn scene_anchor_ch(a: SceneAnchor) -> int {
    return match a {
        None              => $FF,
        At(ch, dsa, dsb)  => ch,
    }
}
// Deform shifts the overlay writes into every band at/below the anchored line;
// hdr() default 15 = no deform on that plane.
pub comptime fn scene_anchor_dsa(a: SceneAnchor) -> int {
    return match a {
        None              => 15,
        At(ch, dsa, dsb)  => dsa,
    }
}
pub comptime fn scene_anchor_dsb(a: SceneAnchor) -> int {
    return match a {
        None              => 15,
        At(ch, dsa, dsb)  => dsb,
    }
}

// -----------------------------------------------
// Scene — one authored world-Y scene (comptime-only, never emitted).
//
// TWO FIELDS ARE BYTE-IDENTITY BRIDGES, not model. They exist because shipped configs
// carry header values the authored model cannot derive, and P1's whole contract is that
// the ROM does not move a byte:
//
//   sc_mask_raw            ParallaxConfig_OJZ_Default AND ParallaxConfig_OJZ_Underwater
//                          (configs.emp:107, :132) both declare band_count 4 with
//                          layer_mask $1F — FIVE bits for FOUR bands. A mask derived
//                          from ly_enabled can only ever produce $0F, so Task 6 spells
//                          this bridge TWICE, once per config. -1 = derive.
//   sc_v_deform_shift_raw  ParallaxConfig_SkyHaze (configs.emp:269) passes
//                          v_deform_shift_bg: 0 while attaching NO v-deform table;
//                          SceneVDeform.None lowers to hdr()'s default 4, which is a
//                          different byte. -1 = derive. ONE config, one bridge.
//
// THE NEAR MISS, because it will be mistaken for a third: ParallaxConfig_OJZ_LockedClouds
// (configs.emp:299) declares band_count 5 with layer_mask $1E, and that is NOT a bridge —
// it DERIVES, from `enabled: 0` on layer 0, which is precisely the authored model working.
// Spell it as a dormant layer; a mask_raw there would hide the one fact the config exists
// to express. (The plan's Task-6 table over-prescribes `mask_raw $1E` here. Derive it.)
//
// Both bridges are SIGNED (i16) precisely because -1 is the "derive" sentinel — a u8/u16
// field cannot hold it, and a 0 sentinel is unusable here since 0 is a legal value for
// both. Neither is a feature: normalising the two shipped records away is a post-P1
// cleanup that costs a deliberate repin/refreeze, and until then a bridge that reproduces
// the authored byte beats a model that quietly changes it. A THIRD bridge species would
// be a spec reconciliation, not an addition — none was needed for the 20 shipped configs
// (nine independently byte-verified through this lowering at review).
//
// no hand-building: use scene() (every guard lives there). A literal `Scene{ .. }`
// type-checks and bypasses the pad guard, the mask-superset guard, both ported anchor
// guards and the precision fence in one go — same convention as SceneLayer above and
// raster_dsl.emp:90.
// -----------------------------------------------
pub struct Scene {
    sc_layers:             [SceneLayer; 8],  // padded to 8; sc_count says how many are real
    sc_count:              u8,
    sc_v_factor:           u8,               // whole-plane Plane-B vshift (pcfg_v_factor_bg)
    sc_v_center:           u16,
    sc_v_offset:           u16,
    sc_v_factor_fg:        u8,               // RESERVED in the v1 runtime; authored for identity
    sc_deform_fg:          SceneDeform,
    sc_deform_bg:          SceneDeform,
    sc_v_deform:           SceneVDeform,
    sc_anchor:             SceneAnchor,
    sc_precision:          u8,               // PRECISION_CELL / PRECISION_LINE
    sc_transition:         u8,               // TRANS_SMOOTH / TRANS_INSTANT
    // Pad so the two i16 bridges land on EVEN offsets (94, 96). `Scene` is comptime-only —
    // it never reaches ROM, so an odd 2-byte field could not fault a 68000 today, and
    // sigil's [layout.odd-field] is a false positive here in the strict sense. Padded
    // anyway, for one cheap reason: the day anything emits a Scene, an odd word field is
    // an address error, and a warning that has been explained away in a baseline is not
    // there to catch it. Zero cost — this struct emits nothing either way.
    sc_pad_5D:             u8 = 0,
    sc_mask_raw:           i16,              // -1 = derive from ly_enabled (bridge, see above)
    sc_v_deform_shift_raw: i16,              // -1 = derive from sc_v_deform (bridge, see above)
}

// -----------------------------------------------
// scene — the authored scene constructor.
//
// Ports hdr()'s two load-bearing guards BY NAME (spec §3.1) plus the layer-count
// ceiling and the P1 precision fence. All four compare INTS, extracted through the
// accessors above, for the reason stated in their banner.
//
// The `layers` array is always eight elements; pad with no_layer(). `count` is the
// authority on how many are real — sc_layers is never scanned past it.
// -----------------------------------------------
pub comptime fn scene(layers: [SceneLayer; 8], count: int,
                      v_factor: int, v_center: int = 0, v_offset: int = 0,
                      v_factor_fg: int = 0,
                      deform_fg: SceneDeform = SceneDeform.None,
                      deform_bg: SceneDeform = SceneDeform.None,
                      v_deform: SceneVDeform = SceneVDeform.None,
                      anchor: SceneAnchor = SceneAnchor.None,
                      precision: int = 0,
                      transition: int = 0,
                      layer_mask_raw: int = -1,
                      v_deform_shift_raw: int = -1) -> Scene {
    // 8 = MAX_PARALLAX_BANDS, 0 = PRECISION_CELL, 0 = TRANS_SMOOTH: inlined per the pin
    // block at the top of this file (the first is imported and would not travel; the
    // other two are defaults, evaluated wherever the call site puts them).
    ensure(count >= 1 && count <= 8,
           "scene(): {count} layers exceeds MAX_PARALLAX_BANDS (8) — the shadow view is sized for eight entries and a ninth writes past Parallax_Shadow_Bands")
    let anchor_ch = scene_anchor_ch(anchor)
    // Ported hdr() guard 1: an anchored scene SPLITS a layer at runtime, so the shadow
    // view needs count+1 entries. Same reasoning, same ceiling, same failure mode as
    // configs.emp's hdr(); this is one of the two pairs Task 7 proves equal.
    ensure(anchor_ch == $FF || count + 1 <= 8,
           "scene(): an anchored scene SPLITS a layer at runtime, so the shadow view needs count+1 entries — {count}+1 exceeds MAX_PARALLAX_BANDS (8) and the split would write past Parallax_Shadow_Bands")
    // Ported hdr() guard 2: the anchor channel must index the patch bank.
    ensure(anchor_ch == $FF || anchor_ch < 4,
           "scene(): anchor ch {anchor_ch} is not a patch channel — the overlay indexes Effects_World_Y[RASTER_MAX_PATCH] (4), so a wider index reads past the anchor bank")
    // THE PAD GUARD. `count` is the sole authority on how many layers are real, and both
    // folds (derived_mask and scene_band) stop there — so a fifth authored layer under
    // `count: 4` is lowered by nothing AND masked by nothing. Silent, and invisible until
    // a word-level compare. This closes it.
    //
    // BOTH CONJUNCTS ARE REQUIRED. `ly_enabled == 0` alone would reject a legal shipped
    // shape: OJZ_LockedClouds (configs.emp:299) is five real layers with layer 0 dormant,
    // so a masked-off REAL layer inside the count must keep passing. `ly_fa == 0` is what
    // separates the two — no authored layer can have it (see no_layer()'s note).
    for i in count..8 {
        let p = layers[i]
        ensure(p.ly_enabled == 0 && p.ly_fa == 0 && p.ly_fb == 0,
               "scene(): slot {i} is past count {count} but is not a no_layer() pad — count is the authority on how many layers are real, and a real layer beyond it is lowered by nothing and masked by nothing")
    }
    // THE MASK BRIDGE IS A SUPERSET, NEVER A CONTRADICTION. sc_mask_raw exists to ADD
    // bits the model cannot derive (OJZ_Default: $1F over a derived $0F, which passes),
    // not to CLEAR one that ly_enabled set. Clearing is an authoring contradiction with a
    // correct spelling one field over — `enabled: 0` on that layer — and left unguarded it
    // is a mask the lowering emits while the model says otherwise.
    ensure(layer_mask_raw < 0 || (layer_mask_raw | derived_mask(layers, count)) == layer_mask_raw,
           "scene(): layer_mask_raw {layer_mask_raw} CLEARS a bit the enabled layers set — the raw mask is a byte-identity bridge that may only ADD bits the model cannot derive; to disable a layer, author it with enabled: 0")
    // Width AND sentinel in one range. pcfg_layer_mask is a u8 (structs.emp:165), and the
    // i16 sentinel field is only safe BECAUSE the mask is 8 bits: a raw $FFFF would
    // round-trip through i16 to -1 and read back as "derive", silently. Any negative other
    // than -1 is caught for the same reason — it would also read as "derive".
    ensure(layer_mask_raw >= -1 && layer_mask_raw <= $FF,
           "scene(): layer_mask_raw {layer_mask_raw} outside -1 (derive) .. $FF — pcfg_layer_mask is a u8, and a wider value would wrap through the i16 bridge field and silently read back as derive")
    // Same shape, same reason. The runtime samples with `asr.w d3, d5` (parallax.emp:1038),
    // so a shift past 15 saturates to the sign bit: a wrong picture, not a fault, which is
    // exactly the class of error that belongs to the build.
    ensure(v_deform_shift_raw >= -1 && v_deform_shift_raw <= 15,
           "scene(): v_deform_shift_raw {v_deform_shift_raw} outside -1 (derive) .. 15 — the runtime samples the column table with asr.w, so a wider shift saturates to sign instead of failing")
    // THE SELECTORS ARE RANGE-CHECKED AS ARGUMENTS, not just pinned as constants. Both
    // are stored raw and read by a one-bit test, so an out-of-range value does not fail,
    // it MEANS something: `transition: 2` is tested with tst.b/bne (parallax.emp:259) and
    // therefore silently means INSTANT, and `precision: 7` would silently select a tier.
    ensure(precision == 0 || precision == 1,
           "scene(): precision {precision} is neither PRECISION_CELL (0) nor PRECISION_LINE (1) — the value is stored and read as a tier selector, so an out-of-range one silently selects a tier rather than failing")
    ensure(transition == 0 || transition == 1,
           "scene(): transition {transition} is neither TRANS_SMOOTH (0) nor TRANS_INSTANT (1) — the runtime tests this byte with tst.b, so anything nonzero silently means instant")
    // THE P1 SCOPE FENCE IS RETIRED HERE (P3 Task 6). It read:
    //
    //     ensure(precision != 1 || scene_deform_is_none(deform_bg) == 0,
    //            "P1: precision line rides a zero-deform table ...; standalone precision
    //             lowering lands with the forcer-set derivation (P2/P3)")
    //
    // and it existed because `sc_precision` had no consumer: PRECISION_LINE authored
    // without a BG table would have lowered SILENTLY to the per-cell pipeline. That is no
    // longer true — `scene_forces_per_line()` below reads the field as its own forcer arm,
    // so the value now means what it says on its own. The fence is not deleted into
    // nothing: it is replaced by a derivation that HONOURS the authored value instead of
    // rejecting it, which is the widening the message named.
    return Scene{
        sc_layers:             layers,
        sc_count:              count,
        sc_v_factor:           v_factor,
        sc_v_center:           v_center,
        sc_v_offset:           v_offset,
        sc_v_factor_fg:        v_factor_fg,
        sc_deform_fg:          deform_fg,
        sc_deform_bg:          deform_bg,
        sc_v_deform:           v_deform,
        sc_anchor:             anchor,
        sc_precision:          precision,
        sc_transition:         transition,
        sc_pad_5D:             default,
        sc_mask_raw:           layer_mask_raw,
        sc_v_deform_shift_raw: v_deform_shift_raw,
    }
}

// =====================================================================
// scene_forces_per_line — THE per-line forcer derivation (spec §2). ONE source.
//
// Design §2 is what makes "twin-key desync is impossible by construction" true: the
// lowering owns the forcer set and feeds BOTH the fill-side mode key and the
// engine.buffers DMA-length key from one derivation. Before P3 Task 6 it fed neither —
// `scene_caps()` re-implemented two of the five arms inline, and the RUNTIME halves were
// two hand-written copies of the same beq/bne sequence in two files, each carrying a
// comment warning that the other existed. This fn is the comptime half of the repair;
// `parallax_mode_key()` below is the runtime half, and the two are adjacent on purpose.
//
// THE EXHAUSTIVE SET, from design §2:
//   1. any H-deform table, either plane, INCLUDING a shared one
//   2. anchor_ch != NONE
//   3. any curve layer                      -- NO SUBJECT UNTIL TASK 10
//   4. precision: line
//   5. any layer boundary not on the 8-px cell grid  -- NO SUBJECT UNTIL TASK 7
//
// ARM 3 IS DEAD CODE TODAY AND THIS COMMENT IS THE ONLY THING THAT SAYS SO. (ARM 5 WAS,
// AND IS NOT ANY MORE — P3 Task 7 woke it up; see below.)
// The ordering is deliberate — the derivation is the single source, so it has to exist
// before the mechanisms that feed it — but a dead arm reads exactly like coverage, and
// this tree's most expensive lesson is the guard that tests nothing while looking like it
// does. Concretely:
//   * Arm 5 (off-grid) IS LIVE since P3 Task 7. It was written dead by Task 6, because
//     `layer()` still ensured `world_y % 8 == 0` and no authorable scene could reach it.
//     Task 7 removed that ensure — an off-grid top is now representable in the record
//     (`band_top_plane`, a plane LINE) and this arm is what makes it correct: it forces
//     the per-line pipeline, because the per-cell filler could only re-quantise it.
//     Red-first witness: games/sonic4/test/poison/poison_scene_grid.emp.
//   * Arm 3 (curve) IS NOT WRITTEN AT ALL, and writing a placeholder would be worse than
//     the gap: `SceneLayer` has no curve attachment, so there is no field to test and any
//     spelling would be a fabricated predicate. Task 10 adds the attachment and the arm
//     lands with it, HERE, immediately after arm 2.
// Both arms are on Task 15's poison list for exactly this reason: the question "is this
// arm reached, and is it right?" is booked, not assumed.
//
// FLAT ACCUMULATOR OVER STATEMENT `if`s, never a nested if-expression — an `if` in
// block-tail position yields unit SILENTLY and folded a capability mask to 0 in P1
// (docs/EMP_PITFALLS.md §1). Same shape as `scene_caps()`'s accumulator below.
//
// Returns 1 (per-line) or 0 (per-cell). Not a bitmask: this is one question.
// =====================================================================
pub comptime fn scene_forces_per_line(s: Scene) -> int {
    comptime var forced = 0
    // ARM 1 — any H-deform table, either plane. PLANE-AGNOSTIC on purpose: the pipeline
    // is per-frame and per-line for the whole screen, there is no half-per-line.
    if scene_deform_is_none(s.sc_deform_fg) == 0 {
        forced = 1
    }
    if scene_deform_is_none(s.sc_deform_bg) == 0 {
        forced = 1
    }
    // ARM 2 — a world-anchored overlay. An anchored boundary lands on an arbitrary
    // SCANLINE, and an 8-px-quantised fill can only place a cell edge, so per-cell would
    // silently quantise the very thing the anchor exists to make exact. $FF is
    // PARALLAX_ANCHOR_NONE, inlined per the pin block at the top of this file.
    if scene_anchor_ch(s.sc_anchor) != $FF {
        forced = 1
    }
    // ARM 3 — any curve layer. NOT WRITTEN: no curve attachment exists (Task 10).
    // ARM 4 — precision: line, standing on its own. 1 is PRECISION_LINE, inlined per the
    // same pin block. Before this parcel `scene()` FENCED this value behind a non-null BG
    // table, which made it a second spelling of arm 1 and never a claim of its own; the
    // fence is retired above and this is what replaces it.
    if s.sc_precision == 1 {
        forced = 1
    }
    // ARM 5 — any layer top off the 8-px cell grid. LIVE SINCE P3 TASK 7, which relaxed
    // `layer()`'s grid ensure; before that no authorable scene could reach it.
    //
    // THE GRID QUESTION IS ASKED OF THE PLANE IMAGE, NOT THE AUTHORED ACT Y, and that is
    // a correction Task 7 forced rather than a refinement. The forcer's real question is
    // "can a per-cell fill place this boundary?", and the fill quantises PLANE lines. The
    // two spaces are not the same grid: with `v_factor 3` a 64-px act step is one plane
    // cell, so testing the act value would force per-line on tops that land dead on a
    // cell edge, and — worse in the other direction — would MISS an act value that is a
    // multiple of 8 but whose plane image is not (v_offset 4, for instance). Asking
    // scene_plane_line() is asking the number the filler will actually see.
    //
    // The one-dot rule applies to the array walk exactly as it does in scene_caps():
    // field, then index, then field.
    let ls = s.sc_layers
    let n  = s.sc_count
    for i in 0..n {
        let l  = ls[i]
        let wy = l.ly_world_y
        if scene_plane_line(s, wy) % 8 != 0 {
            forced = 1
        }
    }
    return forced
}

// =====================================================================
// parallax_mode_key — the RUNTIME half of the same decision, spliced at both twins.
//
// This fn emits no bytes from THIS module; it is spliced into `engine.parallax`'s Step-4
// fill (which mode to build the HScroll buffer in) and `engine.buffers`'s
// `Enqueue_Dirty_Buffers` (which DMA LENGTH to ship for it). Those two must agree or a
// mode-differing config ships a 112-byte DMA for an 896-byte buffer. Before this parcel
// they agreed by being typed out twice; now there is nothing to keep in step.
//
// CONTRACT
//   cfg       address register holding the ACTIVE `parallax_config*`
//   per_cell  branch target for the per-cell answer
//   falls through to the caller's next instruction for the per-line answer
//   clobbers d0
//
// THE TWO KINDS OF NAME IN THIS BODY RESOLVE DIFFERENTLY, and the difference was
// MEASURED here on 2026-08-20 rather than reasoned from docs/EMP_PITFALLS.md §2 — which
// describes `comptime fn -> int` bodies and does not, on the evidence below, describe an
// `asm { }` template's instruction operands:
//
//   * the COMPTIME CONDITIONS (`CAP_PER_LINE`, `CAP_ANCHORS`, and `Game.SCANLINE_CAPS`
//     with them) resolve AT THE CALL SITE, and fail LOUDLY when they cannot. Dropping
//     `CAP_ANCHORS` from `engine/system/buffers.emp`'s `use` gives
//     `error: unknown name CAP_ANCHORS` at the splice — not a silent fold to 0, which is
//     the outcome that would have mattered (it would have elided the anchor half of the
//     key in one twin and not the other). So both callers' `use` lines carry
//     `CAP_ANCHORS` even though neither file names it any more, and that is load-bearing.
//   * the INSTRUCTION OPERANDS (`PARALLAX_ANCHOR_NONE`, the `parallax_config.pcfg_*`
//     field offsets) do NOT need either module's `use`. Removing `PARALLAX_ANCHOR_NONE`
//     from the caller's imports built green with an IDENTICAL CRC; so did removing it
//     from this module's imports. It resolves through the assembler's symbol scope, not
//     the comptime name scope.
//
// The safe reading is therefore the narrow one: the axis that could have degraded
// silently is the axis that shouts. Do not generalise the operand result into "imports
// do not matter here" — the pin at the top of this file still watches
// `PARALLAX_ANCHOR_NONE`'s VALUE, which is the drift this file actually has to catch.
//
// SPLICE ONLY INSIDE THE CALLER'S OWN `CAP_PER_LINE` GATE. Without the bit this emits
// NOTHING, because the caller's own `else` arm is what supplies the unconditional
// `jbra per_cell` — its per-line arm has to elide too, and only the caller can do that.
// The gate is repeated here (always true at both real splices) so the CAP_ANCHORS gate
// below is LEXICALLY ENCLOSED by it: tools/scene_spans.py derives "which spans a mask
// must emit" from enclosing gates within one file, and without this wrapper a mask with
// CAP_ANCHORS but not CAP_PER_LINE would be told to expect `cap_anchors_mode` from a
// build where the whole site elided.
//
// THE TWO SITE TOKENS MERGED INTO ONE. The brackets used to be `cap_anchors_mode`
// (parallax) and `cap_anchors_dma` (buffers) — two names for two copies. There is one
// copy now, so there is one name, expanded twice; the listing carries both expansions
// under the same span token and the outer `cap_per_line_fill` / `cap_per_line_dma`
// brackets still distinguish the two ARMS, which is the part that genuinely differs.
// =====================================================================
pub comptime fn parallax_mode_key(cfg: Reg, per_cell: Label) -> Code {
    return asm {
    if (Game.SCANLINE_CAPS & CAP_PER_LINE) != 0 {
    .cap_per_line_mode_begin:
        move.l  parallax_config.pcfg_deform_table_fg({cfg}), d0
        or.l    parallax_config.pcfg_deform_table_bg({cfg}), d0
        bne     .mode_per_line
        // The anchor half of the SAME key. Anchors imply per-line, so this can only ever
        // be live inside the per-line gate above.
    if (Game.SCANLINE_CAPS & CAP_ANCHORS) != 0 {
    .cap_anchors_mode_begin:
        cmpi.b  #PARALLAX_ANCHOR_NONE, parallax_config.pcfg_anchor_ch({cfg})
        beq     {per_cell}
    .cap_anchors_mode_end:
    } else {
        // No anchored config exists, so the second half of the key can only ever answer
        // per-cell. The unconditional branch REPLACES the test rather than falling
        // through, because the per-line arm is what follows.
        jbra    {per_cell}
    }
    .mode_per_line:
    .cap_per_line_mode_end:
    }
    }
}

// =====================================================================
// Capability fold (spec §3) — what a scene DEMANDS of the runtime.
//
// CAP_TRANSITIONS IS DELIBERATELY ABSENT HERE, and its absence is the ruling, not an
// omission: the P1 rule is "set when the registry holds more than one scene", and a
// single Scene cannot see the registry's size. The registry-level fold (Task 5) ORs
// scene_caps() over its scenes and adds CAP_TRANSITIONS itself when its count > 1.
// sc_transition is still authored and still lowered — it is the pcfg byte — it just
// does not raise a capability on its own.
//
// THE PER-LINE FORCER SET IS NOT SPELLED HERE ANY MORE (P3 Task 6). It lives in
// `scene_forces_per_line()` above, exhaustively, and this fold CALLS it. The P1 note that
// used to sit here — "the forcer set is deform tables + anchors; nothing here should be
// widened to guess at the rest" — was right about the hazard and wrong about the remedy:
// the remedy is one derivation that states all five arms and marks the two without a
// subject, not two arms plus a prohibition. `sc_precision` is consulted THERE, which is
// what made retiring scene()'s precision fence possible.
//
// P3 Task 5 PROMOTED two bits (CAP_MULTI_DEFORM_TABLE, CAP_FACTOR_CURVE) to `pub const`
// so their gates can be measured, and nothing raises them yet — Task 7 and Task 10 own
// those lowerings. This fold still does not read them, for the P1 reason: a bit raised
// here without a mechanism behind it is a capability claim with no subject.
//
// The other three folds below (CAP_DEFORM, CAP_PER_COL_VSRAM, CAP_ANCHORS) stay inline —
// each is a single-arm question with no twin, so there is nothing to single-source.
// =====================================================================
pub comptime fn scene_caps(s: Scene) -> int {
    comptime var caps = 0
    // Bit literals, not the CAP_* names: this fn is elaborated at a game call site and
    // only a glob import puts those names there. See the pin block at the top.
    //   $0001 CAP_PER_LINE  $0002 CAP_PER_COL_VSRAM  $0004 CAP_DEFORM  $0008 CAP_ANCHORS
    // NESTED `if`-EXPRESSIONS DO NOT EVALUATE HERE. The first spelling of this was
    // `if a { 1 } else { if b { 1 } else { 0 } }` and it returned 0 whenever only the
    // INNER test was true — measured: a BG-only deform scene folded to caps 0, so
    // OJZ_Default would have shipped claiming it needs nothing per-line. A flat
    // accumulator over statement `if`s is the shape that holds. (A single-level
    // if-expression IS fine; `anchored` below is one.)
    //
    // has_table IS DELIBERATELY PLANE-AGNOSTIC — "is there a table anywhere", not "is
    // there one on the plane that needs it". The pipeline is per-frame and per-line for
    // the whole screen; there is no half-per-line.
    comptime var has_table = 0
    if scene_deform_is_none(s.sc_deform_fg) == 0 {
        has_table = 1
    }
    if scene_deform_is_none(s.sc_deform_bg) == 0 {
        has_table = 1
    }
    let anchored = if scene_anchor_ch(s.sc_anchor) == $FF { 0 } else { 1 }
    // Per-line: NOT re-derived here. `scene_forces_per_line()` above is the single
    // source for the whole forcer set, and this fold consumes it. Before P3 Task 6 these
    // two lines spelled `has_table == 1 || anchored == 1` — arms 1 and 2 of five, with
    // the note below explicitly forbidding anyone from widening it to guess at the rest.
    // The widening happened in the derivation, where it can be stated exhaustively, and
    // this call is what stops the two from drifting.
    if scene_forces_per_line(s) == 1 {
        caps = caps | $0001
    }
    // Deform proper needs a table AND a live amplitude somewhere. A table whose every
    // consumer sits at shift 15 is flat-pathed: the sample loop is skipped and the
    // emitted HScroll is identical to the no-deform case, so it demands the per-line
    // pipeline but not the deform math. OJZ_Default is exactly that scene.
    //
    // THE SCAN IS CROSS-PLANE ON PURPOSE — every layer shift and both anchor shifts,
    // regardless of which plane holds a table — and the asymmetry is not a bug to tidy.
    // ParallaxConfig_Haze (configs.emp:181-199) attaches a table on the FG ONLY while
    // every band carries a live `dsb: 4`; a scan that paired dsa with deform_fg and dsb
    // with deform_bg would fold Haze to no-deform. The runtime's shift sentinel is per
    // band and per plane, not per attachment.
    comptime var live_amp = 0
    // THE ONE-DOT RULE (Task-1 spike). This three-step split — field, then index, then
    // field — is not indirection for its own sake and must not be collapsed to
    // `s.sc_layers[i].ly_dsa`: chained access past one dot NEVER resolves, and it does
    // not error, it silently yields nothing. Every `ls` / `l` split in this file
    // (scene_hdr, scene_band, derived_mask) is here for that reason.
    let ls = s.sc_layers
    let n  = s.sc_count
    for i in 0..n {
        let l = ls[i]
        if l.ly_dsa != 15 {
            live_amp = 1
        }
        if l.ly_dsb != 15 {
            live_amp = 1
        }
    }
    if anchored == 1 {
        if scene_anchor_dsa(s.sc_anchor) != 15 {
            live_amp = 1
        }
        if scene_anchor_dsb(s.sc_anchor) != 15 {
            live_amp = 1
        }
    }
    if has_table == 1 && live_amp == 1 {
        caps = caps | $0004
    }
    if scene_vdeform_is_none(s.sc_v_deform) == 0 {
        caps = caps | $0002
    }
    if anchored == 1 {
        caps = caps | $0008
    }
    // ANCHORS IMPLY PER-LINE, and P3 Task 6 made that load-bearing rather than merely
    // true. `parallax_mode_key()`'s CAP_ANCHORS gate is lexically enclosed by a
    // CAP_PER_LINE gate, and tools/scene_spans.py derives a mask's expected spans from
    // exactly that nesting — so a mask carrying CAP_ANCHORS without CAP_PER_LINE would be
    // told to expect a span from a build where the whole site elided. The fold cannot
    // produce such a mask (arm 2 of scene_forces_per_line() sets $0001 from the same
    // anchor), and this pin is what keeps it that way if either arm is ever edited.
    ensure((caps & $0008) == 0 || (caps & $0001) != 0,
           "scene_caps(): a scene raised CAP_ANCHORS ({caps}) without CAP_PER_LINE — an anchored boundary lands on an arbitrary scanline, so the two are one claim; the span-expectation derivation in tools/scene_spans.py reads the nesting of the two gates in parallax_mode_key() and would demand a span from a build whose whole site elided")
    return caps
}

// fold_caps — the REGISTRY-level capability mask: every scene's demands, ORed, plus the
// one bit no single scene can raise.
//
// It lives here rather than in Task 5's registry module because it is the other half of
// scene_caps() and the two must be read together — split across files, the reason
// CAP_TRANSITIONS is missing upstairs stops being visible from where it is added. The
// registry module supplies the LIST; the rule for turning a list into a mask is model,
// and model lives with the model.
//
// CAP_TRANSITIONS ($0010) on count > 1: a transition is a property of the EDGE between
// two scenes, so a game with one scene never crosses one no matter what its sc_transition
// byte says. This is the P1 ruling as written; a later phase that learns which section
// pairs are actually adjacent can tighten it, and the tightening is a strict subset.
pub comptime fn fold_caps(scenes: array) -> int {
    ensure(scenes.len >= 1, "fold_caps(): an empty scene registry has no capabilities to fold — a game with no scenes should not be declaring a cap mask")
    comptime var caps = 0
    for s in scenes {
        caps = caps | scene_caps(s)
    }
    if scenes.len > 1 {
        caps = caps | $0010
    }
    return caps
}

// =====================================================================
// THE REBASE STRUCTURAL CHECK (design §6 / §8.2's last build-time gate).
//
// READ THE SCOPE FIRST. Design §6 says: "world-Y layer tops and the anchor bank join the
// §4.11 rebase checklist. Until §4.11 exists (it is FUTURE/Phase-4), the contract test is
// STRUCTURAL/DECLARATIVE only — an act-relative tagging check — stated plainly so it
// cannot be mistaken for runtime rebase verification." This is that check and nothing
// more. It proves the DECLARATIONS sit in a rebase-classified coordinate space; it does
// not, and cannot, prove a rebase preserves them.
//
// THE TWO SPACES, AND WHY EACH IS SAFE UNDER §4.11's UNIFORM SUBTRACTION:
//
//   layer top  (SceneLayer.ly_world_y)  ACT-RELATIVE SINCE P3 TASK 7, AND THAT CHANGED
//              ITS REBASE ARGUMENT — read this before assuming the old one still holds.
//              It USED to be plane-relative (a position inside the 512-px Plane-B span,
//              folded to a cell row by `scene_band`'s `>> 3`), and the argument was that
//              it carried no absolute act coordinate, so a uniform subtraction of
//              REBASE_DELTA left it correct untouched — the section-local-entity argument
//              (ARCH §4.9.1). THAT IS NO LONGER TRUE. `ly_world_y` is now an ACT Y, so a
//              rebase that renumbers act coordinates MUST renumber it, exactly as it must
//              renumber the anchor bank. Design §6 anticipated this ("world-Y layer tops
//              and the anchor bank join the §4.11 rebase checklist"); this comment is the
//              record that they have now actually joined it. The mitigating fact, and the
//              reason this is a checklist row rather than a blocker: the tops are
//              COMPTIME data folded to plane lines by `scene_plane_line()` at build time,
//              so a rebase is a re-authoring event, not a runtime one — nothing in RAM
//              holds a stale copy.
//
//   anchor     (SceneAnchor.At's first payload)  ACT-RELATIVE, BY INDIRECTION. The scene
//              declares a patch CHANNEL, never a coordinate; the act-space Y lives in
//              Effects_World_Y[ch] and reaches the overlay through Effects_Screen_L,
//              which Effects_LatchWorldLines re-derives every frame from Camera_Y. So the
//              rebase has exactly one bank to renumber and the scene records nothing that
//              could go stale.
//
// WHY IT IS A REGISTRY-LEVEL FOLD AND NOT A THIRD ENSURE IN scene()/layer(). Those two
// already range-check their own arguments — and if that were the whole story this check
// would be vacuous, which is worth saying out loud. It is not, because BOTH constructors
// are bypassable and this file says so twice: `SceneLayer{ ly_world_y: 5, .. }` and
// `Scene{ .. }` both type-check and skip every guard (see the notes at those structs).
// A value that reached the registry through that door has never been range-checked by
// anything. This fold runs over the REGISTRY — every scene the game actually ships,
// however it was built — which is the only place that door can be closed.
//
// Returns the number of world-Y tops it classified, so the caller can reference the
// result: an unreferenced top-level `const X = f(...)` is comptime-INERT and proves
// nothing (docs/EMP_PITFALLS.md §3).
// =====================================================================
pub comptime fn assert_act_relative_tagged(scenes: array, act_span: int) -> int {
    // ANTI-VACUITY ON THE BOUND ITSELF. A caller that passed 0 — or a name that resolved
    // to nothing, which is the silent failure mode for a constant at a call site
    // (docs/EMP_PITFALLS.md §2) — would make every top below fail rather than pass, so
    // this is a diagnosis rather than a net. A NEGATIVE or absurdly small span is the
    // case worth naming: it would make the fold assert something no act could satisfy.
    // 512 is inlined per the pin block; one Plane-B span is the smallest act that can
    // carry a scene at all.
    ensure(act_span >= 512 && act_span <= $8000,
           "scene registry: the act span handed to assert_act_relative_tagged() is {act_span}, which is not a legal act extent (one Plane-B span .. the engine's $8000 act-axis ceiling). This value must be DERIVED from the act descriptor's own grid — GRID_H << SECTION_SIZE_SHIFT — not typed; a 0 here usually means the constant did not resolve at the call site")
    comptime var tops = 0
    comptime var anchors = 0
    for s in scenes {
        // The one-dot rule again — field, then index, then field (see scene_caps()).
        let ls = s.sc_layers
        let n  = s.sc_count
        for i in 0..n {
            let l  = ls[i]
            let wy = l.ly_world_y
            // P3 TASK 7 CHANGED BOTH HALVES OF THIS ENSURE, AND THE SPACE IT NAMES.
            //   * the 8-px grid clause is GONE: an off-grid top is legal now, and the
            //     forcer arm 5 in scene_forces_per_line() is what makes it correct.
            //   * `wy < 512` — the BG PLANE's span — became `wy < act_span`, the act's
            //     own, because that is the space `ly_world_y` is now in. The number is
            //     DERIVED at the call site from the act descriptor, never typed here.
            // THE PLANE-IMAGE RANGE IS DELIBERATELY NOT RE-CHECKED HERE. `scene_plane_line()`
            // owns it, and every scene in this list reaches it: lowerN calls scene_band()
            // once per real layer and scene_band() calls scene_plane_line(). Adding a second
            // call here would be a guard that can never fire on its own — indistinguishable
            // from coverage, which is this tree's most expensive lesson. What THIS ensure
            // owns is the act span, which nothing else in the chain knows.
            ensure(wy >= 0 && wy < act_span,
                   "scene registry: a world-Y layer top ({wy}) is outside this act's vertical span ({act_span}), so it is not act-relative-tagged and the §4.11 rebase has no class for it. NOTE this is a STRUCTURAL check only: it proves the declaration is tagged, NOT that a rebase preserves it. Runtime rebase verification waits on the §4.11 mechanism (Phase 4); do not read a green build here as rebase-safe. A top that reached here out of span came through the SceneLayer{{ .. }} back door, bypassing layer()'s own guards")
            tops = tops + 1
        }
        // $FF = PARALLAX_ANCHOR_NONE, 4 = RASTER_MAX_PATCH — both inlined per the pin block.
        let ch = scene_anchor_ch(s.sc_anchor)
        ensure(ch == $FF || ch < 4,
               "scene registry: an anchor bank reference (channel {ch}) is not act-relative-tagged — the ACT-RELATIVE space is the patch bank Effects_World_Y[4], and a channel outside it names no bank the §4.11 rebase would renumber. NOTE this is a STRUCTURAL check only: it proves the declaration is tagged, NOT that a rebase preserves it. Runtime rebase verification waits on the §4.11 mechanism (Phase 4); do not read a green build here as rebase-safe. A channel that reached here out of range came through the Scene{{ .. }} back door, bypassing scene()'s own guards")
        if ch != $FF {
            anchors = anchors + 1
        }
    }
    // ANTI-VACUITY FLOOR. A registry whose scenes declare no world-Y top at all would
    // satisfy every ensure above by having nothing to check, and the caller's `> 0`
    // reference would still hold on the anchor count alone. Both are named so a green
    // result reports what it actually looked at.
    ensure(tops >= 1,
           "scene registry: not one world-Y layer top was classified, so the rebase structural check asked nothing. A scene registry with no tops is either empty or built through the Scene{{ .. }} back door with sc_count 0")
    return tops + anchors
}

// =====================================================================
// THE BUDGET LEDGER (P2 Task 11 — design §5).
//
// Every constant below is TRANSCRIBED FROM A MEASURED ROW in
// tools/effects_budget_model.toml, and each carries the row name it came from. Nothing
// here is estimated, and nothing here is copied from a nearby number: the plan's own
// preamble names `EFX_BLANK_DELAY = 4` as the cautionary case — a constant fitted to one
// shape, enforced by a guard, and wrong for every other shape for as long as nothing
// measured it. Phase 0 measured these; the derivation of each budget is written beside it.
//
// ---- WHY THE AGGREGATION IS `max`, NOT `sum` (a correction to the plan) ----
//
// Design §5 and the plan say "per axis, the SUM is enforced comptime". For SCENES that is
// wrong, and not marginally: ONLY ONE SCENE IS LIVE AT A TIME. A game with twenty scenes
// does not run twenty walkers — it runs the one its current section binds. Summing axis 1
// over the shipped twenty gives ~500,000 cycles against a 128,000-cycle frame, so a SUM
// gate would refuse a registry that demonstrably runs today, which is the exact failure the
// toml header warns about ("a generated `ensure` would fail programs that demonstrably run").
//
// So the steady-state fold is `max` — the WORST scene must fit — and that is the honest
// enforcement. The place a pairwise SUM genuinely belongs is the TRANSITION FRAME, where
// outgoing and incoming configs are both partially live; that is Task 12, and it is BLOCKED
// (no comptime section->scene join, no measured transition reservation — see
// docs/DEFERRED_WORK.md). This note is the seam: when Task 12 lands, it adds the pairwise
// term ON TOP of these max rows; it does not replace them.
//
// ---- WHY THE DENOMINATOR IS THE IDLE STATE ----
//
// Phase 0 measured that sustained max-diagonal does NOT run at 60 Hz: 31 video frames carry
// 15 logic ticks (frames_per_logic_tick_max_diagonal = 2.067, spread 0 across five boots),
// and the single biggest term is Tile_Cache_Fill at 40.1% of every video frame. That is an
// ART-STREAMING cost, not an effects cost, and it is separately owned. A budget gate that
// certifies "this scene fits a 60 Hz frame" must therefore divide by the state that ACTUALLY
// HOLDS 60 Hz, which is idle. The max-diagonal rows stay in the toml as context, carried
// with BOTH denominators, and are never a gate divisor.
//
// ---- UNITS: HUNDREDTHS OF A CYCLE ----
//
// The walker's fitted constants are fractional to two places (base 3021.94, and the fit's
// max |residual| is 0.27 cycles over 14 un-anchored fixtures). `.emp` comptime is integer
// math, so the axis-1 terms are held x100 and named `_X100`. Rounding to whole cycles
// instead would discard a measured digit for no reason; the raster DSL already sets this
// precedent ("Computed in TWENTIETHS so the two halvings ... are exact").
// =====================================================================

// ---- Axis 1: the walker's fitted additive model, [parallax.cost_model] ----
// 17 fixtures, 3 boots each, spread 0 on every one; residual 0.27 cyc on the un-anchored
// subset. Response = Parallax_Update's per-routine row, INCLUSIVE of its callees.
pub const SB_WALK_BASE_X100          = 302194   // base_cycles          3021.94
pub const SB_WALK_BAND_PERCELL_X100  = 74694    // band_percell_cycles   746.94
pub const SB_WALK_LINE_MODE_X100     = 151802   // line_mode_cycles     1518.02
pub const SB_WALK_BAND_PERLINE_X100  = 84597    // band_perline_cycles   845.97
pub const SB_WALK_MULTIBAND_X100     = 2321     // multiband_cycles        23.21
pub const SB_WALK_LINE_FG_X100       = 7621     // line_fg_only_cycles     76.21
pub const SB_WALK_LINE_BG_X100       = 7627     // line_bg_only_cycles     76.27
pub const SB_WALK_LINE_BOTH_X100     = 12617    // line_both_cycles       126.17
pub const SB_WALK_VDEFORM_X100       = 142406   // vdeform_cycles        1424.06

// THE ANCHOR IS CHARGED AT ITS MEASURED WORST REGIME AND IS NOT A FITTED TERM. The toml is
// explicit: `anchor_status = "NOT CONSTANT — two regimes measured, missing parameter named
// in WALKER-MODEL.md, deliberately not fitted"`. W10/W12 measured +456.7/+455.7 (the overlay
// when sampling is ALREADY on); W16 — the SHIPPED shape, ParallaxConfig_OJZ_Underwater —
// measured +1204.7, because there the anchor is what TURNS sampling on. A budget takes the
// worst measured regime and says so; fitting a column excited by one fixture would zero a
// residual without evidence, which the measurement task refused to do and this must not undo.
pub const SB_WALK_ANCHOR_WORST_X100  = 120470   // anchor_cycles_shipped_shape 1204.7 (W16)

// THE SAMPLING TERMS ARE PER SCREEN LINE — forced by measurement, not chosen (fixtures that
// sample only their lower band give 8536/112 and 6097/80 against 17071/224: 76.21 every
// time). THE LINE COUNT A BUDGET MUST USE IS 224, THE WHOLE SCREEN, even for an anchored
// scene that samples fewer. The anchor's SCREEN line is a RUNTIME value — the scene declares
// a patch CHANNEL, and Effects_LatchWorldLines re-derives the line from Camera_Y every frame
// — so the comptime-knowable worst case is an anchor at screen line 0. This over-charges the
// shipped anchored scene (which samples 144 lines at the idle baseline) by design; a budget
// that assumed the camera's convenient position would be gating a coincidence.
pub const SB_SCREEN_LINES            = 224

// The out-of-sample gap, carried as an EXPLICIT uncertainty term rather than tuned away.
// The live config at the idle baseline predicts 19288.7 and measures 19511 — gap +222.3,
// or +1.1%, which the toml attributes to the shipped config's own band tops and scroll-factor
// shifts (work the fixtures held constant). Applied as +11/1000 so the multiply stays small.
pub const SB_WALK_UNCERTAINTY_PERMIL = 11       // out_of_sample_gap_pct 1.1

// ---- Axis 1 pool and reservation ----
// Pool: the NTSC video frame. Reservation: the engine cost that is NOT the walker, so the
// walker's own measured row is subtracted out — charging a scene the walker AND leaving the
// baseline walker in the reservation would double-count the very thing being budgeted.
//   idle_main_loop_cycles 35125 - idle_parallax_update_cycles 19511 = 15614  (non-walker loop)
//   + idle_vblank_cycles 8280                                               (the VInt bracket)
//   = 23894
pub const SB_FRAME_CYCLES            = 128000   // NTSC video frame (ntsc_scanline_cycles 488 x 262)
pub const SB_AXIS1_RESERVATION       = 23894    // measured, derived above

// ---- Axis 2: VBlank DMA bytes ----
// Pool 7524 B is the H40 NTSC VBlank DMA capacity. The reservation is the measured queue
// MINUS the per-line HScroll entry, because that entry belongs to the SCENE and is what this
// axis charges: whole-region scan 3056 B, less 896 B, = 2160 B of non-scene engine DMA.
//
// THE PER-LINE FORCER IS 896 B, ONE ENTRY — and the 1792 B that stood here from P2 until
// 2026-08-20 was a measurement artifact, not a correction to design §5. P3 Task 6 Step 1
// ruled it: `Process_DMA_Critical` resets only the slot CURSOR on drain
// (engine/system/dma_queue.emp:362) and never zeroes the entry bytes, so the whole-region
// queue scan that reported "two 448-word entries with the same command word" was reporting
// one live entry and one stale copy from an earlier frame at a different slot offset. Three
// independent tells, all reproduced: the tree has exactly ONE `Static_Hscroll_Line` enqueue
// site and it is an either/or reached once per VBlank; at the scan line all three slot cursors
// sat at their BASES, so the queue was EMPTY and every entry reported was residue; and zeroing
// the region then advancing exactly one frame yields ONE 896 B entry, five trials, no
// variation. §5's own 896 B / 12% was right.
//
// THE 896 B DID NOT VANISH — IT MOVED COLUMNS. The reservation went 1264 -> 2160 so the SUM
// this guard is judged on (896 + 2160 = 3056) is byte-for-byte what it was, and no budget was
// loosened on the strength of a re-attribution. 2160 is a CEILING (it still contains drain
// residue); the live per-frame queue is 984 B, of which 896 is the scene's, leaving 88 B — but
// that state has an EMPTY Important queue, so 88 would under-reserve for art streaming, whose
// 1152 B page transfer this scan only ever sees as residue. Deriving "standing non-scene DMA"
// properly is P3 Task 13's re-take of every row measured against today's walker.
pub const SB_DMA_POOL_BYTES          = 7524
pub const SB_AXIS2_RESERVATION       = 2160     // CEILING: whole-region 3056 B less the scene's 896
pub const SB_PERLINE_DMA_BYTES       = 896      // ONE 448-word entry (Task 6 Step 1 ruling)

// ---- Axis 3: VBlank CPU, and the COMBINED per-line cost §5 asks for ----
// Pool: the ~18,200-cycle NTSC VBlank window ([raster.schedule_build]'s own denominator).
// Reservation: idle_vblank_cycles 8280 — the VInt_Level BRACKET, which the toml names as
// "the number a VBlank axis is a fraction of", not Raster_VBlank's narrower row.
//
// THE SCENE'S AXIS-3 CHARGE IS THE DRAIN OF ITS OWN AXIS-2 BYTES, and this is the half that
// makes the per-line cost legible as one number. It is DERIVED from documented hardware
// rates, exactly as the toml derives dma_max_single_transfer_derived_cycles: H40 VBlank VRAM
// DMA moves 205 B/line and a scanline is 3420/7 = 488.57 cyc, so 896 B occupies
// 896 / 205 * 488.57 = 2135 cycles. (HALVED 2026-08-20 with SB_PERLINE_DMA_BYTES above: this
// row is derived from that one, so the Task 6 Step 1 ruling carries straight through.)
//
// THIS IS NOT DOUBLE-COUNTING THE 8280, and the reason is the instrument. Oracle's 68000
// core adds only `cyclesExecuted` to `_currentCycle` while bus/VDP/DMA stall accumulates in
// `additionalTime` and lands in `_currentTime` (M68000.cpp:1029-1031; the profiler ring
// stamps `_currentCycle`, M68000.h:95). So DMA occupancy NEVER reaches a measured cycle row
// — 8280 is blind to it by construction — and adding the derived term supplies exactly what
// the instrument cannot see. It is also why max_contiguous_dma_stall_cycles is recorded as
// UNMEASURABLE-ON-THIS-INSTRUMENT rather than as a number.
pub const SB_VBLANK_WINDOW_CYCLES    = 18200
pub const SB_AXIS3_RESERVATION       = 8280     // idle_vblank_cycles, the VInt_Level bracket
pub const SB_DMA_BYTES_PER_LINE      = 205      // H40 VBlank VRAM DMA rate (documented)
pub const SB_SCANLINE_CYC_X100       = 48857    // 3420/7 = 488.57 cyc

// ---- Axis 4b lives in engine/effects/raster_dsl.emp ----
// The HInt per-frame total is a property of the authored RASTER PROGRAM, not of a scene:
// scenes do not fire HInts. Charging it per-scene would need the section->preset->program
// join, which is Labels end to end — the same barrier that blocks Task 12. So axis 4b is
// enforced where the programs are built, inside `raster_program()`, over the fires it can
// actually see. Named here so a reader of the ledger is not left wondering where it went.

// =====================================================================
// Per-scene axis costs. Each returns the charge for ONE scene; the registry folds them.
// =====================================================================

// Does this scene attach an H-deform table on EITHER plane? Plane-agnostic on purpose,
// matching scene_caps()'s has_table: the per-line pipeline is whole-screen, there is no
// half-per-line.
pub comptime fn scene_has_table(s: Scene) -> int {
    comptime var t = 0
    if scene_deform_is_none(s.sc_deform_fg) == 0 {
        t = 1
    }
    if scene_deform_is_none(s.sc_deform_bg) == 0 {
        t = 1
    }
    return t
}

// Does the scene ride the per-line HScroll pipeline? Same derivation as CAP_PER_LINE in
// scene_caps(): a non-NULL deform table selects it, and an anchor splits a band at a
// SCANLINE, which an 8-px-quantised boundary cannot express.
pub comptime fn scene_is_per_line(s: Scene) -> int {
    comptime var p = 0
    if scene_has_table(s) == 1 {
        p = 1
    }
    if scene_anchor_ch(s.sc_anchor) != $FF {
        p = 1
    }
    return p
}

// Live deform amplitude on plane A / plane B. TWO functions, one per plane, because the
// RUNTIME's shift sentinel is per band AND per plane — the sampling term charged below
// depends on how many PLANES sample, and a cross-plane "is anything live" answer cannot
// tell line_fg_only (76.21) from line_both (126.17).
//
// This is deliberately a NARROWER question than scene_caps()'s live_amp, which is
// cross-plane because it only has to answer "does this scene need the deform math at all"
// (and must fold ParallaxConfig_Haze — an FG-only table with live `dsb` — to CAP_DEFORM).
// Both readings are correct for their own question; see scene_caps()'s note.
pub comptime fn scene_live_amp_a(s: Scene) -> int {
    comptime var live = 0
    // The one-dot rule — field, then index, then field (see scene_caps()).
    let ls = s.sc_layers
    let n  = s.sc_count
    for i in 0..n {
        let l = ls[i]
        if l.ly_dsa != 15 {
            live = 1
        }
    }
    if scene_anchor_ch(s.sc_anchor) != $FF {
        if scene_anchor_dsa(s.sc_anchor) != 15 {
            live = 1
        }
    }
    return live
}
pub comptime fn scene_live_amp_b(s: Scene) -> int {
    comptime var live = 0
    let ls = s.sc_layers
    let n  = s.sc_count
    for i in 0..n {
        let l = ls[i]
        if l.ly_dsb != 15 {
            live = 1
        }
    }
    if scene_anchor_ch(s.sc_anchor) != $FF {
        if scene_anchor_dsb(s.sc_anchor) != 15 {
            live = 1
        }
    }
    return live
}

// The per-screen-line sampling term, x100. Zero when the scene is flat-pathed (a table
// attached but every consumer at shift 15 — the sample loop is skipped and the emitted
// HScroll is identical to the no-deform case; OJZ_Default is exactly that scene).
//
// A FLAT ACCUMULATOR OVER STATEMENT IFS, never nested if-expressions: an `if` in block-tail
// position evaluates to unit `()` SILENTLY in this language, and it has already folded a
// capability mask to 0 once in this very file's scene_caps() (docs/EMP_PITFALLS.md §1).
pub comptime fn scene_sample_term_x100(s: Scene) -> int {
    comptime var term = 0
    if scene_has_table(s) == 1 {
        let a = scene_live_amp_a(s)
        let b = scene_live_amp_b(s)
        if a == 1 {
            term = SB_WALK_LINE_FG_X100
        }
        if b == 1 {
            term = SB_WALK_LINE_BG_X100
        }
        // BOTH planes sampling is CHEAPER THAN THE SUM — 126.17, not 152.48. The per-line
        // loop shares index and phase work across the planes, so the second channel on a
        // line costs 50, not 76 (measured, fixture W8). Charging fg+bg would over-book every
        // two-plane scene by 20%.
        if a == 1 {
            if b == 1 {
                term = SB_WALK_LINE_BOTH_X100
            }
        }
    }
    return term
}

// AXIS 1 — the scene's main-loop cost in hundredths of a cycle, uncertainty included.
pub comptime fn scene_axis1_cycles_x100(s: Scene) -> int {
    let n        = s.sc_count
    let per_line = scene_is_per_line(s)
    comptime var c = SB_WALK_BASE_X100
    // Per-band slope, whichever mode the scene selects. The two are different constants
    // (746.94 per-cell vs 845.97 per-line) because the filler is a different loop.
    if per_line == 1 {
        c = c + SB_WALK_LINE_MODE_X100 + SB_WALK_BAND_PERLINE_X100 * (n - 1)
    }
    if per_line == 0 {
        c = c + SB_WALK_BAND_PERCELL_X100 * (n - 1)
    }
    // ONCE, at bands >= 2, in BOTH modes — Step 4a's `.find_k` probe loop, whose body never
    // runs at band_count 1.
    if n >= 2 {
        c = c + SB_WALK_MULTIBAND_X100
    }
    c = c + scene_sample_term_x100(s) * SB_SCREEN_LINES
    if scene_vdeform_is_none(s.sc_v_deform) == 0 {
        c = c + SB_WALK_VDEFORM_X100
    }
    if scene_anchor_ch(s.sc_anchor) != $FF {
        c = c + SB_WALK_ANCHOR_WORST_X100
    }
    // The measured out-of-sample gap, added rather than absorbed.
    return c + c * SB_WALK_UNCERTAINTY_PERMIL / 1000
}

// AXIS 2 — the scene's VBlank DMA bytes.
pub comptime fn scene_axis2_dma_bytes(s: Scene) -> int {
    comptime var b = 0
    if scene_is_per_line(s) == 1 {
        b = SB_PERLINE_DMA_BYTES
    }
    return b
}

// AXIS 3 — the scene's VBlank CPU: the drain occupancy of its own axis-2 bytes.
pub comptime fn scene_axis3_vblank_cycles(s: Scene) -> int {
    let bytes = scene_axis2_dma_bytes(s)
    // bytes / 205 lines, each 488.57 cyc — the x100 scanline constant divided back out.
    return bytes * SB_SCANLINE_CYC_X100 / (SB_DMA_BYTES_PER_LINE * 100)
}

// =====================================================================
// The registry-level fold and the ENFORCEMENT. This is the single authority: design §5's
// ownership rule puts enforcement in the comptime DSL, and the toml `[symbols]` rows pin
// PROVENANCE (drift detection) and never enforcement.
//
// Returns the number of scenes it checked, so the caller can reference the result — an
// unreferenced top-level `const X = f(...)` is comptime-INERT and proves nothing
// (docs/EMP_PITFALLS.md §3), the same reason assert_act_relative_tagged() returns a count.
// =====================================================================
pub comptime fn scene_budget_enforce(scenes: array) -> int {
    ensure(scenes.len >= 1, "scene_budget_enforce(): an empty scene registry has no budget to check — a game with no scenes should not be reaching the budget fold")
    comptime var checked = 0
    for s in scenes {
        // AXIS 1 — main-loop cycles.
        let a1 = scene_axis1_cycles_x100(s)
        ensure(a1 / 100 + SB_AXIS1_RESERVATION <= SB_FRAME_CYCLES,
               "scene budget AXIS 1 (main-loop cycles): this scene's walker costs {a1 / 100} cyc against a {SB_FRAME_CYCLES}-cycle NTSC frame with {SB_AXIS1_RESERVATION} cyc reserved for the non-walker engine (idle_main_loop 35125 less the walker's own idle_parallax_update 19511, plus the idle_vblank VInt bracket 8280), leaving {SB_FRAME_CYCLES - SB_AXIS1_RESERVATION}. The cost is the FITTED walker model in tools/effects_budget_model.toml [parallax.cost_model] (17 fixtures, residual 0.27 cyc) plus its measured +1.1% out-of-sample gap, with the anchor charged at its worst MEASURED regime (1204.7, W16) because it is NOT a constant. Denominator is the IDLE camera state: sustained max-diagonal does not run at 60 Hz (2.067 video frames per logic tick) and is streaming-bound, so it is context, not a divisor")
        // AXIS 2 — VBlank DMA bytes.
        let a2 = scene_axis2_dma_bytes(s)
        ensure(a2 + SB_AXIS2_RESERVATION <= SB_DMA_POOL_BYTES,
               "scene budget AXIS 2 (VBlank DMA bytes): this scene enqueues {a2} B against a {SB_DMA_POOL_BYTES} B H40 NTSC VBlank pool with {SB_AXIS2_RESERVATION} B reserved for non-scene engine DMA (whole-region queue scan 3056 B less the scene's own per-line HScroll 896 B — a CEILING, since that scan includes drain residue; P3 Task 13 re-derives it), leaving {SB_DMA_POOL_BYTES - SB_AXIS2_RESERVATION}. A per-line scene costs 896 B — ONE 448-word HScroll entry, exactly what design §5 prices; the 1792 B this message carried until 2026-08-20 was a queue scan counting drain residue as a second live entry. Read it together with AXIS 3 below: the combined per-line tax is 896 B AND {scene_axis3_vblank_cycles(s)} cyc of drain, and the drain half is still the part §5 does not price at all")
        // AXIS 3 — VBlank CPU (the drain of axis 2).
        let a3 = scene_axis3_vblank_cycles(s)
        ensure(a3 + SB_AXIS3_RESERVATION <= SB_VBLANK_WINDOW_CYCLES,
               "scene budget AXIS 3 (VBlank CPU): this scene's DMA drain occupies {a3} cyc against the ~{SB_VBLANK_WINDOW_CYCLES}-cycle NTSC VBlank window with {SB_AXIS3_RESERVATION} cyc reserved (idle_vblank_cycles, the VInt_Level bracket Raster_VBlank runs inside), leaving {SB_VBLANK_WINDOW_CYCLES - SB_AXIS3_RESERVATION}. The drain is DERIVED from documented hardware rates (bytes / 205 B-per-line x 488.57 cyc-per-line), not measured, and it is NOT double-counted against the reservation: oracle's cycle clock excludes bus/DMA stall by construction (M68000.cpp:1029-1031), so no measured cycle row contains it")
        checked = checked + 1
    }
    return checked
}

// The worst scene per axis — the ledger rows the registry publishes as `pub equ`. `max`,
// not `sum`: see the banner. Each takes the registry so the answer is over every shipped
// scene, not over whichever one a reader happened to look at.
pub comptime fn scene_budget_max_axis1_x100(scenes: array) -> int {
    comptime var m = 0
    for s in scenes {
        let c = scene_axis1_cycles_x100(s)
        if c > m {
            m = c
        }
    }
    return m
}
pub comptime fn scene_budget_max_axis2(scenes: array) -> int {
    comptime var m = 0
    for s in scenes {
        let c = scene_axis2_dma_bytes(s)
        if c > m {
            m = c
        }
    }
    return m
}
pub comptime fn scene_budget_max_axis3(scenes: array) -> int {
    comptime var m = 0
    for s in scenes {
        let c = scene_axis3_vblank_cycles(s)
        if c > m {
            m = c
        }
    }
    return m
}
// How many scenes ride the per-line pipeline — the count that makes the axis-2/3 rows
// legible (a registry where every scene is per-line has no cheap fallback to schedule into).
pub comptime fn scene_budget_per_line_count(scenes: array) -> int {
    comptime var n = 0
    for s in scenes {
        if scene_is_per_line(s) == 1 {
            n = n + 1
        }
    }
    return n
}

// =====================================================================
// Lowering — the authored scene becomes the records the runtime already reads.
//
// scene_hdr()/scene_band() must produce, FIELD FOR FIELD, what configs.emp's
// hdr()/band() produce for the same authoring. That is the P1 gate: Task 7 keeps the
// two constructors alive side by side and proves them word-equal, and Task 6's twenty
// migrated configs are only correct if the ROM does not move a byte. Every default
// below is hdr()'s default, transcribed, not re-derived.
// =====================================================================

// scene_hdr — the 28-byte parallax_config header.
pub comptime fn scene_hdr(s: Scene) -> parallax_config {
    let n        = s.sc_count
    let mask_raw = s.sc_mask_raw
    let ls       = s.sc_layers
    // The layer mask: the raw bridge when authored, else the derived one. scene() has
    // already checked that a raw mask is a SUPERSET of this exact derivation, which is
    // why both call sites must share derived_mask() rather than each carrying a loop.
    let mask = if mask_raw >= 0 { mask_raw } else { derived_mask(ls, n) }
    // The V-deform amplitude shift: the raw bridge when authored (>= 0 wins outright,
    // including over an attached table — SkyHaze is the only case and attaches none),
    // else the attachment's own shift, else hdr()'s default 4 via the accessor.
    let vds_raw = s.sc_v_deform_shift_raw
    let vds = if vds_raw >= 0 { vds_raw } else { scene_vdeform_shift(s.sc_v_deform) }
    return parallax_config{
        pcfg_band_count:        n,
        pcfg_v_factor_bg:       s.sc_v_factor,
        pcfg_v_factor_fg:       s.sc_v_factor_fg,
        pcfg_layer_mask:        mask,
        pcfg_v_center_y:        s.sc_v_center,
        pcfg_v_offset:          s.sc_v_offset,
        pcfg_transition:        s.sc_transition,
        pcfg_deform_speed_fg:   scene_deform_speed(s.sc_deform_fg),
        pcfg_deform_speed_bg:   scene_deform_speed(s.sc_deform_bg),
        pcfg_anchor_ch:         scene_anchor_ch(s.sc_anchor),
        pcfg_deform_table_fg:   scene_deform_table(s.sc_deform_fg),
        pcfg_deform_table_bg:   scene_deform_table(s.sc_deform_bg),
        pcfg_v_deform_table_bg: scene_vdeform_table(s.sc_v_deform),
        pcfg_v_deform_speed_bg: scene_vdeform_speed(s.sc_v_deform),
        pcfg_v_deform_shift_bg: vds,
        pcfg_anchor_dsa:        scene_anchor_dsa(s.sc_anchor),
        pcfg_anchor_dsb:        scene_anchor_dsb(s.sc_anchor),
    }
}

// =====================================================================
// scene_plane_line — THE ACT -> PLANE MAPPING (P3 Task 7). The one unit conversion left
// in the lowering, and it replaced `world_y >> 3`, which was an act->cell TRUNCATION
// dressed up as a unit conversion.
//
// A layer top is authored in ACT world pixels. The band it becomes lives in the BG
// PLANE, and the plane does not track the act 1:1 — it tracks it through the scene's own
// vertical mapping, the SAME one Parallax_Step5_Vscroll applies to the camera:
//
//     Vscroll_BG = ((camY - v_center) >> v_factor) + v_offset      (parallax.emp:1062-1067)
//
// So the plane line an authored world Y lands on is that expression evaluated at the TOP
// instead of at the camera, and Step 4a's whole per-frame job is the subtraction of the
// two. Folding it at comptime rather than at runtime is deliberate: v_factor/v_center/
// v_offset are scene constants, so a runtime mapping would recompute an invariant up to
// eight times a frame to reach the same number.
//
// WHY THIS IS A DIFFERENT MAPPING FROM THE ANCHOR'S, WHICH IS ALSO ACT-SPACE AND ALSO
// LANDS ON A SCREEN LINE. `Effects_LatchWorldLines` maps `Effects_World_Y[ch]` to a
// screen line as `world_y - Camera_Y`, 1:1, because a patch anchor is a LEVEL feature —
// a water surface Sonic swims under, at the camera's own depth. A static layer top is a
// feature of the BG ART, which is at the BG plane's depth. Two things authored in the
// same coordinate space land on different screen lines, and that is not an inconsistency,
// it is parallax. The two agree at exactly one depth (v_factor 0, v_center 0, v_offset 0)
// and are meant to disagree everywhere else.
//
// THE LOCKED CASE IS NOT A SPECIAL CASE, IT IS THE DEGENERATE ONE. `v_factor == 15` is
// the lock sentinel (parallax.emp:1055-1057): the BG plane ignores the camera entirely
// and Vscroll_BG is pinned at v_offset. There is no act->plane relation to invert —
// `(wy - v_center) >> 15` is 0 or -1 for every wy, which would collapse every layer of
// every locked scene onto one line. For a locked plane the authoring space IS the plane,
// so the mapping is the identity. EIGHTEEN OF THE TWENTY shipped scenes are that case
// (tops 0/32/80/112/160, which read as screen lines because v_offset is 0), which is why
// this arm carries the shipped registry rather than being a corner.
// =====================================================================
pub comptime fn scene_plane_line(s: Scene, wy: int) -> int {
    let vf = s.sc_v_factor
    let vc = s.sc_v_center
    let vo = s.sc_v_offset
    // A locked plane maps identically; an unlocked one may not shift a NEGATIVE dividend
    // (the runtime's `asr.w` sign-extends, so the top would land above the plane origin,
    // which is not a position). 15 is the lock sentinel, inlined per the pin block.
    ensure(vf == 15 || wy >= vc,
           "scene_plane_line(): world_y {wy} is above this scene's v_center {vc}. An unlocked BG plane maps act Y to a plane line as ((world_y - v_center) >> v_factor) + v_offset — the same mapping Parallax_Step5_Vscroll applies to the camera — and a top above v_center has no plane image, because the plane never reaches it. Move the top down, or move v_center up.")
    comptime var pl = wy
    if vf != 15 {
        pl = ((wy - vc) >> vf) + vo
    }
    // 512 is inlined per the pin block (PLANE_B_SPAN). Step 4a's runtime clamp protects
    // the HScroll buffer from an out-of-range top; this ensure is what stops a scene ever
    // needing it.
    ensure(pl >= 0 && pl < 512,
           "scene_plane_line(): world_y {wy} maps to plane line {pl}, outside the 512-px Plane-B span. Step 4a rotates tops modulo that span, so a top outside it aliases onto another band's rows instead of being clipped.")
    return pl
}

// scene_band — the band RECORD for layer `i`: the 10-byte legacy entry, plus the per-layer
// deform extension in a game that declares CAP_MULTI_DEFORM_TABLE (P3 Task 8, design 3.1).
// With BAND_EXT_N at 0 — both shipped games — this lowers to exactly the bytes it always
// did, which is what the section 8.1 witness pins.
//
// THE EXTENSION ARM BELOW IS DEAD IN EVERY SHIPPED GAME, and dead code is not coverage:
// nothing raises the bit until Task 9 authors `deform: own(...)`, so the only evidence the
// arm emits correctly is Task 8's spike (docs/benchmarks/scanline-p3/EXTENDED-RECORD.md,
// ROM bytes in both arms). Its reachability belongs on Task 15's poison list. The `if` is
// single-level in expression position ON PURPOSE — a NESTED if-expression yields unit
// silently (docs/EMP_PITFALLS.md section 1), which here would fold the extension array away
// with no diagnostic.
//
// P3 TASK 7 RESHAPED THE RECORD WITHOUT RESIZING IT (see parallax.emp's band_entry
// banner): the top is a u16 PLANE LINE via scene_plane_line(), and the two 1-bit factor
// op flags are packed into one `band_factor_ops` byte to pay for the extra byte.
//
// The factor split is band()'s, transcribed inline (a shared helper would be an imported
// name inside a body — see the pin block): bits 0-3 shift1, bits 4-7 shift2, bit 8 op.
// See parallax_dsl.packed() for the encoding's authority.
pub comptime fn scene_band(s: Scene, i: int) -> band_record {
    let n = s.sc_count
    ensure(i >= 0 && i < n,
           "scene_band(): layer index {i} is outside the scene's {n} real layers — the padding entries past sc_count are not lowerable")
    // The one-dot split again — see the note in scene_caps().
    let ls = s.sc_layers
    let l  = ls[i]
    let fa = l.ly_fa
    let fb = l.ly_fb
    let wy = l.ly_world_y
    // FLAT ACCUMULATOR over statement ifs — an `if` in block-tail position yields unit
    // SILENTLY (docs/EMP_PITFALLS.md §1), and this one folds a mask. Bits 0 and 1 are
    // inlined per the pin block (BAND_OP_BIT_A / BAND_OP_BIT_B).
    comptime var ops = 0
    if ((fa >> 8) & 1) != 0 {
        ops = ops | 1
    }
    if ((fb >> 8) & 1) != 0 {
        ops = ops | 2
    }
    return band_record{
        br_base: band_entry{
            band_top_plane:      scene_plane_line(s, wy),
            band_factor_a_s1:    fa & 15,
            band_factor_a_s2:    (fa >> 4) & 15,
            band_factor_b_s1:    fb & 15,
            band_factor_b_s2:    (fb >> 4) & 15,
            band_factor_ops:     ops,
            band_deform_shift_a: l.ly_dsa,
            band_deform_shift_b: l.ly_dsb,
            band_phase_offset:   l.ly_phase,
        },
        br_ext: if BAND_EXT_N == 1 { [ band_ext{ bx_deform_table_a: 0, bx_deform_table_b: 0,
                                                        bx_deform_speed_a: 0, bx_deform_speed_b: 0 } ] } else { [] },
    }
}
