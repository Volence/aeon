// engine/level/camera.emp — Camera system (§4)
// Tracks player with a fixed classic-S3K X deadzone and a fixed Y deadzone.
//
// Public:
//   Camera_Init(a0=Act*)  — initialise from act descriptor
//   Camera_Update         — follow Player_1 each frame

module engine.camera in camera

use engine.constants.{SECTION_SIZE_SHIFT, SCREEN_WIDTH, SCREEN_HEIGHT, CAM_SCREEN_HALF_W, CAM_SCREEN_HALF_H, CAM_MAX_Y_STEP}
use engine.constants.{ART_HOLD_X_BIT, ART_HOLD_Y_BIT, ST_ROLLING, CURL_Y_SHIFT}
use engine.structs.{Act}
use engine.objects.sst.{Sst}
use engine.coords.{pixels_to_coord}

// The <<SECTION_SIZE_SHIFT chains below split as 8 + (SECTION_SIZE_SHIFT-8)
// (an immediate shift is 1..8/op). The split spelling is derivation-locked to
// the constant; this guard keeps the second term in immediate range if the
// section size ever changes.
ensure(SECTION_SIZE_SHIFT > 8 && SECTION_SIZE_SHIFT <= 16, "SECTION_SIZE_SHIFT {SECTION_SIZE_SHIFT} breaks camera's 8+rest split-shift spelling — respell the chains")

const CAM_MAX_X_STEP    = 16        // file-local: this file-pair IS the truth
                                    // (byte-gate-covered), unlike CAM_MAX_Y_STEP
                                    // which is owned by engine.constants (`use`d above).
                                    // max horizontal scroll px/frame (classic S2/CD;
                                    // S3K=24, imperceptible at the 6px/f player top
                                    // speed). Caps large player position jumps (e.g.
                                    // springs) so the camera can't outrun
                                    // Section_UpdateColumns.

// CAM_MAX_Y_STEP (max camera Y movement px/frame) comes from the shared
// engine.constants twin — `use`d above. Its X partner CAM_MAX_X_STEP stays
// file-local (this file-pair IS its truth, byte-gate-covered).

const CAM_X_DEADZONE_INIT = $10     // Camera_Deadzone_Base seed: the classic 16px
                                    // asymmetric X window (variable at runtime —
                                    // game code may widen it; Y's stays fixed)
const CAM_Y_DEADZONE      = 32      // fixed vertical deadzone half-window (px)

// Game-contract values the landing lock reads (truth: games/sonic4/config/
// constants.emp + player_common.emp). The PSTATE_* values sit in cmpi.b imm8
// positions, which cannot read through extern() until the imm-link width
// deferral ships — mirrored + drift-locked. The mirrors are bare ints (no game
// reference); the guard fns COMPTIME-SELECT their expression on the gate — a
// `Game.CAMERA_JUMP_LOCK=false` game returns `true` before the extern() is ever
// evaluated, so it need not define the symbols at all (the false link probe in
// camera_port proves it).
const PSTATE_JUMP     = 8      // airborne curled from jump — release cap active
const PSTATE_ROLLJUMP = 10     // as JUMP + air control lockout
comptime fn pstate_jump_mirror_ok() -> bool {
    if !Game.CAMERA_JUMP_LOCK { return true }
    return extern("PSTATE_JUMP") == PSTATE_JUMP
}
comptime fn pstate_rolljump_mirror_ok() -> bool {
    if !Game.CAMERA_JUMP_LOCK { return true }
    return extern("PSTATE_ROLLJUMP") == PSTATE_ROLLJUMP
}
ensure(pstate_jump_mirror_ok(), "games/sonic4/config/constants.asm and camera.emp disagree on PSTATE_JUMP — update the mirror")
ensure(pstate_rolljump_mirror_ok(), "games/sonic4/config/constants.asm and camera.emp disagree on PSTATE_ROLLJUMP — update the mirror")

// The player-state byte's absolute address (sound_api's extern-equ-sum idiom;
// `_pl_state` is the game-declared SST-custom offset, link-exported by
// games.sonic4.player_common as an `equ`). The equ's RHS is
// COMPTIME-SELECTED on the gate: a `Game.CAMERA_JUMP_LOCK=false` game gets an
// inert 0 — an equ resolves eagerly even when unused, so an unconditional extern
// sum would force `_pl_state` onto games without the lock (the false link probe
// in camera_port proves the property). The locked arm resolves through the link;
// its only reader sits inside the gated block.
comptime fn pl_state_addr() -> int {
    if !Game.CAMERA_JUMP_LOCK { return 0 }
    return extern("Player_1") + extern("_pl_state")
}
equ PL_STATE_ADDR = pl_state_addr()


// -----------------------------------------------
// clamp_camera_axis_reg — the continuous-scroll world clamp, one axis, on a
// VALUE ALREADY IN d0 (16.16):
//   {cam} = max(0, min(d0, max_cell))   where max_cell holds the precomputed
//   (grid_dim << SECTION_SIZE_SHIFT) - screen_dim upper bound.
// Spliced at Camera_Update's .x_clamp and .y_clamp convergence points: the
// apply paths arrive with d0 = cam + step computed in-register (no RAM
// round-trip), the freeze/hold entries load d0 from the cell one instruction
// upstream. The per-act ceiling is precomputed once in Camera_Init (grid dims
// are act constants) and read here as a bare word — the shift chain no longer
// runs per frame.
// In: d0 = 16.16 axis value; the axis' RAM cell (store target); the axis'
// precomputed max-coord word cell.
// Uses d0/d1 ONLY (inside all callers' licenses; d4 = Camera_Update's reserved
// freeze flag must survive the X splice — do not widen). Emits no rts and no
// external branches — control falls through the splice.
//
// The swap/clr.w/move.l store discards the subpixel fraction EVERY frame on
// both axes — load-bearing behavior (replay-A/B-gated); keep it exactly.
//
// MEGA-ACT CEILING: the ceiling is a WORD (subi.w at init, cmp.w here), so an
// axis extent above $FFFF px — grid dim > 31 sections — word-wraps. Guarded
// today by act_descriptor's (GRID_* << SECTION_SIZE_SHIFT) <= $8000 ensures
// (grid dims <= 16, tighter than 31). Floating-origin Phase 4 removes the word
// truncation.
// -----------------------------------------------
comptime fn clamp_camera_axis_reg(cam: Label, max_cell: Label) -> Code {
    return asm {
        swap    d0
        tst.w   d0
        bge     .min_ok
        moveq   #0, d0
    .min_ok:
        move.w  {max_cell}, d1                  // precomputed axis ceiling (px)
        cmp.w   d1, d0
        ble     .clamp
        move.w  d1, d0
    .clamp:
        swap    d0
        clr.w   d0                              // fraction discarded every frame — load-bearing
        move.l  d0, {cam}
    }
}

// clamp_camera_axis — memory-form wrapper: load the cell, then the register
// clamp above. Sole remaining user is Camera_Init's seed clamp (Camera_Update
// splices the reg form directly at its convergence points).
comptime fn clamp_camera_axis(cam: Label, max_cell: Label) -> Code {
    return asm {
        move.l  {cam}, d0
        {clamp_camera_axis_reg(cam, max_cell)}
    }
}

// -----------------------------------------------
// Camera_Init — initialise from act descriptor
// In:  a0 = act descriptor pointer (read only — preserved)
// Out: none
// Clobbers: d0-d1
// -----------------------------------------------
pub proc Camera_Init (a0: *Act) clobbers(d0-d1) {
        // Camera_X/Y are 16.16 fixed-point, WORLD coordinates (continuous-scroll).
        // start X = (start_sec_x << SECTION_SIZE_SHIFT) + start_local_x - CAM_SCREEN_HALF_W
        moveq   #0, d0
        move.b  Act.start_sec_x(a0), d0
        lsl.l   #8, d0                             // sec_x << SECTION_SIZE_SHIFT,
        lsl.l   #SECTION_SIZE_SHIFT-8, d0          // split 8+rest: max shift is 8/op
        add.w   Act.start_local_x(a0), d0          // section world origin (px) + local
        subi.w  #CAM_SCREEN_HALF_W, d0
        swap    d0
        clr.w   d0
        move.l  d0, Camera_X                       // (Camera_X).w

        // start Y = (start_sec_y << SECTION_SIZE_SHIFT) + start_local_y - CAM_SCREEN_HALF_H
        moveq   #0, d0
        move.b  Act.start_sec_y(a0), d0
        lsl.l   #8, d0                             // sec_y << SECTION_SIZE_SHIFT,
        lsl.l   #SECTION_SIZE_SHIFT-8, d0          // split 8+rest: max shift is 8/op
        add.w   Act.start_local_y(a0), d0          // section world origin (px) + local
        subi.w  #CAM_SCREEN_HALF_H, d0
        swap    d0
        clr.w   d0
        move.l  d0, Camera_Y                       // (Camera_Y).w

        move.w  #0, Camera_Pan_Offset              // (Camera_Pan_Offset).w — feature
                                                   // scaffolding awaiting its consumer:
                                                   // the camera-lookahead system
                                                   // (Sec.sec_camera_lookahead is its
                                                   // per-section knob); write-only until
                                                   // that ships — do not cut
        move.w  #CAM_X_DEADZONE_INIT, Camera_Deadzone_Base  // (Camera_Deadzone_Base).w
        clr.b   Camera_Hold_Frames                 // (Camera_Hold_Frames).w — spindash release
                                                   // writes it; Camera_Update consumes it

        // Precompute the per-act clamp ceilings. Grid dims are act constants, so
        // the upper bound (grid_dim << SECTION_SIZE_SHIFT) - screen is fixed for
        // the whole act; compute it once here (re-run on every act's Camera_Init)
        // instead of every frame inside clamp_camera_axis. WORD result — the
        // MEGA-ACT CEILING guard (grid dims <= 16) keeps it under $FFFF.
        moveq   #0, d0
        move.w  Act.grid_w(a0), d0                 // sections wide
        lsl.l   #8, d0                             // << SECTION_SIZE_SHIFT, split 8+rest
        lsl.l   #SECTION_SIZE_SHIFT-8, d0
        subi.w  #SCREEN_WIDTH, d0
        move.w  d0, Camera_X_Max                   // (Camera_X_Max).w
        moveq   #0, d0
        move.w  Act.grid_h(a0), d0                 // sections tall
        lsl.l   #8, d0
        lsl.l   #SECTION_SIZE_SHIFT-8, d0
        subi.w  #SCREEN_HEIGHT, d0
        move.w  d0, Camera_Y_Max                   // (Camera_Y_Max).w

        // Clamp the seed. The start-position math above is unclamped — a start
        // point within half a screen of a world edge seeds Camera_X/Y negative
        // (or past the max), and the OJZ init ladder consumes the raw seed:
        // one bogus-camera frame leaks into cache population before
        // Camera_Update's per-frame clamp first runs. Clamp here so every
        // consumer of the seed sees in-bounds values from frame zero.
        clamp_camera_axis(Camera_X, Camera_X_Max)
        clamp_camera_axis(Camera_Y, Camera_Y_Max)
        rts
}

// -----------------------------------------------
// Camera_Update — follow Player_1 each frame
// In:  none (reads Player_1 SST and Camera_X/Camera_Y)
// Out: none (updates Camera_X and Camera_Y)
// Clobbers: d0-d4, a0   (d4 = spindash-freeze flag, set in the preamble and
//                        consumed at .y_track — see the reservation note there)
// -----------------------------------------------
pub proc Camera_Update () clobbers(d0-d4/a0) {
    if DEBUG == 1 {
        // P2c Task 10: count frames the art soft-clamp held an axis (0 in normal
        // play — the OJZ cache working set == the pool, so no sustained stalls).
        tst.b   Camera_Art_Hold
        beq     .no_clamp_count
        addq.w  #1, Dbg_Cam_Clamp_Frames
    .no_clamp_count:
    }
        // -- spindash launch freeze --
        //    Camera_Hold_Frames is set =16 on spindash release.
        //    While nonzero, hold the camera still (skip BOTH X and Y follow)
        //    so the launch doesn't whip-scroll and the charge-frame backward
        //    creep can't register. Classic "freeze camera 16 frames" (research
        //    feel-modern §3). X is the load-bearing axis (spindash is
        //    horizontal); Y is frozen too because the bounds clamps below still
        //    run. The freeze only suppresses player-follow, not external
        //    position writes (continuous-scroll: there are no section teleport
        //    rebases — the camera tracks the player in world space). Decrement
        //    once per frame.
        // NOTE: d4 is reserved as the freeze flag from here through the
        // X-tracking and X-clamp paths to .y_track — do not reuse d4
        // anywhere between, or the Y freeze silently breaks.
        moveq   #0, d4                              // d4 = "frozen this frame"
        tst.b   Camera_Hold_Frames                  // (Camera_Hold_Frames).w
        beq     .no_freeze
        subq.b  #1, Camera_Hold_Frames
        st      d4                                  // survives to .y_track
        jbra    .x_done                             // X-clamp only; .y_track
                                                    // tests d4 and skips Y follow
    .no_freeze:
        // -- art-streaming soft-clamp, X axis (P2c Task 10) --
        //    A demand-stalled fill that left not-yet-resident art within
        //    CLAMP_MARGIN_TILES of the visible X edge set ART_HOLD_X_BIT. Hold X
        //    (max step 0 = the .x_done no-apply path: clamp the memory value, no
        //    step) so the camera can't outrun the art. Player logic is untouched;
        //    d4 is 0 here, so Y still follows normally unless it is held too. The
        //    fill clears the bit the frame the stall resolves.
        btst    #ART_HOLD_X_BIT, Camera_Art_Hold
        bne     .x_done
        lea     Player_1, a0                        // (Player_1).w

        // -- X tracking: classic S3K fixed deadzone (screen-x 144..160) --
        //    Matches S2/S3K ScrollHoriz: scroll-RIGHT boundary at dead
        //    centre (Sonic centred while advancing), scroll-LEFT boundary
        //    Camera_Deadzone_Base px to its left — an asymmetric 16px window.
        //    Step capped at CAM_MAX_X_STEP px/frame.
        move.l  Sst.x_pos(a0), d0
        swap    d0                                 // d0.w = player engine X
        move.l  Camera_X, d1                       // (Camera_X).w
        swap    d1                                 // d1.w = camera X (screen left edge)
        addi.w  #CAM_SCREEN_HALF_W, d1             // d1 = camera centre X (screen 160)

        move.w  d0, d3
        sub.w   d1, d3                             // d3 = dist = screen_x - 160

        tst.w   d3
        bge     .x_scroll_right                    // dist >= 0 → at/past centre → scroll right
        // left: hold until the player passes the left boundary (-deadzone)
        move.w  Camera_Deadzone_Base, d2           // (Camera_Deadzone_Base).w
        neg.w   d2                                 // d2 = -deadzone (left boundary)
        cmp.w   d2, d3
        bge     .x_done                            // -deadzone <= dist < 0 → hold
        sub.w   d2, d3                             // overshoot = dist + deadzone (<0)
        cmpi.w  #-CAM_MAX_X_STEP, d3               // cap leftward step
        bge     .apply_x
        move.w  #-CAM_MAX_X_STEP, d3
        jbra    .apply_x
    .x_scroll_right:
        cmpi.w  #CAM_MAX_X_STEP, d3                // overshoot = dist; cap rightward step
        ble     .apply_x
        move.w  #CAM_MAX_X_STEP, d3

    .apply_x:
        // d3.w holds the signed clamped step; promote it to a 16.16 Coord (step
        // in the high word, fraction 0) before adding. swap+clr.w discards d3's
        // stale high word and gives step<<16 — identical to the old ext.l/
        // lsl.l#16 for every step incl. negatives (the sign bits ext.l produced
        // fall entirely off the top of the <<16, so both encodings leave exactly
        // the step word in the high word). Single-pass: cam + step is computed
        // in d0 and handed straight to the register clamp at .x_clamp — the
        // clamped result is the ONLY Camera_X store on this path (the old shape
        // add.l-to-memory + reload in the clamp round-tripped through RAM).
        pixels_to_coord(d3)
        move.l  Camera_X, d0                       // (Camera_X).w
        add.l   d3, d0                             // d0 = stepped camera X, in-register
        jbra    .x_clamp

    .x_done:
        // -- continuous-scroll X clamp: [0, level_width − SCREEN_WIDTH] --
        //    level_width = grid_w << SECTION_SIZE_SHIFT. No more Section_Edge_Flags
        //    / PREVIEW_PIXELS branches — the world camera spans the whole act.
        //    ALL X paths converge on .x_clamp — .x_done is the no-apply entry
        //    (branch target for the deadzone hold and the spindash freeze): it
        //    loads the untouched cell so the clamp still runs on the MEMORY
        //    value; .apply_x arrives at .x_clamp with d0 already stepped.
        //    Control continues into .y_track below.
        move.l  Camera_X, d0                       // (Camera_X).w
    .x_clamp:
        clamp_camera_axis_reg(Camera_X, Camera_X_Max)

    .y_track:
        // -- art-streaming soft-clamp, Y axis (P2c Task 10) --
        //    Symmetric with the X hold above: a Y-edge demand stall set
        //    ART_HOLD_Y_BIT -> hold Y (the .clamp_y no-apply path). Independent of
        //    the X hold and the spindash freeze below.
        btst    #ART_HOLD_Y_BIT, Camera_Art_Hold
        bne     .clamp_y
        tst.b   d4                                  // spindash freeze active?
        bne     .clamp_y                            // yes → hold Y, clamp only
        lea     Player_1, a0                        // (Player_1).w

        move.l  Sst.y_pos(a0), d0
        swap    d0                                 // d0.w = player engine Y
        // S3K parity (MoveCameraY `subq #5` on Status_Roll): the curl hook drops
        // y_pos by CURL_Y_SHIFT, so track the STANDING center — otherwise the
        // camera target steps 5px on every curl/uncurl. Engine-generic: a game
        // that never sets ST_ROLLING pays one btst.
        btst    #ST_ROLLING, Sst.status(a0)
        beq     .no_curl_comp
        subq.w  #CURL_Y_SHIFT, d0
    .no_curl_comp:
        move.l  Camera_Y, d1                       // (Camera_Y).w
        swap    d1                                 // d1.w = camera Y pixels
        addi.w  #CAM_SCREEN_HALF_H, d1             // d1 = camera center Y

        moveq   #CAM_Y_DEADZONE, d2                // fixed vertical deadzone

        move.w  d0, d3
        sub.w   d1, d3                             // dist = player_y - camera_center

        neg.w   d2
        cmp.w   d2, d3
        bge     .check_down
        sub.w   d2, d3
        jbra    .apply_y

    .check_down:
        // -- landing lock (game-declared Game.CAMERA_JUMP_LOCK gate) --
        //    While airborne FROM A JUMP (PSTATE_JUMP / PSTATE_ROLLJUMP — the
        //    upward-launched states, classic's jump flag) the camera must NOT
        //    scroll down to chase a rising/hanging player. We reach here only
        //    in the down-scroll case (player below focal point), so the lock
        //    is just: in those states, suppress the down catch-up entirely.
        //    Upward scroll (the branch above) is untouched — following a high
        //    jump up is fine. AIR/AIRBALL (falls, walk-offs, roll-offs) scroll
        //    normally. Lock lifts automatically on landing (state→GROUND/ROLL)
        //    or once the player reaches the bottom screen edge WHILE STILL in
        //    a jump state: there we DO resume so a long fall after the apex
        //    isn't left off-screen. Debug-fly forces PSTATE_AIR (not a jump
        //    state), so it follows as before. (research feel-modern §3; spec §7)
        //    Requires game-defined _pl_state/PSTATE_JUMP/PSTATE_ROLLJUMP; games
        //    without them set Game.CAMERA_JUMP_LOCK=false for plain deadzone follow
        //    (falls straight from .check_down to .down_ok below).
        if Game.CAMERA_JUMP_LOCK {
            move.b  PL_STATE_ADDR, d2                   // (Player_1+_pl_state).w
            cmpi.b  #PSTATE_JUMP, d2
            beq     .jump_state
            cmpi.b  #PSTATE_ROLLJUMP, d2
            bne     .down_ok
        .jump_state:
            // Gate the lock on vertical velocity: only hold while RISING/HANGING —
            // exactly the stated intent ("must NOT scroll down to chase a rising/
            // hanging player"). The jump state persists through the whole arc incl.
            // the descent, so without this the lock froze Y while the player sank to
            // the bottom edge, then alternated 16-px catch-up steps with hold frames
            // (Sonic riding the edge, jittering). Once y_vel goes positive the player
            // is falling: release so the descent follows like a walk-off (32-px
            // deadzone, 16 px/frame) and settles back to the focal point. Short hops
            // still don't scroll (their descent never exceeds the deadzone).
            tst.w   Sst.y_vel(a0)                       // a0 = Player_1 (unclobbered since .y_track) — falling? (y_vel > 0)
            bgt     .down_ok                            // yes → normal deadzone follow
        .land_lock:
            // rising/hanging, below focal point — d3 still holds the raw signed dist
            // (player_y - center). Failsafe: if the player somehow reaches the bottom
            // screen edge (CAM_SCREEN_HALF_H below center) while still rising, resume
            // follow so it isn't left off-screen; otherwise hold Y.
            cmpi.w  #CAM_SCREEN_HALF_H, d3              // at/over bottom screen edge?
            bge     .down_ok                            // → resume follow
            jbra    .clamp_y                            // locked → hold Y
        }
    .down_ok:
        moveq   #CAM_Y_DEADZONE, d2                 // restore +deadzone (d2 clobbered)
        cmp.w   d2, d3
        ble     .clamp_y
        sub.w   d2, d3

    .apply_y:
        cmpi.w  #CAM_MAX_Y_STEP, d3
        ble     .y_step_hi_ok
        move.w  #CAM_MAX_Y_STEP, d3
    .y_step_hi_ok:
        cmpi.w  #-CAM_MAX_Y_STEP, d3
        bge     .y_step_lo_ok
        move.w  #-CAM_MAX_Y_STEP, d3
    .y_step_lo_ok:
        // d3.w = signed clamped step; promote to a 16.16 Coord (see .apply_x).
        // Single-pass like X: cam + step computed in d0, handed to .y_clamp.
        pixels_to_coord(d3)
        move.l  Camera_Y, d0                        // (Camera_Y).w
        add.l   d3, d0                              // d0 = stepped camera Y, in-register
        jbra    .y_clamp

    .clamp_y:
        // -- continuous-scroll Y clamp: [0, level_height − SCREEN_HEIGHT] --
        //    level_height = grid_h << SECTION_SIZE_SHIFT. Grid-derived, fully
        //    symmetric with the X clamp — no act-supplied camera bounds.
        //    .clamp_y is the no-apply entry (spindash freeze, .land_lock,
        //    .down_ok hold): it loads the untouched cell so the clamp still
        //    runs on the MEMORY value; the apply path arrives at .y_clamp with
        //    d0 already stepped. Must keep the .clamp_y label and the trailing
        //    rts.
        move.l  Camera_Y, d0                        // (Camera_Y).w
    .y_clamp:
        clamp_camera_axis_reg(Camera_Y, Camera_Y_Max)
        rts
}
