// Deferred nametable plane buffer (§4.1)
// Producers: Draw_TileColumn / Draw_TileRow_FromCache (game loop)
// Consumer: VInt_DrawLevel (VBlank)

module engine.plane_buffer in plane_buffer

use engine.constants.{TILE_CACHE_COLS, TILE_CACHE_ROWS, TILE_CACHE_STRIDE, TILE_CACHE_NT_SIZE}
use engine.structs.{Act, Sec}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm_reg}

// ---- ENGINE constants not yet in the shared twin (truth: engine/constants.asm,
// except VRAM_PLANE_B_BYTES from engine/level/bg.asm). Mirrored local +
// drift-locked to keep this port byte-isolated; hoist each into the shared
// engine.constants twin when a 2nd .emp file consumes it. (VRAM_PLANE_A /
// VRAM_PLANE_B_BYTES / PLANE_*_CELLS / PLANE_BUFFER_SIZE also mirror section.emp
// — the shared-home trigger fires now that both files port; tracked for
// consolidation.) TILE_CACHE_* come from the shared engine.constants twin. ----
const VRAM_PLANE_A       = $C000        // Plane A nametable VRAM byte address
const VRAM_PLANE_B_BYTES = $E000        // Plane B nametable VRAM byte address
const VDP_DATA           = $C00000      // VDP data port
const VDP_CTRL           = $C00004      // VDP control port
const PLANE_H_CELLS      = 64
const PLANE_V_CELLS      = 64
const PLANE_BUFFER_SIZE  = 1536         // plane-update ring buffer bytes
const VDP_CTRL_OFF       = VDP_CTRL - VDP_DATA   // control port = data port + this (byte-saving a6-relative derive; VInt_DrawLevel). The bare A-B(An) disp misparses as a call (gap-ledger), so this named derive is the house spelling until that grammar lands.
const PLANE_ENTRY_COL_FLAG = $8000      // plane-buffer entry header bit 15: set = column mode (word drain), clear = row mode (longword drain)

// ---- Sec / Act field access comes from the shared engine.structs module
// (`Sec.sec_bg_layout(a0)` / `Act.act_bg_layout(a2)`) — no file-local offset
// mirrors (that class is extinct). ----

// ---- Drift guards — engine/constants.asm (+ bg.asm) are the source of truth;
// each compares this twin's value against the real AS-side equ through the link
// seam. A mismatch fails the link naming the constant. TILE_CACHE_* drift guards
// live centrally in engine.constants. ----
ensure(extern("VRAM_PLANE_A") == VRAM_PLANE_A, "engine/constants.asm and plane_buffer.emp disagree on VRAM_PLANE_A — update the twin")
ensure(extern("VRAM_PLANE_B_BYTES") == VRAM_PLANE_B_BYTES, "engine/level/bg.asm and plane_buffer.emp disagree on VRAM_PLANE_B_BYTES — update the twin")
ensure(extern("VDP_DATA") == VDP_DATA, "engine/constants.asm and plane_buffer.emp disagree on VDP_DATA — update the twin")
ensure(extern("VDP_CTRL") == VDP_CTRL, "engine/constants.asm and plane_buffer.emp disagree on VDP_CTRL — update the twin")
ensure(extern("PLANE_H_CELLS") == PLANE_H_CELLS, "engine/constants.asm and plane_buffer.emp disagree on PLANE_H_CELLS — update the twin")
ensure(extern("PLANE_V_CELLS") == PLANE_V_CELLS, "engine/constants.asm and plane_buffer.emp disagree on PLANE_V_CELLS — update the twin")
ensure(extern("PLANE_BUFFER_SIZE") == PLANE_BUFFER_SIZE, "engine/constants.asm and plane_buffer.emp disagree on PLANE_BUFFER_SIZE — update the twin")

// NOTE: VInt_DrawLevel's two drain heads build the VDP write-command longword
// from a VRAM byte address via engine.vdp's shared `vdp_comm_reg(reg,
// VdpTarget.Vram, VdpOp.Write, clr: false)` — plane_buffer is the 2nd consumer
// of that typed-VDP interface (gap-ledger row 1073, the hoist that let this
// adopt). The AS twin plane_buffer.asm keeps the inline `lsl.l #2 / addq.w #1 /
// ror.w #2 / swap`, byte-identical to the vdp_comm_reg expansion for
// (Vram, Write, clr=false).

// -----------------------------------------------
// Plane_Buffer_Reset — clear the plane buffer (zero the write cursor).
// The reset hook for level/act transitions: an undrained buffer left by a
// pre-transition lag frame must NOT drain its stale (old-level) entries into
// the new level's VRAM. NO CALLER yet — act transitions aren't wired (single-
// level harness), and VInt_DrawLevel does the per-frame post-drain reset inline
// (its .reset). Kept as the forward reset hook (§9 dead-code flag; see the
// stale-drain audit in the tranche-17 packet).
// Clobbers: none
// -----------------------------------------------
@scaffolding("VInt_Lag race fix — forward reset hook for act transitions (unwired: single-level harness)")
pub proc Plane_Buffer_Reset () {
        move.w  #0, Plane_Buffer_Ptr
        rts
}

// -----------------------------------------------
// Draw_TileColumn — append one tile column from 2D cache to Plane_Buffer
// Maps cache rows to correct nametable rows using Cache_Top_Row mod 64.
// Splits into two column entries at the nametable row 63/0 boundary.
// Column entries use word-level data (VInt_DrawLevel drains with move.w).
// In:  d0.w = target VDP nametable column (0–63)
//      d1.w = world tile column
// Out: none (silently drops if buffer full)
// Clobbers: d0–d5, a0–a2 (a1 = row-wrap sentinel through both parts)
// -----------------------------------------------
pub proc Draw_TileColumn (d0: u16, d1: u16) clobbers(d0-d5/a0-a2) {
        // worst case: 2 headers (8 bytes) + 64 data words (128 bytes) = 136
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #8 + PLANE_V_CELLS*2, d2
        cmpi.w  #PLANE_BUFFER_SIZE - 2, d2
        bhi     .done

        cmp.w   Cache_Left_Col, d1
        blt     .done
        cmp.w   Cache_Head_Col, d1
        bgt     .done

        // compute cache source pointer for cache[logical row 0][col]
        // = physical row Cache_Origin_Row (circular)
        move.w  d0, -(sp)                     // save nametable col
        move.w  d1, d0
        sub.w   Cache_Left_Col, d0
        add.w   Cache_Origin_Col, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .col_nowrap
        subi.w  #TILE_CACHE_COLS, d0
    .col_nowrap:
        add.w   d0, d0
        move.w  Cache_Origin_Row, d1
        move.w  d1, d2
        lsl.w   #7, d1                         // × 128
        lsl.w   #5, d2                         // × 32
        add.w   d2, d1                         // origin_row × 160 (stride bytes)
        add.w   d1, d0
        lea     Tile_Cache_Nametable, a0
        adda.w  d0, a0                         // a0 = cache source
        lea     Tile_Cache_Nametable+TILE_CACHE_NT_SIZE, a1   // wrap sentinel
        move.w  (sp)+, d0                      // restore nametable col

        add.w   d0, d0                         // d0 = col byte offset
        move.w  Cache_Top_Row, d3
        andi.w  #63, d3                        // d3 = start_nt_row

        lea     Plane_Buffer, a2
        adda.w  Plane_Buffer_Ptr, a2

        // === Part A: nametable rows start_nt_row to 63 ===
        move.w  d3, d1
        lsl.w   #7, d1                         // start_nt_row × 128
        add.w   d0, d1
        addi.w  #VRAM_PLANE_A & $FFFF, d1
        move.w  d1, (a2)+                      // VRAM addr

        move.w  #64, d5
        sub.w   d3, d5                         // d5 = rows_A
        move.w  d5, d1
        subq.w  #1, d1
        ori.w   #PLANE_ENTRY_COL_FLAG, d1
        move.w  d1, (a2)+                      // word count | column flag

        move.w  d5, d4
        cmpi.w  #TILE_CACHE_ROWS, d4
        ble     .pA_clamp
        move.w  #TILE_CACHE_ROWS, d4
    .pA_clamp:
        move.w  d4, d1
        subq.w  #1, d1
    .pA_data:
        move.w  (a0), (a2)+
        lea     TILE_CACHE_STRIDE*2(a0), a0
        cmpa.l  a1, a0
        blo     .pa_nowrap
        suba.w  #TILE_CACHE_NT_SIZE, a0        // physical row 59 → 0
    .pa_nowrap:
        dbf     d1, .pA_data

        move.w  d5, d1
        sub.w   d4, d1
        beq     .pA_zend
        subq.w  #1, d1
    .pA_zero:
        clr.w   (a2)+
        dbf     d1, .pA_zero
    .pA_zend:

        // === Part B: nametable rows 0 to start_nt_row-1 ===
        tst.w   d3
        beq     .no_pB

        move.w  d0, d1
        addi.w  #VRAM_PLANE_A & $FFFF, d1
        move.w  d1, (a2)+                      // VRAM addr (row 0)

        move.w  d3, d5                         // d5 = rows_B = start_nt_row
        move.w  d5, d1
        subq.w  #1, d1
        ori.w   #PLANE_ENTRY_COL_FLAG, d1
        move.w  d1, (a2)+                      // word count | column flag

        move.w  #TILE_CACHE_ROWS, d1
        sub.w   d4, d1                         // remaining cache = 60 - data_in_A
        ble     .pB_allz

        cmp.w   d5, d1
        ble     .pB_dok
        move.w  d5, d1
    .pB_dok:
        move.w  d1, d4
        subq.w  #1, d1
    .pB_data:
        move.w  (a0), (a2)+
        lea     TILE_CACHE_STRIDE*2(a0), a0
        cmpa.l  a1, a0
        blo     .pb_nowrap
        suba.w  #TILE_CACHE_NT_SIZE, a0        // physical row 59 → 0
    .pb_nowrap:
        dbf     d1, .pB_data

        move.w  d5, d1
        sub.w   d4, d1
        beq     .pB_zend
        subq.w  #1, d1
    .pB_zfill:
        clr.w   (a2)+
        dbf     d1, .pB_zfill
        jbra    .pB_zend

    .pB_allz:
        move.w  d5, d1
        subq.w  #1, d1
    .pB_az:
        clr.w   (a2)+
        dbf     d1, .pB_az
    .pB_zend:
    .no_pB:
        move.w  #0, (a2)
        move.w  #4 + PLANE_V_CELLS*2, d2
        tst.w   d3
        beq     .sz_ok
        addq.w  #4, d2
    .sz_ok:
        add.w   Plane_Buffer_Ptr, d2
        move.w  d2, Plane_Buffer_Ptr
    .done:
        rts
}

// -----------------------------------------------
// Draw_TileRow_FromCache — append one tile row from 2D cache to Plane_Buffer
// In:  d0.w = target VDP nametable row (0–63)
//      d1.w = world tile row
// Out: none (silently drops if buffer full)
// Clobbers: d0–d5, a0–a2
// -----------------------------------------------
pub proc Draw_TileRow_FromCache (d0: u16, d1: u16) clobbers(d0-d5/a0-a2) {
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + PLANE_H_CELLS*2, d2
        cmpi.w  #PLANE_BUFFER_SIZE - 2, d2
        bhi     .done

        cmp.w   Cache_Top_Row, d1
        blt     .done
        cmp.w   Cache_Bottom_Row, d1
        bgt     .done

        lea     Plane_Buffer, a2
        adda.w  Plane_Buffer_Ptr, a2

        // row header (bit 15 clear = row mode)
        lsl.w   #7, d0                         // row × 128 (64 cols × 2 bytes)
        addi.w  #VRAM_PLANE_A & $FFFF, d0
        move.w  d0, (a2)+
        move.w  #PLANE_H_CELLS/2 - 1, (a2)+

        // compute source: cache nametable row base (physical col 0)
        move.w  d1, d0
        sub.w   Cache_Top_Row, d0
        add.w   Cache_Origin_Row, d0           // map to physical row (circular)
        cmpi.w  #TILE_CACHE_ROWS, d0
        blt     .row_nowrap
        subi.w  #TILE_CACHE_ROWS, d0
    .row_nowrap:
        // row × 80 via shift-add
        move.w  d0, d3
        lsl.w   #6, d0
        lsl.w   #4, d3
        add.w   d3, d0
        add.w   d0, d0                         // byte offset (words → bytes)
        lea     Tile_Cache_Nametable, a0
        adda.w  d0, a0                         // a0 = cache row base (physical col 0)

        // -- Source window: the 64 world cols the plane currently holds,
        //    [R-63, R] with R = Section_Right_Col_Written (cache-clamped).
        //    NT col P shows world col W ≡ P (mod 64) — every engine→plane
        //    offset is a multiple of 64 — so the source walks W = A, A+1,
        //    …, R, then wraps to R-63 … A-1, where A = R & ~63. Cols behind
        //    Cache_Left_Col have no cache data; they sit behind the streamed
        //    window (never visible), so the run emits their stale physical-col
        //    word rather than paying a per-cell zero-write (Probe (i)).
        //    The cache spans 80 cols — 16 plane cols have two cached
        //    candidates (W and W+64); anchor R to Section_Right_Col_Written
        //    (cache-clamped to Cache_Head_Col) so the visible-left plane
        //    cols pick the correct twin, not the wrap twin 64 cols ahead.
        move.w  Section_Right_Col_Written, d4
        cmp.w   Cache_Head_Col, d4
        ble     .r_clamp_ok
        move.w  Cache_Head_Col, d4             // R = min(R, Cache_Head_Col)
    .r_clamp_ok:
        // The NT-order walk is two monotonic world-col legs — A..R and
        // R-63..A-1 — and physical col = (W + Origin - Left) mod COLS is affine
        // in W, so each leg is a contiguous cache run split at most once by the
        // cache-right wrap. Emit them as move.w/dbf runs; the < Cache_Left cols
        // fall out as stale reads (never visible), no per-cell zero-write.
        move.w  Cache_Origin_Col, d3
        sub.w   Cache_Left_Col, d3             // d3 = Origin - Left (world→physical)

        move.w  d4, d0
        andi.w  #$FFC0, d0                     // leg-1 start world col A = R & ~63
        move.w  d4, d1
        andi.w  #63, d1
        addq.w  #1, d1                         // d1 = len1 = (R & 63) + 1  (cols A..R)
        move.w  d1, d5                         // stash len1
        jbsr    .emit_row_run                  // leg 1: A..R

        move.w  d4, d0
        subi.w  #63, d0                        // leg-2 start world col R-63
        moveq   #PLANE_H_CELLS, d1
        sub.w   d5, d1                         // d1 = len2 = 64 - len1
        beq     .row_emit_done                 // len1 == 64 → leg 2 empty
        jbsr    .emit_row_run                  // leg 2: R-63..A-1
    .row_emit_done:
        move.w  #0, (a2)
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + PLANE_H_CELLS*2, d2
        move.w  d2, Plane_Buffer_Ptr
    .done:
        rts

    // -- emit d1 (> 0) cache words for the plane-col run starting at world col
    //    d0; physical col = (d0 + d3) mod TILE_CACHE_COLS, contiguous, wrapping
    //    at most once at the cache right edge. a0 = cache row base (phys col 0),
    //    a2 = dst cursor (advanced). Both a1 (src) and a2 (dst) are word-aligned
    //    throughout (cache base + phys*2 even; Plane_Buffer base even + a 132-byte
    //    ptr stride + 4-byte header), so each run drains as move.l pairs + a
    //    move.w odd-word tail. Clobbers d0-d2, a1. --
    .emit_row_run:
        add.w   d3, d0                         // physical col (may be < 0 or ≥ COLS)
        bpl     .err_nonneg
        addi.w  #TILE_CACHE_COLS, d0
        jbra    .err_norm
    .err_nonneg:
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .err_norm
        subi.w  #TILE_CACHE_COLS, d0
    .err_norm:
        move.w  #TILE_CACHE_COLS, d2
        sub.w   d0, d2                         // cells before the cache-right wrap
        add.w   d0, d0                         // physical col → byte offset
        lea     (a0, d0.w), a1
        cmp.w   d1, d2
        bge     .err_single                   // whole run fits before the wrap
        sub.w   d2, d1                         // d1 = cells after the wrap
        move.w  d2, d0                         // save n1 for the odd-word tail
        lsr.w   #1, d2                         // n1 / 2 long copies
        beq     .err_run1_tail                // n1 == 1: tail word only
        subq.w  #1, d2
    .err_run1:
        move.l  (a1)+, (a2)+
        dbf     d2, .err_run1
    .err_run1_tail:
        btst    #0, d0                         // odd run-1: trailing word
        beq     .err_run1_done
        move.w  (a1)+, (a2)+
    .err_run1_done:
        movea.l a0, a1                         // wrap back to physical col 0
    .err_single:
        move.w  d1, d0                         // save run length for the odd-word tail
        lsr.w   #1, d1                         // len / 2 long copies
        beq     .err_run2_tail                // len == 1: tail word only
        subq.w  #1, d1
    .err_run2:
        move.l  (a1)+, (a2)+
        dbf     d1, .err_run2
    .err_run2_tail:
        btst    #0, d0                         // odd run: trailing word
        beq     .err_ret
        move.w  (a1)+, (a2)+
    .err_ret:
        rts
}

// -----------------------------------------------
// Draw_BG_TileColumn — append one tile column strip to Plane_Buffer for plane B (§4.2).
// In:  d0.w = target VDP nametable column (0–63)
//      d1.w = section tile column index (0..63)
//      a0   = section def pointer (uses Sec_sec_bg_layout, Act fallback if NULL)
// Out: none (silently drops if buffer full)
// Clobbers: d0–d3, a1–a2
// Note: plane B is 64×32 tiles. Strip = 32 words; header = $8000 | (32-1) = $801F.
//       Source layout is row-major 64×32 — for col N, words at byte offsets
//       row*128 + N*2 for row=0..31 (stride = 64 cols * 2 B = 128).
// -----------------------------------------------
pub proc Draw_BG_TileColumn (d0: u16, d1: u16, a0: *Sec) clobbers(d0-d3/a1-a2) {
        // -- overflow check (entry size = 4 + 32*2 = 68 bytes) --
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + 32*2, d2
        cmpi.w  #PLANE_BUFFER_SIZE - 2, d2
        bhi     .done

        // -- get source: sec_bg_layout. Fall back to act default if NULL. --
        movea.l Sec.sec_bg_layout(a0), a1
        cmpa.w  #0, a1
        bne     .have_layout
        movea.l Current_Act_Ptr, a2
        movea.l Act.act_bg_layout(a2), a1
        cmpa.w  #0, a1
        beq     .done
    .have_layout:
        // -- a1 = layout base; advance by (col * 2) to point at row 0 of col --
        move.w  d1, d3
        add.w   d3, d3
        adda.w  d3, a1

        // -- write buffer header --
        lea     Plane_Buffer, a2
        adda.w  Plane_Buffer_Ptr, a2
        add.w   d0, d0
        addi.w  #VRAM_PLANE_B_BYTES & $FFFF, d0
        move.w  d0, (a2)+
        move.w  #PLANE_ENTRY_COL_FLAG | (32 - 1), (a2)+   // column write, 32 words - 1

        // -- copy 32 words (one per row), reading column-major (stride = 128) --
        moveq   #32-1, d3
    .copy:
        move.w  (a1), (a2)+
        adda.w  #128, a1
        dbf     d3, .copy

        // -- zero terminator + buffer pointer update --
        move.w  #0, (a2)
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + 32*2, d2
        move.w  d2, Plane_Buffer_Ptr

    .done:
        rts
}

// -----------------------------------------------
// VInt_DrawLevel — drain Plane_Buffer entries to VDP (called from VBlank)
// Each entry: [addr.w][flags_cnt.w][data...]
//   bit 15 clear = row mode: autoinc $02, longword drain (cnt = longwords-1)
//   bit 15 set   = col mode: autoinc $80, word drain    (cnt = words-1)
// addr=0 terminates.
// Called with Z80 already stopped by VInt_Level / VInt_Lag.
// Clobbers: d0–d1, a0, a5–a6
// -----------------------------------------------
pub proc VInt_DrawLevel () clobbers(d0-d1/a0/a5-a6) {
        tst.w   Plane_Buffer_Ptr
        beq     .reset                             // nothing to draw

        lea     Plane_Buffer, a0
        lea     VDP_DATA, a6
        lea     VDP_CTRL_OFF(a6), a5               // a5 = VDP_CTRL (= a6 + VDP_CTRL-VDP_DATA)

    .next:
        moveq   #0, d0
        move.w  (a0)+, d0                          // VRAM addr (0 = end)
        beq     .done
        move.w  (a0)+, d1                          // flags | count
        bmi     .col_entry

        // -- ROW entry: autoincrement $02, longword drain --
        move.w  #$8F02, (a5)
        vdp_comm_reg(d0, VdpTarget.Vram, VdpOp.Write, clr: false)
        move.l  d0, (a5)
    .drain_row:
        move.l  (a0)+, (a6)
        dbf     d1, .drain_row
        jbra    .next

    .col_entry:
        // -- COL entry: autoincrement $80, word drain --
        move.w  #$8F80, (a5)
        andi.w  #$7FFF, d1                         // strip PLANE_ENTRY_COL_FLAG (bit 15) → bare word count
        vdp_comm_reg(d0, VdpTarget.Vram, VdpOp.Write, clr: false)
        move.l  d0, (a5)
    .drain_col:
        move.w  (a0)+, (a6)
        dbf     d1, .drain_col
        jbra    .next

    .done:
        move.w  #$8F02, (a5)

    .reset:
        move.w  #0, Plane_Buffer_Ptr
        rts
}
