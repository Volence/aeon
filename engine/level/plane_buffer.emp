// Deferred nametable plane buffer (§4.1)
// Producers: Draw_TileColumn / Draw_TileRow_FromCache (game loop)
// Consumer: VInt_DrawLevel (VBlank)

module engine.plane_buffer in plane_buffer

use engine.constants.{TILE_CACHE_COLS, TILE_CACHE_ROWS, TILE_CACHE_STRIDE, TILE_CACHE_NT_SIZE, PLANE_H_CELLS, VRAM_PLANE_B_BYTES}
use engine.constants.{VRAM_PLANE_A, PLANE_V_CELLS, PLANE_BUFFER_SIZE, VDP_DATA, VDP_CTRL}
// Canopy-gap capture instrument (DEBUG only) — the visible-viewport extents the C4 test
// measures the row anchor against, and the fire code it reports.
use engine.constants.{SCREEN_LAST_COL_MAX, SCREEN_LAST_ROW_MAX, CANOPY_C4}
use engine.structs.{Act, Sec}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm_reg}
use engine.irq.{vblank}

const VDP_CTRL_OFF       = VDP_CTRL - VDP_DATA   // control port = data port + this (byte-saving a6-relative derive; VInt_DrawLevel). The bare A-B(An) disp misparses as a call (gap-ledger), so this named derive is the house spelling until that grammar lands.
const PLANE_ENTRY_COL_FLAG = $8000      // plane-buffer entry header bit 15: set = column mode (word drain), clear = row mode (longword drain)

// ---- THE PLANE-WRAP FAMILY, pinned across ALL its members (lens-sweep B1-2 / LS-8a) ----
// Same family as engine/level/section.emp's pair, enumerated the same way (by what TOUCHES
// the plane size, not by grepping `#63`): 13 code sites here, 6 horizontal and 7 vertical,
// pinned per axis because both axes are 64 today.
ensure(PLANE_H_CELLS == 64 && PLANE_H_CELLS - 1 == 63 && (~(PLANE_H_CELLS - 1)) & $FFFF == $FFC0 && PLANE_H_CELLS * 2 == 1 << 7,
       "PLANE-WRAP FAMILY, HORIZONTAL AXIS (lens-sweep B1-2 / LS-8a). PLANE_H_CELLS is now {PLANE_H_CELLS}, but engine/level/plane_buffer.emp hand-spells a 64-column plane at 6 sites. Derived: plane col = world col & (PLANE_H_CELLS-1) = & {PLANE_H_CELLS - 1}; the first world col of a plane-aligned run is world col & ~(PLANE_H_CELLS-1) = & {(~(PLANE_H_CELLS - 1)) & $FFFF}; and one nametable ROW is PLANE_H_CELLS*2 = {PLANE_H_CELLS * 2} bytes, the `lsl.w #7` row scale and the $80 column-write autoincrement. THE SITES: Draw_TileColumn: `lsl.w #7` (start_nt_row x 128); Draw_TileRow_FromCache: `lsl.w #7` (row x 128), `andi.w #$FFC0` (leg-1 start A = R & ~63), `andi.w #63` (leg-1 length), `subi.w #63` (leg-2 start R-63); VInt_DrawLevel: `move.w #$8F80` (COL-entry autoincrement). WHAT THIS PIN DOES NOT COVER: this file's 7 vertical sites (the PLANE_V_CELLS pin beside this one); the 20 sites in engine/level/section.emp, pinned there; VDP register $10, pinned in engine/system/boot_data.emp; engine/level/bg.emp's plane-B blit and BG_LAYOUT_SIZE = 64*64*2, NOT pinned; the sites already spelled from PLANE_H_CELLS (the entry-size reservations, `moveq #PLANE_H_CELLS` in Draw_TileRow_FromCache, the Canopy shadow), which follow the constant; and VInt_DrawLevel's odd-word-tail note that a word past row 63 lands at $E000, which is the VRAM layout (VRAM_PLANE_A + the plane's byte size) and not a literal this pin can see")
ensure(PLANE_V_CELLS == 64 && PLANE_V_CELLS - 1 == 63 && PLANE_V_CELLS * 2 == 1 << 7 && PLANE_V_CELLS / 2 - 1 == 32 - 1,
       "PLANE-WRAP FAMILY, VERTICAL AXIS (lens-sweep B1-2 / LS-8a). PLANE_V_CELLS is now {PLANE_V_CELLS}, but engine/level/plane_buffer.emp hand-spells a 64-row plane at 7 sites. Derived: plane row = world row & (PLANE_V_CELLS-1) = & {PLANE_V_CELLS - 1}; a full column is PLANE_V_CELLS = {PLANE_V_CELLS} words, header count PLANE_V_CELLS-1, PLANE_V_CELLS/2 = {PLANE_V_CELLS / 2} longwords, a 4 + PLANE_V_CELLS*2 = {4 + PLANE_V_CELLS * 2}-byte buffer entry; and the BG layout is column-major with PLANE_V_CELLS rows, so its column stride is PLANE_V_CELLS*2 = {PLANE_V_CELLS * 2} bytes (`lsl.w #7`). THE SITES: Draw_TileColumn: `andi.w #63` (Cache_Top_Row to start_nt_row), `move.w #64` (rows_A); Draw_BG_TileColumn: `addi.w #4 + 64*2` (overflow check), `lsl.w #7` (col x 128 into the layout), `PLANE_ENTRY_COL_FLAG | (64 - 1)` (header), `moveq #32-1` (copy count), `addi.w #4 + 64*2` (pointer advance). WHAT THIS PIN DOES NOT COVER: this file's 6 horizontal sites (the PLANE_H_CELLS pin beside this one); the 20 sites in engine/level/section.emp, pinned there; VDP register $10, pinned in engine/system/boot_data.emp; engine/level/bg.emp's BG_LAYOUT_SIZE = 64*64*2, the layout format Draw_BG_TileColumn reads, NOT pinned; and the sites already spelled from PLANE_V_CELLS (Draw_TileColumn's entry-size reservation and pointer advance), which follow the constant")

// ---- Sec / Act field access comes from the shared engine.structs module
// (`Sec.sec_bg_layout(a0)` / `Act.act_bg_layout(a2)`) — no file-local offset
// mirrors (that class is extinct). ----

// NOTE: VInt_DrawLevel's two drain heads build the VDP write-command longword
// from a VRAM byte address via engine.vdp's shared `vdp_comm_reg(reg,
// VdpTarget.Vram, VdpOp.Write, clr: false)` — plane_buffer is the 2nd consumer
// of that typed-VDP interface (gap-ledger row 1073, the hoist that let this
// adopt).

// -----------------------------------------------
// Plane_Buffer_Reset — clear the plane buffer (zero the write cursor).
// The reset hook for level/act transitions: an undrained buffer left by a
// pre-transition lag frame must NOT drain its stale (old-level) entries into
// the new level's VRAM. NO RELEASE CALLER — act transitions aren't wired (single-
// level harness), and VInt_DrawLevel does the per-frame post-drain reset inline
// (its .reset). Kept as the forward reset hook (§9 dead-code flag).
// Its FIRST caller arrived in the DEBUG shape only: the warp mailbox's ladder
// (Debug_Warp_Consume, ARCH §4.12) hits exactly the case the header describes —
// a pre-warp lag frame's undrained entries describe the OLD locality and must
// not reach the destination's VRAM. The @scaffolding annotation stays because it
// is still true of release; drop it the day a real act transition wires this.
// Clobbers: none
// -----------------------------------------------
@scaffolding("VInt_Lag race fix — forward reset hook for act transitions (unwired: single-level harness)")
pub proc Plane_Buffer_Reset () {
        move.w  #0, Plane_Buffer_Ptr
        rts
}

// -----------------------------------------------
// Draw_TileColumn — append one tile column from 2D cache to Plane_Buffer
// Maps cache rows to correct nametable rows using Cache_Top_Row mod 64.
// Splits into two column entries at the nametable row 63/0 boundary.
// Column entries use word-level data (VInt_DrawLevel drains with move.w).
// In:  d0.w = target VDP nametable column (0–63)
//      d1.w = world tile column
// Out: none. TWO KINDS OF DECLINE, and only one of them is correct. A column
//      outside the tile cache's DECLARED window is an EXPECTED drop (the
//      cache-range gate; engine/system/constants.emp's TILE_CACHE_COLS ensure
//      names it). A column dropped because the plane buffer is full is a DEFECT
//      — the caller records it as written, so it is never redrawn. Release
//      still drops it silently; the DEBUG shape now refuses. See .overflow_ok.
// PRECONDITION (caller's, not checked in release): d1 must be a FILLED column,
//      not merely one inside the cache's declared window — i.e. d1 !=
//      Cache_Fill_Resume_Col. Section_UpdateColumns' loops enforce it; the
//      DEBUG assert below is the only thing that says so at runtime. See that
//      proc's header for why the check cannot live here.
// Clobbers: d0–d5, a0–a2 (a1 = zero source for the fill loops; d2 carries
//           rows-before-physical-wrap across both parts for .copy_col_run)
// -----------------------------------------------
pub proc Draw_TileColumn (d0: u16, d1: u16) clobbers(d0-d5/a0-a2) {
        // LS-8 stride pin. The cache source pointer below is built with
        // `mul_const.w d1, #160, d2` — origin_row x the row stride IN BYTES.
        ensure(TILE_CACHE_STRIDE * 2 == 160 && TILE_CACHE_STRIDE == TILE_CACHE_COLS,
               "Draw_TileColumn hand-spells `mul_const.w d1, #160, d2` for the cache row base and the stride is now TILE_CACHE_STRIDE * 2 = {TILE_CACHE_STRIDE * 2} bytes (TILE_CACHE_STRIDE = {TILE_CACHE_STRIDE} = TILE_CACHE_COLS = {TILE_CACHE_COLS}). Derived: the nametable cache holds WORD entries, so the byte stride is twice the column count. WHAT THIS PIN DOES NOT COVER: Draw_TileRow_FromCache in this same file, which spells the same stride as #80 (WORDS, doubled afterwards) and carries its own pin — the two halves of this module disagree on units and fixing one is not fixing the other; the five stride sites in engine/level/tile_cache.emp, engine/level/collision_lookup.emp and engine/level/section.emp; and the `andi.w #63` / `andi.w #$FFC0` plane-ring masks in this file, which are PLANE_H_CELLS and are a separate unpinned family (lens-sweep B1-F2, still OPEN)")
        // worst case: 2 headers (8 bytes) + 64 data words (128 bytes) = 136
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #8 + PLANE_V_CELLS*2, d2
    if DEBUG == 1 {
        // OVERFLOW IS A DEFECT; A COLUMN OUTSIDE THE CACHE WINDOW IS NOT. Three bails
        // below reach the same `.done`, and only one of them is a fault. Dropping a
        // column because the buffer is full leaves a strip of level undrawn AND
        // unredrawable, because the caller records it in Section_Right_Col_Written
        // whether or not this routine wrote anything — the identical argument the
        // Cache_Fill_Resume_Col assert twenty lines down is built on. The other two
        // bails are the cache-range gate, which constants.emp's TILE_CACHE_COLS ensure
        // names as an expected drop; shouting on those would shout on correct frames.
        //
        // WHY THE WINDOW TEST IS REPEATED HERE INSTEAD OF THE RELEASE GUARDS BEING
        // REORDERED. In release the overflow guard runs FIRST, so a column the window
        // gate was going to drop harmlessly takes the overflow bail instead whenever
        // the buffer happens to be full: an assert at the release site would fire on a
        // non-defect. Reordering release fixes that and moves release BYTES — the same
        // instructions in a different order is a different ROM — and this parcel's
        // contract is that release does not move at all. So the DEBUG shape re-asks the
        // window question in the order that makes the answer meaningful and pays for it
        // in the shape that can afford it: zero release bytes, no release reordering.
        //
        // EXPECTED NEVER TO FIRE TODAY, WHICH IS THE POINT — read it as a drift
        // tripwire, not as a measurement. Draw_TileColumn has exactly two call sites
        // (Section_UpdateColumns' .right_loop and .left_loop) and BOTH reserve this
        // proc's worst case before calling, with the exact algebraic complement of the
        // predicate below (`Plane_Buffer_Ptr > SIZE-2-136` stops the loop; here
        // `Plane_Buffer_Ptr+136 > SIZE-2` drops the column). So no caller in the tree
        // can reach the overflow bail, and the release guard is unreachable rather than
        // merely unhit. A green therefore says the two predicates still agree and no
        // unreserved caller has appeared; it says NOTHING about how close the buffer
        // runs to full. That number is a separate measurement — 272 B peak, horizontal
        // motion only — in docs/DEFERRED_WORK.md's plane-buffer-overflow entry.
        cmp.w   Cache_Left_Col, d1
        blt     .overflow_ok                    // out of window: an expected drop, not this defect
        cmp.w   Cache_Head_Col, d1
        bgt     .overflow_ok
        assert.w d2, ls, #PLANE_BUFFER_SIZE - 2 // complement of the `bhi` below — same threshold
    .overflow_ok:
    }
        cmpi.w  #PLANE_BUFFER_SIZE - 2, d2
        bhi     .done

        cmp.w   Cache_Left_Col, d1
        blt     .done
        cmp.w   Cache_Head_Col, d1
        bgt     .done
    if DEBUG == 1 {
        // DECLARED IS NOT FILLED. The two guards above are the cache's DECLARED
        // window, and Tile_Cache_Fill commits that window BEFORE filling the column
        // it just added — so a budget-out or demand stall leaves one column inside it
        // only partly written, named by Cache_Fill_Resume_Col ($FFFF = none). Copying
        // it here puts a ring slot the fill never wrote into plane A, and the caller
        // then RECORDS the column in Section_Right_Col_Written, so nothing ever
        // redraws it — the canopy-gap defect, d-45.
        //
        // The fix is in the CALLER (Section_UpdateColumns' four loops stop at the
        // partial and do not record it), deliberately: a silent decline here would be
        // the same defect wearing a different hat, because the caller advances its
        // tracker whether or not this routine drew anything. So this shape shouts and
        // release pays nothing — it does not quietly paper over a broken caller.
        move.w  Cache_Fill_Resume_Col, d3
        assert.w d1, ne, d3

        // CANOPY SHADOW (engine/ram.emp, "Canopy-gap capture instrument"). Everything
        // below this line WILL be written into plane col d1 & 63, so this is the last
        // point at which the shadow can be recorded truthfully — every bail is above.
        // Two facts about this write are recorded, because the two are what the row
        // writer and the sweep respectively disagree with:
        //   ColW   — the world column whose cache data lands there;
        //   ColTop — the Cache_Top_Row anchor the row mapping below is built from
        //            (`Cache_Top_Row & 63` = start_nt_row, then TILE_CACHE_ROWS of data
        //            and the remainder zero-filled). A column drawn at one anchor and
        //            read at another shows the wrong rows, which no VRAM read can tell
        //            you afterwards because the tileset is deduplicated.
        move.w  d1, d3
        andi.w  #PLANE_H_CELLS-1, d3
        add.w   d3, d3                          // d3 = plane col × 2
        lea     Canopy_ColW, a0
        move.w  d1, (a0, d3.w)
        lea     Canopy_ColTop, a0
        move.w  Cache_Top_Row, d2
        move.w  d2, (a0, d3.w)
        lea     Canopy_ColFrame, a0
        move.w  Frame_Counter, d2
        move.w  d2, (a0, d3.w)
    }

        // compute cache source pointer for cache[logical row 0][col]
        // = physical row Cache_Origin_Row (circular)
        move.w  d0, -(sp)                     // save nametable col
        move.w  d1, d0
        sub.w   Cache_Left_Col, d0
        add.w   Cache_Origin_Col, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .col_nowrap
        subi.w  #TILE_CACHE_COLS, d0
    .col_nowrap:
        add.w   d0, d0
        move.w  Cache_Origin_Row, d1
        mul_const.w d1, #160, d2               // origin_row × 160 stride bytes (d2 = multiply scratch)
        add.w   d1, d0
        lea     Tile_Cache_Nametable, a0
        adda.w  d0, a0                         // a0 = cache source
        move.w  #TILE_CACHE_ROWS, d2
        sub.w   Cache_Origin_Row, d2           // d2 = rows before the physical wrap
        suba.l  a1, a1                         // a1 = 0 (zero source, fill loops)
        move.w  (sp)+, d0                      // restore nametable col

        add.w   d0, d0                         // d0 = col byte offset
        move.w  Cache_Top_Row, d3
        andi.w  #63, d3                        // d3 = start_nt_row

        lea     Plane_Buffer, a2
        adda.w  Plane_Buffer_Ptr, a2

        // === Part A: nametable rows start_nt_row to 63 ===
        move.w  d3, d1
        lsl.w   #7, d1                         // start_nt_row × 128
        add.w   d0, d1
        addi.w  #VRAM_PLANE_A & $FFFF, d1
        move.w  d1, (a2)+                      // VRAM addr

        move.w  #64, d5
        sub.w   d3, d5                         // d5 = rows_A
        move.w  d5, d1
        subq.w  #1, d1
        ori.w   #PLANE_ENTRY_COL_FLAG, d1
        move.w  d1, (a2)+                      // word count | column flag

        move.w  d5, d4
        cmpi.w  #TILE_CACHE_ROWS, d4
        ble     .pA_clamp
        move.w  #TILE_CACHE_ROWS, d4
    .pA_clamp:
        move.w  d4, d1
        jbsr    .copy_col_run

        move.w  d5, d1
        sub.w   d4, d1
        beq     .pA_zend
        subq.w  #1, d1
    .pA_zero:
        move.w  a1, (a2)+
        dbf     d1, .pA_zero
    .pA_zend:

        // === Part B: nametable rows 0 to start_nt_row-1 ===
        tst.w   d3
        beq     .no_pB

        move.w  d0, d1
        addi.w  #VRAM_PLANE_A & $FFFF, d1
        move.w  d1, (a2)+                      // VRAM addr (row 0)

        move.w  d3, d5                         // d5 = rows_B = start_nt_row
        move.w  d5, d1
        subq.w  #1, d1
        ori.w   #PLANE_ENTRY_COL_FLAG, d1
        move.w  d1, (a2)+                      // word count | column flag

        move.w  #TILE_CACHE_ROWS, d1
        sub.w   d4, d1                         // remaining cache = 60 - data_in_A
        ble     .pB_allz

        cmp.w   d5, d1
        ble     .pB_dok
        move.w  d5, d1
    .pB_dok:
        move.w  d1, d4
        jbsr    .copy_col_run

        move.w  d5, d1
        sub.w   d4, d1
        beq     .pB_zend
        subq.w  #1, d1
    .pB_zfill:
        move.w  a1, (a2)+
        dbf     d1, .pB_zfill
        jbra    .pB_zend

    .pB_allz:
        move.w  d5, d1
        subq.w  #1, d1
    .pB_az:
        move.w  a1, (a2)+
        dbf     d1, .pB_az
    .pB_zend:
    .no_pB:
        move.w  #0, (a2)
        move.w  #4 + PLANE_V_CELLS*2, d2
        tst.w   d3
        beq     .sz_ok
        addq.w  #4, d2
    .sz_ok:
        add.w   Plane_Buffer_Ptr, d2
        move.w  d2, Plane_Buffer_Ptr
    .done:
        rts

    // -- copy d1 (> 0) cache rows to (a2)+, source stride TILE_CACHE_STRIDE*2,
    //    wrapping physical row 59 → 0 at most once. d2 = rows before the
    //    physical wrap (≥ 1 on entry, updated for the next call) — the split
    //    point is known from Cache_Origin_Row up front, so each run is a
    //    check-free drain (the per-iteration sentinel compare is gone).
    //    Row count ≤ TILE_CACHE_ROWS, so run 2 never wraps again.
    //    The drain is 4×-unrolled: quads gather through 16-bit source
    //    displacements (cell k at TILE_CACHE_STRIDE*2*k) + ONE lea per four
    //    cells (~19.5 cyc/cell vs 30 for the old per-cell body), remainder
    //    (count & 3) drains through the per-cell body. The live wrap budget
    //    rides d2's upper half across the drain (SWAP-as-free-register, §2.6)
    //    so the helper needs no extra register and the contract is unchanged.
    //    Clobbers d1-d2 (d2.w = updated wrap budget; upper half trashed), a0. --
    .copy_col_run:
        sub.w   d1, d2
        bgt     .ccr_drain                     // whole run before the wrap — tail-drain d1 cells
        add.w   d2, d1                         // d1 = rows up to the wrap (≥ 1)
        jbsr    .ccr_drain                     // run 1 (d2.w rides the drain's swap stash)
        suba.w  #TILE_CACHE_NT_SIZE, a0        // physical row 59 → 0
        move.w  d2, d1
        neg.w   d1                             // d1 = rows after the wrap
        move.w  #TILE_CACHE_ROWS, d2
        sub.w   d1, d2                         // fresh wrap budget minus run 2
        tst.w   d1
        beq     .ccr_ret                       // the wrap landed at run end
        // fall through: run 2 tail-drains the post-wrap rows
    .ccr_drain:
        swap    d2                             // stash the live wrap budget (§2.6)
        move.w  d1, d2
        andi.w  #3, d2                         // d2 = remainder cells (0-3)
        lsr.w   #2, d1                         // d1 = quad count
        beq     .ccr_rem_entry                 // 1-3 cells: remainder only
        subq.w  #1, d1
    .ccr_quad:
        move.w  (a0), (a2)+
        move.w  TILE_CACHE_STRIDE*2(a0), (a2)+
        move.w  TILE_CACHE_STRIDE*4(a0), (a2)+
        move.w  TILE_CACHE_STRIDE*6(a0), (a2)+
        lea     TILE_CACHE_STRIDE*8(a0), a0
        dbf     d1, .ccr_quad
    .ccr_rem_entry:
        move.w  d2, d1
        beq     .ccr_drained
        subq.w  #1, d1
    .ccr_rem:
        move.w  (a0), (a2)+
        lea     TILE_CACHE_STRIDE*2(a0), a0
        dbf     d1, .ccr_rem
    .ccr_drained:
        swap    d2                             // restore the wrap budget
    .ccr_ret:
        rts
}

// -----------------------------------------------
// Draw_TileRow_FromCache — append one tile row from 2D cache to Plane_Buffer
// In:  d0.w = target VDP nametable row (0–63)
//      d1.w = world tile row
// Out: none (silently drops if buffer full)
// PRECONDITION (caller's, not checked in release): d1 must be a FILLED row —
//      d1 != Cache_Fill_RowResume_Row. Same ruling and same reason as
//      Draw_TileColumn's; Section_UpdateColumns' .bot_loop/.top_loop enforce it.
// Clobbers: d0–d5, a0–a2
// -----------------------------------------------
pub proc Draw_TileRow_FromCache (d0: u16, d1: u16) clobbers(d0-d5/a0-a2) {
        // LS-8 stride pin. The cache row base below is `mul_const.w d0, #80, d3`
        // — row x the stride in WORDS, doubled to bytes by the `add.w d0, d0` that
        // follows. Same stride as Draw_TileColumn above, spelled in the other unit.
        ensure(TILE_CACHE_STRIDE == 80 && TILE_CACHE_STRIDE == TILE_CACHE_COLS,
               "Draw_TileRow_FromCache hand-spells `mul_const.w d0, #80, d3` for the cache row base and the stride is now TILE_CACHE_STRIDE = {TILE_CACHE_STRIDE} (= TILE_CACHE_COLS = {TILE_CACHE_COLS}). Derived: this site works in nametable ENTRIES and the `add.w d0, d0` two lines below converts to bytes, so the immediate is the column count itself and NOT the {TILE_CACHE_STRIDE * 2} its sibling Draw_TileColumn spells. WHAT THIS PIN DOES NOT COVER: Draw_TileColumn in this same file, pinned separately in byte units; the five stride sites in engine/level/tile_cache.emp, engine/level/collision_lookup.emp and engine/level/section.emp; and the `andi.w #63` / `andi.w #$FFC0` plane-ring masks in this file (lens-sweep B1-F2, still OPEN)")
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + PLANE_H_CELLS*2, d2
        cmpi.w  #PLANE_BUFFER_SIZE - 2, d2
        bhi     .done

        cmp.w   Cache_Top_Row, d1
        blt     .done
        cmp.w   Cache_Bottom_Row, d1
        bgt     .done
    if DEBUG == 1 {
        // The row axis carries the IDENTICAL exposure, by the identical mechanism:
        // .v_bottom_fill / .v_top_fill commit Cache_Bottom_Row / Cache_Top_Row before
        // calling TileCache_FillRow, whose partial leaves that row unwritten from
        // Cache_Fill_RowResume_Col rightward. Same ruling as Draw_TileColumn above —
        // the caller refuses to ask, this shape shouts if it ever does.
        move.w  Cache_Fill_RowResume_Row, d3
        assert.w d1, ne, d3

        // CANOPY SHADOW, part 1 of 2 (engine/ram.emp, "Canopy-gap capture instrument").
        // The identity of the row about to be written is known HERE; the anchor it will
        // be written WITH is not derived until .r_clamp_ok below, so the shadow write
        // and the C4 test both live down there and this stashes what they will need.
        // A RAM stash rather than a spare register on purpose: a DEBUG probe that quietly
        // reserves a register across sixty lines of release code is a trap for whoever
        // edits between the two halves.
        move.w  d0, d3
        add.w   d3, d3
        move.w  d3, Canopy_Tmp_Idx              // plane row × 2
        move.w  d1, Canopy_Tmp_V                // world row
    }

        lea     Plane_Buffer, a2
        adda.w  Plane_Buffer_Ptr, a2

        // row header (bit 15 clear = row mode)
        lsl.w   #7, d0                         // row × 128 (64 cols × 2 bytes)
        addi.w  #VRAM_PLANE_A & $FFFF, d0
        move.w  d0, (a2)+
        move.w  #PLANE_H_CELLS/2 - 1, (a2)+

        // compute source: cache nametable row base (physical col 0)
        move.w  d1, d0
        sub.w   Cache_Top_Row, d0
        add.w   Cache_Origin_Row, d0           // map to physical row (circular)
        cmpi.w  #TILE_CACHE_ROWS, d0
        blt     .row_nowrap
        subi.w  #TILE_CACHE_ROWS, d0
    .row_nowrap:
        mul_const.w d0, #80, d3               // row × 80 stride (d3 = multiply scratch)
        add.w   d0, d0                         // byte offset (words → bytes)
        lea     Tile_Cache_Nametable, a0
        adda.w  d0, a0                         // a0 = cache row base (physical col 0)

        // -- Source window: the 64 world cols the plane currently holds,
        //    [R-63, R] with R = Section_Right_Col_Written (cache-clamped).
        //    NT col P shows world col W ≡ P (mod 64) — every engine→plane
        //    offset is a multiple of 64 — so the source walks W = A, A+1,
        //    …, R, then wraps to R-63 … A-1, where A = R & ~63. Cols behind
        //    Cache_Left_Col have no cache data; they sit behind the streamed
        //    window (never visible), so the run emits their stale physical-col
        //    word rather than paying a per-cell zero-write (Probe (i)).
        //    The cache spans 80 cols — 16 plane cols have two cached
        //    candidates (W and W+64); anchor R to Section_Right_Col_Written
        //    (cache-clamped to Cache_Head_Col) so the visible-left plane
        //    cols pick the correct twin, not the wrap twin 64 cols ahead.
        move.w  Section_Right_Col_Written, d4
        cmp.w   Cache_Head_Col, d4
        ble     .r_clamp_ok
        move.w  Cache_Head_Col, d4             // R = min(R, Cache_Head_Col)
    .r_clamp_ok:
    if DEBUG == 1 {
        // CANOPY SHADOW, part 2 of 2, and the C4 test. d4 is the anchor R this write is
        // about to impose on ALL 64 plane columns of this row: plane col P gets the one
        // world col congruent to P mod 64 that lies in [R-63, R]. Record it — no read of
        // VRAM afterwards can recover it, because the act tileset is deduplicated and the
        // same tile word legitimately belongs to many world columns.
        move.w  Canopy_Tmp_Idx, d3
        lea     Canopy_RowR, a1
        move.w  d4, (a1, d3.w)
        lea     Canopy_RowFrame, a1
        move.w  Frame_Counter, d2
        move.w  d2, (a1, d3.w)

        // C4 — the (a) candidate, tested AT ITS SOURCE rather than by the sweep's
        // after-the-fact scan, because here the anchor and the camera are the pair that
        // actually met. This write is about to impose [R-63, R] on every plane column;
        // the screen needs [camCol, camCol+SCREEN_LAST_COL_MAX]. If R falls short of the
        // screen's right edge, the leading visible columns get the twin 64 columns BACK.
        // If R runs more than 63 past camCol, the trailing ones get the twin 64 columns
        // AHEAD. Either way this one write leaves ~40 of the row's 41 visible cells
        // sourced from 512 px away, and only a later column write repairs them one column
        // at a time. Restricted to rows that are on screen: .top_loop legitimately draws
        // rows above the camera, and those are not a sighting.
        move.w  Canopy_Tmp_V, d0
        move.l  Camera_Y, d1
        swap    d1
        lsr.w   #3, d1                         // d1 = camRow
        cmp.w   d1, d0
        blt     .canopy_c4_done                // row above the screen
        addi.w  #SCREEN_LAST_ROW_MAX, d1
        cmp.w   d1, d0
        bgt     .canopy_c4_done                // row below the screen
        move.l  Camera_X, d1
        swap    d1
        lsr.w   #3, d1                         // d1 = camCol
        move.w  d1, d2
        addi.w  #SCREEN_LAST_COL_MAX, d2       // d2 = rightmost visible world col
        cmp.w   d2, d4
        blt     .canopy_c4_bad
        addi.w  #PLANE_H_CELLS-1, d1           // d1 = camCol + 63
        cmp.w   d1, d4
        ble     .canopy_c4_done
    .canopy_c4_bad:
        move.w  d4, d3                         // got   = the anchor R
        move.w  d0, d2                         // want  = the world row being written
        move.w  Canopy_Tmp_Idx, d1
        lsr.w   #1, d1                         // idx   = plane row
        moveq   #CANOPY_C4, d0
        // Canopy_Fire restores every register from its own movem, but d4 (the anchor the
        // release code below still needs) is spilled here anyway: the contract-closure
        // analysis reads liveness across the call and does not model a callee's movem, so
        // without this it reports d4 live-clobbered — correctly, on the evidence it has.
        // Two instructions on a path that never runs in a correct frame, in exchange for
        // the call site stating its own contract instead of relying on a distant one.
        move.w  d4, -(sp)
        jbsr    Canopy_Fire
        move.w  (sp)+, d4
    .canopy_c4_done:
    }
        // The NT-order walk is two monotonic world-col legs — A..R and
        // R-63..A-1 — and physical col = (W + Origin - Left) mod COLS is affine
        // in W, so each leg is a contiguous cache run split at most once by the
        // cache-right wrap. Emit them as move.w/dbf runs; the < Cache_Left cols
        // fall out as stale reads (never visible), no per-cell zero-write.
        move.w  Cache_Origin_Col, d3
        sub.w   Cache_Left_Col, d3             // d3 = Origin - Left (world→physical)

        move.w  d4, d0
        andi.w  #$FFC0, d0                     // leg-1 start world col A = R & ~63
        move.w  d4, d1
        andi.w  #63, d1
        addq.w  #1, d1                         // d1 = len1 = (R & 63) + 1  (cols A..R)
        move.w  d1, d5                         // stash len1
        jbsr    .emit_row_run                  // leg 1: A..R

        move.w  d4, d0
        subi.w  #63, d0                        // leg-2 start world col R-63
        moveq   #PLANE_H_CELLS, d1
        sub.w   d5, d1                         // d1 = len2 = 64 - len1
        beq     .row_emit_done                 // len1 == 64 → leg 2 empty
        jbsr    .emit_row_run                  // leg 2: R-63..A-1
    .row_emit_done:
        move.w  #0, (a2)
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + PLANE_H_CELLS*2, d2
        move.w  d2, Plane_Buffer_Ptr
    .done:
        rts

    // -- emit d1 (> 0) cache words for the plane-col run starting at world col
    //    d0; physical col = (d0 + d3) mod TILE_CACHE_COLS, contiguous, wrapping
    //    at most once at the cache right edge. a0 = cache row base (phys col 0),
    //    a2 = dst cursor (advanced). Both a1 (src) and a2 (dst) are word-aligned
    //    throughout (cache base + phys*2 even; Plane_Buffer base even + a 132-byte
    //    ptr stride + 4-byte header), so each run drains as move.l pairs + a
    //    move.w odd-word tail. Clobbers d0-d2, a1. --
    .emit_row_run:
        add.w   d3, d0                         // physical col (may be < 0 or ≥ COLS)
        bpl     .err_nonneg
        addi.w  #TILE_CACHE_COLS, d0
        jbra    .err_norm
    .err_nonneg:
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .err_norm
        subi.w  #TILE_CACHE_COLS, d0
    .err_norm:
        move.w  #TILE_CACHE_COLS, d2
        sub.w   d0, d2                         // cells before the cache-right wrap
        add.w   d0, d0                         // physical col → byte offset
        lea     (a0, d0.w), a1
        cmp.w   d1, d2
        bge     .err_single                   // whole run fits before the wrap
        sub.w   d2, d1                         // d1 = cells after the wrap
        move.w  d2, d0                         // save n1 for the odd-word tail
        lsr.w   #1, d2                         // n1 / 2 long copies
        beq     .err_run1_tail                // n1 == 1: tail word only
        subq.w  #1, d2
    .err_run1:
        move.l  (a1)+, (a2)+
        dbf     d2, .err_run1
    .err_run1_tail:
        btst    #0, d0                         // odd run-1: trailing word
        beq     .err_run1_done
        move.w  (a1)+, (a2)+
    .err_run1_done:
        movea.l a0, a1                         // wrap back to physical col 0
    .err_single:
        move.w  d1, d0                         // save run length for the odd-word tail
        lsr.w   #1, d1                         // len / 2 long copies
        beq     .err_run2_tail                // len == 1: tail word only
        subq.w  #1, d1
    .err_run2:
        move.l  (a1)+, (a2)+
        dbf     d1, .err_run2
    .err_run2_tail:
        btst    #0, d0                         // odd run: trailing word
        beq     .err_ret
        move.w  (a1)+, (a2)+
    .err_ret:
        rts
}

// -----------------------------------------------
// Draw_BG_TileColumn — append one tile column strip to Plane_Buffer for plane B (§4.2).
// In:  d0.w = target VDP nametable column (0–63)
//      d1.w = section tile column index (0..63)
//      a0   = section def pointer (uses Sec_sec_bg_layout, Act fallback if NULL)
// Out: none (silently drops if buffer full)
// Clobbers: d0–d3, a1–a2
// Note: plane B is 64×64 tiles; the strip covers ALL 64 rows (NEW-5,
//       2026-08-05 — 32-row strips silently half-reverted BG art above row 31).
//       Strip = 64 words; header = $8000 | (64-1) = $803F. Source layout is
//       COLUMN-MAJOR 64×64 — col N's 64 row words are contiguous at byte offset
//       N*128, so the gather is a sequential move.l run, not a strided read.
//       ZERO CALLERS TODAY (2026-06-23 audit) — widened so it is correct when
//       the deferred per-section-BG-swap work wires it.
// -----------------------------------------------
pub proc Draw_BG_TileColumn (d0: u16, d1: u16, a0: *Sec) clobbers(d0-d3/a1-a2) {
        // -- overflow check (entry size = 4 + 64*2 = 132 bytes) --
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + 64*2, d2
        cmpi.w  #PLANE_BUFFER_SIZE - 2, d2
        bhi     .done

        // -- get source: sec_bg_layout. Fall back to act default if NULL. --
        movea.l Sec.sec_bg_layout(a0), a1
        cmpa.w  #0, a1
        bne     .have_layout
        movea.l Current_Act_Ptr, a2
        movea.l Act.act_bg_layout(a2), a1
        cmpa.w  #0, a1
        beq     .done
    .have_layout:
        // -- a1 = layout base; advance by (col * 128) to the top of the column --
        //    (column-major: the column's 64 rows are contiguous from here) --
        move.w  d1, d3
        lsl.w   #7, d3                          // col * 128 (column stride)
        adda.w  d3, a1

        // -- write buffer header --
        lea     Plane_Buffer, a2
        adda.w  Plane_Buffer_Ptr, a2
        add.w   d0, d0
        addi.w  #VRAM_PLANE_B_BYTES & $FFFF, d0
        move.w  d0, (a2)+
        move.w  #PLANE_ENTRY_COL_FLAG | (64 - 1), (a2)+   // column write, 64 words - 1

        // -- copy 64 words (rows 0..63), column-contiguous, paired as move.l:
        //    32 longwords = 64 words. Source and dest are word-even (even layout
        //    base + 128-byte column stride; even buffer) — all move.l needs. --
        moveq   #32-1, d3
    .copy:
        move.l  (a1)+, (a2)+
        dbf     d3, .copy

        // -- zero terminator + buffer pointer update --
        move.w  #0, (a2)
        move.w  Plane_Buffer_Ptr, d2
        addi.w  #4 + 64*2, d2
        move.w  d2, Plane_Buffer_Ptr

    .done:
        rts
}

// -----------------------------------------------
// VInt_DrawLevel — drain Plane_Buffer entries to VDP (called from VBlank)
// Each entry: [addr.w][flags_cnt.w][data...]
//   bit 15 clear = row mode: autoinc $02, longword drain (cnt = longwords-1)
//   bit 15 set   = col mode: autoinc $80, word drain    (cnt = words-1)
// addr=0 terminates.
// Called with Z80 already stopped by VInt_Level / VInt_Lag.
// Clobbers: d0–d1, a0, a5–a6
// -----------------------------------------------
pub proc VInt_DrawLevel () clobbers(d0-d1/a0/a5-a6) requires(vblank) {
        // a5=VDP_CTRL is set up BEFORE the empty-buffer test so both exits honor the
        // reg $0F=$02 (default autoincrement) postcondition: a column entry leaves
        // reg $0F=$80, and a caller (or a prior VBlank step) may leave it non-$02,
        // so the empty path must restore it too — not just the drain path's .done.
        // The postcondition is engine-wide: every $8F80 writer restores $8F02
        // before yielding. Here it is LOAD-BEARING, not belt-and-braces, and the
        // blanket Flush_VDP_Shadow does not cover it: the flush runs at the TOP of
        // the VBlank handler, upstream of this proc, and Process_DMA_Critical runs
        // downstream of it — so between them the only thing that can put reg $0F
        // back after a column entry's $8F80 excursion is the .done restore below.
        // (VInt_Lag's matching re-assert was deleted 2026-08-14: that path skips
        // this proc entirely, so no COLUMN EXCURSION perturbs $0F between its
        // flush and its drain. Different position, different verdict.
        // NARROWED 2026-09-07, lens item LS-19: this used to read "nothing
        // perturbs $0F", which overstated it. Enqueue_Dirty_Buffers runs between
        // that flush and that drain and DOES write VDP_CTRL directly — its
        // `.ship_reg` loop, buffers.emp:458. What makes the deletion safe is that
        // reg $0F is refused tree-wide in the raster DSL, so nothing `.ship_reg`
        // can re-issue is a stride change. The full derivation, and the condition
        // under which the re-assert must come back, is written at the deletion
        // site in vblank.emp — read it before quoting this parenthesis.)
        //
        // The COL entries below take an autoincrement excursion ($8F80 direct
        // to VDP_CTRL, restored to $8F02 at .done) that bypasses the VDP shadow,
        // and Flush_VDP_Shadow re-blits reg $0F from that shadow every VBlank.
        // Unlike the bg.emp / section.emp excursions this one is not masked by
        // hand — it runs inside the VBlank handler, where the 68000 has already
        // set IPL 6 on IRQ entry and nothing here lowers it. That is what keeps
        // the excursion atomic against the flush; assert it rather than leave it
        // resting on where the routine happens to be called from.
        if DEBUG == 1 {
            move.w  sr, d0
            andi.w  #$0700, d0
            assert.w d0, hs, #$0600     // IPL >= 6: VBlank context, no re-entry
        }
        lea     VDP_DATA, a6
        lea     VDP_CTRL_OFF(a6), a5               // a5 = VDP_CTRL (= a6 + VDP_CTRL-VDP_DATA)
        tst.w   Plane_Buffer_Ptr
        beq     .done                              // nothing to draw — still restore autoinc

        lea     Plane_Buffer, a0

    .next:
        moveq   #0, d0
        move.w  (a0)+, d0                          // VRAM addr (0 = end)
        beq     .done
        move.w  (a0)+, d1                          // flags | count
        bmi     .col_entry

        // -- ROW entry: autoincrement $02, longword drain --
        move.w  #$8F02, (a5)
        vdp_comm_reg(d0, VdpTarget.Vram, VdpOp.Write, clr: false)
        move.l  d0, (a5)
    .drain_row:
        move.l  (a0)+, (a6)
        dbf     d1, .drain_row
        jbra    .next

    .col_entry:
        // -- COL entry: autoincrement $80, longword drain (one move.l = two
        //    word writes, each autoincremented $80) + an EXACT odd-word tail —
        //    an extra word past row 63 would land at $E000 (Plane B). a0 is
        //    word-aligned (even buffer base, 4-byte headers, word data), which
        //    is all move.l needs. --
        move.w  #$8F80, (a5)
        andi.w  #$7FFF, d1                         // strip PLANE_ENTRY_COL_FLAG (bit 15) → count-1
        vdp_comm_reg(d0, VdpTarget.Vram, VdpOp.Write, clr: false)
        move.l  d0, (a5)
        addq.w  #1, d1                             // bare word count
        move.w  d1, d0                             // save for the odd tail (command already written)
        lsr.w   #1, d1                             // longword pairs
        beq     .dc_tail                           // single-word entry
        subq.w  #1, d1
    .drain_col:
        move.l  (a0)+, (a6)
        dbf     d1, .drain_col
    .dc_tail:
        btst    #0, d0
        beq     .next
        move.w  (a0)+, (a6)
        jbra    .next

    .done:
        // Both exits land here: the drain terminator and the empty-buffer test
        // above. Restore reg $0F=$02 (a column entry may have left $80), then clear
        // the buffer pointer.
        move.w  #$8F02, (a5)
        move.w  #0, Plane_Buffer_Ptr
        rts
}
