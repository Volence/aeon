// engine/level/parallax_dsl.emp — the §4.6 parallax authoring vocabulary.
//
// The generic, game-agnostic half of the old `engine/parallax_macros.inc`:
// the factor encoding + the deformation-table generators. A game's config
// module (e.g. games.sonic4.parallax_configs) builds `parallax_config` /
// `band_entry` records on top of these, choosing per-band factors from the
// FACTOR_* set and pointing at tables these generators emit.
//
// Pure comptime — this module emits no ROM bytes; it is glob-imported into
// every module (the native comptime-helper set).
module engine.level.parallax_dsl

// ---- factor encoding (24-bit packed scroll factor) ----
// A factor is a fraction p/q (q a power of two) expressed as <=2 shift-add
// terms, packed so the runtime can reconstruct camX*p/q from two shifts:
//   bits 0-3: shift1 (0..14; 15 = "term zero" -> factor 0 / locked layer)
//   bits 4-7: shift2 (0..14; 15 = "single-term factor")
//   bit  8:   op     (0 = ADD the second term, 1 = SUB)
// `band` (games' config module) splits a FACTOR_* value back into the three
// band_entry bytes; this keeps the encoding in one place.
pub comptime fn packed(s1: int, s2: int, op: int) -> int {
    return ((op & 1) << 8) | ((s2 & 15) << 4) | (s1 & 15)
}

pub const FACTOR_LOCKED = $0FF                   // s1=15 -> factor 0 ("locked layer")
pub const FACTOR_0      = FACTOR_LOCKED          // alias
pub const FACTOR_1      = packed(s1: 0, s2: 15, op: 0)   // camX
pub const FACTOR_1_2    = packed(s1: 1, s2: 15, op: 0)   // camX>>1
pub const FACTOR_1_4    = packed(s1: 2, s2: 15, op: 0)   // camX>>2
pub const FACTOR_1_8    = packed(s1: 3, s2: 15, op: 0)   // camX>>3
pub const FACTOR_1_16   = packed(s1: 4, s2: 15, op: 0)   // camX>>4
pub const FACTOR_1_32   = packed(s1: 5, s2: 15, op: 0)   // camX>>5
pub const FACTOR_3_4    = packed(s1: 0, s2: 2, op: 1)    // camX - camX>>2
pub const FACTOR_3_8    = packed(s1: 2, s2: 3, op: 0)    // camX>>2 + camX>>3
pub const FACTOR_3_16   = packed(s1: 3, s2: 4, op: 0)    // camX>>3 + camX>>4
pub const FACTOR_5_8    = packed(s1: 1, s2: 3, op: 0)    // camX>>1 + camX>>3
pub const FACTOR_5_16   = packed(s1: 2, s2: 4, op: 0)    // camX>>2 + camX>>4
pub const FACTOR_7_8    = packed(s1: 0, s2: 3, op: 1)    // camX - camX>>3
pub const FACTOR_7_16   = packed(s1: 1, s2: 4, op: 1)    // camX>>1 - camX>>4
pub const FACTOR_15_16  = packed(s1: 0, s2: 4, op: 1)    // camX - camX>>4

// ---- deformation-table generators (§4.6 T3) ----
// Each emits exactly 256 signed bytes, sampled at (frame*speed + line + phase)
// & $FF. `as.sin`/`as.int` reproduce asl 1.42's float routines bit-for-bit
// (Core §7.1), so the sine tables are byte-identical to the AS `rept 256`
// expansion, golden-gated (float_ns.rs) on the four shipping amplitudes.

pub const TAU = 6.283185307179586

// deform_sine — signed sine wave. amplitude 1..127; period must divide 256.
pub comptime fn deform_sine(amplitude: int, period: int) -> [i8; 256] {
    ensure(256 % period == 0, "deform_sine: period {period} must divide 256")
    return comptime for i in 0..256 { as.int(amplitude * as.sin(TAU * i / period)) }
}

// deform_zero — the all-zero table. A NON-NULL pointer to this forces the
// per-line HScroll pipeline (mode 3, pixel-clean band boundaries) while the
// per-band deform-shift sentinel (15) skips the pointless (0 >> shift) sample
// loop — the emitted HScroll is byte-identical, produced without the math.
pub comptime fn deform_zero() -> [i8; 256] {
    return comptime for i in 0..256 { 0 }
}

comptime fn iabs(x: int) -> int {
    return if x < 0 { 0 - x } else { x }
}

// ===================================================================================
// ---- HOW BIG THE WAVE ACTUALLY IS, IN PIXELS. The magnitude half of design §9.1
// ---- precondition 1, added 2026-09-03 after the row remap shipped LIVE AND INVISIBLE.
//
// WHAT WENT WRONG, AND IT WAS NOT WHERE THE BAND SAT. `scene()`'s remap guard asks
// "does this scene's plane-B scroll vary AT ALL?" — a BOOLEAN — and Scene_OJZ_Underwater
// answered yes truthfully: its anchor carried `dsb: 2` against DeformTable_Shimmer, and
// the overlay writes that shift into every band from the split down, which is exactly the
// band the remap marks. Measured on s4.debug.bin at master 3d00e2c6: the band's own lines
// really do vary, tools/row_remap_witness.py separates them from the flat prediction on
// 12 of 12 samples, and the whole excursion is FOUR PIXELS peak to peak. The owner looked
// at it and reported "I think I see a singular 2 pixel line".
//
// So the question that decides whether an effect is on screen is not "does it vary" but
// "does it vary ENOUGH", and that is a MAGNITUDE the boolean cannot express. These two
// functions are that magnitude, computed from the table the scene actually attaches and
// the shift that actually reaches the band.
//
// WHY IT LIVES HERE AND NOT IN `scene()`. `SceneDeform.Shared(Label, int)` carries a
// LABEL, and a `pub data` label's bytes are not readable at comptime (that is the same
// constraint that forced the `SceneSrc_*` consts to exist at all — see the banner in
// games/sonic4/data/effects/ojz_scenes.emp). So the guard inside `scene()` structurally
// CANNOT see an amplitude, and no dsb-only bound substitutes for one: `dsb: 2` against
// DeformTable_Shimmer (amplitude 8) is 4 px and invisible, while the same `dsb: 2`
// against DeformTable_OJZ_Calm (amplitude 96) is 48 px and unmissable. A guard written on
// the shift alone would refuse a correct scene and pass a dead one. The check therefore
// belongs where the array VALUE has a name — beside the scene — and it is mirrored on the
// linked image by tools/row_remap_gate.py, which reads the emitted table and the emitted
// pcfg_anchor_dsb and needs no comptime name at all.

// deform_asr — one table sample under the engine's own `asr.w`, i.e. FLOOR division by
// 2^n, and it is written to be correct whichever way comptime `/` rounds. If `/` already
// floors, `r` is never negative for a positive divisor and the correction never fires; if
// it truncates toward zero, the correction is what turns -1/4 = 0 back into -1. Getting
// this wrong understates the excursion on the negative half of every sine table, which
// would make the guard below quietly permissive — the one direction a guard must not fail.
comptime fn deform_asr(v: int, n: int) -> int {
    let d = 1 << n
    let q = v / d
    let r = v - q * d
    return if r < 0 { q - 1 } else { q }
}

// deform_excursion — the peak-to-peak horizontal travel, IN PIXELS, that a band takes from
// this table at this deform shift. This is exactly the number a bus read of Hscroll_Buffer
// reports across the band's lines: `max(asr(t,s)) - min(asr(t,s))` over the table. Verified
// against the machine before it was trusted — DeformTable_Shimmer at shift 2 computes 4,
// and the live buffer over band lines 90..223 measured 5 distinct values spanning 4.
//
// The sentinel needs no special case: shift 15 divides an amplitude-127 table to zero and
// this returns 0, which is the truth about a band with no deform.
//
// Flat accumulators over STATEMENT ifs, per EMP_PITFALLS §1 — a min/max written as nested
// if-expressions folds to `()` silently.
pub comptime fn deform_excursion(tbl: array, shift: int) -> int {
    comptime var lo   = 0
    comptime var hi   = 0
    comptime var seen = 0
    for i in 0..tbl.len {
        let v = deform_asr(tbl[i], shift)
        if seen == 0 {
            lo   = v
            hi   = v
            seen = 1
        }
        if v < lo { lo = v }
        if v > hi { hi = v }
    }
    return hi - lo
}

// REMAP_VISIBLE_MIN_PX — the floor, and its provenance is an OBSERVATION, which is stated
// plainly because there is no other kind of evidence for a visibility threshold. Nothing
// about the VDP, the plane size or the scroll word implies a number here; a perceptual bar
// can only be calibrated against someone looking at the screen.
//
// The two measurements it sits between, both from 2026-09-03:
//   4 px  DeformTable_Shimmer at anchor dsb 2 — the shipped waterline. Live, mathematically
//         non-identity, gated five ways, and reported by the owner as not visible.
//   16 px DeformTable_Shimmer at anchor dsb 0 — the fix. Visible.
// 8 is twice the measured-invisible figure and half the measured-visible one, so the bar is
// not tuned to let the current scene squeak past: the shipped value clears it by 2x. If a
// future scene is found invisible at 8 px, RAISE THIS — the number is a record of what has
// been looked at, and it should move when something new is looked at.
pub const REMAP_VISIBLE_MIN_PX = 8

// tri_sample — one triangle sample at phase j (= i % period). Split out of
// deform_triangle because an `if` in block-tail position inside the
// `comptime for` element folds to `()` SILENTLY (EMP_PITFALLS §1) — the
// original inline form made EVERY sample unit, red-first witness 2026-08-26.
// A single-level `return if` folds to a value (measured; `iabs` above is the
// standing precedent), and a CALL in block-tail position is fine (§1).
comptime fn tri_sample(j: int, amplitude: int, period: int) -> int {
    return if j < period / 2 {
        ((j * amplitude * 4) / period) - amplitude
    } else {
        amplitude - (((j - period / 2) * amplitude * 4) / period)
    }
}

// deform_triangle — signed triangle wave, pure integer (no sin). Linear ramp
// -A -> +A -> -A per period. period must divide 256. Same contract as
// deform_sine: 256 signed i8 samples, peak = amplitude (a negative amplitude
// is a legitimately inverted wave — the neg-label parcel's ruling).
pub comptime fn deform_triangle(amplitude: int, period: int) -> [i8; 256] {
    ensure(256 % period == 0, "deform_triangle: period {period} must divide 256")
    return comptime for i in 0..256 {
        tri_sample(j: i % period, amplitude: amplitude, period: period)
    }
}

// GUARD — deform_triangle sample pins (same contract as deform_sine: 256 i8
// samples, `256 % period == 0`, peak = amplitude). Intended waveform, derived
// BEFORE the fix, with j = i % period:
//   j in [0, P/2):  v = (j*4A)/P - A        (linear ramp -A -> +A)
//   j in [P/2, P):  v = A - ((j - P/2)*4A)/P (linear ramp +A -> -A)
// For (amplitude: 16, period: 64):
//   T[0]  = (0*64)/64  - 16 = -16   (trough)
//   T[16] = (16*64)/64 - 16 =   0   (quarter period, rising zero-crossing)
//   T[32] = 16 - (0*64)/64  = +16   (peak)
//   T[48] = 16 - (16*64)/64 =   0   (three-quarter period, falling zero-crossing)
// and mid-ramp T[8] = (8*64)/64 - 16 = -8. These module-level ensures execute
// on EVERY build (parallax_dsl is inside every profile's use closure —
// reachability proven red-first with a deliberate failing ensure, 2026-08-26),
// so the fold can never silently regress to `()` again.
//
// HOW a unit sample surfaces, since 2026-09-02 (sigil merge 6a8b3ecd): NOT
// through these messages. Comptime `==` refuses across comparison classes
// instead of answering, so `() == -16` is a compile error at the comparison and
// the pins below never evaluate. Sigil's `[eq.cross-type]` refusal carries §1's
// unit-fold lead itself (see sigil docs/EMP_PITFALLS_EQUALITY.md §12 at that
// revision), so the diagnosis is not lost — it just arrives from the compiler
// rather than from the strings here. On a healthy tree every pin is int-vs-int
// and answers exactly as before. The independent tripwire on the opposite
// regression — a refusal that starts answering TRUE, which would make all five
// of these pass silently — is games/sonic4/test/poison/poison_tail_if_unit_fold.emp.
const TriPin = deform_triangle(amplitude: 16, period: 64)
ensure(TriPin[0] == -16,
       "deform_triangle guard: T[0] must be -amplitude (trough), got {TriPin[0]}")
ensure(TriPin[16] == 0,
       "deform_triangle guard: T[period/4] must be 0 (rising zero-crossing), got {TriPin[16]}")
ensure(TriPin[32] == 16,
       "deform_triangle guard: T[period/2] must be +amplitude (peak), got {TriPin[32]}")
ensure(TriPin[48] == 0,
       "deform_triangle guard: T[3*period/4] must be 0 (falling zero-crossing), got {TriPin[48]}")
ensure(TriPin[8] == -8,
       "deform_triangle guard: T[period/8] must be -amplitude/2 (mid-ramp linearity), got {TriPin[8]}")

// v_column_perspective — linear V-tilt ramp for per-column V-scroll. focal is
// the horizon column (offset 0); max_offset the peak at the far edge. The
// first 40 entries are the column shape; the rest mirror column 39 (a sentinel
// for animated indexing, harmless for static-shape sections).
pub comptime fn v_column_perspective(focal: int, max_offset: int) -> [i8; 256] {
    return comptime for i in 0..256 {
        ((if i < 40 { i } else { 39 }) - focal) * max_offset / 20
    }
}

// v_column_floor — symmetric V-curve for per-column V-scroll (a floor
// receding at the screen edges). center is the zero column; max_offset the
// peak at the furthest edge. First 40 entries are the shape; the rest mirror
// column 39.
pub comptime fn v_column_floor(center: int, max_offset: int) -> [i8; 256] {
    return comptime for i in 0..256 {
        (iabs((if i < 40 { i } else { 39 }) - center) * max_offset) / center
    }
}

// ---- v_column_floor_screen — EFFECTS-W1 F3, the SCREEN-ANCHORED perspective floor ----
//
// THE ONE FACT THAT DECIDES THIS GENERATOR'S SHAPE: a per-column V-scroll table is indexed
// by SCREEN column, never by plane column. VSRAM holds 20 column-pair entries in H40 and
// each covers a fixed 16-px slice OF THE DISPLAY; a plane's H-scroll slides art past those
// twenty stationary slots, it does not carry them. (rasterscroll.com, "Row/Column
// Scrolling" and "The Inner Workings of the VDP"; Eke-Eke, SpritesMind t=737.) So the
// vanishing point expressed through this table is inherently a viewport quantity — which is
// exactly the EFFECTS-W1 F1 line: an effect is screen-based only when it names a reason of
// that kind, and "a vanishing point is where the viewer's optical axis meets the floor" is
// that reason.
//
// WHAT v_column_floor ABOVE GETS WRONG, and it is two separate things:
//
//   1. THE APEX IS OUTSIDE THE SCREEN. Only twenty entries are ever consumed (the fill loop
//      in Parallax_Step5_Vscroll runs `moveq #20-1, d6`), so at phase 0 the visible shape is
//      entries 0..19 — and `center: 20` puts the V's minimum at entry 20, one column PAST
//      the right edge. The floor never converges on screen; it is a monotone ramp. That is
//      the "the middle is [not] in the middle bottom of the screen" the owner reported.
//   2. THE SHAPE DIES AT ENTRY 40. `if i < 40 { i } else { 39 }` clamps the index, so
//      entries 40..255 are all one constant. A scene with a non-zero sample speed walks the
//      read window into that flat region within 40 frames and stays there for the remaining
//      216 of the 256-frame cycle: the effect is a constant plane-B offset with no shape at
//      all for 84% of its period.
//
// AND WHY THE `/ center` NORMALISATION HAS TO GO WITH IT. It divides the ramp by the apex
// column, so the arm's SLOPE is a function of where the apex sits: move the apex and the
// cone changes steepness. Read as geometry that is a floor whose pitch changes as you look
// around, which is not a floor. A perspective cone has ONE slope; where the apex sits only
// decides how much of each arm is on screen. So this generator takes the slope (as the
// offset a column `V_FLOOR_HALF_COLS` away from the apex receives) and never normalises.
// The web sweep flagged the same hazard from the other side as an untested hypothesis — a
// V sampled with unequal arm lengths "breathes" — and the fix it names is the one taken
// here: keep BOTH arms full length in the table so the window can sit anywhere.
//
// SHAPE: 256 entries, apex (offset 0) at V_FLOOR_CENTER_IDX, both arms full length to the
// table ends. Every index is a real sample — there is no sentinel region — so the 20-entry
// read window is a correct cone slice at ANY phase, which is precisely what lets the
// runtime move the vanishing point by moving the phase instead of rebuilding the table.
pub const V_FLOOR_CENTER_IDX = 128   // the apex's table index
pub const V_FLOOR_HALF_COLS  = 10    // half of H40's 20 column-pairs = the screen half-width

// One sample. Split into a named fn for row_remap_entry16's reason: an `if` in block-tail
// position inside a `comptime for` element folds to `()` SILENTLY (docs/EMP_PITFALLS.md §1),
// and this body needs two of them. Flat statement-`if` accumulation, never nested.
comptime fn v_floor_screen_sample(i: int, edge_offset: int) -> int {
    let d = iabs(i - V_FLOOR_CENTER_IDX)
    comptime var v = (d * edge_offset) / V_FLOOR_HALF_COLS
    if v >  127 { v =  127 }
    if v < -128 { v = -128 }
    return v
}

// edge_offset — the raw sample handed to a column one screen half-width (10 column-pairs,
// 160 px) from the apex. The runtime still divides it by the scene's amplitude shift, so
// this is the shape's units, not pixels.
pub comptime fn v_column_floor_screen(edge_offset: int) -> [i8; 256] {
    return comptime for i in 0..256 {
        v_floor_screen_sample(i, edge_offset)
    }
}

// GUARD — the shape pins, on the same contract as deform_triangle's above and for the same
// reason: these run on EVERY build (parallax_dsl is inside every profile's use closure), so
// a fold to `()` or a slope regression cannot reach a ROM silently.
//
// The clamp exists for the TYPE, not for the effect. The reachable read window is
// `phase .. phase+19` with `phase = V_FLOOR_CENTER_IDX - vp_col` and vp_col in 0..19, so the
// indices any frame can touch are V_FLOOR_CENTER_IDX-19 .. V_FLOOR_CENTER_IDX+19 — |d| <= 19,
// and at edge_offset 24 that peaks at 45. The last pin below is what holds that: if the
// clamp ever bites inside the reachable window the cone is being flattened on one arm and
// the floor tilts wrong, which is invisible in a screenshot.
const VfsPin = v_column_floor_screen(edge_offset: 24)
ensure(VfsPin[V_FLOOR_CENTER_IDX] == 0,
       "v_column_floor_screen guard: the apex sample must be 0, got {VfsPin[V_FLOOR_CENTER_IDX]}")
ensure(VfsPin[V_FLOOR_CENTER_IDX + V_FLOOR_HALF_COLS] == 24,
       "v_column_floor_screen guard: a column one screen half-width right of the apex must get edge_offset (24), got {VfsPin[V_FLOOR_CENTER_IDX + V_FLOOR_HALF_COLS]}")
ensure(VfsPin[V_FLOOR_CENTER_IDX - V_FLOOR_HALF_COLS] == 24,
       "v_column_floor_screen guard: the curve must be SYMMETRIC about the apex — the column one half-width LEFT got {VfsPin[V_FLOOR_CENTER_IDX - V_FLOOR_HALF_COLS]}, not 24")
ensure(VfsPin[V_FLOOR_CENTER_IDX + 5] == 12,
       "v_column_floor_screen guard: the arm must be LINEAR — half a screen half-width out should be half edge_offset (12), got {VfsPin[V_FLOOR_CENTER_IDX + 5]}")
ensure(VfsPin[V_FLOOR_CENTER_IDX + 19] == 45 && VfsPin[V_FLOOR_CENTER_IDX - 19] == 45,
       "v_column_floor_screen guard: the FURTHEST reachable sample (19 column-pairs from the apex, the phase extreme) must be an unclamped 45 on both arms, got {VfsPin[V_FLOOR_CENTER_IDX + 19]} and {VfsPin[V_FLOOR_CENTER_IDX - 19]} — a clamp inside the read window silently flattens one arm of the cone")

// ---- the row-remap ladder (EFFECTS-W1 item 9, the Hydrocity waterline) ----
//
// A ladder is (H+1) rows of H bytes. Row `r` is selected each frame as `H - |p|`, where p is
// the perspective quantity — the separation, in screen lines, between the BACKGROUND's image
// of the surface and the FOREGROUND's truth about it — and the first `H - r` of that row's
// bytes are consumed. `ladder[r][i]` says: screen line i of the band takes the plane-B scroll
// word that belonged to line ladder[r][i].
//
// THREE INVARIANTS, AND ALL THREE ARE CORRECTNESS PROPERTIES RATHER THAN STYLE:
//   entry[i] >= i        The permute is IN PLACE and forward — read base and write base are
//                        the same address, S3K's own shape (sonic3k.asm:105849-105850). A
//                        line either reads a slot it has not written yet, or reads its own
//                        value back. Break this and the loop feeds on its own output.
//   entry non-decreasing  Rows are reordered, repeated and dropped; they are never SWAPPED.
//                        A descending pair is a scroll word moving backwards down the band,
//                        which reads as a tear rather than as compression.
//   entry[i] <= 2i       The read bound. It is what lets the runtime cap the remapped run at
//                        span/2 and know that every fetch stays inside the band's OWN
//                        longwords. Without it a tall |p| over a short band would pull the
//                        next band's scroll words into this one — which looks like a
//                        plausible effect and is not one.
// tools/row_remap_gate.py re-checks all three IN THE BUILT ROM, off the .lst, because the
// generator being right is a different claim from the right bytes reaching the image.
//
// THE MODEL IS CHOSEN, NOT FITTED, AND THAT IS BOOKED. `extra` is quadratic in i and linear
// in |p|: the step grows smoothly from 1 line at the surface to 2 lines at the far end, and
// the whole family scales with the viewpoint separation. S3K's shipped table is NOT this —
// its rows are hand-shaped, its step histograms at rows 70 and 90 are nonlinear in a way no
// single formula reproduces, and it carries exactly one large discontinuity per row (the
// water SEAM), which belongs to the art half this parcel does not build. Fitting S3K's own
// 97x96 table is a legitimate and cheap alternative and is open question 5 of the design;
// parcel 9b owns the generator that would settle it. What this one guarantees is the three
// invariants above, which is what the runtime depends on.
//
// H IS FIXED AT 16 HERE, and the ladder is 17 x 16 = 272 bytes. The return type must be
// concrete, so a parameterised H means a second fn rather than an argument; 9b's generator is
// where that parameterisation belongs.
//
// ⚠ H IS 16 BECAUSE THE ROM SAID SO, TWICE, AND THE NUMBER THAT DECIDED IT IS WORTH KNOWING.
// It started at 64 — a 65 x 64 = 4,160-byte table, exactly the size of S3K's own
// `LBZ Waterline Scroll Data.bin` — and `tools/bganim_room.py` refused the canonical build:
// packed data ran to within 15,092 B of the `dac_banks` anchor against a DATA_GROWTH_RESERVE
// of 16,384 B. H = 32 (1,056 B) cleared the RELEASE shape (18,196 B free) and still failed
// the DEBUG one (15,886 B free, 498 B short) — a four-shape gate needs a four-shape answer,
// and the release shape passing was not one.
//
// THE MEASURED CEILING, DERIVED FROM THOSE TWO RUNS: the DEBUG shape has about 558 BYTES of
// packed-data headroom before the bank-placement rule demands that both anchors move up a
// 32 KB page. That is a whole-ROM re-layout and a frozen-table refreeze, which is not this
// parcel's business — so ANY parcel adding more than ~558 B of packed data hits this wall
// first, and it is not specific to a ladder. Booked in docs/DEFERRED_WORK.md.
//
// AUTHORING H DOWN IS THE DESIGN'S OWN FIRST LEVER (§6.1: "Author H down. The ladder is
// quadratic in the band height."), and it is the one that fits inside a parcel. What it costs
// is the remapped run's CEILING: |p| clamps at 15 lines rather than 63. The shipped binding's
// surface plane line is chosen so its measured sweep sits under that clamp; a binding that
// wants a taller band needs the bigger table AND the bank move, in that order.
pub const ROW_REMAP_H16 = 16

// One ladder entry, from the FLAT index. Split out of the `comptime for` element for
// tri_sample's reason: an `if` in block-tail position inside the element folds to `()`
// SILENTLY (docs/EMP_PITFALLS.md §1). There is no `if` here today, and keeping the body in a
// named fn is what stops one being added inline later.
comptime fn row_remap_entry16(k: int) -> int {
    let r = k / ROW_REMAP_H16                      // the ladder row, 0 .. H
    let i = k % ROW_REMAP_H16                      // the output line within the row
    let p = ROW_REMAP_H16 - r                      // |p|: row H is the identity, row 0 is 2:1
    return i + ((i * i * p) / (ROW_REMAP_H16 * (ROW_REMAP_H16 - 1)))
}

pub comptime fn row_remap_ladder16() -> [u8; 272] {
    return comptime for k in 0..272 { row_remap_entry16(k) }
}
