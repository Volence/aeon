// Collision lookup (§4.7) — collision attr byte from the 2D tile cache.
// Surface probing (heights/angles/solidity) lives in
// games/sonic4/player/player_sensors.emp, built on top of this lookup.
//
// REGISTER CONVENTION (all sensor entry points): d3.b = collision layer
// (0 = path A, 1 = path B — read from the querying object's SST_layer).
// Saved X/Y live in d4/d5. Set d3 before EVERY call — it is not
// preserved by contract. New sensor wrappers (§5) must follow this.
module engine.collision_lookup in collision_lookup

use engine.constants.{CTYPE_AIR, TILE_CACHE_COLS, TILE_CACHE_ROWS, TILE_CACHE_STRIDE}
use engine.constants.{TILE_CACHE_COLL_ROWS, TILE_CACHE_COLL_SIZE, COLL_CELL_H}

// -----------------------------------------------
// Collision_GetType — look up collision type for a world-space position.
// Fuses the world-space bounds check with the cache-relative fetch: the
// former Tile_Cache_GetCollision (its sole caller was this proc's tail call)
// is folded in, so the shared Cache_Left_Col / Cache_Top_Row reads happen
// once and the tail branch is gone.
// In:  d0.w = world X pixel position (same domain as x_pos)
//      d1.w = world Y pixel position
//      d3.b = layer select (0 = path A, 1 = path B)
// Out: d0.b = collision type byte (0 = air)
// Clobbers: d1-d2/a0 (d3 read-only but declared clobbered per the sensor
//           convention above — set it before every call).
// -----------------------------------------------
pub proc Collision_GetType (d0: u16, d1: u16, d3: u8) clobbers(d1-d3/a0) out(d0: u8) {
        ensure(TILE_CACHE_STRIDE == 80 && TILE_CACHE_STRIDE == TILE_CACHE_COLS,
               "Collision_GetType hand-spells `mul_const.w d1, #80, d2` and the stride is now TILE_CACHE_STRIDE = {TILE_CACHE_STRIDE} (= TILE_CACHE_COLS = {TILE_CACHE_COLS}). Derived: a collision plane is TILE_CACHE_COLS bytes per row (TILE_CACHE_COLL_SIZE = TILE_CACHE_COLS * TILE_CACHE_COLL_ROWS = {TILE_CACHE_COLL_SIZE}), so the collision row stride IS the column count. WHAT FIXING THIS ONE SITE DOES NOT FIX (this message used to say only `keep TILE_CACHE_STRIDE=80`, and satisfying it plus its twin in tile_cache.emp was measured to build GREEN with four further sites still striding 80 — lens-sweep row LS-8): the six other hand-spelled stride sites, now pinned at their own routines — engine/level/tile_cache.emp mul_cache_stride, TileCache_CopyBlockColumn (two `((x<<2)+x)<<4` chains carrying no literal 80) and TileCache_FillRow; engine/level/section.emp Section_RedrawPlanes; engine/level/plane_buffer.emp Draw_TileColumn and Draw_TileRow_FromCache. It also does not cover the `lsr.w #3` pixel-to-tile and `lsr.w #1` tile-row-to-cell shifts in this routine, which are COLL_CELL_W/COLL_CELL_H facts and unaffected by the column count")
        lsr.w   #3, d0                      // X pixels → world tile col
        move.w  Cache_Left_Col, d2          // read once: bounds compare + cache-relative
        cmp.w   d2, d0
        blt     .cgt_air                     // col < left window edge
        cmp.w   Cache_Head_Col, d0
        bgt     .cgt_air                     // col > right window edge

        // col in range → cache-relative physical col (circular)
        sub.w   d2, d0                       // col - Cache_Left_Col (d2 free after)
        add.w   Cache_Origin_Col, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .col_nowrap
        subi.w  #TILE_CACHE_COLS, d0
    .col_nowrap:

        lsr.w   #3, d1                      // Y pixels → world tile row
        move.w  Cache_Top_Row, d2           // read once: bounds compare + cache-relative
        cmp.w   d2, d1
        blt     .cgt_air
        cmp.w   Cache_Bottom_Row, d1
        bgt     .cgt_air

        // row in range → cache-relative physical collision row (circular).
        // Origin is added BEFORE the halving, so the origin is read straight from
        // RAM and never halved per query (lens row C1b-3): the old form was
        // lsr L / move O / lsr O / add = floor(L/2) + O/2, this is
        // floor((L + O)/2), and the two are EQUAL for every L because
        // Cache_Origin_Row is kept even — the same invariant the old form leaned
        // on. It stays even only while TILE_CACHE_ROWS is even (the origin wraps by
        // it); the ensure beside TILE_CACHE_COLL_ROWS in engine/system/constants.emp
        // pins that. The range is unchanged too (both are one value), so the single
        // subtract below still wraps. It is also literally "physical tile row / 2
        // = physical collision row", as docs/ENGINE_ARCHITECTURE.md §4.7 words it.
        sub.w   d2, d1                       // row - Cache_Top_Row (d2 free after)
        add.w   Cache_Origin_Row, d1         // → physical tile row, before the wrap
        lsr.w   #1, d1                        // tile rows → collision rows (origin even: exact)
        cmpi.w  #TILE_CACHE_COLL_ROWS, d1
        blt     .row_nowrap
        subi.w  #TILE_CACHE_COLL_ROWS, d1
    .row_nowrap:

        mul_const.w d1, #80, d2             // d1 = coll_row × TILE_CACHE_STRIDE; d2 trashed
        add.w   d0, d1
        // layer plane select: layer B shifts the byte index into the 2nd plane
        tst.b   d3
        beq     .plane_selected
        addi.w  #TILE_CACHE_COLL_SIZE, d1     // plane B starts at +TILE_CACHE_COLL_SIZE
    .plane_selected:
        lea     Tile_Cache_Collision, a0
        move.b  (a0, d1.w), d0
        rts

    .cgt_air:
        moveq   #CTYPE_AIR, d0
        rts
}

// -----------------------------------------------
// Collision_ResidentBottom — the first world pixel row, below a querying object, whose
// collision is NOT resident: where the camera-following RAM ring stops knowing the world.
// Collision_GetType answers AIR past Cache_Bottom_Row (.cgt_air) and reads whatever the
// ring slot last held for a declared-but-unwritten row, so a probe at or below this row
// cannot be trusted. An object that can outrun the camera (an uncapped fall, owner ruling
// FALL-FEEL 2026-09-27) must keep its probes above it; games/sonic4/player/player_air.emp
// Player_FallLimit is the consumer.
//
// "Resident" means WRITTEN, not declared, on both counts the fill leaves open:
//   * a pending partial row (Cache_Fill_RowResume_Row) below the object cuts the extent to
//     the row above it — Tile_Cache_Fill commits Cache_Bottom_Row BEFORE filling it;
//   * collision is copied only on a cell's ODD (cell-completing) row
//     (TileCache_FillRow), so an even last row has not written its cell yet. Rounding
//     (last row + 1) down to even gives the first row of the first incomplete cell.
// A pending row at or above the object is the up-fill's (the pair Tile_Cache_Fill's
// .v_top_fill orphaned) and is not this object's frontier.
// In:  d1.w = the querying object's world Y (px)
// Out: d0.w = frontier, world px (first row NOT resident)
// Clobbers: d1-d2
// -----------------------------------------------
pub proc Collision_ResidentBottom (d1: u16) clobbers(d1-d2) out(d0: u16) {
        ensure(COLL_CELL_H == 16,
               "Collision_ResidentBottom rounds a tile row to its collision cell with `andi.w #$FFFE` (two 8 px tile rows per cell) and converts rows to px with `lsl.w #3`; COLL_CELL_H is now {COLL_CELL_H}")
        move.w  Cache_Bottom_Row, d0
        move.w  Cache_Fill_RowResume_Row, d2    // $FFFF = none, which the unsigned test drops
        cmp.w   d0, d2
        bhi     .filled                          // none pending, or not inside the window
        lsr.w   #3, d1                           // the querying object's tile row
        cmp.w   d1, d2
        bls     .filled                          // pending row at/above it: the up-fill's
        move.w  d2, d0
        subq.w  #1, d0                           // written through the row above the pending one
    .filled:
        addq.w  #1, d0
        andi.w  #$FFFE, d0                       // first row of the first unwritten cell
        lsl.w   #3, d0                           // tile row -> px
        rts
}
