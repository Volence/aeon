// engine/level/page_cache.emp — Art-streaming Phase 2 (P2b Task 6): the VRAM
// page-frame residency cache.
//
// The FG art window (POOL_TILE_CEILING tiles) is carved into PAGE_FRAMES fixed
// 64-tile frames. A page id -> frame map (Page_Table) plus per-frame bookkeeping
// (Page_Frames[]) turns "which 64-tile pool page lives in which VRAM slot" into a
// runtime residency question. Blocks entering the 80x60 tile cache are patched
// logical(global)->physical(frame) at the copy sites (engine.tile_cache) and their
// pages ref-counted; a page whose refcount is 0 and is not pinned is an eviction
// candidate (van Waveren SVT free/LRU/locked tri-list adapted: a frame is in the
// FREE list, the evictable LRU list, or neither — referenced/pinned).
//
// SAFETY INVARIANT (spec §5): pf_refcount counts nametable words currently in the
// tile cache that reference the frame. Eviction only of refcount-0 unpinned frames
// => a physical index baked into a live cache word can never dangle. The audit
// (PageCache_Audit, DEBUG) recomputes every frame's refcount from the whole
// nametable and compares — the machine check on that invariant.
//
// TASK 6 SCOPE: OJZ's 10 pages <= 15 frames, so the free list never empties and
// nothing evicts yet. AllocFrame's LRU-victim arm + the demand-stall path in
// PatchWord are built correctly but DORMANT until Task 7's clamp forces eviction.
//
// REGISTER BUDGET (contract-critical): PageCache_AllocFrame + PageCache_Publish are
// reached from PageIn_Process, whose license is VSync_Wait's decoder union
// d0-d2/a0-a3 — and Level_LoadArt keeps a4/d3-d4/d7 LIVE across VSync_Wait. So the
// procs on that path (AllocFrame, Publish, and their callee Lru*) clobber ONLY
// d0-d2/a0-a3: they address Page_Frames as base(a3)+offset(dn) with an offsetof
// field displacement, never a per-frame pointer in a4. Ref/Unref/PatchWord are
// reached only from the copy sites (PatchWord movem-banks its own working set), so
// they are free of that constraint but still keep to d0-d2/a3 for consistency.
//
// D2 (no unified arbiter): this tier owns its own residency governor; no shared
// cost ledger. The §7.2 adoption seam is a DOCUMENTED comment in the
// Tile_Cache_Fill budget area (engine.tile_cache) + ARCH prose (Task 12) — never
// built here.
//
// PLACEMENT NOTE: every proc below emits as ONE contiguous section behind the
// module head-label PageCache_Init (one-section-per-module rule; map.toml's
// `order` carries the single entry PageCache_Init).
module engine.page_cache in page_cache

use engine.structs.{Act, PageManifest, PageFrame}
use engine.constants.{PAGE_FRAMES, PAGE_TABLE_MAX, PAGE_NOT_RESIDENT}
use engine.constants.{PF_PINNED_BIT, PF_IN_LRU_BIT, PF_PINNED, PF_IN_LRU}
use engine.constants.{NT_TILE_MASK, NT_ATTR_MASK, PAGE_FRAME_TILE_SHIFT, PAGE_FRAME_TILE_MASK}
use engine.constants.{PGRQ_DEMAND, TILE_CACHE_NT_SIZE}

// Every callee is .emp-owned and resolves at link — no boundary decls:
// PageIn_Flush / PageIn_Enqueue (engine.page_in). RAM (Page_Table / Page_Frames /
// Page_Queued_Bits / Page_LRU_* / Page_Free_Head / PageIn_Pool_Table) resolves bare.

// sizeof(PageFrame) must stay the power-of-two 8 so a frame id scales to its
// Page_Frames byte offset with a shift, not a multiply.
ensure(sizeof(PageFrame) == 8, "PageFrame must be 8 bytes so `frame*sizeof` is `lsl #3`")

// Field displacements for the base(a3)+offset(dn) addressing (never baked literals).
const PF_PAGE  = offsetof(PageFrame, pf_page)
const PF_RC    = offsetof(PageFrame, pf_refcount)
const PF_PREV  = offsetof(PageFrame, pf_lru_prev)
const PF_NEXT  = offsetof(PageFrame, pf_lru_next)
const PF_FLAGS = offsetof(PageFrame, pf_flags)

// -----------------------------------------------
// PageCache_Init — reset residency to "empty, all frames free" for an act load.
//
// Calls PageIn_Flush first (Task 4 caller rule: an act/level transition clears
// pending page-in work before the cache is rebuilt). Pages are NOT loaded here —
// Level_LoadArt drives the pool load through the page-in path and page-in's
// completion (PageCache_Publish) fills Page_Table + marks pinned from the manifest.
// This proc only clears the tables and threads the free list.
//
// In:  none          Out: none          Clobbers: d0-d1/a0
// -----------------------------------------------
pub proc PageCache_Init () clobbers(d0-d1/a0) {
        jbsr    PageIn_Flush                    // cancel any in-flight/queued page-in work first

        lea     Page_Table, a0                  // Page_Table[..] = PAGE_NOT_RESIDENT
        move.w  #PAGE_TABLE_MAX-1, d0
    .clr_table:
        move.b  #PAGE_NOT_RESIDENT, (a0)+
        dbf     d0, .clr_table

        lea     Page_Queued_Bits, a0            // Page_Queued_Bits[..] = 0
        move.w  #(PAGE_TABLE_MAX/8)-1, d0
    .clr_queued:
        clr.b   (a0)+
        dbf     d0, .clr_queued

        move.b  #PAGE_NOT_RESIDENT, Page_LRU_Head   // LRU list empty
        move.b  #PAGE_NOT_RESIDENT, Page_LRU_Tail

        // Frames: all free, chained through pf_lru_next (0->1->...->N-1->FF),
        // pf_page = $FFFF, refcount 0, flags 0, prev = FF.
        lea     Page_Frames, a0
        moveq   #0, d1                          // running frame id (== next-link value)
        move.w  #PAGE_FRAMES-1, d0
    .init_frames:
        move.w  #$FFFF, PF_PAGE(a0)
        clr.w   PF_RC(a0)
        move.b  #PAGE_NOT_RESIDENT, PF_PREV(a0)
        addq.w  #1, d1                          // next frame id
        move.b  d1, PF_NEXT(a0)                 // free-list link -> next
        clr.b   PF_FLAGS(a0)
        lea     sizeof(PageFrame)(a0), a0
        dbf     d0, .init_frames
        // the last frame's next link must terminate the free list
        move.b  #PAGE_NOT_RESIDENT, PF_NEXT-sizeof(PageFrame)(a0)
        move.b  #0, Page_Free_Head              // free list head = frame 0

    if DEBUG == 1 {
        clr.w   Page_Audit_Ticks
    }
        rts
}

// -----------------------------------------------
// PageCache_Lookup — page id -> frame idx (or PAGE_NOT_RESIDENT). ~10 cyc.
// In: d0.w = page id       Out: d1.b = frame idx / PAGE_NOT_RESIDENT   Clobbers: a0
// -----------------------------------------------
pub proc PageCache_Lookup (d0: u16) clobbers(a0) out(d1: u8) {
        lea     Page_Table, a0
        move.b  (a0, d0.w), d1
        rts
}

// -----------------------------------------------
// PageCache_Request — enqueue a demand/prefetch page-in IF the page is neither
// resident nor already queued (the queued-marker bitset stops the FIFO being
// double-filled). A full FIFO clears the marker so a later frame re-requests.
// NOT on the PageIn_Process path (called from the copy-site miss + Task-7 prefetch).
// In: d0.w = page id, d1.w = flags (PGRQ_DEMAND)   Out: none   Clobbers: d0-d3/a0-a1
// -----------------------------------------------
pub proc PageCache_Request (d0: u16, d1: u16) clobbers(d0-d3/a0-a1) {
        lea     Page_Table, a0                  // resident already? -> nothing to do
        move.b  (a0, d0.w), d2
        cmpi.b  #PAGE_NOT_RESIDENT, d2
        bne     .done

        move.w  d0, d2                          // already queued? test the dedupe bit
        lsr.w   #3, d2                          // byte index (page/8)
        lea     Page_Queued_Bits, a1
        lea     (a1, d2.w), a1
        move.w  d0, d3
        andi.w  #7, d3                          // bit index (page&7)
        btst    d3, (a1)
        bne     .done                           // already in the FIFO

        bset    d3, (a1)                        // mark queued
    if DEBUG == 1 {
        btst    #0, d1                          // PGRQ_DEMAND bit
        beq     .no_dbg
        addq.w  #1, Dbg_PageCache_Demands
    .no_dbg:
    }
        jbsr    PageIn_Enqueue                  // (d0=page, d1.b=flags) -> carry = full
        bcc     .done
        move.w  d0, d2                          // full -> unmark so a later frame retries
        lsr.w   #3, d2
        lea     Page_Queued_Bits, a1
        lea     (a1, d2.w), a1
        move.w  d0, d3
        andi.w  #7, d3
        bclr    d3, (a1)
    .done:
        rts
}

// -----------------------------------------------
// PageCache_AllocFrame — hand out a frame to load a page into.
//   free list first; else the LRU tail (refcount 0, !pinned by construction);
//   else THRASH — DEBUG raise_error (a bug, not a policy); release returns
//   PAGE_NOT_RESIDENT for the caller to re-queue.
// The returned frame is DETACHED (out of every list), refcount 0, flags 0; the
// caller publishes it once its VRAM landing DMA is enqueued. Evicting a victim
// clears the departing page's Page_Table entry + queued bit.
// In: none   Out: d0.b = frame (or PAGE_NOT_RESIDENT)   Clobbers: d0-d2/a3
// -----------------------------------------------
pub proc PageCache_AllocFrame () clobbers(d0-d2/a3) out(d0: u8) {
        moveq   #0, d0
        move.b  Page_Free_Head, d0
        cmpi.b  #PAGE_NOT_RESIDENT, d0
        beq     .from_lru

        lea     Page_Frames, a3                 // pop the free-list head
        move.w  d0, d1
        lsl.w   #3, d1                           // frame byte offset
        move.b  PF_NEXT(a3, d1.w), Page_Free_Head   // free head advances
        bra     .detach

    .from_lru:
        moveq   #0, d0
        move.b  Page_LRU_Tail, d0
        cmpi.b  #PAGE_NOT_RESIDENT, d0
        beq     .thrash
        lea     Page_Frames, a3
        move.w  d0, d1
        lsl.w   #3, d1
    if DEBUG == 1 {
        tst.w   PF_RC(a3, d1.w)
        beq     .victim_ok
        raise_error "PageCache_AllocFrame: LRU tail refcount>0 (list corruption)"
    .victim_ok:
    }
        jbsr    PageCache_LruUnlink             // unlink victim (d0 = frame, preserved)
        lea     Page_Frames, a3                 // clear departing page's residency
        move.w  d0, d1
        lsl.w   #3, d1
        move.w  PF_PAGE(a3, d1.w), d2           // departing page id
        lea     Page_Table, a3
        move.b  #PAGE_NOT_RESIDENT, (a3, d2.w)  // Page_Table[page] = NOT_RESIDENT
        move.w  d2, d1                          // clear its queued bit too
        lsr.w   #3, d1
        lea     Page_Queued_Bits, a3
        andi.w  #7, d2
        bclr    d2, (a3, d1.w)
        lea     Page_Frames, a3                 // re-derive base+offset for .detach
        move.w  d0, d1
        lsl.w   #3, d1

    .detach:
        move.b  #PAGE_NOT_RESIDENT, PF_PREV(a3, d1.w)
        move.b  #PAGE_NOT_RESIDENT, PF_NEXT(a3, d1.w)
        clr.w   PF_RC(a3, d1.w)
        clr.b   PF_FLAGS(a3, d1.w)
        rts

    .thrash:
    if DEBUG == 1 {
        raise_error "PageCache_AllocFrame: no free/evictable frame (thrash bug)"
    }
        moveq   #PAGE_NOT_RESIDENT, d0
        rts
}

// -----------------------------------------------
// PageCache_Publish — mark a just-landed page resident in its frame. Called by
// engine.page_in the instant a page's VRAM landing DMA is enqueued. Fills
// Page_Table, stamps the frame's page id, applies the manifest's pinned flag, links
// a non-pinned frame into the evictable LRU list, and clears the queued marker.
// (On the PageIn_Process path -> d0-d2/a0-a3 only.)
//
// TASK 7 NOTE: a demand-loaded page is added to the LRU here like a speculative one
// — safe in Task 6 (nothing evicts). Task 7 adds demand-protection (keep a demand
// page out of the LRU until the stalled fill refs it).
// In: d0.w = page id, d1.b = frame idx   Out: none   Clobbers: d0-d2/a0/a3
// -----------------------------------------------
pub proc PageCache_Publish (d0: u16, d1: u8) clobbers(d0-d2/a0/a3) {
        move.w  d0, d2                          // clear the queued marker (page resident now)
        lsr.w   #3, d2
        lea     Page_Queued_Bits, a0
        lea     (a0, d2.w), a0
        move.w  d0, d2
        andi.w  #7, d2
        bclr    d2, (a0)

        lea     Page_Table, a0                  // Page_Table[page] = frame
        move.b  d1, (a0, d0.w)

        movea.l PageIn_Pool_Table, a0           // &manifest[page] (read pm_flags below)
        move.w  d0, d2
        lsl.w   #3, d2                           // page * sizeof(PageManifest)=8
        lea     (a0, d2.w), a0

        lea     Page_Frames, a3                 // frame fields via base+offset
        move.w  d1, d2
        lsl.w   #3, d2
        move.w  d0, PF_PAGE(a3, d2.w)           // pf_page = page (d0 still = page)
        clr.w   PF_RC(a3, d2.w)

        move.b  PageManifest.pm_flags(a0), d0   // pm_flags (page no longer needed)
        btst    #0, d0                          // ART_PAGE_FLAG_PINNED (bit0)
        beq     .not_pinned
        move.b  #PF_PINNED, PF_FLAGS(a3, d2.w)  // pinned: never in the LRU list
        rts
    .not_pinned:
        move.b  #PF_IN_LRU, PF_FLAGS(a3, d2.w)  // evictable, refcount 0
        move.b  d1, d0                          // LruLinkTail takes frame in d0
        jbra    PageCache_LruLinkTail
}

// -----------------------------------------------
// PageCache_Ref — a cache word now references `frame`. refcount++, and on the 0->1
// transition remove the frame from the eviction LRU list ("LRU touch").
// In: d0.b = frame   Out: none   Clobbers: d0-d2/a3   (d3+ untouched: PatchWord
//   holds `old` in d3 across this call)
// -----------------------------------------------
pub proc PageCache_Ref (d0: u8) clobbers(d0-d2/a3) {
        lea     Page_Frames, a3
        move.w  d0, d1
        lsl.w   #3, d1
        addq.w  #1, PF_RC(a3, d1.w)
        cmpi.w  #1, PF_RC(a3, d1.w)
        bne     .done                           // already referenced -> no list change
        bclr    #PF_IN_LRU_BIT, PF_FLAGS(a3, d1.w)
        beq     .done                           // was not in the LRU list
        jbsr    PageCache_LruUnlink             // d0 = frame (preserved)
    .done:
        rts
}

// -----------------------------------------------
// PageCache_Unref — a cache word stopped referencing `frame`. refcount--, and on
// the 1->0 transition link the frame at the LRU tail (evictable), unless pinned.
// In: d0.b = frame   Out: none   Clobbers: d0-d2/a3
// -----------------------------------------------
pub proc PageCache_Unref (d0: u8) clobbers(d0-d2/a3) {
        lea     Page_Frames, a3
        move.w  d0, d1
        lsl.w   #3, d1
    if DEBUG == 1 {
        tst.w   PF_RC(a3, d1.w)
        bne     .ok
        raise_error "PageCache_Unref: refcount underflow (double-free of a cache word)"
    .ok:
    }
        subq.w  #1, PF_RC(a3, d1.w)
        bne     .done                           // still referenced
        btst    #PF_PINNED_BIT, PF_FLAGS(a3, d1.w)
        bne     .done                           // pinned frames never enter the LRU list
        bset    #PF_IN_LRU_BIT, PF_FLAGS(a3, d1.w)
        jbsr    PageCache_LruLinkTail           // d0 = frame
    .done:
        rts
}

// -----------------------------------------------
// PageCache_PatchWord — the copy-site primitive (spec §5). Reads the GLOBAL
// nametable word at (a0), translates it logical->physical, writes the physical
// word at (a1), and adjusts refcounts: Ref the new page, Unref the overwritten old
// page. Blank (tile-index 0) words skip Ref/Unref on their respective side. Neither
// a0 nor a1 is advanced — the caller's copy loop strides them.
//
// If the new word's page is NOT resident: enqueue a demand PageCache_Request, set
// Cache_Art_Stall (the fill returns partial + resumes this column/row next frame),
// and LEAVE the destination cell untouched (its old content + ref intact) — so
// re-copy on resume is refcount-neutral for the cells already done. DORMANT in
// Task 6 (whole pool resident).
//
// Preserves EVERY register (movem-banks its d0-d4/a3 working set; the miss path
// brackets a0/a1 across PageCache_Request; a4 is never touched) so it drops cleanly
// into the register-saturated H6 fill loops.
// In: a0 = source GLOBAL word ptr, a1 = destination nametable-cell ptr
// Out: none   Clobbers: () — preserves d0-d4/a3 (a0/a1 read-only; a4 untouched)
// -----------------------------------------------
pub proc PageCache_PatchWord (a0: *u8, a1: *u8) clobbers() preserves(d0-d4/a3/a0-a1) {
        movem.l d0-d4/a3, -(sp)
        move.w  (a0), d0                        // new GLOBAL word
        move.w  d0, d1
        andi.w  #NT_TILE_MASK, d1               // new tile index (0..2047)
        beq     .new_blank                      // new is blank -> unref old, write 0, no ref

        move.w  d1, d2                          // page = idx >> 6
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d2
        lea     Page_Table, a3
        move.b  (a3, d2.w), d2                  // frame (or NOT_RESIDENT)
        cmpi.b  #PAGE_NOT_RESIDENT, d2
        beq     .miss
        andi.w  #$00FF, d2                      // zero-extend frame

        move.w  d1, d3                          // physical = attrs | (frame<<6 | (idx&63))
        andi.w  #PAGE_FRAME_TILE_MASK, d3       // intra-frame tile (idx & 63)
        move.w  d2, d4
        lsl.w   #PAGE_FRAME_TILE_SHIFT, d4      // frame << 6
        or.w    d4, d3                          // physical tile index
        andi.w  #NT_ATTR_MASK, d0               // keep pal/pri/flip
        or.w    d3, d0                          // physical nametable word

        move.w  (a1), d3                        // capture OLD cell (unref) BEFORE overwrite
        move.w  d0, (a1)                        // write the patched word

        move.w  d2, d0                          // Ref the new frame; d3(old)/d4 survive Ref
        jbsr    PageCache_Ref
        andi.w  #NT_TILE_MASK, d3               // Unref old frame (if old was not blank)
        beq     .exit
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d3
        move.w  d3, d0
        jbsr    PageCache_Unref
    .exit:
        movem.l (sp)+, d0-d4/a3
        rts

    .new_blank:
        move.w  (a1), d3                        // new is blank: unref old, then write 0
        clr.w   (a1)
        andi.w  #NT_TILE_MASK, d3
        beq     .exit
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d3
        move.w  d3, d0
        jbsr    PageCache_Unref
        bra     .exit

    .miss:
        move.w  d1, d0                          // page = idx >> 6
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d0
        move.w  #PGRQ_DEMAND, d1
        movem.l a0/a1, -(sp)                    // Request clobbers a0-a1
        jbsr    PageCache_Request
        movem.l (sp)+, a0/a1
        move.w  #1, Cache_Art_Stall             // fill returns partial + resumes this col/row
        bra     .exit
}

// -----------------------------------------------
// PageCache_LruUnlink — remove a frame from the evictable LRU doubly-linked list.
// (private) In: d0.b = frame (preserved). Clobbers d1-d2/a3.
// d1 holds the constant cur byte-offset; every neighbour link is read/written via
// base(a3)+offset — no per-frame pointer register (the d0-d2/a0-a3 budget).
// -----------------------------------------------
proc PageCache_LruUnlink (d0: u8) clobbers(d1-d2/a3) {
        lea     Page_Frames, a3
        move.w  d0, d1
        lsl.w   #3, d1                           // cur offset (constant)
        // --- (prev)->next : if prev==FF Head=next else frame[prev].next = cur.next ---
        moveq   #0, d2
        move.b  PF_PREV(a3, d1.w), d2           // prev
        cmpi.w  #PAGE_NOT_RESIDENT, d2
        bne     .set_prevnext
        move.b  PF_NEXT(a3, d1.w), Page_LRU_Head
        bra     .next_side
    .set_prevnext:
        lsl.w   #3, d2                           // prev offset
        move.b  PF_NEXT(a3, d1.w), PF_NEXT(a3, d2.w)   // frame[prev].next = cur.next
    .next_side:
        // --- (next)<-prev : if next==FF Tail=prev else frame[next].prev = cur.prev ---
        moveq   #0, d2
        move.b  PF_NEXT(a3, d1.w), d2           // next
        cmpi.w  #PAGE_NOT_RESIDENT, d2
        bne     .set_nextprev
        move.b  PF_PREV(a3, d1.w), Page_LRU_Tail
        rts
    .set_nextprev:
        lsl.w   #3, d2                           // next offset
        move.b  PF_PREV(a3, d1.w), PF_PREV(a3, d2.w)   // frame[next].prev = cur.prev
        rts
}

// -----------------------------------------------
// PageCache_LruLinkTail — append a frame at the LRU tail (newest evictable end).
// (private) In: d0.b = frame (preserved). Clobbers d1-d2/a3.
// -----------------------------------------------
proc PageCache_LruLinkTail (d0: u8) clobbers(d1-d2/a3) {
        lea     Page_Frames, a3
        move.w  d0, d1
        lsl.w   #3, d1                           // cur offset
        move.b  #PAGE_NOT_RESIDENT, PF_NEXT(a3, d1.w)   // cur.next = FF
        moveq   #0, d2
        move.b  Page_LRU_Tail, d2               // old tail
        move.b  d2, PF_PREV(a3, d1.w)           // cur.prev = old tail
        cmpi.w  #PAGE_NOT_RESIDENT, d2
        bne     .have_tail
        move.b  d0, Page_LRU_Head               // list was empty -> head = cur
        bra     .set_tail
    .have_tail:
        lsl.w   #3, d2                           // old tail offset
        move.b  d0, PF_NEXT(a3, d2.w)           // oldtail.next = cur
    .set_tail:
        move.b  d0, Page_LRU_Tail
        rts
}

// -----------------------------------------------
// PageCache_Audit — DEBUG residency invariant check (spec §5). Recomputes every
// frame's refcount from the WHOLE tile-cache nametable and compares to pf_refcount;
// then walks the LRU list asserting each member is refcount-0, unpinned, and marked
// PF_IN_LRU with no cycle. raise_error on any mismatch. Runs at init (after the
// first full cache fill) and every PAGECACHE_AUDIT_INTERVAL frames during play. The
// ~4800-word walk is a rare, identifiable DEBUG-shape lag spike — measure
// Lag_Frame_Count on the non-audit frames.
// In: none   Out: none (raise_error on failure)   Clobbers: d0-d3/a0-a3
// -----------------------------------------------
pub proc PageCache_Audit () clobbers(d0-d3/a0-a3) {
    if DEBUG == 1 {
        lea     Page_Audit_Scratch, a0          // zero the per-frame scratch counters
        move.w  #PAGE_FRAMES-1, d0
    .zero:
        clr.w   (a0)+
        dbf     d0, .zero

        lea     Tile_Cache_Nametable, a0        // accumulate refcount per frame (skip tile 0)
        lea     Page_Audit_Scratch, a1
        move.w  #(TILE_CACHE_NT_SIZE/2)-1, d0
    .walk:
        move.w  (a0)+, d1
        andi.w  #NT_TILE_MASK, d1
        beq     .walk_next
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1      // frame id
        add.w   d1, d1                           // word stride
        addq.w  #1, (a1, d1.w)
    .walk_next:
        dbf     d0, .walk

        lea     Page_Audit_Scratch, a0          // compare recomputed vs stored, per frame
        lea     Page_Frames, a1
        move.w  #PAGE_FRAMES-1, d0
    .cmp:
        move.w  (a0)+, d1                       // recomputed
        cmp.w   PF_RC(a1), d1
        beq     .cmp_next
        raise_error "PageCache_Audit: pf_refcount != recomputed nametable count"
    .cmp_next:
        lea     sizeof(PageFrame)(a1), a1
        dbf     d0, .cmp

        lea     Page_Frames, a1                 // LRU walk: refcount 0, !pinned, PF_IN_LRU, no cycle
        moveq   #0, d0
        move.b  Page_LRU_Head, d0               // cursor
        moveq   #0, d2                          // visited count (cycle bound)
    .lru:
        cmpi.b  #PAGE_NOT_RESIDENT, d0
        beq     .lru_done
        addq.w  #1, d2
        cmpi.w  #PAGE_FRAMES, d2
        bls     .lru_ok_count
        raise_error "PageCache_Audit: LRU list longer than PAGE_FRAMES (cycle)"
    .lru_ok_count:
        move.w  d0, d1
        lsl.w   #3, d1
        lea     (a1, d1.w), a3                  // &frame[cursor]
        tst.w   PF_RC(a3)
        beq     .lru_rc_ok
        raise_error "PageCache_Audit: LRU member has refcount>0"
    .lru_rc_ok:
        move.b  PF_FLAGS(a3), d3
        btst    #PF_IN_LRU_BIT, d3
        bne     .lru_inlru_ok
        raise_error "PageCache_Audit: LRU member missing PF_IN_LRU"
    .lru_inlru_ok:
        btst    #PF_PINNED_BIT, d3
        beq     .lru_pin_ok
        raise_error "PageCache_Audit: pinned frame in the LRU list"
    .lru_pin_ok:
        moveq   #0, d0
        move.b  PF_NEXT(a3), d0                 // advance
        bra     .lru
    .lru_done:
    }
        rts
}
