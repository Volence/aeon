// engine/level/page_cache.emp — Art-streaming Phase 2 (P2b Task 6): the VRAM
// page-frame residency cache.
//
// The FG art window (POOL_TILE_CEILING tiles) is carved into PAGE_FRAMES fixed
// 64-tile frames. A page id -> frame map (Page_Table) plus per-frame bookkeeping
// (Page_Frames[]) turns "which 64-tile pool page lives in which VRAM slot" into a
// runtime residency question. Blocks entering the 80x60 tile cache are patched
// logical(global)->physical(frame) at the copy sites (engine.tile_cache) and their
// pages ref-counted; a page whose refcount is 0 and is not pinned is an eviction
// candidate (van Waveren SVT free/evictable/locked states adapted: a frame is
// FREE-listed, PF_EVICTABLE (stamped, age-scanned at eviction), or neither —
// referenced/pinned/detached). Eviction order is the pf_stamp age, not a list.
//
// SAFETY INVARIANT (spec §5): pf_refcount counts nametable words currently in the
// tile cache that reference the frame. Eviction only of refcount-0 unpinned frames
// => a physical index baked into a live cache word can never dangle. The audit
// (PageCache_Audit, DEBUG) recomputes every frame's refcount from the whole
// nametable and compares — the machine check on that invariant.
//
// TWO REGIMES (streaming fix F1). The above is the GENERAL regime. An act that is
// fully resident AND whose Page_Table is the IDENTITY (Level_LoadArt verifies both
// and latches PageCache_Direct_Map) can never evict, so refcounts are not a live
// quantity there and physical == global for every word: the copy-site patch runs
// take a collapsed variant that skips the page->frame indirection and the refcount
// pair entirely. The invariant above is not weakened, it is VACUOUS in that regime,
// and PageCache_Audit checks the three that replace it instead of a number nobody
// writes. A THIRD, transient regime (streaming-lag fix, 2026-09-25): a STREAMING act
// whose resident set is still exactly its bulk-loaded block [0, PAGE_FRAMES_CLAMP) at
// identity takes the same collapsed loop plus one residency compare
// (pc_patch_run_bounded), until its first frame allocation ends it and rebuilds the
// refcounts (PageCache_EndBoundedRegime). A FOURTH (resident plain copy, 2026-09-26):
// the F1 regime on an act whose words were baked PHYSICAL — the run is a plain word
// copy with no map read (pc_patch_run_plain; see there for why it is exact). Every
// other proc in this module is regime-independent.
//
// REGISTER BUDGET (contract-critical): PageCache_AllocFrame + PageCache_Publish are
// reached from PageIn_Process, whose license is VSync_Wait's decoder union
// d0-d2/a0-a3 — and Level_LoadArt keeps a4/d5-d7 LIVE across VSync_Wait. So the
// procs on that path (AllocFrame, Publish) clobber ONLY
// d0-d2/a0-a3: they address Page_Frames as base(a3)+offset(dn) with an offsetof
// field displacement, never a per-frame pointer in a4. The patch-run primitives
// (PatchRun_Seq/_Col) are reached only from the copy sites and movem-bank their
// working set once per run, so they are free of that constraint.
//
// D2 (no unified arbiter): this tier owns its own residency governor; no shared
// cost ledger. The §7.2 adoption seam is a DOCUMENTED comment in the
// Tile_Cache_Fill budget area (engine.tile_cache) + ARCH prose (Task 12) — never
// built here.
//
// PLACEMENT NOTE: every proc below emits as ONE contiguous section behind the
// module head-label PageCache_Init (one-section-per-module rule; map.toml's
// `order` carries the single entry PageCache_Init).
module engine.page_cache in page_cache

use engine.structs.{PageManifest, PageFrame}
use engine.constants.{PAGE_FRAMES, PAGE_FRAMES_CLAMP, PAGE_TABLE_MAX, PAGE_NOT_RESIDENT}
use engine.constants.{PF_PINNED_BIT, PF_EVICTABLE_BIT, PF_PINNED, PF_EVICTABLE, ART_PAGE_FLAG_PINNED_BIT}
use engine.constants.{PF_DEMAND_HELD_BIT, PF_DEMAND_HELD}
use engine.constants.{NT_TILE_MASK, NT_ATTR_MASK, PAGE_FRAME_TILE_SHIFT, PAGE_FRAME_TILE_MASK}
use engine.constants.{PGRQ_DEMAND, PGRQ_DEMAND_BIT, PGRQ_PREFETCH, PAGE_PREFETCH_MAX, TILE_CACHE_NT_SIZE}
use engine.constants.{BLOCK_NT_SIZE, BLOCK_TILE_SIZE, BLOCK_TILE_SHIFT, TILE_CACHE_STRIDE}
use engine.constants.{BLOCKS_PER_SECTION_AXIS, BLOCKS_PER_SECTION_SHIFT, SECTION_SIZE_SHIFT}
use engine.constants.{BLOCK_STAGE_SLOTS, PAGE_FRAMES_MAX}
use engine.constants.{PAGECACHE_AUDIT_INTERVAL, PAGE_AUDIT_FULL, PAGE_AUDIT_TICK, PAGE_AUDIT_IDLE}
use engine.constants.{SCREEN_HEIGHT, VDP_HV_COUNTER}
use engine.constants.{PAGECACHE_DIRECT_RESIDENT, PAGECACHE_DIRECT_BOUNDED, PAGECACHE_DIRECT_PLAIN}

// The patch runs select their loop with `tst.b PageCache_Direct_Map / bmi / bne`, so
// the RESIDENT and PLAIN values must be negative bytes (one `cmpi.b` inside the `bmi`
// arm tells them apart) and BOUNDED a positive non-zero one. PageCache_Audit takes its
// latched arm on any non-zero value, which is right for all three. The bounded loop's
// residency bound is an immediate word.
ensure(PAGECACHE_DIRECT_RESIDENT >= $80 && PAGECACHE_DIRECT_RESIDENT <= $FF && PAGECACHE_DIRECT_PLAIN >= $80 && PAGECACHE_DIRECT_PLAIN <= $FF && PAGECACHE_DIRECT_PLAIN != PAGECACHE_DIRECT_RESIDENT && PAGECACHE_DIRECT_BOUNDED >= 1 && PAGECACHE_DIRECT_BOUNDED < $80,
       "PageCache_Direct_Map's latched values must split on the sign bit (RESIDENT and PLAIN negative and distinct, BOUNDED positive non-zero)")
ensure(PAGE_FRAMES_CLAMP << PAGE_FRAME_TILE_SHIFT <= NT_TILE_MASK + 1,
       "the bounded patch loop's residency bound PAGE_FRAMES_CLAMP << PAGE_FRAME_TILE_SHIFT must be a physical tile index bound")

// PageCache_Prefetch's resumable scan (streaming-lag fix, 2026-09-25) spells three
// facts by shape rather than by loop: the proof cursors are cleared with four clr.l
// (BLOCK_STAGE_SLOTS bytes), a row's byte offset is `row << (BLOCK_TILE_SHIFT+1)`, and
// a Page_Table entry is tested with `tst.b / bmi` (PAGE_NOT_RESIDENT must be the ONLY
// negative byte, so every real frame index must stay below $80).
ensure(BLOCK_STAGE_SLOTS == 16, "PageCache_Prefetch clears Page_Pfx_Scan_Pos with FOUR clr.l (16 bytes) — re-derive that unroll if BLOCK_STAGE_SLOTS moves (BLOCK_STAGE_SLOTS = {BLOCK_STAGE_SLOTS})")
ensure(BLOCK_TILE_SIZE * 2 == 1 << (BLOCK_TILE_SHIFT + 1) && BLOCK_NT_SIZE == BLOCK_TILE_SIZE * BLOCK_TILE_SIZE * 2,
       "PageCache_Prefetch's row offset `row << (BLOCK_TILE_SHIFT+1)` assumes a staged block row is BLOCK_TILE_SIZE words")
ensure(PAGE_NOT_RESIDENT >= $80 && PAGE_NOT_RESIDENT <= $FF && PAGE_FRAMES_MAX <= $80,
       "PageCache_Prefetch tests residency with `tst.b / bmi`: PAGE_NOT_RESIDENT must be a negative byte and every frame index a non-negative one")
// The general patch loop reads Page_Table with `move.b (a3,d2.w),d2 / bmi` and uses d2
// as a WORD frame index with no zero-extend: sound only while a page id's high byte is
// 0, i.e. every in-bounds page id is < 256.
ensure(PAGE_TABLE_MAX <= 256, "pc_patch_run_loop drops the frame zero-extend: a page id must fit a byte (PAGE_TABLE_MAX = {PAGE_TABLE_MAX})")

// ---- LS-8 family pins: the hand-spelled decompose literals in THIS module ----
// PageCache_Prefetch_Strips decomposes a world tile coord into (sec_x, sec_y,
// block_index) twice — once for the row strip, once for the col strip — and both
// copies hand-spell the geometry the block-align lines two rows above spell by NAME
// (`#~(BLOCK_TILE_SIZE-1)`, `#BLOCK_TILE_SIZE`). These are the TWINS of the pins at
// the head of engine/level/tile_cache.emp; they are deliberately independent so
// either module fires on its own. (2026-09-10, lens-sweep row LS-8.)

ensure(BLOCKS_PER_SECTION_AXIS - 1 == $F && (1 << BLOCKS_PER_SECTION_SHIFT) == BLOCKS_PER_SECTION_AXIS,
       "BLOCKS-PER-SECTION MOVED (BLOCKS_PER_SECTION_AXIS = {BLOCKS_PER_SECTION_AXIS}) AND PageCache_Prefetch_Strips STILL HAND-SPELLS THE 16-BLOCK LITERALS. Derived: intra-section block mask = BLOCKS_PER_SECTION_AXIS-1 = {BLOCKS_PER_SECTION_AXIS - 1}, and the block_index row scale = BLOCKS_PER_SECTION_AXIS = 1 << BLOCKS_PER_SECTION_SHIFT ({BLOCKS_PER_SECTION_SHIFT}). RESPELL SIX SITES, all in PageCache_Prefetch_Strips: `andi.w #$F` x2 + `lsl.w #4` x1 in the ROW strip, and the same trio in the COL strip -> `#BLOCKS_PER_SECTION_AXIS-1` and `#BLOCKS_PER_SECTION_SHIFT`. Note the trap this module walks past twice: the `lsr.w #BLOCK_TILE_SHIFT` immediately ABOVE each mask is a DIFFERENT constant that is also 4 today, so a reader respelling by eye can mask a block index with the tile shift and see nothing. WHAT THIS PIN DOES NOT COVER: the identical trio x2 in engine/level/tile_cache.emp (decompose_block and TileCache_FillAll), which carry the twin of this pin; the `lsr.w #8` section shifts in this module, pinned below; and the block-tile literals, which this module already spells by name")

ensure(BLOCK_TILE_SHIFT + BLOCKS_PER_SECTION_SHIFT == 8 && BLOCK_TILE_SHIFT + BLOCKS_PER_SECTION_SHIFT == SECTION_SIZE_SHIFT - 3,
       "THE WORLD-TILE TO SECTION SHIFT MOVED OFF 8 AND PageCache_Prefetch_Strips HAND-SPELLS `lsr.w #8` FOUR TIMES (two per strip: the target's own axis and the scanned axis). Derived two independent ways, and BOTH must hold: a section is BLOCKS_PER_SECTION_AXIS blocks of BLOCK_TILE_SIZE tiles, so the shift is BLOCK_TILE_SHIFT + BLOCKS_PER_SECTION_SHIFT = {BLOCK_TILE_SHIFT} + {BLOCKS_PER_SECTION_SHIFT}; and a section is SECTION_SIZE px of 8 px tiles, so it is SECTION_SIZE_SHIFT - 3 = {SECTION_SIZE_SHIFT} - 3. WHAT THIS PIN DOES NOT COVER: the five `lsr.w #8` in engine/level/tile_cache.emp and the one `lsl.w #8` in engine/level/section.emp, which carry their own twins; and the `andi.w #7` page-bit masks in this module, which are bits-per-byte and have nothing to do with section geometry")

// Every callee is .emp-owned and resolves at link — no boundary decls:
// PageIn_Flush / PageIn_Enqueue (engine.page_in), TileCache_FindStagedBlock
// (engine.tile_cache — the page prefetch probes the staged ahead-strip blocks). RAM
// (Page_Table / Page_Frames / Page_Queued_Bits / Page_Free_Head /
// PageIn_Pool_Table / PageIn_Cur_Flags / Page_Pfx_Budget / the Cache_Pfx_*_Target +
// Cache_Left_Col/Head_Col/Top_Row/Bottom_Row prefetch signals) resolves bare.

// sizeof(PageFrame) must stay the power-of-two 8 so a frame id scales to its
// Page_Frames byte offset with a shift, not a multiply.
ensure(sizeof(PageFrame) == 8, "PageFrame must be 8 bytes so `frame*sizeof` is `lsl #3`")
// sizeof(PageManifest) has the twin ensure beside its other stride site
// (engine.page_in); the Publish walk here strides it with the same `lsl #3`.
ensure(sizeof(PageManifest) == 8, "PageManifest must be 8 bytes so `page*sizeof` is `lsl #3`")

// DEBUG audit snapshot geometry: 4 header bytes + the first SNAP_TABLE_ENTRIES
// Page_Table bytes + 2 bytes per frame must fit the Page_Audit_Snapshot array
// (engine/ram.emp) — a PAGE_FRAMES bump past the buffer would silently overrun
// the adjacent DEBUG vars in exactly the shape the snapshot exists to debug.
const SNAP_TABLE_ENTRIES = 16
ensure(4 + SNAP_TABLE_ENTRIES + 2 * PAGE_FRAMES <= 52, "Page_Audit_Snapshot[52] overflow — grow the ram.emp array with PAGE_FRAMES")

// DEBUG audit slicing (audit-amortise, 2026-09-26; PageCache_Audit's header has the
// why). In a latched regime the nametable half of the audit is cut into
// PAGE_AUDIT_SLICES slices of PAGE_AUDIT_SLICE_WORDS words that VSync_Wait's idle slot
// audits while the frame has room; the interval tick audits whatever it did not reach.
// 40 words keeps one slice's price (below) small against the idle a frame usually has.
const PAGE_AUDIT_SLICE_WORDS = 40
const PAGE_AUDIT_SLICE_BYTES = PAGE_AUDIT_SLICE_WORDS * 2
const PAGE_AUDIT_SLICES      = (TILE_CACHE_NT_SIZE / 2) / PAGE_AUDIT_SLICE_WORDS
ensure(PAGE_AUDIT_SLICES * PAGE_AUDIT_SLICE_WORDS == TILE_CACHE_NT_SIZE / 2,
       "PAGE_AUDIT_SLICE_WORDS ({PAGE_AUDIT_SLICE_WORDS}) must divide the nametable's word count, or the last slice reads past Tile_Cache_Nametable / leaves words unaudited")
ensure((PAGE_AUDIT_SLICES - 1) * PAGE_AUDIT_SLICE_BYTES <= $7FFF,
       "the slice offset is added with a sign-extending adda.w")
// The idle gate: a slice starts only at or above this scanline. PRICED BY HAND from the
// instruction timings (68000 manual), 2026-09-26: the frame mask ~56 cycles x
// PAGE_FRAMES (672), the fast walk 170 cycles per 4-word group x 10 groups (1700), the
// gate + slice bookkeeping + call ~250: ~2,650 cycles = 5.4 scanlines at 488 cycles a
// line (127,840 / 262). The margin is twice that, rounded up to 12 lines, so a slice
// that passes the gate ends before VBlank with room left for the VBlank_Flag race the
// .idle note describes. If the slice or PAGE_FRAMES grows, re-price this.
// How long the idle slot may leave a due slice before the TICK call audits it in-tick
// (PageCache_Audit, PACING). It widens the latency bound from INTERVAL to
// INTERVAL + SLACK ticks and buys a sweep that rides out that many consecutive
// idle-starved (lagging) ticks without adding work to the tick.
const PAGE_AUDIT_SLACK_TICKS = 8
ensure(PAGECACHE_AUDIT_INTERVAL - 1 - (PAGE_AUDIT_SLACK_TICKS + 1) <= PAGE_AUDIT_SLICES,
       "the TICK call's overdue bound must never pass the last slice (it would write a cursor past PAGE_AUDIT_SLICES)")
ensure(PAGE_AUDIT_SLICES <= PAGECACHE_AUDIT_INTERVAL - 1,
       "every slice must become due before the interval tick, or the pacing never lets the idle slot reach it")
const PAGE_AUDIT_IDLE_MARGIN_LINES = 12
const PAGE_AUDIT_IDLE_LAST_LINE    = SCREEN_HEIGHT - PAGE_AUDIT_IDLE_MARGIN_LINES
ensure(PAGE_AUDIT_SLICE_WORDS == 40 && PAGE_FRAMES <= 12,
       "PAGE_AUDIT_IDLE_MARGIN_LINES was priced for a 40-word slice over <= 12 frames — re-price it (see its note) before changing either")
ensure(PAGE_AUDIT_SLICE_WORDS % 4 == 0 && (TILE_CACHE_NT_SIZE / 2) % 4 == 0, "the dangling walk is unrolled 4-way: every run it is given must be whole groups of 4 words")
ensure(PAGE_AUDIT_SLICE_WORDS / 4 <= 128, "the slice group count is loaded with moveq")
ensure(PAGE_FRAMES <= 32, "PageCache_Audit's dangling walk keeps one mask bit per frame in a 32-bit register")
ensure((NT_TILE_MASK >> PAGE_FRAME_TILE_SHIFT) <= 31, "a nametable frame id must index the 32-bit dangling mask")
ensure(PAGE_AUDIT_FULL == 0 && PAGE_AUDIT_TICK == 1 && PAGE_AUDIT_IDLE > 1,
       "PageCache_Audit dispatches on d0 == 0 (FULL), then d0 - 1 == 0 (TICK), else IDLE")

// Page_Demand_Held's values (PageCache_Publish sets NEW, PageCache_DemandHoldTick ages it
// to SEEN and clears it; 0 = no frame carries PF_DEMAND_HELD).
const PAGE_HELD_NEW  = 1
const PAGE_HELD_SEEN = 2

// Field displacements for the base(a3)+offset(dn) addressing (never baked literals).
const PF_PAGE  = offsetof(PageFrame, pf_page)
const PF_RC    = offsetof(PageFrame, pf_refcount)
const PF_STAMP = offsetof(PageFrame, pf_stamp)
const PF_NEXT  = offsetof(PageFrame, pf_next)
const PF_FLAGS = offsetof(PageFrame, pf_flags)

// -----------------------------------------------
// PageCache_Init — reset residency to "empty, all frames free" for an act load.
//
// Calls PageIn_Flush first (Task 4 caller rule: an act/level transition clears
// pending page-in work before the cache is rebuilt). Pages are NOT loaded here —
// Level_LoadArt drives the pool load through the page-in path and page-in's
// completion (PageCache_Publish) fills Page_Table + marks pinned from the manifest.
// This proc only clears the tables and threads the free list.
//
// In:  none          Out: none          Clobbers: d0-d1/a0
// -----------------------------------------------
pub proc PageCache_Init () clobbers(d0-d1/a0) {
        jbsr    PageIn_Flush                    // cancel any in-flight/queued page-in work first
        clr.b   PageIn_Bulk_Drain               // defensive: no bulk drain in progress across an act reset
                                                // (Level_LoadArt re-arms it around its own load below)
        // F1: the DIRECT-MAP patch regime is FALSE for the whole of an act load —
        // Level_LoadArt re-latches it only once the pool has landed and Page_Table
        // is proven to be the identity. Clearing it here (not in Level_LoadArt) is
        // what stops the PREVIOUS act's latch surviving into this act's first
        // fills: the general loop is always correct, the direct one only under the
        // proof, so the safe value is the one that costs cycles.
        clr.b   PageCache_Direct_Map
        // Every page is about to be non-resident: the prefetch scan's row proofs
        // (Page_Pfx_Scan_Pos) are all void. One bump; the scan clears at its next sync.
        addq.w  #1, Page_Evict_Gen

        lea     Page_Table, a0                 // Page_Table[..] = PAGE_NOT_RESIDENT
        move.w  #PAGE_TABLE_MAX-1, d0
    .clr_table:
        move.b  #PAGE_NOT_RESIDENT, (a0)+
        dbf     d0, .clr_table

        lea     Page_Queued_Bits, a0            // Page_Queued_Bits[..] = 0
        move.w  #(PAGE_TABLE_MAX/8)-1, d0
    .clr_queued:
        clr.b   (a0)+
        dbf     d0, .clr_queued

        // Frames: ALL PAGE_FRAMES records initialized (pf_page $FFFF, refcount 0,
        // flags 0, stamp 0), chained through pf_next (0->1->...->N-1->FF) — the
        // FREE list is the only list left (F-1 stamp eviction: eviction order is
        // the pf_stamp age scan, not a linked list). The free list is TERMINATED
        // at frame PAGE_FRAMES_CLAMP-1 (== PAGE_FRAMES-1 in every shipped shape;
        // the STRESS_EVICT dev fixture clamps it below that): frames
        // [PAGE_FRAMES_CLAMP..PAGE_FRAMES) stay initialized (audit-clean,
        // unassigned) but UNREACHABLE from Page_Free_Head, so AllocFrame can never
        // hand out a clamped frame and the pool cannot be fully resident under the
        // fixture.
        lea     Page_Frames, a0
        moveq   #0, d1                          // running frame id (== next-link value)
        move.w  #PAGE_FRAMES-1, d0
    .init_frames:
        move.w  #$FFFF, PF_PAGE(a0)
        clr.w   PF_RC(a0)
        clr.w   PF_STAMP(a0)
        addq.w  #1, d1                          // next frame id
        move.b  d1, PF_NEXT(a0)                 // free-list link -> next
        clr.b   PF_FLAGS(a0)
        lea     sizeof(PageFrame)(a0), a0
        dbf     d0, .init_frames
        // terminate the free list at the last USABLE frame (PAGE_FRAMES_CLAMP-1); the
        // clamped tail's own links are left dangling but are never reached. a0 sits at
        // Page_Frames + PAGE_FRAMES*sizeof(PageFrame) here, so the terminator is at
        // displacement PF_NEXT + (CLAMP-1-PAGE_FRAMES)*sizeof (== PF_NEXT-sizeof at
        // CLAMP==PAGE_FRAMES, the unclamped case).
        move.b  #PAGE_NOT_RESIDENT, PF_NEXT + (PAGE_FRAMES_CLAMP-1-PAGE_FRAMES)*sizeof(PageFrame)(a0)
        move.b  #0, Page_Free_Head              // free list head = frame 0
        clr.b   Page_Demand_Held                // no demand hold survives an act reset (flags were cleared above)

    if DEBUG == 1 {
        // Page_Audit_Ticks = 0 is also what keeps the idle-slot sweep off until the level
        // state ticks again (PageCache_Audit, PACING): the pool was just reset while the
        // nametable may still hold the previous act's words.
        clr.w   Page_Audit_Ticks
        clr.w   Page_Audit_Slice
    }
        rts
}


// -----------------------------------------------
// PageCache_Request — enqueue a demand/prefetch page-in IF the page is neither
// resident nor already queued (the queued-marker bitset stops the FIFO being
// double-filled). A full FIFO clears the marker so a later frame re-requests.
// NOT on the PageIn_Process path (called from the copy-site miss + Task-7 prefetch).
//
// POOL-BOUNDS GUARD (soak backstop, chain 69): a page id past the act's pool must
// never reach the FIFO — the manifest stride (page*sizeof(PageManifest)) would walk
// off the act_art_pool_pages-entry table into adjacent ROM (garbage pm_source ->
// wrapper version 0, caught by the ZX0-form assert). A REAL reference can only yield
// page < pages, so an id >= pages is a bug in the caller. DEBUG raises loud; release
// silently skips (a prefetch/demand can never off-manifest the dispatcher).
// In: d0.w = page id, d1.w = flags (PGRQ_DEMAND)   Out: none   Clobbers: d0-d3/a0-a1
// -----------------------------------------------
pub proc PageCache_Request (d0: u16, d1: u16) clobbers(d0-d3/a0-a1) {
        cmp.w   PageIn_Pool_Pages, d0          // page id must index a real pool page (stored count,
        blo     .in_range                      // not Current_Act_Ptr which read null at gameplay)
    if DEBUG == 1 {
        raise_error "PageCache_Request: page_id >= act_art_pool_pages (off-manifest)"
    }
        rts                                     // release: silent no-op (never off-manifest)
    .in_range:
        lea     Page_Table, a0                  // resident already? -> nothing to do
        move.b  (a0, d0.w), d2
        cmpi.b  #PAGE_NOT_RESIDENT, d2
        bne     .done

        // in-flight already? (chain-73 belt-and-braces). The single decode slot's page,
        // while its decode/landing has not published yet (Page_Table above still says
        // NOT_RESIDENT). The continuous queued-bit claim already covers this; this is
        // the cheap explicit guard the double-load post-mortem asked for.
        cmp.w   PageIn_Cur_Page, d0
        bne     .not_inflight
        tst.b   PageIn_InFlight
        bne     .done
        tst.b   PageIn_Staging_Busy
        bne     .done
        tst.b   PageIn_Land_Pending
        bne     .done
    .not_inflight:

        move.w  d0, d2                          // already CLAIMED (in the FIFO / in-flight)?
        lsr.w   #3, d2                          // byte index (page/8)
        lea     Page_Queued_Bits, a1
        move.w  d0, d3
        andi.w  #7, d3                          // bit index (page&7)
        btst    d3, (a1, d2.w)
        bne     .done                           // already claimed -> dedup
    if DEBUG == 1 {
        btst    #PGRQ_DEMAND_BIT, d1
        beq     .no_dbg
        addq.w  #1, Dbg_PageCache_Demands
    .no_dbg:
    }
        // PageIn_Enqueue SETS the queued bit on success (the sole claim site, chain 73):
        // the claim is continuous from here to Publish, so no re-request double-loads.
        // On a full FIFO it leaves the page unclaimed, so a later frame re-requests.
        jbra    PageIn_Enqueue                  // tail (carry = dropped, ignored by callers)
    .done:
        rts
}

// -----------------------------------------------
// PageCache_AllocFrame — hand out a frame to load a page into.
//   free list first; else the oldest PF_EVICTABLE frame (refcount 0, !pinned
//   by construction — the stamp age scan);
//   else THRASH — DEBUG raise_error (a bug, not a policy); release returns
//   PAGE_NOT_RESIDENT for the caller to re-queue.
// The returned frame is DETACHED (out of every list), refcount 0, flags 0, and
// pf_page = $FFFF (UNASSIGNED) — it belongs to no page until PageCache_Publish stamps
// its new id, so the bijectivity audit's $FFFF-skip covers the whole in-flight decode
// window (chain-72 fix). The caller publishes it once its VRAM landing DMA is enqueued.
// Evicting a victim clears BOTH residency directions: the departing page's Page_Table
// entry + queued bit, and the frame's pf_page (via .detach).
// In: none   Out: d0.b = frame (or PAGE_NOT_RESIDENT)   Clobbers: d0-d2/a3
// -----------------------------------------------
pub proc PageCache_AllocFrame () clobbers(d1-d2/a3) out(d0: u8) {
        // The bounded-direct patch regime (streaming-lag fix, 2026-09-25) holds only
        // while the resident set is the bulk-loaded identity block, and it maintains
        // no refcounts. The first allocation after the latch is the first moment
        // either can change, so it ends the regime HERE, before any frame is handed
        // out or any victim chosen: the refcounts are rebuilt from the nametable, and
        // from now on every run takes the general loop.
        cmpi.b  #PAGECACHE_DIRECT_BOUNDED, PageCache_Direct_Map
        bne     .regime_ok
        jbsr    PageCache_EndBoundedRegime      // preserves every register
    .regime_ok:
        moveq   #0, d0
        move.b  Page_Free_Head, d0
        cmpi.b  #PAGE_NOT_RESIDENT, d0
        beq     .from_lru

        lea     Page_Frames, a3                 // pop the free-list head
        move.w  d0, d1
        lsl.w   #3, d1                           // frame byte offset
        move.b  PF_NEXT(a3, d1.w), Page_Free_Head   // free head advances
        bra     .detach

    .from_lru:
        // DEMAND-PROTECTION INVARIANT (Task 7): a demand-loaded page that has been
        // Published but not yet Ref'd by the resuming fill is NOT flagged
        // PF_EVICTABLE (see PageCache_Publish), so it is NEVER a candidate here.
        // That is what stops a second demand miss in the same frame from evicting
        // the just-published page out from under the resuming fill (which would
        // re-request the page it just evicted, forever). The hold is BOUNDED
        // (PF_DEMAND_HELD, released by PageCache_DemandHoldTick once a fill pass
        // ends without a stall), so a page the fill never wanted does not leak.
        // Every candidate is refcount-0/unpinned — safe to evict.
        // F-1 stamp eviction: victim = the OLDEST evictable frame — the max
        // unsigned (Frame_Counter - pf_stamp) among PF_EVICTABLE frames. An
        // O(PAGE_FRAMES) scan, paid only at eviction; it replaces the linked
        // list whose end-choice WAS the MRU bug (the policy is now structural).
        // blo-skip means age TIES replace the best — the LAST-seen (lowest
        // frame index; the scan descends) wins, deterministically; all-age-0
        // still selects a candidate.
        // Stamp wrap at 65536 frames (~18 min) can only mis-age a candidate —
        // every candidate is still refcount-0/unpinned, so safety never moves.
        lea     Page_Frames, a3
        move.w  #$FFFF, d0                       // best offset (sentinel: none found)
        clr.w   -(sp)                            // best age slot = 0
        move.w  #(PAGE_FRAMES-1)*sizeof(PageFrame), d1
    .ev_scan:
        btst    #PF_EVICTABLE_BIT, PF_FLAGS(a3, d1.w)
        beq     .ev_next
        move.w  Frame_Counter, d2
        sub.w   PF_STAMP(a3, d1.w), d2           // d2 = unsigned age
        cmp.w   (sp), d2
        blo     .ev_next                         // strictly younger than best -> skip
        move.w  d2, (sp)                         // new best age
        move.w  d1, d0                           // new best offset
    .ev_next:
        subq.w  #sizeof(PageFrame), d1
        bpl     .ev_scan
        addq.l  #2, sp                           // drop the best-age slot
        cmpi.w  #$FFFF, d0
        beq     .thrash
        move.w  d0, d1                           // d1 = victim byte offset
        lsr.w   #3, d0                           // d0 = victim frame id (sizeof ensure'd 8)
    if DEBUG == 1 {
        tst.w   PF_RC(a3, d1.w)
        beq     .victim_ok
        raise_error "PageCache_AllocFrame: evictable frame refcount>0 (flag corruption)"
    .victim_ok:
    }
        move.w  PF_PAGE(a3, d1.w), d2           // departing page id
        // A page leaves residency: every "row proven all-resident" the prefetch scan
        // holds may now be false (it does not know which blocks referenced this page).
        // Register-free, so this proc's d1-d2/a3 contract is untouched.
        addq.w  #1, Page_Evict_Gen
        lea     Page_Table, a3
        move.b  #PAGE_NOT_RESIDENT, (a3, d2.w)  // Page_Table[page] = NOT_RESIDENT
        move.w  d2, d1                          // clear its queued bit too
        lsr.w   #3, d1
        lea     Page_Queued_Bits, a3
        andi.w  #7, d2
        bclr    d2, (a3, d1.w)
        lea     Page_Frames, a3                 // re-derive base+offset for .detach
        move.w  d0, d1
        lsl.w   #3, d1

    .detach:
        // pf_page := $FFFF (UNASSIGNED) — soak fix chain 72. An allocated frame is
        // detached here and stays so until PageCache_Publish stamps its new page id;
        // during that in-flight window (decode across VBlanks) the frame belongs to NO
        // page. Leaving the victim's STALE pf_page made the bijectivity audit fail
        // (frame.pf_page -> Page_Table[that page] was cleared at eviction -> no round-
        // trip). Sentinelling it makes the invariant true at EVERY instant: the audit's
        // pf_page==$FFFF skip covers the in-flight frame. (Eviction already cleared the
        // OTHER direction, Page_Table[victim], above; this closes both directions here.)
        // Free-list allocs already carry $FFFF from Init — this is a no-op for them.
        move.w  #$FFFF, PF_PAGE(a3, d1.w)
        move.b  #PAGE_NOT_RESIDENT, PF_NEXT(a3, d1.w)
        clr.w   PF_STAMP(a3, d1.w)
        clr.w   PF_RC(a3, d1.w)
        clr.b   PF_FLAGS(a3, d1.w)              // clears PF_EVICTABLE: detached = not a candidate
        rts

    .thrash:
    if DEBUG == 1 {
        raise_error "PageCache_AllocFrame: no free/evictable frame (thrash bug)"
    }
        move.b  #PAGE_NOT_RESIDENT, d0          // $FF sentinel (moveq can't hold 255)
        rts
}

// -----------------------------------------------
// PageCache_FreeFrame — B&R rollback twin of AllocFrame: return a DETACHED frame
// (pf_page $FFFF, in no reclaim list) to the free list. A dispatch that
// allocated but could not start/queue its page-in MUST hand the frame back —
// a detached frame is unreachable from both reclaim lists AND exempt from the
// orphan audit (its $FFFF skip covers the in-flight frame), so a leak here is
// permanent and invisible until PageCache_Init.
// In: d0.b = frame (preserved)   Out: none   Clobbers: d1-d2/a3
// -----------------------------------------------
pub proc PageCache_FreeFrame (d0: u8) clobbers(d1-d2/a3) {
        lea     Page_Frames, a3
        moveq   #0, d1
        move.b  d0, d1
        lsl.w   #3, d1                           // frame byte offset
    if DEBUG == 1 {
        cmpi.w  #$FFFF, PF_PAGE(a3, d1.w)       // only a DETACHED frame may be freed
        beq     .detached_ok
        raise_error "PageCache_FreeFrame: frame not detached (pf_page != $FFFF)"
    .detached_ok:
    }
        move.b  Page_Free_Head, d2                  // (via d2: abs+indexed in one op is a sigil gap)
        move.b  d2, PF_NEXT(a3, d1.w)               // frame.next = old free head
        move.b  d0, Page_Free_Head                  // free head = frame
        rts
}

// -----------------------------------------------
// PageCache_EndBoundedRegime — leave the bounded-direct patch regime (streaming-lag
// fix, 2026-09-25) for the general one. Called ONLY from PageCache_AllocFrame's
// entry, while PageCache_Direct_Map == PAGECACHE_DIRECT_BOUNDED.
//
// The bounded loop maintained no refcounts, so they are rebuilt here from the one
// ground truth the audit also uses: every non-blank word of Tile_Cache_Nametable
// references the frame (index >> PAGE_FRAME_TILE_SHIFT) it names. Nothing else in the
// engine holds a physical index (the refcount invariant, spec §5). Then each ASSIGNED,
// unpinned frame gets the candidacy the general loop would have given it: referenced
// -> not PF_EVICTABLE; unreferenced -> PF_EVICTABLE, keeping its stamp if it already
// was one (a bulk-published page is, from its publish) or stamping it NOW if not. The
// post-state is exactly the general regime's invariant set, which PageCache_Audit
// checks on its next pass.
//
// Cost: one walk of TILE_CACHE_NT_SIZE/2 words, ONCE per act load at most (the
// regime never re-latches mid-act). Measured in the parcel's run (see ARCH §9.7): it
// lands on the first page-in past the bulk-loaded block, i.e. where the camera first
// nears a page outside it. Not sliced: it runs in the VSync_Wait idle slot like the
// rest of AllocFrame's callers and may overrun one VBlank there, once.
//
// On the PageIn_Process path, so it preserves every register it touches (the path's
// license is d0-d2/a0-a3 and AllocFrame's own contract is narrower still).
// In: none   Out: none   Clobbers: () — preserves d0-d2/a0-a1
// -----------------------------------------------
pub proc PageCache_EndBoundedRegime () clobbers() preserves(d0-d2/a0-a1) {
        movem.l d0-d2/a0-a1, -(sp)
        clr.b   PageCache_Direct_Map            // from here on every run takes the general loop

        lea     Page_Frames, a1                 // zero every refcount (defensive: nothing wrote them)
        moveq   #PAGE_FRAMES-1, d0
    .zero_rc:
        clr.w   PF_RC(a1)
        lea     sizeof(PageFrame)(a1), a1
        dbf     d0, .zero_rc

        lea     Tile_Cache_Nametable, a0        // count every live physical reference
        lea     Page_Frames, a1
        move.w  #(TILE_CACHE_NT_SIZE/2)-1, d0
    .walk:
        move.w  (a0)+, d1
        andi.w  #NT_TILE_MASK, d1
        beq     .walk_next                      // blank: no reference
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1      // frame id
        lsl.w   #3, d1                          // * sizeof(PageFrame)
        addq.w  #1, PF_RC(a1, d1.w)
    .walk_next:
        dbf     d0, .walk

        move.w  Frame_Counter, d2               // one release time for the newly-unreferenced
        lea     Page_Frames, a1
        moveq   #PAGE_FRAMES-1, d0
    .frame:
        cmpi.w  #$FFFF, PF_PAGE(a1)
        beq     .frame_next                     // unassigned: not a candidate, nothing to set
        btst    #PF_PINNED_BIT, PF_FLAGS(a1)
        bne     .frame_next                     // pinned: never a candidate
        tst.w   PF_RC(a1)
        beq     .unreferenced
        bclr    #PF_EVICTABLE_BIT, PF_FLAGS(a1) // referenced: never a candidate
        jbra    .frame_next
    .unreferenced:
        bset    #PF_EVICTABLE_BIT, PF_FLAGS(a1)
        bne     .frame_next                     // already a candidate: keep its release stamp
        move.w  d2, PF_STAMP(a1)                // newly a candidate: released now
    .frame_next:
        lea     sizeof(PageFrame)(a1), a1
        dbf     d0, .frame
        movem.l (sp)+, d0-d2/a0-a1
        rts
}

// -----------------------------------------------
// PageCache_Publish — mark a just-landed page resident in its frame. Called by
// engine.page_in the instant a page's VRAM landing DMA is enqueued. Fills
// Page_Table, stamps the frame's page id, applies the manifest's pinned flag, links
// a non-pinned frame an eviction candidate (stamp + PF_EVICTABLE), and clears the
// queued marker.
// (On the PageIn_Process path -> d0-d2/a0-a3 only.)
//
// DEMAND-PROTECTION (Task 7, by construction): a SPECULATIVE (prefetch/bulk) page is
// flagged PF_EVICTABLE (+stamped) immediately — a cold prefetched page must be
// reclaimable if it is never referenced. A DEMAND page (PageIn_Cur_Flags PGRQ_DEMAND)
// is instead HELD: not a candidate, refcount 0, PF_DEMAND_HELD set. AllocFrame's
// candidate scan therefore cannot evict it before the resuming fill references it
// (the deadlock the plan flags). The first Ref (0->1) leaves it referenced; a later
// full Unref (1->0) stamps + flags it normally.
//
// THE HOLD ENDS (stressart-halts GPL-2, 2026-09-26). Task 7 assumed the resuming fill
// always references the page. It need not: the words that missed can be overwritten
// before the page lands (measured on STRESS_ART's diagonal: the camera flew into empty
// sky, the stall cleared while the page was still decoding, and the page sat assigned,
// unreferenced and unflagged for 65 frames — unreachable by every reclaim path, i.e.
// leaked, until the orphan audit raised). So the hold is bounded: PF_DEMAND_HELD marks
// the frame, Page_Demand_Held arms PageCache_DemandHoldTick, and the first fill pass
// that SAW the page resident and ended WITHOUT a demand stall releases every held frame
// still unreferenced as an ordinary candidate. While the fill keeps stalling, the hold
// stands, which is the whole of what the protection was for. (See the matching
// invariant note at AllocFrame's .from_lru arm.)
// In: d0.w = page id, d1.b = frame idx   Out: none   Clobbers: d0-d2/a0/a3
// -----------------------------------------------
pub proc PageCache_Publish (d0: u16, d1: u8) clobbers(d0-d2/a0/a3) {
        move.w  d0, d2                          // clear the queued marker (page resident now)
        lsr.w   #3, d2
        lea     Page_Queued_Bits, a0
        lea     (a0, d2.w), a0
        move.w  d0, d2
        andi.w  #7, d2
        bclr    d2, (a0)

        lea     Page_Table, a0                  // Page_Table[page] = frame
    if DEBUG == 1 {
        // DUPLICATE-PUBLISH catcher (chain 73): a page must be published exactly once
        // per load — its Page_Table entry must be NOT_RESIDENT here. A second publish
        // (the dedupe claim-gap bug) would overwrite the entry and orphan the first
        // frame (fatal for a PINNED page). This raise_error names the bug at its site.
        cmpi.b  #PAGE_NOT_RESIDENT, (a0, d0.w)
        beq     .pub_not_resident
        raise_error "PageCache_Publish: page already resident (duplicate publish / dedupe gap)"
    .pub_not_resident:
    }
        move.b  d1, (a0, d0.w)

        movea.l PageIn_Pool_Table, a0           // manifest base (set by Level_LoadArt; live-read-confirmed correct)
        move.w  d0, d2
        lsl.w   #3, d2                           // page * sizeof(PageManifest)=8
        lea     (a0, d2.w), a0                  // a0 = &manifest[page] (read pm_flags below)

        lea     Page_Frames, a3                 // frame fields via base+offset
        // frame*8 offset: ZERO-EXTEND d1 first. The caller (page_in) sets d1 via
        // `move.b PageIn_Cur_Frame, d1`, so d1's upper byte is STALE; a `move.w d1,d2`
        // would fold that garbage into the offset (frame*8 -> wild address), and every
        // frame-record write (pf_page, refcount, flags) would miss its record — the
        // Task-6 boot bug (pf_page $FFFF everywhere, pinned flags never set).
        moveq   #0, d2
        move.b  d1, d2                          // d2 = frame (0..14), clean
        lsl.w   #3, d2                           // d2 = frame * sizeof(PageFrame)=8
        move.w  d0, PF_PAGE(a3, d2.w)           // pf_page = page (d0 still = page)
        clr.w   PF_RC(a3, d2.w)

        move.b  PageManifest.pm_flags(a0), d0   // pm_flags (page no longer needed)
        btst    #ART_PAGE_FLAG_PINNED_BIT, d0
        beq     .not_pinned
        move.b  #PF_PINNED, PF_FLAGS(a3, d2.w)  // pinned: never an eviction candidate
        rts
    .not_pinned:
        // DEMAND-PROTECTION: a demand page is HELD (not PF_EVICTABLE) until the
        // stalled fill's first Ref or PageCache_DemandHoldTick's release, whichever
        // comes first — so AllocFrame's candidate scan cannot evict it before the
        // fill has had its pass at it. Flags/refcount are already the detached state
        // (0/0 from AllocFrame .detach).
        clr.b   PF_FLAGS(a3, d2.w)             // defensive: guarantee no stale PF_PINNED
        btst    #PGRQ_DEMAND_BIT, PageIn_Cur_Flags
        beq     .speculative
        bset    #PF_DEMAND_HELD_BIT, PF_FLAGS(a3, d2.w)   // demand -> held (protected, bounded)
        move.b  #PAGE_HELD_NEW, Page_Demand_Held          // the next fill pass is the first to see it
        rts
    .speculative:
        // SPECULATIVE (prefetch/bulk): immediately an eviction candidate — a cold
        // prefetched page must be reclaimable if it is never referenced. Flag +
        // stamp NOW (F-1): the stamp makes it the NEWEST candidate, so it is
        // evicted only after every older release — the prefetch-churn shape the
        // old tail-pop had is structurally gone.
        move.w  Frame_Counter, d0               // (via d0: abs-sym + indexed in one op is a sigil gap)
        move.w  d0, PF_STAMP(a3, d2.w)
        bset    #PF_EVICTABLE_BIT, PF_FLAGS(a3, d2.w)
        rts
}

// -----------------------------------------------
// PageCache_DemandHoldTick — end the demand holds the fill no longer needs
// (stressart-halts GPL-2 fix, 2026-09-26; PageCache_Publish's header has the why).
// Called by Tile_Cache_Fill once per fill pass, AFTER its same-frame gate and BEFORE
// it clears Cache_Art_Stall, so Cache_Art_Stall still holds the PREVIOUS pass's result;
// the caller skips the call while Page_Demand_Held is 0.
//
//   NEW  -> SEEN: a hold was published since the previous pass began. The pass about to
//               run is the first to see the page resident; nothing is decided yet.
//   SEEN, previous pass stalled -> keep every hold: the fill is still waiting on a page,
//               and the held ones may be what its resume needs next.
//   SEEN, previous pass did not stall -> release. That pass saw every held page
//               resident and wanted nothing it could not have, so a held frame still at
//               refcount 0 is one nothing wants: it becomes an ordinary candidate
//               (PF_EVICTABLE + stamped now, the newest, so evicted after every older
//               release). A held frame the fill DID reference just drops the mark; its
//               own 1->0 unref flags it.
//
// Why a release cannot bring back the deadlock the hold exists for: that deadlock needs
// a fill that is stalled, and a stalled pass keeps every hold. The worst a release can
// cost is a re-demand, never a dangling word: eviction still takes only refcount-0,
// unpinned frames.
//
// Cost: two compares on NEW/keep; one 12-frame walk (~450 cycles) on a release, which
// happens at most once per demand episode. Never reached on a latched (resident or
// bounded) act, which publishes no demand page.
// In: none   Out: none   Clobbers: d0-d2/a0
// -----------------------------------------------
pub proc PageCache_DemandHoldTick () clobbers(d0-d2/a0) {
        cmpi.b  #PAGE_HELD_NEW, Page_Demand_Held
        bne     .seen
        move.b  #PAGE_HELD_SEEN, Page_Demand_Held       // the pass about to run sees them first
        rts
    .seen:
        tst.w   Cache_Art_Stall                 // the previous pass (it saw every hold) stalled?
        bne     .keep                           // yes: keep every hold
        clr.b   Page_Demand_Held
        move.w  Frame_Counter, d2               // one release time for the whole walk
        lea     Page_Frames, a0
        moveq   #PAGE_FRAMES-1, d0
    .frame:
        bclr    #PF_DEMAND_HELD_BIT, PF_FLAGS(a0)
        beq     .next                           // not held
        tst.w   PF_RC(a0)
        bne     .next                           // referenced: its own 1->0 unref will flag it
        bset    #PF_EVICTABLE_BIT, PF_FLAGS(a0) // never referenced: an ordinary candidate now
        move.w  d2, PF_STAMP(a0)
    .next:
        lea     sizeof(PageFrame)(a0), a0
        dbf     d0, .frame
    .keep:
        rts
}

// -----------------------------------------------
// The copy-site patch RUN primitives (spec §5). PageCache_PatchRun_Seq/_Col
// replace the per-word PageCache_PatchWord: each patches a straight run of
// cache words, banking the working set ONCE per run instead of once per word.
// The old per-word movem+jsr/rts bracket (~166 cycles) was the single largest
// line item of the fall/scroll fill cost (2026-08-09 profile: 160 words/frame
// at terminal fall ≈ 19% of frame in bracket+call overhead alone). Per-word
// SEMANTICS are unchanged — the loop body is the old PatchWord body with the
// old jbsr'd PageCache_Ref/Unref bodies inlined (this file was their only
// caller): read the LOCAL word at (a0), local->global through the staged
// block's section map (Cache_Cur_LocalMap — F-3 merge-translation),
// global->physical, capture-old-BEFORE-write at (a1), ref the new frame /
// unref the overwritten one, in the same per-word order.
//
// Refcount transitions (single source of truth, was PageCache_Ref/Unref):
//   ref   0->1: clear PF_EVICTABLE (referenced frames are never candidates —
//               F-1 stamp eviction, one bclr replaces the old list unlink)
//   unref 1->0: stamp Frame_Counter + set PF_EVICTABLE unless pinned
//
// Blank words (local 0 / mapped global 0) skip translation and ref on the new
// side (panel C1-2 early-out: map[0]==0 is generator-guaranteed; the post-map
// beq stays as the backstop for maps aliasing other locals to global 0).
//
// Non-resident page: enqueue a demand PageCache_Request, set Cache_Art_Stall
// (the fill returns partial + resumes this column/row next frame), LEAVE the
// destination cell untouched (old content + ref intact), and CONTINUE the run —
// re-copy on resume is refcount-neutral for the cells already done.
//
// Run hoists (why the run form is cheap): Cache_Cur_LocalMap (a2), Page_Table
// (a3) and Page_Frames (a4) load once per run — the per-word form reloaded the
// map every word and the Ref/Unref calls re-lea'd Page_Frames per transition.
// All three survive the miss path (PageCache_Request clobbers only d0-d3/a0-a1).
// -----------------------------------------------

// The shared run loop, emitted per stride shape (src_step/dest_step in bytes).
// Register file inside the loop (all banked by the wrapping proc):
//   d0 = new word scratch   d1 = local->global->intra   d2 = page->frame
//   d3 = old word / old frame   d4 = build/stamp temp   d5 = dbf counter
//   a0/a1 = src/dest cursors (advance src_step/dest_step per word)
//   a2 = Cache_Cur_LocalMap   a3 = Page_Table   a4 = Page_Frames
comptime fn pc_patch_run_loop(src_step: Int, dest_step: Int) -> Code {
    return asm {
        subq.w  #1, d5                          // count >= 1 (callers guarantee)
        jbra    .pw_word

        // --- cold arms first: both rejoin .pw_next ---
    .pw_new_blank:
        move.w  (a1), d3                        // new is blank: unref old, write 0
        clr.w   (a1)
        andi.w  #NT_TILE_MASK, d3
        bne     .pw_unref_old
        jbra    .pw_next

    .pw_miss:
        move.w  d1, d0                          // page = global >> 6
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d0
        move.w  #PGRQ_DEMAND, d1
        movem.l a0/a1, -(sp)                    // Request clobbers d0-d3/a0-a1 (a2-a4 safe)
        jbsr    PageCache_Request
        movem.l (sp)+, a0/a1
        move.w  #1, Cache_Art_Stall             // fill returns partial + resumes this col/row
        jbra    .pw_next

        // --- per-word body ---
    .pw_word:
        move.w  (a0), d0                        // new LOCAL word (staged blocks stay local — F-3)
        move.w  d0, d1
        andi.w  #NT_TILE_MASK, d1               // local index (0..2047, generator-bounded)
        beq     .pw_new_blank                   // C1-2 blank early-out before the map read
        add.w   d1, d1                          // u16 table stride
        move.w  (a2, d1.w), d1                  // d1 = GLOBAL slot (full u16 — no 11-bit ceiling)
        beq     .pw_new_blank                   // global 0 = blank -> unref old, write 0, no ref

        move.w  d1, d2                          // page = global >> 6 (u16-wide: up to 1023,
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d2      //   generator ensures < PAGE_TABLE_MAX)
    if DEBUG == 1 {
        // Pool bound (panel-convergent): F-3 removed the 11-bit structural cap,
        // so a corrupt/stale map could index past the PAGE_TABLE_MAX-byte table
        // (OOB read, then an OOB refcount WRITE). The prefetch scan carries the
        // same bound in release; here DEBUG raises loud at the source.
        cmp.w   PageIn_Pool_Pages, d2
        blo     .pw_page_ok
        raise_error "PageCache patch run: mapped page >= pool pages (corrupt/stale local map)"
    .pw_page_ok:
    }
        // frame (or NOT_RESIDENT). d2's high byte is already 0 — page < PAGE_TABLE_MAX
        // = 256, ensure'd at the module head — so the byte load leaves a clean
        // zero-extended frame, and PAGE_NOT_RESIDENT is the only negative byte.
        move.b  (a3, d2.w), d2
        bmi     .pw_miss

        andi.w  #PAGE_FRAME_TILE_MASK, d1       // physical = frame<<6 | (global&63)
        move.w  d2, d4
        lsl.w   #PAGE_FRAME_TILE_SHIFT, d4      // frame << 6
        or.w    d4, d1                          // d1 = physical tile index
        andi.w  #NT_ATTR_MASK, d0               // keep pal/pri/flip
        or.w    d1, d0                          // physical nametable word

        move.w  (a1), d3                        // capture OLD cell (unref) BEFORE overwrite
        move.w  d0, (a1)                        // write the patched word
        andi.w  #NT_TILE_MASK, d3               // old physical index; 0 = was blank
        beq     .pw_ref_new                     // blank before: ref the new frame only
        // SAME-FRAME SHORTCUT (streaming-lag fix, 2026-09-25). If the old cell
        // already referenced the frame the new word references, the ref and the
        // unref cancel exactly: no refcount changes, and no transition either way
        // (the count stays >= 1 throughout), so PF_EVICTABLE and pf_stamp are
        // untouched by the pair. Old and new share a frame iff their indices agree
        // above bit PAGE_FRAME_TILE_SHIFT: (old ^ new) <= PAGE_FRAME_TILE_MASK.
        eor.w   d1, d3
        cmpi.w  #PAGE_FRAME_TILE_MASK, d3
        bls     .pw_next                        // same frame: refcount-neutral
        eor.w   d1, d3                          // restore the old index (non-zero)
    .pw_ref_new:
        // inline ref of the new frame (d2). A referenced frame is never a candidate,
        // so PF_EVICTABLE is cleared unconditionally: on 0->1 that is the transition,
        // on n->n+1 it is already clear (the audit's invariant: evictable => rc 0).
        lsl.w   #3, d2                          // frame * sizeof(PageFrame)
        addq.w  #1, PF_RC(a4, d2.w)
        bclr    #PF_EVICTABLE_BIT, PF_FLAGS(a4, d2.w)
        tst.w   d3
        beq     .pw_next                        // nothing was there to unref
    .pw_unref_old:
        // inline unref of the old frame (d3 = old physical index, nonzero)
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d3      // old frame
        lsl.w   #3, d3                          // * sizeof(PageFrame)
    if DEBUG == 1 {
        tst.w   PF_RC(a4, d3.w)
        bne     .pw_rc_ok
        raise_error "PageCache patch run: refcount underflow (double-free of a cache word)"
    .pw_rc_ok:
    }
        subq.w  #1, PF_RC(a4, d3.w)
        bne     .pw_next                        // still referenced
        btst    #PF_PINNED_BIT, PF_FLAGS(a4, d3.w)
        bne     .pw_next                        // pinned frames are never candidates
        // 1->0: eviction candidate NOW — stamp the release time (F-1: age =
        // Frame_Counter - stamp, oldest wins)
        move.w  Frame_Counter, d4               // (via d4: abs-sym + indexed in one op is a sigil gap)
        move.w  d4, PF_STAMP(a4, d3.w)
        bset    #PF_EVICTABLE_BIT, PF_FLAGS(a4, d3.w)
    .pw_next:
        lea     {src_step}(a0), a0
        lea     {dest_step}(a1), a1
        dbf     d5, .pw_word
    }
}

// -----------------------------------------------
// THE DIRECT-MAP VARIANT (streaming fix F1). Emitted per stride shape beside the
// general loop above and selected per RUN by PageCache_Direct_Map.
//
// WHY IT IS VALID. Level_LoadArt latches PageCache_Direct_Map only when the act
// is fully resident AND Page_Table is the IDENTITY (Page_Table[p] == p for every
// p < PageIn_Pool_Pages) — see the latch there for why the identity is what the
// free list + in-order bulk enqueue produce, and why it cannot change afterwards.
// Under it the general loop's whole translation is a no-op:
//
//     physical = frame<<6 | (global & 63)          [the general loop]
//              = (global>>6)<<6 | (global & 63)    [frame == page == global>>6]
//              = global
//
// so the map's GLOBAL value IS the physical nametable index and the page->frame
// indirection disappears. The refcount pair goes with it: refcounts exist to make
// eviction safe, and under the latch no page can ever be evicted (every page is
// resident, so PageCache_Request early-outs and AllocFrame is never reached).
// PageCache_Audit's refcount arm is conditioned on the same latch and replaced
// there by the checks that ARE live in this regime — see it.
//
// The F-3 merge-translation contract is satisfied IDENTICALLY: staged words stay
// LOCAL, the section map is applied per word, the full-width global lives only in
// a register, and the 11-bit nametable field carries only the physical index
// (< POOL_TILE_CEILING, well inside NT_TILE_MASK — no literal: this line read
// "<= 959" through two pool cuts). Value-identity with the
// general loop is by construction: the same map read feeds the same attr merge.
//
// A miss arm is structurally unreachable here (every page resident => every
// Page_Table entry a real frame), so there is none. The DEBUG bound check the
// general loop carries survives in a STRICTER and cheaper form: it bounds the
// GLOBAL directly against pool_pages<<6 (hoisted once per run into d4) rather
// than deriving the page per word, which catches every out-of-pool map entry the
// page-level check caught and the sub-page ones it did not.
//
// Register file inside the loop: d0 = word scratch, d1 = global/physical,
// d5 = dbf counter, a0/a1 = src/dest cursors, a2 = Cache_Cur_LocalMap,
// d4 = DEBUG pool-tile bound. a3/a4 are UNUSED (no Page_Table / Page_Frames).
// -----------------------------------------------
comptime fn pc_patch_run_direct(src_step: Int, dest_step: Int) -> Code {
    return asm {
        subq.w  #1, d5                          // count >= 1 (callers guarantee)
        jbra    .pd_word

        // --- cold arm: blank word (local 0, or a local the map sends to global 0) ---
    .pd_blank:
        clr.w   (a1)                            // no refcount to unref in this regime
        jbra    .pd_next

        // --- per-word body ---
    .pd_word:
        move.w  (a0), d0                        // new LOCAL word (staged blocks stay local — F-3)
        move.w  d0, d1
        andi.w  #NT_TILE_MASK, d1               // local index (0..2047, generator-bounded)
        beq     .pd_blank                       // C1-2 blank early-out before the map read
        add.w   d1, d1                          // u16 table stride
        move.w  (a2, d1.w), d1                  // d1 = GLOBAL slot == PHYSICAL under the latch
        beq     .pd_blank                       // global 0 = blank -> write 0
    if DEBUG == 1 {
        // Pool bound, stricter than the general loop's page-level twin: a corrupt
        // or stale local map must not reach the nametable. d4 = pool_pages<<6 =
        // one past the last valid global, hoisted once per run.
        cmp.w   d4, d1
        blo     .pd_bound_ok
        raise_error "PageCache direct patch run: mapped global >= pool tiles (corrupt/stale local map)"
    .pd_bound_ok:
    }
        andi.w  #NT_ATTR_MASK, d0               // keep pal/pri/flip
        or.w    d1, d0                          // physical nametable word
        move.w  d0, (a1)
    .pd_next:
        lea     {src_step}(a0), a0
        lea     {dest_step}(a1), a1
        dbf     d5, .pd_word
    }
}

// The DEBUG-only per-run hoist of the direct loop's pool-tile bound (d4).
// Spelled once so both stride shapes cannot drift apart.
comptime fn pc_direct_bound_hoist() -> Code {
    return asm {
    if DEBUG == 1 {
        move.w  PageIn_Pool_Pages, d4
        lsl.w   #PAGE_FRAME_TILE_SHIFT, d4      // d4 = pool_pages * 64 = one past the last valid global
    }
    }
}

// -----------------------------------------------
// THE BOUNDED-DIRECT VARIANT (streaming-lag fix, 2026-09-25). The direct loop's shape
// for a STREAMING act, selected per run while PageCache_Direct_Map ==
// PAGECACHE_DIRECT_BOUNDED.
//
// WHY IT IS VALID. Level_LoadArt latches it only when the act's resident set is
// exactly pages [0, PAGE_FRAMES_CLAMP) at identity (Page_Table[p] == p) with every
// other page absent — verified, not assumed. For a resident page the F1 argument holds
// word for word (physical == global), and residency itself is `global <
// PAGE_FRAMES_CLAMP << PAGE_FRAME_TILE_SHIFT` (d4, hoisted per run). The resident set
// cannot change while the latch holds: every page-in needs PageCache_AllocFrame, and
// its first call ends the regime (PageCache_EndBoundedRegime rebuilds the refcounts
// from the nametable, then the general loop takes over). So this loop maintains NO
// refcounts, exactly like the F1 loop and for the same reason: nothing can be evicted
// while it runs.
//
// A word above the bound is a miss: the same demand request + Cache_Art_Stall + leave
// the cell as the general loop's miss arm. Its page is outside the resident set, so
// the page-in that answers it is the allocation that ends the regime.
//
// Register file: d0 = word scratch, d1 = global/physical, d4 = residency bound,
// d5 = dbf counter, a0/a1 = src/dest cursors, a2 = Cache_Cur_LocalMap. a3/a4 unused.
// Cost over the F1 loop: one cmp + one not-taken bhs per non-blank word.
// -----------------------------------------------
comptime fn pc_patch_run_bounded(src_step: Int, dest_step: Int) -> Code {
    return asm {
        move.w  #PAGE_FRAMES_CLAMP << PAGE_FRAME_TILE_SHIFT, d4  // one past the last resident global
        subq.w  #1, d5                          // count >= 1 (callers guarantee)
        jbra    .pb_word

        // --- cold arms: both rejoin .pb_next ---
    .pb_blank:
        clr.w   (a1)                            // no refcount to unref in this regime
        jbra    .pb_next

    .pb_miss:
        move.w  d1, d0                          // page = global >> 6
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d0
    if DEBUG == 1 {
        // Pool bound, the general loop's twin: a corrupt/stale local map must not
        // reach the request FIFO as an off-manifest page (Request's own backstop
        // would name it too, one frame later and less precisely).
        cmp.w   PageIn_Pool_Pages, d0
        blo     .pb_page_ok
        raise_error "PageCache bounded patch run: mapped page >= pool pages (corrupt/stale local map)"
    .pb_page_ok:
    }
        move.w  #PGRQ_DEMAND, d1
        movem.l a0/a1, -(sp)                    // Request clobbers d0-d3/a0-a1 (d4/d5/a2 safe)
        jbsr    PageCache_Request
        movem.l (sp)+, a0/a1
        move.w  #1, Cache_Art_Stall             // fill returns partial + resumes this col/row
        jbra    .pb_next

        // --- per-word body ---
    .pb_word:
        move.w  (a0), d0                        // new LOCAL word (staged blocks stay local — F-3)
        move.w  d0, d1
        andi.w  #NT_TILE_MASK, d1               // local index (0..2047, generator-bounded)
        beq     .pb_blank                       // C1-2 blank early-out before the map read
        add.w   d1, d1                          // u16 table stride
        move.w  (a2, d1.w), d1                  // d1 = GLOBAL slot == PHYSICAL for a resident page
        beq     .pb_blank                       // global 0 = blank -> write 0
        cmp.w   d4, d1
        bhs     .pb_miss                        // page outside [0, PAGE_FRAMES_CLAMP): not resident
        andi.w  #NT_ATTR_MASK, d0               // keep pal/pri/flip
        or.w    d1, d0                          // physical nametable word
        move.w  d0, (a1)
    .pb_next:
        lea     {src_step}(a0), a0
        lea     {dest_step}(a1), a1
        dbf     d5, .pb_word
    }
}

// -----------------------------------------------
// THE PLAIN VARIANT (resident plain copy, 2026-09-26). Selected per run while
// PageCache_Direct_Map == PAGECACHE_DIRECT_PLAIN.
//
// WHY IT IS VALID. Level_LoadArt latches PLAIN only where it would latch RESIDENT
// (fully resident, Page_Table the identity: physical == global) AND the act carries
// Act.act_nt_physical — its level tool baked every block word as `attr | global`
// with a blank word stored as $0000, and gave every section the pool-slot identity
// map (map[i] == i for every index a word can carry; verify_level_bin.py refuses a
// physical-form tree where either is false). On such a word the direct loop computes:
//
//     index 0          -> $0000                 == the stored word (blank is $0000)
//     index i != 0     -> (w & ATTR) | map[i]   == (w & ATTR) | i == w
//
// so the direct loop is the identity on physical-form data, and the run is a copy.
// Value-identity with the direct loop is therefore by construction, the same way the
// direct loop's is with the general one — one level further down the same chain.
//
// WHAT IT GIVES UP. The direct loop's DEBUG per-word pool bound: a per-word DEBUG check
// here would hand back most of the DEBUG shape's gain. It is a BUILD-time check instead
// (verify_level_bin.py: every physical word's index is a real pool slot), and the
// periodic PageCache_Audit still refuses a cache word that names an unassigned frame.
//
// No register bank: the loop touches only d0 (declared clobbered) and a0/a1 (the
// advanced cursors the callers continue from), so the proc returns straight from it.
// Two spellings, one per stride shape: the sequential run is contiguous on both sides,
// so it post-increments (12+10 cyc/word against the direct loop's ~97); the column run
// strides a block row on the source and a cache row on the destination.
// -----------------------------------------------
comptime fn pc_patch_run_plain_seq() -> Code {
    return asm {
        subq.w  #1, d0                          // count >= 1 (callers guarantee)
    .pp_word:
        move.w  (a0)+, (a1)+                    // the stored word IS the physical word
        dbf     d0, .pp_word
    }
}

comptime fn pc_patch_run_plain_col(src_step: Int, dest_step: Int) -> Code {
    return asm {
        subq.w  #1, d0                          // count >= 1 (callers guarantee)
    .pp_word:
        move.w  (a0), (a1)                      // the stored word IS the physical word
        lea     {src_step}(a0), a0
        lea     {dest_step}(a1), a1
        dbf     d0, .pp_word
    }
}

// -----------------------------------------------
// PageCache_PatchRun_Seq — patch a SEQUENTIAL run (FillRow: src and dest both
// advance one word). PageCache_PatchRun_Col — patch a block-COLUMN run
// (CopyBlockColumn: src advances one block row = 32 bytes, dest one cache row
// = 160 bytes; the caller handles the cache row-59->0 wrap between runs).
// In: a0 = source LOCAL word ptr, a1 = destination nametable-cell ptr,
//     d0.w = run length (>= 1); Cache_Cur_LocalMap published by
//     FindStagedBlock/DecompressBlock
// Out: a0/a1 advanced one stride PAST the run (the callers continue run 2 from
//     them). Everything else preserved — the run form drops into the
//     register-saturated H6 fill loops with no caller-side banking.
// -----------------------------------------------
// The variant select is per RUN, not per word: one tst.b + bcc over the ~8-10 runs
// a saturated tick issues (~200 cyc/tick) against the ~95 cyc/word the direct loop
// saves over 280 words/tick. The fallback arm is the pre-F1 code byte-for-byte.
//
// DISPATCH ORDER (resident plain copy, 2026-09-26). The sign test runs BEFORE the
// register bank so the plain arm can skip the bank entirely. The general and bounded
// arms execute the same instructions they did before it moved — tst, bmi (not taken),
// movem, then `bne .bounded` on the SAME tst's Z, because movem.l to memory leaves the
// CCR untouched — so the streaming path pays nothing for the plain arm. The two
// negative latches (RESIDENT, PLAIN) are told apart by one compare inside the `bmi` arm.
pub proc PageCache_PatchRun_Seq (a0: *u8, a1: *u8, d0: u16) clobbers(d0) inout(a0: *u8, a1: *u8) preserves(d1-d7/a2-a6) {
        tst.b   PageCache_Direct_Map
        bmi     .resident                       // RESIDENT ($FF) or PLAIN ($80)
        movem.l d1-d5/a2-a4, -(sp)              // CCR untouched: Z is still the tst's
        bne     .bounded                        // PAGECACHE_DIRECT_BOUNDED ($01)
        move.w  d0, d5                          // run length
        movea.l Cache_Cur_LocalMap, a2          // run hoists (see block comment)
        lea     Page_Table, a3
        lea     Page_Frames, a4
        pc_patch_run_loop(2, 2)
        movem.l (sp)+, d1-d5/a2-a4
        rts
    .bounded:
        move.w  d0, d5                          // run length
        movea.l Cache_Cur_LocalMap, a2
        pc_patch_run_bounded(2, 2)
        movem.l (sp)+, d1-d5/a2-a4
        rts
    .resident:
        cmpi.b  #PAGECACHE_DIRECT_PLAIN, PageCache_Direct_Map
        bne     .direct
        pc_patch_run_plain_seq()                // no bank: d0/a0/a1 only
        rts
    .direct:
        movem.l d1-d5/a2-a4, -(sp)
        move.w  d0, d5                          // run length
        movea.l Cache_Cur_LocalMap, a2
        pc_direct_bound_hoist()
        pc_patch_run_direct(2, 2)
        movem.l (sp)+, d1-d5/a2-a4
        rts
}

pub proc PageCache_PatchRun_Col (a0: *u8, a1: *u8, d0: u16) clobbers(d0) inout(a0: *u8, a1: *u8) preserves(d1-d7/a2-a6) {
        tst.b   PageCache_Direct_Map
        bmi     .resident                       // RESIDENT ($FF) or PLAIN ($80)
        movem.l d1-d5/a2-a4, -(sp)              // CCR untouched: Z is still the tst's
        bne     .bounded                        // PAGECACHE_DIRECT_BOUNDED ($01)
        move.w  d0, d5                          // run length
        movea.l Cache_Cur_LocalMap, a2          // run hoists (see block comment)
        lea     Page_Table, a3
        lea     Page_Frames, a4
        pc_patch_run_loop(BLOCK_TILE_SIZE * 2, TILE_CACHE_STRIDE * 2)
        movem.l (sp)+, d1-d5/a2-a4
        rts
    .bounded:
        move.w  d0, d5                          // run length
        movea.l Cache_Cur_LocalMap, a2
        pc_patch_run_bounded(BLOCK_TILE_SIZE * 2, TILE_CACHE_STRIDE * 2)
        movem.l (sp)+, d1-d5/a2-a4
        rts
    .resident:
        cmpi.b  #PAGECACHE_DIRECT_PLAIN, PageCache_Direct_Map
        bne     .direct
        pc_patch_run_plain_col(BLOCK_TILE_SIZE * 2, TILE_CACHE_STRIDE * 2)   // no bank: d0/a0/a1 only
        rts
    .direct:
        movem.l d1-d5/a2-a4, -(sp)
        move.w  d0, d5                          // run length
        movea.l Cache_Cur_LocalMap, a2
        pc_direct_bound_hoist()
        pc_patch_run_direct(BLOCK_TILE_SIZE * 2, TILE_CACHE_STRIDE * 2)
        movem.l (sp)+, d1-d5/a2-a4
        rts
}

// -----------------------------------------------
// PageCache_Prefetch — page-tier speculative prefetch (Task 7, spec §5). Called once
// per frame from PageIn_Process's idle site. Reads the tile-cache leading-edge signals
// Cache_Pfx_Row_Target / Cache_Pfx_Col_Target (the block-tier ahead targets set by
// Tile_Cache_Fill's unified prefetch; one frame stale here — PageIn_Process runs at
// frame top, before Tile_Cache_Fill), probes each ahead-strip block's staging slot,
// and PageCache_Request(prefetch)es the non-resident pages those blocks reference.
// Bounded to PAGE_PREFETCH_MAX enqueues/frame (Page_Pfx_Budget, reset by the caller).
//
// Local->global (F-3 merge-translation): a STAGED block's nametable words are
// LOCAL; the scan maps each through the block's section map (Cache_Cur_LocalMap,
// published by the FindStagedBlock probe that located the block) and derives
// page = global >> PAGE_FRAME_TILE_SHIFT at full u16 width. A block not yet
// staged is skipped (its pages are unknown until the block-tier prefetch stages
// it a few frames ahead; the demand-stall path is the correctness backstop).
//
// BOUNDED AND RESUMABLE (streaming-lag fix, 2026-09-25 — docs/research/2026-09-25-s4-lag.md).
// This scan used to re-walk every staged ahead-strip block's 256 words EVERY frame
// (23k-94k cycles per tick measured on the two-zone clip act, the first flown act
// that streams), and it did not stop at VBlank, so it ran into the next tick — and
// PageIn_Process then started a decode AFTER that VBlank, which the bookmark only
// banks at the NEXT one: a whole frame lost. Three changes, each measured:
//   * RESUMABLE CURSOR, one byte per staging slot (Page_Pfx_Scan_Pos): how many of
//     the block's rows are proven all-resident. A row is walked at most once per
//     (slot claim, eviction epoch); a block whose 16 rows are proven costs one probe.
//     What can falsify a proof is an EVICTION (Page_Evict_Gen) or a re-CLAIM of the
//     slot (Block_Stage_Gen/_Next, the round-robin claim) — both synced at entry. A
//     page becoming resident can only make a proof truer, so Publish invalidates
//     nothing.
//   * COOPERATIVE YIELD at VBlank: VBlank_Flag (cleared by VSync_Wait before this
//     runs, set by the VBlank) is polled once per block ROW (16 words, ~2k cycles),
//     so the scan's overrun past VBlank is bounded by one row. The yield returns
//     Z-clear so PageIn_Process knows not to start a decode on a stolen frame.
//   * A QUEUED page (claim bit set: in the FIFO or in flight) is PENDING, not a new
//     request: it holds the row's proof back but spends no budget, so one slow
//     decode no longer stops the scan from reaching the rest of the strip.
//
// D3: this is the ENQUEUE side (never gated — it only warms the FIFO, bounded). The
// admission gate on speculative decode STARTS lives in PageIn_Process.
//
// POOL-BOUNDS INVARIANT (soak fix, chain 69): a derived page is Requested ONLY when
// page < act_art_pool_pages. A valid translated pool word can only yield page 0..pages-1
// (global indices span exactly the pool), so any page >= pages is a SCAN ARTIFACT — a
// word read from a staged slot that is not a live translated pool reference (an edge /
// empty / stale-transient probe). Speculative prefetch must never turn an artifact into
// an off-manifest page-in, so the scan SILENTLY skips it. The count comes from
// PageIn_Pool_Pages (stored by Level_LoadArt) — NOT Current_Act_Ptr, which read null at
// the gameplay dispatch (chain 71). PageCache_Request carries the loud backstop.
//
// Preserves EVERY register (movem-banks its whole working set) so PageIn_Process's
// declared clobber set — and hence VSync_Wait's folded license — never widens. The
// two strip loops hold their invariants in d5-d7 (preserved across
// TileCache_FindStagedBlock's d3-d4/a1 clobber); .scan_block banks d5-d7 itself and
// holds its own state in d4-d7/a2-a5 (preserved across PageCache_Request's
// d0-d3/a0-a1 clobber).
// A yield leaves VBlank_Flag set, which is how PageIn_Process knows not to start a
// decode on the frame that is already over (it tests the flag after this call).
// In: none   Out: none   Clobbers: () — preserves d0-d7/a0-a6
// -----------------------------------------------
pub proc PageCache_Prefetch () clobbers() preserves(d0-d7/a0-a6) {
        // FULLY-RESIDENT degenerate path (§9.7): when the whole pool fits the
        // frame clamp (latched by Level_LoadArt), the bulk load ends with every
        // page permanently resident — nothing this scan could ever find is
        // non-resident. One tst deletes it for every act that fits; streaming
        // acts fall through.
        tst.b   PageIn_Fully_Resident
        bne     .ret
        // DEMAND-FIRST discipline (chain 74): while the fill has an unresolved demand
        // stall, speculative prefetch must NOT enqueue — it would compete for the scarce
        // dynamic frames the demand needs and churn pointless decode/evict cycles. One
        // flag: Cache_Art_Stall stays set every frame the fill re-stalls on a missing
        // page, so it spans the whole demand lifecycle until the page publishes. (This is
        // per-tier priority discipline, not a shared arbiter — D2 stays honored.)
        tst.w   Cache_Art_Stall
        bne     .ret
        // BULK-FIRST discipline (chain 78, mirror of the demand-first gate above): while
        // Level_LoadArt's init bulk pool load + drain-wait is active, speculative prefetch
        // must NOT enqueue. With more pages than frames a prefetch landing evicts a
        // resident page whose ahead-strip refs get re-scanned and re-requested — a
        // prefetch<->evict cycle that never drains (black-screen livelock). The bulk
        // drain has no Cache_Art_Stall, so the demand-first gate does not cover it; this
        // flag does. (Also covers act-transition reloads — it spans the whole bulk load.)
        tst.b   PageIn_Bulk_Drain
        bne     .ret
        tst.w   Page_Pfx_Budget
        beq     .ret                            // no budget left this frame — cheap exit
        movem.l d0-d7/a0-a6, -(sp)

        // ---- SYNC the per-slot row proofs (see the header) ----
        lea     Page_Pfx_Scan_Pos, a0
        move.w  Page_Evict_Gen, d0
        cmp.w   Page_Pfx_Evict_Seen, d0
        beq     .sync_claims
        move.w  d0, Page_Pfx_Evict_Seen         // an eviction (or act reset) since: void every proof
    .sync_all:
        move.w  (Block_Stage_Gen).w, (Page_Pfx_Stage_Gen).w // widths pinned: mem-to-mem two-symbolic operands
        clr.l   (a0)                            // BLOCK_STAGE_SLOTS bytes (ensure'd 16 at the module head)
        clr.l   4(a0)
        clr.l   8(a0)
        clr.l   12(a0)
        jbra    .synced
    .sync_claims:
        // Claims are strictly round-robin from Block_Stage_Next (DecompressBlock is
        // the one claim site), so the `delta` claims since the last sync re-keyed
        // exactly the slots [Next - delta .. Next) mod BLOCK_STAGE_SLOTS — the same
        // derivation Tile_Cache_Fill's F2 memo uses. TileCache_InvalidateStaging
        // bumps the generation once and resets Next to 0; the formula then also
        // clears slot BLOCK_STAGE_SLOTS-1 (harmless: conservative), and every slot it
        // does not clear holds the $FFFFFFFF key, which no probe can hit until the
        // slot is claimed again — and that claim is counted here.
        move.w  Block_Stage_Gen, d0
        sub.w   Page_Pfx_Stage_Gen, d0          // d0 = claims since the last sync
        beq     .synced
        cmpi.w  #BLOCK_STAGE_SLOTS, d0
        bhs     .sync_all                       // a full turnover: every slot re-claimed
        move.w  (Block_Stage_Gen).w, (Page_Pfx_Stage_Gen).w // widths pinned: mem-to-mem two-symbolic operands
        move.w  Block_Stage_Next, d1
        sub.w   d0, d1                          // first slot claimed since (masked per step)
        subq.w  #1, d0
    .sync_slot:
        andi.w  #BLOCK_STAGE_SLOTS-1, d1
        clr.b   (a0, d1.w)                      // re-claimed: its block's rows are unproven
        addq.w  #1, d1
        dbf     d0, .sync_slot
    .synced:

        // ---- ROW strip: ahead block-row across cache cols [Left..Head] ----
        move.w  Cache_Pfx_Row_Target, d6
        cmpi.w  #$FFFF, d6
        beq     .col_strip                       // no vertical target this frame
        move.w  d6, d5
        lsr.w   #8, d5                            // d5 = sec_y (fixed for the row)
        lsr.w   #BLOCK_TILE_SHIFT, d6
        andi.w  #$F, d6
        lsl.w   #4, d6                            // d6 = block_y*16 (add block_x per col)
        move.w  Cache_Left_Col, d7
        andi.w  #~(BLOCK_TILE_SIZE-1), d7         // align to block col
    .row_scan:
        tst.w   Page_Pfx_Budget
        beq     .strips_done
        tst.b   VBlank_Flag
        bne     .strips_done                     // the idle window is over — yield
        cmp.w   Cache_Head_Col, d7
        bhi     .col_strip                       // past the cache head — row strip done
        move.w  d7, d0
        lsr.w   #8, d0                            // sec_x
        move.w  d5, d1                            // sec_y
        move.w  d7, d2
        lsr.w   #BLOCK_TILE_SHIFT, d2
        andi.w  #$F, d2                           // block_x
        add.w   d6, d2                            // block_index = block_y*16 + block_x
        jbsr    TileCache_FindStagedBlock         // Z on hit, a1 = slot, d4 = slot*4; d0-d2 preserved
        bne     .row_next                         // not staged -> pages unknown, skip
        jbsr    .scan_block                       // Z clear = stop this frame (yield / budget)
        bne     .strips_done
    .row_next:
        addi.w  #BLOCK_TILE_SIZE, d7
        jbra    .row_scan

        // ---- COL strip: ahead block-col across cache rows [Top..Bottom] ----
    .col_strip:
        move.w  Cache_Pfx_Col_Target, d6
        cmpi.w  #$FFFF, d6
        beq     .strips_done                      // no horizontal target this frame
        move.w  d6, d5
        lsr.w   #8, d5                            // d5 = sec_x (fixed for the col)
        lsr.w   #BLOCK_TILE_SHIFT, d6
        andi.w  #$F, d6                           // d6 = block_x (fixed)
        move.w  Cache_Top_Row, d7
        andi.w  #~(BLOCK_TILE_SIZE-1), d7          // align to block row
    .col_scan:
        tst.w   Page_Pfx_Budget
        beq     .strips_done
        tst.b   VBlank_Flag
        bne     .strips_done                     // the idle window is over — yield
        cmp.w   Cache_Bottom_Row, d7
        bhi     .strips_done                      // past the cache bottom — col strip done
        move.w  d5, d0                            // sec_x
        move.w  d7, d1
        lsr.w   #8, d1                            // sec_y
        move.w  d7, d2
        lsr.w   #BLOCK_TILE_SHIFT, d2
        andi.w  #$F, d2                           // block_y
        lsl.w   #4, d2
        add.w   d6, d2                            // block_index = block_y*16 + block_x
        jbsr    TileCache_FindStagedBlock
        bne     .col_next
        jbsr    .scan_block
        bne     .strips_done
    .col_next:
        addi.w  #BLOCK_TILE_SIZE, d7
        jbra    .col_scan

    .strips_done:
        movem.l (sp)+, d0-d7/a0-a6
    .ret:
        rts

    .scan_block:
        // Walk a staged block's unproven rows, resuming at its slot's cursor. Each
        // LOCAL nametable word maps local->global through the block's section map
        // (Cache_Cur_LocalMap, published by the probe that found it); a non-blank
        // global whose page is a REAL pool page and not resident is either PENDING
        // (claim bit set: queued or in flight — spends no budget) or Requested
        // (prefetch; spends one unit of Page_Pfx_Budget). A row with no such page
        // advances the cursor; once any row of the block has missed, the cursor
        // freezes there for this pass so the next frame re-checks from it.
        // In:  a1 = slot base, d4 = slot*4 (FindStagedBlock's hit outputs)
        // Out: Z set = carry on along the strip; Z clear = stop this frame (VBlank
        //      yield or budget spent). Banks the strip walk's d5-d7; d0-d4/a0-a5 are
        //      the enclosing proc's (all restored by its epilogue movem).
        // State across PageCache_Request (clobbers d0-d3/a0-a1): d4 = row-missed
        //   flag, d5 = pool pages, d6 = word counter, d7 = row, a2 = word cursor,
        //   a3 = section map, a4 = Page_Table, a5 = this slot's cursor byte.
        movem.l d5-d7, -(sp)
        lsr.w   #2, d4                            // slot*4 -> slot
        lea     Page_Pfx_Scan_Pos, a5
        adda.w  d4, a5                            // a5 = &Page_Pfx_Scan_Pos[slot]
        moveq   #0, d7
        move.b  (a5), d7                          // d7 = first unproven row
        cmpi.w  #BLOCK_TILE_SIZE, d7
        bhs     .sb_continue                      // every row proven — one probe, no walk
        move.w  d7, d0
        lsl.w   #BLOCK_TILE_SHIFT + 1, d0         // row * BLOCK_TILE_SIZE words * 2 bytes
        lea     (a1, d0.w), a2                    // a2 = the first unproven row's first word
        movea.l Cache_Cur_LocalMap, a3            // this block's local->global map
        lea     Page_Table, a4
        move.w  PageIn_Pool_Pages, d5             // pool-bounds invariant (see the header)
        moveq   #0, d4                            // no row of this block has missed yet
    .sb_row:
        tst.b   VBlank_Flag
        bne     .sb_stop                          // yield at a row boundary (<= one row of overrun)
        moveq   #BLOCK_TILE_SIZE-1, d6
    .sb_word:
        move.w  (a2)+, d0
        andi.w  #NT_TILE_MASK, d0                 // LOCAL tile index
        beq     .sb_next                          // local 0 = blank (map[0]==0) — skip the map read
        add.w   d0, d0                            // u16 table stride
        move.w  (a3, d0.w), d0                    // d0 = GLOBAL slot (full u16)
        beq     .sb_next                          // global 0 = blank -> no page
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d0        // page id
        cmp.w   d5, d0                            // pool-bounds invariant: a REAL pool page?
        bhs     .sb_next                          // page >= pages -> scan artifact, skip silently
        tst.b   (a4, d0.w)                        // frame (0..PAGE_FRAMES_MAX-1) or PAGE_NOT_RESIDENT
        bmi     .sb_miss                          // $FF is the only negative entry (ensure'd at the head)
    .sb_next:
        dbf     d6, .sb_word
        tst.w   d4
        bne     .sb_row_done                      // a row missed: the cursor stays put
        addq.b  #1, (a5)                          // this row is proven all-resident
    .sb_row_done:
        addq.w  #1, d7
        cmpi.w  #BLOCK_TILE_SIZE, d7
        blo     .sb_row
    .sb_continue:
        movem.l (sp)+, d5-d7                      // (movem leaves the CCR alone)
        moveq   #0, d0                            // Z set: carry on along the strip
        rts
    .sb_stop:
        movem.l (sp)+, d5-d7
        moveq   #1, d0                            // Z clear: stop scanning this frame
        rts

    .sb_miss:
        moveq   #1, d4                            // this row stays unproven (and so do later ones)
        move.w  d0, d1
        lsr.w   #3, d1                            // claim bitset byte (page/8)
        lea     Page_Queued_Bits, a0
        btst    d0, (a0, d1.w)                    // bit page&7 (btst on a byte operand is mod 8)
        bne     .sb_next                          // already claimed: pending, no budget spent
        move.w  #PGRQ_PREFETCH, d1                // non-resident, unclaimed -> request
        jbsr    PageCache_Request                 // clobbers d0-d3/a0-a1
    if DEBUG == 1 {
        addq.w  #1, Dbg_PageCache_Prefetches
    }
        subq.w  #1, Page_Pfx_Budget
        bne     .sb_next
        jbra    .sb_stop                          // budget spent this frame
}


// -----------------------------------------------
// PageCache_ResetRefcounts — the WARM-cache counterpart of PageCache_Init, and
// the precondition TileCache_FillAll has been asking for in prose since P2b:
//
//   "requires all resident pf_refcount == 0 — guaranteed by PageCache_Init at
//    boot. The .zero_nt bulk-zero here bypasses the patch runs' per-word unref,
//    so a future WARM-cache refill must first reset refcounts and rebuild the
//    LRU before calling this, or residency accounting double-counts."
//                                        — engine/level/tile_cache.emp, FillAll
//
// That future arrived with the DEBUG warp mailbox: a warp re-runs Tile_Cache_Init
// mid-act, on a cache whose every live nametable word still holds a reference.
// PageCache_Init is the wrong tool there — it drops RESIDENCY too, and residency
// can only be rebuilt by Level_LoadArt, which spins VSync_Wait with the display
// off. This proc resets exactly the half FillAll invalidates and leaves the
// page->frame map alone, so the refill re-references the pages already in VRAM.
//
// THE POST-STATE IS THE AUDIT'S POST-STATE, not an approximation of it — every
// invariant PageCache_Audit checks is re-established here:
//   * pf_refcount = 0 for every frame (FillAll is about to zero the nametable
//     that justified them).
//   * an ASSIGNED, unpinned frame becomes an eviction candidate NOW: PF_EVICTABLE
//     set and pf_stamp = Frame_Counter, which is exactly what the patch runs'
//     1->0 unref does. Skipping the stamp would hand the F-1 age scan a stale
//     release time and evict the wrong frame first.
//   * an UNASSIGNED frame (free list, or the in-flight decode frame, which is
//     unassigned by construction since soak-fix chain 72) and a PINNED frame both
//     get PF_EVICTABLE CLEARED — the audit raises on either flavour of a wrongly
//     flagged frame ("unassigned frame flagged PF_EVICTABLE" / "pinned frame
//     flagged PF_EVICTABLE"), and clearing is also simply true.
// Tile_Cache_Init's own DEBUG tail calls PageCache_Audit after the refill, so the
// warp path checks this proc's work on every warp in the shape that has it.
//
// The page-in FIFO is deliberately NOT flushed. PageIn_Flush would cancel the
// queue but leave a mid-decode frame DETACHED and unassigned — reachable from
// neither the free list nor the candidate scan, i.e. leaked, and invisible to the
// audit (which skips unassigned frames). Letting an in-flight page-in complete
// normally is strictly safer: Publish only marks residency, and the refill
// re-references whatever it finds. The shipped act is fully resident (10 pages,
// PAGE_FRAMES_CLAMP frames), so nothing is ever in flight at warp time anyway.
//
// DEBUG-SHAPE ONLY: the whole body, rts included, sits inside `if DEBUG == 1`, so
// this emits ZERO bytes in release (the Debug_AssertObjLoop / Debug_CharacterHotkey
// idiom). Its one caller is the DEBUG warp.
//
// PLACEMENT IS LOAD-BEARING — it sits immediately before PageCache_Audit, the last
// proc in the module, and must stay there. Zero release bytes is not by itself zero
// release CHANGE: both canonical shapes append the convsym deb2 symbol table, so a
// zero-byte release LABEL still lands in the appendix and moves the ROM's CRC and
// its header ROM-end/checksum words. Parked here, this proc's release label
// coincides with PageCache_Audit's address and the appendix dedupes it away, so
// s4.bin and demo.bin stay byte-identical (measured: both CRCs unchanged). Anywhere
// a real emitting symbol follows it — including end-of-file, where nothing does —
// the appendix grows and the release ROM changes. Being the LAST proc also means
// the `if DEBUG == 1` scope below cannot renumber any release-visible anonymous asm
// scope (the pc_patch_run_loop splices all sit above it).
// In: none   Out: none   Clobbers: d0-d2/a0
// -----------------------------------------------
pub proc PageCache_ResetRefcounts () clobbers(d0-d2/a0) {
    if DEBUG == 1 {
        move.w  Frame_Counter, d2               // one release time for the whole sweep
        lea     Page_Frames, a0
        move.w  #PAGE_FRAMES-1, d0
    .frame:
        clr.w   PF_RC(a0)
        move.b  PF_FLAGS(a0), d1
        bclr    #PF_EVICTABLE_BIT, d1           // default: NOT a candidate
        bclr    #PF_DEMAND_HELD_BIT, d1         // a warp resolves every demand: no hold survives it
        cmpi.w  #$FFFF, PF_PAGE(a0)
        beq     .store                          // unassigned (free / in-flight decode)
        btst    #PF_PINNED_BIT, d1
        bne     .store                          // pinned frames are never victims
        bset    #PF_EVICTABLE_BIT, d1           // assigned + rc0 + unpinned = candidate
        move.w  d2, PF_STAMP(a0)                // released NOW (F-1 age scan origin)
    .store:
        move.b  d1, PF_FLAGS(a0)
        lea     sizeof(PageFrame)(a0), a0
        dbf     d0, .frame
        rts
    }
}

// -----------------------------------------------
// PageCache_Audit — DEBUG residency invariant check (spec §5). Three modes, ONE set of
// invariants: d0 chooses WHEN the work happens, never WHAT is checked.
//
//   PAGE_AUDIT_FULL — everything, in this one call. Tile_Cache_Init's DEBUG tail (after
//     the first full cache fill, and the reason the DEBUG warp self-audits its own
//     PageCache_ResetRefcounts work — tools/warp_mailbox_gate.py asserts that).
//   PAGE_AUDIT_TICK — the level state's once-per-logic-tick call (games/sonic4/test/
//     ojz_scroll_test.emp, right after Tile_Cache_Fill returns). Fix F5 moved it out of
//     the fill because the fill is the streaming arc's measurement subject; do NOT
//     re-add a gate in the fill. It advances Page_Audit_Ticks, audits any nametable
//     slice the idle slot left overdue, and runs the interval's checks on tick
//     PAGECACHE_AUDIT_INTERVAL.
//   PAGE_AUDIT_IDLE — VSync_Wait's idle slot, after PageIn_Process (engine/system/
//     vblank.emp). Audits nametable slices while the frame has time left, and stops.
//
// WHAT IS CHECKED, in every mode that checks. General regime: every frame's
// pf_refcount equals the number of live nametable words naming it. Latched regimes
// (PageCache_Direct_Map != 0, streaming fix F1 and the bounded variant): (a) every
// pf_refcount is zero, (b) no nametable word names an UNASSIGNED frame, (c) Page_Table
// is the identity below PAGE_FRAMES_CLAMP and absent above it. Every regime:
// PF_EVICTABLE => assigned + rc0 + unpinned; PF_DEMAND_HELD => assigned + unpinned +
// the hold gate armed; page<->frame is a bijection; no assigned frame is unreachable by
// every reclaim path (orphan).
//
// THE AMORTISED SCHEDULE (audit-amortise, 2026-09-26; the measurements and the designs
// it beat are in docs/research/2026-09-26-audit-amortise.md). The audit's cost is the
// 4800-word nametable walk: 203k-236k cycles, two DEBUG lag frames on every interval
// tick when it ran whole on one tick.
//   * LATCHED REGIMES (every shipped act). The walk's ONLY consumer is (b), and (b) is
//     a per-word predicate over ONE instant's state: "this word's frame is assigned
//     now". So the walk is cut into PAGE_AUDIT_SLICES slices of PAGE_AUDIT_SLICE_WORDS
//     words. The idle slot audits slices while the scanline says the slice still fits
//     before VBlank (PAGE_AUDIT_IDLE_LAST_LINE), so it costs the running game nothing:
//     it only spends time the frame would have spun away in `.wait`.
//   * PACING. Slice s may be audited from interval tick s+1 on (the idle slot never
//     runs ahead of the tick count) and must be audited by tick
//     s+1+PAGE_AUDIT_SLACK_TICKS: a slice the idle slot has not reached by then is
//     audited by the TICK call itself, and the interval tick audits whatever is left.
//     Page_Audit_Late counts the slices the ticks had to do (idle had no room). Without
//     the pacing an idle-rich interval would sweep at its start and an idle-starved
//     one at its end, and a word's two checks could sit almost two intervals apart.
//   * WHY A SLICE CANNOT LIE. Each slice checks its words against a mask of assigned
//     frames built IN THE SAME CALL, from the same instant, by .dangling_walk. Nothing
//     crosses from one slice to the next except Page_Audit_Slice, which chooses WHICH
//     words are read and never holds a partial result. So a raise names a violation
//     present in the state at the moment it raised, and a state that changed between
//     slices cannot add up to a false failure or a false pass: no two instants are
//     ever combined. (a), (c), flags, bijectivity and orphan are whole-state checks and
//     run whole, on the interval tick, as before.
//   * GENERAL REGIME. Its check is a SUM over the whole nametable at one instant. A sum
//     spread over time while Tile_Cache_Fill rewrites words is wrong in both
//     directions (a word counted and then rewritten A->B, while a word not yet counted
//     goes B->A, leaves every refcount unchanged and the partial sum off by one). Only
//     a write barrier in the copy sites or a restart-on-write sweep fixes that, and the
//     fill writes on nearly every tick in motion, so a restarting sweep never
//     finishes. So the general regime keeps the atomic walk on the interval tick,
//     unchanged, and the idle slot skips it. Do not slice it without a write barrier.
//   * THE PACING ALSO ARMS IT. Page_Audit_Ticks is 0 from PageCache_Init until the
//     level state's first tick, so no slice is allowed during Level_LoadArt's
//     VSync_Wait spins, when the nametable may still hold the previous act's words
//     against a pool that was just reset.
//
// LATENCY. The frame-level checks run on every interval tick: a violation there is
// caught within PAGECACHE_AUDIT_INTERVAL ticks, as before. A nametable word is audited
// in every interval between phase s+1 and s+1+PAGE_AUDIT_SLACK_TICKS of its slice s, so
// two consecutive checks of it are at most PAGECACHE_AUDIT_INTERVAL +
// PAGE_AUDIT_SLACK_TICKS ticks apart: a violation that stays put is caught within
// that many ticks (136 against the whole walk's 128), and usually within a few ticks
// of its slice's phase (tools/pagecache_audit_poison.py measures it). Refcount/flag/
// map corruptions are monotone (nothing re-derives them), so a periodic audit reports
// them late, never misses them.
//
// REGISTERS. d0-d2/a0-a3 and nothing else, in every mode: the IDLE caller is VSync_Wait,
// whose contract is exactly that set (Level_LoadArt keeps a4/d5-d7 live across it).
// In: d0.w = PAGE_AUDIT_FULL | PAGE_AUDIT_TICK | PAGE_AUDIT_IDLE
// Out: none (raise_error on failure)   Clobbers: d0-d2/a0-a3
// -----------------------------------------------
pub proc PageCache_Audit (d0: u16) clobbers(d0-d2/a0-a3) {
    if DEBUG == 1 {
        tst.w   d0
        beq     .full                           // PAGE_AUDIT_FULL
        subq.w  #1, d0
        bne     .idle                           // PAGE_AUDIT_IDLE

        // ---- PAGE_AUDIT_TICK ----
        // The PACED sweep: slice s may be audited by the idle slot from interval tick
        // s+1 on, and MUST be audited by tick s+1+PAGE_AUDIT_SLACK_TICKS — if the idle
        // slot has not reached it by then (no idle time for that many ticks), this
        // tick audits the overdue slices itself and counts them in Page_Audit_Late.
        // Pacing is what keeps the latency bound: every word is examined at the same
        // phase of every interval, give or take the slack (header, LATENCY).
        addq.w  #1, Page_Audit_Ticks
        move.w  Page_Audit_Ticks, d0
        cmpi.w  #PAGECACHE_AUDIT_INTERVAL, d0
        bhs     .interval
        tst.b   PageCache_Direct_Map
        beq     .tick_done                      // general regime: its sum stays atomic (header)
        subi.w  #PAGE_AUDIT_SLACK_TICKS+1, d0   // d0 = slices that must be done by now
        ble     .tick_done
        move.w  Page_Audit_Slice, d1
        move.w  d0, d2
        sub.w   d1, d2                          // d2 = overdue slices
        ble     .tick_done
        add.w   d2, Page_Audit_Late
        move.w  d0, Page_Audit_Slice
        move.w  d1, d0                          // first overdue slice
        jbra    .slices_now                     // tail: audit them at this instant
    .tick_done:
        rts

    .interval:
        clr.w   Page_Audit_Ticks
        tst.b   PageCache_Direct_Map
        beq     .interval_general
        move.w  Page_Audit_Slice, d0            // the slices not yet audited this interval
        move.w  #PAGE_AUDIT_SLICES, d2
        sub.w   d0, d2                          // d2 = slices left
        ble     .sweep_done
        add.w   d2, Page_Audit_Late
        jbsr    .slices_now                     // (b) for the rest, at this one instant
    .sweep_done:
        clr.w   Page_Audit_Slice                // the next interval's sweep starts at slice 0
        jbsr    .snapshot
        jbra    .latched_frames
    .interval_general:
        clr.w   Page_Audit_Slice
        // fall into FULL: the general regime's atomic walk, unchanged

        // ---- PAGE_AUDIT_FULL (and the general regime's interval tick) ----
    .full:
        jbsr    .snapshot
        tst.b   PageCache_Direct_Map
        bne     .full_latched

        lea     Page_Audit_Scratch, a0          // zero the per-frame scratch counters
        move.w  #PAGE_FRAMES-1, d0
    .zero:
        clr.w   (a0)+
        dbf     d0, .zero

        lea     Tile_Cache_Nametable, a0        // accumulate refcount per frame (skip tile 0)
        lea     Page_Audit_Scratch, a1
        move.w  #(TILE_CACHE_NT_SIZE/2)-1, d0
    .walk:
        move.w  (a0)+, d1
        andi.w  #NT_TILE_MASK, d1
        beq     .walk_next
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1      // frame id
        add.w   d1, d1                           // word stride
        addq.w  #1, (a1, d1.w)
    .walk_next:
        dbf     d0, .walk

        lea     Page_Audit_Scratch, a0          // compare recomputed vs stored, per frame
        lea     Page_Frames, a1
        move.w  #PAGE_FRAMES-1, d0
    .cmp:
        move.w  (a0)+, d1                       // recomputed
        cmp.w   PF_RC(a1), d1
        beq     .cmp_next
        raise_error "PageCache_Audit: pf_refcount != recomputed nametable count"
    .cmp_next:
        lea     sizeof(PageFrame)(a1), a1
        dbf     d0, .cmp
        jbra    .common

        // DIRECT-MAP regimes (streaming fix F1 + the bounded variant). The collapsed
        // copy-site runs maintain NO refcounts — under the latch nothing can evict, so
        // a refcount is not a live quantity and the comparison above would be a check
        // on a number nobody writes. It is replaced, NOT dropped, by the invariants
        // that are live here (this arm must never become the vacuous one):
        //   (a) every stored refcount is ZERO. A nonzero one means a GENERAL-loop run
        //       executed while the latch was set — the two variants mixed.
        //   (b) every frame the nametable REFERENCES is assigned (pf_page != $FFFF):
        //       the no-dangling-physical-index property the refcounts existed to
        //       protect, re-derived straight from the nametable (.dangling_walk).
        //   (c) Page_Table is STILL the identity over the pool — the premise the whole
        //       collapsed loop rests on, which Level_LoadArt's latch proved only once.
    .full_latched:
        lea     Tile_Cache_Nametable, a0        // (b) over the whole nametable, this instant
        move.w  #(TILE_CACHE_NT_SIZE/2)/4-1, d2 // unrolled 4-way: groups - 1
        jbsr    .dangling_walk
    .latched_frames:
        lea     Page_Frames, a1                 // (a)
        move.w  #PAGE_FRAMES-1, d0
    .dm_rc:
        tst.w   PF_RC(a1)
        beq     .dm_rc_ok
        raise_error "PageCache_Audit: nonzero pf_refcount under the direct-map latch (patch loop variants mixed)"
    .dm_rc_ok:
        lea     sizeof(PageFrame)(a1), a1
        dbf     d0, .dm_rc

        lea     Page_Table, a1                  // (c)
        move.w  PageIn_Pool_Pages, d0
        subq.w  #1, d0
        bmi     .common                         // empty pool -> identity holds vacuously
        // Both latched variants: identity below PAGE_FRAMES_CLAMP and ABSENT above it.
        // A fully resident act's pool never exceeds the clamp, so for it this is the
        // F1 identity check unchanged; for the bounded variant (streaming-lag fix,
        // 2026-09-25) the absent half is its premise that the resident set is exactly
        // the bulk-loaded block.
        moveq   #0, d1                          // d1 = page id (== expected frame id below the clamp)
    .dm_ident:
        move.b  (a1)+, d2
        cmpi.w  #PAGE_FRAMES_CLAMP, d1
        bhs     .dm_absent
        cmp.b   d1, d2
        beq     .dm_ident_ok
        raise_error "PageCache_Audit: Page_Table is not the identity under the direct-map latch"
    .dm_absent:
        cmpi.b  #PAGE_NOT_RESIDENT, d2
        beq     .dm_ident_ok
        raise_error "PageCache_Audit: a page above the bulk-loaded block is resident under the bounded-direct latch"
    .dm_ident_ok:
        addq.w  #1, d1
        dbf     d0, .dm_ident

        // ---- every regime: the frame-level invariants, whole, at this one instant ----
    .common:
        // Candidate-flag invariant (F-1 stamp eviction — replaces the LRU-list
        // walk + cycle bound, which died with the list): PF_EVICTABLE implies
        // assigned + refcount 0 + unpinned. The reverse direction is NOT an
        // invariant (a demand-published frame is legitimately assigned/rc0/
        // unpinned yet unflagged until its first Ref/Unref cycle).
        lea     Page_Frames, a1
        move.w  #(PAGE_FRAMES-1)*sizeof(PageFrame), d1
    .evf:
        move.b  PF_FLAGS(a1, d1.w), d0
        btst    #PF_EVICTABLE_BIT, d0
        beq     .evf_next
        tst.w   PF_RC(a1, d1.w)
        beq     .evf_rc_ok
        raise_error "PageCache_Audit: PF_EVICTABLE frame has refcount>0"
    .evf_rc_ok:
        btst    #PF_PINNED_BIT, d0
        beq     .evf_pin_ok
        raise_error "PageCache_Audit: pinned frame flagged PF_EVICTABLE"
    .evf_pin_ok:
        cmpi.w  #$FFFF, PF_PAGE(a1, d1.w)
        bne     .evf_next
        raise_error "PageCache_Audit: unassigned frame flagged PF_EVICTABLE"
    .evf_next:
        subq.w  #sizeof(PageFrame), d1
        bpl     .evf

        // Demand-hold invariant (stressart-halts GPL-2, 2026-09-26): PF_DEMAND_HELD
        // implies assigned + unpinned, and a held frame needs the gate armed — with
        // Page_Demand_Held 0, PageCache_DemandHoldTick is never called and the hold
        // (which exempts the frame from the orphan check below) would never end.
        lea     Page_Frames, a1
        move.w  #(PAGE_FRAMES-1)*sizeof(PageFrame), d1
    .held:
        btst    #PF_DEMAND_HELD_BIT, PF_FLAGS(a1, d1.w)
        beq     .held_next
        tst.b   Page_Demand_Held
        bne     .held_armed
        raise_error "PageCache_Audit: demand-held frame but the hold gate is disarmed (the hold would never end)"
    .held_armed:
        btst    #PF_PINNED_BIT, PF_FLAGS(a1, d1.w)
        beq     .held_unpinned
        raise_error "PageCache_Audit: pinned frame carries PF_DEMAND_HELD"
    .held_unpinned:
        cmpi.w  #$FFFF, PF_PAGE(a1, d1.w)
        bne     .held_next
        raise_error "PageCache_Audit: unassigned frame carries PF_DEMAND_HELD"
    .held_next:
        subq.w  #sizeof(PageFrame), d1
        bpl     .held

        // --- MAPPING BIJECTIVITY (Task-6 review): the residency map must be a
        //     bijection between resident pages and assigned frames. A consistent-
        //     but-WRONG mapping (page art landing at frame X while Page_Table says
        //     frame Y) passes the refcount/flag checks but renders wrong art; this
        //     cross-check red-screens it at init. ---
        // (1) every assigned frame round-trips: Page_Table[frame.pf_page] == frame.
        //     A frame index is < PAGE_FRAMES <= 32, so the byte compare is the whole
        //     comparison.
        lea     Page_Frames, a1
        lea     Page_Table, a2
        moveq   #0, d0                          // frame index
    .bij_frame:
        move.w  d0, d1
        lsl.w   #3, d1
        move.w  PF_PAGE(a1, d1.w), d2           // pf_page
        cmpi.w  #$FFFF, d2
        beq     .bij_frame_next                 // unassigned frame -> skip
        cmp.b   (a2, d2.w), d0                  // Page_Table[pf_page] (frame idx) == frame?
        beq     .bij_frame_next
        raise_error "PageCache_Audit: frame.pf_page does not round-trip via Page_Table (wrong mapping)"
    .bij_frame_next:
        addq.w  #1, d0
        cmpi.w  #PAGE_FRAMES, d0
        blt     .bij_frame
        // (2) every resident page round-trips: Page_Frames[Page_Table[page]].pf_page == page.
        lea     Page_Table, a1
        lea     Page_Frames, a2
        moveq   #0, d0                          // page index
    .bij_page:
        move.b  (a1, d0.w), d1                  // Page_Table[page] (frame idx)
        andi.w  #$00FF, d1
        cmpi.w  #PAGE_NOT_RESIDENT, d1
        beq     .bij_page_next                  // not resident -> skip
        lsl.w   #3, d1                           // frame offset
        move.w  PF_PAGE(a2, d1.w), d2           // frame.pf_page
        cmp.w   d0, d2
        beq     .bij_page_next
        raise_error "PageCache_Audit: Page_Table entry's frame carries a different page id (wrong mapping)"
    .bij_page_next:
        addq.w  #1, d0
        cmpi.w  #PAGE_TABLE_MAX, d0
        blt     .bij_page

        // --- ORPHAN FRAME (T7 review NIT-2): a frame that is ASSIGNED (pf_page !=
        //     $FFFF) yet is unreachable by every reclaim mechanism — refcount 0,
        //     not PF_EVICTABLE, not pinned, and not the live page-in handoff
        //     frame — has LEAKED: neither the free list nor the candidate scan
        //     can ever hand it back to AllocFrame, so its VRAM is lost until the
        //     next act reset (a class the refcount/flag/bijectivity checks above
        //     all pass). The in-flight DECODE frame is UNASSIGNED (pf_page
        //     $FFFF, soak-fix chain 72), so the pf_page skip already covers it;
        //     the one legitimate assigned/rc0/unflagged transient — a demand
        //     page published but not yet Ref'd by its resuming fill — carries
        //     PF_DEMAND_HELD, and that hold is itself bounded: while any frame is
        //     held, Page_Demand_Held must be armed, or nothing will ever release it
        //     (checked here). This replaced a PageIn_Cur_Frame exemption, which
        //     covered only the LATEST page-in (stressart-halts GPL-2, 2026-09-26:
        //     the frame it raised on was a real leak, a demand page nothing would
        //     ever reference; the hold release now reclaims it). ---
        lea     Page_Frames, a1
        moveq   #0, d0                          // frame index
    .orphan:
        move.w  d0, d2
        lsl.w   #3, d2
        lea     (a1, d2.w), a3                  // &frame[d0]
        cmpi.w  #$FFFF, PF_PAGE(a3)
        beq     .orphan_next                    // unassigned (free / in-flight decode) -> ok
        tst.w   PF_RC(a3)
        bne     .orphan_next                    // referenced -> reachable via a cache word
        move.b  PF_FLAGS(a3), d2                // (d2's offset is spent: a3 holds the frame)
        andi.b  #PF_EVICTABLE | PF_PINNED | PF_DEMAND_HELD, d2
        bne     .orphan_next                    // candidate, pinned, or demand-held (bounded, below)
        raise_error "PageCache_Audit: assigned frame in no reclaim list (leaked/orphan)"
    .orphan_next:
        addq.w  #1, d0
        cmpi.w  #PAGE_FRAMES, d0
        blt     .orphan
        rts

        // ---- PAGE_AUDIT_IDLE: slices while this frame still has room ----
        // The V counter is read BEFORE VBlank_Flag is tested: if the VBlank IRQ lands
        // between the two, the flag is already set when tested; if it landed before
        // the read, the flag is set too. Either way a slice never starts after this
        // frame's VBlank (VInt_Level can run past line 0 of the next frame, where a
        // V-counter-only gate would read a small line number and steal the next
        // tick's time). A slice that starts at or before PAGE_AUDIT_IDLE_LAST_LINE
        // ends before VBlank at the priced cost (constant's note).
    .idle:
        tst.b   PageCache_Direct_Map
        beq     .idle_done                      // general regime: its sum stays atomic (header)
    .idle_slice:
        move.w  Page_Audit_Slice, d0
        cmp.w   Page_Audit_Ticks, d0
        bhs     .idle_done                      // slice s waits for interval tick s+1 (pacing)
        cmpi.w  #PAGE_AUDIT_SLICES, d0
        bhs     .idle_done                      // this interval's sweep is done
        move.w  VDP_HV_COUNTER, d1
        lsr.w   #8, d1                          // V counter (scanline)
        cmpi.w  #PAGE_AUDIT_IDLE_LAST_LINE, d1
        bhi     .idle_done                      // too close to VBlank, or inside it
        tst.b   VBlank_Flag
        bne     .idle_done                      // this frame's VBlank already came
        addq.w  #1, Page_Audit_Slice
        moveq   #1, d2
        jbsr    .slices_now
        jbra    .idle_slice
    .idle_done:
        rts

        // Audit slices [d0, d0+d2) at this instant (d2 >= 1). Clobbers d0-d2/a0-a1.
    .slices_now:
        mul_const.w d2, #PAGE_AUDIT_SLICE_WORDS/4, d1   // -> 4-word groups
        subq.w  #1, d2
        mul_const.w d0, #PAGE_AUDIT_SLICE_BYTES, d1
        lea     Tile_Cache_Nametable, a0
        adda.w  d0, a0
        jbra    .dangling_walk                  // tail

        // Ground-truth snapshot of the residency map (Task-6 mapping-bug debug): a
        // red-screen freezes this readable copy of the free head + Page_Table + per-
        // frame pf_page/flags, so the exact corruption is visible in RAM. Taken on
        // every call that runs the frame-level checks (FULL and the interval tick);
        // a raise from an idle slice leaves the last interval's snapshot.
        // Clobbers d0/a0-a1.
    .snapshot:
        lea     Page_Audit_Snapshot, a0
        move.b  Page_Free_Head, (a0)+           // [0]
        move.b  #$FF, (a0)+                     // [1] reserved (was LRU head — stamp eviction has no list)
        move.b  #$FF, (a0)+                     // [2] reserved (was LRU tail)
        clr.b   (a0)+                           // [3] pad
        lea     Page_Table, a1                  // [4..4+SNAP_TABLE_ENTRIES) = Page_Table head
        moveq   #SNAP_TABLE_ENTRIES-1, d0
    .snap_tab:
        move.b  (a1)+, (a0)+
        dbf     d0, .snap_tab
        lea     Page_Frames, a1                 // [20..50) = per frame: pf_page.lo, pf_flags
        moveq   #PAGE_FRAMES-1, d0
    .snap_frame:
        move.b  PF_PAGE+1(a1), (a0)+           // pf_page low byte (page id / $FF when unassigned)
        move.b  PF_FLAGS(a1), (a0)+            // PINNED/EVICTABLE flags (free-list MEMBERSHIP is derivable via pf_page.lo==$FF; link order is not captured)
        lea     sizeof(PageFrame)(a1), a1
        dbf     d0, .snap_frame
        rts

        // (b) over 4*(d2+1) nametable words from a0, against THIS instant's frame
        // state: d0 = a 32-bit mask with bit f clear iff frame f (< PAGE_FRAMES) is
        // unassigned, built here, in the same call as the words are read. Frame ids
        // >= PAGE_FRAMES keep their bit set: the whole-walk audit never checked them
        // either (its per-frame loop stopped at PAGE_FRAMES), so coverage is kept, not
        // widened. `btst dN, dM` takes the bit number MOD 32, so a raw word shifted
        // right by PAGE_FRAME_TILE_SHIFT needs no mask: bits 0-4 are the frame id
        // (bits 6-10 of the word) and the attribute bits land in 5-9, which btst
        // ignores. Tile 0 (the blank word) names frame 0: while frame 0 is assigned it
        // passes, exactly as the counting walk's skip did, so the 4-way unrolled FAST
        // loop needs no tile-0 test. If frame 0 is ever UNASSIGNED a blank word would
        // false-fail, so that case takes the SLOW loop, which skips tile 0 explicitly.
        // Clobbers d0-d2/a0-a1.
    .dangling_walk:
        moveq   #-1, d0
        lea     Page_Frames, a1
        moveq   #0, d1                          // frame index
    .dw_mask:
        cmpi.w  #$FFFF, PF_PAGE(a1)
        bne     .dw_mask_next
        bclr    d1, d0                          // unassigned -> a word naming it is dangling
    .dw_mask_next:
        lea     sizeof(PageFrame)(a1), a1
        addq.w  #1, d1
        cmpi.w  #PAGE_FRAMES, d1
        blo     .dw_mask
        btst    #0, d0
        beq     .dw_slow                        // frame 0 unassigned: blank words need the skip
    .dw_fast:
        move.w  (a0)+, d1
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1      // bits 0-4 = frame id; btst reads only those
        btst    d1, d0
        beq     .dw_dangling
        move.w  (a0)+, d1
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1
        btst    d1, d0
        beq     .dw_dangling
        move.w  (a0)+, d1
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1
        btst    d1, d0
        beq     .dw_dangling
        move.w  (a0)+, d1
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1
        btst    d1, d0
        beq     .dw_dangling
        dbf     d2, .dw_fast
        rts
    .dw_slow:
        add.w   d2, d2                          // (n/4 - 1) -> n - 1 words: *4 + 3
        add.w   d2, d2
        addq.w  #3, d2
    .dw_word:
        move.w  (a0)+, d1
        andi.w  #NT_TILE_MASK, d1
        beq     .dw_next
        lsr.w   #PAGE_FRAME_TILE_SHIFT, d1      // frame id
        btst    d1, d0
        beq     .dw_dangling
    .dw_next:
        dbf     d2, .dw_word
        rts
    .dw_dangling:
        raise_error "PageCache_Audit: nametable references an UNASSIGNED frame (dangling physical index)"
    } else {
        rts
    }
}
