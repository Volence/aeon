// 2D tile cache (§4.7)
// Linear 2D buffer in lower RAM. Slides in both axes as camera moves.
// Block-based decompression: each 16×16 tile block decompressed on demand.
// Continuous-scroll: camera, player, and entities live in WORLD coordinates,
// so a camera tile coord (Camera_X/8, Camera_Y/8) IS already a world tile coord.

module engine.tile_cache in tile_cache

use engine.structs.{Act, Sec, Act_grid_w_lo, Act_grid_h_lo}
use engine.constants.{TILE_CACHE_COLS, TILE_CACHE_ROWS, TILE_CACHE_STRIDE, TILE_CACHE_NT_SIZE, MAX_ACT_SECTIONS}
use engine.constants.{TILE_CACHE_COLL_ROWS, TILE_CACHE_COLL_SIZE, TILE_CACHE_COLL_PLANES, TILE_CACHE_MARGIN_H, TILE_CACHE_MARGIN_V}
use engine.constants.{BLOCK_TILE_SIZE, BLOCK_TILE_SHIFT, BLOCK_NT_SIZE, BLOCK_COLL_ROWS, BLOCK_COLL_COLS, BLOCK_COLL_PLANE_SIZE}
use engine.constants.{BLOCK_COLL_SIZE, BLOCK_RAW_SIZE, BLOCK_STAGE_SLOTS, BLOCK_DECOMP_BUDGET, BLOCK_INDEX_SIZE, VFILL_ROWS_PER_FRAME, H_PFX_HYST}

// S4LZ_DecompressDict is .emp-owned (engine.s4lz) and resolves at link — no
// decl; its contract (a4=dict base, d4.w=dict len preserved, clobbers
// d0-d3/a0/a2-a4, out a1) travels with the proc itself.

// The COLL_* / BLOCK_* tile-cache geometry (derived from TILE_CACHE_ROWS/COLS +
// BLOCK_TILE_SIZE) now lives in the shared engine.constants twin — `use`d above.

// ---- Sec / Act field access comes from the shared engine.structs module
// (`Sec.field(aN)` / `Act.field(aN)`, the grid-dim low-byte views via
// Act_grid_w_lo / Act_grid_h_lo) — the file-local offset-const mirrors are gone. ----
// (Act/Sec field-offset drift guards now live in engine.structs' per-field wall.)
// TileCache_DecompressBlock multiplies the flat section id by sizeof(Sec) = 66;
// the `ensure` keeps 66 the real stride.
ensure(sizeof(Sec) == 66, "tile_cache multiplies by #66 — keep sizeof(Sec)=66 or the stride is wrong")

// coll_src_row_base — staged-block collision-row byte base from an intra-block
// tile row (mirrors the AS `collSrcRowBase` macro). Parity-safe: halve the tile
// row to the 16px collision cell, then scale by BLOCK_COLL_COLS. The ×16 shift
// assumes BLOCK_COLL_COLS=16 — the comptime guard makes a drift unrepresentable
// (the macro's `if BLOCK_COLL_COLS <> 16 / error`). File-local (single consumer).
comptime fn coll_src_row_base(reg: Reg) -> Code {
    ensure(BLOCK_COLL_COLS == 16, "coll_src_row_base assumes BLOCK_COLL_COLS=16 (lsl #4); update the shift")
    return asm {
        lsr.w   #1, {reg}                       // tile row -> collision row (16px cell)
        lsl.w   #4, {reg}                        // * BLOCK_COLL_COLS (16 bytes per row)
    }
}

// decompose_block — split a WORLD TILE (col, row) into section coords + block
// index for a FindStagedBlock / DecompressBlock probe: sec = tile >> 8 (256-tile
// sections), block = (tile >> 4) & 15, block_index = block_y*16 + block_x. Names
// the idiom the donor flagged "(same pattern as FillColumn/FillRow)". File-local.
// col/row must be preserved regs (NOT the
// d0-d3 scratch). Out: d0 = sec_x, d1 = sec_y, d2 = block_index. Clobbers d0-d3.
comptime fn decompose_block(col: Reg, row: Reg) -> Code {
    return asm {
        move.w  {col}, d0
        lsr.w   #8, d0                         // sec_x = tile_col >> 8
        move.w  {row}, d1
        lsr.w   #8, d1                         // sec_y = tile_row >> 8
        move.w  {col}, d2
        lsr.w   #BLOCK_TILE_SHIFT, d2
        andi.w  #$F, d2                        // block_x = (tile_col >> 4) & 15
        move.w  {row}, d3
        lsr.w   #BLOCK_TILE_SHIFT, d3
        andi.w  #$F, d3                        // block_y = (tile_row >> 4) & 15
        lsl.w   #4, d3
        add.w   d2, d3
        move.w  d3, d2                         // block_index = block_y*16 + block_x
    }
}

// mul_cache_stride — multiply a cache row by TILE_CACHE_STRIDE = 80 (the row width)
// via `mul_const.w #80`. Names the ×80 idiom used by GetTile and FillRow's
// cache_row_offset (the "form (a)" sites that need a separate scratch reg;
// CopyBlockColumn's "form (b)" single-temp variant stays inline). Collision lookup
// carries its own inline copy (engine.collision_lookup). The comptime guard makes a
// stride drift unrepresentable.
// dst ends = dst*stride; scratch is trashed.
comptime fn mul_cache_stride(dst: Reg, scratch: Reg) -> Code {
    ensure(TILE_CACHE_STRIDE == 80, "mul_cache_stride multiplies by #80; keep TILE_CACHE_STRIDE=80 or the row stride is wrong")
    return asm {
        mul_const.w {dst}, #80, {scratch}         // dst × 80 (= TILE_CACHE_STRIDE); scratch trashed
    }
}

// -----------------------------------------------
// Tile_Cache_GetTile — look up nametable word for a world tile position
// In:  d0.w = world tile col, d1.w = world tile row
// Out: d2.w = nametable word
// Clobbers: d0-d2, a0
// -----------------------------------------------
pub proc Tile_Cache_GetTile (d0: u16, d1: u16) clobbers(d0-d1/a0) out(d2) {
        sub.w   Cache_Left_Col, d0
        add.w   Cache_Origin_Col, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .col_nowrap
        subi.w  #TILE_CACHE_COLS, d0
    .col_nowrap:
        sub.w   Cache_Top_Row, d1
        add.w   Cache_Origin_Row, d1
        cmpi.w  #TILE_CACHE_ROWS, d1
        blt     .row_nowrap
        subi.w  #TILE_CACHE_ROWS, d1
    .row_nowrap:
        mul_cache_stride(d1, d2)              // d1 = row * TILE_CACHE_STRIDE
        add.w   d0, d1
        add.w   d1, d1                         // ×2 for word-sized entries
        lea     Tile_Cache_Nametable, a0
        move.w  (a0, d1.w), d2
        rts
}

// Tile_Cache_GetCollision was folded into engine.collision_lookup's
// Collision_GetType (its sole caller, via the former jbra tail call). The
// bounds check and the cache-relative fetch now share the Cache_Left_Col /
// Cache_Top_Row reads there.

// -----------------------------------------------
// BlockStage_PtrTable — ROM table of staging slot base addresses.
// Parallel to Block_Stage_Keys; slot N's nametable starts here, collision
// follows at +BLOCK_NT_SIZE.
// -----------------------------------------------
pub data BlockStage_PtrTable: [*u8; BLOCK_STAGE_SLOTS] = comptime for i in 0..BLOCK_STAGE_SLOTS { extern("Block_Stage_Buffers") + i * BLOCK_RAW_SIZE }

// -----------------------------------------------
// TileCache_FindStagedBlock — probe staging cache for a decompressed block
// In:  d0.w = sec_x, d1.w = sec_y, d2.w = block_index (0–255)
// Out: Z set + a1 = slot base (nametable; collision at +BLOCK_NT_SIZE) on hit;
//      Z clear on miss (a1 trashed). d0–d2 preserved.
// Clobbers: d3-d4, a1
// CONTRACT — a1 is a RESULT on the eq edge and SCRATCH on the others, which is
// why it is declared in both `clobbers` and `out`. The probe walks a1 across the
// key table before the hit/miss is known, so the miss exit returns a1 destroyed;
// a caller holding a value in a1 must save it on every path.
// -----------------------------------------------
pub proc TileCache_FindStagedBlock (d0: u16, d1: u16, d2: u16) clobbers(d3-d4/a1) out(a1 if eq) preserves(d0-d2) {
        move.w  d0, d3
        lsl.w   #8, d3
        move.b  d1, d3
        swap    d3
        move.w  d2, d3                         // d3.l = key (sec_x|sec_y|block_index)
        lea     Block_Stage_Keys, a1
        moveq   #BLOCK_STAGE_SLOTS-1, d4
    .probe:
        cmp.l   (a1)+, d3
        dbeq    d4, .probe
        bne     .miss
        // slot index × 4 = (a1 - 4) - Block_Stage_Keys
        move.w  a1, d3
        subi.w  #(Block_Stage_Keys+4) & $FFFF, d3
        lea     Block_Stage_Ptrs, a1
        movea.l (a1, d3.w), a1                 // a1 = staged data pointer (RAM slot / raw ROM block / zero page)
        moveq   #0, d3                         // Z set (hit)
        rts
    .miss:
        moveq   #1, d3                         // Z clear (miss)
        rts
}

// -----------------------------------------------
// TileCache_InvalidateStaging — empty all staging slots
// Clobbers: d0, a0
// -----------------------------------------------
pub proc TileCache_InvalidateStaging () clobbers(d0/a0) {
        lea     Block_Stage_Keys, a0
        moveq   #BLOCK_STAGE_SLOTS-1, d0
    .inv:
        move.l  #-1, (a0)+
        dbf     d0, .inv
        clr.w   Block_Stage_Next
        addq.w  #1, Block_Stage_Gen            // staging emptied — every warm-line memo now stale
        move.w  #$FFFF, Pfx_Memo_Gen           // sentinel: the next frame's scans re-probe in full
        move.w  #$FFFF, Cs_Memo_Gen
        rts
}

// -----------------------------------------------
// TileCache_DecompressBlock — decompress one 16×16 block into a staging slot
// Claims the next round-robin slot and records the key, so subsequent
// TileCache_FindStagedBlock probes hit it.
// Index entry forms: 0 = empty (zero-fill); bit 31 set = RAW DIRECT (offset
// from table base to an uncompressed 768-byte block in the dict region —
// straight ROM→slot copy); else = S4LZ v3 stream decoded with the section's
// block dictionary pre-seeding the window (Sec.sec_block_dict/_len).
// In:  d0.w = sec_x, d1.w = sec_y, d2.w = block_index (0–255)
// Out: a1 = slot base (nametable; collision at +BLOCK_NT_SIZE)
// Clobbers: d0-d7, a0-a4
// -----------------------------------------------
pub proc TileCache_DecompressBlock (d0: u16, d1: u16, d2: u16) clobbers(d0-d7/a0/a2-a4) out(a1) {
        // claim next round-robin slot, record key
        move.w  d0, d3
        lsl.w   #8, d3
        move.b  d1, d3
        swap    d3
        move.w  d2, d3                         // d3.l = key
        move.w  Block_Stage_Next, d4
        move.w  d4, d5
        addq.w  #1, d5
        cmpi.w  #BLOCK_STAGE_SLOTS, d5
        blt     .rr_ok
        moveq   #0, d5
    .rr_ok:
        move.w  d5, Block_Stage_Next
        addq.w  #1, Block_Stage_Gen            // a new staging claim invalidates every warm-line memo
        add.w   d4, d4
        add.w   d4, d4                         // slot index × 4
        lea     Block_Stage_Keys, a1
        move.l  d3, (a1, d4.w)
        lea     BlockStage_PtrTable(pc), a1
        movea.l (a1, d4.w), a3                 // a3 = dest slot base
        move.w  d4, d6                         // preserve slot×4 for the empty/raw pointer store
        lea     Block_Stage_Ptrs, a1
        move.l  a3, (a1, d4.w)                 // default staged pointer = RAM slot (compressed decodes into it)

        movea.l Current_Act_Ptr, a0
        movea.l Act.sec_grid_ptr(a0), a1

        // -- world-edge guard: the fixed-width cache extends past the act
        //    grid at boundaries (and debug-fly wanders anywhere), so out-of-
        //    grid requests are legitimate — they decompress as blank blocks
        //    (tile 0, collision 0) instead of indexing the Sec table out of
        //    range. The key recorded above caches the blank like any block. --
        cmp.w   Act.grid_w(a0), d0
        bhs     .empty_block                   // (target past .s in DEBUG only — the .raw_direct assert block; bare relaxes per shape, twin ifdefs it)
        cmp.w   Act.grid_h(a0), d1
        bhs     .empty_block

        // sec_id = sec_y * grid_w + sec_x. grid_w and sec_y are bounded by
        // MAX_ACT_SECTIONS (build-asserted grid_w*grid_h <= it), so the bounded
        // multiply prices mulu the winner over the cold-path add loop.
        move.w  Act.grid_w(a0), d3             // d3 = grid_w
        mul_bounded.w d3, d1, #MAX_ACT_SECTIONS // d3 = grid_w * sec_y
        add.w   d0, d3                         // d3 = flat section id
        mul_const.w d3, #66, d4                // d3 = flat × sizeof(Sec) = 66 (d4 = multiply scratch)
        adda.w  d3, a1                         // a1 = Sec struct pointer

        movea.l Sec.sec_block_index(a1), a2    // a2 = block index table base (ROM)
        move.l  a2, d3
        beq     .empty_block                   // (target past .s in DEBUG only — the .raw_direct assert block; bare relaxes per shape, twin ifdefs it)

        // index into block table: block_index × 4
        move.w  d2, d3
        lsl.w   #2, d3
        move.l  (a2, d3.w), d0                 // d0 = offset from table base (0 = null)
        beq     .empty_block
        bmi     .raw_direct                    // bit 31 = raw block in the dict region

        // compressed v3 stream — decode with the section dictionary window
        lea     (a2, d0.l), a0                 // a0 = compressed block data
        move.w  Sec.sec_block_dict_len(a1), d4 // d4 = dict bytes (0 = none)
        movea.l Sec.sec_block_dict(a1), a4     // a4 = raw dict base (ROM)
        movea.l a3, a1
        move.l  a3, -(sp)                      // decompress clobbers a3, advances a1
        jbsr    S4LZ_DecompressDict            // engine.s4lz (module-to-module)
        movea.l (sp)+, a1                      // a1 = slot base
        rts

    .raw_direct:
        bclr    #31, d0                        // d0 = byte offset of the raw block
        if DEBUG == 1 {
            assert.l d0, hs, #BLOCK_INDEX_SIZE  // raw region sits past the index
            move.w  d0, d3
            andi.w  #1, d3
            assert.w d3, eq                    // raw offset must be word-even
        }
        lea     (a2, d0.l), a0                 // a0 = raw 768-byte block (ROM, slot layout)
        // point the slot straight at the uncompressed ROM block — no copy. The
        // ROM block is BLOCK_RAW_SIZE in slot layout (nametable + collision) exactly
        // as a decompressed slot, and consumers only read through the pointer.
        lea     Block_Stage_Ptrs, a1
        move.l  a0, (a1, d6.w)
        movea.l a0, a1                         // a1 = raw ROM block
        rts

    .empty_block:
        // point the slot at the shared read-only zero page — no 768-byte zero-fill.
        // The page is boot-cleared and never written (the staged-pointer read-only
        // contract), so it stays zero for the life of the ROM.
        lea     Block_Stage_ZeroPage, a0
        lea     Block_Stage_Ptrs, a1
        move.l  a0, (a1, d6.w)
        movea.l a0, a1                         // a1 = zero page
        rts
}

// -----------------------------------------------
// TileCache_CopyBlockColumn — copy a vertical run of one block column into cache
// In:  d0.w = intra-block col (0–15)
//      d1.w = cache col offset (world_col - Cache_Left_Col)
//      d2.w = dest cache row offset (world_row - Cache_Top_Row); even
//      d3.w = rows to copy (> 0, even)
//      d4.w = source start row within block (0–15, even)
//      a1   = staged block base (nametable; collision at +BLOCK_NT_SIZE)
//      a5   = Tile_Cache_Nametable base (H6 hoist — caller-set, loop-invariant)
//      a6   = Tile_Cache_Collision base (H6 hoist — caller-set, loop-invariant)
// Out: none; a1/a5/a6 preserved
// Clobbers: d0-d3, d5, a0, a2-a3
// Note: d2/d3/d4 even is guaranteed because Cache_Top_Row is kept even and
//       block tops are multiples of 16 — collision halving stays exact.
//       Cache_Origin_Row is also kept even, so the physical row keeps the
//       logical row's parity and physical_row/2 = physical collision row.
// -----------------------------------------------
pub proc TileCache_CopyBlockColumn (d0: u16, d1: u16, d2: u16, d3: u16, d4: u16, a1: *u8, a5: *u8, a6: *u8) clobbers(d0-d3/d5/a0/a2-a3) {
        // wrap d1 (logical cache col) to physical column via circular origin
        add.w   Cache_Origin_Col, d1
        cmpi.w  #TILE_CACHE_COLS, d1
        blt     .col_nowrap
        subi.w  #TILE_CACHE_COLS, d1
    .col_nowrap:
        // wrap d2 (logical dest row) to physical row via circular origin
        add.w   Cache_Origin_Row, d2
        cmpi.w  #TILE_CACHE_ROWS, d2
        blt     .row_nowrap
        subi.w  #TILE_CACHE_ROWS, d2
    .row_nowrap:
        // source: slot base + (src_row * 16 + col) * 2
        movea.l a1, a0
        move.w  d4, d5
        lsl.w   #5, d5                         // src_row * 32 bytes
        adda.w  d5, a0
        move.w  d0, d5
        add.w   d5, d5                         // col * 2
        adda.w  d5, a0                         // a0 = first tile word in run

        // dest: Tile_Cache_Nametable + (phys_row * stride + cache_col) * 2
        // ×80 = ((x<<2)+x)<<4 — single temp
        move.w  d2, d5
        lsl.w   #2, d5
        add.w   d2, d5
        lsl.w   #4, d5                         // d5 = phys_row * 80
        add.w   d1, d5                         // + cache_col
        add.w   d5, d5                         // byte offset
        movea.l a5, a2                        // H6: hoisted NT base (a5, set by the caller — survives DecompressBlock)
        adda.w  d5, a2

        // wrap-split: the vertical run (≤16 rows) crosses the cache row-59→0
        // boundary at most once, so emit ≤2 straight copies split there instead
        // of a per-row sentinel test — byte-identical dest, no per-row wrap branch.
        move.w  #TILE_CACHE_ROWS, d5
        sub.w   d2, d5                         // d5 = rows until the dest column wraps
        cmp.w   d3, d5
        bge     .nt_one_run                    // whole run fits before the wrap
        subq.w  #1, d5
    .nt_run1:
        move.w  (a0), (a2)
        lea     BLOCK_TILE_SIZE*2(a0), a0      // next block row (32 bytes)
        lea     TILE_CACHE_STRIDE*2(a2), a2    // next cache row (160 bytes)
        dbf     d5, .nt_run1
        suba.w  #TILE_CACHE_NT_SIZE, a2        // dest wraps row 59 → 0, keeping cache_col
        move.w  d3, d5
        add.w   d2, d5
        subi.w  #TILE_CACHE_ROWS, d5           // d5 = rows after the wrap
        jbra    .nt_run2
    .nt_one_run:
        move.w  d3, d5
    .nt_run2:
        subq.w  #1, d5
    .nt_run2_loop:
        move.w  (a0), (a2)
        lea     BLOCK_TILE_SIZE*2(a0), a0
        lea     TILE_CACHE_STRIDE*2(a2), a2
        dbf     d5, .nt_run2_loop

        // collision plane A: src = slot base + BLOCK_NT_SIZE + (src_row/2)*16 + col
        // src_row (d4) is even here, but use the parity-safe macro anyway so this
        // site cannot drift into the FillRow odd-row trap class (§5).
        lea     BLOCK_NT_SIZE(a1), a0
        move.w  d4, d5
        coll_src_row_base(d5)                  // (src_row/2) * BLOCK_COLL_COLS
        adda.w  d5, a0
        adda.w  d0, a0                         // + col (bytes, not words)

        // dest plane A: Tile_Cache_Collision + (phys_row/2)*80 + cache_col
        lsr.w   #1, d2                         // d2 = physical collision row (halved)
        move.w  d2, d5
        lsl.w   #2, d5
        add.w   d2, d5
        lsl.w   #4, d5                         // d5 = collision_row * 80
        add.w   d1, d5                         // d5 = dest byte offset within plane
        movea.l a6, a2                        // H6: hoisted collision base (a6, set by the caller)
        adda.w  d5, a2

        lsr.w   #1, d3                         // d3 = collision rows to copy (tile rows / 2)
        // Both planes copied in ONE run: the fixed displacements reach plane B
        // from the plane-A cursors (source +BLOCK_COLL_PLANE_SIZE, dest
        // +TILE_CACHE_COLL_SIZE). Plane B's wrap is free — when the plane-A
        // dest wraps to row 0, the +TILE_CACHE_COLL_SIZE displacement still
        // lands on the correct plane B row. Same wrap-split as the nametable
        // loop: the ≤8-row run crosses the plane-A row-29→0 boundary at most
        // once — ≤2 straight copies, no per-row wrap branch.
        tst.w   d3
        beq     .done_coll
        move.w  #TILE_CACHE_COLL_ROWS, d5
        sub.w   d2, d5                         // d5 = collision rows until the dest wraps
        cmp.w   d3, d5
        bge     .coll_one_run
        subq.w  #1, d5
    .coll_run1:
        move.b  (a0), (a2)                                       // plane A
        move.b  BLOCK_COLL_PLANE_SIZE(a0), TILE_CACHE_COLL_SIZE(a2) // plane B
        lea     BLOCK_TILE_SIZE(a0), a0        // next collision row in block (16 bytes)
        lea     TILE_CACHE_STRIDE(a2), a2      // next collision row in cache (80 bytes)
        dbf     d5, .coll_run1
        suba.w  #TILE_CACHE_COLL_SIZE, a2      // wrap plane A row 29 → 0, keeping cache_col
        move.w  d3, d5
        add.w   d2, d5
        subi.w  #TILE_CACHE_COLL_ROWS, d5      // d5 = rows after the wrap
        jbra    .coll_run2
    .coll_one_run:
        move.w  d3, d5
    .coll_run2:
        subq.w  #1, d5
    .coll_run2_loop:
        move.b  (a0), (a2)                                       // plane A
        move.b  BLOCK_COLL_PLANE_SIZE(a0), TILE_CACHE_COLL_SIZE(a2) // plane B
        lea     BLOCK_TILE_SIZE(a0), a0
        lea     TILE_CACHE_STRIDE(a2), a2
        dbf     d5, .coll_run2_loop
    .done_coll:
        rts
}

// -----------------------------------------------
// Tile_Cache_Init — populate cache for initial viewport + margins
// Called at level init (display off).
// In:  none (reads Camera_X, Camera_Y, Current_Act_Ptr)
// Out: none
// Clobbers: d0-d7, a0-a6
// -----------------------------------------------
pub proc Tile_Cache_Init () clobbers(d0-d7/a0-a6) {
        // compute world tile bounds for initial fill
        move.l  Camera_X, d0
        swap    d0
        lsr.w   #3, d0                         // camera world tile col
        subi.w  #TILE_CACHE_MARGIN_H, d0
        bpl     .left_ok
        moveq   #0, d0
    .left_ok:
        move.w  d0, Cache_Left_Col
        addi.w  #TILE_CACHE_COLS-1, d0
        move.w  d0, Cache_Head_Col
        clr.w   Cache_Origin_Col
        clr.w   Cache_Origin_Row
        move.w  #$FFFF, Cache_Fill_Last_Frame
        move.w  #$FFFF, Cache_Fill_Resume_Col
        move.w  #$FFFF, Cache_Fill_RowResume_Row

        move.l  Camera_Y, d0
        swap    d0
        lsr.w   #3, d0                         // camera world tile row
        move.w  d0, Cache_Prev_Cam_Row     // init vertical prefetch baseline
        // init horizontal prefetch baseline (else the first H-motion frame sees a
        // huge spurious delta off Cache_Prev_Cam_X=0 and mis-latches the direction)
        move.l  Camera_X, d1
        swap    d1
        move.w  d1, Cache_Prev_Cam_X
        clr.w   Cache_H_Pfx_Dir
        clr.w   Cache_H_Pfx_Accum
        clr.w   Cache_Pfx_Skip_Armed
        clr.w   Cache_Pfx_Lag_Flag             // trailing-lag gate baseline (no false skip on frame 1)
        subi.w  #TILE_CACHE_MARGIN_V, d0
        bpl     .top_ok
        moveq   #0, d0
    .top_ok:
        andi.w  #$FFFE, d0                     // keep Cache_Top_Row even (collision cell alignment)
        move.w  d0, Cache_Top_Row
        addi.w  #TILE_CACHE_ROWS-1, d0
        move.w  d0, Cache_Bottom_Row

        jbsr    TileCache_InvalidateStaging

        jbsr    TileCache_FillAll
        jbsr    TileCache_WarmupBelowRow       // cold-start warmup: pre-stage the below-row
        rts
}

// -----------------------------------------------
// TileCache_FillAll — fill entire cache from block data
// Called at init and after full reinit.
// In:  none (reads Cache_Left_Col/Head_Col/Top_Row/Bottom_Row)
// Out: none
// Clobbers: d0-d7, a0-a6
// -----------------------------------------------
pub proc TileCache_FillAll () clobbers(d0-d7/a0-a6) {
        // H6: hoist the CopyBlockColumn base leas — a5/a6 survive DecompressBlock,
        // loop-invariant for the whole fill (mirrors FillColumn's hoist).
        lea     Tile_Cache_Nametable, a5
        lea     Tile_Cache_Collision, a6
        // zero the cache first
        lea     Tile_Cache_Nametable, a0
        move.w  #(TILE_CACHE_NT_SIZE/4)-1, d0
    .zero_nt:
        clr.l   (a0)+
        dbf     d0, .zero_nt

        lea     Tile_Cache_Collision, a0
        move.w  #(TILE_CACHE_COLL_SIZE*TILE_CACHE_COLL_PLANES/4)-1, d0
    .zero_coll:
        clr.l   (a0)+
        dbf     d0, .zero_coll

        // iterate over all blocks overlapping the cache window
        // world_block_col = world_tile_col / 16; world_block_row = world_tile_row / 16
        // Each world block maps to: sec_x = block_col / 16, intra_block_x = block_col & 15

        move.w  Cache_Left_Col, d0
        lsr.w   #BLOCK_TILE_SHIFT, d0          // first world block col
        move.w  d0, -(sp)                      // save start_block_col

        move.w  Cache_Head_Col, d0
        lsr.w   #BLOCK_TILE_SHIFT, d0
        move.w  d0, -(sp)                      // save end_block_col

        move.w  Cache_Top_Row, d0
        lsr.w   #BLOCK_TILE_SHIFT, d0
        move.w  d0, -(sp)                      // save start_block_row (also current)

        move.w  Cache_Bottom_Row, d0
        lsr.w   #BLOCK_TILE_SHIFT, d0
        move.w  d0, -(sp)                      // save end_block_row

        // stack layout: 0(sp)=end_row, 2(sp)=cur_row, 4(sp)=end_col, 6(sp)=start_col

    .block_row_loop:
        move.w  6(sp), d6                      // d6 = current block col (reset to start)

    .block_col_loop:
        // decompose world block coords into section + intra-block
        move.w  d6, d0
        lsr.w   #BLOCK_TILE_SHIFT, d0          // sec_x = world_block_col / 16
        move.w  2(sp), d7
        move.w  d7, d1
        lsr.w   #BLOCK_TILE_SHIFT, d1          // sec_y = world_block_row / 16
        move.w  d6, d2
        andi.w  #$F, d2                        // intra_block_x
        move.w  d7, d3
        andi.w  #$F, d3                        // intra_block_y
        // block_index = intra_block_y * 16 + intra_block_x
        lsl.w   #4, d3
        add.w   d2, d3
        move.w  d3, d2                         // d2 = block_index

        movem.l d6/d7, -(sp)
        jbsr    TileCache_DecompressBlock
        movem.l (sp)+, d6/d7

        // copy all 16 columns from staging into cache
        move.w  d6, d4
        lsl.w   #BLOCK_TILE_SHIFT, d4          // world tile col of block left
        move.w  2(sp), d5                      // current world block row
        lsl.w   #BLOCK_TILE_SHIFT, d5          // world tile row of block top

        moveq   #0, d0                         // intra-block col counter
    .fill_copy_col:
        // cache col offset = (block_left_tile + intra_col) - Cache_Left_Col
        move.w  d4, d1
        add.w   d0, d1
        sub.w   Cache_Left_Col, d1
        bmi     .fill_skip_col
        cmpi.w  #TILE_CACHE_COLS, d1
        bge     .fill_skip_col

        // dest row offset = block_top_tile - Cache_Top_Row.
        // If the block straddles the cache top, clip dest to row 0 and
        // offset the SOURCE by the clipped amount instead.
        move.w  d5, d2
        sub.w   Cache_Top_Row, d2          // signed dest row
        move.w  d2, d7
        bpl     .fill_no_clip
        moveq   #0, d2
    .fill_no_clip:
        sub.w   d2, d7
        neg.w   d7                             // d7 = source start row (0 if no clip)
        cmpi.w  #BLOCK_TILE_SIZE, d7
        bge     .fill_skip_col                 // block entirely above cache

        // rows = min(TILE_CACHE_ROWS - dest_row, BLOCK_TILE_SIZE - src_start)
        move.w  #TILE_CACHE_ROWS, d3
        sub.w   d2, d3
        ble     .fill_skip_col                 // block entirely below cache
        neg.w   d7
        addi.w  #BLOCK_TILE_SIZE, d7           // d7 = rows available in block
        cmp.w   d7, d3
        ble     .fill_rows_ok
        move.w  d7, d3
    .fill_rows_ok:
        movem.l d0/d4-d6, -(sp)
        move.w  #BLOCK_TILE_SIZE, d4
        sub.w   d7, d4                         // d4 = source start row
        jbsr    TileCache_CopyBlockColumn
        movem.l (sp)+, d0/d4-d6
    .fill_skip_col:
        addq.w  #1, d0
        cmpi.w  #BLOCK_TILE_SIZE, d0
        blt     .fill_copy_col

        // next block col
        addq.w  #1, d6
        cmp.w   4(sp), d6                     // compare with end_block_col
        ble     .block_col_loop

        // next block row
        move.w  2(sp), d0
        addq.w  #1, d0
        move.w  d0, 2(sp)
        cmp.w   (sp), d0                      // compare with end_block_row
        ble     .block_row_loop

        lea     8(sp), sp                     // clean up stack
        rts
}

// -----------------------------------------------
// TileCache_WarmupBelowRow — cold-start warmup
// Pre-stages the ENTIRE block-row just below the initial cache window so the
// FIRST downward crossing is warm — before the leftover-budget row prefetch has
// had any quiet frames to work. Targets the cold-start regime the leftover-budget
// prefetch structurally can't cover (the first crossing has no prior quiet frames). Called once from
// Tile_Cache_Init after FillAll, display OFF: the ~5-6 extra synchronous
// decompresses ride Init's existing ~10-frame cost, no lag concern. Down-scroll
// assumption (the common level-entry direction); an up-scroll from spawn simply
// doesn't benefit — no correctness cost either way (staging is a decompress
// cache; unused pre-staged blocks evict harmlessly as scroll proceeds).
// Init-only by design: Reinit is mid-play recovery where the scroll direction
// is unknown, so the down assumption doesn't hold there.
// In:  none (reads Cache_Bottom_Row/Left_Col/Head_Col, Current_Act_Ptr)
// Out: none
// Clobbers: d0-d7, a0-a4 (DecompressBlock's set + scan temps; a5/a6 preserved)
// -----------------------------------------------
pub proc TileCache_WarmupBelowRow () clobbers(d0-d7/a0-a4) {
        // target = first world tile row of the block-row below cache bottom
        // (mirrors the prefetch down-branch: align bottom to block start + one block)
        move.w  Cache_Bottom_Row, d7
        andi.w  #~(BLOCK_TILE_SIZE-1), d7      // align down to block start
        addi.w  #BLOCK_TILE_SIZE, d7           // first row of the block below
        // guard: sec_y = d7 >> 8 must be < grid_h (else below the world — nothing to warm)
        move.w  d7, d5
        lsr.w   #8, d5                         // sec_y
        movea.l Current_Act_Ptr, a0
        moveq   #0, d0
        move.b  Act_grid_h_lo(a0), d0           // grid_h (sections)
        cmp.w   d0, d5
        bcc     .done                          // sec_y >= grid_h — below the world, skip

        // scan block cols [Left..Head], stage EVERY unstaged block (no k=1 cap,
        // no budget — display off). d6 = col cursor, d7 = target row; both are
        // preserved regs, so DecompressBlock (clobbers d0-d7) needs them saved.
        move.w  Cache_Left_Col, d6
        andi.w  #$FFF0, d6                     // align to the first block col
    .scan:
        cmp.w   Cache_Head_Col, d6
        bgt     .done                          // whole below-row scanned
        decompose_block(d6, d7)                // → sec_x=d0, sec_y=d1, block_index=d2
        // grid guard: sec_x < grid_w (cols past the act right edge decompress blank)
        movea.l Current_Act_Ptr, a0
        moveq   #0, d3
        move.b  Act_grid_w_lo(a0), d3           // grid_w (sections)
        cmp.w   d3, d0
        bcc     .next                          // sec_x >= grid_w — past world, skip col
        jbsr    TileCache_FindStagedBlock      // Z set on hit; d0-d2 preserved
        beq     .next                          // already staged — next col
        movem.l d6-d7, -(sp)                   // DecompressBlock clobbers d0-d7
        jbsr    TileCache_DecompressBlock      // stage this block (d0/d1/d2 in)
        movem.l (sp)+, d6-d7
    .next:
        addi.w  #BLOCK_TILE_SIZE, d6           // next block col
        jbra    .scan
    .done:
        rts
}

// -----------------------------------------------
// Tile_Cache_Fill — per-frame cache extension as camera moves
// Called each frame after Camera_Update, before Section_UpdatePlane.
// Handles rightward/leftward column fill and downward/upward row fill.
// In:  none
// Out: none
// Clobbers: d0-d7, a0-a6
// -----------------------------------------------
pub proc Tile_Cache_Fill () clobbers(d0-d7/a0-a6) {
        // --- frame gate: at most one fill pass per physical frame ---
        // Frame_Counter only increments in VBlank, so all game-loop
        // iterations within the same VBlank period see the same value.
        move.w  Frame_Counter, d0
        cmp.w   Cache_Fill_Last_Frame, d0
        beq     .fill_return
        // trailing-lag detect (consumed by the H4 gate below): Frame_Counter ticks once
        // per VBlank on BOTH the normal (VInt_Level) and lag (VInt_Lag) paths, so it
        // advancing by MORE than 1 since the last fill means a frame lagged in between.
        move.w  d0, d1
        sub.w   Cache_Fill_Last_Frame, d1      // frames since last fill
        subq.w  #1, d1                          // 0 = on time, >0 = a frame lagged
        beq     .fg_on_time
        move.w  #1, Cache_Pfx_Lag_Flag
        jbra    .fg_lag_done
    .fg_on_time:
        clr.w   Cache_Pfx_Lag_Flag
    .fg_lag_done:
        move.w  d0, Cache_Fill_Last_Frame

        // --- reset per-frame decompress budget + rows-this-frame cap ---
        //     BEFORE the preambles: the column-partial bypass path jumps
        //     straight to .v_section, which must see a fresh rows cap.
        move.w  #BLOCK_DECOMP_BUDGET, Cache_Fill_Budget
        move.w  #VFILL_ROWS_PER_FRAME, Cache_Fill_Rows_Left

        // --- finish any pending partial ROW first (before the column
        //     preamble's bypass can reach the v-loops): there is exactly
        //     one row-resume slot, and the v-loops overwrite or clear it —
        //     a still-occupied slot there orphans a half-filled row with
        //     stale tiles AND stale collision. ---
        move.w  Cache_Fill_RowResume_Row, d5
        cmpi.w  #$FFFF, d5
        beq     .no_row_pending
        cmp.w   Cache_Top_Row, d5
        blt     .row_pending_stale
        cmp.w   Cache_Bottom_Row, d5
        bgt     .row_pending_stale
        move.w  d5, -(sp)                      // FillRow clobbers d5
        jbsr    TileCache_FillRow
        move.w  (sp)+, d5
        tst.w   d0
        bne     .fill_return                   // budget out again — done this frame
        // If the completed row IS the cache top, it was the first half of an
        // up-fill pair whose budget-out orphaned the second half — fill it
        // too (Top is always even; no other partial stores a row equal to
        // Top; refilling a filled row is idempotent).
        cmp.w   Cache_Top_Row, d5
        bne     .no_row_pending
        addq.w  #1, d5
        cmp.w   Cache_Bottom_Row, d5
        bgt     .no_row_pending
        jbsr    TileCache_FillRow
        tst.w   d0
        bne     .fill_return
        jbra    .no_row_pending
    .row_pending_stale:
        move.w  #$FFFF, Cache_Fill_RowResume_Row
    .no_row_pending:

        // --- finish any pending partial column before extending further.
        //     At most one partial can be outstanding (a partial exhausts the
        //     budget, which stops all further column work for the frame). ---
        move.w  Cache_Fill_Resume_Col, d5
        cmpi.w  #$FFFF, d5
        beq     .no_pending
        cmp.w   Cache_Left_Col, d5
        blt     .pending_stale                 // column evicted since — drop it
        cmp.w   Cache_Head_Col, d5
        bgt     .pending_stale
        // if rows were evicted from the top since, resume from the new top
        move.w  Cache_Top_Row, d0
        cmp.w   Cache_Fill_Resume_Row, d0
        ble     .pending_row_ok
        move.w  d0, Cache_Fill_Resume_Row
    .pending_row_ok:
        jbsr    TileCache_FillColumn
        tst.w   d0
        bne     .v_section                     // budget out again — vertical still runs
        jbra    .no_pending
    .pending_stale:
        move.w  #$FFFF, Cache_Fill_Resume_Col
    .no_pending:

        // --- compute desired left edge ---
        move.l  Camera_X, d6
        swap    d6
        lsr.w   #3, d6
        move.w  d6, d0                         // d0 = world tile col
        subi.w  #TILE_CACHE_MARGIN_H, d0
        bpl     .h_left_pos
        moveq   #0, d0
    .h_left_pos:
        move.w  d0, -(sp)                     // [sp] = desired_left

        // --- compute desired right edge ---
        move.l  Camera_X, d6
        swap    d6
        addi.w  #327, d6
        lsr.w   #3, d6
        move.w  d6, d0                         // d0 = world tile col
        addi.w  #TILE_CACHE_MARGIN_H, d0
        move.w  d0, d7                         // d7 = desired right edge

        // clamp right so span fits cache
        move.w  (sp), d0                       // desired_left
        addi.w  #TILE_CACHE_COLS-1, d0
        cmp.w   d0, d7
        ble     .h_clamp_ok
        move.w  d0, d7
    .h_clamp_ok:

        // --- fill rightward columns (evict 1 from left as needed) ---
        move.w  Cache_Head_Col, d5
    .h_right_fill:
        cmp.w   d7, d5
        bge     .h_right_done
        addq.w  #1, d5

        // evict 1 column from left if cache is at capacity
        move.w  d5, d0
        sub.w   Cache_Left_Col, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .h_no_evict
        moveq   #1, d0
        jbsr    TileCache_HSlide
    .h_no_evict:
        move.w  d5, Cache_Head_Col         // commit before fill (resume is keyed by column)

        movem.l d5/d7, -(sp)
        jbsr    TileCache_FillColumn
        movem.l (sp)+, d5/d7
        tst.w   d0
        beq     .h_right_fill
        // budget out — skip remaining column work, vertical still runs
        addq.l  #2, sp                         // pop desired_left
        jbra    .v_section
    .h_right_done:

        // --- fill leftward columns (evict 1 from right as needed) ---
        move.w  (sp)+, d4                      // d4 = desired_left
        move.w  Cache_Left_Col, d5
    .h_left_fill:
        cmp.w   d4, d5
        ble     .h_left_done
        subq.w  #1, d5

        // evict 1 column from right if cache is at capacity
        move.w  Cache_Head_Col, d0
        sub.w   d5, d0
        cmpi.w  #TILE_CACHE_COLS, d0
        blt     .h_no_evict_left
        subq.w  #1, Cache_Head_Col
    .h_no_evict_left:

        // commit + slide origin left before fill
        move.w  d5, Cache_Left_Col
        move.w  Cache_Origin_Col, d0
        subq.w  #1, d0
        bpl     .h_origin_ok
        move.w  #TILE_CACHE_COLS-1, d0
    .h_origin_ok:
        move.w  d0, Cache_Origin_Col

        movem.l d4-d5, -(sp)
        jbsr    TileCache_FillColumn
        movem.l (sp)+, d4-d5
        tst.w   d0
        beq     .h_left_fill
    .h_left_done:

    .v_section:
        // --- compute desired top edge (kept even: collision cell alignment) ---
        move.l  Camera_Y, d6
        swap    d6
        lsr.w   #3, d6
        move.w  d6, d0                         // d0 = world tile row
        subi.w  #TILE_CACHE_MARGIN_V, d0
        bpl     .v_top_pos
        moveq   #0, d0
    .v_top_pos:
        andi.w  #$FFFE, d0
        move.w  d0, -(sp)                     // [sp] = desired_top

        // --- compute desired bottom edge ---
        move.l  Camera_Y, d6
        swap    d6
        addi.w  #231, d6
        lsr.w   #3, d6
        move.w  d6, d0                         // d0 = world tile row
        addi.w  #TILE_CACHE_MARGIN_V, d0
        move.w  d0, d7                         // d7 = desired bottom edge

        // clamp bottom so span fits cache
        move.w  (sp), d0                       // desired_top
        addi.w  #TILE_CACHE_ROWS-1, d0
        cmp.w   d0, d7
        ble     .v_clamp_ok
        move.w  d0, d7
    .v_clamp_ok:

        // --- fill downward rows (evict 2 from top as needed; Top stays even) ---
        // rows cap: (Cache_Fill_Rows_Left) counts down; stop when 0.
        // commit Cache_Bottom_Row BEFORE fill so the resume preamble can
        // safely resume a partial row using the committed tracker.
        move.w  Cache_Bottom_Row, d5
        cmp.w   d7, d5
        bge     .v_bottom_done

    .v_bottom_fill:
        tst.w   Cache_Fill_Rows_Left       // rows cap exhausted?
        beq     .v_bottom_done

        addq.w  #1, d5
        cmp.w   d7, d5
        bgt     .v_bottom_done

        // evict 2 rows from top if cache is at capacity
        move.w  d5, d0
        sub.w   Cache_Top_Row, d0
        cmpi.w  #TILE_CACHE_ROWS, d0
        blt     .v_no_evict
        moveq   #2, d0
        jbsr    TileCache_VSlide
    .v_no_evict:

        // commit BEFORE fill (resume is keyed by row)
        move.w  d5, Cache_Bottom_Row

        movem.l d5/d7, -(sp)
        jbsr    TileCache_FillRow
        movem.l (sp)+, d5/d7

        tst.w   d0
        bne     .v_bottom_done                 // partial — resume preamble finishes next frame
        subq.w  #1, Cache_Fill_Rows_Left
        jbra    .v_bottom_fill
    .v_bottom_done:

        // --- fill upward rows in pairs (evict 2 from bottom as needed) ---
        // Only start a pair if rows_left >= 2 AND budget > 0.
        // Cache_Top_Row is committed BEFORE fill (per existing precedent at .v_no_evict_up).
        // On partial in either half of the pair, exit — resume preamble finishes next frame.
        move.w  (sp)+, d4                      // d4 = desired_top (even)
        move.w  Cache_Top_Row, d5
    .v_top_fill:
        cmp.w   d4, d5
        ble     .v_top_done
        // need 2 rows remaining to start a pair
        cmpi.w  #2, Cache_Fill_Rows_Left
        blt     .v_top_done
        // a bottom-fill partial leaves budget 0 — starting a pair here would
        // clobber its resume slot and orphan the half-filled row
        tst.w   Cache_Fill_Budget
        beq     .v_top_done

        subq.w  #2, d5                         // 2-row step keeps Top even

        // evict 2 rows from bottom if cache would exceed capacity
        move.w  Cache_Bottom_Row, d0
        sub.w   d5, d0
        cmpi.w  #TILE_CACHE_ROWS, d0
        blt     .v_no_evict_up
        moveq   #2, d0
        jbsr    TileCache_VSlideUp             // O(1) origin retreat — clobbers d0-d1 only
    .v_no_evict_up:

        // commit Cache_Top_Row BEFORE fills (resume keyed by row)
        move.w  d5, Cache_Top_Row

        movem.l d4-d5, -(sp)
        jbsr    TileCache_FillRow              // new top row (d5)
        movem.l (sp)+, d4-d5
        tst.w   d0
        bne     .v_top_done                    // partial — exit; resume finishes next frame
        subq.w  #1, Cache_Fill_Rows_Left

        addq.w  #1, d5
        movem.l d4-d5, -(sp)
        jbsr    TileCache_FillRow              // second row of the pair (d5+1)
        movem.l (sp)+, d4-d5
        tst.w   d0
        bne     .v_top_done                    // partial — exit; resume finishes next frame
        subq.w  #1, Cache_Fill_Rows_Left
        subq.w  #1, d5                         // restore d5 to even (pair base)
        jbra    .v_top_fill
    .v_top_done:
        // ============ UNIFIED DIRECTION-AWARE PREFETCH (§4.7, design note) ============
        // Leftover-budget speculation ordered row -> col -> corner. H4 deadline gate
        // first: pure speculation must never push a late frame past VBlank. The demand
        // fill above already ran and is NEVER gated.
        // H4 (trailing-lag gate): Tile_Cache_Fill runs once/frame inside VBlank (V~=240,
        // the same slot every frame), so a beam-position read cannot gauge frame load.
        // Use the previous frame's outcome instead: Cache_Pfx_Lag_Flag was set at the
        // frame gate above from the Frame_Counter delta (release-safe, unlike the DEBUG
        // Lag_Frame_Count). If the frame just before this one lagged, skip this frame's
        // speculation — but NEVER skip two running: a sustained-lag run must keep pre-
        // warming or cold columns cascade back in (demand fill is never gated, so the
        // bounded worst case is the pre-prefetch path).
        tst.w   Cache_Pfx_Lag_Flag             // did the previous frame lag?
        beq     .pfx_no_recent_lag
        tst.w   Cache_Pfx_Skip_Armed
        bne     .pfx_gate_ok                   // already skipped once -> run anyway (no cascade)
        move.w  #1, Cache_Pfx_Skip_Armed       // arm: skip this frame's speculation
        jbra    .fill_return
    .pfx_no_recent_lag:
        clr.w   Cache_Pfx_Skip_Armed
    .pfx_gate_ok:
        tst.w   Cache_Fill_Budget
        beq     .fill_return                   // demand fill spent the budget — no prefetch
        // corner (H2) inputs: each axis scan records its target; $FFFF = axis inactive
        move.w  #$FFFF, Cache_Pfx_Row_Target
        move.w  #$FFFF, Cache_Pfx_Col_Target

        // ---- ROW SCAN (vertical prefetch; NO hysteresis — gravity is decisive) ----
        move.l  Camera_Y, d0
        swap    d0
        lsr.w   #3, d0                         // d0 = camera world tile row
        move.w  Cache_Prev_Cam_Row, d1
        move.w  d0, Cache_Prev_Cam_Row         // update for next frame. If a frame is
                                               // H4-gate-skipped or budget-0 this (and the
                                               // Cache_Prev_Cam_X update below) don't run,
                                               // so the next tail-run sees a DOUBLED delta —
                                               // harmless: V uses the sign only, H nets px.
        sub.w   d1, d0                         // d0 = delta (+down / -up / 0)
        beq     .row_done                      // not moving vertically — no row target
        bmi     .pfx_up

        // moving DOWN: target = block-row just below cache bottom
        move.w  Cache_Bottom_Row, d7
        andi.w  #~(BLOCK_TILE_SIZE-1), d7      // align down to block start
        addi.w  #BLOCK_TILE_SIZE, d7           // first row of next block below
        move.w  d7, d5
        lsr.w   #8, d5                         // sec_y
        movea.l Current_Act_Ptr, a0
        moveq   #0, d0
        move.b  Act_grid_h_lo(a0), d0           // grid_h (sections)
        cmp.w   d0, d5
        bcc     .row_done                      // sec_y >= grid_h — out of world
        jbra    .pfx_go

    .pfx_up:
        // moving UP: target = block-row just above cache top
        move.w  Cache_Top_Row, d7
        andi.w  #~(BLOCK_TILE_SIZE-1), d7      // align down to block start (Top is even)
        tst.w   d7
        beq     .row_done                      // top block-row IS world row 0 — nothing above
        subi.w  #BLOCK_TILE_SIZE, d7           // first row of block above

    .pfx_go:
        // d7 = target world tile row. Scan block cols [Left..Head], stage the FIRST
        // unstaged block k=1 (self-advancing across the ~8 quiet frames), sec_x per
        // step, sec_y fixed (guarded at entry).
        move.w  d7, Cache_Pfx_Row_Target       // record for the corner (H2)
        // Memo skip: when this target row, the cache col bounds, AND the staging
        // generation all match the last frame that found the whole row already
        // staged, the FindStagedBlock walk below can only re-probe to the same all-
        // hits result — skip straight to .row_done (Cache_Pfx_Row_Target is already
        // set, so the corner still sees the target; budget is untouched on this path).
        // R1: the Left/Head bounds compare is LOAD-BEARING, not belt-and-braces —
        // Cache_Head_Col advances on a prefetch-SUCCESS fill (all-hits, zero
        // decompress, generation UNCHANGED), so on that frame the bounds are the only
        // thing that killed the memo. Never simplify the bounds compare away.
        cmp.w   Pfx_Memo_Row, d7
        bne     .pfx_scan_begin
        move.w  Cache_Left_Col, d5
        cmp.w   Pfx_Memo_L, d5
        bne     .pfx_scan_begin
        move.w  Cache_Head_Col, d5
        cmp.w   Pfx_Memo_H, d5
        bne     .pfx_scan_begin
        move.w  Block_Stage_Gen, d5
        cmp.w   Pfx_Memo_Gen, d5
        beq     .row_done                      // memo hit — row still all-staged
    .pfx_scan_begin:
        move.w  Cache_Left_Col, d6
        andi.w  #$FFF0, d6                     // align to the first block col
    .pfx_scan:
        cmp.w   Cache_Head_Col, d6
        bgt     .pfx_record                    // whole next row already staged
        decompose_block(d6, d7)                // -> sec_x=d0, sec_y=d1, block_index=d2
        movea.l Current_Act_Ptr, a0
        moveq   #0, d3
        move.b  Act_grid_w_lo(a0), d3
        cmp.w   d3, d0
        bcc     .pfx_next                      // sec_x >= grid_w — out of world, skip col
        jbsr    TileCache_FindStagedBlock      // Z on hit; d0-d2 preserved; clobbers d3-d4,a1
        beq     .pfx_next                      // already staged — try next col
        subq.w  #1, Cache_Fill_Budget
        jbsr    TileCache_DecompressBlock      // stage this block — k=1, then done
        jbra    .row_done
    .pfx_next:
        addi.w  #BLOCK_TILE_SIZE, d6           // next block col
        jbra    .pfx_scan

    .pfx_record:
        // Reached ONLY from the bgt all-hits exit — the whole row was already staged
        // and no block was decompressed this frame (the decompress path jumps to
        // .row_done and never records). Memoize (target row, Left, Head, generation)
        // so the next unchanged frame skips this walk.
        move.w  d7, Pfx_Memo_Row
        move.w  (Cache_Left_Col).w, (Pfx_Memo_L).w    // widths pinned: mem-to-mem two-symbolic operands
        move.w  (Cache_Head_Col).w, (Pfx_Memo_H).w    // widths pinned: mem-to-mem two-symbolic operands
        move.w  (Block_Stage_Gen).w, (Pfx_Memo_Gen).w // widths pinned: mem-to-mem two-symbolic operands

    .row_done:
        // ---- COL SCAN (horizontal prefetch; H3 direction hysteresis) ----
        // Update the latch EVERY tail-run frame (accuracy), THEN gate the scan on
        // budget. Camera px delta -> direction; the latch flips only after
        // >= H_PFX_HYST px of NET opposite motion (players dither on column seams).
        move.l  Camera_X, d0
        swap    d0                             // d0.w = camera px (low word)
        move.w  Cache_Prev_Cam_X, d1
        move.w  d0, Cache_Prev_Cam_X           // update for next frame
        sub.w   d1, d0                         // d0 = delta px (+right / -left / 0)
        move.w  Cache_H_Pfx_Dir, d3
        bne     .cs_have_latch
        // no latch yet: establish from this frame's motion sign
        tst.w   d0
        beq     .fill_return                   // never moved horizontally — no col, no corner
        bmi     .cs_first_left
        moveq   #1, d3
        jbra    .cs_first_set
    .cs_first_left:
        moveq   #-1, d3
    .cs_first_set:
        move.w  d3, Cache_H_Pfx_Dir
        clr.w   Cache_H_Pfx_Accum
        jbra    .cs_latched
    .cs_have_latch:
        // opp = motion opposite the latch; accumulate (clamp >=0); flip at threshold
        move.w  d0, d1                         // d1 = delta px
        tst.w   d3
        bmi     .cs_opp_ready                  // latch LEFT: opposite = +delta (keep sign)
        neg.w   d1                             // latch RIGHT: opposite = -delta
    .cs_opp_ready:
        add.w   d1, Cache_H_Pfx_Accum
        tst.w   Cache_H_Pfx_Accum
        bpl     .cs_accum_ok
        clr.w   Cache_H_Pfx_Accum              // net: with-latch motion cannot bank below 0
    .cs_accum_ok:
        cmpi.w  #H_PFX_HYST, Cache_H_Pfx_Accum
        blt     .cs_latched                    // not enough opposite motion — keep latch
        neg.w   d3                             // flip the latched direction
        move.w  d3, Cache_H_Pfx_Dir
        clr.w   Cache_H_Pfx_Accum
    .cs_latched:
        // d3 = latched direction (+1 right / -1 left). NOTE: the col scan runs whenever a
        // direction is latched — INCLUDING purely-vertical frames (no H motion this frame)
        // — so it keeps pre-warming the latched-side column. Probe-only cost when that
        // column is already staged (FindStagedBlock hits, no decompress); intentional.
        tst.w   Cache_Fill_Budget
        beq     .fill_return                   // row scan spent the budget — no col this frame
        tst.w   d3
        bmi     .cs_left
        // RIGHT: target = block-col just beyond cache head
        move.w  Cache_Head_Col, d6
        andi.w  #~(BLOCK_TILE_SIZE-1), d6
        addi.w  #BLOCK_TILE_SIZE, d6
        jbra    .cs_have_col
    .cs_left:
        // LEFT: target = block-col just before cache left
        move.w  Cache_Left_Col, d6
        andi.w  #~(BLOCK_TILE_SIZE-1), d6
        beq     .col_done                      // left block-col IS world col 0 — nothing left
        subi.w  #BLOCK_TILE_SIZE, d6
    .cs_have_col:
        // guard sec_x = d6 >> 8 < grid_w (FIXED for the whole col scan)
        move.w  d6, d5
        lsr.w   #8, d5                         // sec_x
        movea.l Current_Act_Ptr, a0
        moveq   #0, d0
        move.b  Act_grid_w_lo(a0), d0           // grid_w (sections)
        cmp.w   d0, d5
        bcc     .col_done                      // sec_x >= grid_w — out of world
        move.w  d6, Cache_Pfx_Col_Target       // record for the corner (H2)
        // Memo skip (mirror of .pfx): when this target col, the cache row bounds, AND
        // the staging generation all match the last frame that found the whole col
        // already staged, the FindStagedBlock row walk can only re-probe to the same
        // all-hits result — skip to .col_done (Cache_Pfx_Col_Target is already set, so
        // the corner still sees the target; budget is untouched on this path).
        // R1: the Top/Bottom bounds compare is LOAD-BEARING — Cache_Top_Row/Bottom_Row
        // advance on a prefetch-SUCCESS fill (all-hits, zero decompress, generation
        // UNCHANGED), so on that frame the bounds are the only memo-killer.
        cmp.w   Cs_Memo_Col, d6
        bne     .cs_scan_begin
        move.w  Cache_Top_Row, d5
        cmp.w   Cs_Memo_T, d5
        bne     .cs_scan_begin
        move.w  Cache_Bottom_Row, d5
        cmp.w   Cs_Memo_B, d5
        bne     .cs_scan_begin
        move.w  Block_Stage_Gen, d5
        cmp.w   Cs_Memo_Gen, d5
        beq     .col_done                      // memo hit — col still all-staged
    .cs_scan_begin:
        // scan block rows [Top..Bottom]; sec_y per step (d6 fixed for the scan)
        move.w  Cache_Top_Row, d7
        andi.w  #$FFF0, d7                     // align to the first block row
    .cs_scan:
        cmp.w   Cache_Bottom_Row, d7
        bgt     .cs_record                     // whole next col already staged
        move.w  d7, d5
        lsr.w   #8, d5                         // sec_y
        movea.l Current_Act_Ptr, a0
        moveq   #0, d3
        move.b  Act_grid_h_lo(a0), d3
        cmp.w   d3, d5
        bcc     .cs_next                       // sec_y >= grid_h — skip this block row
        decompose_block(d6, d7)                // -> sec_x=d0, sec_y=d1, block_index=d2
        jbsr    TileCache_FindStagedBlock
        beq     .cs_next                       // already staged — try next row
        subq.w  #1, Cache_Fill_Budget
        jbsr    TileCache_DecompressBlock      // stage this block — k=1, then done
        jbra    .col_done
    .cs_next:
        addi.w  #BLOCK_TILE_SIZE, d7           // next block row
        jbra    .cs_scan

    .cs_record:
        // Reached ONLY from the bgt all-hits exit — the whole col was already staged
        // and no block was decompressed this frame (the decompress path jumps to
        // .col_done and never records). Memoize (target col, Top, Bottom, generation).
        move.w  d6, Cs_Memo_Col
        move.w  (Cache_Top_Row).w, (Cs_Memo_T).w     // widths pinned: mem-to-mem two-symbolic operands
        move.w  (Cache_Bottom_Row).w, (Cs_Memo_B).w  // widths pinned: mem-to-mem two-symbolic operands
        move.w  (Block_Stage_Gen).w, (Cs_Memo_Gen).w // widths pinned: mem-to-mem two-symbolic operands

    .col_done:
        // ---- CORNER (H2): the (next-row x next-col) block is in NEITHER axis scan;
        // stage it LAST, only when BOTH axes are actively crossing. Both targets were
        // grid-guarded when recorded, so the corner section is in-grid by construction
        // (sec_x<grid_w from the col, sec_y<grid_h from the row).
        tst.w   Cache_Fill_Budget
        beq     .fill_return
        move.w  Cache_Pfx_Row_Target, d7
        cmpi.w  #$FFFF, d7
        beq     .fill_return                   // no vertical target — no corner
        move.w  Cache_Pfx_Col_Target, d6
        cmpi.w  #$FFFF, d6
        beq     .fill_return                   // no horizontal target — no corner
        decompose_block(d6, d7)                // -> sec_x=d0, sec_y=d1, block_index=d2
        jbsr    TileCache_FindStagedBlock
        beq     .fill_return                   // already staged
        subq.w  #1, Cache_Fill_Budget
        jbsr    TileCache_DecompressBlock      // stage the corner — k=1
    .fill_return:
        rts
}

// -----------------------------------------------
// TileCache_FillColumn — fill one world column into cache (budget-limited)
// In:  d5.w = world tile col (must already be within cache bounds)
// Out: d0.w = 0 if column complete, nonzero if partial.
//      On partial, resume state (Cache_Fill_Resume_Col/Row) is stored;
//      Tile_Cache_Fill finishes it first next frame.
// Uses Cache_Fill_Budget — shared per-frame decompress allowance.
// In (H6): a5/a6 set at entry to the NT/collision bases (hoisted CopyBlockColumn leas).
// Clobbers: d0-d7, a0-a6
// -----------------------------------------------
pub proc TileCache_FillColumn (d5: u16) clobbers(d1-d7/a0-a6) out(d0) {
        // H6: hoist the two loop-invariant base leas out of CopyBlockColumn — a5/a6
        // are the only regs surviving DecompressBlock's clobber license (d0-d7/a0/a2-a4),
        // so they carry the bases across the per-block decompress for the whole column.
        lea     Tile_Cache_Nametable, a5
        lea     Tile_Cache_Collision, a6
        // resume only if a partial is pending for THIS column
        move.w  Cache_Top_Row, d7
        cmp.w   Cache_Fill_Resume_Col, d5
        bne     .fc_from_top
        move.w  Cache_Fill_Resume_Row, d7
    .fc_from_top:

    .fc_block_loop:
        cmp.w   Cache_Bottom_Row, d7
        bgt     .fc_complete                   // cursor past bottom — done

        // decompose world col d5 / row d7 into sec_x=d0, sec_y=d1, block_index=d2
        decompose_block(d5, d7)

        // probe staging cache (a1 = slot base on hit)
        jbsr    TileCache_FindStagedBlock
        beq     .fc_have_block

        // need decompress — check shared frame budget
        tst.w   Cache_Fill_Budget
        beq     .fc_budget_out
        subq.w  #1, Cache_Fill_Budget

        movem.l d5/d7, -(sp)
        jbsr    TileCache_DecompressBlock      // a1 = slot base
        movem.l (sp)+, d5/d7
    .fc_have_block:

        // copy run [d7 .. min(block_bottom, Cache_Bottom_Row)]
        move.w  d5, d0
        andi.w  #$F, d0                        // intra-block col
        move.w  d5, d1
        sub.w   Cache_Left_Col, d1         // cache col offset
        move.w  d7, d2
        sub.w   Cache_Top_Row, d2          // dest row offset (even)
        move.w  d7, d4
        andi.w  #$F, d4                        // source start row (even)

        // rows = min(block_top + 16, Bottom + 1) - cursor
        move.w  d7, d3
        andi.w  #$FFF0, d3
        addi.w  #BLOCK_TILE_SIZE, d3           // block bottom + 1
        move.w  Cache_Bottom_Row, d6
        addq.w  #1, d6
        cmp.w   d6, d3
        ble     .fc_rows_ok
        move.w  d6, d3
    .fc_rows_ok:
        sub.w   d7, d3                         // d3 = rows (> 0, even)

        movem.l d5, -(sp)                        // CopyBlockColumn clobbers d5 (saved); it preserves d7
        jbsr    TileCache_CopyBlockColumn
        movem.l (sp)+, d5

        // advance cursor to next block top
        andi.w  #$FFF0, d7
        addi.w  #BLOCK_TILE_SIZE, d7
        jbra    .fc_block_loop

    .fc_budget_out:
        move.w  d5, Cache_Fill_Resume_Col
        move.w  d7, Cache_Fill_Resume_Row
        moveq   #1, d0
        rts

    .fc_complete:
        move.w  #$FFFF, Cache_Fill_Resume_Col
        moveq   #0, d0
        rts
}

// -----------------------------------------------
// TileCache_FillRow — fill one world row into cache (nametable + collision)
// In:  d5.w = world tile row to fill
// Out: d0.w = 0 complete / 1 budget-out (resume state stored in
//             Cache_Fill_RowResume_Row/Col).
//      On complete, Cache_Fill_RowResume_Row is set to $FFFF.
// Clobbers: d0-d7, a0-a6
//   a5/a6 hold the collision plane-A/plane-B DEST row bases for the WHOLE row
//   (loop-invariant, hoisted out of the per-cell loop). They survive the per-block
//   DecompressBlock call because its license (d0-d7/a0/a2-a4) EXCLUDES a5/a6;
//   a4 (NT dest base) + a2 (plane-B src base) ARE clobbered by it, so they are
//   re-set per block. (transitive-attribute: widened from a0-a4; sole caller
//   Tile_Cache_Fill already licenses a0-a6.)
// Note: collision is copied only on the odd row of each 16px cell (the row
//       that completes the cell). Cache_Top_Row is kept even, so cell
//       boundaries align with world block data.
// -----------------------------------------------
pub proc TileCache_FillRow (d5: u16) clobbers(d1-d7/a0-a6) out(d0) {
        // cache row offset (constant for all columns)
        move.w  d5, d2
        sub.w   Cache_Top_Row, d2
        bmi     .fr_early_out

        // remember logical row for the cell-parity test, then map to
        // physical row via the circular origin (origin even → parity
        // is preserved, but offsets must come from the physical row)
        move.w  d2, d4                         // d4 = logical row
        add.w   Cache_Origin_Row, d2
        cmpi.w  #TILE_CACHE_ROWS, d2
        blt     .fr_row_nowrap
        subi.w  #TILE_CACHE_ROWS, d2
    .fr_row_nowrap:

        // collision dest row offset (bytes); $FFFF = even row, skip collision
        move.w  #$FFFF, d3
        btst    #0, d4
        beq     .fr_no_coll
        move.w  d2, d3
        lsr.w   #1, d3                         // physical collision row
        mul_const.w d3, #80, d4               // collision_row × 80 (d4 = multiply scratch)
    .fr_no_coll:
        move.w  d3, -(sp)                      // 2(sp) = collision row offset

        // pre-compute cache row stride in words — pushed once for entire call
        mul_cache_stride(d2, d3)              // d2 = phys_row * TILE_CACHE_STRIDE
        move.w  d2, -(sp)                      // 0(sp) = cache_row_offset_words

        // --- loop-invariant hoist: the collision plane-A/plane-B DEST row bases are
        //     loop-invariant (Tile_Cache_Collision / +TILE_CACHE_COLL_SIZE, both
        //     compile-time). Hoist them ONCE per row into a5/a6. LOAD-BEARING &
        //     INVISIBLE: this relies on a5/a6 surviving the per-block
        //     DecompressBlock call — its license (d0-d7/a0/a2-a4) excludes them
        //     (S4LZ_DecompressDict, the engine.s4lz transitive callee, verified
        //     a5/a6-clean too). A future edit that makes DecompressBlock (or a
        //     swapped decompressor) touch a5/a6 would corrupt the collision
        //     planes SILENTLY — a checked-clobbers lint (callee writes ⊆ its
        //     declared clobbers) is what would catch this mechanically. ---
        lea     Tile_Cache_Collision, a5           // plane-A dest base (whole row)
        lea     Tile_Cache_Collision+TILE_CACHE_COLL_SIZE, a6  // plane-B dest base (whole row)

        // resume: if this is the partially-filled row from last frame,
        // restart the column walk from where we left off (not Cache_Left_Col).
        // Clamp to Left_Col in case columns were evicted since the partial.
        move.w  Cache_Left_Col, d7
        cmp.w   Cache_Fill_RowResume_Row, d5
        bne     .fr_from_left
        move.w  Cache_Fill_RowResume_Col, d7
        cmp.w   Cache_Left_Col, d7        // resume col < Left → evicted, use Left
        bge     .fr_from_left
        move.w  Cache_Left_Col, d7
    .fr_from_left:
    .fr_block_loop:
        cmp.w   Cache_Head_Col, d7
        bgt     .fr_done

        // decompose world col d7 / row d5 into sec_x=d0, sec_y=d1, block_index=d2
        decompose_block(d7, d5)

        jbsr    TileCache_FindStagedBlock      // a1 = slot base on hit
        beq     .fr_have_block
        // need decompress — check shared frame budget
        tst.w   Cache_Fill_Budget
        beq     .fr_budget_out
        subq.w  #1, Cache_Fill_Budget
        movem.l d5/d7, -(sp)
        jbsr    TileCache_DecompressBlock      // a1 = slot base
        movem.l (sp)+, d5/d7
    .fr_have_block:

        // staging source bases for this row:
        //   a0 = nametable row base = slot + intra_row * 32
        //   a3 = collision row base = slot + BLOCK_NT_SIZE + (intra_row/2) * 16
        move.w  d5, d4
        andi.w  #$F, d4                        // intra-block row
        move.w  d4, d3
        lsl.w   #5, d4                         // * 32
        lea     (a1, d4.w), a0
        // collision row base = (intra_row/2) * BLOCK_COLL_COLS via the parity-safe
        // macro. FillRow copies collision only on the ODD (cell-completing) row,
        // so the even-only intra_row*8 shortcut would land 64px off — the §5
        // loop-arc wall bug (arc toe cells read as full-solid $01 → ground wall
        // probe killed gsp). coll_src_row_base makes that misencoding impossible.
        coll_src_row_base(d3)                  // (intra_row/2) * BLOCK_COLL_COLS
        lea     BLOCK_NT_SIZE(a1), a3
        adda.w  d3, a3

        // per-block hoist: a4 = NT DEST base, a2 = plane-B SRC base (a3 + 128). Both
        // per-BLOCK — DecompressBlock clobbers a4 + a2, so they re-set here (a5/a6
        // survive it, hoisted per-row above). Plane-B src can't be an indexed
        // displacement: BLOCK_COLL_PLANE_SIZE = 128 > +127 (signed 8-bit).
        lea     Tile_Cache_Nametable, a4
        lea     BLOCK_COLL_PLANE_SIZE(a3), a2

        // === valid intra-block column run [ic_lo, ic_hi) ===
        // The per-tile loop this replaced wrote a column iff it passed three
        // monotone gates: world_col <= Head (else the block loop TERMINATES),
        // world_col >= Left, and cache_col < COLS (the latter two SKIP the cell).
        // world_col rises with the intra-col, so the surviving columns form one
        // contiguous run — the prefix below Left and the suffix past Head/COLS are
        // clamped off (never written, never zero-filled; FillRow always skipped
        // out-of-range cells rather than zeroing them, so the clamp is inherent).
        //   ic_lo = max(intra_start, Left - B)
        //   ic_hi = min(BLOCK_TILE_SIZE, Head - B + 1, Left + COLS - B)   (B = block base)
        move.w  d7, d2
        andi.w  #$FFF0, d2                    // d2 = block base B
        move.w  d7, d3
        andi.w  #$F, d3                       // ic_lo = intra_start
        move.w  Cache_Left_Col, d0
        sub.w   d2, d0                         // Left - B
        cmp.w   d3, d0
        ble     .fr_iclo_done
        move.w  d0, d3                         // ic_lo = Left - B
    .fr_iclo_done:
        moveq   #BLOCK_TILE_SIZE, d4
        move.w  Cache_Head_Col, d0
        sub.w   d2, d0
        addq.w  #1, d0                         // Head - B + 1
        cmp.w   d4, d0
        bge     .fr_ichi_head
        move.w  d0, d4
    .fr_ichi_head:
        move.w  Cache_Left_Col, d0
        sub.w   d2, d0
        addi.w  #TILE_CACHE_COLS, d0           // Left + COLS - B
        cmp.w   d4, d0
        bge     .fr_ichi_done
        move.w  d0, d4                         // ic_hi = Left + COLS - B
    .fr_ichi_done:
        cmp.w   d4, d3
        bge     .fr_nt_empty                  // ic_lo >= ic_hi: nothing to copy

        // === phase 1: nametable segment copy ===
        // src words are contiguous (staging slot, intra_col * 2); dest columns are
        // contiguous in the circular cache and wrap at most once at Origin_Col, so
        // the run splits into <=2 straight copies. Each run drains as move.l pairs
        // (src and dest both word-aligned: the intra_col*2 src and the *2 dest offset
        // are even) plus a move.w odd-word tail — the two runs are individually odd
        // or even, so each carries its own tail. d2=B still; d3=ic_lo, d4=ic_hi.
        // a0 = NT staging row base (consumed here — DecompressBlock resets it per
        // block, and phase 2 reads collision via a3/a2, not a0).
        move.w  d3, d0
        add.w   d0, d0
        adda.w  d0, a0                         // a0 -> staging src at ic_lo
        move.w  d4, d1
        sub.w   d3, d1                         // d1 = n_total (> 0)
        add.w   d3, d2
        sub.w   Cache_Left_Col, d2            // cache_col_lo (0..COLS-1)
        add.w   Cache_Origin_Col, d2          // phys_start (0..2*COLS-2)
        move.w  (sp), d4                       // d4 = cache_row_offset_words
        cmpi.w  #TILE_CACHE_COLS, d2
        blt     .fr_nt_ncalc
        subi.w  #TILE_CACHE_COLS, d2           // starts already wrapped: one run
        move.w  d1, d0                         // n1 = n_total
        bra     .fr_nt_emit
    .fr_nt_ncalc:
        move.w  #TILE_CACHE_COLS, d0
        sub.w   d2, d0                         // cols_before_wrap = COLS - phys_start (>=1)
        cmp.w   d1, d0
        blt     .fr_nt_emit                   // n1 = cols_before_wrap (< n_total)
        move.w  d1, d0                         // n1 = n_total (whole run fits pre-wrap)
    .fr_nt_emit:
        move.w  d1, d3
        sub.w   d0, d3                         // d3 = n2 = n_total - n1
        move.w  d4, d1
        add.w   d2, d1
        add.w   d1, d1                         // (row_off + phys_start) * 2
        lea     (a4, d1.w), a1                 // run-1 dest
        move.w  d0, d1                         // save n1 for the odd-word tail
        lsr.w   #1, d0                         // n1 / 2 long copies
        beq     .fr_nt_run1_tail              // n1 == 1: tail word only
        subq.w  #1, d0
    .fr_nt_run1:
        move.l  (a0)+, (a1)+
        dbf     d0, .fr_nt_run1
    .fr_nt_run1_tail:
        btst    #0, d1                         // odd run-1: trailing word
        beq     .fr_nt_run1_done
        move.w  (a0)+, (a1)+
    .fr_nt_run1_done:
        tst.w   d3
        beq     .fr_nt_empty
        move.w  d4, d1
        add.w   d1, d1                         // wrap dest starts at phys 0
        lea     (a4, d1.w), a1                 // run-2 dest
        move.w  d3, d1                         // save n2 for the odd-word tail
        lsr.w   #1, d3                         // n2 / 2 long copies
        beq     .fr_nt_run2_tail              // n2 == 1: tail word only
        subq.w  #1, d3
    .fr_nt_run2:
        move.l  (a0)+, (a1)+
        dbf     d3, .fr_nt_run2
    .fr_nt_run2_tail:
        btst    #0, d1                         // odd run-2: trailing word
        beq     .fr_nt_empty
        move.w  (a0)+, (a1)+

    .fr_nt_empty:
        // === phase 2: collision planes A and B (cell-completing rows only) ===
        // Segmented mirror of phase 1: the collision byte-copy walks the SAME valid run
        // [ic_lo, ic_hi) with the SAME Origin_Col wrap-split as the nametable — RE-derived
        // here, independent of phase 1, so the nametable half stays byte-for-byte as 1.1a
        // and a fault in this block can only touch collision. Runs only on the ODD (cell-
        // completing) row (2(sp) = $FFFF gates the whole phase — constant per row). Dest
        // byte index = coll_row_offset + physical col; src byte = (plane base, intra_col),
        // contiguous. a5/a6 = plane A/B DEST bases (per-row); a3/a2 = plane A/B SRC bases
        // (per-block); a1/a4 = the run dest pointers (a4 = NT base, dead after phase 1).
        // (move.b runs; move.w/move.l byte-pairing is a ledgered optimization.)
        move.w  2(sp), d0
        cmpi.w  #$FFFF, d0
        beq     .fr_next_block                // even row: no collision this row

        // re-derive the valid run [ic_lo=d3, ic_hi=d4); d2 = block base B
        move.w  d7, d2
        andi.w  #$FFF0, d2
        move.w  d7, d3
        andi.w  #$F, d3                        // ic_lo = intra_start
        move.w  Cache_Left_Col, d0
        sub.w   d2, d0                         // Left - B
        cmp.w   d3, d0
        ble     .fr_ci_iclo
        move.w  d0, d3                         // ic_lo = Left - B
    .fr_ci_iclo:
        moveq   #BLOCK_TILE_SIZE, d4
        move.w  Cache_Head_Col, d0
        sub.w   d2, d0
        addq.w  #1, d0                         // Head - B + 1
        cmp.w   d4, d0
        bge     .fr_ci_head
        move.w  d0, d4
    .fr_ci_head:
        move.w  Cache_Left_Col, d0
        sub.w   d2, d0
        addi.w  #TILE_CACHE_COLS, d0           // Left + COLS - B
        cmp.w   d4, d0
        bge     .fr_ci_ichi
        move.w  d0, d4                         // ic_hi = Left + COLS - B
    .fr_ci_ichi:
        cmp.w   d4, d3
        bge     .fr_next_block                // empty run

        // advance plane-A/B src to ic_lo (byte index); n_total -> d1; phys_start -> d2
        move.w  d3, d0
        adda.w  d0, a3
        adda.w  d0, a2
        move.w  d4, d1
        sub.w   d3, d1
        add.w   d3, d2
        sub.w   Cache_Left_Col, d2
        add.w   Cache_Origin_Col, d2          // phys_start (0..2*COLS-2)
        cmpi.w  #TILE_CACHE_COLS, d2
        blt     .fr_ci_ncalc
        subi.w  #TILE_CACHE_COLS, d2           // starts already wrapped: one run
        move.w  d1, d0                         // n1 = n_total
        bra     .fr_ci_emit
    .fr_ci_ncalc:
        move.w  #TILE_CACHE_COLS, d0
        sub.w   d2, d0                         // cols_before_wrap = COLS - phys_start (>=1)
        cmp.w   d1, d0
        blt     .fr_ci_emit                   // n1 = cols_before_wrap (< n_total)
        move.w  d1, d0                         // n1 = n_total (whole run fits pre-wrap)
    .fr_ci_emit:
        move.w  d1, d3
        sub.w   d0, d3                         // d3 = n2 = n_total - n1
        move.w  2(sp), d4
        add.w   d2, d4                         // coll_row_offset + phys_start
        lea     (a5, d4.w), a1                 // run-1 plane A dest
        lea     (a6, d4.w), a4                 // run-1 plane B dest
        subq.w  #1, d0
    .fr_ci_run1:
        move.b  (a3)+, (a1)+                   // plane A
        move.b  (a2)+, (a4)+                   // plane B
        dbf     d0, .fr_ci_run1
        tst.w   d3
        beq     .fr_next_block
        move.w  2(sp), d4                      // wrap dest starts at phys 0
        lea     (a5, d4.w), a1                 // run-2 plane A dest
        lea     (a6, d4.w), a4                 // run-2 plane B dest
        subq.w  #1, d3
    .fr_ci_run2:
        move.b  (a3)+, (a1)+
        move.b  (a2)+, (a4)+
        dbf     d3, .fr_ci_run2

    .fr_next_block:
        move.w  d7, d0
        andi.w  #$FFF0, d0
        addi.w  #BLOCK_TILE_SIZE, d0
        move.w  d0, d7
        jbra    .fr_block_loop

    .fr_budget_out:
        // Budget exhausted mid-row. Store resume state and return partial.
        // Two words are on the stack (pushed above): pop them before exit.
        addq.l  #4, sp
        move.w  d5, Cache_Fill_RowResume_Row
        move.w  d7, Cache_Fill_RowResume_Col
        moveq   #1, d0
        rts

    .fr_done:
        addq.l  #4, sp                         // pop row offsets
        move.w  #$FFFF, Cache_Fill_RowResume_Row
        moveq   #0, d0
        rts
    .fr_early_out:
        moveq   #0, d0
        rts
}

// -----------------------------------------------
// TileCache_HSlide — circular advance: evict left columns by updating origin
// In:  d0.w = columns to evict from left side
// Out: none
// Clobbers: d0-d1
// -----------------------------------------------
pub proc TileCache_HSlide (d0: u16) clobbers(d0-d1) {
        tst.w   d0
        ble     .done
        add.w   d0, Cache_Left_Col
        move.w  Cache_Origin_Col, d1
        add.w   d0, d1
        cmpi.w  #TILE_CACHE_COLS, d1
        blt     .nowrap
        subi.w  #TILE_CACHE_COLS, d1
    .nowrap:
        move.w  d1, Cache_Origin_Col
    .done:
        rts
}

// -----------------------------------------------
// TileCache_VSlide — evict stale top rows (circular, O(1))
// Advances Cache_Origin_Row instead of moving data — the recycled
// physical rows are overwritten by TileCache_FillRow before they can
// become visible (same validity contract the old memmove had).
// Replaces the ~87k-cycle memmove (9.4KB NT + 2.3KB collision per
// 2-row evict) that caused lag during sustained vertical scroll.
// In:  d0.w = tile rows to evict from top (even)
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc TileCache_VSlide (d0: u16) clobbers(d0) {
        tst.w   d0
        ble     .vslide_done
        add.w   d0, Cache_Top_Row
        add.w   Cache_Origin_Row, d0
        cmpi.w  #TILE_CACHE_ROWS, d0
        blt     .vslide_nowrap
        subi.w  #TILE_CACHE_ROWS, d0
    .vslide_nowrap:
        move.w  d0, Cache_Origin_Row
    .vslide_done:
        rts
}

// -----------------------------------------------
// TileCache_VSlideUp — evict stale bottom rows (circular, O(1))
// Mirror of TileCache_VSlide: retreats Cache_Origin_Row so new top
// rows map onto the recycled bottom rows' physical storage.
// In:  d0.w = tile rows to evict from bottom (even)
// Out: none
// Clobbers: d0-d1
// -----------------------------------------------
pub proc TileCache_VSlideUp (d0: u16) clobbers(d0-d1) {
        tst.w   d0
        ble     .vsu_done
        sub.w   d0, Cache_Bottom_Row
        move.w  Cache_Origin_Row, d1
        sub.w   d0, d1
        bpl     .vsu_nowrap
        addi.w  #TILE_CACHE_ROWS, d1
    .vsu_nowrap:
        move.w  d1, Cache_Origin_Row
    .vsu_done:
        rts
}

// -----------------------------------------------
// TileCache_Reinit — full cache re-center + refill (recovery path)
// Costs ~10 frames synchronously (full FillAll) — recovery only, never
// on a hot path. Currently no callers; retained as the documented
// recovery mechanism for future cache-miss / debug-warp handling.
// In:  none
// Out: none
// Clobbers: d0-d7, a0-a6
// -----------------------------------------------
pub proc TileCache_Reinit () clobbers(d0-d7/a0-a6) {
        // recompute cache bounds centered on camera
        move.l  Camera_X, d0
        swap    d0
        lsr.w   #3, d0                         // camera world tile col
        subi.w  #TILE_CACHE_MARGIN_H, d0
        bpl     .ri_left_ok
        moveq   #0, d0
    .ri_left_ok:
        move.w  d0, Cache_Left_Col
        addi.w  #TILE_CACHE_COLS-1, d0
        move.w  d0, Cache_Head_Col
        clr.w   Cache_Origin_Col
        clr.w   Cache_Origin_Row
        move.w  #$FFFF, Cache_Fill_Resume_Col
        move.w  #$FFFF, Cache_Fill_RowResume_Row

        move.l  Camera_Y, d0
        swap    d0
        lsr.w   #3, d0                         // camera world tile row
        move.w  d0, Cache_Prev_Cam_Row     // reset vertical prefetch baseline on reinit
        move.l  Camera_X, d1
        swap    d1
        move.w  d1, Cache_Prev_Cam_X       // reset horizontal prefetch baseline
        clr.w   Cache_H_Pfx_Dir
        clr.w   Cache_H_Pfx_Accum
        clr.w   Cache_Pfx_Skip_Armed
        clr.w   Cache_Pfx_Lag_Flag             // trailing-lag gate baseline
        subi.w  #TILE_CACHE_MARGIN_V, d0
        bpl     .ri_top_ok
        moveq   #0, d0
    .ri_top_ok:
        andi.w  #$FFFE, d0                     // keep Cache_Top_Row even (collision cell alignment)
        move.w  d0, Cache_Top_Row
        addi.w  #TILE_CACHE_ROWS-1, d0
        move.w  d0, Cache_Bottom_Row

        jbsr    TileCache_InvalidateStaging

        // refill
        jbsr    TileCache_FillAll

        // mark plane dirty for full redraw
        st.b    Section_Plane_Dirty
        rts
}
