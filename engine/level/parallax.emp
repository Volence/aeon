// engine/level/parallax.emp — §4.6 parallax pipeline
//
// Public:
//   Parallax_Init(a0=parallax_config*) — initialize Parallax_State at level load
//   Parallax_Update                    — main-loop per-frame builder
//   Parallax_StartTransition(a0=new)   — section-boundary config switch
//   Vscroll_Write                      — VBlank VSRAM emitter

module engine.parallax in parallax

use engine.constants.{SECTION_SIZE_SHIFT, SCREEN_WIDTH, SCREEN_HEIGHT, PARALLAX_TRANS_DEFAULT, PARALLAX_LERP_SHIFT, VDP_DATA, VDP_CTRL, PARALLAX_ANCHOR_NONE, MAX_PARALLAX_BANDS}
use engine.structs.{Sec, parallax_config}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm, VDP_MODE3_OFF}
use engine.z80_bus.{z80_stopped}
use engine.irq.{ints_off, vblank}
use engine.effects.preset.{Effects_InstallPreset}
// The capability bits the P2 specialisation gates test against (§3.3). Imported by
// NAME rather than inlined as literals: the inline-the-number rule in scene_dsl.emp
// exists because a `comptime fn` body resolves its free names at the CALL site, and
// most of the uses below are not inside a comptime fn — they are `if` conditions in this
// module's own instruction stream, where this module's own `use` is what resolves
// them. Spelling the numbers here instead would give up the drift check for nothing.
//
// (Until 2026-08-26 one exception stood here: `parallax_mode_key`, a comptime fn in
// scene_dsl.emp whose comptime CONDITIONS resolved through this module's `use` line. It
// was deleted with the per-cell HScroll path it selected — d-29-corrected — and the
// import block below no longer carries anything for another file's body.)
//
// A NOTE ON WHY THIS BIT LANDED A PARCEL LATE, because the shape of the obstacle is
// worth carrying: gating CAP_TRANSITIONS elides 48 more bytes from demo's Parallax_*
// run, and that run sits immediately upstream of `Level_LoadArt`. sigil classifies a
// section as an ISLAND when its FROZEN provisional base exceeds the packed running end
// by more than ANCHOR_GAP = 0x400, and then demands a declared `[[anchor]]` for it. At
// the Phase-1 tip demo placed Level_LoadArt at 0x6050 against a provisional still
// frozen at 0x6430 — a 0x3E0 gap, 32 bytes of headroom — so this elision crossed it and
// both demo shapes failed with `[map.undeclared-island] ROM section at 0x6430`.
//
// Phase 1's own refreeze re-derived the demo tables (provisional 0x6430 -> 0x6050
// debug, 0x53A0 -> 0x4FC0 plain), which is what opened the headroom. Recorded because
// the WRONG fix is the tempting one: declaring a 0x6430 anchor in games/demo/map.toml
// builds, and bakes a moment's placer fill into the placement contract for a section
// that packs. A stale provisional is refrozen, never anchored around.
// CAP_MULTI_DEFORM_TABLE COMES BACK IN P3 TASK 9 and this time the file names it: Task 8
// dropped it (41d14f36) because the extended record is a DATA shape and needed no gated
// code, and Task 9 adds the first CODE site for the bit — the per-band table reload in
// Parallax_Fill_PerLine. A comptime CONDITION resolves at the call site and fails LOUDLY
// when it cannot (measured 2026-08-20 on the buffers.emp twin, since deleted), so this import is load-bearing.
use engine.level.scene_dsl.{CAP_PER_COL_VSRAM, CAP_DEFORM, CAP_ANCHORS, CAP_TRANSITIONS, CAP_MULTI_DEFORM_TABLE, CAP_FACTOR_CURVE, CAP_BAND_DRIFT}

// The a5-relative data-port derive (a5 = VDP_CTRL, so VDP_DATA_OFF(a5) hits
// VDP_DATA). Port bases + their drift locks live in engine.vdp.
const VDP_DATA_OFF = VDP_DATA - VDP_CTRL     // = -4

// StartTransition writes VDP register $0B (Mode Set 3) through the shadow, which
// IS the register's authority — Flush_VDP_Shadow re-blits all of $00-$12 from it
// unconditionally at the next VBlank, so there is no dirty bit to set and no way
// to opt out of the write-back. Parallax_Update (`.mode3_shadow` below) writes the
// same byte and additionally drives the register directly on the frame the mode
// changes, because the flush is a VBlank step and the mode must be live for the
// frame it becomes active. VDP_MODE3_OFF comes from the shared engine.vdp
// shadow-offset block. Nothing relates that block to VdpShadow's field offsets — engine.vdp
// says so itself: a wrong offset there changes the emitted displacement, so the
// seven-target byte identity is the only check.

// ---- Parallax band-entry ROM struct (§4.6) — parallax-private (only parallax
// reads it). This module is the sole author of the band_entry layout; the build
// harvests `band_entry_len` for ram.asm's shadow-band reservation.
// parallax_config lives in engine.structs (shared with engine.buffers, which
// keys the HScroll DMA length off the deform-table fields). ----

// Parallax band entry — 10 bytes per band, ROM data.
//
// P3 TASK 7 (world-Y re-glue) RESHAPED THIS RECORD WITHOUT RESIZING IT, and the
// arithmetic is worth stating because it is what kept `BAND_ENTRY_LEN` — and therefore
// `Parallax_Shadow_Bands` and the whole axis-6 RAM row — from moving:
//
//   band_top went u8 -> u16  (+1)  because a PLANE LINE is 0..511 and does not fit a byte
//   the two 1-bit op flags were packed into one byte  (-1)
//
// Net zero. The op packing is not a tidy-up riding along: it is what PAYS for the wider
// top. Decode_Factor_A/B read it with `btst #0` / `btst #1` on the same byte, which is
// the same cost as the two `tst.b`s it replaces.
pub struct band_entry {
    band_top_plane:      u16,  // ROM: first PLANE LINE of the band (0..511)
    band_factor_a_s1:    u8,   // Plane A shift1 (15 = whole-factor zero "locked")
    band_factor_a_s2:    u8,   // Plane A shift2 (15 = single-term factor)
    band_factor_b_s1:    u8,   // Plane B shift1
    band_factor_b_s2:    u8,   // Plane B shift2
    band_factor_ops:     u8,   // bit 0: plane A 0=ADD/1=SUB; bit 1: plane B 0=ADD/1=SUB
    band_deform_shift_a: u8,   // Plane A deform amplitude shift (15 = no FG deform)
    band_deform_shift_b: u8,   // Plane B deform amplitude shift
    band_phase_offset:   u8,   // 0..255, added to deform sample index for desync
}

// ================= THE CAPABILITY-SHAPED RECORD (P3 TASK 8, design 3.1) =============
//
// 3.1's rule: "no-new-capability scenes lower to the EXISTING 28-byte header + 10-byte
// entries BYTE-IDENTICALLY; extended records exist only in games whose mask includes
// MULTI_DEFORM_TABLE." (The quote is 3.1's own wording and its "28-byte" is now stale by
// two: the header became 30 bytes on 2026-08-27 when `pcfg_layer_mask` widened to a u16
// for MAX_PARALLAX_BANDS = 16. The rule this passage cites is about the BAND record, which
// did not move.) With BAND_EXT_N at 0 the trailing array field emits NOTHING and
// sizeof(band_record) IS sizeof(band_entry), so every stride, displacement and reservation
// derived from it is unchanged byte for byte — the four-shape CRC pairs are in
// docs/benchmarks/scanline-p3/EXTENDED-RECORD.md.
//
// WHY A LENGTH-PARAMETERISED ARRAY FIELD AND NOT A CONDITIONAL DECLARATION. sigil's item
// grammar has no `if` opener (crates/sigil-frontend-emp/src/parser.rs:544-600 is the whole
// list), so `if CAP { struct band_record {...} } else { struct band_record {...} }` is
// ungrammatical, and a `data X: T` binding carries exactly one type annotation, so two
// types feeding one binding is closed too. Parameterising the type — one struct whose
// trailing array is 1 long or 0 long — is the form that survives, and it keeps the
// size-annotation and array-length PINS that 3.1 says the untyped
// `if CAP {..} else {Data.empty}` fallback forfeits. That was Task 8 Step 1's SPIKE, proven
// by ROM bytes in BOTH arms rather than by a green build (EXTENDED-RECORD.md section 1).
//
// WHY IT IS A SECOND STRUCT AND NOT FIELDS ON `band_entry`. `band_entry` is one of sigil's
// STRUCT_OFFSET_TWINS (crates/sigil-harness/src/native.rs:1348-1357): the build lays it out
// AMBIENTLY — one file plus types.emp, no profile, no defines, no contract — to harvest
// `band_entry_len` for engine/ram.emp's mirror pin. A name from outside that tiny
// environment in a harvested struct's layout expression fails the whole build before a byte
// is emitted (measured 2026-08-20). So the harvested twin stays contract-free and the
// capability shape lives in a struct the harvest never sees. `band_record` is deliberately
// NOT in that list, and `band_entry` must never gain a field.
//
// ---- WHY BAND_EXT_N IS A PINNED LITERAL AND NOT A FOLD OF Game.SCANLINE_CAPS ----
//
// It should read `if (Game.SCANLINE_CAPS & CAP_MULTI_DEFORM_TABLE) != 0 { 1 } else { 0 }`,
// and that spelling was written, built, and REJECTED BY THE COMPILER twenty times over —
// `unknown name Game.SCANLINE_CAPS`, once per emitted config record. The context that lays
// out an emitted `data` binding's record type does not bind contract members. Neither does
// the ambient struct harvest, nor `harvest_engine_ram_addresses` (engine/ram.emp earns the
// same error for the same spelling). A build DEFINE *is* visible there: driving BAND_EXT_N
// off `DEBUG` sized the record and built byte-identically, which is what makes the fix
// concrete rather than speculative — expose each game's declared SCANLINE_CAPS as an
// `emp_defines` row the way MAX_RING_BUFFER already is. That is a sigil-side change, booked
// in docs/DEFERRED_WORK.md; EXTENDED-RECORD.md has the full evidence.
//
// Until then the number is a mirror and THE CAPABILITY IS STILL THE AUTHORITY, because the
// game side pins the two together where both are visible: games/sonic4/data/effects/
// scene_registry.emp carries a two-directional ensure against Game.SCANLINE_CAPS. Raising
// the bit without setting this to 1 fails the build, and so does the reverse. What this
// tree cannot do yet is carry two games that DISAGREE about the bit — one engine constant
// cannot be 0 and 1 at once — and that, precisely, is what the define buys.
pub const BAND_EXT_N = 0

// band_ext — the per-layer deform reference, present only under CAP_MULTI_DEFORM_TABLE.
//
// WHAT IS AND IS NOT HERE. Design section 2's `own(table, shift_a/b, phase, speed)` names
// five things; three ALREADY have a home in the legacy entry and are not duplicated —
// `shift_a/b` are `band_deform_shift_a/b`, `phase` is `band_phase_offset`, all three
// per-band since Parcel W. What `own` adds over `shared` is the TABLE the band samples and
// the RATE its phase advances, which are the CONFIG's in every other variant
// (`pcfg_deform_table_fg/bg`, `pcfg_deform_speed_fg/bg`). So the extension is exactly those
// four fields and nothing speculative.
//
// INHERITANCE IS RESOLVED AT COMPTIME, NOT BY A NULL SENTINEL HERE (P3 Task 9 SETTLED
// THIS; Task 8 left it open and guessed the other way). These four fields always carry the
// EFFECTIVE value for their band: a band whose layer authored no `own` ref carries the
// SCENE's table and speed, resolved by `band_table_a/b()` and `band_speed_a/b()` in
// engine/level/scene_dsl.emp. Both inputs — the scene's plane attachment and the layer's
// own — are comptime constants, so a runtime "is it null? then use the config's" test per
// band per plane would spend the frame's hot path re-deciding what the build already knows.
// The consequence is worth stating plainly: in a game that declares the capability EVERY
// band carries an extension, because the extension is a record-shape property of the GAME
// (design section 3.1), never a per-band option.
//
// So the fill loop's read is unconditional under the capability — two `movea.l`s and no
// test — which is also what makes Task 9's cost parameter a clean per-band constant rather
// than a data-dependent branch.
// THE TWO TABLE FIELDS ARE `*u8`, NOT `u32` (P3 Task 9 corrected Task 8's declaration).
// They hold a Label — a ROM address the linker fills in — and a `u32` field REFUSES one:
// `[emit.type] expected an integer for u32, got label`, once per emitted band, measured
// 2026-08-20 the first time a lowering put a real table in here. Task 8's placeholder was
// the literal 0, which is why the declaration built for a parcel while being wrong.
// `*u8` is what `parallax_config`'s three table words already use, for the same reason.
pub struct band_ext (size: 10) {
    bx_deform_table_a: *u8,  // Plane A deform table, EFFECTIVE (own's, else the scene's)
    bx_deform_table_b: *u8,  // Plane B deform table, EFFECTIVE (own's, else the scene's)
    bx_deform_speed_a: u8,   // Plane A phase advance per frame, EFFECTIVE
    bx_deform_speed_b: u8,   // Plane B phase advance per frame, EFFECTIVE
}

// ================= THE CURVE TAIL (P3 TASK 10, design section 2 / 4.1) ==============
//
// A BG factor may be a `curve(from, to)`: the effective Plane-B scroll RAMPS across the
// layer instead of holding one factor. `from` is the layer's own `fb` (the factor already
// in the legacy prefix, unchanged and still the band's base scroll); `to` is the far-end
// factor, and it is what this tail carries.
//
// SECOND CAPABILITY-SELECTED TAIL, SAME SHAPE AS band_ext, AND DELIBERATELY NOT FOLDED
// INTO IT. The two are selected by DIFFERENT bits (CAP_MULTI_DEFORM_TABLE / CAP_FACTOR_CURVE)
// and a game may declare either, both or neither; one merged tail would make a curve game
// pay for deform pointers it never reads and vice versa. `band_record` composes them, and
// with both N's at 0 it is still byte-for-byte the legacy `band_entry`.
//
// FOUR ROM BYTES AND THREE RUNTIME WORDS, and the split is the design:
//   * bc_to_s1/bc_to_s2/bc_flags are AUTHORED — the far-end factor's packed shift pair and
//     its op/active bits, lowered by scene_band().
//   * bc_step/bc_rem/bc_span are DERIVED EVERY FRAME by the curve hoist
//     (Parallax_Step4_Fill, `.cap_factor_curve_hoist`) into the SHADOW copy. Their ROM
//     image is zero and is never read.
//
// WHY THE DERIVED WORDS LIVE IN THE RECORD RATHER THAN IN THREE PARALLEL RAM ARRAYS. The
// anchored overlay (Step 4b) SPLITS a band by copying a whole entry down and duplicating
// it, and the split of a curve layer must CONTINUE that layer's ramp (design section 2:
// "an anchor split inside a curve layer continues the curve"). Riding inside the record
// means the existing whole-entry copies — `copy_band_entry_fwd`/`_back`, which are already
// generated from `sizeof(band_record)` — carry the curve parameters to the split for free.
// Three parallel arrays would need three more shift-down walks in Step 4b, each one a
// place for the two views to drift apart. The cost is four dead ROM bytes per band in a
// curve game, stated plainly rather than hidden.
pub const CURVE_FLAG_OP_BIT     = 0   // far-end factor: 0 = ADD the second term, 1 = SUB
pub const CURVE_FLAG_ACTIVE_BIT = 1   // 1 = this band is a curve layer (authored)
// SET AT RUNTIME BY STEP 4b, ON THE SPLIT ENTRY ONLY, and never present in ROM. It is what
// tells the fill "seed this band's accumulator from the previous band's parked carry
// instead of from the base scroll" — i.e. do not re-parametrise the ramp at the split.
// Every frame's shadow view is re-copied from ROM before Step 4b runs, so the bit cannot
// go stale.
pub const CURVE_FLAG_CONT_BIT   = 2
pub struct band_curve (size: 10) {
    bc_to_s1:  u8,   // far-end factor shift1 (15 = whole-factor zero, "ramp to locked")
    bc_to_s2:  u8,   // far-end factor shift2 (15 = single-term factor)
    bc_flags:  u8,   // CURVE_FLAG_* bits
    bc_pad:    u8,   // keeps the three derived words on even offsets (68000 address error)
    bc_step:   i16,  // DERIVED: floor(spread / span), the whole part of the per-line delta
    bc_rem:    i16,  // DERIVED: spread mod span, normalised to [0, span) — the Bresenham term
    bc_span:   u16,  // DERIVED: the layer's on-screen line span, the Bresenham modulus
}

// BAND_CURVE_N — 1 in a game whose SCANLINE_CAPS include CAP_FACTOR_CURVE, else 0. A
// PINNED LITERAL for exactly BAND_EXT_N's reason (its banner above has the full evidence):
// the context that lays out an emitted `data` binding's record type binds no contract
// members, so `Game.SCANLINE_CAPS` here is `unknown name`, once per emitted config record.
// The capability is still the authority — games/sonic4/data/effects/scene_registry.emp
// carries the two-directional pin, where both names are visible.
//
// FLIPPED TO 1 BY THE d-15 SHOWCASE PARCEL (2026-08-26). The owner's answer to PARK-1 turns
// per-layer vertical depth and CURVED SCROLLING on in the OJZ showcase, and the curve half
// is a RECORD-SHAPE capability: the Aurora-authored scene `ojz_act1_depth`
// (games/sonic4/data/editor/effects/ojz_act1_depth.json) attaches `curve: SceneCurve.To(..)`
// to two layers, so every band record in the tree now carries the curve tail and
// engine/ram.emp's BAND_CURVE_BYTES mirror moved to 10 in the same commit — which is exactly
// what scene_registry.emp's CAP_FACTOR_CURVE pin says adopting one costs.
//
// IT IS ENGINE-WIDE, NOT PER-GAME, and that is this constant's design (see the banner
// above): a pinned literal cannot read Game.SCANLINE_CAPS, so `demo` pays the widened
// record too. Both images move; both are rebuilt and gated by this parcel.
pub const BAND_CURVE_N = 1

// ============== THE DRIFT TAIL (band drift, design §1.3 / §2) =====================
//
// A layer may DRIFT: its plane-B scroll advances by a constant rate every frame, on top of
// whatever the camera term already gives it. Clouds that keep moving while the player stands
// still. THIRD capability-selected tail, selected by CAP_BAND_DRIFT, and deliberately not
// folded into either of the other two for band_curve's stated reason — a game may declare
// any subset of the three, and one merged tail would make each pay for the others.
//
// THE AUTHORED UNIT IS 1/256 px PER FRAME (signed 8.8); THIS FIELD IS 16.16. The shift is
// done in the LOWERING (`scene_band()`: `rate << 8`), not at runtime. An 8.8 rate must be
// aligned to the 16.16 accumulator before it can be added to it, and doing that with an
// `lsl.l #8` costs 24 cycles per band per frame on the 68000 (8 + 2n); doing it at comptime
// costs 2 ROM bytes per band and nothing per frame.
//
// ---- WHY THE ACCUMULATOR IS NOT IN THIS TAIL, WHICH IS THE WHOLE DESIGN ----
//
// The obvious shape — rate here, accumulator beside it — CANNOT BE BUILT, for two
// independent reasons, both properties of the shadow view this record also lives in:
//
//   (a) THE SHADOW VIEW IS DESTROYED AND REBUILT FROM ROM EVERY FRAME. Step 4a walks every
//       band and calls copy_band_entry_fwd(), which copies the WHOLE record, tails included.
//       An accumulator in a shadow tail is overwritten with its ROM image (zero) before it is
//       ever read. band_curve's three derived words survive only because they are RE-DERIVED
//       after the copy by `.cap_factor_curve_hoist`; a value that must ACCUMULATE has no such
//       escape.
//   (b) THE SHADOW VIEW IS ROTATED, so slot index != layer index. Step 4a's `.find_k` starts
//       the copy at the band containing the current plane-space V-scroll and wraps. A per-slot
//       accumulator would be attributed to a DIFFERENT layer the moment Vscroll_BG crossed a
//       band top, and the drift phase would jump between layers as the camera moved.
//
// So the rate (authored, constant, read through the ROM cursor a1) lives HERE, and the
// accumulator lives in `Parallax_Drift_Acc` — a RAM array indexed by CONFIG BAND INDEX,
// exactly as Parallax_Current_Scroll_A/_B are, folded into the plane-B target inside
// Parallax_Update's band loop BEFORE Step 4a ever runs.
//
// THAT PLACEMENT IS ALSO WHY THE ANCHORED OVERLAY NEEDS NOTHING. The curve tail had to invent
// CURVE_FLAG_CONT_BIT and Parallax_Curve_Carry so a Step-4b split would CONTINUE its ramp.
// Drift is already folded into Parallax_Current_Scroll_B[i] before Step 4a copies it into the
// shadow, so Step 4b's `move.w (a5), 2(a5)` hands the manufactured entry an already-drifted
// scroll word by the mechanism that already exists. Zero flags, zero carry state.
//
// THE DUAL COST, STATED PLAINLY RATHER THAN HIDDEN (band_curve's own convention for its four
// dead ROM bytes): THE RATE'S SHADOW COPY IS NEVER READ. Step 4a copies these 4 bytes per band
// per frame and nothing consumes them. The alternative that avoids it — a parallel ROM rate
// array reached through a new parallax_config word — was costed and rejected: it widens the
// config from 30 to 34 bytes, moves every config record in the tree, pulls engine/system/
// buffers.emp into the parcel, and invents a per-band data shape that exists for one field.
//
// FOUR BYTES, AND THE SIZE IS LOAD-BEARING. It keeps sizeof(band_record) a multiple of 4
// (20 -> 24), so copy_run_longs()' `% 4 == 0` fast path survives and no trailing move.w
// appears in the whole-entry copy; and it keeps the record EVEN, which
// tools/parallax_crossing_gate.py and copy_band_entry's address-error argument both need.
//
// LAST IN THE RECORD, so raising BAND_DRIFT_N alone moves neither br_ext nor br_curve and the
// two existing offsetof ensures stay true without being edited. The new one is additive.
//
// ALIGNMENT, BECAUSE THE INSTINCT IS WRONG HERE. br_drift sits at record offset 20 and band
// i's base is `config + 30 + 24i`, so this long lands on an EVEN but not 4-aligned address.
// On a 68000 that is legal and free: only ODD addresses fault, and a long access is two word
// accesses on the 16-bit bus regardless. No padding is needed and none should be added.
//
// THE FIELD IS u32 AND NOT i32, AND THAT IS THE TREE'S PRECEDENT RATHER THAN A PREFERENCE.
// parallax_config.pcfg_v_offset is "the u16 IMAGE of a signed word", two's-complement encoded
// at comptime by scene_hdr(), for the same reason: the emitted image is what matters and the
// runtime consumes it with a size-tagged add that does not care. scene_band() does the same
// encode here. (band_curve's i16 fields prove nothing about negative emission — they are
// DERIVED words whose ROM image is always zero.)
pub struct band_drift (size: 4) {
    bd_rate_1616: u32,   // px/frame in 16.16 — the u32 image of a SIGNED rate; see the banner
}

// BAND_DRIFT_N — 1 in a game whose SCANLINE_CAPS include CAP_BAND_DRIFT, else 0. A PINNED
// LITERAL for exactly BAND_EXT_N's and BAND_CURVE_N's reason (BAND_EXT_N's banner above has
// the full evidence): the context that lays out an emitted `data` binding's record type binds
// no contract members, so `Game.SCANLINE_CAPS` here is `unknown name`. The capability is still
// the authority — games/sonic4/data/effects/scene_registry.emp carries the two-directional
// pin, where both names are visible.
//
// IT IS ENGINE-WIDE, NOT PER-GAME. Flipping it to 1 widens band_record for BOTH games,
// including `demo`, whose SCANLINE_CAPS is 0 and which will never drift, and every ROM image
// in the tree moves. That is owner-gated (scene_registry.emp carries the refusal), and it is
// why the mechanism lands at 0: the mechanism moves no byte, adoption does.
pub const BAND_DRIFT_N = 0

// band_record — WHAT A BAND OCCUPIES, in ROM and in the shadow view. This is the type the
// registry emits arrays of, the type `scene_band()` builds, and the STRIDE every walker
// loop advances by. The legacy prefix sits at offset 0, which is why every field reference
// in this file is still spelled `band_entry.<field>(aN)`.
//
// A MODULE THAT IMPORTS `band_record` MUST IMPORT `band_entry`, `band_ext`, `BAND_EXT_N`,
// `band_curve`, `BAND_CURVE_N`, `band_drift` AND `BAND_DRIFT_N` TOO. The declaration is re-elaborated in the importing
// module's own name environment, so a partial import fails there — and it fails pointing AT
// THIS DECLARATION, in this file, naming a type this file plainly declares. Three importers
// do it: engine.level.scene_dsl, games.sonic4.scene_registry, games.sonic4.scene_equiv_proof.
pub struct band_record (size: sizeof(band_entry) + sizeof(band_ext) * BAND_EXT_N + sizeof(band_curve) * BAND_CURVE_N + sizeof(band_drift) * BAND_DRIFT_N) {
    br_base:  band_entry,
    br_ext:   [band_ext; BAND_EXT_N],
    br_curve: [band_curve; BAND_CURVE_N],
    br_drift: [band_drift; BAND_DRIFT_N],
}
ensure(offsetof(band_record, br_base) == 0,
       "band_record's legacy prefix is at offset {offsetof(band_record, br_base)}, not 0 — every `band_entry.<field>(aN)` displacement in this file addresses through the record base, so a non-zero prefix offset silently mis-addresses all ten legacy fields")
// THE CAPABILITY-OFF IDENTITY, as an assertion rather than a comment: with no extension the
// record IS the legacy entry. Design section 8.1's claim, checked where it is decided.
ensure(BAND_EXT_N != 0 || BAND_CURVE_N != 0 || BAND_DRIFT_N != 0 || sizeof(band_record) == sizeof(band_entry),
       "all three capability tails are absent (BAND_EXT_N {BAND_EXT_N}, BAND_CURVE_N {BAND_CURVE_N}, BAND_DRIFT_N {BAND_DRIFT_N}) but band_record ({sizeof(band_record)}) is not the legacy band_entry ({sizeof(band_entry)}) — a no-new-capability game must lower byte-identically")

// THE SHADOW RESERVATION IS A MIRROR THIS MODULE HOLDS TO THE RECORD, for the same reason
// BAND_EXT_N is: engine/ram.emp is lowered by a focused, CONTRACT-BLIND build, so it cannot
// read the capability either. It reserves BAND_ENTRY_LEN per band; this ensure — which sees
// both the record and the RESOLVED RAM span — is what stops the two disagreeing. Widen the
// record without widening ram.emp and the build fails naming the constant, instead of the
// shadow view running off the end of its array at runtime.
ensure(extern("Parallax_Shadow_Scroll_A") - extern("Parallax_Shadow_Bands") == sizeof(band_record) * MAX_PARALLAX_BANDS,
       "Parallax_Shadow_Bands reserves fewer bytes than the shadow view needs: sizeof(band_record) x MAX_PARALLAX_BANDS = {sizeof(band_record) * MAX_PARALLAX_BANDS} — set BAND_EXT_BYTES (the deform tail, sizeof(band_ext) = 10), BAND_CURVE_BYTES (the curve tail, sizeof(band_curve) = 10) and/or BAND_DRIFT_BYTES (the drift tail, sizeof(band_drift) = 4) in engine/ram.emp to match the tails this game's capabilities select. Do NOT widen BAND_ENTRY_LEN: it mirrors the LEGACY band_entry, which sigil harvests ambiently, and the extern(\"band_entry_len\") pin beside it would go red")

// The two op bits, named once. Decode_Factor_A/B and the lowering are the only readers.
pub const BAND_OP_BIT_A = 0
pub const BAND_OP_BIT_B = 1

// band_top_line / band_top_line_next — THE SAME WORD at THE SAME OFFSET as
// band_top_plane, named for the unit it carries in the per-frame SHADOW VIEW.
//
// Two populations of band_entry exist and they measure their top in different units:
//   ROM entries (games/.../ojz_scenes.emp, lowered) -> Plane-B LINES 0..511
//   Parallax_Shadow_Bands (rebuilt each frame)      -> SCREEN LINES 0..224
// Both fit the u16, so nothing moves; Step 4a's rebase is where plane lines become
// screen lines.
//
// BEFORE P3 TASK 7 THE ROM UNIT WAS A PLANE CELL ROW (0..63) AND THE REBASE ALSO
// QUANTISED THE SCROLL (`Vscroll_BG >> 3`). That is the one-line-off class: a band top
// only ever landed on an 8-px cell edge and JUMPED a whole cell as the BG scrolled,
// while the art underneath it moved a line at a time. Re-glue keeps the sub-cell part of
// Vscroll_BG — the "partial offset" S.C.E.'s walker carries out of its height subtraction
// — so the top tracks the art line for line. That is the whole mechanism; the wider field
// exists to make an off-cell top REPRESENTABLE, which is what lets `layer()` drop its
// 8-px grid ensure.
//
// The alternative spelling — renaming the field to a unit-free `band_top` — was REJECTED:
// one name silently meaning two units is worse than the status quo, because nothing at a
// call site tells you which population you are holding. Two names at one offset make grep
// separate them.
//
// The peek-ahead form exists because the .field-in-disp sugar does not compose in
// displacement arithmetic (row 1068), so the neighbour offset must be a named const.
// Parallax_State clear span in longwords — a NAMED comptime mirror for the
// Init loop counter, drift-locked to the ram.asm layout. (The counter was a
// `moveq` until the 2026-08-27 ceiling raise made the count exceed a signed
// byte; see the note below. moveq link-deferral exists — the ImmSigned8 fixup
// — but the named count + drift-lock reads better than inline extern
// arithmetic; keeping the mirror is the chosen spelling.)
//
// IT MOVED DOWN HERE IN P3 TASK 8 so it can carry the extension term: the shadow-band array
// lives inside this span, so a wider record widens the wipe. The extension term is DERIVED
// from the record rather than hand-added, so widening ram.emp's BAND_ENTRY_LEN is the one
// edit a capability flip needs and this count follows it.
//
// THE CAPABILITY-OFF TERM IS DERIVED FROM MAX_PARALLAX_BANDS TOO (2026-08-27), and it used
// to be the literal `61`. That literal was NOT a constant of the layout — it was 244/4, and
// 244 is `100 + 18 * 8`. Five of ram.emp's Parallax_State fields are sized by the band
// ceiling, so raising the ceiling moved the real span and left the mirror behind: measured
// at MAX_PARALLAX_BANDS = 16 the drift guard below fired with "expected 102 longs" against
// a true span of 138. The guard caught it — this spelling means there is nothing to catch.
//
//   100 = the ceiling-INDEPENDENT bytes: 3 phase words (6) + Current_Vscroll_BG (2) +
//         two config longs (8) + Transition_Frames/Snap_Pending/Prev_Sec_X/Prev_Sec_Y (4)
//         + Vscroll_Column_Buf (80).
//    18 = the PER-BAND bytes at the capability-off record: Current_Scroll_A + _B (4) +
//         BAND_ENTRY_LEN (10) + Shadow_Scroll_A + _B (4).
//
// Both terms are checked against the resolved RAM span by the drift ensure below, so this
// arithmetic is a spelling of that layout and not a second authority on it.
//
// THE CEILING RAISE HAPPENED (2026-08-27, MAX_PARALLAX_BANDS 8 -> 16) AND THIS IS WHAT IT
// COST HERE: `Parallax_Init` used to load this count with a `moveq`, whose immediate is a
// SIGNED BYTE. The count is `7 * M + 25` at the shipped capability set, so the moveq form
// survives only to MAX = 14; at 15 and above sigil refuses it by name rather than
// truncating it ("moveq data 137 does not fit in a signed byte", measured at MAX = 16), so
// it was a loud build error and never a 65,418-iteration clear. Init now loads it with a
// `move.w` — +2 ROM bytes and +4 cycles, once, at level init. Do NOT "optimise" it back to
// a moveq: it fits again only if the ceiling ever drops below 15.
//
// THE SPAN AT MAX 16 IS 552 BYTES (138 longs), up from 328 (82) at MAX 8 — +224 B, the
// whole RAM cost of the raise. Nothing here needed to change for it: both terms are
// derived, and the drift ensure below checks them against the resolved RAM span.
ensure(((sizeof(band_ext) * BAND_EXT_N + sizeof(band_curve) * BAND_CURVE_N + sizeof(band_drift) * BAND_DRIFT_N) * MAX_PARALLAX_BANDS) % 4 == 0,
       "the band tails add {(sizeof(band_ext) * BAND_EXT_N + sizeof(band_curve) * BAND_CURVE_N + sizeof(band_drift) * BAND_DRIFT_N) * MAX_PARALLAX_BANDS} bytes to Parallax_State, which is not a whole number of longs — Parallax_Init clears in LONGS, so a non-multiple would under-clear the tail")
// The trailing `+ BAND_CURVE_N` is the two-word curve carry (P3 Task 10) — one long, in
// the state span and therefore cleared by Parallax_Init, present only under the capability.
// `+ BAND_DRIFT_N * MAX_PARALLAX_BANDS` is Parallax_Drift_Acc, the band-drift accumulator
// array: ONE LONG PER BAND, not one per config, because it is indexed by config band index
// exactly as Parallax_Current_Scroll_A/_B are. It is inside this span deliberately —
// Parallax_Init clears the whole span in longs, so the accumulators zero themselves at level
// init with no new code. The shadow-widening half of the drift cost rides in the tails term
// above (sizeof(band_drift) * BAND_DRIFT_N), which is where every tail's shadow cost lives.
const PARALLAX_STATE_LONGS = (100 + 18 * MAX_PARALLAX_BANDS) / 4 + ((sizeof(band_ext) * BAND_EXT_N + sizeof(band_curve) * BAND_CURVE_N + sizeof(band_drift) * BAND_DRIFT_N) * MAX_PARALLAX_BANDS) / 4 + BAND_CURVE_N + BAND_DRIFT_N * MAX_PARALLAX_BANDS
ensure(extern("Parallax_Shadow_Bands") - extern("Parallax_Curve_Carry") == 4 * BAND_CURVE_N,
       "the curve carry reserves {extern(\"Parallax_Shadow_Bands\") - extern(\"Parallax_Curve_Carry\")} bytes, not the {4 * BAND_CURVE_N} this capability needs — set CURVE_CARRY_WORDS in engine/ram.emp (it is derived from BAND_CURVE_BYTES, so the real edit is that mirror). A short reservation makes the fill's cross-band carry alias the shadow band array")
// The drift accumulator's own reservation, the exact twin of the curve-carry pin above and
// for the same reason: the total-span ensure below can only say the sum is wrong, never
// WHICH array is short, and a short accumulator array makes the band loop's `addq.l #4, a4`
// walk off the end into Parallax_Curve_Carry and then into the shadow bands — a silent
// corruption of the thing Step 4a is about to read. Parallax_Drift_Acc is placed immediately
// BEFORE Parallax_Curve_Carry in engine/ram.emp precisely so both pins are adjacent-symbol
// differences; inserting anything between them breaks whichever one it splits.
ensure(extern("Parallax_Curve_Carry") - extern("Parallax_Drift_Acc") == 4 * BAND_DRIFT_N * MAX_PARALLAX_BANDS,
       "the band-drift accumulator reserves {extern(\"Parallax_Curve_Carry\") - extern(\"Parallax_Drift_Acc\")} bytes, not the {4 * BAND_DRIFT_N * MAX_PARALLAX_BANDS} this capability needs (one 16.16 long per band, MAX_PARALLAX_BANDS of them) — set BAND_DRIFT_BYTES in engine/ram.emp (DRIFT_ACC_LONGS is derived from it, so the real edit is that one mirror). A short reservation makes Parallax_Update's accumulator cursor walk into Parallax_Curve_Carry and the shadow band array")
ensure((extern("Parallax_State_End") - extern("Parallax_State"))/4 == PARALLAX_STATE_LONGS, "Parallax_State clear span drifted from ram.asm: expected {PARALLAX_STATE_LONGS} longs")

// The peek-ahead strides by the RECORD, not by the legacy prefix — the neighbour band is
// one whole record away, extension included.
const band_top_line      = offsetof(band_entry, band_top_plane)
const band_top_line_next = offsetof(band_entry, band_top_plane) + sizeof(band_record)

// The extension's two table words, as displacements FROM THE RECORD BASE (P3 Task 9).
// Named consts for the same reason band_top_line_next is one: the .field-in-disp sugar
// does not compose in displacement arithmetic, and the extension's fields are two
// offsetofs deep. Both fold to constants whatever BAND_EXT_N is — a zero-length array
// still has a position — and the only reader is the capability-gated block in
// Parallax_Fill_PerLine, which does not exist when the array is empty.
const band_ext_table_a = offsetof(band_record, br_ext) + offsetof(band_ext, bx_deform_table_a)
const band_ext_table_b = offsetof(band_record, br_ext) + offsetof(band_ext, bx_deform_table_b)
// THE EXTENSION SITS AFTER THE LEGACY PREFIX, and the per-band load addresses through the
// same a1 the ten legacy fields do — so if the prefix ever stopped being the whole of the
// record's head, that block would read two words of band_entry as a table pointer and jump
// the fill loop into the middle of the shadow array. offsetof(br_base) == 0 is pinned
// above; this is the other half of the same claim.
ensure(BAND_EXT_N == 0 || offsetof(band_record, br_ext) == sizeof(band_entry),
       "band_record's extension starts at {offsetof(band_record, br_ext)}, not immediately after the legacy prefix ({sizeof(band_entry)}) — Parallax_Fill_PerLine's per-band table load addresses the extension by a constant displacement from the record base, so a gap or an overlap there reads legacy fields as a curve pointer")

// The curve tail's six displacements FROM THE RECORD BASE (P3 Task 10), named for
// band_ext_table_a/b's reason: the .field-in-disp sugar does not compose in displacement
// arithmetic, and each of these is two offsetofs deep. All six fold to constants whatever
// BAND_CURVE_N is — a zero-length array still has a position — and their only readers are
// the three CAP_FACTOR_CURVE-gated blocks, which do not exist when the array is empty.
const band_curve_to_s1  = offsetof(band_record, br_curve) + offsetof(band_curve, bc_to_s1)
const band_curve_to_s2  = offsetof(band_record, br_curve) + offsetof(band_curve, bc_to_s2)
const band_curve_flags  = offsetof(band_record, br_curve) + offsetof(band_curve, bc_flags)
const band_curve_step   = offsetof(band_record, br_curve) + offsetof(band_curve, bc_step)
const band_curve_rem    = offsetof(band_record, br_curve) + offsetof(band_curve, bc_rem)
const band_curve_span   = offsetof(band_record, br_curve) + offsetof(band_curve, bc_span)
// THE CURVE TAIL SITS AFTER BOTH THE LEGACY PREFIX AND THE DEFORM TAIL, and the hoist
// writes three WORDS through those displacements — so an overlap would not merely read the
// wrong bytes, it would CORRUPT a neighbouring band's fields every frame. Same claim as the
// br_ext pin above, for the tail that is written rather than only read.
ensure(BAND_CURVE_N == 0 || offsetof(band_record, br_curve) == sizeof(band_entry) + sizeof(band_ext) * BAND_EXT_N,
       "band_record's curve tail starts at {offsetof(band_record, br_curve)}, not immediately after the legacy prefix plus the deform tail ({sizeof(band_entry) + sizeof(band_ext) * BAND_EXT_N}) — the per-frame curve hoist WRITES three words at constant displacements from the record base, so a gap or an overlap there scribbles over band fields once per frame")
// The three derived words are written with `move.w`, so each must land on an EVEN
// displacement from a record base that is itself even (copy_run_longs() pins both the
// record stride and the config header's size for the same reason). An odd one is a 68000
// address error at runtime, not a wrong picture.
ensure(BAND_CURVE_N == 0 || (band_curve_step % 2 == 0 && band_curve_rem % 2 == 0 && band_curve_span % 2 == 0),
       "a curve tail word lands on an ODD displacement from the record base (step {band_curve_step}, rem {band_curve_rem}, span {band_curve_span}) — the per-frame hoist writes all three with move.w and would address-error")
// The drift tail's ONE displacement FROM THE RECORD BASE, named for band_curve_*'s reason and
// NOT optional sugar: `band_drift.bd_rate_1616(a1)` would assemble to displacement 0 — the
// field's offset WITHIN band_drift — and read band_top_plane + band_factor_a as a rate, every
// band, every frame, with no diagnostic. The .field-in-disp sugar does not compose through a
// containing struct. Folds to a constant whatever BAND_DRIFT_N is (a zero-length array still
// has a position), and its only reader is the CAP_BAND_DRIFT-gated accumulate in
// Parallax_Update, which does not exist when the array is empty.
const band_drift_rate = offsetof(band_record, br_drift) + offsetof(band_drift, bd_rate_1616)
// THE DRIFT TAIL SITS AFTER THE LEGACY PREFIX AND BOTH OTHER TAILS — it is LAST by design, so
// that raising BAND_DRIFT_N alone moves neither br_ext nor br_curve and the two pins above
// stay true without being edited. This is the additive third.
ensure(BAND_DRIFT_N == 0 || offsetof(band_record, br_drift) == sizeof(band_entry) + sizeof(band_ext) * BAND_EXT_N + sizeof(band_curve) * BAND_CURVE_N,
       "band_record's drift tail starts at {offsetof(band_record, br_drift)}, not immediately after the legacy prefix plus the deform and curve tails ({sizeof(band_entry) + sizeof(band_ext) * BAND_EXT_N + sizeof(band_curve) * BAND_CURVE_N}) — Parallax_Update reads the rate by a constant displacement from the record base, so a gap or an overlap there reads two legacy or curve fields as a 16.16 drift rate and moves the background by garbage every frame")
// The rate is read with `move.l`, so its displacement from an even record base must itself be
// EVEN or every band's read is a 68000 address error. Same claim as the curve tail's odd-word
// pin below, for the field that is read as a LONG rather than written as three words.
ensure(BAND_DRIFT_N == 0 || band_drift_rate % 2 == 0,
       "the drift tail's rate lands on an ODD displacement from the record base ({band_drift_rate}) — Parallax_Update reads it with move.l and would address-error on every band")
// PLANE_B_SPAN — the Plane-B vertical span in pixels, the modulus Step 4a's rotation
// works in and the ceiling every lowered `band_top_plane` must sit under. 64 rows of
// 8-px cells: the engine's plane geometry, not a parallax choice, which is why it is
// derived from the cell count rather than typed as 512.
pub const PLANE_B_CELL_ROWS = 64
pub const PLANE_B_SPAN      = PLANE_B_CELL_ROWS * 8
ensure(PLANE_B_SPAN == 512, "PLANE_B_SPAN drifted from the 64x64 Plane-B geometry Step 4a's `and.w #PLANE_B_SPAN-1` masks against")

// ---- THE THREE WHOLE-ENTRY COPIES, ALL GENERATED FROM ONE SIZE (P3 Task 8 Step 3) ----
//
// A whole band_entry moves in three places in this file and, before Task 8, only ONE of
// them was derived from the struct. Step 4a called the generator; the two Parcel-W sites —
// `.anchor_shift_band` and the split-entry write — were hand-unrolled three-move runs, each
// carrying the entry's 10-byte shape as typed-out instructions. That is the duplication
// removed here: the generator produces BOTH directions now and all three sites call it, so
// a field added to band_entry lengthens every run instead of lengthening one and silently
// TRUNCATING two.
//
// THE TWO DIRECTIONS ARE NOT INTERCHANGEABLE, which is why both are generated rather than
// one being spelled in terms of the other at a call site. Forward is two post-incrementing
// cursors. Backward is ONE pre-decrementing cursor whose source steps back inside the entry
// while each piece is written one whole entry forward — the shift-down walk's cursor
// discipline, which requires running from the END. A backward run is the forward run
// REVERSED, so both take their widths from `copy_run_longs()`: get the two out of step and
// one site copies a different set of bytes than the other, in the quietest possible way.
//
// SIBLING, still hand-written: engine.buffers' `queue_static_dma` spells the
// same shape as a literal 3L+1W run under
// `ensure(sizeof(DMAEntry) == 14, "… re-derive the copy")`. One shared generator
// over both is its own byte-proving parcel (gap-ledger row).

// The long count of the widest-first run whose total advance is exactly sizeof(band_record):
// as many longs as fit, then a trailing word when the size is not a multiple of 4.
comptime fn copy_run_longs() -> int {
    // An ODD entry size is unrepresentable here, and the reason is a crash, not
    // a truncation: with an odd stride the k-th entry starts at base + k*size,
    // whose parity ALTERNATES, so the run's leading `move.l` lands on an odd
    // address for every odd k — a 68000 address error (CODING_CONVENTIONS §6.1,
    // "Word-align ALL word and long data"). No ordering of the run fixes it.
    // The stride is only half of it: the run's FIRST address must be even too,
    // and the band array's base is the config header, so the header carries the
    // same obligation. Both bases are even today only by layout accident.
    // Pinning a divisibility assumption rather than letting it hold by accident
    // is the core.clear_longs precedent.
    //
    // IT IS WRITTEN AGAINST THE SIZE, NOT AGAINST 10, so it holds for the extended record
    // too when one lands (P3 Task 8 correction C5: evenness must survive the extension —
    // prefix + extension, not prefix alone). See docs/benchmarks/scanline-p3/
    // EXTENDED-RECORD.md for why the extension itself is not here yet.
    ensure(sizeof(band_record) % 2 == 0,
           "sizeof(band_record) is {sizeof(band_record)}, which is ODD — the whole-entry copy's move.l run would address-error on every odd-indexed entry; keep the entry size even")
    ensure(sizeof(parallax_config) % 2 == 0,
           "sizeof(parallax_config) is odd — it is the band array's base offset, so the whole-entry copy's move.l run would start on an odd address")
    return sizeof(band_record) / 4
}

// copy_band_entry_fwd — forward copy, both cursors post-incrementing.
//
// In:  {src} = source entry, {dst} = destination cursor
// Out: both advanced by sizeof(band_record); no data register touched
//
// Step 4a's rebase immediately after its call reads the copied top back through
// `-sizeof(band_record)(a4)`, so the run's advance and that displacement are ONE fact
// rather than two numbers that must agree.
comptime fn copy_band_entry_fwd(src: Reg, dst: Reg) -> Code {
    let longs = 0..copy_run_longs() |> fold(asm {}, |acc, _i| acc ++ asm {
        move.l  ({src})+, ({dst})+
    })
    if sizeof(band_record) % 4 == 0 { return longs }
    return longs ++ asm { move.w  ({src})+, ({dst})+ }
}

// copy_band_entry_back — the same run REVERSED: one pre-decrementing cursor walking back
// through the source entry, each piece written one whole entry forward.
//
// In:  {cur} = one past the END of the source entry
// Out: {cur} moved back by sizeof(band_record); the entry now also sits one entry later
comptime fn copy_band_entry_back(cur: Reg) -> Code {
    let tail = if sizeof(band_record) % 4 == 0 { asm { } } else { asm {
        move.w  -({cur}), sizeof(band_record)({cur})
    } }
    return tail ++ (0..copy_run_longs() |> fold(asm {}, |acc, _i| acc ++ asm {
        move.l  -({cur}), sizeof(band_record)({cur})
    }))
}

// ----------------------------------------------------------------------
// Parallax_Init — wipe Parallax_State and seed current_config
// In:  a0 = parallax_config* (NULL = inert; pipeline will skip)
// Out: none
// Clobbers: d0-d7, a0-a6 (the local wipe touches d0/d1/a1; the snap `jbsr
//           Parallax_Update` tail-call clobbers the full file — the declaration
//           below is the real, tail-inclusive contract).
// ----------------------------------------------------------------------
pub proc Parallax_Init () clobbers(d0-d7/a0-a6) {
        lea     Parallax_State, a1                          // (Parallax_State).w
        // `move.w`, NOT `moveq`: a moveq immediate is a SIGNED BYTE and this count is
        // `7 * MAX_PARALLAX_BANDS + 25` at the shipped capability set — 81 at MAX 8, but
        // 137 at MAX 16, which sigil refuses by name ("moveq data 137 does not fit in a
        // signed byte"). A loud build error, never a 65,418-iteration clear; the fix costs
        // +2 ROM bytes and +4 cycles ONCE, at level init. See the note at
        // PARALLAX_STATE_LONGS. (The moveq form survives up to MAX = 14.)
        move.w  #PARALLAX_STATE_LONGS-1, d0
        moveq   #0, d1
    .zero:
        move.l  d1, (a1)+
        dbf     d0, .zero

        move.l  a0, Parallax_Current_Config                 // (Parallax_Current_Config).w

        // Seed the previous-section trackers to a sentinel (the .zero loop
        // above just cleared them to 0,0, a valid grid coord). $FF,$FF can
        // never match a real section, so the first Parallax_CheckBoundary
        // re-selects the start section's config — a no-op against the config
        // this Init already chose, but it primes Prev_Sec_X/Y correctly.
        move.b  #$FF, Parallax_Prev_Sec_X                   // (Parallax_Prev_Sec_X).w
        move.b  #$FF, Parallax_Prev_Sec_Y                   // (Parallax_Prev_Sec_Y).w

        // Snap all band scrolls to their correct positions on the first
        // frame instead of lerping from 0. One Update with Snap_Pending
        // writes target_scroll directly to current_scroll for every band.
        st      Parallax_Snap_Pending                       // (Parallax_Snap_Pending).w
        jbsr    Parallax_Update
        rts
}

// ----------------------------------------------------------------------
// Parallax_CheckBoundary — per-section parallax: re-select config on a
// section-boundary crossing.
//
// Continuous-scroll replacement for the deleted teleport-driven snap. The
// camera scrolls live in world space, so there is no teleport to hang the
// config switch on; instead we watch the section under the camera CENTRE
// (matching the active-section semantic used for the diagnostic tint) and
// act the frame it changes. On a crossing we hand the new section to
// Effects_InstallPreset, which resolves ep_parallax (the act default when
// NULL) and returns it, and hand THAT to Parallax_StartTransition, which
// decides snap vs. lerp from the new config's pcfg_transition flag and
// no-ops when the config is unchanged.
//
// Edge-triggered: the per-frame cost off a boundary is two shifts and a
// byte compare. Out-of-grid sections (Section_GetSecPtrXY Z set) are left
// alone — the camera is clamped in-grid, but the guard keeps this robust.
//
// In:  none (reads Camera_X/Y, Current_Act_Ptr, Parallax_Prev_Sec_X/Y)
// Out: config switched + transition staged iff a crossing changed it.
// Clobbers: d0-d4, a0-a3 (a1/a3 enter the union via Effects_InstallPreset,
//   the effects-P3 preset path — the sole per-section effect consumer since
//   the legacy per-field installers were removed, effects-P3-C2 Task 13; d4
//   joined it in P-b, where Raster_BuildSchedule's table walk reaches d4. d2/d3 hold
//   the section coords and are dead by the call, so nothing here needs saving.)
// ----------------------------------------------------------------------
pub proc Parallax_CheckBoundary () clobbers(d0-d4/a0-a3) {
        // -- section under the camera centre (camX+160 / camY+112) --
        move.w  Camera_X, d2                        // (Camera_X).w — world X px (high word)
        addi.w  #SCREEN_WIDTH/2, d2
        moveq   #SECTION_SIZE_SHIFT, d0
        asr.w   d0, d2 as GridX                     // d2 = cur_sec_x
        move.w  Camera_Y, d3                        // (Camera_Y).w — world Y px
        addi.w  #SCREEN_HEIGHT/2, d3
        asr.w   d0, d3 as GridY                     // d3 = cur_sec_y

        // -- crossing? compare against last frame's section --
        cmp.b   Parallax_Prev_Sec_X, d2            // (Parallax_Prev_Sec_X).w
        bne     .crossed
        cmp.b   Parallax_Prev_Sec_Y, d3            // (Parallax_Prev_Sec_Y).w
        beq     .no_crossing
    .crossed:
        // -- look up the new section (a2 = act ptr) --
        movea.l Current_Act_Ptr, a2                 // (Current_Act_Ptr).w
        jbsr    Section_GetSecPtrXY                 // a0 = Sec ptr (Z set = out of grid)
        beq     .no_crossing                        // out of grid — keep current config

        // commit the new section coords only once we have a valid section
        move.b  d2, Parallax_Prev_Sec_X             // (Parallax_Prev_Sec_X).w
        move.b  d3, Parallax_Prev_Sec_Y             // (Parallax_Prev_Sec_Y).w

        // -- the per-section effect consumer (effects P3) --
        // This is the ONE place the engine notices "the camera entered a new
        // section", so the per-section effect consumer hangs here beside the
        // parallax one rather than duplicating the crossing detection. Every
        // section sets sec_effects (Task 12 converted the last OJZ act), so
        // TOTAL BINDING is the only path left: Effects_InstallPreset writes
        // every channel (palette, cycle, variants, raster) itself and returns
        // the resolved parallax config in a0. The legacy per-field "NULL means
        // keep whatever the previous section had" installers (Palette_LoadSection,
        // Palette_InstallCycleSection, Raster_InstallSection) are deleted —
        // effects-P3-C2 Task 13; a0 = Sec* with sec_effects == 0 reaching here
        // is a content bug, not a runtime state to degrade gracefully into.
    if DEBUG == 1 {
        tst.l   Sec.sec_effects(a0)                  // (Sec.sec_effects)(a0)
        bne     .have_preset
        raise_error "Parallax_CheckBoundary: section with sec_effects == 0 (the legacy per-field path was removed, effects-P3-C2 Task 13)"
    .have_preset:
    }
        jbsr    Effects_InstallPreset                // a0 = Sec* in, a0 = resolved parallax config out
        jbra    Parallax_StartTransition             // snap/lerp + mode shadow; no-op if unchanged
    .no_crossing:
        rts
}

// ----------------------------------------------------------------------
// Parallax_StartTransition — handle parallax_config change at section boundary
//
// Transition mode is picked from the NEW config's pcfg_transition byte:
//   0 (default) = smooth: stage as Target_Config, set frame counter to
//                 PARALLAX_TRANS_DEFAULT, leave Current_Config alone.
//                 Parallax_Update uses Target_Config to compute band
//                 targets while the per-band scroll lerp (>>PARALLAX_LERP_SHIFT)
//                 naturally eases current toward those values. When the
//                 counter hits 0, Current = Target (handled in Update).
//   1           = instant: swap Current_Config immediately.
//
// In either branch the VDP $0B (Mode Set 3) shadow updates to the NEW
// config's mode bits — the buffer is built from the new config from this
// frame onward, so the register must match for correct rendering.
//
// In:  a0 = new parallax_config* (NULL = inherit, no-op)
// Out: transition state set up; mode_set_3 shadow updated.
// Clobbers: d0, d1
// ----------------------------------------------------------------------
pub proc Parallax_StartTransition () clobbers(d0-d1) {
        cmpa.w  #0, a0
        beq     .no_change                          // null → inherit, no-op
        cmpa.l  Parallax_Current_Config, a0         // (Parallax_Current_Config).w
        beq     .recross_current                    // matches current → cancel a staged transition, else no-op
        cmpa.l  Parallax_Target_Config, a0          // (Parallax_Target_Config).w
        beq     .no_change                          // already transitioning to this → no-op

        // -- pick transition mode from the new config's pcfg_transition flag --
        // CAP_TRANSITIONS span (P2 §3.3). A game whose registry holds one scene never
        // crosses a scene edge, so nothing can ever STAGE a smooth transition. The whole
        // staging arm is the elidable region and `.instant` is its structural
        // fallthrough — eliding it makes every install instant, which is what a
        // single-scene game already gets.
    if (Game.SCANLINE_CAPS & CAP_TRANSITIONS) != 0 {
    .cap_transitions_stage_begin:
        tst.b   parallax_config.pcfg_transition(a0)
        bne     .instant

        // -- smooth: stage target, leave current_config intact --
        move.l  a0, Parallax_Target_Config          // (Parallax_Target_Config).w
        move.b  #PARALLAX_TRANS_DEFAULT, Parallax_Transition_Frames  // (Parallax_Transition_Frames).w
        jbra    .update_mode
    .cap_transitions_stage_end:
    }

    .instant:
        // -- instant: swap current immediately, clear target, AND snap
        //    band scroll values to the new config's targets (otherwise they
        //    would still lerp toward the new targets over PARALLAX_LERP_SHIFT
        //    frames, defeating the "instant" semantic). --
        move.l  a0, Parallax_Current_Config         // (Parallax_Current_Config).w
        move.l  #0, Parallax_Target_Config          // (Parallax_Target_Config).w
        move.b  #0, Parallax_Transition_Frames      // (Parallax_Transition_Frames).w
        move.b  #1, Parallax_Snap_Pending           // (Parallax_Snap_Pending).w

    .update_mode:
        // --- VDP reg $0B Mode Set 3 update from the NEW config ---
        //   bits 1:0 = HScroll mode: %11 per-line, ALWAYS. One table layout, one
        //              hardware mode (d-29-corrected, 2026-08-26): the per-cell (%10)
        //              arm this used to derive from the two header table words is gone
        //              with the per-cell fill and its 112-byte DMA.
        //   bit 2    = VScroll mode: 0 whole-plane, 1 per-column (still per config)
        moveq   #%11, d0                            // per-line HScroll
        // CAP_PER_COL_VSRAM span (P2 §3.3) — the register half. Bit 2 goes up for exactly
        // the configs that attach a column table, which is an AUTHORING property of the
        // installed scene and not a fact this file may pin: a census of what the game
        // currently authors goes stale on the same clock as the scenes. (One stood here
        // until 2026-08-28 claiming bit 2 was never set and the test dead, while six
        // registry scenes attached a table and this branch ran.) Falls through to
        // `.v_done`, which is where the `beq` went anyway.
    if (Game.SCANLINE_CAPS & CAP_PER_COL_VSRAM) != 0 {
    .cap_per_col_vsram_mode_begin:
        move.l  parallax_config.pcfg_v_deform_table_bg(a0), d1
        beq     .v_done
        ori.b   #%100, d0                           // bit 2 = per-column V
    .cap_per_col_vsram_mode_end:
    }
    .v_done:
        // Shadow write-through only: the shadow IS the register's authority, and
        // Flush_VDP_Shadow re-blits all of $00-$12 unconditionally next VBlank.
        // The Set_VDP_Reg helper now EXISTS (engine/system/vdp_init.emp) and is
        // what §3.1 rule 5 mandates for a write like this; what is outstanding is
        // ADOPTION, here and at the seven other inline shadow-write sites. Left
        // inline deliberately: converting them moves bytes and belongs in its own
        // parcel, not as a rider on the one that added the helper.
        move.b  d0, VDP_Shadow_Table + VDP_MODE3_OFF   // (VDP_Shadow_Table+VDP_Shadow_vdp_mode3).w

    .no_change:
        rts

    .recross_current:
        // Re-crossed into the CURRENT config's own section. If a transition to a
        // different config is staged (mid-lerp), CANCEL it: clear the stage, snap
        // the band scrolls back to current, and restore current's mode (active
        // config reverts to current the instant frames→0, so every mode/length/
        // stride consumer follows it back). With nothing staged this is the
        // genuine no-op (already settled on this config).
        tst.b   Parallax_Transition_Frames          // (Parallax_Transition_Frames).w
        beq     .no_change
        move.l  #0, Parallax_Target_Config          // (Parallax_Target_Config).w
        move.b  #0, Parallax_Transition_Frames      // (Parallax_Transition_Frames).w
        move.b  #1, Parallax_Snap_Pending           // (Parallax_Snap_Pending).w — snap bands back to current
        jbra    .update_mode                        // a0 == current → restore current's mode bits
}

// ----------------------------------------------------------------------
// Parallax_Active_Config — the transition state machine's single "active config"
// selector. During a smooth transition (Transition_Frames > 0) the NEW (Target)
// config is active for ALL structural decisions — render mode, HScroll DMA
// length, VSRAM stride, band layout; only Plane B scroll lerps toward it. Every
// mode/format/length consumer routes through here so they never disagree
// mid-transition (the band builder, the fill format, and the mode-set-3 register
// already commit to Target from frame 0; this accessor is the one they share).
//
// For a shipped (mode-equal) config pair Active and Current select the same mode,
// so shipped rendering is unchanged.
//
// In:  none
// Out: d0 = active parallax_config* (0 = inert); Z reflects d0 — declared as
//      the `zero: inert` flag result so callers' beq-after-call reliance is
//      contract, not header prose (demanding sites: Vscroll_Write's and
//      Enqueue_Dirty_Buffers' NULL-config dispatch). d0 is the returned
//      result, so it rides out(), not clobbers().
// ----------------------------------------------------------------------
pub proc Parallax_Active_Config () clobbers() out(d0, zero: inert) {
        // CAP_TRANSITIONS span (P2 §3.3). Parallax_Target_Config is written ONLY by
        // StartTransition's staging arm, so with that arm elided the target is
        // permanently NULL and Transition_Frames permanently 0, and this selector
        // collapses to "return Current_Config".
    if (Game.SCANLINE_CAPS & CAP_TRANSITIONS) != 0 {
    .cap_transitions_select_begin:
        tst.b   Parallax_Transition_Frames          // (Parallax_Transition_Frames).w
        bne     .use_target
        move.l  Parallax_Current_Config, d0         // (Parallax_Current_Config).w — Z from d0
        rts
    .use_target:
        move.l  Parallax_Target_Config, d0          // (Parallax_Target_Config).w — Z from d0
        rts
    .cap_transitions_select_end:
    } else {
        // The collapse, not a second implementation. `zero: inert` still holds — Z comes
        // from the same move.l.
        move.l  Parallax_Current_Config, d0         // (Parallax_Current_Config).w — Z from d0
        rts
    }
}

// ----------------------------------------------------------------------
// Vscroll_Write — emit Vscroll_Factor (whole-plane) or column buf (per-column)
// Whole-plane Vscroll_Factor, or the 20-longword per-column buffer when the
// config's v_deform_table_bg is set.
//
// Caller (the VBlank handler) must keep the Z80 off the 68k bus across this —
// via stopZ80 (sound-off build) OR the SND_CTRL_DMA_ACTIVE flag bracket (sound
// build, where the Z80 is deliberately not halted). VDP writes happen here, and
// they inherit the ambient autoincrement (reg $0F must be 2 for the per-column
// VSRAM stride — the drain path leaves it $02, and on BOTH VBlank paths
// Flush_VDP_Shadow has already re-blitted reg $0F from its shadow byte ($02,
// writerless since boot) earlier in the same handler, so $02 holds here by
// construction rather than by every $8F80 excursion restoring itself).
//
// In:  none (reads Parallax_Active_Config, Vscroll_Factor)
// Out: VSRAM written
// Clobbers: d0, a0, a5
//
// HARDWARE QUIRK (per-column branch): the VDP's per-column V-scroll grain
// is 16 px (one VSRAM entry per column-pair). When a plane has non-zero
// HScroll AND per-column V-scroll is on, that plane's leftmost partial
// column (the screen sliver before its HScroll's first 16-px boundary)
// renders at V-scroll = 0 regardless of VSRAM[0]. There is no register to
// fix this — it's silicon. IT IS PER PLANE: the mode bit is one bit for the
// screen, but each plane has its own HScroll word, so plane A suffers it
// independently of plane B and a locked B says nothing about A (this is
// what the FOREGROUND strip on the six per-column scenes is — see
// docs/research/2026-08-28-deform-scene-left-edge-triage.md).
// Mitigations: (a) sprite mask the leftmost strip (SpriteMask — declaration
// exists, engine emission still pending, see DEFERRED_WORK.md "Sprite mask
// for per-column V-scroll"), (b) lock BOTH planes' HScroll to 0 (factor_a
// and factor_b = FACTOR_0, no plane-B factor curve, AND no live deform on
// either plane — deform re-adds per-line HScroll on top of a locked
// factor), or (c) live with it. SINCE P3 TASK 12 THE CHOICE IS AUTHORED,
// NOT IMPLIED: any scene attaching a per-column V-deform table must declare
// `left_column_mask:` (SceneLeftColMask in engine/level/scene_dsl.emp —
// Factor0Lock is VERIFIED against every condition in (b), Accept is (c)
// spelled out, SpriteMask is refused until its emission lands) and the
// build fails an undeclared one.
// ----------------------------------------------------------------------
pub proc Vscroll_Write () clobbers(d0/a0/a5) requires(vblank) {
        lea     VDP_CTRL, a5                        // (VDP_CTRL).l
        move.l  #vdp_comm(0, VdpTarget.Vsram, VdpOp.Write), (a5)

        // per-column or whole-plane? — key off the ACTIVE config (Target during
        // a transition) so the VSRAM stride matches the mode the register + fill
        // committed to at frame 0 (transition mode-contract).
        jbsr    Parallax_Active_Config              // d0 = active config; Z reflects d0
        beq     .whole_plane
        // CAP_PER_COL_VSRAM span (P2 §3.3). The emitter runs for exactly the configs whose
        // pcfg_v_deform_table_bg is non-NULL; which configs those are is an authoring
        // question this file must not answer for the reason the register half above gives.
        // (The claim that stood here until 2026-08-28 — no scene attaches one, the emitter
        // is unreachable — was wrong on both halves, and it was the first thing a reader
        // chasing the left-edge strip met.) `.whole_plane` is the structural fallthrough.
    if (Game.SCANLINE_CAPS & CAP_PER_COL_VSRAM) != 0 {
    .cap_per_col_vsram_emit_begin:
        movea.l d0, a0
        move.l  parallax_config.pcfg_v_deform_table_bg(a0), d0
        beq     .whole_plane

        // per-column: emit 20 longwords from column buffer to VSRAM
        lea     Parallax_Vscroll_Column_Buf, a0     // (Parallax_Vscroll_Column_Buf).w
        move.l  (a0)+, VDP_DATA_OFF(a5)             // rept 20 (VDP_DATA-VDP_CTRL)(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        move.l  (a0)+, VDP_DATA_OFF(a5)
        rts
    .cap_per_col_vsram_emit_end:
    }

    .whole_plane:
        move.l  (Vscroll_Factor).w, VDP_DATA_OFF(a5)  // explicit .w: the relaxable-abs + trailing-(d16,An) form has no bare lowering yet (gap-ledger successor to the pinned abs-sym feature) — must pin the width
        rts
}

// ----------------------------------------------------------------------
// Parallax_Update — per-frame parallax buffer build
//
// Reads:  Camera_X, Parallax_Current_Config, Parallax_Current_Scroll_A/B
// Writes: Parallax_Current_Scroll_A/B (lerp toward target),
//         Hscroll_Buffer (224 longwords, one per scanline)
//
// Per-frame cost scales with band count; the per-line deform fill
// (Parallax_Fill_PerLine) is the hot path (§4.6 perf charter).
//
// In:  none
// Out: none
// Clobbers: d0-d7, a0-a4
// (a5/a6 also clobbered via the Step5/Step4 tail-branch pipeline — see the
// contract-audit note; declared here so the closure check covers the tail.)
// ----------------------------------------------------------------------
pub proc Parallax_Update () clobbers(d0-d7/a0-a6) preserves(sr.mask) {
        // --- Step 1: select active config for this frame ---
        // During a smooth transition (Parallax_Transition_Frames > 0) drive
        // band targets from Target_Config; the per-band scroll lerp eases
        // current_scroll values toward those across PARALLAX_TRANS_DEFAULT
        // frames. When the counter hits 0, promote target → current and
        // clear target. Outside transitions, use Current_Config as before.
        tst.b   Parallax_Transition_Frames          // (Parallax_Transition_Frames).w
        beq     .use_current
        subq.b  #1, Parallax_Transition_Frames
        bne     .use_target
        // counter just hit 0 → promote target into current, clear target.
        // The d0→Current move is LAST so .config_resolved reads Z from d0:
        // every path into .config_resolved leaves the active config in d0 with
        // Z reflecting it, so `beq .no_config` fires only for a genuine null.
        move.l  Parallax_Target_Config, d0          // (Parallax_Target_Config).w
        move.l  #0, Parallax_Target_Config
        move.l  d0, Parallax_Current_Config         // (Parallax_Current_Config).w
        jbra    .config_resolved
    .use_target:
        move.l  Parallax_Target_Config, d0
        jbra    .config_resolved
    .use_current:
        move.l  Parallax_Current_Config, d0
    .config_resolved:
        // 0 = inert (no parallax config active)
        beq     .no_config
        movea.l d0, a0

        // --- per-frame VDP reg $0B (Mode Set 3) assertion from the active config ---
        // The register must match the mode the HScroll/VSRAM buffers are built from
        // THIS frame, and the buffers below build from this same active config.
        // Parallax_StartTransition writes the mode only on a section-boundary
        // crossing (edge-triggered, same-config short-circuit), so without a
        // per-frame re-assert the register goes stale whenever the active config
        // differs from what the last crossing left (a mid-transition frame, where
        // the active config is Target). Re-deriving here — the one per-frame site
        // that already holds the resolved active config in a0 — keeps the register
        // in lockstep with the buffers every frame. Inert while every act section
        // shares one mode (the derived value is unchanging); load-bearing when they
        // do not. The null-config case takes the .no_config early-out above and
        // asserts nothing (parallax is off, so the mode is don't-care).
        //   bits 1:0 = HScroll mode: %11 per-line, ALWAYS (d-29-corrected, 2026-08-26 —
        //              the per-cell arm keyed off the header table words is deleted).
        //              The per-frame re-assert still earns its place for BIT 2, which is
        //              per config.
        //   bit 2    = VScroll mode: 0 whole-plane, 1 per-column
        moveq   #%11, d0                            // per-line HScroll
        move.l  parallax_config.pcfg_v_deform_table_bg(a0), d1
        beq     .mode3_shadow
        ori.b   #%100, d0                           // bit 2 = per-column V-scroll
    .mode3_shadow:
        // Read the previous mode BEFORE overwriting the shadow: it is the record
        // of what this routine last drove onto reg $0B directly, and the shadow
        // flush keeps the register at that value in between. So shadow == d0
        // means the hardware register ALREADY holds d0 and the direct write
        // below would be a no-op — skip it and its bus hold. This is the ≥99%
        // case (every frame whose active config keeps the same mode); the write
        // is only load-bearing on the frame the mode actually changes.
        // Sole writer of reg $0B / this shadow byte is this site (grep-verified),
        // which is what makes the shadow a sound record of the register.
        move.b  VDP_Shadow_Table + VDP_MODE3_OFF, d1   // previous mode
        move.b  d0, VDP_Shadow_Table + VDP_MODE3_OFF   // (VDP_Shadow_Table+VDP_Shadow_vdp_mode3).w
        cmp.b   d1, d0
        beq     .mode3_reg_live                        // unchanged — register already correct
        // Also drive reg $0B on the hardware directly (not only the shadow): the
        // shadow→register flush is a VBlank step, and a config's mode must be live
        // for the frame it becomes active, not one VBlank later. Read VDP_CTRL
        // first to reset the command state machine — a half-finished 32-bit address
        // command from upstream (e.g. Section_UpdateColumns) would otherwise consume
        // this $8B?? word as its second longword, corrupting the VDP and leaving
        // reg $0B unchanged. $8B?? has bit 15 set, so it is an atomic single-word
        // register write regardless of any VBlank that lands mid-wrap.
        andi.w  #$00FF, d0
        ori.w   #$8B00, d0                          // d0 = $8B?? = "set reg $0B = ??"
        // Mask IRQs across the whole bus hold. This is the tree's one atomic Z80
        // hold that must also stay masked: an IRQ6 landing mid-bracket runs
        // VBlank's own bus bracket and returns with the bus RELEASED, so the
        // pending $8B?? write would then land with the Z80 live on its bank
        // window (bus-latch corruption). The SR mask keeps the state-machine-reset
        // read and the register write atomic against VBlank's own Z80 hold.
        with ints_off {
            with z80_stopped {
                move.w  VDP_CTRL, d1                // (VDP_CTRL).l — reset command state machine
                move.w  d0, VDP_CTRL                // (VDP_CTRL).l
            }
        }
    .mode3_reg_live:

        moveq   #0, d7
        move.b  parallax_config.pcfg_band_count(a0), d7
        beq     .no_config

        // -- camera X (signed pixel high word) --
        move.l  Camera_X, d0                        // (Camera_X).w
        swap    d0                                  // d0.w = camX

        // -- compute target band scrolls and lerp current_scroll_a/b --
        lea     sizeof(parallax_config)(a0), a1     // a1 = first band_entry
        lea     Parallax_Current_Scroll_A, a2       // (Parallax_Current_Scroll_A).w
        lea     Parallax_Current_Scroll_B, a3       // (Parallax_Current_Scroll_B).w

        // BAND DRIFT — the accumulator cursor. a4 IS FREE HERE and that is checked, not
        // assumed: this proc uses a0 (config), a1 (ROM band record), a2/a3 (the two
        // current-scroll cursors) and nothing else above a3 until the `jbra
        // Parallax_Step5_Vscroll` tail. Decode_Factor_A/_B declare clobbers(d1-d2)
        // preserves(d3), so no address register crosses them either. Parallax_Update
        // already declares clobbers(d0-d7/a0-a6), so no proc contract moves for this.
        if (Game.SCANLINE_CAPS & CAP_BAND_DRIFT) != 0 {
        .cap_band_drift_setup_begin:
                lea     Parallax_Drift_Acc, a4      // (Parallax_Drift_Acc).w
        .cap_band_drift_setup_end:
        }

        // THE LOAD IS A `move.w` AND THAT IS THE WHOLE POINT OF THE 2026-08-27 RAISE.
        // `btst d5, d6` already reaches bits 0..15 (it is a register-to-register bit test,
        // modulo 32), so the ONLY thing that made bands 8..15 dead at MAX_PARALLAX_BANDS = 8
        // was this load being a `move.b`: bits 8..15 of d6 were structurally zero, every
        // such band took `.band_disabled`, and it inherited the band above it. Green build,
        // silently wrong picture. Same 12 cycles either way — a widened mask costs nothing
        // per frame. `moveq #0, d6` still clears the upper word, which the btst needs.
        moveq   #0, d6
        move.w  parallax_config.pcfg_layer_mask(a0), d6            // d6 = layer mask (16 bands)
        moveq   #0, d5                              // d5 = band index
        move.w  d0, d3                              // d3 = previous-band current_a seed = -camX:
        neg.w   d3                                  //   a disabled band 0 must still hard-lock the
                                                    //   FG to the camera (streaming window — see
                                                    //   plane-wrap comment below); only the BG may
                                                    //   inherit the locked/previous value
        moveq   #0, d4                              // d4 = previous-band current_b

        // Plane A (factor_a) is HARD-LOCKED to its factor-derived target —
        // never lerped. The FG streaming engine draws columns in a
        // camera-anchored 64-col window, so any FG scroll offset from the
        // camera drags the plane-wrap seam into view at the screen edge
        // (an always-on lerp trailed the camera by ~15 × velocity; even a
        // 16-frame transition lerp drifts ~240 px at 16 px/frame and then
        // visibly snaps). Transition smoothing is a plane B effect.
        //
        // Plane B (factor_b) lerps ONLY during an active section
        // transition (Transition_Frames > 0) — easing between the two
        // configs' BG factors. Outside transitions it locks to target.
        // Parallax_Snap_Pending forces the snap path when the camera jumps
        // (no smooth lerp can catch up).

    .band_loop:
        btst    d5, d6
        beq     .band_disabled

        // -- factor_a: hard-locked, current_a = target every frame --
        jbsr    Decode_Factor_A                     // out: d2 = -decode(camX, factor_a)
        move.w  d2, (a2)
        move.w  d2, d3                              // remember for inheritance

        // -- factor_b: lerp during transition, else lock --
        jbsr    Decode_Factor_B                     // out: d2 = -decode(camX, factor_b)

        // BAND DRIFT — advance this band's 16.16 accumulator and fold its PIXEL part into
        // the plane-B TARGET, before the snap/lerp.
        //
        // BEFORE the lerp and not after, deliberately. Outside a transition `.snap_b` writes
        // the target straight through, so drift appears at full value every frame; inside one
        // the lerp's step is recomputed every frame against a target that now moves by `rate`,
        // and the ramp still converges (at frames_remaining == 1 the step is the whole
        // residual against THAT frame's target). Folding it in after the lerp is arguably
        // cleaner semantically but it is a behaviour change nobody asked for AND it forces the
        // accumulate into Step 4a's copy loop — the loop that is the band-count scaling risk.
        //
        // NO PER-BAND `tst` ON THE RATE. A zero rate costs 48 cycles; testing for it costs
        // ~30 to save ~40 and adds a data-dependent branch. band_ext's gated block takes the
        // same position for the same reason: unconditional under the capability keeps the
        // cost a clean per-band constant for the walker's fitted model instead of a
        // content-dependent one.
        //
        // THE ENABLED ARM ONLY. A disabled band inherits the band above's scroll words and
        // emits nothing of its own, so accumulating for it would be spending cycles on a
        // value nothing reads. Its accumulator slot is still STEPPED at `.band_done`, on both
        // arms, so slot index never desyncs from band index. Layer masks are comptime per
        // config, so a band cannot toggle at runtime and there is no resume discontinuity.
        //
        // d1 IS THE RIGHT SCRATCH: it is dead between Decode_Factor_B's return and the lerp's
        // `move.w (a3), d1` below. A memory-to-memory add does not exist on the 68000, so the
        // rate must land in a data register on its way to the accumulator.
        //
        // `add.w (a4), d2` READS THE HIGH WORD, which is the whole reason the accumulator is
        // laid out [pixels:i16][fraction:u16] with the pixels HIGH: on a big-endian 68000 the
        // first word of the long IS the pixel part, so the extraction is a word read and not
        // a shift. The wrap is seamless for the same layout: the pixel part wraps mod 65536,
        // Plane B is 512 px wide at reg $10 = $11, and 65536 = 128 x 512 exactly, so the wrap
        // is a whole number of plane widths. A 16-bit 8.8 accumulator would wrap its pixel
        // part at 256, and 256 mod 512 != 0 — a visible snap every ~43 s at 6 px/frame.
        if (Game.SCANLINE_CAPS & CAP_BAND_DRIFT) != 0 {
        .cap_band_drift_accum_begin:
                move.l  band_drift_rate(a1), d1     // ROM rate, 16.16 px/frame
                add.l   d1, (a4)                    // acc += rate
                add.w   (a4), d2                    // target_b += acc's PIXEL part (high word)
        .cap_band_drift_accum_end:
        }

        tst.b   Parallax_Snap_Pending               // (Parallax_Snap_Pending).w
        bne     .snap_b
        tst.b   Parallax_Transition_Frames          // (Parallax_Transition_Frames).w
        beq     .snap_b                             // no transition — lock to target
        // frames-remaining ramp: step = (target − current) / frames_remaining,
        // so the BG scroll converges EXACTLY by the last window frame
        // (frames_remaining reaches 1 → step = the whole residual). The promote
        // frame's .snap_b is then a no-op (current already equals target) — no
        // end-of-transition pop. d4 is dead here (it is rewritten with current_b
        // at .write_b), so it carries the divisor.
        // Divisor invariant: the divide path is reached only past the
        // `tst.b Transition_Frames / beq .snap_b` above, so frames_remaining is
        // 1..PARALLAX_TRANS_DEFAULT here — never 0. Divide-by-zero is structurally
        // unreachable. The gap is ext.l'd to a 32-bit dividend; |quotient| =
        // |gap|/frames_remaining ≤ |gap| ≤ $7FFF fits a word, so divs never
        // overflows.
        move.w  (a3), d1                            // d1 = current_b
        sub.w   d1, d2                              // d2.w = target − current (gap)
        ext.l   d2                                  // sign-extend gap → 32-bit dividend
        moveq   #0, d4
        move.b  Parallax_Transition_Frames, d4     // (Parallax_Transition_Frames).w — frames_remaining 1..15
        divs.w  d4, d2                              // d2.w = gap / frames_remaining = ramp step
        add.w   d2, d1                              // d1 = current + step
        jbra    .write_b
    .snap_b:
        move.w  d2, d1                              // snap: current_b = target
    .write_b:
        move.w  d1, (a3)
        move.w  d1, d4
        jbra    .band_done

    .band_disabled:
        // inherit previous-band scroll
        move.w  d3, (a2)
        move.w  d4, (a3)

    .band_done:
        adda.l  #sizeof(band_record), a1
        addq.l  #2, a2
        addq.l  #2, a3
        // BAND DRIFT — step the accumulator cursor. ON BOTH ARMS (this label is where
        // `.band_disabled` joins), because the array is indexed by BAND index and a disabled
        // band still owns its slot. Skipping it here would shift every subsequent band's
        // accumulator by one and hand a drifting layer the phase of a different one.
        if (Game.SCANLINE_CAPS & CAP_BAND_DRIFT) != 0 {
        .cap_band_drift_step_begin:
                addq.l  #4, a4
        .cap_band_drift_step_end:
        }
        addq.w  #1, d5
        cmp.w   d7, d5
        blo     .band_loop

        // clear Snap_Pending flag — one-shot, consumed by this Update
        clr.b   Parallax_Snap_Pending               // (Parallax_Snap_Pending).w

        // NOTE: Step 5 (Vscroll) runs BEFORE Step 4 (HScroll fill) — the
        // band rotation in Step 4a needs this frame's Vscroll_BG.
        jbra    Parallax_Step5_Vscroll
    .no_config:
        rts
}

proc Parallax_Step4_Fill () clobbers(d0-d7/a0-a6) {

        // --- Step 4a: WORLD-Y RE-GLUE — rotate plane-space band tops into screen space ---
        //
        // Band tops reach ROM as PLANE LINES 0..511 (`band_top_plane`). The author writes
        // an ACT-space world Y and scene_band() maps it through the scene's own vertical
        // mapping at COMPTIME — see engine/level/scene_dsl.emp's `scene_plane_line()`,
        // which owns that half. This routine owns the other half: plane line -> screen
        // line, every frame, against the CURRENT Vscroll_BG.
        //
        // THE RE-GLUE, IN ONE LINE: the rotation now works in PLANE LINES, not cells.
        // It used to be `vshift = (Vscroll_BG mod 512) >> 3` and `screen_cell = top_cell -
        // vshift`, which threw away `Vscroll_BG & 7` — so a band top only ever landed on
        // an 8-px cell edge and JUMPED a whole cell while the art under it moved a line at
        // a time. That discarded remainder is exactly the "partial offset" S.C.E.'s
        // deformation walker carries out of its band-height subtraction, and dropping it is
        // the classic one-line-off port defect. Keeping it costs one fewer shift.
        //
        // At Vscroll_BG = 0 the rotation is still an identity copy plus the clamp, so
        // vertically-locked configs (v_factor_bg = 15, v_offset = 0) are unchanged.
        // The shadow view is built EVERY frame, even then: the clamp below is load-bearing
        // — a raw plane-space top (e.g. 320, 384) would make the per-line filler emit more
        // than 224 lines and spray past Hscroll_Buffer into the DMA queues (frozen-VDP
        // crash class).
        //
        // WHY THE SEARCH STAYS A SEARCH. Thunder Force IV was checked for the arithmetic
        // alternative and does not supply one: its bands are SCREEN-anchored (64 per-band
        // accumulators at $FFFF9718, cleared once at init, each builder emitting a fixed
        // unrolled run per band), so band k owns the same scanlines forever and the seek
        // never exists. The even-spacing collapse — `band = vs >> log2(spacing)`, `partial
        // = vs & (spacing-1)` — IS available in principle and is not taken, because ours
        // are authored and are not evenly spaced (OJZ_Default: 0/64/320/384, gaps 64, 256,
        // 64, 128). A fast path selected by a comptime predicate NO shipped scene satisfies
        // is a specialisation with no subject. The search is at most 7 word compares once
        // per frame; see docs/benchmarks/scanline-p3/REGLUE.md.
        move.w  Parallax_Current_Vscroll_BG, d0     // (Parallax_Current_Vscroll_BG).w
        and.w   #PLANE_B_SPAN-1, d0         // d0 = vs, the plane LINE at the screen top
        // -- find k = the band containing plane line vs --
        // (last band whose top <= vs; tops ascend and band 0 top is 0)
        lea     sizeof(parallax_config)(a0), a1
        lea     sizeof(band_record)(a1), a4  // probe = band[1]
        moveq   #0, d1                      // d1 = k
        moveq   #1, d2                      // probe index
    .find_k:
        cmp.w   d7, d2
        bhs     .found_k
        move.w  band_entry.band_top_plane(a4), d3   // 0..511, no zero-extend needed
        cmp.w   d0, d3
        bhi     .found_k                    // top > vs — stop
        move.w  d2, d1
        adda.w  #sizeof(band_record), a4
        addq.w  #1, d2
        jbra    .find_k
    .found_k:
        // -- copy all bands starting at k (wrapping) into the shadow view,
        //    rebasing tops to screen lines and reordering the scroll words --
        lea     Parallax_Shadow_Bands, a4           // (Parallax_Shadow_Bands).w
        lea     Parallax_Shadow_Scroll_A, a5        // (Parallax_Shadow_Scroll_A).w
        lea     Parallax_Shadow_Scroll_B, a6        // (Parallax_Shadow_Scroll_B).w
        move.w  d7, d6
        subq.w  #1, d6                      // dbf counter
        move.w  d1, d2                      // d2 = source band index (starts at k)
        moveq   #0, d4                      // first-entry flag
    .copy_band:
        move.w  d2, d3
        mul_const.w d3, #sizeof(band_record), d5  // d3 = d2 × sizeof(band_record); d5 trashed
        lea     sizeof(parallax_config)(a0), a1
        adda.w  d3, a1
        copy_band_entry_fwd(a1, a4)
        // rebase the copied entry's top: PLANE LINES -> SCREEN LINES
        move.w  -sizeof(band_record)(a4), d3
        sub.w   d0, d3
        tst.w   d4
        bne     .not_first
        moveq   #0, d3                      // band k starts at the screen top
        moveq   #1, d4
        jbra    .write_top
    .not_first:
        tst.w   d3
        bgt     .clamp_top
        addi.w  #PLANE_B_SPAN, d3           // wrapped past the plane bottom
    .clamp_top:
        cmpi.w  #SCREEN_HEIGHT, d3
        ble     .write_top
        move.w  #SCREEN_HEIGHT, d3          // off-screen — zero-length fill
    .write_top:
        // CLAMP AND STORE BOTH IN LINES. The clamp is what stops the per-line filler
        // emitting more than 224 lines and spraying past Hscroll_Buffer (:618-622).
        // Before re-glue this was a 28-CELL clamp followed by a `lsl.w #3`; the unit
        // conversion is gone because there is no longer a unit to convert — nothing in
        // this pipeline counts cells any more (the per-cell filler, the last thing that
        // did, was deleted 2026-08-26).
        move.w  d3, -sizeof(band_record)(a4)
        // reorder the matching scroll words
        move.w  d2, d3
        add.w   d3, d3
        lea     Parallax_Current_Scroll_A, a1       // (Parallax_Current_Scroll_A).w
        move.w  (a1,d3.w), (a5)+
        lea     Parallax_Current_Scroll_B, a1       // (Parallax_Current_Scroll_B).w
        move.w  (a1,d3.w), (a6)+
        addq.w  #1, d2
        cmp.w   d7, d2
        blo     .no_wrap
        moveq   #0, d2
    .no_wrap:
        dbf     d6, .copy_band

        // ============ THE CURVE HOIST (P3 Task 10, design section 2 / 4.1) ============
        //
        // ONCE PER FRAME PER CURVE LAYER, and this is the whole of a curve's arithmetic:
        // the far-end factor is decoded against this frame's camX, the SPREAD between the
        // two ends is divided by the layer's line span, and the quotient/remainder pair is
        // parked in the band's own curve tail for the fill's per-line accumulator. The line
        // loop then does two adds and a conditional correction — no divide, no multiply,
        // and no factor decode per line, which is what design section 2 rules ("computed
        // once per frame per curve layer in the band hoist ... never in the line loop,
        // never a multiply").
        //
        // WHY IT SITS HERE — AFTER STEP 4a'S COPY, BEFORE STEP 4b'S SPLIT — AND NOT IN THE
        // FILL'S OWN PER-BAND HOIST, WHICH IS WHERE IT WOULD BE CHEAPEST TO WRITE. The
        // divisor must be the LAYER's span. Step 4b splits a band in two at the anchored
        // line, and by the time the fill walks the shadow view a split layer is two entries
        // whose spans sum to the layer's. Dividing by either half would make the ramp twice
        // as steep on both sides of the boundary — the split RE-PARAMETRISING the curve,
        // which is exactly what design section 2 forbids ("an anchor split inside a curve
        // layer CONTINUES the curve"). Computed here, the step is the layer's, Step 4b's
        // whole-entry copy hands it to the split unchanged, and the split's accumulator
        // picks up where its parent left off (CURVE_FLAG_CONT_BIT).
        //
        // WHY BRESENHAM AND NOT A FIXED-POINT STEP. A ramp of 300 px over 100 lines is 3 px
        // a line; a ramp of 30 px over 100 lines is a THIRD of a pixel a line, and a whole
        // integer step would round it to zero and emit no ramp at all. The obvious fix — an
        // 8.8 step, `(spread << 8) / span` — cannot be BOUNDED: at span 1 it needs
        // |spread| <= 127 to keep the quotient inside a word, and spread is a camera-scaled
        // quantity with no such bound. Carrying the exact remainder costs one compare and
        // one conditional add per line and is exact at every span. See the divisor argument
        // at the divide itself.
        //
        // COST: this loop runs over EVERY shadow band and pays one `btst` for the bands
        // that are not curves. A frame with no curve layer at all still walks it — the
        // capability gate is what removes it from a game that authors none, which is the
        // whole point of the bit.
    if (Game.SCANLINE_CAPS & CAP_FACTOR_CURVE) != 0 {
    .cap_factor_curve_hoist_begin:
        move.l  Camera_X, d0                        // (Camera_X).w
        swap    d0                                  // d0.w = camX (signed pixels)
        lea     Parallax_Shadow_Bands, a1           // (Parallax_Shadow_Bands).w
        lea     Parallax_Shadow_Scroll_B, a3        // (Parallax_Shadow_Scroll_B).w
        move.w  d7, d6
        subq.w  #1, d6                              // dbf count over the shadow view
        moveq   #1, d5                              // d5 = index of the NEXT band
    .curve_band:
        btst    #CURVE_FLAG_ACTIVE_BIT, band_curve_flags(a1)
        beq     .curve_next
        // -- the layer's line span: the next band's top, or 224, less this band's --
        move.w  #SCREEN_HEIGHT, d4
        cmp.w   d7, d5
        bhs     .curve_have_end                     // last band: the screen bottom
        move.w  band_top_line_next(a1), d4
    .curve_have_end:
        sub.w   band_top_line(a1), d4               // d4 = span, in SCREEN LINES
        ble     .curve_next                         // <= 0: Step 4a clamped this layer off
                                                    //   the screen, so it emits no lines and
                                                    //   there is nothing to ramp across. THIS
                                                    //   TEST IS THE DIVISOR'S ZERO GUARD —
                                                    //   see the divide below.
        move.w  d4, band_curve_span(a1)
        // -- the far-end factor, decoded exactly as Decode_Factor_B decodes the base --
        // Spelled out rather than called: a `Decode_Factor_Curve` proc would emit a body
        // (and, gated, a stub) in every game, and the two extra registers this block has
        // spare are precisely what that proc's stack-borrowed scratch exists to avoid.
        moveq   #0, d1
        move.b  band_curve_to_s1(a1), d1
        cmpi.b  #15, d1
        beq     .curve_to_zero                      // s1 15 = whole-factor zero ("locked")
        move.w  d0, d2
        asr.w   d1, d2                              // first term = camX >> s1
        moveq   #0, d1
        move.b  band_curve_to_s2(a1), d1
        cmpi.b  #15, d1
        beq     .curve_to_negate                    // s2 15 = single-term factor
        move.w  d0, d3
        asr.w   d1, d3                              // second term = camX >> s2
        btst    #CURVE_FLAG_OP_BIT, band_curve_flags(a1)
        bne     .curve_to_sub
        add.w   d3, d2
        jbra    .curve_to_negate
    .curve_to_sub:
        sub.w   d3, d2
    .curve_to_negate:
        neg.w   d2                                  // HScroll words are negated offsets, so
        jbra    .curve_spread                       //   the far end matches the base's sign
    .curve_to_zero:
        moveq   #0, d2
    .curve_spread:
        sub.w   (a3), d2                            // d2 = spread = far_end - base_scroll
        // THE DIVISOR IS BOUNDED, ARGUED THE SAME WAY THE TRANSITION RAMP'S IS (the tree's
        // only other divs, in Parallax_Update's band loop):
        //   * NEVER ZERO, NEVER NEGATIVE, STRUCTURALLY. The divide is reached only past the
        //     `ble .curve_next` above, so d4 is >= 1 here. It is also <= 224: Step 4a clamps
        //     every shadow top into [0, SCREEN_HEIGHT] and this span is a difference of two
        //     such tops (or of 224 and one of them), so the divisor is 1..224 on every path.
        //     Divide-by-zero is unreachable by construction, not by likelihood — a zero-span
        //     band is a state Step 4a REACHES (two tops both clamped to 224), which is why
        //     the test is a real branch and not an assertion.
        //   * THE QUOTIENT CANNOT OVERFLOW. The dividend is a WORD spread sign-extended to
        //     32 bits, so |quotient| = |spread| / span <= |spread| <= $7FFF and fits the
        //     word divs.w must return. Widening the dividend — the 8.8 step this design
        //     rejected — is exactly what would break that argument.
        ext.l   d2                                  // sign-extend spread -> 32-bit dividend
        divs.w  d4, d2                              // d2.w = quotient, d2 high = remainder
        move.w  d2, d1                              // d1 = quotient, TRUNCATED toward zero
        swap    d2                                  // d2.w = remainder, signed like the
                                                    //   dividend (68000 divs semantics)
        tst.w   d2
        bge     .curve_rem_ok
        // NORMALISE TO A FLOOR. The line loop's correction is one-directional (`err >= span
        // -> err -= span, acc += 1`), which needs a remainder in [0, span). A negative spread
        // truncates toward zero, so shifting the remainder up by one span and the quotient
        // down by one turns the pair into the floor division the loop assumes — the same
        // value, re-expressed. Without it a downward ramp would accumulate its fraction in
        // the wrong direction and drift by up to one pixel per line.
        add.w   d4, d2                              // remainder -> [0, span)
        subq.w  #1, d1                              // ...and the quotient becomes the floor
    .curve_rem_ok:
        move.w  d1, band_curve_step(a1)
        move.w  d2, band_curve_rem(a1)
    .curve_next:
        adda.w  #sizeof(band_record), a1
        addq.l  #2, a3
        addq.w  #1, d5
        dbf     d6, .curve_band
    .cap_factor_curve_hoist_end:
    }

        lea     Parallax_Shadow_Bands, a1           // (Parallax_Shadow_Bands).w
        lea     Parallax_Shadow_Scroll_A, a2        // (Parallax_Shadow_Scroll_A).w
        lea     Parallax_Shadow_Scroll_B, a3        // (Parallax_Shadow_Scroll_B).w

        // ================= Step 4b: world-anchored deform overlay (Parcel W) =========
        // A palette boundary (raster patch channel) and a shimmer boundary (this) are
        // driven by ONE act-space anchor, Effects_World_Y[ch], and must land on the SAME
        // scanline. The band containing that line is SPLIT there, and every band from the
        // split down takes the config's anchored deform shifts.
        //
        // SPLIT-AND-OVERRIDE, NOT TRUNCATE-AND-APPEND. An earlier design made the anchored
        // region one terminal band owning the screen below the line; it was replaced because
        // it DISCARDED the plane bands underneath, flattening everything below a water
        // surface onto a single scroll factor — which contradicts the whole point of the
        // boundary being a level feature while the art keeps riding its own plane. Ristar
        // composes the two the same way this does (its surface is a predicate that ADDS to
        // the other plane's word, not a list entry); we pay the cost once per frame here
        // instead of once per scanline.
        //
        // WHAT IS NOT TOUCHED: the deform PHASE. The wave rides the art because the phase
        // base folds Camera_Y / Vscroll_BG (Harmony defect #2, further down this file). Band
        // TOP and wave PHASE are separate quantities in separate registers, which is exactly
        // why anchoring a boundary to the camera cannot re-open that defect.
        //
        // CAP_ANCHORS span (P2 §3.3) — the whole overlay. With no scene carrying an
        // `anchor_ch:`, pcfg_anchor_ch is PARALLAX_ANCHOR_NONE for every config the
        // game can install, so the first test below always takes `.bands_ready`, which
        // is exactly the structural fallthrough this span elides into.
    if (Game.SCANLINE_CAPS & CAP_ANCHORS) != 0 {
    .cap_anchors_overlay_begin:
        moveq   #0, d2
        move.b  parallax_config.pcfg_anchor_ch(a0), d2
        cmpi.w  #PARALLAX_ANCHOR_NONE, d2
        beq     .bands_ready                        // no overlay: byte-identical to before

        // L = the channel's screen line, LATCHED this frame by Effects_LatchWorldLines
        // (main loop, after Camera_Update, before this proc). May be negative, meaningfully.
        // Reading the latch rather than recomputing `anchor - Camera_Y` here is what keeps
        // this boundary and Raster_BuildSchedule's fire line on the SAME camera on a lag frame,
        // where VBlank runs twice against one main-loop update.
        move.w  d2, d0
        add.w   d0, d0                              // channel -> word index
        lea     Effects_Screen_L, a4                // (Effects_Screen_L).w
        move.w  (a4,d0.w), d0                       // d0 = L

        // OFF THE TOP OF THE SCREEN: split at line 0 and DO NOT CLAMP TO THE BAND.
        // The band clamp below is what keeps this boundary pinned to the palette boundary while
        // both are on screen — but the palette side answers L <= 0 with a frame-top ship that
        // covers the WHOLE screen, not with its clamped fire. Clamping here too would split the
        // bands at the band floor (screen line 3) while the palette went wet from line 0, so the
        // two would disagree across exactly the rows this parcel exists to fix.
        //
        // The threshold is L <= 0 on BOTH sides and must stay that way. Widening one side to
        // L <= 3 to also cover the rows the fire cannot reach would make them disagree through
        // the 1..3 window instead — a smaller version of the same defect. That residual (a
        // boundary rendering at screen 3 while the world says 1..3) is ACCEPTED.
        tst.w   d0
        ble     .anchor_top

        // Resolve L against the channel's own raster band, so the palette boundary and this one
        // agree in ALL THREE anchor states. Raster_BuildSchedule reads the same two words from the
        // same table and reaches the same verdict: above the band, clamp up (the frame-top ship
        // covers the rest); inside it, follow the anchor; past it, the record is not emitted and
        // this boundary does not split. If this side resolved anywhere else the two would
        // separate exactly where the fixture reaches.
        // The accessor clobbers a0 (our config) and d0-d2, so a0 and L cross the call on
        // the stack; a1-a3 (the shadow bases) it leaves alone.
        move.l  a0, -(sp)
        move.w  d0, -(sp)
        move.w  d2, d0                              // d0 = channel
        jbsr    Raster_GetChannelBand               // d0 = found, d1/d2 = lo/hi FIRE lines
        move.w  d0, d3                              // hold the found flag: the pop below
        move.w  (sp)+, d0                           //   sets flags, so test AFTER restoring L
        tst.w   d3
        beq     .anchor_unclamped                   // no band declared -> [0,224] is correct
        addq.w  #1, d1                              // fire line -> screen line, both bounds
        addq.w  #1, d2
        // THE DRY DIRECTION, and the HI test comes first because it is no longer a clamp.
        // Past band_hi the channel's raster record is not EMITTED at all this frame
        // (Raster_BuildSchedule drops it), so there is no palette boundary for this one to pin
        // to. Splitting the scroll bands here would leave the two disagreeing across exactly the
        // rows the palette no longer covers — the defect Parcel W exists to remove, and the
        // reason DEFERRED_WORK says never to change one side alone. The threshold is the
        // RECORD'S OWN band, read from the table the builder clamps against, so the two cannot
        // drift apart by editing one number.
        cmp.w   d2, d0
        ble     .anchor_hi_ok
        movea.l (sp)+, a0                           // config back — this path leaves here
        jbra    .bands_ready
    .anchor_hi_ok:
        // Below band_lo the record IS still emitted, clamped up to the floor, because the
        // frame-top ship covers the rows above it. Asymmetric on purpose: clamping UP hides
        // nothing, clamping DOWN would paint rows the world says are dry.
        cmp.w   d1, d0
        bge     .anchor_unclamped
        move.w  d1, d0
    .anchor_unclamped:
        movea.l (sp)+, a0                           // config back, on EVERY path below

        // Clamp to the screen. L <= 0 is the whole-screen state — the split lands at line 0 and
        // every band takes the anchored shifts, reached structurally instead of as a special
        // case. The early `ble .anchor_top` above is now the live route here; this test is the
        // total-contract backstop for the no-band-declared path (d0 = 0 out of
        // Raster_GetChannelBand), which returns L unclamped.
        tst.w   d0
        bpl     .anchor_nonneg
    .anchor_top:
        moveq   #0, d0
    .anchor_nonneg:
        cmpi.w  #224, d0
        bge     .bands_ready                        // entirely below the screen: nothing to do.
                                                    // NOT dead, and no longer the water channel's
                                                    // route: the band test above owns that now.
                                                    // This is the NO-BAND-DECLARED path's only
                                                    // threshold (Raster_GetChannelBand answering 0
                                                    // is a semantic answer — no live table, or no
                                                    // record for this channel — and it returns L
                                                    // unclamped), so the screen edge is all there
                                                    // is to test against.

        // --- find k = the last shadow band whose top <= L (the band being split) ---
        lea     Parallax_Shadow_Bands, a4
        moveq   #0, d1                              // d1 = k
        moveq   #1, d3                              // probe index
        cmp.w   d7, d3
        bhs     .anchor_have_k                      // single band: k = 0
        lea     sizeof(band_record)(a4), a5
    .anchor_find_k:
        move.w  band_top_line(a5), d2       // shadow tops are 0..224, no zero-extend needed
        cmp.w   d0, d2
        bhi     .anchor_have_k                      // top > L: previous band contains L
        move.w  d3, d1
        adda.w  #sizeof(band_record), a5
        addq.w  #1, d3
        cmp.w   d7, d3
        blo     .anchor_find_k
    .anchor_have_k:

        // --- shift entries (k+1 .. n-1) down one slot, from the END backwards ---
        // The shadow view has room for exactly one more entry; hdr()'s
        // `band_count + 1 <= MAX_PARALLAX_BANDS` guard is what reserves it.
        move.w  d7, d3
        sub.w   d1, d3
        subq.w  #1, d3                              // entries strictly below band k
        beq     .anchor_no_shift
        subq.w  #1, d3                              // -> dbf count
        move.w  d7, d2
        mul_const.w d2, #sizeof(band_record), d4     // d2 = n * entry size; d4 trashed
        lea     Parallax_Shadow_Bands, a5
        adda.w  d2, a5                              // a5 = &band[n], one past the last
    .anchor_shift_band:
        // Each -(a5) steps back inside the SOURCE entry while the displacement writes the
        // matching word/long one whole entry forward. Source and destination never overlap
        // (the gap IS one entry), so the order within an entry does not matter.
        //
        // GENERATED SINCE P3 TASK 8 (Step 3): this was a hand-unrolled W+L+L run carrying
        // the entry's 10-byte shape as instructions, while Step 4a's copy was already
        // derived from the struct. Same widths, same order, one authority.
        copy_band_entry_back(a5)
        dbf     d3, .anchor_shift_band

        // the matching scroll words: (k+1 .. n-1) -> (k+2 .. n), same backward walk
        move.w  d7, d3
        sub.w   d1, d3
        subq.w  #2, d3                              // dbf count (>= 0 here)
        move.w  d7, d2
        add.w   d2, d2                              // word index of slot n
        lea     Parallax_Shadow_Scroll_A, a5
        adda.w  d2, a5
        lea     Parallax_Shadow_Scroll_B, a6
        adda.w  d2, a6
    .anchor_shift_scroll:
        move.w  -(a5), 2(a5)
        move.w  -(a6), 2(a6)
        dbf     d3, .anchor_shift_scroll
    .anchor_no_shift:

        // --- write the split entry at k+1: a copy of band k, retopped to L ---
        // It INHERITS its parent's scroll factors and scroll words. That inheritance is the
        // mechanism: the surface changes where the wave starts, not how the layer scrolls.
        move.w  d1, d2
        mul_const.w d2, #sizeof(band_record), d4     // d2 = k * entry size
        lea     Parallax_Shadow_Bands, a5
        adda.w  d2, a5                              // a5 = &band[k]
        lea     sizeof(band_record)(a5), a6          // a6 = &band[k+1]
        // GENERATED SINCE P3 TASK 8 (Step 3) — the forward twin of the shift-down walk
        // above, off the same run widths. Was L+L+W typed out by hand.
        copy_band_entry_fwd(a5, a6)
        move.w  d1, d2
        add.w   d2, d2                              // word index of slot k
        lea     Parallax_Shadow_Scroll_A, a5
        adda.w  d2, a5
        move.w  (a5), 2(a5)                         // A[k+1] = A[k]
        lea     Parallax_Shadow_Scroll_B, a5
        adda.w  d2, a5
        move.w  (a5), 2(a5)                         // B[k+1] = B[k]

        addq.w  #1, d7                              // the shadow view is one band longer

        // --- from the split entry down, override BOTH deform shifts ---
        move.w  d1, d2
        addq.w  #1, d2                              // first overridden index = k+1
        move.w  d7, d3
        sub.w   d2, d3
        subq.w  #1, d3                              // dbf count over (k+1 .. n)
        mul_const.w d2, #sizeof(band_record), d4
        lea     Parallax_Shadow_Bands, a5
        adda.w  d2, a5                              // a5 = &band[k+1]
        move.b  parallax_config.pcfg_anchor_dsa(a0), d4
        move.b  parallax_config.pcfg_anchor_dsb(a0), d5
    .anchor_shift_write:
        move.b  d4, band_entry.band_deform_shift_a(a5)
        move.b  d5, band_entry.band_deform_shift_b(a5)
        adda.w  #sizeof(band_record), a5
        dbf     d3, .anchor_shift_write
        // retop the split entry AFTER the override walk (which does not touch the top)
        move.w  d1, d2
        addq.w  #1, d2
        mul_const.w d2, #sizeof(band_record), d4
        lea     Parallax_Shadow_Bands, a5
        adda.w  d2, a5
        move.w  d0, band_top_line(a5)               // the split lands exactly on L
        // THE SPLIT CONTINUES ITS PARENT'S CURVE (P3 Task 10; design section 2's ruling).
        // a5 is &band[k+1], the entry this overlay just manufactured as a copy of band k.
        // If band k was a curve layer, its ramp must run THROUGH the boundary: the split
        // inherited the parent's step, remainder and span from the whole-entry copy above,
        // and this bit tells the fill to seed its accumulator from the parent's parked
        // carry instead of restarting at the base scroll. Without it the ramp would restart
        // at L — the split re-parametrising the curve, which is the one interaction design
        // section 2 calls out by name.
        //
        // UNCONDITIONAL, AND CORRECT FOR A NON-CURVE PARENT TOO: the fill reads this bit
        // only after the band's ACTIVE bit says it is a curve at all, so setting it on a
        // flat split is inert. Testing the parent first would cost a branch to save nothing.
        // It cannot go stale either — Step 4a re-copies the whole shadow view from ROM,
        // where the bit is never authored, before this overlay runs.
    if (Game.SCANLINE_CAPS & CAP_FACTOR_CURVE) != 0 {
    .cap_factor_curve_split_begin:
        bset    #CURVE_FLAG_CONT_BIT, band_curve_flags(a5)
    .cap_factor_curve_split_end:
    }
    .cap_anchors_overlay_end:
    }
    .bands_ready:

        // --- Step 4: fill HScroll buffer — per-line, the one filler ---
        //   a1/a2/a3 = band array + scroll arrays (config's own or shadow).
        //
        // THERE IS NO MODE HERE ANY MORE. Until 2026-08-26 this site spliced
        // `parallax_mode_key` (engine.level.scene_dsl) to choose Parallax_Fill_PerCell
        // (28 longwords, 112-byte DMA) or Parallax_Fill_PerLine (224 longwords, 896-byte
        // DMA) off the header's two deform-table words and the anchor byte, twinned with
        // the DMA-length choice in engine.buffers. Owner ruling d-29-corrected deleted the
        // per-cell path: no shipped config had ever selected it (21 of 21 per-line on
        // master f8d06cae), the fill wrote its entries at stride 4 where the VDP reads
        // cell-mode tables at stride 32 (so only cell rows 0-3 were ever fed), and its
        // whole benefit was ~400 cycles/frame on plain scenes. The per-line fill, the
        // 896-byte DMA and reg $0B = %11 are now unconditional — including in a game
        // whose SCANLINE_CAPS is 0, whose filler simply takes `.lp_flat` for every band.
        // The old CAP_PER_LINE span brackets went with the gate; the deform / curve /
        // multi-table sub-spans inside Parallax_Fill_PerLine are still their own gates.
        //
        // advance H-deform phase accumulators so animated tables (sine, etc.)
        // actually scroll their wave over time. Without this the wave is
        // static and effects like windy clouds / heat shimmer don't animate.
        moveq   #0, d0
        move.b  parallax_config.pcfg_deform_speed_fg(a0), d0
        add.w   d0, Parallax_Deform_Phase_FG        // (Parallax_Deform_Phase_FG).w
        moveq   #0, d0
        move.b  parallax_config.pcfg_deform_speed_bg(a0), d0
        add.w   d0, Parallax_Deform_Phase_BG        // (Parallax_Deform_Phase_BG).w
        jbra    Parallax_Fill_PerLine               // tail call; it preserves a0/d7 itself
}

// ----------------------------------------------------------------------
proc Parallax_Step5_Vscroll () clobbers(d0-d7/a0-a6) {
        // --- Step 5: compute whole-plane Vscroll (always — used by per-column too) ---
        // FG: vscroll_a = camY (Plane A follows camera 1:1)
        // BG: target_b  = ((camY - v_center_y) >> v_factor_bg) + v_offset
        //     current_vscroll_bg += (target_b - current_vscroll_bg) >> PARALLAX_LERP_SHIFT
        //
        // Lock sentinel: v_factor_bg = 15 → skip lerp, pin BG = vOffset.
        // For configs that want the BG plane vertically locked regardless
        // of Camera_Y. v_factor_bg = 15 is an intentional feature.
        move.l  Camera_Y, d0                        // (Camera_Y).w
        swap    d0                                  // d0.w = camY (signed pixels)
        move.w  d0, d1                              // d1.w = camY  (FG vscroll)
        moveq   #0, d2
        move.b  parallax_config.pcfg_v_factor_bg(a0), d2
        cmpi.b  #15, d2
        beq     .v_locked
        sub.w   parallax_config.pcfg_v_center_y(a0), d0
        asr.w   d2, d0
        add.w   parallax_config.pcfg_v_offset(a0), d0     // d0 = target_b

        tst.b   Parallax_Snap_Pending               // (Parallax_Snap_Pending).w
        bne     .v_snap
        // CAP_TRANSITIONS span (P2 §3.3). Transition_Frames can only be nonzero
        // downstream of StartTransition's staging arm, so with that elided this test
        // always takes `.v_snap` — the lerp is the elidable region and the snap is its
        // structural fallthrough.
    if (Game.SCANLINE_CAPS & CAP_TRANSITIONS) != 0 {
    .cap_transitions_lerp_begin:
        tst.b   Parallax_Transition_Frames          // (Parallax_Transition_Frames).w
        beq     .v_snap                             // no transition — lock to target
        move.w  Parallax_Current_Vscroll_BG, d2     // (Parallax_Current_Vscroll_BG).w
        sub.w   d2, d0
        asr.w   #PARALLAX_LERP_SHIFT, d0
        add.w   d0, d2                              // d2 = new current_vscroll_bg
        jbra    .v_pack
    .cap_transitions_lerp_end:
    }
    .v_snap:
        move.w  d0, d2                              // snap: current = target
        jbra    .v_pack
    .v_locked:
        // locked: BG = vOffset (static, ignores camera + lerp)
        // FG follows camY (d1 already loaded with camY at function entry).
        // FG_V_scroll = camY scrolls the full 64-row Plane A. Camera_Y is
        // grid-clamped to [0, grid_h*SECTION_SIZE - SCREEN_HEIGHT].
        move.w  parallax_config.pcfg_v_offset(a0), d2
    .v_pack:
        move.w  d2, Parallax_Current_Vscroll_BG     // (Parallax_Current_Vscroll_BG).w

        // pack into Vscroll_Factor (used by Vscroll_Write whole-plane branch)
        swap    d1                                  // FG in high half
        move.w  d2, d1                              // BG in low half (d2 = current_vscroll_bg)
        move.l  d1, Vscroll_Factor

        // --- Step 5b: per-column V-scroll buffer fill ---
        // If v_deform_table_bg != NULL, sample table per column and write
        // column buffer. Vscroll_Write picks this up via the same flag.
        // Whole-plane Vscroll_Factor is also kept correct (above) so the
        // whole-plane fallback path stays valid if per-column gets disabled.
        // CAP_PER_COL_VSRAM span (P2 §3.3) — the column-buffer producer. Its consumer
        // is Vscroll_Write's `cap_per_col_vsram_emit` span; the two elide together or
        // the buffer is filled for nobody. `.v_done` is the structural fallthrough.
    if (Game.SCANLINE_CAPS & CAP_PER_COL_VSRAM) != 0 {
    .cap_per_col_vsram_fill_begin:
        move.l  parallax_config.pcfg_v_deform_table_bg(a0), d0
        beq     .v_done

        // advance v_deform_phase_bg by speed
        moveq   #0, d3
        move.b  parallax_config.pcfg_v_deform_speed_bg(a0), d3
        add.w   d3, Parallax_V_Deform_Phase_BG      // (Parallax_V_Deform_Phase_BG).w
        and.w   #$FF, Parallax_V_Deform_Phase_BG    // (Parallax_V_Deform_Phase_BG).w

        // fill 20 column-pairs (80 bytes total)
        // d1 = camY (FG, swap'd into high half — restore low word)
        swap    d1                                  // restore d1.w = camY (FG)
        // d2 = current_vscroll_bg (BG base)
        movea.l d0, a1                              // a1 = v_deform_table_bg
        lea     Parallax_Vscroll_Column_Buf, a2     // (Parallax_Vscroll_Column_Buf).w
        moveq   #0, d3
        move.b  parallax_config.pcfg_v_deform_shift_bg(a0), d3   // amplitude shift
        moveq   #0, d4
        move.b  Parallax_V_Deform_Phase_BG+1, d4    // (Parallax_V_Deform_Phase_BG+1).w — phase low byte
        moveq   #20-1, d6                           // 20 column-pairs
    .col:
        move.b  (a1, d4.w), d5                      // sample (signed byte)
        ext.w   d5
        asr.w   d3, d5                              // offset = sample >> v_deform_shift_bg
        move.w  d1, (a2)+                           // FG word = camY (constant per column)
        move.w  d2, d0
        add.w   d5, d0
        move.w  d0, (a2)+                           // BG word = base + offset
        addq.b  #1, d4
        dbf     d6, .col
    .cap_per_col_vsram_fill_end:
    }

    .v_done:
        jbra    Parallax_Step4_Fill         // Step 4 runs after Vscroll is final
}

// ----------------------------------------------------------------------
// Decode_Factor_A — return negated Plane A scroll for current band
// In:  d0.w = camX (signed pixels), a1 = band_entry*
// Out: d2.w = negated factor result. Returns 0 if s1 == 15 (locked).
// Preserves: d0, d3-d7, a0-a4. Clobbers: d1, d2.
// (Pushes d3 internally to use as the second-term scratch register.)
// ----------------------------------------------------------------------
proc Decode_Factor_A () clobbers(d1-d2) preserves(d3) {
        moveq   #0, d1
        move.b  band_entry.band_factor_a_s1(a1), d1
        cmpi.b  #15, d1
        beq     .locked
        move.w  d0, d2
        asr.w   d1, d2                              // first term = camX >> s1
        moveq   #0, d1
        move.b  band_entry.band_factor_a_s2(a1), d1
        cmpi.b  #15, d1
        beq     .negate
        // second term: combine with d2 via op (need scratch — borrow d3 via stack)
        move.l  d3, -(sp)
        move.w  d0, d3
        asr.w   d1, d3                              // second term = camX >> s2
        btst    #BAND_OP_BIT_A, band_entry.band_factor_ops(a1)
        bne     .a_sub
        add.w   d3, d2
        jbra    .a_pop_d3
    .a_sub:
        sub.w   d3, d2
    .a_pop_d3:
        move.l  (sp)+, d3
    .negate:
        neg.w   d2
        rts
    .locked:
        moveq   #0, d2
        rts
}

// ----------------------------------------------------------------------
// Decode_Factor_B — same shape as Decode_Factor_A, reads factor_b fields
// ----------------------------------------------------------------------
proc Decode_Factor_B () clobbers(d1-d2) preserves(d3) {
        moveq   #0, d1
        move.b  band_entry.band_factor_b_s1(a1), d1
        cmpi.b  #15, d1
        beq     .locked
        move.w  d0, d2
        asr.w   d1, d2
        moveq   #0, d1
        move.b  band_entry.band_factor_b_s2(a1), d1
        cmpi.b  #15, d1
        beq     .negate
        move.l  d3, -(sp)
        move.w  d0, d3
        asr.w   d1, d3
        btst    #BAND_OP_BIT_B, band_entry.band_factor_ops(a1)
        bne     .b_sub
        add.w   d3, d2
        jbra    .b_pop_d3
    .b_sub:
        sub.w   d3, d2
    .b_pop_d3:
        move.l  (sp)+, d3
    .negate:
        neg.w   d2
        rts
    .locked:
        moveq   #0, d2
        rts
}

// ----------------------------------------------------------------------
// Parallax_Fill_PerLine — emit 224 longwords with FG/BG deform sampling
// In:  a0 = parallax_config*, d7 = band count (MUST be >= 1 — countdown loop;
//      the only caller guards band_count != 0)
// Out: Hscroll_Buffer filled (224 longwords); a0/d7 preserved
// Clobbers: d0-d6, a1-a6
//
// Per band, all loop-invariant decisions are hoisted and one of FIVE
// specialized line loops runs (both/fg/bg deform, a curve ramp, or flat copy).
//
// IT WAS FOUR UNTIL P3 TASK 10, and this line is kept current deliberately: the design
// doc's claim that "`.lp_both` uses all 16 registers" — false, it uses 14 — got there
// because a roster comment in this file went stale and was read as a measurement. A count
// in a banner is a claim like any other.
//
// Registers at the point a band picks its loop:
//   d0 = packed base scroll (FG<<16 | BG)   — constant per band
//   d1 = scratch (index / sample / out word)
//   d2 = BG phase base (Phase_BG + band_phase)
//   d3 = shift_a (low) / shift_b (high) — swap to switch
//   d4 = line index    d5 = band end line
//   d6 = FG phase base (Phase_FG + band_phase)
//   d7 = bands remaining (countdown; movem-restored at exit)
//   a5/a6 = FG/BG deform curves (bases; never advanced)
//
// The FIVE loops then re-allocate, and they do NOT agree — each is register-starved and
// spends what the others need. What every one of them guarantees on the way out is the
// only cross-loop contract: **d4 = the band's end line**, a1/a2/a3/a5/a6/d7 untouched.
//   `.lp_both`  — the ORIGINAL shape, and the only one that still walks d4 per line: it
//                 indexes both curves as `(phase + d4) & $FF` and swaps d3 to switch shifts.
//   `.lp_flat`  — d0 broadcast 8 longs at a time; d1/d2 are the group/remainder counters.
//   `.band_fg_only` / `.lp_bg` — d4 jumps to the band end IMMEDIATELY and the curve is read
//                 through a0, a walking pointer, reset at the 256-byte wrap. d5 is the
//                 sample scratch, so the post-wrap line count lives on the stack. See the
//                 banner above those two loops for why, and for which halves of d0 go where.
//   `.lp_curve` — the RAMPING BG factor (P3 Task 10). Spends every data register: d1 acc,
//                 d2 whole step, d3 remainder, d6 error, d5 span (the Bresenham modulus,
//                 free because d4 has already jumped to the band end), d0.w the constant FG
//                 word, plus a4 as the output cursor and a0 as its end. That allocation IS
//                 the measured reason a layer may not have a curve AND a deform ref: a
//                 sampled channel needs a phase base, an amplitude shift and a scratch, and
//                 there are none left. Its state crosses BANDS through two stack words —
//                 the only loop here that does — so an anchored split continues the ramp.
// ----------------------------------------------------------------------
proc Parallax_Fill_PerLine () clobbers(d0-d6/a1-a6) preserves(a0/d7) {
        // UNCONDITIONAL since 2026-08-26 (d-29-corrected). This body used to sit under a
        // CAP_PER_LINE gate (`cap_per_line_body`, P2 §3.3) with a bare-`rts` else stub, and
        // its only caller under the twin `cap_per_line_fill` span; a zero-capability game
        // elided both and ran the per-cell filler instead. The per-cell filler is deleted,
        // so this is THE filler for every game, and a game raising no capability bit runs
        // it with every band on `.lp_flat`. The sub-spans below (deform tables, deform
        // sampling, per-band tables, curve) keep their own gates.
        movem.l a0/d7, -(sp)                        // preserve caller's config ptr + band count

        // a1/a2/a3 = band array + scroll arrays, set by the caller (Step 4a:
        // either the config's own data or the vscroll-rotated shadow view)
        lea     Hscroll_Buffer, a4                  // (Hscroll_Buffer).w — output ptr
        // CAP_DEFORM span, second site in this proc — the two table pointers the
        // sampling block is the ONLY reader of. A separate span name (not a second
        // `cap_deform_sample`) because two labels of one name in a proc is a
        // redefinition; the capability half is what ties them together.
    if (Game.SCANLINE_CAPS & CAP_DEFORM) != 0 {
    .cap_deform_tables_begin:
        movea.l parallax_config.pcfg_deform_table_fg(a0), a5  // NULL = no FG sampling
        movea.l parallax_config.pcfg_deform_table_bg(a0), a6  // NULL = no BG sampling
    .cap_deform_tables_end:
    }

        moveq   #0, d4                              // current line index (0..223)

    .next_band:
        // --- end_line for this band: the next band's top, or 224 ---
        // The shadow view stores tops in SCREEN LINES (Parcel W), so the ×8 that used
        // to live here is gone — it moved to Step 4a's rebase, which is the one place
        // that knows it is converting units. Reading a line-unit field here is what lets
        // an anchored boundary land on an arbitrary scanline instead of a cell edge.
        // The field is a WORD since P3 Task 7 (world-Y re-glue widened the ROM top to a
        // plane line 0..511); the shadow half of it is still 0..224, so the read is a
        // straight `move.w` and the old `moveq #0` zero-extend is gone with the byte.
        move.w  #224, d5
        subq.w  #1, d7
        beq     .have_end                           // last band
        move.w  band_top_line_next(a1), d5  // band_top+band_entry_len(a1), SCREEN LINES
    .have_end:

        // --- packed base scroll (constant per band) ---
        move.w  (a2), d0                            // FG (already negated)
        swap    d0
        move.w  (a3), d0                            // BG → d0 = FG<<16 | BG

        // ---- THE FIFTH LINE LOOP: a curve layer's ramping BG scroll (P3 Task 10) ----
        //
        // TESTED FIRST, BEFORE THE DEFORM HOISTS, AND THAT ORDER IS THE CURVE ∧ DEFORM
        // RULING MADE STRUCTURAL. A curve band never samples: `layer()` refuses a curve
        // beside a live amplitude and `scene()` refuses one beside a live anchor shift, so
        // by the time a curve band reaches here its two shift bytes are the no-deform
        // sentinel and every path through the block below would land on `.lp_flat` anyway.
        // Branching out here rather than after those tests is what keeps this ONE new loop
        // variant instead of a product with the FG/BG/both matrix.
        //
        // THE HOIST FALLS STRAIGHT INTO THE LOOP and the NON-curve path branches over both,
        // rather than the other way round. Deliberate: with CAP_DEFORM off (a game with
        // curves and no deform tables) the sampling block between here and `.lp_flat`
        // elides completely, so a loop body sitting outside this gate would be fallen into
        // by every flat band on the way past.
        //
        // WHAT THE HOIST INHERITS FROM THE PER-FRAME PASS (Parallax_Step4_Fill's
        // `.cap_factor_curve_hoist`): the whole step, the Bresenham remainder and the span
        // are already in this band's curve tail, computed against the LAYER's span before
        // the anchored overlay could split it. Nothing per-band is recomputed here except
        // the output extent and the accumulator's seed.
    if (Game.SCANLINE_CAPS & CAP_FACTOR_CURVE) != 0 {
    .cap_factor_curve_band_begin:
        btst    #CURVE_FLAG_ACTIVE_BIT, band_curve_flags(a1)
        beq     .curve_band_done                    // a flat layer: the sampling block owns it
        // -- seed the accumulator: at the layer's base, or where the parent left off --
        btst    #CURVE_FLAG_CONT_BIT, band_curve_flags(a1)
        bne     .curve_continue
        move.w  d0, d1                              // acc = this layer's BG base scroll
        moveq   #0, d6                              // err = 0: the ramp starts at this line
        jbra    .curve_seeded
    .curve_continue:
        // THE ANCHORED SPLIT'S HALF OF "AN ANCHOR SPLIT CONTINUES THE CURVE". Step 4b set
        // this bit on the entry it manufactured from the band above, whose loop parked its
        // final accumulator and error in Parallax_Curve_Carry. Resuming from them is what
        // makes the delta a function of the ABSOLUTE screen line rather than of the entry's
        // own top — the split moves a boundary, it does not re-parametrise a ramp.
        //
        // WHY THE CARRY IS RAM AND NOT TWO WORDS OF STACK FRAME, which is what this was
        // first built as and is otherwise the better shape (live for one call, free when
        // the capability is off): the contract closure gate reads ANY `(sp)`/`d(sp)` access
        // in a proc with a `preserves()` movem as a write to the saved-register slots, and
        // reported `[proc.clobber-undeclared] Parallax_Fill_PerLine a0` + `d7` — the exact
        // pair the movem restores. Measured 2026-08-20 and bisected to these four
        // instructions: replacing them with register moves cleared both firings while every
        // other line of this block stayed. The reservation is capability-sized in
        // engine/ram.emp, so a game without curves still spends nothing.
        move.w  Parallax_Curve_Carry, d1            // (Parallax_Curve_Carry).w — acc
        move.w  Parallax_Curve_Carry+2, d6          // (Parallax_Curve_Carry+2).w — err
    .curve_seeded:
        // PARK THE SEED BEFORE THE EMPTY-ENTRY EARLY-OUT, not only at the loop's end. Step
        // 4a can clamp a layer to ZERO lines (two shadow tops both at 224), and a split
        // below a zero-line parent must still resume from where that parent WOULD have
        // started — otherwise it reads whatever the last non-empty curve band left, which is
        // a different layer's ramp.
        move.w  d1, Parallax_Curve_Carry            // (Parallax_Curve_Carry).w
        move.w  d6, Parallax_Curve_Carry+2          // (Parallax_Curve_Carry+2).w
        move.w  d5, d2
        sub.w   d4, d2                              // d2 = lines in THIS entry
        ble     .band_done                          // empty/malformed entry
        move.w  d5, d4                              // line index jumps to the band end
        add.w   d2, d2
        add.w   d2, d2                              // d2 = bytes this entry writes
        movea.l a4, a0                              // a0 = the run's END cursor. a0 is the
        adda.w  d2, a0                              //   caller's config ptr, dead since the
                                                    //   table hoist and restored by the exit
                                                    //   movem — the same borrow the two
                                                    //   single-channel loops make for their
                                                    //   curve walk pointer.
        move.w  band_curve_step(a1), d2             // whole pixels per line (may be negative)
        move.w  band_curve_rem(a1), d3              // the fraction's numerator, in [0, span)
        move.w  band_curve_span(a1), d5             // d5 is free — d4 already holds the end
        swap    d0                                  // d0.w = FG base scroll (constant word)
    .lp_curve:
        move.w  d0, (a4)+                           // FG word — constant across the layer
        move.w  d1, (a4)+                           // BG word — the ramp's value at this line
        add.w   d2, d1                              // acc += whole
        add.w   d3, d6                              // err += remainder
        cmp.w   d5, d6                              // both are in [0, 2*span); unsigned is
        blo     .lc_next                            //   exact and needs no sign handling
        sub.w   d5, d6
        addq.w  #1, d1                              // the fraction carried one whole pixel
    .lc_next:
        cmpa.l  a0, a4
        blo     .lp_curve
        move.w  d1, Parallax_Curve_Carry            // (Parallax_Curve_Carry).w — park the
        move.w  d6, Parallax_Curve_Carry+2          //   carry: the next entry may be this
                                                    //   layer's anchored continuation
        jbra    .band_done
    .curve_band_done:
    .cap_factor_curve_band_end:
    }

        // --- hoist channel-active decisions ---
        // CAP_DEFORM span (P2 §3.3), PATH depth — the sampling machinery: both hoists
        // and all three sampled line loops. Without the bit no band carries a live
        // (non-15) amplitude, so every band would take `.lp_flat` at runtime anyway;
        // eliding removes the dead decisions AND the three loops, and `.lp_flat` is
        // the structural fallthrough.
    if (Game.SCANLINE_CAPS & CAP_DEFORM) != 0 {
    .cap_deform_sample_begin:
        // CAP_MULTI_DEFORM_TABLE span (§3.3), the FIRST code site for the bit (P3 Task 9;
        // Task 8's landing was data-side, so it authored no bracket and said so).
        //
        // PER-LAYER DEFORM REFS MOVE THE TABLE POINTERS FROM THE CONFIG TO THE BAND. The
        // `cap_deform_tables` hoist above loads the CONFIG's two curves once for the whole
        // fill, which is right when every band samples the same pair. A layer with
        // `deform: own(..)` samples its own, so under the capability a5/a6 are re-loaded
        // PER BAND, from this band's extension record.
        //
        // TWO INSTRUCTIONS, NO TEST, AND THAT IS THE DESIGN. The extension always carries
        // the EFFECTIVE table (engine/level/scene_dsl.emp's band_table_a/b resolve the
        // inheritance at comptime), so there is no "is it null? fall back" branch to pay
        // for. This is the whole runtime cost of the capability and it is a clean per-band
        // constant — the model parameter Task 9 measures.
        //
        // NESTED INSIDE cap_deform_sample ON PURPOSE. a5/a6 are the sampling machinery's
        // registers and nothing outside this block reads them, so a build with the tables
        // but not the sampler would load two pointers nobody uses. scene_caps() pins the
        // implication that makes the nesting sound (MULTI_DEFORM_TABLE ⇒ CAP_DEFORM), and
        // tools/scene_spans.py derives a mask's expected spans from exactly this nesting.
        //
        // THE CONFIG-LEVEL HOIST IS NOT ELIDED UNDER THE CAPABILITY, though it is dead
        // there. An `if CAP == 0 { ... }` gate would be the only inverted one in the tree
        // and would make the span model non-monotone — tools/scene_spans.py would have to
        // learn that a WIDER mask emits FEWER spans. Two `movea.l`s once per frame is not
        // worth that; if it ever is, it is a span-tooling change, not a one-line edit here.
    if (Game.SCANLINE_CAPS & CAP_MULTI_DEFORM_TABLE) != 0 {
    .cap_multi_deform_table_band_begin:
        movea.l band_ext_table_a(a1), a5    // this band's FG curve (0 = no FG sampling)
        movea.l band_ext_table_b(a1), a6    // this band's BG curve (0 = no BG sampling)
    .cap_multi_deform_table_band_end:
    }
        // FG active: table non-NULL AND shift_a != 15
        cmpa.w  #0, a5
        beq     .fg_inactive
        moveq   #0, d3
        move.b  band_entry.band_deform_shift_a(a1), d3
        cmpi.b  #15, d3
        beq     .fg_inactive
        // FG ACTIVE — d3.w = shift_a; d6 = FG phase base
        move.w  Parallax_Deform_Phase_FG, d6        // (Parallax_Deform_Phase_FG).w
        moveq   #0, d1
        move.b  band_entry.band_phase_offset(a1), d1
        add.w   d1, d6
        // LAYER-anchor the sample index (Harmony study defect #2): fold the FG
        // plane's vscroll (= camY, Step 5) into the base so the wave rides the
        // ART, not the screen — without this a vertical scroll slides the art
        // under a screen-fixed wave. Index math is mod-256 (the &$FF in the
        // loops), so the fold is phase-safe.
        move.l  Camera_Y, d1                        // (Camera_Y).w
        swap    d1
        add.w   d1, d6
        // BG active too?
        cmpa.w  #0, a6
        beq     .band_fg_only
        moveq   #15, d1
        cmp.b   band_entry.band_deform_shift_b(a1), d1
        beq     .band_fg_only
        // --- BOTH channels ---
        swap    d3
        move.b  band_entry.band_deform_shift_b(a1), d3  // low byte = shift_b after swap below
        moveq   #0, d2
        move.b  band_entry.band_phase_offset(a1), d2
        add.w   Parallax_Deform_Phase_BG, d2        // (Parallax_Deform_Phase_BG).w — d2 = BG phase base
        add.w   Parallax_Current_Vscroll_BG, d2     // layer-anchor: BG plane vscroll (defect #2)
        swap    d3                                  // d3.w = shift_a, hi = shift_b
        jbra    .lp_both
    .fg_inactive:
        // FG flat — BG active?
        cmpa.w  #0, a6
        beq     .lp_flat
        moveq   #15, d1
        cmp.b   band_entry.band_deform_shift_b(a1), d1
        beq     .lp_flat
        // --- BG only ---
        moveq   #0, d3
        move.b  band_entry.band_deform_shift_b(a1), d3  // d3.w = shift_b
        moveq   #0, d2
        move.b  band_entry.band_phase_offset(a1), d2
        add.w   Parallax_Deform_Phase_BG, d2        // (Parallax_Deform_Phase_BG).w
        add.w   Parallax_Current_Vscroll_BG, d2     // layer-anchor: BG plane vscroll (defect #2)
        jbra    .lp_bg

// --- BOTH: FG and BG sampled per line ---
    .lp_both:
        cmp.w   d5, d4
        bhs     .band_done
    .lb_line:
        move.w  d6, d1
        add.w   d4, d1
        andi.w  #$FF, d1
        move.b  (a5,d1.w), d1
        ext.w   d1
        asr.w   d3, d1                              // >> shift_a
        swap    d0
        add.w   d0, d1                              // + FG base
        swap    d0
        move.w  d1, (a4)+                           // FG word
        swap    d3                                  // → shift_b
        move.w  d2, d1
        add.w   d4, d1
        andi.w  #$FF, d1
        move.b  (a6,d1.w), d1
        ext.w   d1
        asr.w   d3, d1                              // >> shift_b
        swap    d3                                  // → shift_a
        add.w   d0, d1                              // + BG base
        move.w  d1, (a4)+                           // BG word
        addq.w  #1, d4
        cmp.w   d5, d4
        blo     .lb_line
        jbra    .band_done

// --- SINGLE-CHANNEL SAMPLING: pointer walk + unrolled run ---
//
// The two single-channel loops below cost 90 cycles a line in the shape this replaced,
// and they are where the walker's time actually goes: at the shipped OJZ camera the
// anchored overlay turns BG sampling on for 144 of the 224 lines, and under sustained
// max-diagonal for ~176 of them. Three changes, each value-identical:
//
// (1) POINTER WALK instead of a recomputed index. The old body spent 30 of its 90
//     cycles just addressing the curve — `move.w phase,d1 / add.w d4,d1 /
//     andi.w #$FF,d1 / move.b (aTab,d1.w),d1`. The index is (phase + line) & $FF and
//     the line advances by exactly 1, so the ADDRESS advances by exactly 1: a walking
//     `move.b (a0)+,d5` (8 cycles) reads the identical byte sequence. The `& $FF` is
//     the one thing a walk cannot express, so the run is SPLIT at the 256-byte wrap and
//     the pointer reset to the table base. The fill is 224 lines and a curve is 256
//     bytes, so a band crosses the wrap AT MOST ONCE and a third run cannot exist.
//     The curves stay 256 bytes and that is not an accident: doubling one so the wrap
//     became unreachable would move every `DeformTable_*` address, which rewrites the
//     `pcfg_deform_table_*` words inside every emitted config record — precisely the
//     byte churn `scene_registry.emp:350-361` pins the P1 image-identity gate on.
//
// (2) THE SAMPLED CHANNEL'S BASE SCROLL GETS ITS OWN WORD REGISTER. d0 packs
//     FG<<16 | BG, so the old body paid `swap d0 / add.w d0,d1 / swap d0` — 12 cycles a
//     line — to reach the half it needed. Both halves are loop-invariant; the sampled
//     half is now unpacked ONCE per band and the constant half stays in d0's low word.
//
// (3) 8x UNROLL + remainder tail, the same shape `.lp_flat` already uses, trading 10
//     cycles of `dbf` per line for 1.25. Spans have been arbitrary since Parcel W (a
//     world-anchored band splits at any scanline), so the tail is mandatory and carries
//     the same zero-remainder guard `.fl_tail` documents: `subq #1` on 0 gives $FFFF and
//     sprays ~2 MB forward out of Hscroll_Buffer.
//
// `.lp_both` above is deliberately NOT converted: two sampled channels need two walk
// pointers and there is no second free address register. Leaving it also fixes the
// walker model's `line_both` term as an unchanged regression control.
//
// REGISTER NOTE: a0 is the walk pointer. It is the caller's config pointer, dead after
// the two table loads at the top of this proc, and restored by the exit `movem` — which
// is what keeps the declared `preserves(a0)` true.
// d5 is the body's sample scratch, so the post-wrap line count is parked on the stack
// across each run rather than held in a register; every path pops it before `.band_done`.

// --- FG only: BG word constant ---
    .band_fg_only:
        move.w  d5, d1
        sub.w   d4, d1
        ble     .band_done                          // empty/malformed band; d1 = span
        add.w   d4, d6
        andi.w  #$FF, d6                            // d6 = curve index of the first line
        move.w  d5, d4                              // line index jumps to band end
        movea.l a5, a0
        adda.w  d6, a0                              // a0 = &fg_curve[index]
        neg.w   d6
        addi.w  #256, d6                            // d6 = lines until the wrap (1..256)
        swap    d0
        move.w  d0, d2                              // d2 = FG base scroll, unpacked once
        swap    d0                                  // d0.w = BG base scroll (constant word)
        moveq   #0, d5                              // d5 = lines left after the wrap
        cmp.w   d6, d1
        bls     .lf_run                             // whole band fits before the wrap
        move.w  d1, d5
        sub.w   d6, d5                              // d5 = post-wrap run
        move.w  d6, d1                              // d1 = pre-wrap run
    .lf_run:                                        // d1 = lines this run (>= 1)
        move.w  d5, -(sp)                           // park: d5 is the body's scratch
        move.w  d1, d6
        andi.w  #7, d6                              // d6 = remainder lines 0..7
        lsr.w   #3, d1                              // d1 = whole groups of 8
        beq     .lf_tail
        subq.w  #1, d1
    .lf_grp:
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+                           // FG word
        move.w  d0, (a4)+                           // BG word (constant)
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        dbf     d1, .lf_grp
    .lf_tail:
        tst.w   d6                                  // zero remainder MUST skip the dbf
        beq     .lf_after
        subq.w  #1, d6
    .lf_rem:
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d2, d5
        move.w  d5, (a4)+
        move.w  d0, (a4)+
        dbf     d6, .lf_rem
    .lf_after:
        move.w  (sp)+, d5
        tst.w   d5
        beq     .band_done
        move.w  d5, d1                              // the post-wrap run
        moveq   #0, d5                              // ...and there cannot be a third
        movea.l a5, a0                              // walk restarts at the curve base
        jbra    .lf_run

// --- BG only: FG word constant ---
    .lp_bg:
        move.w  d5, d1
        sub.w   d4, d1
        ble     .band_done                          // empty/malformed band; d1 = span
        add.w   d4, d2
        andi.w  #$FF, d2                            // d2 = curve index of the first line
        move.w  d5, d4                              // line index jumps to band end
        movea.l a6, a0
        adda.w  d2, a0                              // a0 = &bg_curve[index]
        neg.w   d2
        addi.w  #256, d2                            // d2 = lines until the wrap (1..256)
        move.w  d0, d6                              // d6 = BG base scroll (d0's low half)
        swap    d0                                  // d0.w = FG base scroll (constant word)
        moveq   #0, d5                              // d5 = lines left after the wrap
        cmp.w   d2, d1
        bls     .lg_run                             // whole band fits before the wrap
        move.w  d1, d5
        sub.w   d2, d5                              // d5 = post-wrap run
        move.w  d2, d1                              // d1 = pre-wrap run
    .lg_run:                                        // d1 = lines this run (>= 1)
        move.w  d5, -(sp)                           // park: d5 is the body's scratch
        move.w  d1, d2
        andi.w  #7, d2                              // d2 = remainder lines 0..7
        lsr.w   #3, d1                              // d1 = whole groups of 8
        beq     .lg_tail
        subq.w  #1, d1
    .lg_grp:
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+                           // FG word (constant)
        move.w  d5, (a4)+                           // BG word
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        dbf     d1, .lg_grp
    .lg_tail:
        tst.w   d2                                  // zero remainder MUST skip the dbf
        beq     .lg_after
        subq.w  #1, d2
    .lg_rem:
        move.b  (a0)+, d5
        ext.w   d5
        asr.w   d3, d5
        add.w   d6, d5
        move.w  d0, (a4)+
        move.w  d5, (a4)+
        dbf     d2, .lg_rem
    .lg_after:
        move.w  (sp)+, d5
        tst.w   d5
        beq     .band_done
        move.w  d5, d1                              // the post-wrap run
        moveq   #0, d5                              // ...and there cannot be a third
        movea.l a6, a0                              // walk restarts at the curve base
        jbra    .lg_run
    .cap_deform_sample_end:
    }

// --- FLAT: same longword for every line of the band (8x unrolled + tail) ---
    // Band line spans USED to be guaranteed multiples of 8 — tops were Plane-B cell
    // rows scaled ×8 in both readers, and the last band ends at 224 = 28×8 — so this
    // path was a bare `span >> 3` unroll with NO remainder tail. Parcel W's
    // world-anchored overlay splits a band at an ARBITRARY scanline, so that guarantee
    // is gone and the tail below is what replaces it.
    //
    // WHY THE TAIL IS NOT OPTIONAL, in two failure modes, both silent at build time:
    //   span 1..7  -> `lsr #3` = 0, `subq #1` = $FFFF, and dbf runs 65536 times × 8
    //                 longwords = ~2 MB sprayed from Hscroll_Buffer forward, into the
    //                 DMA queues — the frozen-VDP crash class the Step-4a clamp at
    //                 :618-622 exists to prevent.
    //   span 9..15 -> writes 8·floor(span/8) longwords while d4 jumps to the band end,
    //                 so a4 and d4 desync PERMANENTLY: every band below lands at the
    //                 wrong buffer offset and the buffer tail keeps last frame's words.
    //
    // d2/d3/d6 are dead on this path (they carry the deform paths' phase bases and
    // shifts, and this is the no-deform branch), so the remainder counter is free.
    .lp_flat:
        move.w  d5, d1
        sub.w   d4, d1
        ble     .band_done                          // empty/malformed band
        move.w  d5, d4                              // line index jumps to band end
        move.w  d1, d2
        andi.w  #7, d2                              // d2 = remainder lines 0..7
        lsr.w   #3, d1                              // d1 = whole groups of 8
        beq     .fl_tail                            // span < 8: tail only, no group
        subq.w  #1, d1
    .fl_line:
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        move.l  d0, (a4)+
        dbf     d1, .fl_line
    .fl_tail:
        // A ZERO REMAINDER MUST BRANCH AROUND, never fall into the dbf: `subq #1` on 0
        // gives $FFFF and re-creates the exact 65536-iteration spray this tail exists to
        // fix — with the multiple-of-8 spans that are still the common case as the input.
        tst.w   d2
        beq     .band_done
        subq.w  #1, d2
    .fl_rem:
        move.l  d0, (a4)+
        dbf     d2, .fl_rem

    .band_done:
        lea     sizeof(band_record)(a1), a1
        addq.l  #2, a2
        addq.l  #2, a3
        tst.w   d7
        bne     .next_band

        movem.l (sp)+, a0/d7
        rts
}

