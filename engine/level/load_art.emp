// Level art loader
// The act uses a single act-wide paged art pool held as a VRAM residency cache
// (§9.7): pages occupy allocated frames and stream in/out on demand. Level_LoadArt
// drives the init bulk load through the Art-streaming page-in path (engine.page_in)
// so init exercises the same decode + landing machinery gameplay uses. When the
// pool fits PAGE_FRAMES_CLAMP the cache degenerates to fully resident for the
// life of the act; a larger pool ends the bulk load with only the last-loaded
// pages resident and gameplay pages the rest in as needed.
// (The blocking Art_Decompress/ZX0_Decompress pair lives with its sole consumer,
// the DEBUG compression self-test — F-6: release ships no unreachable equipment.)

module engine.load_art in load_art

use engine.structs.{Act}
use engine.constants.{DMA_BUDGET_BLANKED_INIT, PGRQ_BULK, PAGE_FRAMES_CLAMP}

// Every callee is .emp-owned and resolves at link — no boundary decls:
// PageCache_Init (engine.page_cache) / PageIn_Enqueue (engine.page_in), BG_Init (engine.bg),
// VSync_Wait (engine.vblank).

// -----------------------------------------------
// Level_LoadArt — load the WHOLE act art pool to VRAM via the page-in path,
// then init BG.
//
// In:  a0 = act descriptor pointer
// Out: none
// Clobbers: d0-d2/d5-d7/a0-a4 — own writes (a4 act ptr, d5 page_id, d6 page
//      count, d7 saved budget) plus the callee licenses folded in: PageIn_Flush
//      (none), PageIn_Enqueue d2/a0, VSync_Wait d0-d2/a0-a3 (its P2a idle-decode
//      slice preserves d3-d4 via PageIn_EnqueueLanding), BG_Init d0-d1/a1-a2.
//      a4/d5-d7 are the only registers kept live across VSync_Wait, and all sit
//      OUTSIDE VSync_Wait's d0-d2/a0-a3 set, so no movem is needed. a5-a6/d3-d4
//      are untouched (preserved by not-touching).
//
// The act ships one paged art pool: a stride-8 manifest v2 [PageManifest;N]
// table {source, tiles, form, flags} + per-page blobs — ZX0 blobs carry the
// 4-byte wrapper, raw blobs carry NO wrapper. Each page's index is enqueued as
// a page-in request; the dispatcher (PageIn_Process, run once per frame by
// VSync_Wait) resolves it, decodes/lands it, and marks it resident. We spin
// VSync_Wait until every page has landed. When the pool fits PAGE_FRAMES_CLAMP
// the whole pool is then resident for the life of the act (the degenerate
// fully-resident regime) and section streaming/teleport never reloads tile
// art; a larger pool leaves the last-loaded pages resident and streams the
// rest on demand.
//
// Runs at init with the display blanked OFF (caller's responsibility): with the
// display off, DMA runs at the full per-line rate on EVERY line, so the raised
// window budget (DMA_BUDGET_BLANKED_INIT) lets a whole 64-tile (2048 B) page's Important
// landing DMA drain inside one VSync. The active-display budget is restored
// before the loop returns (and before the caller enables the display).
// -----------------------------------------------
pub proc Level_LoadArt (a0: *Act) clobbers(d0-d2/d5-d7/a0-a4) {
        movea.l a0, a4                              // a4 = act ptr (kept live to BG_Init)

        // Bind the live act context at the START of level init (soak fix chain 71):
        // Section_Init sets Current_Act_Ptr too, but LATER (and it read null at the
        // gameplay page-in dispatch), so the page prefetch's pool-bound check and any
        // Current_Act_Ptr reader had a stale/null base. Set it here, before any page-in.
        move.l  a0, Current_Act_Ptr

        // Seed the per-act art-streaming budget (P2c Task 9, B&R pattern): copy the
        // descriptor's steady-state byte budget to RAM and seed the current-frame
        // remaining so the very first landing (before PageIn_Process's first per-frame
        // tick reload, e.g. if Frame_Counter has not advanced yet) sees a valid budget.
        // PageIn_Process reloads Art_Budget_Remaining from Act_Art_Budget in its
        // once-per-physical-frame tick thereafter. The display-off bulk load lands
        // <=1 page/frame (2048 B) under the budget (4096), so the governor never
        // throttles init — a steady-state cap on gameplay bursts, not init bulk.
        move.w  Act.act_art_budget(a0), d0
        move.w  d0, Act_Art_Budget
        move.w  d0, Art_Budget_Remaining

        // Reset the residency cache at the act transition, before the pool is
        // (re)loaded (P2b Task 6). PageCache_Init flushes pending page-in work
        // (subsuming the old PageIn_Flush), clears Page_Table, and threads the frame
        // free list — so the streaming load below allocates frames per page and
        // page-in's completion (PageCache_Publish) marks each page resident.
        jbsr    PageCache_Init

        move.w  Act.act_art_pool_pages(a4), d6      // d6.w = page count
        move.w  d6, PageIn_Pool_Pages               // store the page count: dispatch page-id bound
                                                    // (resolve-context source independent of Current_Act_Ptr)
        // Latch the §9.7 degenerate-path flag: pool fits the frame clamp ->
        // permanently fully resident after this bulk load -> PageCache_Prefetch
        // early-outs its ahead-strip scan for the whole act (nothing it could
        // find is ever non-resident). Streaming acts (pool > clamp) leave it 0.
        clr.b   PageIn_Fully_Resident
        cmpi.w  #PAGE_FRAMES_CLAMP, d6
        bhi     .streaming_pool
        st.b    PageIn_Fully_Resident
    .streaming_pool:
        tst.w   d6
        beq     .bg                                 // empty pool -> straight to BG

        // Point the dispatcher at this act's page-address table (FIFO resolution base).
        move.l  Act.act_art_pool_table(a4), PageIn_Pool_Table

        // BULK-FIRST discipline (chain 78): suppress speculative prefetch for the whole
        // bulk load + drain-wait below. Otherwise, with the pool > PAGE_FRAMES, each
        // VSync_Wait's PageCache_Prefetch refills the FIFO from ahead-strip evictions and
        // the drain never reaches quiescence (black-screen init livelock). Cleared once the
        // drain completes, before the display comes on.
        st.b    PageIn_Bulk_Drain

        // Raise the DMA window budget for the display-off bulk load: several
        // 64-tile pages' Important landing DMAs (2048 B each) drain per blanked
        // frame under the raised window (headroom above the active-display budget).
        move.w  DMA_Budget_Default, d7              // save the active-display budget
        move.w  #DMA_BUDGET_BLANKED_INIT, DMA_Budget_Default

        // Enqueue every page as a request, INCREMENTALLY (tripwire 1): at the
        // 64-tile cutover a pool is ~10+ pages > PAGEIN_QUEUE_SLOTS(8), so a
        // blind up-front enqueue would drop pages. Enqueue one page at a time; on a
        // full queue, spin a VSync_Wait to drain a slot, then retry the SAME page.
        // Nothing is dropped, at any page count.
        moveq   #0, d5                              // d5 = next page_id to enqueue
    .enq_loop:
        cmp.w   d6, d5                              // all pages enqueued?
        bge     .drain_wait
        move.w  d5, d0
        moveq   #PGRQ_BULK, d1                      // bulk load: non-speculative (D3-gate-exempt), still evictable
        jbsr    PageIn_Enqueue                      // carry SET = queue full
        bcc     .enq_next
        jbsr    VSync_Wait                          // queue full -> drain a frame, retry same page
        jbra    .enq_loop
    .enq_next:
        addq.w  #1, d5
        jbra    .enq_loop

        // Drive the streaming path to completion. VSync_Wait runs PageIn_Process
        // each frame (decode slice + landing); the trailing VBlank drains
        // Critical/Important in the extended display-off blanking. Spin until the
        // queue is empty AND no decode is in flight/suspended/pending AND the last
        // landing has drained (Staging_Busy cleared by VInt_Level).
    .drain_wait:
        jbsr    VSync_Wait
        tst.b   PageIn_Queue_Count
        bne     .drain_wait
        tst.b   PageIn_InFlight
        bne     .drain_wait
        tst.b   PageIn_Suspended
        bne     .drain_wait
        tst.b   PageIn_Land_Pending
        bne     .drain_wait
        tst.b   PageIn_Staging_Busy
        bne     .drain_wait

        move.w  d7, DMA_Budget_Default              // restore the active-display budget
        clr.b   PageIn_Bulk_Drain                  // bulk drain reached quiescence — prefetch may resume

    .bg:
        // -- Streaming fix F1: latch the DIRECT-MAP patch regime --
        // The copy-site patch runs (PageCache_PatchRun_Seq/_Col) translate every
        // nametable word global->physical through Page_Table and maintain a
        // refcount pair, so that a page can later be EVICTED safely. Both are
        // dead weight on an act that can never evict, and on such an act the
        // translation is provably the identity — so the runs take a collapsed
        // variant instead. Two conditions, checked HERE because this is the last
        // point in the act load where either can still change:
        //
        //   (1) PageIn_Fully_Resident — the pool fits PAGE_FRAMES_CLAMP, so the
        //       bulk drain above left every page resident and nothing can evict:
        //       PageCache_Request early-outs on a resident page, so AllocFrame is
        //       never reached and Page_Table is frozen for the act's lifetime.
        //   (2) Page_Table is the IDENTITY over the pool — Page_Table[p] == p for
        //       every p < PageIn_Pool_Pages. That is what PageCache_Init's free
        //       list (threaded 0->1->...->N-1) plus the in-order enqueue above
        //       plus page-in's single-slot, in-order completion produce; it is
        //       VERIFIED rather than assumed, so an allocator or scheduling change
        //       that broke it would cost the fast path, never correctness.
        //
        // Under both, frame == page == global>>6, hence
        // frame<<6 | (global&63) == global: the map's global value IS the physical
        // index and the patch collapses to read/mask/one map read/attr-merge/store.
        // An act failing either condition runs the pre-F1 loop unchanged.
        //
        // An EMPTY pool satisfies the identity vacuously and is latched: with no
        // pool pages every translated word is blank, and any non-blank one is
        // already a loud DEBUG failure on both loop variants.
        clr.b   PageCache_Direct_Map
        tst.b   PageIn_Fully_Resident
        beq     .no_direct
        lea     Page_Table, a0
        move.w  PageIn_Pool_Pages, d0
        subq.w  #1, d0
        bmi     .direct_ok                          // empty pool -> identity holds vacuously
        moveq   #0, d1                              // d1 = expected frame id (== page id)
    .direct_scan:
        cmp.b   (a0)+, d1
        bne     .no_direct                          // not the identity -> keep the general loop
        addq.w  #1, d1
        dbf     d0, .direct_scan
    .direct_ok:
        st.b    PageCache_Direct_Map
    .no_direct:

        // -- §2 A.5: blit zone-wide BG to Plane B nametable (T1) --
        movea.l a4, a0                              // a0 = act ptr
        jbra    BG_Init                             // tail call
}
