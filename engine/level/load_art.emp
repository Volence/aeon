// Level art loader
// Blocking decompress -> DMA pipeline. The act uses a single act-wide paged
// art pool that is fully resident in VRAM for the life of the act (loaded
// once at init).

module engine.load_art in load_art

use engine.structs.{Act}
use engine.constants.{ART_POOL_PAGE_TILES, ART_HDR_VERSION, ART_HDR_SIZE, ART_VER_ZX0, TILE_SIZE}

// One decompressed pool page in bytes (ART_POOL_PAGE_TILES tiles x 32 B) —
// the VRAM page stride and the Art_Staging_Buffer capacity are the same
// quantity (the buffer holds exactly one page).
const ART_POOL_PAGE_BYTES = ART_POOL_PAGE_TILES * TILE_SIZE

// Every callee is .emp-owned and resolves at link — no boundary decls:
// S4LZ_Decompress / ZX0_Decompress (engine.s4lz / engine.zx0),
// QueueDMA_Critical (engine.dma_queue), BG_Init (engine.bg), VSync_Wait
// (engine.vblank).

// -----------------------------------------------
// Art_Decompress — version-dispatched blocking art decompressor.
//
// Every compressed art blob starts with the 4-byte wrapper
// [u16 BE uncompressed size][u8 flags][u8 version]:
//   version 1 (ART_VER_S4LZ) -> S4LZ_Decompress (parses the wrapper itself)
//   version 2 (ART_VER_ZX0)  -> ZX0_Decompress (wrapper skipped here)
// Callers must skip size-0 blobs BEFORE calling (empty stubs carry no
// decodable stream).
//
// Dispatch order (§2.2 — common case falls through): ZX0 is the common case
// on every production path. The two-tier split puts ZX0 on the load-time art
// tier, and every act-pool page the engine ships is a .zx0 blob
// (games/sonic4/data/generated/**/act_pool_page*.zx0); the S4LZ arm is
// reached only from the DEBUG compression self-test, which exercises both
// arms deliberately. So the ZX0 test is the not-taken branch.
//
// In:  a0 = source ROM pointer (wrapper at start, word-aligned)
//      a1 = destination buffer
// Out: a0 = past end of compressed data
// Clobbers: d0-d3, a1-a3 (the S4LZ path; of these the ZX0 path touches only
//      d0-d1 and the a1 cursor) — the exhaustive license: a4/d4 are preserved
//      on both paths and callers keep them live across the call.
//      a1 is the destination write cursor and is left wherever writing
//      stopped — not an output. The two arms do not agree on it: ZX0 always
//      produces it, but an S4LZ stream that decompresses to zero bytes never
//      writes it, leaving the caller's own dest start. The wrapper's size word
//      is the authoritative extent.
// -----------------------------------------------
pub proc Art_Decompress (a0: *u8, a1: *u8) clobbers(d0-d3/a1-a3) out(a0) {
        cmpi.b  #ART_VER_ZX0, ART_HDR_VERSION(a0)
        bne     .s4lz                           // rare arm out of line (§2.2)
        addq.l  #ART_HDR_SIZE, a0               // ZX0 stream starts past wrapper
        jbra    ZX0_Decompress
    .s4lz:
        jbra    S4LZ_Decompress                 // S4LZ_Decompress reads its own wrapper
}

// -----------------------------------------------
// Level_LoadArt — load the WHOLE act art pool to VRAM, then init BG.
//
// In:  a0 = act descriptor pointer
// Out: none
// Clobbers: d0-d4, d7, a0-a3; d6/a4-a6 are movem-PRESERVED (the loop-live
//      registers below sit in them so both callees' licenses leave them
//      alone, and the movem round-trip proves the preservation).
//      Derivation — own writes: a4, d6, a5, a6, a0, d4, a1, d7, d1, d2, d3.
//      Callee licenses folded in: Art_Decompress d0-d3/a1-a3 (its S4LZ tail
//      call is d0-d3/a1-a3, its ZX0 tail call d0-d1 plus the a1 cursor, both
//      covered),
//      QueueDMA_Critical d0-d4/a1-a2, VSync_Wait d0-d2/a0-a3 (widened by the
//      Art-streaming P2a idle-decode slice — Task 3 Step 6; still fully covered
//      here, and this proc keeps only a4-a6/d6/d7 live across VSync_Wait),
//      BG_Init d0-d1/a1-a2.
//      Union minus the movem set = d0-d4/d7/a0-a3. a3 enters via
//      Art_Decompress (NOT via BG_Init, which explicitly preserves a3).
//      d5 is written by no instruction here and by no callee license, so it
//      is NOT in the set — an earlier header carried it and made callers
//      save a register this proc never touches.
//
// The act ships one paged art pool. Each page
// is a wrapped ZX0/S4LZ blob of up to ART_POOL_PAGE_TILES (256) tiles. We
// decompress each page into Art_Staging_Buffer (8192 B, the init-only view
// over the tile-cache RAM — free before the tile cache is populated) and
// queue a Critical DMA to its fixed VRAM slot (page_index * 8192 bytes =
// page_index << 13). The whole pool is then resident for the life of the
// act, so section streaming/teleport never reloads tile art.
//
// Runs at init with the display blanked OFF (caller's responsibility): with
// the display off, DMA runs at the full ~205 bytes/line rate on EVERY line
// (the active/blank distinction disappears), so each page's Critical DMA
// drains with wide margin inside its one VSync.
//
// Loop-live registers chosen to survive BOTH callees:
//   Art_Decompress    clobbers d0-d3, a1-a3 (a4/d4 preserved)
//   QueueDMA_Critical clobbers d0-d4, a1-a2
//   VSync_Wait        clobbers d0-d2/a0-a3 (P2a-widened; a4-a6/d6/d7 untouched)
// -> a4 (act ptr), a5 (page table cursor), a6 (VRAM dest), d6 (page count-1)
//   are all untouched across the calls. d7 carries the page's byte length across
//   the queue attempt (QueueDMA_Critical clobbers d4, so a drop-retry can't
//   re-read the length from d4).
//
// Drop handling: QueueDMA_Critical's carry is consumed IMMEDIATELY
// (VSync_Wait, the next call, clobbers CCR and d0). A drop should never happen
// here — init runs display-off with an extended VBlank that drains Critical every
// VSync — so DEBUG halts on it (raise_error) and release honestly drains a frame
// and retries the same page (Art_Staging_Buffer still holds the decompressed
// data; VSync_Wait touches neither it nor a6). Both directions are testable:
// force the Critical queue full and confirm DEBUG halts / release retries + lands.
// -----------------------------------------------
pub proc Level_LoadArt (a0: *Act) clobbers(d0-d4/d7/a0-a3) preserves(d6/a4-a6) {
        movem.l d6/a4-a6, -(sp)
        movea.l a0, a4                              // a4 = act ptr (preserved)

        move.w  Act.act_art_pool_pages(a4), d6      // d6.w = page count
        beq     .done                               // empty pool -> nothing to load
        subq.w  #1, d6                              // d6 = count-1 (dbf counter)

        movea.l Act.act_art_pool_table(a4), a5      // a5 = page-address table cursor
        suba.l  a6, a6                              // a6 = VRAM byte dest, starts at 0

    .page_loop:
        movea.l (a5)+, a0                           // a0 = next page wrapper addr
        move.w  (a0), d4                            // d4.w = uncompressed size (BE)
        beq     .next                               // size 0 -> skip (empty page stub)

        lea     Art_Staging_Buffer, a1              // (Art_Staging_Buffer).l — decompress scratch
        jbsr    Art_Decompress                      // a4/d4 preserved across this
        move.w  d4, d7                              // d7 = byte length (survives QueueDMA/VSync for retry)

    .queue_page:
        move.l  #Art_Staging_Buffer, d1             // d1 = DMA source (RAM)
        moveq   #0, d2
        move.w  a6, d2                              // d2.w = VRAM byte dest
        move.w  d7, d3                              // d3.w = byte length
        jbsr    QueueDMA_Critical
        bcs     .drop_page                          // carry SET -> dropped (rare; handled out of line)
        jbsr    VSync_Wait

    .next:
        lea     ART_POOL_PAGE_BYTES(a6), a6         // advance VRAM dest one page (8192 B)
        dbf     d6, .page_loop

    .done:
        // -- §2 A.5: blit zone-wide BG to Plane B nametable (T1) --
        movea.l a4, a0                              // a0 = act ptr
        jbsr    BG_Init

        movem.l (sp)+, d6/a4-a6
        rts

    // Out-of-line drop handler — kept out of the .page_loop body so the loop's
    // forward .s branches (beq.s .done, beq.s .next) stay in range in BOTH shapes
    // despite the DEBUG raise_error expansion. Reached only on carry SET (queue
    // full), which should never happen during blanked-init load (see the header).
    .drop_page:
        if DEBUG == 1 {
            raise_error "Level_LoadArt: Critical DMA queue full during init art load"
        } else {
            jbsr    VSync_Wait                      // release: drain a frame, then retry this page
            jbra    .queue_page                     // Art_Staging_Buffer + a6 still valid
        }
}
