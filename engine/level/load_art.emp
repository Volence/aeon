// Level art loader
// The act uses a single act-wide paged art pool that is fully resident in VRAM
// for the life of the act (loaded once at init). Level_LoadArt drives that load
// through the Art-streaming page-in path (engine.page_in) so init exercises the
// same decode + landing machinery gameplay uses.
//
// Art_Decompress is the version-dispatched BLOCKING decompressor, kept for the
// DEBUG compression self-test (engine.debug.compression_selftest); Level_LoadArt
// no longer calls it — the streaming decoder ZX0R_Decompress does the work.

module engine.load_art in load_art

use engine.structs.{Act}
use engine.constants.{ART_HDR_VERSION, ART_HDR_SIZE, ART_VER_ZX0, DMA_BUDGET_BLANKED_INIT}

// Every callee is .emp-owned and resolves at link — no boundary decls:
// S4LZ_Decompress / ZX0_Decompress (engine.s4lz / engine.zx0),
// PageIn_Flush / PageIn_Enqueue (engine.page_in), BG_Init (engine.bg),
// VSync_Wait (engine.vblank).

// -----------------------------------------------
// Art_Decompress — version-dispatched blocking art decompressor.
//
// Every compressed art blob starts with the 4-byte wrapper
// [u16 BE uncompressed size][u8 flags][u8 version]:
//   version 1 (ART_VER_S4LZ) -> S4LZ_Decompress (parses the wrapper itself)
//   version 2 (ART_VER_ZX0)  -> ZX0_Decompress (wrapper skipped here)
// Callers must skip size-0 blobs BEFORE calling (empty stubs carry no
// decodable stream).
//
// Dispatch order (§2.2 — common case falls through): ZX0 is the common case
// on every production path. The two-tier split puts ZX0 on the load-time art
// tier, and every act-pool page the engine ships is a .zx0 blob
// (games/sonic4/data/generated/**/act_pool_page*.zx0); the S4LZ arm is
// reached only from the DEBUG compression self-test, which exercises both
// arms deliberately. So the ZX0 test is the not-taken branch.
//
// In:  a0 = source ROM pointer (wrapper at start, word-aligned)
//      a1 = destination buffer
// Out: a0 = past end of compressed data
// Clobbers: d0-d3, a1-a3 (the S4LZ path; of these the ZX0 path touches only
//      d0-d1 and the a1 cursor) — the exhaustive license: a4/d4 are preserved
//      on both paths and callers keep them live across the call.
//      a1 is the destination write cursor and is left wherever writing
//      stopped — not an output. The two arms do not agree on it: ZX0 always
//      produces it, but an S4LZ stream that decompresses to zero bytes never
//      writes it, leaving the caller's own dest start. The wrapper's size word
//      is the authoritative extent.
// -----------------------------------------------
pub proc Art_Decompress (a0: *u8, a1: *u8) clobbers(d0-d3/a1-a3) out(a0) {
        cmpi.b  #ART_VER_ZX0, ART_HDR_VERSION(a0)
        bne     .s4lz                           // rare arm out of line (§2.2)
        addq.l  #ART_HDR_SIZE, a0               // ZX0 stream starts past wrapper
        jbra    ZX0_Decompress
    .s4lz:
        jbra    S4LZ_Decompress                 // S4LZ_Decompress reads its own wrapper
}

// -----------------------------------------------
// Level_LoadArt — load the WHOLE act art pool to VRAM via the page-in path,
// then init BG.
//
// In:  a0 = act descriptor pointer
// Out: none
// Clobbers: d0-d2/d5-d7/a0-a4 — own writes (a4 act ptr, d5 page_id, d6 page
//      count, d7 saved budget) plus the callee licenses folded in: PageIn_Flush
//      (none), PageIn_Enqueue d2/a0, VSync_Wait d0-d2/a0-a3 (its P2a idle-decode
//      slice preserves d3-d4 via PageIn_EnqueueLanding), BG_Init d0-d1/a1-a2.
//      a4/d7 are the only registers kept live across VSync_Wait, and both sit
//      OUTSIDE VSync_Wait's d0-d2/a0-a3 set, so no movem is needed. a5-a6/d3-d4
//      are untouched (preserved by not-touching).
//
// The act ships one paged art pool: a longword page-address table + wrapped
// ZX0/raw page blobs. Each page's index is enqueued as a page-in request; the
// dispatcher (PageIn_Process, run once per frame by VSync_Wait) resolves it,
// decodes/lands it, and marks it resident. We spin VSync_Wait until every page
// has landed. The whole pool is then resident for the life of the act, so
// section streaming/teleport never reloads tile art.
//
// Runs at init with the display blanked OFF (caller's responsibility): with the
// display off, DMA runs at the full per-line rate on EVERY line, so the raised
// window budget (DMA_BUDGET_BLANKED_INIT) lets a whole 256-tile page's Important
// landing DMA drain inside one VSync. The active-display budget is restored
// before the loop returns (and before the caller enables the display).
// -----------------------------------------------
pub proc Level_LoadArt (a0: *Act) clobbers(d0-d2/d5-d7/a0-a4) {
        movea.l a0, a4                              // a4 = act ptr (kept live to BG_Init)

        // Clean page-in state at the act transition, before the pool is (re)loaded.
        jbsr    PageIn_Flush

        move.w  Act.act_art_pool_pages(a4), d6      // d6.w = page count
        beq     .bg                                 // empty pool -> straight to BG

        // Point the dispatcher at this act's page-address table (FIFO resolution base).
        move.l  Act.act_art_pool_table(a4), PageIn_Pool_Table

        // Raise the DMA window budget for the display-off bulk load: several
        // 64-tile pages' Important landing DMAs (2048 B each) drain per blanked
        // frame under the raised window (headroom above the active-display budget).
        move.w  DMA_Budget_Default, d7              // save the active-display budget
        move.w  #DMA_BUDGET_BLANKED_INIT, DMA_Budget_Default

        // Enqueue every page as a request, INCREMENTALLY (tripwire 1): at the
        // 64-tile cutover a pool is ~10+ pages > PAGEIN_QUEUE_SLOTS(8), so a
        // blind up-front enqueue would drop pages. Enqueue one page at a time; on a
        // full queue, spin a VSync_Wait to drain a slot, then retry the SAME page.
        // Nothing is dropped, at any page count.
        moveq   #0, d5                              // d5 = next page_id to enqueue
    .enq_loop:
        cmp.w   d6, d5                              // all pages enqueued?
        bge     .drain_wait
        move.w  d5, d0
        moveq   #0, d1                              // flags 0 = bulk load (not a demand miss)
        jbsr    PageIn_Enqueue                      // carry SET = queue full
        bcc     .enq_next
        jbsr    VSync_Wait                          // queue full -> drain a frame, retry same page
        jbra    .enq_loop
    .enq_next:
        addq.w  #1, d5
        jbra    .enq_loop

        // Drive the streaming path to completion. VSync_Wait runs PageIn_Process
        // each frame (decode slice + landing); the trailing VBlank drains
        // Critical/Important in the extended display-off blanking. Spin until the
        // queue is empty AND no decode is in flight/suspended/pending AND the last
        // landing has drained (Staging_Busy cleared by VInt_Level).
    .drain_wait:
        jbsr    VSync_Wait
        tst.b   PageIn_Queue_Count
        bne     .drain_wait
        tst.b   PageIn_InFlight
        bne     .drain_wait
        tst.b   PageIn_Suspended
        bne     .drain_wait
        tst.b   PageIn_Land_Pending
        bne     .drain_wait
        tst.b   PageIn_Staging_Busy
        bne     .drain_wait

        move.w  d7, DMA_Budget_Default              // restore the active-display budget

    .bg:
        // -- §2 A.5: blit zone-wide BG to Plane B nametable (T1) --
        movea.l a4, a0                              // a0 = act ptr
        jbra    BG_Init                             // tail call
}
