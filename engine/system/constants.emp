// -----------------------------------------------
// engine.constants — the shared engine constants (SOLE DEFINITION)
//
// This module is the AUTHORITATIVE source of these engine constants. `.emp`
// consumers read them via `use engine.constants`; the residual AS reads them
// at comptime through the ownership-flip export — the build harvests every
// `pub const` here and injects it as a guarded AS `-D` define (a name the
// residual AS may consume but not re-author; an in-file `=` of it is a hard
// `[defines.collision]`). engine/constants.asm no longer defines these.
//
// `VDP_Shadow_len` is EXCLUDED from this module's harvest: the AS-side symbol
// is owned by the struct-offset harvest (engine.structs' VdpShadow, the layout
// author). The `pub const` here is the `.emp`-side named immediate the flush
// loops read; a wrong value changes the emitted `moveq`, so byte-identity is the
// drift check against the struct.
//
// Pure consts: this module opens no section and emits ZERO bytes in the ROM.
// -----------------------------------------------
module engine.constants

// Controller button masks (mirrors engine/constants.asm).
pub const BUTTON_UP    = 1 << 0
pub const BUTTON_DOWN  = 1 << 1
pub const BUTTON_LEFT  = 1 << 2
pub const BUTTON_RIGHT = 1 << 3
pub const BUTTON_C     = 1 << 5
pub const BUTTON_A     = 1 << 6

// Controller button BIT NUMBERS (for `btst #BUTTON_x_BIT` — the d-pad bit
// positions; mirror engine/constants.asm).
pub const BUTTON_UP_BIT    = 0
pub const BUTTON_DOWN_BIT  = 1
pub const BUTTON_LEFT_BIT  = 2
pub const BUTTON_RIGHT_BIT = 3

// 6-button pad: extra-button masks (the Ext bytes' low nibble) + pad types.
pub const BUTTON_EXT_Z    = 1 << 0
pub const BUTTON_EXT_Y    = 1 << 1
pub const BUTTON_EXT_X    = 1 << 2
pub const BUTTON_EXT_MODE = 1 << 3
pub const PAD_3BTN = 0
pub const PAD_6BTN = 1

// Hardware controller port data registers (mirrors engine/constants.asm).
pub const HW_PORT_1_DATA = $A10003
pub const HW_PORT_2_DATA = $A10005

// Collision type: air / no surface (mirrors engine/constants.asm).
pub const CTYPE_AIR = 0

// Render flags — SST render_flags bit assignments (mirrors
// engine/constants.asm).
pub const RF_ONSCREEN  = 0            // set by Draw_Sprite if visible
pub const RF_XFLIP     = 1            // horizontal flip
pub const RF_YFLIP     = 2            // vertical flip
pub const RF_COORDMODE = 3            // 0 = world coords, 1 = screen coords
pub const RF_MULTISPRITE = 4          // (parent only) batch render via sibling walk
pub const RF_PRIORITY_SHIFT = 5       // bits 5-7 = sprite priority band (0-7)
pub const RF_PRIORITY_MASK = $E0      // the band bits themselves — a runtime band change
                                      // must clear these before or-ing the new band in

// Animation script control codes ($F7-$FF) + interpreter inputs. Animation and
// test-object data modules read these in both build shapes.
pub const AF_END       = $FF          // loop: restart from first frame
pub const AF_BACK      = $FE          // jump back N: next byte = rewind count
pub const AF_CHANGE    = $FD          // switch animation: next byte = new anim ID
pub const AF_ROUTINE   = $FC          // increment routine counter (SST_custom byte 0) by 2
pub const AF_DELETE    = $FB          // auto-despawn command
pub const AF_CALLBACK  = $FA          // call routine: dc.b $FA, target_hi, target_lo, 0
pub const AF_SOUND     = $F9          // play sound effect: dc.b $F9, sound_id
pub const AF_COLLISION = $F8          // set collision type: dc.b $F8, collision_type
pub const AF_SET_FIELD = $F7          // lowest control code — the $F7+ dispatch threshold
pub const DUR_DYNAMIC  = $FF          // duration sentinel: hold comes from caller's d3
pub const OBJ_CODE_BANK = 1           // objroutine bank hi-word (moveq/swap → $00010000)
pub const FRAME_PIECE_COUNT = 4       // sprite-frame piece-count word offset (after 4 bbox bytes)

// Object slot counts per pool (mirrors engine/constants.asm).
pub const NUM_PLAYERS = 2
pub const NUM_DYNAMIC = 40
pub const NUM_SYSTEM  = 8
pub const NUM_EFFECTS = 16

// Total slot count across all pools + culling geometry + the untagged slot
// sentinel (mirror engine/constants.asm — the object-core block).
pub const NUM_TOTAL_SLOTS = NUM_PLAYERS + NUM_DYNAMIC + NUM_SYSTEM + NUM_EFFECTS
// Occupancy overflow-latch amendment (spec §9): frame-end pending-latch
// capacity. AllocDynamic at a full live list latches the popped slot instead of
// compacting mid-frame; RunObjects' tail drains it (one compaction, then append
// in alloc order). Latch full → alloc-fail. Bounded, rare.
pub const NUM_DYNAMIC_PENDING = 8
pub const CULL_DISTANCE_X = $300      // 768px — skip dynamic objects beyond this
pub const CULL_DISTANCE_Y = $200      // 512px

// Collision response types — the full TouchResponse dispatch family (index
// into the branch table; COLLISION_NONE = air, COLLISION_TOUCH = dispatch
// ceiling).
pub const COLLISION_NONE        = 0
pub const COLLISION_ENEMY       = 1
pub const COLLISION_BOSS        = 2
pub const COLLISION_HURT        = 3
pub const COLLISION_MONITOR     = 4
pub const COLLISION_RING        = 5
pub const COLLISION_BUBBLE      = 6
pub const COLLISION_PROJECTILE  = 7
pub const COLLISION_SOLID       = 8
pub const COLLISION_SOLID_BREAK = 9
pub const COLLISION_SPRING      = 10
pub const COLLISION_SOLID_HURT  = 11
pub const COLLISION_TOUCH       = 12

// status byte bits — SST_status. Player interpretation. Bits 1-2 align with
// RF_XFLIP/RF_YFLIP for direct propagation.
pub const ST_XFLIP       = 1          // 1 = facing left (horizontal flip); = RF_XFLIP
pub const ST_YFLIP       = 2          // = RF_YFLIP — vertical flip
pub const ST_IN_AIR      = 3          // 1 = airborne (jumped or falling)
pub const ST_ROLLING     = 4          // 1 = rolled up (ball)
pub const ST_ON_OBJECT   = 5          // 1 = standing on a solid object
pub const ST_PUSHING     = 6          // 1 = pushing against a wall
pub const ST_UNDERWATER  = 7          // 1 = submerged

// Player + ball collision radii — the engine-wide DEFAULT box a game builds its
// characters' records from. The curl y-shift that used to sit here is gone: it
// is a function of a character's two boxes (stand height - ball height, halved),
// so it is derived from the record at its four player-side sites
// (curl_head_rise / curl_shift_px, games/sonic4/player/player_common.emp) and
// published to the camera through Camera_Curl_Offset. A constant here could only
// ever have been one character's.
pub const PLAYER_X_RADIUS = 9
pub const PLAYER_Y_RADIUS = 19
pub const BALL_X_RADIUS   = 7
pub const BALL_Y_RADIUS   = 14
pub const PUSH_RADIUS     = 10        // wall-push sensor half-width

// Level-edge behaviour codes (mirror engine/constants.asm).
pub const EDGE_CLAMP  = 0
pub const EDGE_WRAP_V = 1
pub const EDGE_KILL   = 2

// Player physics parameters — the values Sonic's PhysTable holds plus the shared
// movement thresholds; player state files consume them.
pub const PHYS_ACCEL            = $C
pub const PHYS_DECEL            = $80
pub const PHYS_FRICTION         = $C
pub const PHYS_TOP_SPEED        = $600
pub const PHYS_GRAVITY          = $38
pub const PHYS_JUMP_FORCE       = $680
pub const PHYS_AIR_ACCEL        = $18
pub const PHYS_JUMP_RELEASE_CAP = -$400
pub const PHYS_SKID_MIN         = $400   // min |gsp| to trigger a skid
pub const PHYS_JUMP_BUFFER      = 2      // jump-input buffer window (frames)
pub const PHYS_FALL_CAP         = $1000  // terminal fall speed
pub const PHYS_SLOPE_WALK       = $20    // walking slope-factor magnitude
pub const PHYS_SLOPE_ROLL_DOWN  = $50    // rolling downhill slope factor
pub const PHYS_SLOPE_ROLL_UP    = $14    // rolling uphill slope factor
pub const PHYS_SLOPE_STAND_MIN  = $D     // min gsp to stand on a slope
pub const PHYS_ROLL_START_MIN   = $100   // min |gsp| to start a roll
pub const PHYS_JUMP_HEADROOM    = 6      // clearance needed to jump
// Max first-frame rise = jump_force >> 8 (Sonic: $680 -> 6.5px) + 1 margin.
pub const PHYS_JUMP_SKIP_CLEARANCE = 8   // press-frame clearance that makes the
                                         // same-tick mostly-up ceiling re-probe a
                                         // guaranteed no-op (G1 skip gate)
// guards the BUILD-TIME seed only — the runtime phys table is
// section-modifiable and must never exceed it
ensure(PHYS_JUMP_SKIP_CLEARANCE * 256 > PHYS_JUMP_FORCE, "skip clearance must cover the first-frame rise")
pub const PHYS_GSP_CAP          = $1000  // ground-speed cap
pub const PHYS_ROLL_DECEL       = $20    // roll brake decel
pub const PHYS_ROLL_FRICTION    = $6     // rolling friction (half PHYS_FRICTION)
pub const PHYS_ROLL_FORCE_MIN   = $200   // min |gsp| below which a roll cannot start on flat ground
pub const PHYS_UNROLL_MAX       = $80    // max |gsp| to unroll
pub const PHYS_KEEP_ROLL_MIN    = $400   // min |gsp| to keep rolling
pub const PHYS_SLIP_SPEED       = $280   // slip threshold speed
pub const PHYS_SLIP_ANGLE       = $18    // slip angle window
pub const PHYS_FALL_ANGLE       = $30    // fall-off angle window
pub const PHYS_SLIP_NUDGE       = $80    // slip velocity nudge
pub const PHYS_MOVE_LOCK_TIME   = 30     // control-lock duration after a slip (frames)

// Ring geometry/animation. The game-VARYING ring capacity values
// (MAX_RING_BUFFER, VRAM_RING_PLACEHOLDER) stay per-profile `-D`s — a game knob.
pub const RING_HEIGHT      = 16
pub const RING_ANIM_FRAMES = 4
pub const RING_ANIM_SPEED  = 8              // frames per animation tick

// Engine-owned BUFFER FORMAT (review item 30/G). RING_BUFFER_ENTRY_SIZE
// describes the layout of an ENGINE-owned RAM buffer (Ring_Buffer) walked only
// by engine code (rings.emp / entity_window.emp / ram.emp). It is NOT a game
// knob: no game may pick a different value, yet both game configs carried
// byte-identical copies the engine then had to `ensure(extern(..))`-guard
// against. Homed here, the guard chain disappears with the duplication. Only the
// COUNT stays a game knob (MAX_RING_BUFFER, a per-profile `-D`).
// COLLECTED_SLOT_SIZE, the other moved format, lives with its own field-offset
// companions in the collected-bitmask block below.
pub const RING_BUFFER_ENTRY_SIZE = 6        // dc.w x, y; dc.b section_id, list_index

// Driver-keyed BG tile-band animation (engine/level/bg_anim.emp). This sizes
// engine/ram.emp's BgAnim_LastStep array, which is why it exists here at all —
// ram.emp cannot import a CODE module's consts at comptime.
//
// DELIBERATE MIRROR, not a single authority: bg_anim.emp keeps its OWN
// module-local BGANIM_MAX_BANDS and must keep it. `bg_anim_port` lowers that file
// standalone against an empty symbol table, and the constant harvest turns names
// from this module into LINK EQUATES rather than comptime constants — so a
// `use engine.constants.{BGANIM_MAX_BANDS}` there compiles to an unresolved fixup
// and breaks the standalone gate. Collapsing the two needs a comptime ram->code
// import path that does not exist.
//
// THERE ARE THREE AUTHORITIES, NOT TWO, AND THEY ARE GATED — do not sync by hand. This const,
// bg_anim.emp's module-local mirror, and tools/inject_editor_bg.py's literal (the emitter — the
// RELEASE defense, since bg_anim's own assert is DEBUG-only). engine/ram.emp NAMES this constant,
// so it is a consumer and cannot drift. tools/test_bg_emit.py::TestBgAnimBandCeiling reads all
// three and fails on disagreement, on build.sh's pytest lane. RAISING THE CEILING MEANS EDITING
// ALL THREE; the gate will tell you which you missed.
pub const BGANIM_MAX_BANDS = 4              // animated BG strips per act

// Section / level geometry, shared by entity_window + act_descriptor + section.
// SEC_VOID = flat section-id sentinel ("no section here").
pub const SECTION_SIZE       = $0800        // section width/height in world px
pub const SECTION_SIZE_SHIFT = 11           // log2(SECTION_SIZE)
pub const SEC_VOID           = $FF          // sentinel flat section id (void cell)

// 2D tile-cache geometry (mirrors engine/constants.asm). Consolidated here at
// the shared-struct-module batch: section.emp + tile_cache.emp both mirrored
// these four the same way — the 2nd-consumer kill condition, so they move to
// the shared twin (the SECTION_SIZE precedent). The COLL_*/BLOCK_* derivatives
// stay file-local in tile_cache (single consumer).
pub const TILE_CACHE_COLS    = 80                                 // viewport 40 + margin 20×2
pub const TILE_CACHE_ROWS    = 60                                 // viewport 28 + margin 16×2
pub const TILE_CACHE_STRIDE  = TILE_CACHE_COLS                    // row stride (cols)
pub const TILE_CACHE_NT_SIZE = TILE_CACHE_COLS * TILE_CACHE_ROWS * 2  // 9600 bytes

// DMA-queue geometry — slot counts per priority sub-queue; the total is the
// derived sum.
pub const DMA_CRITICAL_SLOTS   = 8
pub const DMA_IMPORTANT_SLOTS  = 12
pub const DMA_DEFERRABLE_SLOTS = 12
pub const DMA_TOTAL_SLOTS      = DMA_CRITICAL_SLOTS + DMA_IMPORTANT_SLOTS + DMA_DEFERRABLE_SLOTS

// Act art-pool paging + compressed-art wrapper. Every compressed art blob starts
// with the 4-byte wrapper [u16 BE uncompressed size][u8 flags][u8 version].
pub const ART_POOL_PAGE_TILES = 64          // tiles per pool page (P2b cutover 256->64; matches ojz_strip_gen)
pub const ART_HDR_VERSION     = 3           // byte offset of version within wrapper
pub const ART_HDR_SIZE        = 4           // wrapper bytes ahead of the stream
pub const ART_VER_S4LZ        = 1           // S4LZ v3 token stream (runtime tier)
pub const ART_VER_ZX0         = 2           // ZX0 modern/V2 bitstream (load-time tier)

// Manifest v2 (P2b): the act's page-address table (Act.act_art_pool_table) is now
// a stride-`sizeof(PageManifest)` array of {source.l, tiles.w, form.b, flags.b}.
// PageIn_Process strides it and dispatches on the form byte (not the wrapper
// version). pm_form values / pm_flags bits:
pub const ART_PAGE_FORM_ZX0    = 0          // ZX0 stream (wrapper + salvador bitstream, staged decode)
pub const ART_PAGE_FORM_RAW    = 1          // raw-direct (uncompressed payload, DMA straight from ROM)
pub const ART_PAGE_FLAG_PINNED = 1 << 0     // never-evict act-common page (P2b residency cache)
pub const ART_PAGE_FLAG_PINNED_BIT = 0      // btst-form twin (house mask+_BIT pattern, cf. PF_PINNED_BIT)
pub const PAGE_TABLE_MAX       = 256        // residency page-table ceiling (matches ojz_strip_gen)

// Residency cache (P2b Task 6, engine.page_cache). The FG VRAM art region is
// carved into PAGE_FRAMES fixed 64-tile frames; the page table maps a global
// page id -> the frame holding it (or PAGE_NOT_RESIDENT). POOL_TILE_CEILING(960)
// / ART_POOL_PAGE_TILES(64) = 15 frames span the whole FG art window.
pub const PAGE_FRAMES        = POOL_TILE_CEILING / ART_POOL_PAGE_TILES   // 15
ensure(PAGE_FRAMES * ART_POOL_PAGE_TILES == POOL_TILE_CEILING,
       "PAGE_FRAMES*ART_POOL_PAGE_TILES must tile the FG art window exactly")
// CAPACITY, deliberately split from the COUNT above (user style ruling
// 2026-08-11). PAGE_FRAMES sizes two RAM arrays (Page_Frames,
// Page_Audit_Scratch — the latter debug-only), so before this split a pool
// resize was secretly a RAM-LAYOUT change: 960->896 slid every debug cell
// below the scratch array by -2, moved 126 pins, and desynced the replay
// fixtures on a behaviour-identical build. The arrays are now sized by this
// fixed capacity and PAGE_FRAMES is just the live count, so POOL_TILE_CEILING
// is a genuinely VRAM-only knob. Cost: (PAGE_FRAMES_MAX - PAGE_FRAMES) slots
// of RAM slack (10 bytes at 14/15) — bought deliberately, do not "reclaim" it.
// Raising the capacity IS a RAM-layout change and owes the full pin/goldens
// ritual; that is the point — you pay it when you CHOOSE to, not as a side
// effect of a VRAM budget edit.
pub const PAGE_FRAMES_MAX    = 15
ensure(PAGE_FRAMES <= PAGE_FRAMES_MAX,
       "PAGE_FRAMES exceeds PAGE_FRAMES_MAX — raise the capacity (a deliberate RAM-layout change owing the pin/goldens ritual), do not shrink the pool's count math")
pub const PAGE_NOT_RESIDENT  = $FF          // Page_Table sentinel + free-link terminator
// pf_flags bits (engine.structs PageFrame):
pub const PF_PINNED_BIT      = 0            // never a victim (build-marked act-common page)
pub const PF_EVICTABLE_BIT   = 1            // frame is an eviction candidate (assigned, refcount 0,
                                            // unpinned, stamped) — F-1 stamp eviction; set on
                                            // Unref 1->0 + speculative publish, cleared on Ref 0->1
pub const PF_PINNED          = 1 << PF_PINNED_BIT
pub const PF_EVICTABLE       = 1 << PF_EVICTABLE_BIT
// The tile-index field of a nametable word (bits 0-10); bits 11-15 are pal/pri/flip.
pub const NT_TILE_MASK       = $07FF
pub const NT_ATTR_MASK       = $F800
// A resident physical tile index >> PAGE_FRAME_TILE_SHIFT yields its frame id;
// (index & PAGE_FRAME_TILE_MASK) is the intra-frame tile (0..63). 64 = 2^6.
pub const PAGE_FRAME_TILE_SHIFT = 6
pub const PAGE_FRAME_TILE_MASK  = ART_POOL_PAGE_TILES - 1                // 63
ensure((1 << PAGE_FRAME_TILE_SHIFT) == ART_POOL_PAGE_TILES,
       "PAGE_FRAME_TILE_SHIFT must equal log2(ART_POOL_PAGE_TILES)")
// DEBUG residency audit cadence: recompute per-frame refcounts from the whole
// Tile_Cache_Nametable every PAGECACHE_AUDIT_INTERVAL LOGIC TICKS during play.
// Chosen large enough that the ~4800-word walk's one-tick cost is a rare,
// identifiable spike (it perturbs ONLY the DEBUG shape's Lag_Frame_Count —
// measure lag on the non-audit ticks). The gate lives in the level state's tick,
// right after Tile_Cache_Fill returns (fix F5 — it used to be gated INSIDE the
// fill, which charged the ~110,000-cycle pass to the routine the streaming arc
// measures). The audit also runs unconditionally at level init.
pub const PAGECACHE_AUDIT_INTERVAL = 128

// Page-in request FIFO (Art-streaming P2a, engine.page_in). The dispatcher pops
// one request per idle slice, resolving page_id -> source/dest via the act's
// page-address table. Demand requests dequeue before prefetch (two-pass scan).
pub const PAGEIN_QUEUE_SLOTS  = 8           // request FIFO depth (S3K ~4-deep + headroom)
pub const PGRQ_DEMAND_BIT     = 0           // request flags: bit set = demand (dequeue first)
pub const PGRQ_DEMAND         = 1 << PGRQ_DEMAND_BIT
pub const PGRQ_BULK_BIT       = 1           // init bulk load: non-speculative (D3-gate-exempt) but still evictable (stamp-scanned)
pub const PGRQ_BULK           = 1 << PGRQ_BULK_BIT
pub const PGRQ_PREFETCH       = 0           // speculative: NO flag bits (dequeues after demand; the ONLY gated class)

// Page prefetch (Art-streaming P2b Task 7). When the tile-cache fill's leading edge
// advances, the page prefetch collects the ahead-strip's referenced pages (via the
// staged-block LOCAL words map through the same per-word local->global path) and Requests non-resident
// ones. Bounded per frame so a burst never floods the DMA window.
pub const PAGE_PREFETCH_MAX   = 2           // max prefetch enqueues attempted per frame

// STRESS_EVICT forced-eviction dev fixture (Task 7). The build define STRESS_EVICT
// (0 in every shipped shape; 1 only in the off-canonical `stress_evict` dev profile)
// clamps the usable frame count so OJZ's 10 pages can NO LONGER all be resident (4
// pinned pages 0/1/8/9 + 5 dynamic frames), forcing continuous evict/reload traffic
// through every path. PageCache_Init threads only PAGE_FRAMES_CLAMP frames into the
// free list; the remaining frame RECORDS stay initialized (audit-clean, unassigned)
// but unreachable. Byte-INERT at STRESS_EVICT=0 (PAGE_FRAMES_CLAMP == PAGE_FRAMES).
//
// CALIBRATION HISTORY (the fixture floor for OJZ is 9; overseer ruling, chain 78).
// OJZ is a hard case for a forced-eviction fixture: dedup makes the working set
// ~= the pool (T7's established conclusion — there is no stable *sustained-churn*
// regime on OJZ; genuine churn coverage comes from Task 11's stress-uniquify
// fixture, which manufactures a working set larger than the frame count). So the
// clamp is a calibration against OJZ's marginal boundary, not a churn generator:
//   6 (4 pinned + 2 dynamic): livelocked at init pre-watchdog — the fill needs >2
//       dynamic pages at once, so pages thrashed through 2 frames, fill never
//       completed (black screen). Retired.
//   7 (+ 3 dynamic): deterministic, LOUD thrash — used as the working-set-violation
//       probe (the stall watchdog / AllocFrame assert NAMES it instead of hanging).
//   8 (+ 4 dynamic): MARGINAL — sits exactly on OJZ's working-set boundary, so it
//       tips into AllocFrame thrash under small prefetch-timing shifts (e.g. NIT-1's
//       skip-arm un-suppression raised speculative traffic just enough). Not a
//       defect: boundary marginality, correctly detected loudly.
//   9 (+ 5 dynamic): kept as the fixture floor, but NOT a stable churn regime —
//       clamp 9 still thrashed the diagonal seam. STRUCTURAL finding (overseer,
//       final): the refcount source is the whole 80x60 Tile_Cache_Nametable window
//       (multi-screen), and on OJZ's deduped 10-page pool any window references
//       ~every page, so the cache-window working set == the pool. Refcount-based
//       eviction therefore cannot sustain churn at ANY clamp < PAGE_FRAMES on a small
//       deduped act (chain-74's clean run at 8 was traversal luck). The audits stay
//       clean through every thrash (recount == stored), proving the refs are genuine
//       window references, not leaks — the AllocFrame assert correctly REFUSES to
//       evict displayed art. This is the design being right: streaming exists for acts
//       whose windows CAN'T span the pool; OJZ is not one. So on OJZ this fixture
//       serves as a loud thrash-CANARY (zero silent corruption), not a churn generator.
//       Sustained-churn coverage = Task 11's stress-uniquify fixture (window << pool).
// If a working set ever exceeds the dynamic frames, the stall watchdog
// (Tile_Cache_Fill, DEBUG) NAMES it instead of hanging.
pub const STRESS_EVICT_FRAMES = 9
pub const PAGE_FRAMES_CLAMP   = PAGE_FRAMES - STRESS_EVICT * (PAGE_FRAMES - STRESS_EVICT_FRAMES)
ensure(PAGE_FRAMES_CLAMP >= 1 && PAGE_FRAMES_CLAMP <= PAGE_FRAMES,
       "PAGE_FRAMES_CLAMP must be in [1, PAGE_FRAMES] (check STRESS_EVICT_FRAMES)")

// Demand-stall watchdog (Task 7, DEBUG). If the tile-cache fill's demand stall
// (Cache_Art_Stall) persists unresolved for this many consecutive frames, the engine
// raise_errors instead of hanging on a silent black screen — a livelock where the
// working set exceeds the available dynamic frames must be LOUD (the plan's soak gate
// requires "no deadlock in the demand-stall path"). ~5 seconds at 60 Hz.
pub const STALL_WATCHDOG_FRAMES = 300

// VRAM fixed-region byte addresses + plane geometry.
pub const VRAM_SPRITE_TABLE = $B800         // relocated from $D800 to free plane rows 48-63
pub const VRAM_HSCROLL_TABLE = $BC00        // relocated from $DC00 (was inside Plane A 64x64 nametable)
pub const VRAM_PLANE_B_BYTES = $E000        // Plane B nametable VRAM byte address (bg/plane_buffer/section)
pub const PLANE_H_CELLS     = 64

// VDP sprite-table geometry.
pub const MAX_VDP_SPRITES     = 80
pub const VDP_SPRITE_X_OFFSET = 128         // VDP adds 128 to sprite X
pub const VDP_SPRITE_Y_OFFSET = 128         // VDP adds 128 to sprite Y

// Sprite priority-band + scanline budgeting geometry.
pub const PRIORITY_BANDS        = 8
pub const SPRITES_PER_BAND      = 32
pub const SCANLINE_BANDS        = 7         // 224 / 32 = 7 bands of 32 scanlines
pub const SCANLINE_SPRITE_LIMIT = 24        // max sprite pieces per band

// Visible screen dimensions in pixels (mirror engine/constants.asm).
pub const SCREEN_WIDTH  = 320
pub const SCREEN_HEIGHT = 224

// Half-screen camera offsets (screen centre = camera lock point; consumed by
// camera + ojz_scroll_test). = SCREEN_WIDTH/2 and (SCREEN_HEIGHT-visible-strip)/2.
pub const CAM_SCREEN_HALF_W = 160
pub const CAM_SCREEN_HALF_H = 112

// Visible screen extent in 8px tiles (camera/tile-cache edge math).
pub const SCREEN_TILES_W = SCREEN_WIDTH >> 3    // 40
pub const SCREEN_TILES_H = SCREEN_HEIGHT >> 3   // 28

// --- Art-streaming camera soft-clamp (P2c Task 10) ---
// When a demand-stalled tile-cache fill leaves not-yet-resident art within
// CLAMP_MARGIN_TILES tiles of the visible screen edge on an axis, that axis is
// HELD (max step 0) until the stall resolves — the honorable S3K-gate
// degradation (the camera waits; player logic runs untouched). tile_cache.emp
// sets the per-axis bits at its two demand-stall sites, camera.emp consumes them,
// and the fill re-derives the whole word fresh each pass so it clears the frame
// the stall resolves. On OJZ the demand-stall path fires only transiently (the
// cache working set == the pool), so in normal play the word stays 0 and the
// camera never holds; the fixture (STRESS_EVICT/STRESS_ART) is where it engages.
pub const CLAMP_MARGIN_TILES = 4                // edge slack (tiles) before a hold engages
pub const ART_HOLD_X_BIT     = 0                // Camera_Art_Hold: X axis held
pub const ART_HOLD_Y_BIT     = 1                // Camera_Art_Hold: Y axis held

// Sprite-frame precomputed bbox byte offsets + first-piece offset (mirror
// engine/constants.asm; FRAME_PIECE_COUNT above completes the header layout).
pub const FRAME_BBOX_X_MIN = 0              // signed byte — leftmost piece pixel
pub const FRAME_BBOX_X_MAX = 1              // signed byte — rightmost piece pixel
pub const FRAME_BBOX_Y_MIN = 2              // signed byte — topmost piece pixel
pub const FRAME_BBOX_Y_MAX = 3              // signed byte — bottommost piece pixel
pub const FRAME_PIECES     = 6              // byte offset to first piece datum

// -----------------------------------------------
// Hardware addresses (memory-mapped MD peripherals).
// -----------------------------------------------
pub const Z80_RAM         = $A00000
pub const Z80_RAM_END     = $A02000     // 8 KB
pub const Z80_BUS_REQUEST = $A11100
pub const Z80_RESET       = $A11200

pub const VDP_DATA        = $C00000     // VDP data port
pub const VDP_CTRL        = $C00004     // VDP control port

// Reg $0C's BOOT value, named because two modules depend on it and neither could say so.
// engine/system/boot_data.emp writes it into the positional VDP register table; the raster
// DSL's reg_sh_on()/reg_sh_off() build their register writes on top of it, since
// Shadow/Highlight is bit 3 of the same register that selects H40. A resolution change here
// silently changes what every raster band edge writes, and that dependency used to live in a
// COMMENT claiming a pin it did not have (2026-08-18 substrate sweep, Tier 4).
//
// IT LIVES HERE, not in boot_data, deliberately. boot_data EMITS BYTES, so importing it from
// raster_dsl drags a data module into every isolated *_port harness that compiles the DSL —
// which is exactly how the first spelling of this pin broke four port tests that build.sh
// cannot see. A register default is a constant, and constants.emp is already every port
// harness's dependency.
pub const VDP_REG_0C_BOOT = $81         // $0C: H40 (320px), no interlace
pub const VDP_HV_COUNTER  = $C00008
pub const PSG_PORT        = $C00011

pub const HW_VERSION            = $A10001
pub const HW_PORT_EXP_DATA      = $A10007
pub const HW_PORT_1_CTRL        = $A10009
pub const HW_PORT_2_CTRL        = $A1000B
pub const HW_EXPANSION_CTRL     = $A1000D
pub const HW_PORT_A_CTRL_FULL   = $A10008
pub const HW_EXPANSION_CTRL_FULL = $A1000C

pub const TMSS_REGISTER   = $A14000

pub const YM2612_A0       = $A04000
pub const YM2612_D0       = $A04001
pub const YM2612_A1       = $A04002
pub const YM2612_D1       = $A04003

