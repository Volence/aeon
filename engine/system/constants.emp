// -----------------------------------------------
// engine.constants — the shared-constants twin
//
// engine/constants.asm stays authoritative until its own port; this module
// mirrors the handful of values today's .emp files need at comptime, so a
// `use engine.constants` gets the same names as the `.asm` side without
// re-declaring them per file. Every mirrored value carries an `ensure`
// drift guard reading the real AS-side equ back through `extern()` — if
// constants.asm ever changes without this twin following, the LINK fails
// naming the drifted constant instead of silently emitting stale bytes.
//
// Pure consts + item-position ensures only: this module opens no section
// and emits ZERO bytes anywhere in the ROM.
// -----------------------------------------------
module engine.constants

// Controller button masks (mirrors engine/constants.asm).
pub const BUTTON_UP    = 1 << 0
pub const BUTTON_DOWN  = 1 << 1
pub const BUTTON_LEFT  = 1 << 2
pub const BUTTON_RIGHT = 1 << 3

// Hardware controller port data registers (mirrors engine/constants.asm).
pub const HW_PORT_1_DATA = $A10003
pub const HW_PORT_2_DATA = $A10005

// Collision type: air / no surface (mirrors engine/constants.asm).
pub const CTYPE_AIR = 0

// Render flags — SST render_flags bit assignments (mirrors
// engine/constants.asm).
pub const RF_ONSCREEN  = 0            // set by Draw_Sprite if visible
pub const RF_XFLIP     = 1            // horizontal flip
pub const RF_YFLIP     = 2            // vertical flip
pub const RF_COORDMODE = 3            // 0 = world coords, 1 = screen coords
pub const RF_MULTISPRITE = 4          // (parent only) batch render via sibling walk
pub const RF_PRIORITY_SHIFT = 5       // bits 5-7 = sprite priority band (0-7)

// Animation script commands + interpreter inputs (mirror engine/constants.asm
// — the AF_* AS truth re-homed there at the animate port so script DATA files
// survive the SIGIL_EMP_ANIMATE gate; kill-list row 2, dies at row 1's flip).
// Consumed values only: AF_CHANGE/ROUTINE/CALLBACK/SOUND/COLLISION have no
// .emp consumer yet and stay unmirrored.
pub const AF_END       = $FF          // loop: restart from first frame
pub const AF_BACK      = $FE          // jump back N: next byte = rewind count
pub const AF_DELETE    = $FB          // auto-despawn command
pub const AF_SET_FIELD = $F7          // lowest control code — the $F7+ dispatch threshold
pub const DUR_DYNAMIC  = $FF          // duration sentinel: hold comes from caller's d3
pub const OBJ_CODE_BANK = 1           // objroutine bank hi-word (moveq/swap → $00010000)
pub const FRAME_PIECE_COUNT = 4       // sprite-frame piece-count word offset (after 4 bbox bytes)

// Object slot counts per pool (mirrors engine/constants.asm).
pub const NUM_PLAYERS = 2
pub const NUM_DYNAMIC = 40
pub const NUM_SYSTEM  = 8
pub const NUM_EFFECTS = 16

// Total slot count across all pools + culling geometry + the untagged slot
// sentinel (mirror engine/constants.asm — the object-core block, tranche 10).
pub const NUM_TOTAL_SLOTS = NUM_PLAYERS + NUM_DYNAMIC + NUM_SYSTEM + NUM_EFFECTS
// Occupancy amendment A2 (overflow latch, spec §9): frame-end pending-latch
// capacity. AllocDynamic at a full live list latches the popped slot instead of
// compacting mid-frame; RunObjects' tail drains it (one compaction, then append
// in alloc order). Latch full → alloc-fail. Bounded, rare.
pub const NUM_DYNAMIC_PENDING = 8
pub const CULL_DISTANCE_X = $300      // 768px — skip dynamic objects beyond this
pub const CULL_DISTANCE_Y = $200      // 512px
pub const SLOT_TAG_UNTAGGED = $FF     // AllocDynamic tags a fresh slot untagged

// Collision response types (mirrors engine/constants.asm). Only the
// dispatch ceiling is mirrored — the rest of the type family stays
// AS-owned until a consumer needs it at comptime.
pub const COLLISION_TOUCH = 12

// status byte bits — SST_status (mirrors engine/constants.asm).
// Player interpretation:
pub const ST_IN_AIR      = 3          // 1 = airborne (jumped or falling)
pub const ST_ON_OBJECT   = 5          // 1 = standing on a solid object

// Ring geometry/animation (mirrors engine/constants.asm:401-403; the
// game-owned ring capacity constants live module-local in rings.emp —
// they are engine.inc game-CONTRACT symbols, not engine constants).
pub const RING_HEIGHT      = 16
pub const RING_ANIM_FRAMES = 4
pub const RING_ANIM_SPEED  = 8              // frames per animation tick

// Section / level geometry (mirrors engine/constants.asm). Consolidated here
// at the tranche-15 section.emp port: SECTION_SIZE_SHIFT reached its 3rd .emp
// consumer (entity_window + act_descriptor + section), tripping row-22/row-8's
// "consolidate on a 2nd consumer" kill condition. SECTION_SIZE moves with its
// shift partner and SEC_VOID with the family so entity_window's mirror clears
// whole. SEC_VOID = flat section-id sentinel ("no section here").
pub const SECTION_SIZE       = $0800        // section width/height in world px
pub const SECTION_SIZE_SHIFT = 11           // log2(SECTION_SIZE)
pub const SEC_VOID           = $FF          // sentinel flat section id (void cell)

// VDP sprite-table geometry (mirrors engine/constants.asm — hoisted there
// from sprites.asm at the tranche-11 sprites.emp port so it survives the
// SIGIL_EMP_SPRITES gate for the gate-off rings.asm twin; kill-list row 17
// → row-1 class).
pub const MAX_VDP_SPRITES     = 80
pub const VDP_SPRITE_X_OFFSET = 128         // VDP adds 128 to sprite X
pub const VDP_SPRITE_Y_OFFSET = 128         // VDP adds 128 to sprite Y

// Sprite priority-band + scanline budgeting geometry (mirror
// engine/constants.asm — first consumed at the tranche-11 sprites.emp port).
pub const PRIORITY_BANDS        = 8
pub const SPRITES_PER_BAND      = 32
pub const SCANLINE_BANDS        = 7         // 224 / 32 = 7 bands of 32 scanlines
pub const SCANLINE_SPRITE_LIMIT = 24        // max sprite pieces per band

// Visible screen dimensions in pixels (mirror engine/constants.asm).
pub const SCREEN_WIDTH  = 320
pub const SCREEN_HEIGHT = 224

// Sprite-frame precomputed bbox byte offsets + first-piece offset (mirror
// engine/constants.asm; FRAME_PIECE_COUNT above completes the header layout).
pub const FRAME_BBOX_X_MIN = 0              // signed byte — leftmost piece pixel
pub const FRAME_BBOX_X_MAX = 1              // signed byte — rightmost piece pixel
pub const FRAME_BBOX_Y_MIN = 2              // signed byte — topmost piece pixel
pub const FRAME_BBOX_Y_MAX = 3              // signed byte — bottommost piece pixel
pub const FRAME_PIECES     = 6              // byte offset to first piece datum

// VDP shadow-table length: 19 shadowed registers, $00-$12 (mirrors
// engine/structs.asm's VDP_Shadow struct length — struct-generated `_len`
// symbols export over the same equ seam, so the guard below reads the real
// layout-derived value, and structs.asm's own `<> 19` guard double-locks it).
pub const VDP_Shadow_len = 19

// -----------------------------------------------
// Drift guards — engine/constants.asm is the source of truth; these compare
// this twin's values against the real AS-side equs through the link-symbol
// seam (D2.27). A mismatch fails the link naming the drifted constant.
// -----------------------------------------------
ensure(extern("BUTTON_UP") == BUTTON_UP, "engine/constants.asm and engine/constants.emp disagree on BUTTON_UP — update the twin")
ensure(extern("BUTTON_DOWN") == BUTTON_DOWN, "engine/constants.asm and engine/constants.emp disagree on BUTTON_DOWN — update the twin")
ensure(extern("BUTTON_LEFT") == BUTTON_LEFT, "engine/constants.asm and engine/constants.emp disagree on BUTTON_LEFT — update the twin")
ensure(extern("BUTTON_RIGHT") == BUTTON_RIGHT, "engine/constants.asm and engine/constants.emp disagree on BUTTON_RIGHT — update the twin")
ensure(extern("HW_PORT_1_DATA") == HW_PORT_1_DATA, "engine/constants.asm and engine/constants.emp disagree on HW_PORT_1_DATA — update the twin")
ensure(extern("HW_PORT_2_DATA") == HW_PORT_2_DATA, "engine/constants.asm and engine/constants.emp disagree on HW_PORT_2_DATA — update the twin")
ensure(extern("CTYPE_AIR") == CTYPE_AIR, "engine/constants.asm and engine/constants.emp disagree on CTYPE_AIR — update the twin")
ensure(extern("RF_COORDMODE") == RF_COORDMODE, "engine/constants.asm and engine/constants.emp disagree on RF_COORDMODE — update the twin")
ensure(extern("RF_PRIORITY_SHIFT") == RF_PRIORITY_SHIFT, "engine/constants.asm and engine/constants.emp disagree on RF_PRIORITY_SHIFT — update the twin")
ensure(extern("AF_END") == AF_END, "engine/constants.asm and engine/constants.emp disagree on AF_END — update the twin")
ensure(extern("AF_BACK") == AF_BACK, "engine/constants.asm and engine/constants.emp disagree on AF_BACK — update the twin")
ensure(extern("AF_DELETE") == AF_DELETE, "engine/constants.asm and engine/constants.emp disagree on AF_DELETE — update the twin")
ensure(extern("AF_SET_FIELD") == AF_SET_FIELD, "engine/constants.asm and engine/constants.emp disagree on AF_SET_FIELD — update the twin")
ensure(extern("DUR_DYNAMIC") == DUR_DYNAMIC, "engine/constants.asm and engine/constants.emp disagree on DUR_DYNAMIC — update the twin")
ensure(extern("OBJ_CODE_BANK") == OBJ_CODE_BANK, "engine/constants.asm and engine/constants.emp disagree on OBJ_CODE_BANK — update the twin")
ensure(extern("FRAME_PIECE_COUNT") == FRAME_PIECE_COUNT, "engine/constants.asm and engine/constants.emp disagree on FRAME_PIECE_COUNT — update the twin")
ensure(extern("NUM_PLAYERS") == NUM_PLAYERS, "engine/constants.asm and engine/constants.emp disagree on NUM_PLAYERS — update the twin")
ensure(extern("NUM_DYNAMIC") == NUM_DYNAMIC, "engine/constants.asm and engine/constants.emp disagree on NUM_DYNAMIC — update the twin")
ensure(extern("NUM_SYSTEM") == NUM_SYSTEM, "engine/constants.asm and engine/constants.emp disagree on NUM_SYSTEM — update the twin")
ensure(extern("NUM_EFFECTS") == NUM_EFFECTS, "engine/constants.asm and engine/constants.emp disagree on NUM_EFFECTS — update the twin")
ensure(extern("NUM_TOTAL_SLOTS") == NUM_TOTAL_SLOTS, "engine/constants.asm and engine/constants.emp disagree on NUM_TOTAL_SLOTS — update the twin")
ensure(extern("NUM_DYNAMIC_PENDING") == NUM_DYNAMIC_PENDING, "engine/constants.asm and engine/constants.emp disagree on NUM_DYNAMIC_PENDING — update the twin")
ensure(extern("CULL_DISTANCE_X") == CULL_DISTANCE_X, "engine/constants.asm and engine/constants.emp disagree on CULL_DISTANCE_X — update the twin")
ensure(extern("CULL_DISTANCE_Y") == CULL_DISTANCE_Y, "engine/constants.asm and engine/constants.emp disagree on CULL_DISTANCE_Y — update the twin")
ensure(extern("SLOT_TAG_UNTAGGED") == SLOT_TAG_UNTAGGED, "engine/constants.asm and engine/constants.emp disagree on SLOT_TAG_UNTAGGED — update the twin")
ensure(extern("COLLISION_TOUCH") == COLLISION_TOUCH, "engine/constants.asm and engine/constants.emp disagree on COLLISION_TOUCH — update the twin")
ensure(extern("ST_IN_AIR") == ST_IN_AIR, "engine/constants.asm and engine/constants.emp disagree on ST_IN_AIR — update the twin")
ensure(extern("ST_ON_OBJECT") == ST_ON_OBJECT, "engine/constants.asm and engine/constants.emp disagree on ST_ON_OBJECT — update the twin")
ensure(extern("VDP_Shadow_len") == VDP_Shadow_len, "engine/structs.asm's VDP_Shadow struct and engine/constants.emp disagree on VDP_Shadow_len — update the twin")
ensure(extern("SECTION_SIZE") == SECTION_SIZE, "engine/constants.asm and engine/constants.emp disagree on SECTION_SIZE — update the twin")
ensure(extern("SECTION_SIZE_SHIFT") == SECTION_SIZE_SHIFT, "engine/constants.asm and engine/constants.emp disagree on SECTION_SIZE_SHIFT — update the twin")
ensure(extern("SEC_VOID") == SEC_VOID, "engine/constants.asm and engine/constants.emp disagree on SEC_VOID — update the twin")
ensure(extern("RING_HEIGHT") == RING_HEIGHT, "engine/constants.asm and engine/constants.emp disagree on RING_HEIGHT — update the twin")
ensure(extern("RING_ANIM_FRAMES") == RING_ANIM_FRAMES, "engine/constants.asm and engine/constants.emp disagree on RING_ANIM_FRAMES — update the twin")
ensure(extern("RING_ANIM_SPEED") == RING_ANIM_SPEED, "engine/constants.asm and engine/constants.emp disagree on RING_ANIM_SPEED — update the twin")
ensure(extern("MAX_VDP_SPRITES") == MAX_VDP_SPRITES, "engine/constants.asm and engine/constants.emp disagree on MAX_VDP_SPRITES — update the twin")
ensure(extern("VDP_SPRITE_X_OFFSET") == VDP_SPRITE_X_OFFSET, "engine/constants.asm and engine/constants.emp disagree on VDP_SPRITE_X_OFFSET — update the twin")
ensure(extern("VDP_SPRITE_Y_OFFSET") == VDP_SPRITE_Y_OFFSET, "engine/constants.asm and engine/constants.emp disagree on VDP_SPRITE_Y_OFFSET — update the twin")
ensure(extern("RF_ONSCREEN") == RF_ONSCREEN, "engine/constants.asm and engine/constants.emp disagree on RF_ONSCREEN — update the twin")
ensure(extern("RF_XFLIP") == RF_XFLIP, "engine/constants.asm and engine/constants.emp disagree on RF_XFLIP — update the twin")
ensure(extern("RF_YFLIP") == RF_YFLIP, "engine/constants.asm and engine/constants.emp disagree on RF_YFLIP — update the twin")
ensure(extern("RF_MULTISPRITE") == RF_MULTISPRITE, "engine/constants.asm and engine/constants.emp disagree on RF_MULTISPRITE — update the twin")
ensure(extern("PRIORITY_BANDS") == PRIORITY_BANDS, "engine/constants.asm and engine/constants.emp disagree on PRIORITY_BANDS — update the twin")
ensure(extern("SPRITES_PER_BAND") == SPRITES_PER_BAND, "engine/constants.asm and engine/constants.emp disagree on SPRITES_PER_BAND — update the twin")
ensure(extern("SCANLINE_BANDS") == SCANLINE_BANDS, "engine/constants.asm and engine/constants.emp disagree on SCANLINE_BANDS — update the twin")
ensure(extern("SCANLINE_SPRITE_LIMIT") == SCANLINE_SPRITE_LIMIT, "engine/constants.asm and engine/constants.emp disagree on SCANLINE_SPRITE_LIMIT — update the twin")
ensure(extern("SCREEN_WIDTH") == SCREEN_WIDTH, "engine/constants.asm and engine/constants.emp disagree on SCREEN_WIDTH — update the twin")
ensure(extern("SCREEN_HEIGHT") == SCREEN_HEIGHT, "engine/constants.asm and engine/constants.emp disagree on SCREEN_HEIGHT — update the twin")
ensure(extern("FRAME_BBOX_X_MIN") == FRAME_BBOX_X_MIN, "engine/constants.asm and engine/constants.emp disagree on FRAME_BBOX_X_MIN — update the twin")
ensure(extern("FRAME_BBOX_X_MAX") == FRAME_BBOX_X_MAX, "engine/constants.asm and engine/constants.emp disagree on FRAME_BBOX_X_MAX — update the twin")
ensure(extern("FRAME_BBOX_Y_MIN") == FRAME_BBOX_Y_MIN, "engine/constants.asm and engine/constants.emp disagree on FRAME_BBOX_Y_MIN — update the twin")
ensure(extern("FRAME_BBOX_Y_MAX") == FRAME_BBOX_Y_MAX, "engine/constants.asm and engine/constants.emp disagree on FRAME_BBOX_Y_MAX — update the twin")
ensure(extern("FRAME_PIECES") == FRAME_PIECES, "engine/constants.asm and engine/constants.emp disagree on FRAME_PIECES — update the twin")
