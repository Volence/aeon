// -----------------------------------------------
// VDP access-type bit patterns (feed the AS `vdpComm` `(type & rwd)` derivation
// and engine.vdp's target_bits / op_bits mappers — the .emp-native vocabulary).
// -----------------------------------------------
pub const VRAM  = %100001
pub const CRAM  = %101011
pub const VSRAM = %100101
pub const READ  = %001100
pub const WRITE = %000111
