// kills U+D+L+R) carrying an end/checkpoint opcode.
// -----------------------------------------------
pub const INPUT_LIVE       = 0
pub const INPUT_PLAYBACK   = 1
pub const INPUT_RECORD     = 2          // DEBUG builds only
pub const REPLAY_ESCAPE    = $FF        // impossible as a held byte (SOCD guard)
pub const REPLAY_OP_END    = $00
pub const REPLAY_OP_CHECK  = $01        // + u32 hash payload
pub const REPLAY_CHECK_MASK   = 63      // checkpoint every 64 ticks (record side)
pub const REPLAY_RECORD_TICKS = 8192    // 8 KB ring (DEBUG)
pub const REPLAY_HEADER_LEN   = 20      // magic4+flags1+pad1+ticks4+corehash4+seed4+reserved2

// -----------------------------------------------
// Game state IDs.
// -----------------------------------------------
pub const GS_BOOT = 0
pub const GS_IDLE = 1

// -----------------------------------------------
// DMA-queue VBlank budgets — the per-frame WINDOW capacity in DMA-byte-equiv.
// Seeded into DMA_Budget_Remaining at the TOP of VInt_Level; the frame's big
// window riders (plane drain, Critical DMA) then CHARGE it as they run, so the
// Important/Deferrable drain sees the TRUE headroom left in the blanking window.
//
// Derivation (oracle cycle model, hardware-verified):
//   blanking window ≈ 488.6 68k cyc/line ×
//       NTSC 38 blank lines ≈ 18,565 cyc   |   PAL 72 blank lines ≈ 35,179 cyc
//   blanking DMA ≈ 2.7 cyc/byte  →  raw capacity  NTSC 6876 / PAL 13029 bytes
//   × ~0.89 safety margin for the uncharged non-DMA VInt tail (Flush_VDP_Shadow /
//     Enqueue_Dirty_Buffers / Vscroll_Write / Read_Controllers / sound brackets)
//     and the plane drain's CPU-write rate running above 2.7 cyc/byte:
//       NTSC 6876 × 0.89 ≈ 6144   |   PAL 13029 × 0.89 ≈ 11648
// On calm frames the charged riders are small, so the residual budget stays far
// above realistic Important/Deferrable demand and never binds (behaviorally
// identical). On an overloaded frame the riders draw it down to the real window
// headroom, capping the drain instead of overrunning into active display.
// -----------------------------------------------
pub const DMA_BUDGET_NTSC = 6144
pub const DMA_BUDGET_PAL  = 11648

// -----------------------------------------------
// Enqueue-side DMA byte cap (Vectorman dual cap, Art-streaming P2c Task 8). The
// three QueueDMA_* classes share a per-frame running byte total
// (DMA_Enq_Bytes_Frame, reset in VInt_Level beside DMA_Budget_Remaining); an
// enqueue whose bytes would push the total over this cap is REJECTED exactly like
// a full queue (carry set — callers already retry next frame). Set ABOVE the drain
// window budgets so it only catches a runaway enqueue STORM (a producer flooding
// the queue faster than the window can drain), never normal traffic. The entry-
// count cap (the queue slots) is the first half of the dual cap; this is the byte
// half. A per-tier admission cap on ONE resource (DMA bytes), NOT a unified arbiter
// (D2) — it builds no shared cost ledger.
// -----------------------------------------------
pub const DMA_ENQ_BYTE_CAP = 12288

// -----------------------------------------------
// Decompression / art staging.
// -----------------------------------------------
pub const TILE_SIZE = 32                          // bytes per 8x8 4bpp tile
pub const ART_POOL_PAGE_BYTES = ART_POOL_PAGE_TILES * TILE_SIZE       // 2048 — one page's VRAM bytes
pub const ART_STAGING_BUFFER_SIZE = ART_POOL_PAGE_BYTES              // 2048 — one decompressed pool page
// PageIn_Process derives a page's VRAM dest as page_id << ART_POOL_PAGE_BYTES_SHIFT
// (== page_id * ART_POOL_PAGE_BYTES) — the ensure keeps the shift honest against
// the byte size so a page-size change can't leave the shift stale (tripwire 2).
pub const ART_POOL_PAGE_BYTES_SHIFT = 11
ensure((1 << ART_POOL_PAGE_BYTES_SHIFT) == ART_POOL_PAGE_BYTES,
       "ART_POOL_PAGE_BYTES_SHIFT must equal log2(ART_POOL_PAGE_BYTES)")

// Blanked-init page-load DMA window (Art-streaming P2a/P2b). Level init streams
// the act pool through the SAME page-in path gameplay uses, landing each decoded
// page via an Important-priority staging->VRAM DMA. A 64-tile page is 2048 B, so
// several pages' landings can drain per display-off frame; Level_LoadArt runs
// display-OFF, where DMA runs at the full per-line rate on every line, so it
// raises the window budget to this value for the bulk load (headroom for several
// page landings + a normal frame's other charges) and restores the active-display
// budget before display-on.
pub const DMA_BUDGET_BLANKED_INIT = ART_STAGING_BUFFER_SIZE + DMA_BUDGET_NTSC   // 8192 (2048 page + 6144 NTSC window)

// -----------------------------------------------
// SST layout constants (the ObjDef-copied template block + custom span).
// -----------------------------------------------
pub const SST_CUSTOM_SIZE   = 34        // bytes in sst_custom ($2E-$4F)
pub const SST_TEMPLATE_START = $0A      // first byte of the ObjDef-copied template block
pub const SST_TEMPLATE_SIZE = 24        // template bytes copied at spawn ($0A-$21; $20-$21 re-inited)

// -----------------------------------------------
// Terrain solidity classes (SolidityTable values — generator contract).
// -----------------------------------------------
pub const SOLID_NONE = 0
pub const SOLID_TOP  = 1
pub const SOLID_LRB  = 2
pub const SOLID_ALL  = 3

// -----------------------------------------------
// Parallax (§4.6).
// -----------------------------------------------
// RAISED 8 -> 16 on 2026-08-27. Three facts make the raise affordable and one makes it
// possible; all four are measurements, not estimates (docs/DEFERRED_WORK.md's band-ceiling
// row carries the full derivation):
//   * COST TO A SCENE THAT DOES NOT USE THE EXTRA BANDS IS ZERO CYCLES. Every per-frame
//     parallax walk is bounded by `pcfg_band_count`, never by this constant — the only
//     O(MAX) loop in engine/level/parallax.emp is `Parallax_Init`'s one-time state wipe.
//   * A SCENE THAT DOES use sixteen pays 4664 + 15 x 854 = 17,474 cyc = 13.7% of the
//     128,000-cycle NTSC frame (SB_WALK_BAND_PERLINE_X100, scene_dsl.emp).
//   * RAM: Parallax_State = 100 + 20 x MAX + 4 -> 328 B at 8, 552 B at 16 (+224).
//   * `pcfg_layer_mask` HAD TO BECOME A u16 (engine/structs.emp). At a u8 every band from
//     index 8 up read a structurally-zero bit, took `.band_disabled`, and inherited the
//     band above it: a build that is green and a picture that is silently wrong.
// A RAISE IS NOT A ONE-LINE EDIT. Whatever moves this number must also move: the
// `ensure(MAX_PARALLAX_BANDS == N)` pin and the inlined literals it guards in
// engine/level/scene_dsl.emp (an imported constant named inside a comptime body a GAME
// module elaborates resolves to NOTHING, silently — see EMP_PITFALLS), the SceneCfgN /
// lowerN shape set in games/sonic4/data/effects/scene_registry.emp (derived and named by
// tools/test_scene_band_shape_coverage.py), tools/effects_gen.py's pinned mirror, every
// `scene()` call site's fixed-size pad array, and the anchored-at-ceiling poison
// (games/sonic4/test/poison/poison_scene_capacity.emp + tools/emp_expect_fail.py, whose
// count pin now fails LOUDLY and names this constant instead of going quietly vacuous).
pub const MAX_PARALLAX_BANDS    = 16
// pcfg_anchor_ch sentinel: this config has NO world-anchored deform overlay (Parcel W).
// $FF and not 0, because 0 is a legal patch channel — the same reason RASTER_ARM_PARK is
// a value no real arm can take rather than a zero.
pub const PARALLAX_ANCHOR_NONE  = $FF
pub const PARALLAX_TRANS_DEFAULT = 16   // default boundary lerp duration (frames)
// Per-frame BG vscroll transition lerp: current += (target - current) >> 4.
// CONVERGENCE (the exponential-lerp table in CODING_CONVENTIONS §2.6): each frame
// retains 15/16 of the gap, so after the PARALLAX_TRANS_DEFAULT window of 16
// frames (15/16)^16 ~= 36% of the gap is STILL outstanding — ~95% convergence
// needs ~46 frames at this shift, ~99% needs ~71. That residual is not a bug: the
// promote frame in Parallax_Step5_Vscroll takes the `.v_snap` path (transition
// counter is 0), so the last ~36% lands as a single-frame snap. The per-band
// HORIZONTAL scroll does NOT use this shift — it uses an exact
// gap/frames_remaining ramp (parallax.emp Step 4) and converges on the last
// window frame with no residual.
pub const PARALLAX_LERP_SHIFT   = 4

// -----------------------------------------------
// Act art-pool VRAM ceiling + per-act section grid cap.
// -----------------------------------------------
// 896 = 14 pages of 64, NOT 960 (15): the top page was surrendered to the dust
// windows (VRAM_DUST_PUFF at 896, VRAM_DUST_SPINDASH at 912, the ring sparkle's
// VRAM_RING_SPARKLE at 924, 32 tiles spare at 928-959 — see
// docs/generated/vram-map-sonic4.md, emitted from
// games/sonic4/vram.toml, whose generated block cross-checks THIS value by
// name). Affordable because the pool is over-provisioned: OJZ act 1 needs 10
// pages (612 tiles) of the remaining 14, so it stays fully resident. Safe
// because of the 2026-08-11 prep parcel: the RAM arrays are PAGE_FRAMES_MAX-
// sized (a resize moves no RAM) and the replay hash is layout-proof.
pub const POOL_TILE_CEILING = 896       // pool loads to tiles 0..N-1; dust windows at 896; DPLC region at tile 960
pub const MAX_ACT_SECTIONS  = 48        // flat id = sec_y*grid_w + sec_x; build asserts grid_w*grid_h <= this

// -----------------------------------------------
// Plane-update ring buffer.
// -----------------------------------------------
pub const PLANE_BUFFER_SIZE = 1536      // bytes (~11 FG column entries per frame; a BG
                                        // column entry is 132 B since the NEW-5 64-row
                                        // widening — worst realistic frame ~800 B)

// -----------------------------------------------
// 2D tile-cache collision geometry + 16x16 block format (§4.7). The COLL_* /
// BLOCK_* derivatives fold from TILE_CACHE_ROWS/COLS and BLOCK_TILE_SIZE.
// -----------------------------------------------
pub const TILE_CACHE_COLL_ROWS   = TILE_CACHE_ROWS / 2                    // 30 collision rows (16px cells)
pub const TILE_CACHE_COLL_SIZE   = TILE_CACHE_COLS * TILE_CACHE_COLL_ROWS // 2400 bytes per plane
pub const TILE_CACHE_COLL_PLANES = 2                                      // path A (index 0) + path B (index 1)
pub const TILE_CACHE_MARGIN_H    = 20                                     // horizontal margin (columns each side)
pub const TILE_CACHE_MARGIN_V    = 16                                     // vertical margin (rows each side)

// -----------------------------------------------
// STREAMING REACH — the fill window's far edge, and the guards that hold it
// against the viewport. Added 2026-08-27 by the fg-left-edge derivation (see
// docs/DEFERRED_WORK.md, "FOREGROUND: the two leftmost plane-A columns"). The
// two literals below used to be bare `327` / `231` inline in section.emp's and
// tile_cache.emp's `addi.w`s, so the claim "the fill window covers the whole
// viewport" was a claim about four hand-copied magic numbers and nothing checked
// it. Naming them changes no byte (327 == 320+7, 231 == 224+7) and makes the
// ensures below real.
//
// THE NEAR EDGE HAS NO CONSTANT, AND THAT IS THE POINT. Both fills take their
// near edge as `Camera >> 3` with nothing subtracted and nothing masked off —
// the camera word IS the viewport's left/top pixel, so the first column the fill
// covers is the column that contains screen x = 0. There is no left margin to be
// wrong. Any future edit that introduces one (a block-align mask, a `subq`, a
// margin term) breaks a property no ensure here can see, because an absent term
// cannot be asserted; it can only be documented, and this is where.
//
// THE FAR EDGE, DERIVED. The last visible pixel is Camera + SCREEN_* - 1. Adding
// one further tile (+8) and truncating gives `(Camera + REACH) >> 3` == (the
// column holding the last visible pixel) + 1 — one column of deliberate
// conservative overdraw, on both axes. With Camera's sub-tile fraction f in
// 0..7 the reach in WHOLE COLUMNS above the camera's own column is therefore
// (7 + REACH) >> 3, which is what the *_COLS_MAX / *_ROWS_MAX pair names: 41
// columns and 29 rows.
pub const SECTION_H_REACH_PX = SCREEN_WIDTH  + 7    // 327 — camera-relative far edge, X
pub const SECTION_V_REACH_PX = SCREEN_HEIGHT + 7    // 231 — camera-relative far edge, Y
pub const SECTION_H_REACH_COLS_MAX = (7 + SECTION_H_REACH_PX) >> 3   // 41
pub const SECTION_V_REACH_ROWS_MAX = (7 + SECTION_V_REACH_PX) >> 3   // 29
// The viewport's own far column/row, camera-relative, same worst-case fraction.
pub const SCREEN_LAST_COL_MAX = (7 + SCREEN_WIDTH  - 1) >> 3         // 40
pub const SCREEN_LAST_ROW_MAX = (7 + SCREEN_HEIGHT - 1) >> 3         // 27

// (1) The fill must reach at least the viewport's far edge. Paired with the
//     absent near margin documented above, this IS "the fill window covers the
//     full visible viewport" — the property the fg-left-edge booking doubted.
ensure(SECTION_H_REACH_COLS_MAX >= SCREEN_LAST_COL_MAX,
       "the column fill's far reach ({SECTION_H_REACH_COLS_MAX} cols past the camera's own column) no longer covers the viewport's last partially-visible column ({SCREEN_LAST_COL_MAX}) — the right edge of the screen would stream one or more columns short and show whatever the plane ring last left there")
ensure(SECTION_V_REACH_ROWS_MAX >= SCREEN_LAST_ROW_MAX,
       "the row fill's far reach ({SECTION_V_REACH_ROWS_MAX} rows past the camera's own row) no longer covers the viewport's last partially-visible row ({SCREEN_LAST_ROW_MAX}) — the bottom of the screen would stream short")

// (2) The streamed window must FIT THE PLANE RING measured from the viewport's
//     own near column/row. Section_UpdateColumns clamps its far tracker to
//     `visible_near + PLANE_*_CELLS - 1` precisely so the far edge can never lap
//     the ring and overwrite the NEAR edge with the wrap twin (the world content
//     PLANE_*_CELLS away). If the reach ever exceeded that clamp, the clamp —
//     not the reach — would decide the far edge, and the fill would silently
//     stop covering the viewport. 41 <= 63 and 29 <= 63 today: 22 and 34 columns
//     of slack, which is the number the derivation needed and could not find
//     written down anywhere.
ensure(SECTION_H_REACH_COLS_MAX <= PLANE_H_CELLS - 1,
       "the column fill reaches {SECTION_H_REACH_COLS_MAX} columns past the camera's own column, but the plane ring is only {PLANE_H_CELLS} cells wide — Section_UpdateColumns' wrap clamp (visible_left + {PLANE_H_CELLS}-1) would now bind before the reach does, so the far edge stops short AND the leftmost visible column risks being rewritten with the wrap twin")
ensure(SECTION_V_REACH_ROWS_MAX <= PLANE_V_CELLS - 1,
       "the row fill reaches {SECTION_V_REACH_ROWS_MAX} rows past the camera's own row, but the plane ring is only {PLANE_V_CELLS} cells tall — the vertical wrap clamp would bind before the reach does")

// (3) The tile cache must be able to hold the whole streamed window PLUS its
//     margin, or Tile_Cache_Fill's `desired_right = min(camera + reach + margin,
//     desired_left + COLS-1)` clamp binds and Cache_Head_Col never reaches the
//     column the plane fill wants — Draw_TileColumn's cache-range gate then drops
//     the write and the far edge shows stale ring content.
ensure(TILE_CACHE_COLS >= TILE_CACHE_MARGIN_H + SECTION_H_REACH_COLS_MAX + 1,
       "TILE_CACHE_COLS ({TILE_CACHE_COLS}) cannot span the left margin ({TILE_CACHE_MARGIN_H}) plus the column fill's reach ({SECTION_H_REACH_COLS_MAX}) plus the camera's own column — Cache_Head_Col can never reach the plane fill's right edge and Draw_TileColumn drops those columns")
ensure(TILE_CACHE_ROWS >= TILE_CACHE_MARGIN_V + SECTION_V_REACH_ROWS_MAX + 1,
       "TILE_CACHE_ROWS ({TILE_CACHE_ROWS}) cannot span the top margin ({TILE_CACHE_MARGIN_V}) plus the row fill's reach ({SECTION_V_REACH_ROWS_MAX}) plus the camera's own row — Cache_Bottom_Row can never reach the plane fill's bottom edge")

// Raw block layout: [512B nametable][128B collision plane A][128B collision plane B].
pub const BLOCK_TILE_SIZE       = 16    // 16x16 tiles per block
pub const BLOCK_TILE_SHIFT      = 4     // lsr #4 = / 16
// The size and the shift are one fact written twice, and roughly ten sites
// consume the shift rather than the size. Changing the block geometry without
// moving both would divide by the wrong power of two everywhere at once.
ensure(1 << BLOCK_TILE_SHIFT == BLOCK_TILE_SIZE,
       "BLOCK_TILE_SHIFT and BLOCK_TILE_SIZE disagree — every `lsr #BLOCK_TILE_SHIFT` divides by the wrong power of two")
pub const BLOCK_NT_SIZE         = BLOCK_TILE_SIZE * BLOCK_TILE_SIZE * 2   // 512 bytes
pub const BLOCK_COLL_ROWS       = BLOCK_TILE_SIZE / 2                     // 8 collision rows per block
pub const BLOCK_COLL_COLS       = BLOCK_TILE_SIZE                         // 16 collision cells per row
pub const BLOCK_COLL_PLANE_SIZE = BLOCK_COLL_COLS * BLOCK_COLL_ROWS       // 128 bytes per plane
pub const BLOCK_COLL_SIZE       = BLOCK_COLL_PLANE_SIZE * TILE_CACHE_COLL_PLANES  // 256 bytes (A+B)
pub const BLOCK_RAW_SIZE        = BLOCK_NT_SIZE + BLOCK_COLL_SIZE         // 768 bytes
pub const BLOCK_STAGE_SLOTS     = 16    // staged decompressed blocks (round-robin evict)
pub const BLOCK_DECOMP_BUDGET   = 6     // max block decompresses per frame (columns + rows share)
// Rows filled per frame cap. Must be >= CAM_MAX_Y_STEP/8 — build-asserted at the
// CAM_MAX_Y_STEP definition below. 2 exactly MATCHES the 16 px/frame camera cap
// (2*8 == 16): the fill keeps up with the worst case but has ZERO catch-up
// headroom, so a frame the fill misses is only recovered by the 16-row cache
// margin, never by filling faster. (The 2026-06-10 vertical-streaming plan sized
// this at 4 for catch-up; the shipped value is 2. Raising it is a budget
// decision — BLOCK_DECOMP_BUDGET is shared with the column fill — not a
// comment fix, so the value is left alone here.)
pub const VFILL_ROWS_PER_FRAME  = 2
pub const H_PFX_HYST            = 16    // net opposite-motion px before the horizontal prefetch latch flips
pub const BLOCKS_PER_SECTION_AXIS = 16  // 16 blocks across, 16 down
pub const BLOCKS_PER_SECTION_SHIFT = 4  // lsr #4 = / BLOCKS_PER_SECTION_AXIS
// Blocks-per-section is a DIFFERENT quantity from tiles-per-block; they are both
// 16 today, so a site that divides a block count by the wrong one is invisible.
ensure(1 << BLOCKS_PER_SECTION_SHIFT == BLOCKS_PER_SECTION_AXIS,
       "BLOCKS_PER_SECTION_SHIFT and BLOCKS_PER_SECTION_AXIS disagree — the world-block to section decompose divides by the wrong power of two")
pub const BLOCK_INDEX_ENTRIES   = BLOCKS_PER_SECTION_AXIS * BLOCKS_PER_SECTION_AXIS  // 256
pub const BLOCK_INDEX_SIZE      = BLOCK_INDEX_ENTRIES * 4                 // 1024 bytes (ROM)

// Staging probe index (streaming fix F4). TileCache_FindStagedBlock hashes a
// staged block's key to a bucket instead of linear-scanning all BLOCK_STAGE_SLOTS
// keys. The hash IS the block index, which the probe already holds in d2, so it
// costs zero instructions — which is only possible while there is one bucket per
// representable block index. Shrinking this below BLOCK_INDEX_ENTRIES would need
// a mask in the probe's hot path; the equality makes that a build error rather
// than a silently slower probe.
pub const BLOCK_STAGE_BUCKETS   = BLOCK_INDEX_ENTRIES                     // 256 buckets, one per block_index
ensure(BLOCK_STAGE_BUCKETS == BLOCK_INDEX_ENTRIES,
       "BLOCK_STAGE_BUCKETS must stay one-per-block-index — TileCache_FindStagedBlock indexes the bucket table with the RAW block index and masks nothing")
// The bucket/chain cells hold a slot's BYTE OFFSET into the stride-4 key table
// (slot * 4), with $FF as the end-of-chain sentinel, so the probe carries one
// index register for Keys/Ptrs/Maps/Chain alike. $FF must stay unrepresentable
// as a real offset.
ensure(BLOCK_STAGE_SLOTS * 4 < $FF,
       "BLOCK_STAGE_SLOTS * 4 reached the staging index's $FF end-of-chain sentinel — widen Block_Stage_Bucket/Chain to words first")

// The prefetch-scan memo's eviction test (streaming fix F2) builds a 16-bit mask
// of the slots the scan covered and rotates a `rol.w` window of newly-claimed
// slots across it. The rotate width IS the slot count; at any other
// BLOCK_STAGE_SLOTS the mask and the rotate stop describing the same set.
ensure(BLOCK_STAGE_SLOTS == 16,
       "the prefetch memo's covered-slot mask is a WORD and its eviction window is a `rol.w` — both are exactly 16 slots wide; widen them together with BLOCK_STAGE_SLOTS")

// Collision cell shift (pixel -> 16px cell).
pub const COLLISION_CELL_SHIFT  = 4

// -----------------------------------------------
// Camera (§4.7 streaming contract; CAM_MAX_Y_STEP <= VFILL_ROWS_PER_FRAME*8).
// -----------------------------------------------
pub const CAM_LOOKAHEAD_THRESHOLD = $0600  // ground speed for pan enable
pub const CAM_PAN_SPEED = 2                // pixels/frame pan rate
pub const CAM_PAN_LIMIT = 64               // max pan pixels
pub const CAM_MAX_Y_STEP = 16              // max camera Y movement px/frame

// The §4.7 streaming contract, as a build guard (conventions §1.6). The vertical
// tile-cache fill may only advance VFILL_ROWS_PER_FRAME rows (8 px each) per
// frame; if the camera can outrun that, the cache trails the view and the top/
// bottom margin drains until the fill visibly lags. Currently at EXACT equality
// (16 == 2*8, zero slack) — raising CAM_MAX_Y_STEP without raising
// VFILL_ROWS_PER_FRAME (or vice versa) is a silent streaming regression, so the
// relation is asserted rather than left to the comment above.
ensure(CAM_MAX_Y_STEP <= VFILL_ROWS_PER_FRAME * 8,
       "camera Y step outruns the vertical tile-cache fill rate (CAM_MAX_Y_STEP > VFILL_ROWS_PER_FRAME*8)")

// --- Speculation residency guard (streaming fix F2a) -------------------------
// Placed after the camera block because it is DERIVED from the camera cap, not
// tuned: the block prefetch stages the block strip one block beyond the cache
// edge, the edge advances CAM_MAX_Y_STEP/8 = 2 tiles per logic tick at the cap
// (its X twin CAM_MAX_X_STEP is file-local to engine/level/camera.emp and equal),
// and a strip is BLOCK_TILE_SIZE = 16 tiles, so the staged block is CONSUMED
// BLOCK_SPEC_LEAD_TICKS ticks later. Meanwhile eviction is strict round-robin, so
// a staged block survives exactly BLOCK_STAGE_SLOTS further CLAIMS. Speculation
// can only land while
//
//     claims over the next LEAD ticks  <=  BLOCK_STAGE_SLOTS
//
// and the guard estimates the left side by the claims over the LAST LEAD ticks
// (Cache_Spec_Gen_Ring in engine.ram). MEASURED at sustained max-diagonal before
// the guard, by tools/staging_lifetime_timeline.py: 4.13 claims/tick = 33 claims
// per 8 ticks against 16 slots, speculation residency 3.64 ticks against the
// 8-tick lead, 59% of evicted speculations never used. The same tool measures
// `right` and `down` at 0.48/0.61 claims/tick with ZERO dead speculations — which
// is why this is a guard and not a deletion.
//
// This is a LEAD FLOOR, not the lead: below the camera cap the edge advances
// slower, so the real lead is LONGER and a fixed 8-tick window under-counts the
// claims that will occur over it. The product (claim rate x lead) is roughly
// speed-invariant — both scale with camera speed — so the error is second-order,
// and it errs toward PERMITTING speculation, which is the safe direction for the
// single-axis states where the prefetch does all the work. Documented rather than
// corrected: correcting it needs a divide, and this engine does not divide.
pub const BLOCK_SPEC_LEAD_TICKS = BLOCK_TILE_SIZE / (CAM_MAX_Y_STEP / 8)  // 16 / 2 = 8
// The ring is indexed by Logic_Tick & (LEAD-1) — a power of two is not a tuning
// choice here, it is what makes the index a mask instead of a modulo.
ensure(BLOCK_SPEC_LEAD_TICKS > 0 && (BLOCK_SPEC_LEAD_TICKS & (BLOCK_SPEC_LEAD_TICKS - 1)) == 0,
       "BLOCK_SPEC_LEAD_TICKS must be a power of two — Tile_Cache_Fill indexes Cache_Spec_Gen_Ring with `andi.w #LEAD-1`")
// Schmitt re-arm. Tripping and re-arming on the SAME threshold oscillates by
// construction: suppressing speculation lowers the claim rate, which re-arms it,
// which raises it again — the packet's bistability, re-entered once per window.
// Re-arming only at half the slot count leaves room for the speculation stream
// the re-arm is about to start. Measured: at max-diagonal the demand-only rate is
// 1.5-2.2 claims/tick = 12-18 per 8 ticks, ABOVE this line, so the guard stays
// down; at `right`/`down` the total rate is 4-5 per 8 ticks, below it, so the
// guard never trips and those axes keep every speculation they have today.
pub const BLOCK_SPEC_REARM      = BLOCK_STAGE_SLOTS / 2
ensure(BLOCK_SPEC_REARM < BLOCK_STAGE_SLOTS,
       "the speculation guard's re-arm threshold must be STRICTLY below its trip threshold or the latch is not a Schmitt trigger and will oscillate")

// Sprite-cull margin (px) added to all four sides of the visibility box in
// Update_Sprite_Visibility. Sprite culling runs inside RunObjects, which the
// game shell calls BEFORE Camera_Update, so the cull tests against LAST frame's
// camera while positioning uses the post-update value. An object within one
// frame of camera motion of a screen edge therefore culls one frame late or
// early -> edge pop-in. The margin absorbs that skew without perturbing update
// order (reordering Camera_Update ahead of RunObjects would shift
// gameplay-visible timing). Must be >= max(CAM_MAX_X_STEP, CAM_MAX_Y_STEP);
// 32 = 2x the 16 px/frame worst case on both axes.
pub const SPRITE_CULL_MARGIN = 32

// -----------------------------------------------
// Entity window scan (§4.9 — camera-driven sliding window).
// -----------------------------------------------
pub const MAX_TRACKED_SECTIONS    = 4       // camera-envelope 2x2
pub const ENTITY_LOAD_BUFFER      = $180    // px ahead/behind camera to load entities
pub const ENTITY_DESPAWN_BUFFER   = $200    // px beyond load buffer to despawn (hysteresis)
pub const ENTITY_LOAD_BUFFER_Y    = $100    // px above/below camera to load entities
pub const ENTITY_DESPAWN_BUFFER_Y = $180    // Y despawn distance (> load = hysteresis)
pub const ENTITY_LOADED_SLOT_SIZE = 32      // per-entry loaded bitmask: 16B rings + 16B objects
pub const ENTITY_LOADED_OBJ_OFFSET = 16     // object bits start mid-slot
pub const ENTITY_RESCAN_COARSE_MASK = $FF80 // camY coarse-row mask (128px rows)
pub const ENTITY_RESCAN_ROW_SIZE  = $10000 - ENTITY_RESCAN_COARSE_MASK   // 128 — coarse row height

// 3x3 rolling collected/killed bitmask geometry.
pub const COLLECTED_BITMASK_OFFSET = 2      // ring collected bitmask starts 2 bytes into slot
pub const KILLED_BITMASK_OFFSET   = 18      // object killed bitmask starts after ring bitmask
pub const COLLECTED_EMPTY_TAG     = $FF     // slot not owned by any section
pub const COLLECTED_MASK_BYTES    = KILLED_BITMASK_OFFSET - COLLECTED_BITMASK_OFFSET  // 16 — one bitmask
pub const MAX_LIST_ENTRIES        = 128     // collected/killed bitmask capacity per section
// Slot STRIDE — an engine-owned FORMAT, not a game knob (review item 30/G). It
// is the sum of the field offsets above, so it is derived, not restated; the
// game knob is the slot COUNT (COLLECTED_WINDOW_SLOTS, a per-profile `-D`).
// Was duplicated byte-identically in every game config with `ensure(extern(..))`
// guards in ram.emp + entity_window.emp; homed here, both go away.
pub const COLLECTED_SLOT_SIZE     = KILLED_BITMASK_OFFSET + COLLECTED_MASK_BYTES  // 34 — tag + pad + ring mask + killed mask

// Slot tag (SST_slot_tag) — which quadrant entry (0-3) spawned an object.
pub const SLOT_TAG_LEFT    = 0              // upper-left
pub const SLOT_TAG_RIGHT   = 1              // upper-right
pub const SLOT_TAG_LOWER_L = 2              // lower-left
pub const SLOT_TAG_LOWER_R = 3              // lower-right

// Object placement entry (ROM, 6 bytes): dc.w x, y, flags|type|subtype.
pub const OEF_ANY_Y        = 15            // spawn regardless of camera Y
pub const OEF_YFLIP        = 14            // rol.w #4 in Load_Object -> RF_YFLIP
pub const OEF_XFLIP        = 13            // rol.w #4 in Load_Object -> RF_XFLIP
pub const OEF_TYPE_SHIFT   = 8             // bits 12-8: type (0-31)
pub const OEF_TYPE_MASK    = $1F
pub const OEF_SUBTYPE_MASK = $FF           // bits 7-0
pub const OBJ_ENTRY_SIZE   = 6

// VDP shadow-table length: 19 shadowed registers, $00-$12. The AS-side
// `VDP_Shadow_len` symbol is owned by the struct-offset harvest (engine.structs'
// VdpShadow), so it is EXCLUDED from this module's constant harvest to keep a
// single injector. This named immediate is the `.emp`-side value the flush code
// reads; a wrong value changes the emitted `moveq`, so byte-identity checks it.
pub const VDP_Shadow_len = 19
