// VDP shadow table management
module engine.vdp_init in vdp_init

use engine.constants.{VDP_Shadow_len}

// The VDP register-set encoding: a control-port word %100R_RRRR_VVVV_VVVV —
// command base $8000 plus register-number strides of $0100, value in the
// low byte. Module-local until a second consumer earns them a twin slot.
const VDP_REG_CMD  = $8000
const VDP_REG_STEP = $0100

// Drift-lock: both loops here (VDP_Shadow_Init's copy, Flush_VDP_Shadow's blit)
// are counted `dbf` walks primed by `moveq #VDP_Shadow_len-1`. `moveq` sign-
// extends a SIGNED byte, so a bound past 128 loads a NEGATIVE count and `dbf`
// runs 65536 iterations — the flush would walk the whole 68K address space
// writing garbage to VDP_CTRL. The real ceiling is far tighter than that: the
// VDP has 24 registers and only $00-$12 are shadowed, so anything above 24 is
// already a table-definition bug. Guard at the hardware bound, not the encoding
// bound, so the error names the real mistake.
// VDP_Shadow_len is an imported const, so ensure sees it at comptime.
ensure(VDP_Shadow_len <= 24, "engine.constants VDP_Shadow_len > 24 — the VDP has only 24 registers, and moveq's signed-byte count bounds both shadow walks")

// -----------------------------------------------
// VDP_Shadow_Init — copy boot VDP register values into shadow table
// In:  none (reads from BootData VDP register values)
// Out: none
// Clobbers: d0, a0-a1
// -----------------------------------------------
pub proc VDP_Shadow_Init () clobbers(d0/a0-a1) {
        lea     BootData_VDPRegs(pc), a0    // cross-seam pc-rel: engine/system/boot.asm
        lea     VDP_Shadow_Table, a1
        moveq   #VDP_Shadow_len-1, d0
    .copy:
        move.b  (a0)+, (a1)+
        dbf     d0, .copy
        rts
}

// -----------------------------------------------
// Flush_VDP_Shadow — re-blit ALL shadowed registers to the VDP (§0.4)
// Called during VBlank, unconditionally: the shadow is the authority for
// registers $00-$12, so every frame starts from it. That is what makes a
// mid-frame raster write self-undoing — an effect that pokes reg $0B or $0A
// during active scan needs no paired "frame-top reset" word, because the next
// flush restores the settled value for free. Two independently-authored
// effects can therefore touch the same register without agreeing on anything.
// (Gunstar Heroes and Alien Soldier both restore blanket for this reason.)
//
// INVARIANT this creates for reg $0F (autoincrement): the flush restores $0F
// every frame from the shadow ($02). Any routine that changes autoincrement
// mid-frame — writing $8F80 straight to VDP_CTRL and restoring $8F02 itself,
// bypassing the shadow — MUST keep interrupts masked for the whole excursion,
// or a VBlank landing inside it flushes $8F02 back under the routine's feet
// and the rest of its column-mode writes stride by 2 instead of $80. The three
// excursion sites are engine/level/bg.emp, engine/level/section.emp and
// engine/level/plane_buffer.emp; each carries a DEBUG-shape IPL assert.
//
// In:  none
// Out: none
// Clobbers: d0-d1, a0-a1
// -----------------------------------------------
pub proc Flush_VDP_Shadow () clobbers(d0-d1/a0-a1) {
        lea     VDP_Shadow_Table, a0
        lea     VDP_CTRL, a1
        move.w  #VDP_REG_CMD, d0            // register command base (reg $00)
        moveq   #VDP_Shadow_len-1, d1
    .loop:
        move.b  (a0)+, d0                   // shadow value into the command's low byte
        move.w  d0, (a1)                    // write $8X00+val to VDP
        addi.w  #VDP_REG_STEP, d0           // next register command ($8X00 -> $8(X+1)00)
        dbf     d1, .loop
        rts
}

// -----------------------------------------------
// Set_VDP_Reg — the ONE way to change a VDP register outside VBlank and have
// it survive to the next frame. Writes the shadow byte only; the unconditional
// flush at frame top is what reaches the hardware.
// In:  d0.w = register index ($00-$12), d1.b = value
// Out: none
// Clobbers: a0
// -----------------------------------------------
pub proc Set_VDP_Reg (d0: u16, d1: u8) clobbers(a0) {
        lea     VDP_Shadow_Table, a0
        move.b  d1, (a0, d0.w)
        rts
}
