// Game state machine and main loop
module engine.game_loop in game_loop

// Build-shape inputs (-D NAME=0|1): SOUND_DRIVER_ENABLED gates the sound driver;
// SOUND_DEBUG_HOTKEYS is the sound test-harness opt-in (OFF in normal play
// builds; requires DEBUG=1 — enforced for every build path by the comptime
// `ensure` in games/sonic4/config/game.emp, which build.sh's shell guard now
// merely front-runs with a friendlier message).

// GameState — the state-dispatch proc type: the Game_State dispatch runs
// arbitrary state code, an honest ⊤ bound. `pub` so the engine's Game contract
// (engine.game_contract) types its `entry` member by it — this module is the
// type's dispatch-use home (the `jsr (a0) as GameState` below); the bind pass
// resolves the interface's member type across the whole module set.
pub type GameState = proc () clobbers(d0-d7/a0-a6)

// -----------------------------------------------
// GameLoop — master loop
// VSync → dispatch current state → repeat
// Clobbers EVERYTHING: the `jsr (a0)` state
// dispatch runs arbitrary game-state code, so no register is contractually
// preserved (and even the fixed callees already trash d0/d1/d2/a0/a1). The old
// clobbers(a0) under-declared. GameLoop never returns (jbra GameLoop tail-recurse)
// so the contract is nominal — but the signature must not falsely claim to
// preserve registers the body destroys.
// -----------------------------------------------
@noreturn
pub proc GameLoop () clobbers(d0-d7/a0-a6) {
        jbsr    VSync_Wait
        addq.l  #1, Logic_Tick          // the deterministic timebase (one per tick, never per VBlank)
        jbsr    Input_Tick              // replay seam: live no-op / playback overwrite / record tap
        if SOUND_DRIVER_ENABLED == 1 {
        jbsr    Sound_DrainSfxRing      // drain ONE pending SFX/frame into the mailbox
                                        // (release sound builds need this too, not just DEBUG)
        }
        // The game's per-frame debug hook (Game.debug_tick). Bound game-side only
        // in the sound test-harness shape; `= empty` in every canonical build,
        // where it emits nothing. When bound it lowers to an absolute jsr
        // (engine→game, placement-independent).
        invoke  Game.debug_tick
        movea.l Game_State, a0
        jsr     (a0) as GameState       // computed dispatch (bare jsr by the jbra/jbsr rule)
        // The palette engine's per-frame composition (effects P2). Main-loop, NOT
        // VBlank: it is arithmetic (base -> cycling -> cross-fade -> operators ->
        // variants), and it must land AFTER the game state's boundary crossings
        // (which set Pal_Base / arm fades) and BEFORE the next VBlank's
        // Enqueue_Dirty_Buffers reads Palette_Dirty. A static frame costs one
        // `tst.b Pal_Active`.
        jbsr    Palette_Compose
        jbra    GameLoop
}

// -----------------------------------------------
// GameState_Idle — minimal state (VSync only)
// -----------------------------------------------
pub proc GameState_Idle () clobbers() {
        rts
}
