// Buffer initialization, static DMA entries, and plane utilities
module engine.buffers in buffers

use engine.structs.{DMAEntry, parallax_config}
use engine.constants.{VRAM_SPRITE_TABLE, VRAM_HSCROLL_TABLE, PLANE_H_CELLS, VDP_DATA, VDP_CTRL, PARALLAX_ANCHOR_NONE}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm, vdp_comm_delta, plane_loc, dma_length}
use engine.irq.{vblank}

// DMA source word addresses for the static entries — the link-time arm of
// engine.vdp's dma_source derivation ((addr >> 1) & $7FFFFF): the sources are
// RAM labels, so the fold happens in the link expression, not at comptime
// (the row-1004 comptime/link boundary; see dma_source's header).
equ SRC_PAL_LINE0 = (extern("Palette_Buffer") >> 1) & $7FFFFF
equ SRC_PAL_LINE1 = ((extern("Palette_Buffer") + $20) >> 1) & $7FFFFF
equ SRC_PAL_LINE2 = ((extern("Palette_Buffer") + $40) >> 1) & $7FFFFF
equ SRC_PAL_LINE3 = ((extern("Palette_Buffer") + $60) >> 1) & $7FFFFF
equ SRC_SPRITE_TABLE = (extern("Sprite_Table_Buffer") >> 1) & $7FFFFF
equ SRC_HSCROLL = (extern("Hscroll_Buffer") >> 1) & $7FFFFF

// Directional derive over the shared port bases (kept local per the
// engine.vdp header rule).
const VDP_CTRL_OFF = VDP_CTRL - VDP_DATA

// -----------------------------------------------
// queue_static_dma — enqueue one pre-built static DMAEntry on the Critical
// queue.
//
// The interface is entry-only and Critical-bound: the slot/end pair lives
// ONCE here, so a caller can never mismatch a slot variable with another
// queue's end bound (the donor macro's 3-symbol interface allowed it).
//
// Out: carry SET = request DROPPED (Critical queue full); carry CLEAR =
// enqueued OK — the same carry contract as QueueDMA_Critical. Callers clear
// their dirty bit/flag ONLY on carry-clear and leave it set on a drop so the
// next VBlank retries, instead of leaving stale palette/SAT data in VRAM
// indefinitely.
// Clobbers: a1-a2 (d0 untouched — Enqueue_Dirty_Buffers keeps its dirty-bit
// snapshot live in d0 across four consecutive splices).
// Unlike QueueDMA_Critical's transfer core, this template does NOT mask IRQs
// around the slot read-modify-write: it is non-pub and its only consumer runs
// exclusively inside IRQ6, while every main-loop enqueuer goes through the
// masked core — mutual exclusion by containment. Exporting it to main-loop
// context would open the slot race the core's mask closes.
// -----------------------------------------------
comptime fn queue_static_dma(entry: Label) -> Code {
    return asm {
        movea.w DMA_Critical_Slot, a1
        cmpa.w  #DMA_Critical_End, a1
        beq     .drop
        lea     {entry}, a2
        move.l  (a2)+, (a1)+
        move.l  (a2)+, (a1)+
        move.l  (a2)+, (a1)+
        move.w  (a2)+, (a1)+
        move.w  a1, DMA_Critical_Slot
        andi.b  #$FE, ccr               // enqueued -> carry CLEAR (defensive spelling: the slot-var MOVE above already cleared C — kept as the explicit contract point)
        jbra    .done
    .drop:
        ori.b   #1, ccr                 // queue full -> carry SET (dropped)
    .done:
    }
}
// The template's 3×move.l + move.w copy is spelled for 14-byte entries — pin
// it to the struct so a DMAEntry layout change cannot silently truncate the
// copy (the engine.structs wall pins .emp == .asm, not this copy's width).
ensure(sizeof(DMAEntry) == 14, "queue_static_dma's 3L+1W entry copy assumes sizeof(DMAEntry) == 14 — re-derive the copy")

// -----------------------------------------------
// Init_SpriteTable — pre-init sprite link chain 0->1->2->...->79->0
// Y positions = 0 (off-screen), size = 0, tiles = 0
// In:  none
// Out: none
// Clobbers: d0-d2, a0
// -----------------------------------------------
pub proc Init_SpriteTable () clobbers(d0-d2/a0) {
        lea     Sprite_Table_Buffer, a0         // (Sprite_Table_Buffer).w
        moveq   #0, d0
        moveq   #1, d1
        moveq   #79-1, d2
    .loop:
        move.w  d0, (a0)+                       // Y = 0
        move.b  d0, (a0)+                       // size = 0
        move.b  d1, (a0)+                       // link -> next
        move.l  d0, (a0)+                       // tile = 0, X = 0
        addq.b  #1, d1
        dbf     d2, .loop
        move.w  d0, (a0)+                       // entry 79: Y = 0
        move.b  d0, (a0)+                       // size = 0
        move.b  d0, (a0)+                       // link = 0 (terminate)
        move.l  d0, (a0)+                       // tile = 0, X = 0
        rts
}

// -----------------------------------------------
// BuildStaticDMA — pre-compute the 7 static DMA entries
// (4 palette lines + 1 sprite table + 2 HScroll entries)
// Called once at boot after Init_DMA_Queue.
// In:  none
// Out: none
// Clobbers: d0-d4, a0
// -----------------------------------------------
pub proc BuildStaticDMA () clobbers(d0-d4/a0) {
        moveq   #-$6C, d0                       // $94 sign-extended
        move.l  #$93979695, d4                  // reg markers $93/$97/$96/$95 — one movep.l lands all four at offsets 2/4/6/8

        // Palette line 0: Palette_Buffer+$00 -> CRAM $0000, 32 bytes
        lea     Static_Pal_Line0, a0            // (Static_Pal_Line0).w
        move.l  #SRC_PAL_LINE0, d1
        move.w  #dma_length(32), d3
        move.l  #vdp_comm(0, VdpTarget.Cram, VdpOp.Dma), d2
        jbsr    Build_DMA_Entry

        // Palette line 1: Palette_Buffer+$20 -> CRAM $0020, 32 bytes
        lea     Static_Pal_Line1, a0
        move.l  #SRC_PAL_LINE1, d1
        move.w  #dma_length(32), d3
        move.l  #vdp_comm($20, VdpTarget.Cram, VdpOp.Dma), d2
        jbsr    Build_DMA_Entry

        // Palette line 2: Palette_Buffer+$40 -> CRAM $0040, 32 bytes
        lea     Static_Pal_Line2, a0
        move.l  #SRC_PAL_LINE2, d1
        move.w  #dma_length(32), d3
        move.l  #vdp_comm($40, VdpTarget.Cram, VdpOp.Dma), d2
        jbsr    Build_DMA_Entry

        // Palette line 3: Palette_Buffer+$60 -> CRAM $0060, 32 bytes
        lea     Static_Pal_Line3, a0
        move.l  #SRC_PAL_LINE3, d1
        move.w  #dma_length(32), d3
        move.l  #vdp_comm($60, VdpTarget.Cram, VdpOp.Dma), d2
        jbsr    Build_DMA_Entry

        // Sprite table: Sprite_Table_Buffer -> VRAM sprite table. 640 bytes is
        // the boot default only — Render_Sprites (sprites H3) re-patches the
        // length words (SizeH/SizeL via movep.w) every frame to the live entry
        // count, so the SAT DMA ships only entries up to the chain terminator.
        lea     Static_Sprite_DMA, a0
        move.l  #SRC_SPRITE_TABLE, d1
        move.w  #dma_length(640), d3
        move.l  #vdp_comm(VRAM_SPRITE_TABLE, VdpTarget.Vram, VdpOp.Dma), d2
        jbsr    Build_DMA_Entry

        // §4.6 HScroll cell mode: Hscroll_Buffer -> VRAM_HSCROLL_TABLE, 112 bytes
        lea     Static_Hscroll_Cell, a0
        move.l  #SRC_HSCROLL, d1
        move.w  #dma_length(112), d3
        move.l  #vdp_comm(VRAM_HSCROLL_TABLE, VdpTarget.Vram, VdpOp.Dma), d2
        jbsr    Build_DMA_Entry

        // §4.6 HScroll line mode: Hscroll_Buffer -> VRAM_HSCROLL_TABLE, 896 bytes
        // (tail-calls the shared builder — the seventh entry's build IS the tail)
        lea     Static_Hscroll_Line, a0
        move.l  #SRC_HSCROLL, d1
        move.w  #dma_length(896), d3
        move.l  #vdp_comm(VRAM_HSCROLL_TABLE, VdpTarget.Vram, VdpOp.Dma), d2
        jbra    Build_DMA_Entry
}

// -----------------------------------------------
// Build_DMA_Entry — lay one 14-byte DMAEntry. THE only place that knows the interleaved
// byte layout, which is why it is a proc rather than the local label it used to be:
// the off-screen ship (engine.effects.raster) builds its entry at INSTALL time from
// parameters carried in the program's ROM trailer, and a second copy of this movep
// sequence would be a second thing to keep in step with the struct.
//
//   a0 = destination DMAEntry   d1 = source (address >> 1)   d2 = VDP command longword
//   d3 = length in WORDS        d0 = $94 sign-extended       d4 = $93979695 markers
//
// d0/d4 are inputs rather than locals because BuildStaticDMA sets them once and builds
// seven entries; a caller building ONE must set them itself.
//
// THE MARKER REGISTER IS d4, NOT d5, and that is a contract-closure fact rather than taste:
// the off-screen ship builds its entry under Raster_InstallPatched, whose caller chain
// (Effects_InstallPreset, Parallax_CheckBoundary) declares only d0-d4. A d5 here propagates
// as `transitive d5` up all three and fails the closure gate — restoring it around the call
// does not help, because the declaration is what the analysis reads.
//
// Offset 3 is written TWICE and the order is load-bearing: movep.l lays the source's top
// byte there, then movep.w's length low byte overwrites it. The settled value at 3 is SizeL.
// -----------------------------------------------
proc Build_DMA_Entry (a0: u32, d0: u16, d1: u32, d2: u32, d3: u16, d4: u32) {
        move.b  d0, DMAEntry.Reg94(a0)
        movep.l d4, DMAEntry.Reg93(a0)
        movep.l d1, DMAEntry.SizeL(a0)          // source -> offsets 3,5,7,9
        movep.w d3, DMAEntry.SizeH(a0)          // length -> offsets 1,3
        move.l  d2, DMAEntry.Command(a0)
        rts
}

// -----------------------------------------------
// PlaneMapToVRAM — CPU-based row-by-row nametable writer
// For one-shot plane loads (title screens, menus, level init).
// Use during display-off or VBlank only.
// Exported API awaiting its consumers — the title/menu system is the intended
// caller; no call site exists in the tree yet (deliberate forward-scaffolding,
// kill condition on the campaign gap-ledger).
// PRECONDITION: the per-row `add.l` command advance is carry-blind across the
// VDP command word's A15:A14 split — the target nametable must sit inside one
// $4000-aligned address segment (any aligned <=4KB nametable qualifies).
// In:  a1   = source nametable data (VDP-ready words)
//      d0.l = VDP write command for top-left cell
//      d1.w = width in cells - 1
//      d2.w = height in rows - 1
// Out: none
// Clobbers: d0-d4, a1, a5-a6
// -----------------------------------------------
pub proc PlaneMapToVRAM (a1: *u8, d0: u32, d1: u16, d2: u16) clobbers(d0-d4/a1/a5-a6) {
        move.l  #vdp_comm_delta(plane_loc(PLANE_H_CELLS, 0, 1)), d4
        lea     VDP_DATA, a6                    // (VDP_DATA).l
        lea     VDP_CTRL_OFF(a6), a5
    .row:
        move.l  d0, (a5)                        // set VRAM write address
        move.w  d1, d3
    .cell:
        move.w  (a1)+, (a6)                     // write one nametable word
        dbf     d3, .cell
        add.l   d4, d0                          // advance to next row
        dbf     d2, .row
        rts
}

// -----------------------------------------------
// Enqueue_Dirty_Buffers — enqueue dirty palette lines and sprite table
// Called from VBlank handlers inside the DMA window (sound build: the
// SND_CTRL_DMA_ACTIVE flag bracket is raised, the Z80 runs free on its DRAIN
// path; sound-off build: the Z80 is bus-stopped for the whole window).
// In:  none
// Out: none
// Clobbers: d0, a1-a2
// -----------------------------------------------
// Each dirty bit / flag is cleared ONLY when its enqueue succeeded (carry clear).
// On a drop (Critical queue full — reachable during a fade + heavy art staging)
// the bit is left set so the next VBlank retries it, instead of clearing it and
// leaving stale palette/SAT data in VRAM indefinitely.
pub proc Enqueue_Dirty_Buffers () clobbers(d0/a1-a2) requires(vblank) {
        move.b  Palette_Dirty, d0               // (Palette_Dirty).w
        beq     .no_pal
        btst    #0, d0
        beq     .skip_pal0
        queue_static_dma(Static_Pal_Line0)
        bcs     .skip_pal0                      // dropped -> leave bit 0 set
        bclr    #0, Palette_Dirty               // enqueued -> clear bit 0
        // R1 splice: snapshot line 0 iff dirty AND accepted (both guard branches are
        // upstream). Eight unrolled move.l on COST grounds (160 vs 244 cyc for a dbf
        // loop) — not register pressure; this file's own line-3 note frees d0 there.
        // Spec: docs/superpowers/specs/2026-08-16-parcel-r1-palette-bands-v6.md §2.1.
        lea     Palette_Buffer, a1
        lea     Palette_Ship_Snap, a2
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
    .skip_pal0:
        btst    #1, d0
        beq     .skip_pal1
        queue_static_dma(Static_Pal_Line1)
        bcs     .skip_pal1
        bclr    #1, Palette_Dirty
        // R1 splice, line 1 — see line 0 above.
        lea     Palette_Buffer+$20, a1
        lea     Palette_Ship_Snap+$20, a2
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
    .skip_pal1:
        btst    #2, d0
        beq     .skip_pal2
        queue_static_dma(Static_Pal_Line2)
        bcs     .skip_pal2
        bclr    #2, Palette_Dirty
        // R1 splice, line 2 — see line 0 above.
        lea     Palette_Buffer+$40, a1
        lea     Palette_Ship_Snap+$40, a2
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
    .skip_pal2:
        btst    #3, d0
        beq     .skip_pal3
        queue_static_dma(Static_Pal_Line3)
        bcs     .skip_pal3
        bclr    #3, Palette_Dirty
        // R1 splice, line 3 — see line 0 above.
        lea     Palette_Buffer+$60, a1
        lea     Palette_Ship_Snap+$60, a2
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
    .skip_pal3:
    .no_pal:
        // ---- the off-screen frame-top ship (patched programs that declare one) ----
        // When a patch channel's world anchor is ABOVE the screen, its fire can only pin at
        // its band floor, leaving the rows above that floor showing the base palette — fully
        // submerged with a permanently dry stripe at the top. This re-issues the fire's OWN
        // colours as a frame-top DMA so they cover the whole screen instead.
        //
        // The entry is pre-built in the program's ROM trailer and the pointer is install-time
        // state, so this costs a test and a taken branch on every frame that does not need it.
        //
        // IT SITS AFTER THE PALETTE BLOCK, and the ORDER against line 2's base ship is the
        // point: the base ship reloads Palette_Buffer over these same CRAM entries, so a ship
        // queued BEFORE it would be undone in the same frame. DMA-queue order is what matters,
        // not source-line order, and everything above is already queued by here.
        //
        // d0 is free at this point — its Palette_Dirty snapshot is dead after the bit-3 test.
        move.l  Effects_Offscreen_Entry, d0
        beq     .no_ship
        // btst instead of a saved carry: bit 2 CLEAR means line 2 either shipped this frame or
        // was not dirty, and both are legal. Bit 2 still SET means the base ship DROPPED (queue
        // full), and shipping over a line that did not get reloaded is not a state to add to.
        btst    #2, Palette_Dirty               // (Palette_Dirty).w
        bne     .no_ship
        movea.l d0, a2
        move.w  (a2), d0                        // the channel this entry belongs to
        add.w   d0, d0
        lea     Effects_Screen_L, a1            // (Effects_Screen_L).w
        tst.w   (a1, d0.w)                      // the LATCHED line — never recomputed here
        bgt     .no_ship                        // still on screen: the fire owns the boundary
        // Replay the fire's SetReg ops BEFORE the DMA enqueue, while a2 still points into the
        // trailer (queue_static_dma clobbers it). Entry layout after the channel word:
        // [stage off][colour count][CRAM addr][reg count][reg words...].
        //
        // THIS WRITES THE VDP DIRECTLY, and the position is what makes that safe and
        // self-restoring: Flush_VDP_Shadow has ALREADY run this VBlank (vblank.emp — Raster,
        // then Flush, then here), so a register written now survives the frame, and NEXT
        // frame's unconditional flush puts the shadow value back. Transient by construction,
        // exactly like the palette side — no restore path, no state to leave behind.
        //
        // WHY IT IS NEEDED AT ALL: the ship exists because the fire's line clamps into its
        // band, so the rows above that line never see the fire. The palette half was covered
        // by the DMA; the register half was not, and OJZ's water fire carries sh_on() — the
        // top rows came out tinted but with Shadow/Highlight still off, i.e. visibly lighter.
        movea.l Effects_Offscreen_Entry, a2
        move.w  8(a2), d0                       // reg count
        beq     .ship_dma
        lea     10(a2), a1                      // -> the reg words
        subq.w  #1, d0
    .ship_reg:
        move.w  (a1)+, VDP_CTRL
        dbf     d0, .ship_reg
    .ship_dma:
        queue_static_dma(Static_Pal_Ship)       // built at install from the trailer's params
    .no_ship:
        tst.b   Sprite_Table_Dirty              // (Sprite_Table_Dirty).w
        beq     .no_spr
        tst.b   Sprite_Emit_Active              // NEW-3: a drop-retained dirty +
        bne     .no_spr                         //   mid-emit buffer = torn ship;
                                                //   keep dirty armed, retry next
                                                //   VBlank (worst case one extra
                                                //   stale-SAT frame, on a lag frame)
        queue_static_dma(Static_Sprite_DMA)
        bcs     .no_spr                         // dropped -> leave flag set for retry
        clr.b   Sprite_Table_Dirty              // enqueued -> clear
    .no_spr:
        // §4.6: enqueue HScroll DMA when a parallax_config is active.
        // Mode auto-selected: any H-deform table -> per-line (896B), else per-cell (112B).
        // Since Parcel W a world-anchored overlay ALSO forces per-line, because an anchored
        // boundary lands on an arbitrary scanline and per-cell can only place a cell edge.
        // Length keys off the ACTIVE config (Target during a transition) so the DMA
        // byte count matches the mode the buffer was built + the VDP was told to
        // render in — otherwise a mode-differing transition ships a cell-length DMA
        // for a line-mode buffer (or vice versa) = the ≤16-frame tear.
        //
        // THIS IS THE TWIN of parallax.emp's Step-4 mode select, keyed off the SAME fields.
        // The two must be changed together or the length and the buffer disagree.
        jbsr    Parallax_Active_Config          // d0 = active config; Z reflects d0
        beq     .hs_cell                        // NULL -> per-cell default
        movea.l d0, a1
        move.l  parallax_config.pcfg_deform_table_fg(a1), d0
        or.l    parallax_config.pcfg_deform_table_bg(a1), d0
        bne     .hs_line
        cmpi.b  #PARALLAX_ANCHOR_NONE, parallax_config.pcfg_anchor_ch(a1)
        beq     .hs_cell
    .hs_line:
        queue_static_dma(Static_Hscroll_Line)
        jbra    .hs_done
    .hs_cell:
        queue_static_dma(Static_Hscroll_Cell)
    .hs_done:
        rts
}
