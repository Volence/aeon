// VBlank handler with function pointer dispatch and lag detection (§1.2)
module engine.vblank in vblank

use engine.constants.{VDP_CTRL}
use engine.z80_bus.{z80_stopped}
use engine.irq.{ints_off, vblank}
use engine.structs.{DMAEntry}
// Art-streaming P2a: the resumable decoder's toolchain extent symbols
// (ZX0R_Decompress / ZX0R_Decompress.__end) — the VBlank bookmark's PC range.
use engine.zx0_resume.{ZX0R_Decompress}

use engine.sound_constants.*

// 68k-side view of the Z80 sound driver's DMA-window flag (SND_Z80_BASE +
// SND_CTRL_DMA_ACTIVE). Comptime-folded sum; the bare operand spelling
// width-selects abs.l ($A01F04 sits outside the abs.w window). This equ names a
// global linker symbol — Section_RedrawPlanes references it for its own poke-storm
// flag bracket.
equ SND_DMA_ACTIVE_SLOT = SND_Z80_BASE + SND_CTRL_DMA_ACTIVE

// The Z80-state snapshot Sound_DebugMirror is now engine.debug.sound_debug-owned
// (sound_debug.emp, t28). The comptime-gated CALL below (DEBUG × SOUND_DRIVER_ENABLED
// × SOUND_DBG_MIRROR — the mirror shape) resolves module-to-module to that proc; no
// extern decl (a decl + the .emp-owned proc would §11-Q4 collide, the kill-row-33
// precedent). In every other shape the call is comptime-false, so nothing references it.

// The VInt_Ptr dispatch runs one of the VBlank pipeline handlers — an honest
// ⊤ bound (the handlers' own contracts are narrower; the full save/restore
// around the dispatch makes the bound free).
type VBlankHandler = proc () clobbers(d0-d7/a0-a6)

// -----------------------------------------------
// VBlank_Handler — IRQ6 entry point
// Dispatches through VInt_Ptr on normal frames,
// VInt_Lag when main loop hasn't finished.
//
// CPU-STATE ONLY: clobbers() is empty BECAUSE the movem round-trip — enforced
// by preserves() — restores all CPU register state before rte (interrupt
// transparency — the hblank.emp HBlankHandler convention). It does NOT cover VDP
// latch/autoincrement state: the dispatched handlers own the engine's
// VDP-access invariants.
// -----------------------------------------------
pub proc VBlank_Handler () clobbers() preserves(d0-d7/a0-a6) grants(vblank) {
        movem.l d0-a6, -(sp)
        // --- Art-streaming P2a VBlank bookmark (survey §2) ---
        // If a resumable art decode (ZX0R) was interrupted, redirect this rte to
        // PageIn_BankRegs so it banks the decoder's live registers + CCR and yields
        // to the main loop. The PC is read/rewritten via the Sigil irq_frame.pc
        // accessor (toolchain-derived (disp,sp) off the movem above — no hand
        // VBH_STACKED_PC constant), range-checked against the decoder's extent
        // symbols. The redirect takes effect at THIS handler's rte, AFTER
        // VInt_Level's whole pipeline + the movem restore, so the bookmark stays the
        // V-int's final act even though the check runs at entry. The check runs
        // BEFORE the Ready/dispatch split, so it banks on WHICHEVER path dispatches.
        // The corrected invariant is "the bank is safe on whichever path dispatches",
        // NOT the sketch §2 "the lag path can never bank" (that lemma is over-stated):
        // if a VBlank straddles the pre-decoder setup window (PageIn_Resume's
        // restore/push, or the scaffold's page scan) it correctly does NOT bank (PC
        // outside the range), runs VInt_Level, and clears Ready — so the decode can
        // then run to the NEXT VBlank with Ready=0 and get banked on the VInt_Lag
        // dispatch. That straddle path is SAFE: the main loop is parked in the decoder,
        // so Plane_Buffer is already drained and VInt_Lag's skipped drain is a no-op,
        // and the banked context survives either path via the movem round-trip (the
        // rare cost is a single benign lag frame — see DEFERRED_WORK). A SUSPENDED
        // decode (InFlight=1 but PC is main-loop code, outside the range) is never
        // bookmarked, and PageIn_BankRegs / PageIn_Resume both sit outside the range,
        // so a VBlank landing mid-bank/mid-resume stays transparent.
        tst.b   PageIn_InFlight                 // art decode possibly interrupted?
        beq     .no_bookmark
        move.l  irq_frame.pc, d0                // the PC the rte will return to
        cmpi.l  #ZX0R_Decompress, d0
        bcs     .no_bookmark                    // PC < decoder start -> not in range
        cmpi.l  #ZX0R_Decompress.__end, d0
        bcc     .no_bookmark                    // PC >= decoder end   -> not in range
        move.l  d0, PageIn_Saved_PC             // bank the interrupted decoder PC
        move.l  #PageIn_BankRegs, irq_frame.pc  // redirect the rte to the banking stub
        if DEBUG == 1 {
            addq.w  #1, Dbg_PageIn_Preempts      // bookmark redirects (decode sliced by a VBlank)
        }
    .no_bookmark:
        tst.b   VBlank_Ready                    // (VBlank_Ready).w
        beq     .lag
        movea.l VInt_Ptr, a0                    // (VInt_Ptr).w
        jsr     (a0) as VBlankHandler           // computed dispatch (bare jsr by the jbra/jbsr rule)
        jbra    .done
    .lag:
        jbsr    VInt_Lag
    .done:
        if DEBUG == 1 && SOUND_DRIVER_ENABLED == 1 && SOUND_DBG_MIRROR == 1 {
            jbsr    Sound_DebugMirror           // Z80-state snapshot (stops Z80 ~190us -> 60Hz tick;
                                                // OFF by default so DEBUG audio is clean)
        }
        moveq   #0, d0
        move.b  d0, VBlank_Ready                // (VBlank_Ready).w
        movem.l (sp)+, d0-a6
        rte
}

// -----------------------------------------------
// VInt_Level — full pipeline handler (normal frames)
// Execution order: shadow flush -> dirty enqueue -> plane-buffer drain ->
//   Critical drain -> VSRAM -> budget -> Important drain -> Deferrable drain ->
//   controllers -> frame counter -> VBlank flag
// Clobbers: the union of the pipeline callees (Flush_VDP_Shadow d0-d3/a0-a1 ·
//   Enqueue_Dirty_Buffers d0/a1-a2 · VInt_DrawLevel d0-d1/a0/a5-a6 ·
//   Process_DMA_Critical a1/a5 · Vscroll_Write d0/a0/a5 ·
//   Process_DMA_Important/Deferrable d0-d1/a0-a3/a5 · Read_Controllers d0-d4/a0)
// (d4 enters the union with the 6-button burst — Read_Controllers widened, input parcel 2026-08-02)
// -----------------------------------------------
pub proc VInt_Level () clobbers(d0-d4/a0-a3/a5-a6) requires(vblank) {
        // --- VDP work ---
        // Sound (MegaPCM-2 model): when the Z80 sound driver is enabled we do NOT
        // stop the Z80 during the VDP/DMA pipeline. Instead we raise a FLAG BRACKET
        // around the whole VDP/DMA window: SND_CTRL_DMA_ACTIVE=1 here at the very
        // top (before ANY VDP work), cleared =0 after the last DMA below. The Z80
        // producer checks this flag every sample and takes its DRAIN path (feeds
        // the DAC from the RAM ring with NO ROM read) for as long as the flag is
        // set — so a banked ROM read can never land inside a DMA burst and stall
        // the Z80 bus (the under-load pitch sag). The brief bus-held byte write is
        // the ONLY 68k bus hold in the sound build; the DMA pipeline itself runs
        // with the Z80 free. The OFF build keeps the original full-DMA Z80 fence.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #1, SND_DMA_ACTIVE_SLOT // raise: DMA window open (Z80 -> DRAIN)
            }
        }
        // Sound-OFF fence: with no driver to hand the DRAIN contract to, the whole
        // VDP/DMA pipeline runs with the bus held. The bracket is comptime-gated so
        // ONE body serves both shapes — under sound ON it lowers unbracketed and the
        // flag pair above is the fence instead.
        with z80_stopped if SOUND_DRIVER_ENABLED == 0 {
            // Seed the frame's window budget BEFORE any VDP work (§1.1). The two big
            // window riders below (plane drain + Critical DMA) then charge it as they
            // run, so the Important/Deferrable drain sees the true blanking-window
            // headroom left — not the whole window as if nothing had run.
            move.w  (DMA_Budget_Default).w, (DMA_Budget_Remaining).w    // widths pinned: mem-to-mem two-symbolic operands need both widths spelled
            // Vectorman dual cap (P2c Task 8): clear the frame's enqueue-side running
            // byte total. Every QueueDMA_* enqueue charges it; over DMA_ENQ_BYTE_CAP the
            // enqueue is rejected like a full queue. Reset here beside the drain-window budget.
            clr.w   (DMA_Enq_Bytes_Frame).w
            // NOTE: the per-act ART budget (P2c Task 9) is reloaded in PageIn_Process's
            // own once-per-physical-frame tick, NOT here — it is charged in the main loop
            // every frame, so it must be reloaded in the same context (Frame_Counter tick,
            // which advances on both the VInt_Level and VInt_Lag paths) to stay in-phase.
            // A VInt_Level-only reload was skipped on VInt_Lag frames -> spurious deferral
            // -> held-frame famine -> STRESS clamp thrash (chain-77 soak fix). The DMA
            // enqueue byte cap above is charged by many enqueuers with no main-loop tick,
            // so it stays here (frame boundary, matches DMA_Budget_Remaining); its 12288
            // ceiling is coarse enough that a rare straddle accumulation is benign.

            jbsr    Flush_VDP_Shadow

            jbsr    Enqueue_Dirty_Buffers   // queues palette + sprites + HScroll (§4.6)

            // Charge the plane drain against the window budget: Plane_Buffer_Ptr is
            // this frame's pending buffer-content bytes (0 = empty), a conservative
            // proxy for the CPU-written drain's window cost (headers counted in;
            // the CPU-write rate running above 2.7 cyc/byte is absorbed by the
            // DMA_BUDGET_* safety margin). Read it BEFORE VInt_DrawLevel zeroes it.
            move.w  Plane_Buffer_Ptr, d0
            sub.w   d0, DMA_Budget_Remaining
            jbsr    VInt_DrawLevel          // drain Plane_Buffer to VDP (§4.1)

            // Charge the Critical DMA (mandatory, always fully drains): sum the queued
            // entries' byte sizes and subtract them, so the leftover for Important/
            // Deferrable reflects the window Critical is about to consume. Walk runs
            // between Enqueue_Dirty_Buffers (fills the queue) and Process_DMA_Critical
            // (drains + resets the slot); ≤ DMA_CRITICAL_SLOTS iterations.
            lea     DMA_Critical, a0
            movea.w DMA_Critical_Slot, a2   // (DMA_Critical_Slot).w — first-free entry
            moveq   #0, d1                  // word accumulator
        .charge_critical:
            cmpa.l  a0, a2
            bls     .charged_critical
            moveq   #0, d0
            movep.w DMAEntry.SizeH(a0), d0  // entry length in words
            add.w   d0, d1
            lea     sizeof(DMAEntry)(a0), a0
            jbra    .charge_critical
        .charged_critical:
            add.w   d1, d1                  // words -> bytes
            sub.w   d1, DMA_Budget_Remaining
            // Floor the budget at 0: a pathological rider confluence could drive it
            // negative (u16 underflow reads as signed-negative), and the drain's
            // signed test would already refuse — but keep the stored cell a clean
            // non-negative headroom value (matches the drain's own >= 0 invariant).
            tst.w   DMA_Budget_Remaining
            bpl     .budget_floored
            clr.w   DMA_Budget_Remaining
        .budget_floored:

            jbsr    Process_DMA_Critical    // drains palette + sprites + HScroll

            // §4.6: VSRAM write must come AFTER HScroll DMA (CODING_CONVENTIONS §3.4)
            jbsr    Vscroll_Write

            jbsr    Process_DMA_Important
            // Art-streaming P2a: a published page's staging->VRAM DMA rides the
            // Important queue. Once it has fully drained (the Important queue is
            // empty again), release the staging slot so PageIn_Process can start
            // the next decode. Slot == base means empty (Init_DMA_Queue idiom).
            tst.b   PageIn_Staging_Busy
            beq     .staging_idle
            move.w  DMA_Important_Slot, d0
            cmpi.w  #DMA_Important, d0
            bne     .staging_idle
            clr.b   PageIn_Staging_Busy
        .staging_idle:
            jbsr    Process_DMA_Deferrable
        }

        // Sound (flag bracket close): the VDP/DMA window is finished — ROM is safe
        // to read again. Clear SND_CTRL_DMA_ACTIVE=0 so the Z80 producer leaves its
        // DRAIN path and resumes FILL read-ahead. Net: the flag was 1 for the
        // whole VDP/DMA window. Brief bus-held write (the only 68k bus hold in the
        // sound build); the DMA pipeline above ran with the Z80 free.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #0, SND_DMA_ACTIVE_SLOT // lower: DMA window closed (Z80 -> FILL)
            }
        }

        // --- Non-VDP work ---
        jbsr    Read_Controllers
        // Latch accumulated press edges for the upcoming logic tick.
        // Lag VBlanks only OR into the accumulator, so a press landing in
        // ANY lag frame survives into the next tick's latch (consume-once,
        // zero race: this runs in interrupt context while the main loop is
        // parked in VSync_Wait).
        move.b  (Ctrl_1_Press_Accum).w, (Ctrl_1_Press).w    // widths pinned: mem-to-mem two-symbolic operands
        clr.b   Ctrl_1_Press_Accum
        move.b  (Ctrl_2_Press_Accum).w, (Ctrl_2_Press).w    // widths pinned: mem-to-mem two-symbolic operands
        clr.b   Ctrl_2_Press_Accum
        // 6-button ext press edges latch the same consume-once way (input parcel 2026-08-02)
        move.b  (Ctrl_1_Ext_Press_Accum).w, (Ctrl_1_Ext_Press).w    // widths pinned: mem-to-mem two-symbolic operands
        clr.b   Ctrl_1_Ext_Press_Accum
        move.b  (Ctrl_2_Ext_Press_Accum).w, (Ctrl_2_Ext_Press).w    // widths pinned: mem-to-mem two-symbolic operands
        clr.b   Ctrl_2_Ext_Press_Accum
        addq.w  #1, Frame_Counter
        move.b  #1, VBlank_Flag
        rts
}

// -----------------------------------------------
// VInt_Lag — minimal handler (lag frames)
// Critical DMA only. Important/Deferrable entries persist. The Plane_Buffer
// drain (VInt_DrawLevel) is deliberately NOT run here — on a lag frame the main
// loop is still mid-fill (VBlank_Ready=0) and the buffer is half-written; it
// drains on the next complete frame (VInt_Level). See note below.
// Clobbers: the union of the lag-path callees (Flush_VDP_Shadow d0-d3/a0-a1 ·
//   Enqueue_Dirty_Buffers d0/a1-a2 · Process_DMA_Critical a1/a5 ·
//   Vscroll_Write d0/a0/a5 · Read_Controllers d0-d4/a0)
// (d4 enters the union with the 6-button burst — Read_Controllers widened, input parcel 2026-08-02)
// -----------------------------------------------
proc VInt_Lag () clobbers(d0-d4/a0-a2/a5) requires(vblank) {
        // Sound (flag bracket): see VInt_Level — raise SND_CTRL_DMA_ACTIVE=1 at the
        // very top (before any VDP work) so the Z80 producer takes its DRAIN path
        // for the whole VDP/DMA window; cleared =0 after the last DMA below. OFF
        // build keeps the original full-DMA Z80 fence.
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #1, SND_DMA_ACTIVE_SLOT // raise: DMA window open (Z80 -> DRAIN)
            }
        }
        // Sound-OFF fence: with no driver to hand the DRAIN contract to, the whole
        // VDP/DMA pipeline runs with the bus held. The bracket is comptime-gated so
        // ONE body serves both shapes — under sound ON it lowers unbracketed and the
        // flag pair above is the fence instead.
        with z80_stopped if SOUND_DRIVER_ENABLED == 0 {
            jbsr    Flush_VDP_Shadow
            jbsr    Enqueue_Dirty_Buffers
            // Do NOT drain Plane_Buffer here. On a lag frame the main loop has not
            // finished (VBlank_Ready=0) and is still appending to Plane_Buffer inside
            // Section_UpdateColumns. VInt_DrawLevel drains on Plane_Buffer_Ptr!=0 with
            // no "complete" guard, so draining now reads TORN entries — a half-written
            // entry's addr field is garbage, so the drain writes to a garbage VDP dest
            // (nametable corruption, e.g. Plane B fills with ROM/cache bytes) and then
            // resets Plane_Buffer_Ptr=0 under the main loop's feet, cascading into more
            // lag and more torn drains. The palette/sprite enqueues above ARE safe:
            // they are dirty-FLAG gated (the flag is set only after a complete
            // write), and the sprite ship is additionally Sprite_Emit_Active-gated
            // (NEW-3) — a DROP-RETAINED dirty flag from a full Critical queue is
            // set-but-stale, and without the emit bracket this IRQ could ship the
            // previous length against a mid-emit buffer.
            // The HScroll enqueue is NOT flag-gated (it fires every VBlank) — it is
            // safe by a different, weaker mechanism: the static entry's destination
            // and length are pre-built, so a lag-frame tear corrupts scroll VALUES
            // only (one frame of mixed offsets, self-healing next complete frame),
            // never the VDP destination — the garbage-destination write is what makes
            // the Ptr-gated plane buffer dangerous. The plane drain defers to the
            // next complete frame (VInt_Level, VBlank_Ready=1).
            //
            // Re-assert autoinc = $02 (NEW-1, 2026-08-05). On a complete frame
            // VInt_DrawLevel exits $8F02 unconditionally one call before the
            // drain; on a LAG frame it is skipped (above), so the drain used to
            // REST on the ambient invariant that every $8F80 writer restores
            // before yielding — unasserted, and a future writer that returns
            // without restoring would break Critical DMA on lag frames only, a
            // nearly untestable failure mode. 20 cycles on lag frames buys the
            // invariant back unconditionally (declared-contexts can prove
            // bracket PAIRING but not register VALUES, and an IRQ is not a CFG
            // edge — the structural close was evaluated and ledgered, see
            // DEFERRED_WORK).
            move.w  #$8F02, VDP_CTRL
            jbsr    Process_DMA_Critical
            jbsr    Vscroll_Write           // §4.6 — after Critical DMA
        }

        // Sound (flag bracket close): VDP/DMA window finished — clear the flag so
        // the Z80 producer resumes FILL read-ahead (see VInt_Level).
        if SOUND_DRIVER_ENABLED == 1 {
            with z80_stopped {
                move.b  #0, SND_DMA_ACTIVE_SLOT // lower: DMA window closed (Z80 -> FILL)
            }
        }

        jbsr    Read_Controllers
        addq.w  #1, Frame_Counter
        move.b  #1, VBlank_Flag

        if DEBUG == 1 {
            addq.l  #1, Lag_Frame_Count
        }
        rts
}

// -----------------------------------------------
// VSync_Wait — block until VBlank fires (§1.2.5)
// In:  none
// Out: none
// Clobbers: d0-d2/a0-a3 — d0 is VSync_Wait's own, the rest is the PageIn/decoder
//   union folded in from the idle-time PageIn_Process slice below (Art-streaming
//   P2a, Task 3 Step 6). PageIn_Process adds nothing beyond this set and pushes
//   nothing before falling into the decoder. Every caller was re-verified against
//   the widening: GameLoop already clobbers everything; Level_LoadArt keeps only
//   a4/d5-d7 live across its VSync_Wait calls (all outside this set).
// PRECONDITION: the caller runs below IPL 6 — preserves(sr.mask) faithfully
// re-masks, so a caller already at IPL >= 6 spins forever (no in-tree caller
// does). preserves(sr.mask) is intact across the PageIn slice: the mask
// round-trip is the `with ints_off` bracket's, and a mid-body jbsr does not touch
// the mask (the decode runs at the caller's IPL and bank/resume preserve SR). The
// CCR is NOT the caller's at return: the post-bracket wait loop and flag clear
// write flags after the restore.
// -----------------------------------------------
pub proc VSync_Wait () clobbers(d0-d2/a0-a3) preserves(sr.mask) {
        // Clear any STALE VBlank_Flag first — VInt_Lag (which fires when
        // VBlank_Ready=0) sets VBlank_Flag, so a long pre-Wait operation
        // (e.g., S4LZ_Decompress) can leave the flag set from a previous
        // lag-frame VBlank. Without this clear, VSync_Wait returns
        // immediately and the queued Critical DMA never drains before the
        // CALLER overwrites the source buffer (Art_Staging_Buffer).
        moveq   #0, d0
        // The clear-flag + set-Ready pair below MUST be atomic. If a VBlank IRQ6
        // lands between them (VBlank_Ready still 0), it runs VInt_Lag, which sets
        // VBlank_Flag — so .wait falls through with NO real vsync, while Ready is
        // left =1 for the NEXT VBlank to full-drain a still-mid-fill Plane_Buffer
        // (the torn-drain hazard VInt_Lag's header describes). Mask IRQs across
        // the pair (46 cy — 14+16+16 — on this once-per-frame path); this also makes
        // Lag_Frame_Count exact. SR is restored BEFORE .wait — the wait itself
        // depends on IRQ6 setting the flag.
        with ints_off {
            move.b  d0, VBlank_Flag
            move.b  #1, VBlank_Ready
        }
        // Idle-time art-decode slice (Art-streaming P2a). STRICTLY after the
        // atomic flag-clear/Ready-set bracket: decode is only ever live once
        // VBlank_Ready = 1, which is what makes a mid-decode VBlank always dispatch
        // VInt_Level (never VInt_Lag) — the lag-path bookmark impossibility proof
        // (survey §2). PageIn_Process either finishes/suspends the current slice
        // and returns here, or (fresh/resume) runs the decoder until a VBlank
        // banks it and PageIn_BankRegs's rts returns here.
        jbsr    PageIn_Process
        moveq   #0, d0                          // re-establish d0=0: PageIn_Process clobbers it,
                                                // and the .wait flag-clear below reuses it
    .wait:
        tst.b   VBlank_Flag
        beq     .wait
        move.b  d0, VBlank_Flag
        if DEBUG == 1 {
            move.w  d0, DMA_Bytes_ThisFrame
        }
        rts
}
