// Demo record/replay — the tick-seam input harness (spec 2026-08-02 §3).
module engine.replay in replay

use engine.constants.{INPUT_PLAYBACK, INPUT_RECORD, REPLAY_ESCAPE, REPLAY_OP_CHECK, REPLAY_CHECK_MASK, REPLAY_RECORD_TICKS, BUTTON_START_BIT}
use engine.objects.sst.{Sst, interact_off}

// -----------------------------------------------
// The Player_1 hash map — ADDRESS-FREE BY CONSTRUCTION.
//
// The hash covers Player_1's gameplay state, and ONLY the fields whose value is
// not an address. Every ROM pointer and every RAM pointer in the SST is skipped,
// so two builds that differ only in WHERE things landed (any parcel that shifts
// ROM addresses, any RAM-layout change) hash a behaviour-identical tick to the
// SAME value. That is the property a RECORDED fixture needs to survive a parcel:
// the old whole-SST hash was build-shape specific, which invalidated every
// recorded checkpoint on address-shifting-but-behaviour-neutral work.
//
//   hashed   $02..$0D  x_pos, y_pos, x_vel, y_vel                    3 longs
//            $0E..$0F  render_flags, collision_resp                  word fold
//            $14..$17  art_tile, width_pixels, height_pixels         1 long
//            $18..$19  anim, subtype                                 word fold
//            $1E..$25  status, angle, prev_anim, anim_frame,
//                      anim_timer, mapping_frame, prev_frame,
//                      sprite_piece_count                            2 longs
//            $2A..$2D  slot_tag, entity_section_id,
//                      entity_list_index, layer                      1 long
//            $2E..$4D  sst_custom — the PlayerV overlay              8 longs
//            $4E..$4F  interact — the engine's TouchResponse claim    word fold
//
//   excluded $00 code_addr    ROM address (offset from ObjCodeBase — shifts with
//                             the object-code bank's layout)
//            $10 mappings     ROM pointer
//            $1A anim_table   ROM pointer
//            $26 parent_ptr   RAM pointer (0 for the player — no coverage lost)
//            $28 sibling_ptr  RAM pointer (0 for the player — no coverage lost)
//            $50 frame_off    derived render cache — a pure function of
//                             mappings + mapping_frame, and itself a ROM-relative
//                             offset (excluded before this change too)
//
// CONTRACT: every field inside a hashed span MUST be address-free. Adding a
// pointer field to the SST is fine; moving one INTO a span is not. The ensures
// below pin each excluded field's offset AND the total byte accounting, so any
// reshuffle that would silently re-poison the hash fails the BUILD instead.
// Fix the map (add a new span / a new fold); never widen a span over a pointer.
//
// Span bases are link-time (the extern-equ-sum idiom); span lengths are comptime
// and derived from the BOUNDING EXCLUDED field, so they track the struct.
// -----------------------------------------------
equ HASH_P1_MOTION  = extern("Player_1") + offsetof(Sst, x_pos)         // $02
equ HASH_P1_RENDER  = extern("Player_1") + offsetof(Sst, render_flags)  // $0E (word)
equ HASH_P1_DISPLAY = extern("Player_1") + offsetof(Sst, art_tile)      // $14
equ HASH_P1_ANIMSUB = extern("Player_1") + offsetof(Sst, anim)          // $18 (word)
equ HASH_P1_ANIM    = extern("Player_1") + offsetof(Sst, status)        // $1E
equ HASH_P1_ENTITY  = extern("Player_1") + offsetof(Sst, slot_tag)      // $2A
equ HASH_P1_CUSTOM  = extern("Player_1") + offsetof(Sst, sst_custom)    // $2E
equ HASH_P1_INTERACT = extern("Player_1") + interact_off()              // $4E (word)

const HASH_P1_MOTION_LONGS  = (offsetof(Sst, render_flags) - offsetof(Sst, x_pos)) / 4
const HASH_P1_DISPLAY_LONGS = (offsetof(Sst, anim)         - offsetof(Sst, art_tile)) / 4
const HASH_P1_ANIM_LONGS    = (offsetof(Sst, parent_ptr)   - offsetof(Sst, status)) / 4
const HASH_P1_ENTITY_LONGS  = (offsetof(Sst, sst_custom)   - offsetof(Sst, slot_tag)) / 4
const HASH_P1_CUSTOM_LONGS  = (interact_off()              - offsetof(Sst, sst_custom)) / 4

// Excluded-offset pins: a struct reshuffle that moves a pointer field trips one
// of these by name, so the failure says WHICH pointer moved.
ensure(offsetof(Sst, code_addr)   == $00, "Sst.code_addr moved — it is a ROM-relative address EXCLUDED from Replay_Hash; re-cut the hash map")
ensure(offsetof(Sst, mappings)    == $10, "Sst.mappings moved — ROM pointer EXCLUDED from Replay_Hash; re-cut the hash map")
ensure(offsetof(Sst, anim_table)  == $1A, "Sst.anim_table moved — ROM pointer EXCLUDED from Replay_Hash; re-cut the hash map")
ensure(offsetof(Sst, parent_ptr)  == $26, "Sst.parent_ptr moved — RAM pointer EXCLUDED from Replay_Hash; re-cut the hash map")
ensure(offsetof(Sst, sibling_ptr) == $28, "Sst.sibling_ptr moved — RAM pointer EXCLUDED from Replay_Hash; re-cut the hash map")
ensure(offsetof(Sst, frame_off)   == $50, "Sst.frame_off moved — derived ROM-relative cache EXCLUDED from Replay_Hash; re-cut the hash map")

// Span integrity: every span base must be even (move.l/move.w would otherwise
// address-error), and every long span long-divisible.
ensure(offsetof(Sst, x_pos) % 2 == 0 && offsetof(Sst, art_tile) % 2 == 0 && offsetof(Sst, status) % 2 == 0 && offsetof(Sst, slot_tag) % 2 == 0 && offsetof(Sst, sst_custom) % 2 == 0, "a Replay_Hash long-span base landed odd — move.l would address-error")
ensure(offsetof(Sst, render_flags) % 2 == 0 && offsetof(Sst, anim) % 2 == 0 && interact_off() % 2 == 0, "a Replay_Hash word-fold base landed odd — move.w would address-error")
ensure((offsetof(Sst, render_flags) - offsetof(Sst, x_pos)) % 4 == 0, "Replay_Hash motion span ($02..render_flags) is no longer long-divisible — re-cut the hash map")
ensure((offsetof(Sst, anim) - offsetof(Sst, art_tile)) % 4 == 0, "Replay_Hash display span (art_tile..anim) is no longer long-divisible — re-cut the hash map")
ensure((offsetof(Sst, parent_ptr) - offsetof(Sst, status)) % 4 == 0, "Replay_Hash anim/status span (status..parent_ptr) is no longer long-divisible — re-cut the hash map")
ensure((offsetof(Sst, sst_custom) - offsetof(Sst, slot_tag)) % 4 == 0, "Replay_Hash entity span (slot_tag..sst_custom) is no longer long-divisible — re-cut the hash map")
ensure((interact_off() - offsetof(Sst, sst_custom)) % 4 == 0, "Replay_Hash custom span (sst_custom..interact) is no longer long-divisible — re-cut the hash map")

// Total accounting: hashed bytes + the 16 deliberately-excluded bytes (code_addr 2
// + mappings 4 + anim_table 4 + parent_ptr 2 + sibling_ptr 2 + frame_off 2) must be
// the WHOLE record. Any field added to the SST lands in a span (fine, if it is
// address-free) or outside every span (then this fails, and the map must be
// re-cut deliberately) — nothing drifts out of the hash unnoticed.
const HASH_P1_EXCLUDED_BYTES = 2 + 4 + 4 + 2 + 2 + 2   // code_addr, mappings, anim_table, parent_ptr, sibling_ptr, frame_off
// (the trailing + 6 = the three word folds: render_flags/collision_resp, anim/subtype, interact)
const HASH_P1_HASHED_BYTES = (HASH_P1_MOTION_LONGS + HASH_P1_DISPLAY_LONGS + HASH_P1_ANIM_LONGS + HASH_P1_ENTITY_LONGS + HASH_P1_CUSTOM_LONGS) * 4 + 6
ensure(HASH_P1_HASHED_BYTES + HASH_P1_EXCLUDED_BYTES == sizeof(Sst),
        "Replay_Hash no longer accounts for every SST byte ({HASH_P1_HASHED_BYTES} hashed + {HASH_P1_EXCLUDED_BYTES} excluded != sizeof(Sst)) — a field was added or moved; re-cut the hash map (and keep it address-free)")

// -----------------------------------------------
// Input_Tick — the ONE replay seam. Called from GameLoop AFTER VSync_Wait (VInt
// has already latched the pads) and BEFORE the state dispatch, so every input
// consumer downstream is untouched.
//
//   INPUT_LIVE     (0): no-op — the pads flow through unchanged.
//   INPUT_PLAYBACK (1): overwrite Ctrl_1_Held / Ctrl_1_Press from the stream.
//                       Presses derive from the STREAM's previous byte, NEVER the
//                       live pad (the S1 REV00 / S2 input-bleed desync class,
//                       killed structurally). A live Start press sets
//                       Replay_Exit_Request WITHOUT merging into the latched
//                       bytes (the replayed stream stays pure). On end-of-stream:
//                       Replay_Done set, revert to live.
//   INPUT_RECORD   (2): DEBUG only — tap the latched Ctrl_1_Held into the ring +
//                       emit a curated-state checkpoint every 64 ticks.
//
// In:  none (reads Input_Source + the latched controller cells)
// Out: Ctrl_1_Held / Ctrl_1_Press possibly overwritten (playback); ring + log
//      appended (record); Replay_* flags updated.
// Clobbers: d0-d3, a0-a1
// -----------------------------------------------
pub proc Input_Tick () clobbers(d0-d3/a0-a1) {
        move.b  Input_Source, d0
        beq     .live                       // INPUT_LIVE -> no-op
        cmpi.b  #INPUT_PLAYBACK, d0
        beq     .playback
        if DEBUG == 1 { jbra .record }      // only INPUT_RECORD remains; it exists in DEBUG only
    .live:
        rts

    // --- PLAYBACK ---------------------------------------------------------
    .playback:
        // Live Start -> exit-request FLAG. Read BEFORE the overwrite clobbers
        // Ctrl_1_Press; the flag is public (the game polls it) and is NEVER merged
        // into the latched bytes — the replayed input stream stays byte-pure.
        btst    #BUTTON_START_BIT, Ctrl_1_Press
        beq     .no_exit
        st      Replay_Exit_Request
    .no_exit:
        tst.b   Replay_Hold
        bne     .hold                       // still inside the current RLE run
    .fetch:
        movea.l Replay_Ptr, a0
    .fetch_a0:                              // re-entry: a0 already = stream ptr
        move.b  (a0)+, d0
        cmpi.b  #REPLAY_ESCAPE, d0
        bne     .pair                       // ordinary buttons byte -> new RLE run
        move.b  (a0)+, d1                   // escape opcode
        beq     .end                        // REPLAY_OP_END ($00)
        cmpi.b  #REPLAY_OP_CHECK, d1
        bne     .bad_stream                 // unknown opcode
        // checkpoint record: u32 expected hash follows.
        if DEBUG == 1 {
            move.l  (a0)+, d2               // expected hash (d2 survives Replay_Hash)
            move.l  a0, Replay_Ptr          // advance PAST the record before the clobbering call
            jbsr    Replay_Hash             // d0.l = curated-block hash (clobbers d0-d1/a0-a1)
            cmp.l   d0, d2
            bne     .desync
            movea.l Replay_Ptr, a0          // reload the advanced ptr, fetch the real pair this tick
            jbra    .fetch_a0
        }
        if DEBUG == 0 {
            addq.l  #4, a0                   // release: step over the payload, no compare
            jbra    .fetch_a0
        }
    .pair:
        move.b  (a0)+, Replay_Hold          // hold_minus_1 (run_len - 1; 0 = this tick only)
        move.l  a0, Replay_Ptr
        jbra    .apply                       // d0 = the new held byte
    .hold:
        subq.b  #1, Replay_Hold
        move.b  Replay_Prev, d0             // same byte as last tick
    .apply:
        // press = new & (new ^ prev_stream) — STREAM history, not the live pad.
        move.b  Replay_Prev, d1
        move.b  d0, Replay_Prev
        eor.b   d0, d1
        and.b   d0, d1
        move.b  d0, Ctrl_1_Held
        move.b  d1, Ctrl_1_Press
        rts
    .end:
        st      Replay_Done
        clr.b   Input_Source                // revert to live
        rts

    // Unknown escape opcode: a DEBUG trap (corrupt/foreign stream), a graceful
    // end in release. Split per shape so neither carries dead code after the tail.
    if DEBUG == 1 {
    .bad_stream:
        raise_exception "REPLAY BAD OPCODE"
    .desync:
        // curated-block mismatch: d0 = actual, d2 = expected, d1 = tick. The MD
        // Debugger register dump shows all three.
        move.l  Logic_Tick, d1
        raise_exception "REPLAY DESYNC"
    }
    if DEBUG == 0 {
    .bad_stream:
        jbra    .end
    }

    // --- RECORD (DEBUG only) ---------------------------------------------
    if DEBUG == 1 {
    .record:
        move.w  Replay_Record_Idx, d0
        cmpi.w  #REPLAY_RECORD_TICKS, d0
        bhs     .rec_stop                   // ring already full (defensive)
        // Checkpoint BEFORE storing this tick's input: at ring indices 0, 64, 128…
        // the hash captures the curated state at the START of this tick — the same
        // point playback compares it, so the packer places the record before this
        // tick's input pair.
        move.w  d0, d1
        andi.w  #REPLAY_CHECK_MASK, d1
        bne     .rec_store
        move.w  Replay_Check_Idx, d1
        lsl.w   #3, d1                       // entry stride 8 (tick u32, hash u32)
        lea     Replay_Check_Log, a1
        move.l  Logic_Tick, d0               // via a register: sigil can't lower abs-sym + indexed in one move
        move.l  d0, (a1,d1.w)
        jbsr    Replay_Hash                  // d0 = hash (clobbers d0-d1/a0-a1)
        move.w  Replay_Check_Idx, d1         // reload the entry offset (d1 clobbered)
        lsl.w   #3, d1
        lea     Replay_Check_Log, a1
        move.l  d0, 4(a1,d1.w)
        addq.w  #1, Replay_Check_Idx
    .rec_store:
        move.w  Replay_Record_Idx, d0        // reload (hash may have clobbered d0)
        move.b  Ctrl_1_Held, d1
        lea     Replay_Record_Buf, a0
        move.b  d1, (a0,d0.w)
        addq.w  #1, d0
        move.w  d0, Replay_Record_Idx
        cmpi.w  #REPLAY_RECORD_TICKS, d0
        bne     .rec_ret
    .rec_stop:
        st      Replay_Done
        clr.b   Input_Source
    .rec_ret:
        rts
    }
}

// -----------------------------------------------
// Replay_Hash — the curated gameplay-state checksum (DEBUG net + recorder).
// Longword sum + rol #1 over a const (addr, len_longs) table for the longword-
// clean regions, then word folds for the odd cells:
//   Logic_Tick (1) · Player_1's five address-free SST spans (15 longs) ·
//   Camera_X + Camera_Y (2) ·
//   Section streaming state (Top+Bottom · Right+Left · Fwd · Bwd) ·
//   Player_1 render_flags+collision_resp / anim+subtype / interact (words) ·
//   Dynamic_Live_Count / Dynamic_Free_SP / Effect_Free_SP (words) ·
//   Section_Plane_Dirty (word).
// Excludes sound RAM, Ctrl_* cells, VDP staging, DEBUG-only cells — gameplay state
// only. The Player_1 coverage is ADDRESS-FREE: every SST field holding a ROM or RAM
// address is skipped (see the hash-map block at the top of this module for the
// per-field map, the reasons, and the build-time ensures that keep it honest), so a
// behaviour-neutral parcel that merely shifts addresses reproduces recorded
// checkpoint hashes and the committed fixture stays a valid regression net.
// WARNING: any field added to a hashed span MUST be address-free — a pointer
// landing inside one silently re-poisons every recorded fixture.
// The plan's Slot_Section_Map / Section_Stream_State names do NOT
// exist in engine/ram.emp (the A.4 art-stream state machine was never landed under
// those labels — they survive only in stale docs); the real section-streaming cells
// stand in for the intent (cover streaming progress so a stream desync is caught).
// Out: d0.l  Clobbers: d0-d1, a0-a1
// -----------------------------------------------
pub proc Replay_Hash () clobbers(d0-d1/a0-a1) {
        moveq   #0, d0                       // accumulator
        lea     .hash_table, a1
    .hash_next:
        move.l  (a1)+, d1                    // region base (0 = end of longword table)
        beq     .hash_wtail
        movea.l d1, a0
        move.l  (a1)+, d1                    // length in longwords
    .hash_fold:
        rol.l   #1, d0
        add.l   (a0)+, d0
        subq.l  #1, d1
        bne     .hash_fold
        bra     .hash_next
    .hash_wtail:
        // Odd (non-longword) gameplay words, folded the same way. The first three
        // are Player_1 cells stranded between the address-free long spans (the
        // pointer fields sit between them) — see the hash map at the top.
        moveq   #0, d1
        move.w  HASH_P1_RENDER, d1           // render_flags + collision_resp ($0E)
        rol.l   #1, d0
        add.l   d1, d0
        moveq   #0, d1
        move.w  HASH_P1_ANIMSUB, d1          // anim + subtype ($18)
        rol.l   #1, d0
        add.l   d1, d0
        moveq   #0, d1
        move.w  HASH_P1_INTERACT, d1         // interact ($4E — sst.emp's interact_off())
        rol.l   #1, d0
        add.l   d1, d0
        moveq   #0, d1
        move.w  Dynamic_Live_Count, d1
        rol.l   #1, d0
        add.l   d1, d0
        moveq   #0, d1
        move.w  Dynamic_Free_SP, d1
        rol.l   #1, d0
        add.l   d1, d0
        moveq   #0, d1
        move.w  Effect_Free_SP, d1
        rol.l   #1, d0
        add.l   d1, d0
        moveq   #0, d1
        move.w  Section_Plane_Dirty, d1      // Plane_Dirty byte + its pad byte
        rol.l   #1, d0
        add.l   d1, d0
        rts

    // (addr.l, len_longs.l) pairs, 0-terminated. move.l reads at even (not
    // necessarily 4-aligned) addresses — legal on the 68000.
    .hash_table:
        dc.l    Logic_Tick, 1
        // Player_1 — the address-free spans only (map + reasons at the top of this
        // module). The gaps between rows are exactly the excluded pointer fields.
        dc.l    HASH_P1_MOTION,  HASH_P1_MOTION_LONGS   // $02 x_pos, y_pos, x_vel, y_vel
        dc.l    HASH_P1_DISPLAY, HASH_P1_DISPLAY_LONGS  // $14 art_tile, width, height
        dc.l    HASH_P1_ANIM,    HASH_P1_ANIM_LONGS     // $1E status..sprite_piece_count
        dc.l    HASH_P1_ENTITY,  HASH_P1_ENTITY_LONGS   // $2A slot_tag..layer
        dc.l    HASH_P1_CUSTOM,  HASH_P1_CUSTOM_LONGS   // $2E sst_custom (PlayerV)
        dc.l    Camera_X, 2                  // Camera_X + Camera_Y (contiguous)
        dc.l    Section_Top_Row_Written, 1   // Top + Bottom (contiguous words)
        dc.l    Section_Right_Col_Written, 1 // Right + Left
        dc.l    Section_Fwd_Neighbor_Data, 1
        dc.l    Section_Bwd_Neighbor_Data, 1
        dc.l    0, 0                         // terminator
}
