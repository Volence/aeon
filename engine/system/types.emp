// -----------------------------------------------
// engine.types — the engine's domain-type vocabulary (construct-walk #3,
// 2026-07-10, Volence-ratified names)
//
// Every type here erases to the raw representation — zero bytes, zero
// cycles. The win is MEANING: values that are bit-identical but nonsense to
// mix (an angle vs a timer byte, a velocity vs a pixel count) get distinct
// names, and the fixed<I,F> scales make cross-scale arithmetic refusable
// (D2.10) where values flow through typed surfaces.
//
// Pure types only: this module opens no section and emits ZERO bytes.
// -----------------------------------------------
module engine.types

// A 16.16 positional coordinate: hi word = whole pixels, lo word = the
// fraction (the codebase calls the lo word "the subpixel"). Space-NEUTRAL
// by design — the same format carries world coords and, under RF_COORDMODE,
// screen coords (test_particle), so the type names the format+role, not
// the space.
pub newtype Coord = fixed<16,16>

// An 8.8 signed velocity: $100 = 1 px/frame. Covers x_vel/y_vel AND the
// player's ground_speed (inertia) — the along-ground velocity is the same
// domain, not a separate one. Signed and directed, hence Velocity (a
// "Speed" would also blur against the ground_speed field name).
pub newtype Velocity = fixed<8,8>

// A byte angle: $00-$FF = one full turn (the 68k-native circle). Reused by
// terrain angles (SST) and rotation. sin/cos (GetSineCosine) take an Angle
// and return the BARE fixed<8,8> unit fraction sin·$100 — a scale factor,
// not a Velocity; it becomes one only when multiplied by a speed.
pub newtype Angle = u8

// The object dispatch word: an offset from ObjCodeBase (objroutine's
// value), stored at SST $00. Unlike every other u16 in the record — it is
// executable-address-shaped, never arithmetic data.
pub newtype ObjRoutine = u16

// A hitbox dimension in pixels — the FULL collision-box width/height (SST
// width_pixels/height_pixels), NOT a half-extent: aabb_axis_test sums both
// boxes' full dims and compares against TWICE the centre distance, so a
// half-extent here would halve every hitbox. Collision-box domain, distinct
// from world distances and screen coordinates. Named HitboxDim (not the earlier
// Radius) because the value is a full box dimension and "radius" read as a
// half-extent (Volence-approved rename).
pub newtype HitboxDim = u8

// The PACKED VRAM art word: priority<<15 | palette<<13 | tile index
// (vram_art's output shape). Named now so stores read honestly; the
// index/address conversion family (VramTile, vram_bytes ×32) arrives with
// the VRAM-layout port.
pub newtype VramArtTile = u16

// Animation identities, THREE distinct byte types (item-13 wave 1). They are
// bit-identical small indices that live in adjacent SST fields, so mixing them
// is the same silent-wrong-answer class as the grid-axis swap:
//   AnimId       — which script (an index into an anim table's offset ordinals).
//   AnimFrame    — the byte CURSOR within the running script (SST anim_frame);
//                  the read position an event/frame walk advances, NOT a frame
//                  identity.
//   MappingFrame — which sprite mapping frame (SST mapping_frame / prev_frame);
//                  the drawn-frame identity a DPLC/mapping lookup indexes.
// The script-cursor vs mapping-frame pair is the highest-risk swap; splitting
// them names the distinction at every typed surface. (These flow through SST
// MEMORY today, not register call slots, so the types carry MEANING; the slice
// enforces the moment such a value crosses a typed register param — see the
// field-store domain-check ledger row.)
pub newtype AnimId = u8
pub newtype AnimFrame = u8
pub newtype MappingFrame = u8

// Section-grid coordinates, AXIS-SPLIT (G5). A level is a grid of fixed-size
// sections; a cell is addressed by its column (GridX = sec_x) and row
// (GridY = sec_y). They are split into two newtypes precisely so the compiler
// REFUSES a sec_x/sec_y swap at a call boundary — the same silent-wrong-answer
// class as the MigrateMasks stride bug. Both erase to u8 (grids are small); the
// unsigned range guard in Section_GetSecPtrXY still catches out-of-grid at run
// time, so these carry naming, not a refinement.
pub newtype GridX = u8
pub newtype GridY = u8

// A flat section id: sec_y * grid_w + sec_x — the linear index into the Sec
// grid that Section_FlatIDXY computes and EntityScanState.ess_section_id holds.
// u16 because a large act's flat index exceeds a byte (MAX_ACT_SECTIONS ≤ 496,
// guarded where the ×66 stride sign-extends).
pub newtype SectionId = u16

// Sound identities, DISTINCT (item-13 wave 1). A song id (SongId — the SONG_*
// family, indexes SongTable) and a sound-effect id (SfxId — the SFX_* / SFXID_*
// family, indexes SfxTable) are both small bytes that flow to the 68k sound API,
// and mixing them plays the wrong sound. Split so the compiler REFUSES an SfxId
// in a SongId slot (or vice versa) at a sound-API call boundary. Both erase to
// u8; the driver-side Z80 blob is untouched — the types stop at the param-block
// boundary. APIs keep ACTION names (Sound_PlayMusic / Sound_PlaySFX); the types
// name the VALUE.
pub newtype SongId = u8
pub newtype SfxId = u8
