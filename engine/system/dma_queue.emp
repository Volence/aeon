// DMA queue — 3-priority sub-queue system with movep-interleaved format.
//
// Queue entries are 14-byte DMAEntry records (engine.structs twin): VDP reg
// numbers pre-filled at even offsets, value bytes movep-interleaved at odd
// offsets, so draining an entry is a straight register-port byte stream.

module engine.dma_queue in dma_queue

use engine.structs.{DMAEntry}
use engine.constants.{DMA_CRITICAL_SLOTS, DMA_TOTAL_SLOTS, VDP_CTRL, DMA_ENQ_BYTE_CAP}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm_reg}
use engine.irq.{vblank}

// Derived entry displacements (one-consumer usage detail — file-local per the
// engine.structs boundary rule). The ENTRY2_* forms address the SECOND entry
// of a 128KB split pair through the same base register.
const ENTRY_LEN      = sizeof(DMAEntry)
const ENTRY2_SIZEH   = ENTRY_LEN + offsetof(DMAEntry, SizeH)
const ENTRY2_SIZEL   = ENTRY_LEN + offsetof(DMAEntry, SizeL)
const ENTRY2_COMMAND = ENTRY_LEN + offsetof(DMAEntry, Command)

// -----------------------------------------------
// fill_slot_markers — Init's per-slot marker pre-fill, displacements DERIVED
// from the DMAEntry layout (slot c's Reg94 byte, then the Reg93/97/96/95
// marker family via one movep.l). Emits n slots' worth of stores.
// LOCKSTEP: dma_queue.asm spells this as a `rept DMA_TOTAL_SLOTS`/`set`
// unroll — the byte gates are the guard; a slot-count or layout change must
// move both sides (the gate names the first diverging byte if only one moves).
// -----------------------------------------------
comptime fn fill_slot_markers(n: int) -> Code {
    return 0..n |> fold(asm {}, |acc, c| acc ++ asm {
        move.b  d0, {c * sizeof(DMAEntry) + offsetof(DMAEntry, Reg94)}(a0)
        movep.l d1, {c * sizeof(DMAEntry) + offsetof(DMAEntry, Reg93)}(a0)
    })
}

// -----------------------------------------------
// Init_DMA_Queue — pre-fill all 32 slots with VDP register markers
// Called once at boot.
// In:  none
// Out: none
// Clobbers: d0-d1, a0
// -----------------------------------------------
pub proc Init_DMA_Queue () clobbers(d0-d1/a0) {
        lea     DMA_Queue, a0                   // (DMA_Queue).w
        moveq   #-$6C, d0                       // $94 sign-extended
        move.l  #$93979695, d1                  // reg markers $93/$97/$96/$95 — one movep.l lands all four at offsets 2/4/6/8
        fill_slot_markers(DMA_TOTAL_SLOTS)
        // Slot vars hold the next free entry's address; empty = queue base.
        // (dest widths pinned `.w`: a link-time #imm source with a bare
        // relaxable dest is the [lower.imm-link] gap — row 1046 item 2)
        move.w  #DMA_Critical, (DMA_Critical_Slot).w
        move.w  #DMA_Important, (DMA_Important_Slot).w
        move.w  #DMA_Deferrable, (DMA_Deferrable_Slot).w
        rts
}

// -----------------------------------------------
// QueueDMA_Critical / QueueDMA_Important / QueueDMA_Deferrable
// Entry points that select the target sub-queue, then tail into the shared
// QueueDMA_Deferrable.transfer core (Deferrable's own body runs straight
// into it — the shared core IS Deferrable's tail).
//
// In:  d1.l = source address (bytes, even)
//      d2.w = VRAM destination (byte address)
//      d3.w = transfer length (bytes, even, non-zero)
// Out: carry SET = request DROPPED (queue full); carry CLEAR = enqueued OK.
//      The carry is pinned AFTER the caller's SR is restored — the restore
//      would otherwise overwrite it and every carry-checking caller would
//      read garbage (see the andi/ori-to-ccr sites in the core).
//      A 128KB split needs TWO free slots: with only one, the whole transfer
//      is rejected (carry SET, byte charge rolled back — .split_reject).
//      Enqueueing just the first half with carry CLEAR would publish
//      half-landed data (page_in marks pages RESIDENT on carry-clear).
// Clobbers: d0-d4, a1-a2 — the exhaustive license; everything outside it is
//      contractually preserved. Callers rely on exactly this set (dplc's
//      Perform_DPLC* skip saving a3 across the call), so widening it means
//      re-checking every dead-save caller.
// SR: `preserves(sr.mask)` + `out(carry: dropped)` partition SR between them —
//      the signature itself says the interrupt mask round-trips (the core saves
//      SR once at .transfer and each of its three exits — .finish_entry, .full,
//      the split tail — restores it before returning) while CCR carries the
//      carry result, pinned AFTER the restore. What the contract cannot say:
//      WHY callers rely on the mask half — a caller that masked for its own
//      atomicity is not silently unmasked by enqueueing. (The mask the core
//      INSTALLS is a separate job — it keeps a VBlank from landing mid-write
//      and seeing a half-built queue entry.)
//      QueueDMA_Deferrable's body carries the save/restore the checker verifies;
//      the two sibling entry points reach the same core through an unconditional
//      tail transfer, and the mask claim is credited THROUGH that tail (both the
//      clobbers and the preserves analyses discharge the shared-core tail).
// -----------------------------------------------
pub proc QueueDMA_Critical (d1: u32, d2: u16, d3: u16) clobbers(d0-d4/a1-a2) out(carry: dropped) preserves(sr.mask) {
        lea     DMA_Critical_Slot, a2           // (DMA_Critical_Slot).w
        move.w  #DMA_Critical_End, d4
        jbra    QueueDMA_Deferrable.transfer
}

pub proc QueueDMA_Important (d1: u32, d2: u16, d3: u16) clobbers(d0-d4/a1-a2) out(carry: dropped) preserves(sr.mask) {
        lea     DMA_Important_Slot, a2          // (DMA_Important_Slot).w
        move.w  #DMA_Important_End, d4
        jbra    QueueDMA_Deferrable.transfer
}

pub proc QueueDMA_Deferrable (d1: u32, d2: u16, d3: u16) clobbers(d0-d4/a1-a2) out(carry: dropped) preserves(sr.mask) {
        lea     DMA_Deferrable_Slot, a2         // (DMA_Deferrable_Slot).w
        move.w  #DMA_Deferrable_End, d4

    // -----------------------------------------------
    // .transfer — the shared enqueue core (the three entry points above all
    // arrive here; Deferrable falls straight in).
    // In:  d1.l = source (bytes), d2.w = dest, d3.w = length (bytes)
    //      a2 = pointer to slot variable, d4.w = queue end address
    // Out/Clobbers: the entry points' contract above.
    // -----------------------------------------------
    export .transfer:
        move.w  sr, -(sp)
        move.w  #$2700, sr                      // disableInts (engine/macros.asm)
        movea.w (a2), a1
        cmpa.w  d4, a1
        beq     .full

        // Vectorman byte cap (P2c Task 8): charge this transfer's bytes against the
        // frame's running enqueue total. d3 is STILL the byte length here (converted to
        // words below). Compute-then-commit = an atomic charge for the WHOLE transfer,
        // so a 128KB split (one transfer, two entries) charges/rejects both halves
        // together. Over the cap -> reject exactly like a full queue (carry set; the
        // caller retries next frame). bcs catches a word-overflow add: the committed
        // total can never exceed the cap, so only a pathological single transfer
        // overflows the word — treat that as over cap too.
        move.w  DMA_Enq_Bytes_Frame, d0
        add.w   d3, d0
        bcs     .byte_capped
        cmpi.w  #DMA_ENQ_BYTE_CAP, d0
        bhi     .byte_capped
        move.w  d0, DMA_Enq_Bytes_Frame         // commit the byte charge (rolled back = never committed on reject)

        lsr.l   #1, d1                          // source to words
        bclr.l  #23, d1                         // defensive: word-address bit 23 = reg $17 bit 7 (DMD1) — force 0 = 68k-memory->VRAM (a real 24-bit pointer already has it clear)
        movep.l d1, DMAEntry.SizeL(a1)          // source -> offsets 3,5,7,9

        lsr.w   #1, d3                          // length to words

        // 128KB boundary check (sub+sub approach).
        // Detects if (source_words.w + length_words.w) > $10000,
        // i.e. the DMA crosses a 128KB byte boundary.
        moveq   #0, d0
        sub.w   d3, d0
        sub.w   d1, d0
        blo     .split                          // carry = crosses boundary

        // No crossing — write length and finish
        movep.w d3, DMAEntry.SizeH(a1)          // length -> offsets 1,3

    .finish_entry:
        moveq   #0, d0
        move.w  d2, d0
        vdp_comm_reg(d0, VdpTarget.Vram, VdpOp.Dma, false)
        move.l  d0, DMAEntry.Command(a1)

        lea     ENTRY_LEN(a1), a1
        move.w  a1, (a2)

        move.w  (sp)+, sr
        andi.b  #$FE, ccr                       // carry CLEAR = enqueued OK (pinned after the SR restore)
        rts

    .full:
        if DEBUG == 1 {
            addq.w  #1, DMA_Overflow_Count      // (DMA_Overflow_Count).w — debug-only profiling counter
        }
        move.w  (sp)+, sr
        ori.b   #1, ccr                         // carry SET = request dropped (queue full; pinned after the SR restore)
        rts

    .byte_capped:
        // Vectorman byte-half of the dual cap (P2c Task 8): the transfer's bytes would
        // push the frame's enqueue total over DMA_ENQ_BYTE_CAP. Nothing was committed
        // (the total is written only on the admit path above), so this is the "roll
        // back the size add" the plan asks for. Reject like a full queue.
        if DEBUG == 1 {
            addq.w  #1, Dbg_DMA_Enq_Capped      // (P2c Task 8) enqueues rejected by the byte cap; 0 in normal play
        }
        move.w  (sp)+, sr
        ori.b   #1, ccr                         // carry SET = request rejected (byte cap; pinned after the SR restore)
        rts

        // --- 128KB boundary split ---
        // Split the transfer into two queue entries: one up to the boundary,
        // one for the remainder. Both go to the same sub-queue.
    .split:
        add.w   d3, d0                          // d0 = words until 128KB boundary
        movep.w d0, DMAEntry.SizeH(a1)          // write first part length

        // Need two free slots — check room for second entry
        subi.w  #sizeof(DMAEntry), d4           // d4 = start of last slot
        cmpa.w  d4, a1
        bhs     .split_reject                   // only one slot — reject BOTH halves

        // Second part parameters
        sub.w   d0, d3                          // d3 = second part length (words)
        add.l   d0, d1                          // d1 = second part source (words)
        add.w   d0, d0                          // d0 = first part length (bytes)
        add.w   d2, d0                          // d0 = second part VRAM dest

        // Finish first entry with original destination
        vdp_comm_reg(d2, VdpTarget.Vram, VdpOp.Dma, true)   // d2 -> VDP command (clr=true: upper word unknown — the one masking site among the three)
        move.l  d2, DMAEntry.Command(a1)

        // Write second entry into next slot
        movep.l d1, ENTRY2_SIZEL(a1)
        movep.w d3, ENTRY2_SIZEH(a1)

        // Second entry VDP command — d0 upper word known zero
        vdp_comm_reg(d0, VdpTarget.Vram, VdpOp.Dma, false)
        lea     ENTRY2_COMMAND(a1), a1
        move.l  d0, (a1)+
        move.w  a1, (a2)

        move.w  (sp)+, sr
        andi.b  #$FE, ccr                       // carry CLEAR = both split entries enqueued OK
        rts

    .split_reject:
        // ONE free slot cannot hold a boundary-crossing transfer. Enqueueing just
        // the first half with carry CLEAR published half-landed data — carry-clear
        // means "the WHOLE transfer is queued" (page_in marks a page RESIDENT on
        // it; the tail of the frame kept the evicted page's art, silently). The
        // slot's partial field writes are harmless without the cursor advance.
        // Roll back the committed byte charge and reject like a full queue; every
        // caller's carry path retries next frame.
        add.w   d3, d3                          // length words -> bytes (whole transfer)
        sub.w   d3, DMA_Enq_Bytes_Frame         // roll back the byte-cap charge
        if DEBUG == 1 {
            addq.w  #1, DMA_Overflow_Count
        }
        move.w  (sp)+, sr
        ori.b   #1, ccr                         // carry SET = request dropped (split needs 2 slots)
        rts
}

// -----------------------------------------------
// Process_DMA_Critical jump-table pieces.
// The table dispatches on the queue's BYTE offset (entry count ×
// sizeof(DMAEntry)), so every slot must be exactly sizeof(DMAEntry) = 14
// bytes wide; the drain run unrolls one 8-byte send group per entry, and
// slot c branches to the group that drains exactly c entries.
// LOCKSTEP: dma_queue.asm spells the table as `rept`/`set` unrolls with
// arithmetic slot targets (`bra.w .drain_end-.c*8`) — this side names the
// drain entry points instead; the byte gates prove the two spellings
// identical.
// -----------------------------------------------

// One jump-table slot: point a5/a1 at the port and queue, then branch to the
// drain group for this slot's entry count.
comptime fn jt_slot(drain: Label) -> Code {
    return asm {
        lea     VDP_CTRL, a5                    // (VDP_CTRL).l
        lea     DMA_Critical, a1                // (DMA_Critical).w
        bra.w   {drain}                         // STRUCTURAL bra.w: stride-locked jump-table slot — lea.l(6) + lea.w(4) + bra.w(4) = sizeof(DMAEntry); a relaxed branch would break the offset indexing
    }
}

// Slot 0's trap-filler pad: slot 0 is `bra.w .done` (4 bytes); the rest of
// its sizeof(DMAEntry)-wide slot is unreachable trap #0 filler.
comptime fn jt_filler() -> Code {
    return 0..(sizeof(DMAEntry) - 4) / 2 |> fold(asm {}, |acc, _i| acc ++ asm { trap #0 })
}

// One drain send group: stream one 14-byte entry to the VDP control port.
comptime fn dma_send_entry() -> Code {
    return asm {
        move.l  (a1)+, (a5)
        move.l  (a1)+, (a5)
        move.l  (a1)+, (a5)
        move.w  (a1)+, (a5)
    }
}

// The slot list and drain run below are hand-spelled 8-wide; pin the count so
// a queue-geometry change fails loud here instead of drifting past the table.
ensure(DMA_CRITICAL_SLOTS == 8, "Process_DMA_Critical's jump table is spelled for 8 slots — re-derive .jump_table/.drain_* AND the .slot_0..8 landing labels + the jmp's targets(...) list for {DMA_CRITICAL_SLOTS}")
// jt_slot emits a PHYSICALLY FIXED 14-byte slot (lea.l 6 + lea.w 4 + bra.w 4)
// while the dispatch index scales with sizeof(DMAEntry) — pin the equality so
// an entry-layout change cannot silently desync the jmp indexing from the
// slot stride (the count ensure above is blind to this).
ensure(sizeof(DMAEntry) == 14, "the jump-table slot stride is spelled as 14 fixed bytes — a DMAEntry layout change must re-derive jt_slot/jt_filler/dma_send_entry")

// -----------------------------------------------
// Process_DMA_Critical — drain Critical queue via jump table
// Zero branches per entry. 72 cycles/entry (3x move.l 20 + move.w 12),
// 576 for all 8 drain groups; ~670 whole-proc worst case with dispatch,
// slot-var reset, and rts (68000 table timing — VDP FIFO waits can only
// add to this, never subtract).
//   @budget(cycles: 670) is the MACHINE-CHECKED ceiling, and the three numbers
//   MEET: prose ~670 / B′-3b table 670 / walk 670. The `targets(...)` clause
//   names the PHYSICAL landing labels (.slot_0..8), so the walk charges each
//   slot's dispatch body before following into its drain. The dearest is slot 8:
//   movea.w 16 + suba.w 12 + jmp 10 + lea VDP_CTRL 12 + lea DMA_Critical 12 +
//   drain_8's 576 + slot reset 16 + rts 16 = 670. A downstream-label enumeration
//   would skip the two slot-8 leas; naming the physical landing labels keeps them
//   charged. (Every relaxable operand is charged its abs.l ceiling; the linker's
//   abs.w widths for the RAM slot vars make the true worst 662 — @budget holds
//   either way.)
// In:  none
// Out: none
// Clobbers: a1, a5
// Precondition: the VDP control-port first/second-word flip-flop is CLEAR on
// entry — a stranded unpaired command word upstream would eat the first
// register write and desync the whole stream (every VInt writer issues
// paired words; single-word register writes like $8F02 cannot strand it).
// -----------------------------------------------
@budget(cycles: 670)
pub proc Process_DMA_Critical () clobbers(a1/a5) requires(vblank) {
        movea.w DMA_Critical_Slot, a1           // (DMA_Critical_Slot).w
        suba.w  #DMA_Critical, a1               // a1 = byte offset into queue
        jmp     .jump_table(a1) targets(.slot_0, .slot_1, .slot_2, .slot_3, .slot_4, .slot_5, .slot_6, .slot_7, .slot_8)

    // The `targets(...)` set names the PHYSICAL landing points — each `.slot_k`
    // sits at exactly .jump_table + k*sizeof(DMAEntry), the byte the computed jmp
    // actually reaches — so the cycle walk charges each slot's own dispatch body
    // (the lea/lea/bra.w, or slot 8's lea/lea fall-in) BEFORE it follows into the
    // drain. Labels emit zero bytes; the ensure-pinned stride and this label set
    // say the same thing.
    .jump_table:
    .slot_0:
        bra.w   .done                           // STRUCTURAL bra.w: slot 0 (queue empty) — the 4-byte head of the sizeof(DMAEntry)-wide slot
        jt_filler()
    .slot_1:
        jt_slot(.drain_1)                       // 1 entry queued
    .slot_2:
        jt_slot(.drain_2)
    .slot_3:
        jt_slot(.drain_3)
    .slot_4:
        jt_slot(.drain_4)
    .slot_5:
        jt_slot(.drain_5)
    .slot_6:
        jt_slot(.drain_6)
    .slot_7:
        jt_slot(.drain_7)
    .slot_8:
        lea     VDP_CTRL, a5                    // slot 8 (queue full) falls through into the full drain
        lea     DMA_Critical, a1
    .drain_8:
        dma_send_entry()
    .drain_7:
        dma_send_entry()
    .drain_6:
        dma_send_entry()
    .drain_5:
        dma_send_entry()
    .drain_4:
        dma_send_entry()
    .drain_3:
        dma_send_entry()
    .drain_2:
        dma_send_entry()
    .drain_1:
        dma_send_entry()
        move.w  #DMA_Critical, (DMA_Critical_Slot).w    // width pinned: [lower.imm-link], row 1046 item 2
    .done:
        rts
}

// -----------------------------------------------
// Process_DMA_Important — drain Important queue with byte budget
// In:  none (reads DMA_Budget_Remaining)
// Out: none
// Clobbers: d0-d1, a0-a3, a5
// -----------------------------------------------
pub proc Process_DMA_Important () clobbers(d0-d1/a0-a3/a5) requires(vblank) {
        movea.w DMA_Important_Slot, a1          // (DMA_Important_Slot).w
        lea     DMA_Important, a0               // (DMA_Important).w
        cmpa.l  a0, a1
        bls     .done
        lea     DMA_Important_Slot, a2
        jbra    Drain_Budgeted_Queue            // tail call — updates slot var
    .done:
        rts
}

// -----------------------------------------------
// Process_DMA_Deferrable — drain Deferrable queue with byte budget
// In:  none (reads DMA_Budget_Remaining)
// Out: none
// Clobbers: d0-d1, a0-a3, a5
// -----------------------------------------------
pub proc Process_DMA_Deferrable () clobbers(d0-d1/a0-a3/a5) requires(vblank) {
        movea.w DMA_Deferrable_Slot, a1         // (DMA_Deferrable_Slot).w
        lea     DMA_Deferrable, a0              // (DMA_Deferrable).w
        cmpa.l  a0, a1
        bls     .done
        lea     DMA_Deferrable_Slot, a2
        jbra    Drain_Budgeted_Queue            // tail call — updates slot var
    .done:
        rts
}

// -----------------------------------------------
// Drain_Budgeted_Queue — shared loop for Important/Deferrable
// Entries that don't fit this frame's budget are COMPACTED to the
// queue base and persist to the next frame (consumers like
// Perform_DPLC queue once and rely on eventual delivery —
// discarding meant stale art).
// In:  a0 = queue start, a1 = slot pointer value (first free)
//      a2 = slot variable address
//      DMA_Budget_Remaining must be set
// Out: slot variable updated (base if fully drained,
//      base + survivors after compaction, unchanged if nothing drained)
// Clobbers: d0-d1, a0-a1, a3, a5
// Precondition: the VDP control-port flip-flop is CLEAR on entry (see
// Process_DMA_Critical's header — same stream-desync class).
// -----------------------------------------------
proc Drain_Budgeted_Queue (a0: *u8, a1: *u8, a2: *u8) clobbers(d0-d1/a0-a1/a3/a5) {
        lea     VDP_CTRL, a5                    // (VDP_CTRL).l
        movea.l a0, a3                          // a3 = queue base
    .loop:
        movep.w DMAEntry.SizeH(a0), d1          // read this entry's size in words
        add.w   d1, d1                          // words -> bytes
        move.w  DMA_Budget_Remaining, d0        // (DMA_Budget_Remaining).w
        sub.w   d1, d0                          // budget AFTER sending this whole entry
        bmi     .out_of_budget                  // entry does not fit — leave it (+ the rest) queued for next frame's fresh budget; no overshoot
        move.w  d0, DMA_Budget_Remaining        // commit: budget stays >= 0 (the drain never overshoots the window)
        move.l  (a0)+, (a5)
        move.l  (a0)+, (a5)
        move.l  (a0)+, (a5)
        move.w  (a0)+, (a5)
        cmpa.l  a0, a1
        bhi     .loop
        move.w  a3, (a2)                        // fully drained — slot = base
        rts

    .out_of_budget:
        cmpa.l  a0, a3
        beq     .no_drain                       // nothing sent — slot already correct
    .compact:
        move.l  (a0)+, (a3)+                    // src always above dst — safe forward copy
        move.l  (a0)+, (a3)+
        move.l  (a0)+, (a3)+
        move.w  (a0)+, (a3)+
        cmpa.l  a0, a1
        bhi     .compact
        move.w  a3, (a2)                        // slot = base + surviving entries
    .no_drain:
        rts
}
