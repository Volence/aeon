// Boot sequence — TMSS, VDP init, Z80 init, memory clearing
// (§ references = docs/ENGINE_ARCHITECTURE.md)
//
// The BootData table (movem preloads, VDP register bytes, DMA fill command,
// Z80 blob, PSG bytes, post-DMA commands) is engine/system/boot_data.emp — the
// code walks it with ONE sequential (a5)+ cursor. The .emp reaches the table
// head via `lea BootData(pc)` across the region seam; Z80_SOUND_SIZE /
// Z80_IDLE_SIZE are boot_data.emp's link-exported `equ`s.
module engine.boot in boot

use engine.constants.{VDP_DATA, VDP_CTRL, PSG_PORT, SYSTEM_STACK}
use engine.vdp.{VDP_MODE2_OFF, vdp_reg, bytes_to_lcnt}
use engine.z80_bus.{z80_stopped}

// The hardware ports below (HW_*, TMSS_REGISTER, YM2612_A0) are bare
// link-resolved addresses (truth: engine.constants) — EA-position only, all in
// the $A1xxxx / $A0xxxx range that forces abs.l regardless of comptime
// knownness. VDP_DATA / VDP_CTRL / PSG_PORT come from the shared engine.constants
// module because the PSG displacement below needs them at COMPTIME.

// PSG_DATA_OFF is the directional derive the PSG displacement slot consumes off
// the VDP_DATA base in a3 (the engine.vdp consumer-side derive pattern).
const PSG_DATA_OFF = PSG_PORT - VDP_DATA

// -----------------------------------------------
// EntryPoint — first instruction after reset
// Never returns (falls through Warm/Cold boot into the GameLoop tail), so the
// contract is the honest ⊤ bound: the body destroys every register, sp
// included (it reloads sp from SYSTEM_STACK below).
// RESET-ENTRY ONLY in practice (the reset vector is the sole referencer):
// everything up to the interrupt unmask relies on the 68000 reset forcing
// SR=$2700 — a software `jmp EntryPoint` with interrupts live would race the
// RAM clear (VInt_Ptr zeroed) against a pending VInt. The sp reload below does
// NOT make a software re-entry safe on its own; it only removes the second
// failure mode (see the comment on the lea).
// -----------------------------------------------
@noreturn
pub proc EntryPoint () clobbers(d0-d7/a0-a6/sr) {
        // Reload the stack pointer (S2/S3K both do this). On a hardware reset
        // the 68000 has already loaded sp from vector $000, so this is
        // redundant — but a software `jmp EntryPoint` soft-reset does NOT, and
        // without this the 64KB RAM clear below runs on whatever sp the game
        // was using and then `jbsr VDP_Shadow_Init` pushes a return address
        // into just-cleared (or worse, live) RAM and returns through garbage.
        // One instruction closes that; the interrupt-state caveat above still
        // stands separately.
        // Explicit `.w`: $FFFFFF00 sign-extends from $FF00, so abs.w is the
        // 4-byte encoding and the relaxer would pick it anyway — but only when
        // SYSTEM_STACK arrives comptime-known. The standalone boot port gate
        // feeds it as a link equ, where a relaxable form could choose abs.l and
        // silently diverge by two bytes. Pinning the width makes both paths
        // agree by construction (the row-1046 kept-width class).
        lea     (SYSTEM_STACK).w, sp

        tst.l   HW_PORT_A_CTRL_FULL
        bne     .warm_boot
        tst.w   HW_EXPANSION_CTRL_FULL
        beq     .cold_boot

    // -----------------------------------------------
    // Warm boot — soft reset path
    // -----------------------------------------------
    .warm_boot:
        // Wait for any in-progress DMA. (Safe pre-handshake on TMSS
        // hardware: the TMSS boot ROM has already unlocked the VDP on every
        // reset path before the cartridge runs.)
    .wait_dma:
        move.w  VDP_CTRL, d0
        btst    #1, d0                      // VDP status bit 1 = DMA busy
        bne     .wait_dma

        // Fall through to cold boot.

    // -----------------------------------------------
    // Cold boot — full hardware initialization.
    // NAME ONLY: this runs on EVERY boot. The warm path above falls straight
    // through, so everything below (RAM clear included) executes on a soft
    // reset exactly as it does on power-on. Nothing is preserved across a
    // reset — see docs/ENGINE_ARCHITECTURE.md §0.11.
    // -----------------------------------------------
    .cold_boot:
        // TMSS handshake (§0.2)
        move.b  HW_VERSION, d0
        andi.b  #$F, d0                     // low nibble = hardware version (0 = pre-TMSS)
        beq     .no_tmss
        move.l  #$53454741, TMSS_REGISTER       // "SEGA"
    .no_tmss:

        // Reset VDP command word state machine
        move.w  VDP_CTRL, d0

        // Preload hardware addresses via movem — the table head assigns:
        // d5=$8000 (VDP reg cmd base) d6=RAM-clear dbf count d7=$0100 (reg
        // stride / Z80 bus value); a0=Z80_RAM a1=Z80_BUS_REQUEST a2=Z80_RESET
        // a3=VDP_DATA a4=VDP_CTRL (boot_data.emp owns the values).
        lea     BootData(pc), a5
        movem.w (a5)+, d5-d7
        movem.l (a5)+, a0-a4

        // VDP register init — 24 registers from table (§0.3)
        moveq   #23, d1
    .vdp_loop:
        move.b  (a5)+, d5
        move.w  d5, (a4)
        add.w   d7, d5                  // d7 = $0100 → next register
        dbf     d1, .vdp_loop

        // Start VRAM DMA fill (§0.7) — runs in background on VDP clock
        move.w  #vdp_reg($0F, $01), (a4)    // auto-increment = 1 for byte-by-byte DMA fill
        move.l  (a5)+, (a4)                 // vdpComm(0, VRAM, DMA)
        moveq   #0, d0
        move.w  d0, (a3)                    // trigger fill (fill byte = 0)

        // --- PARALLEL WORK WHILE DMA FILLS VRAM ---
        // Window invariant: until .wait_fill, nothing may touch the VDP DATA
        // port ($C00000) — a data write mid-fill both lands in VRAM and
        // REPLACES the fill byte. NOTHING below does: the Z80 reset/bus dance,
        // the blob copy and the 64KB RAM clear are all off-VDP. The PSG port
        // ($C00011) is VDP-DECODED and used to be the one exception here; the
        // 4 PSG-silence writes now live BELOW .wait_fill (2026-08-04, review
        // item 27 finding 2 — the PSG sits inside the VDP, a plutiedev-
        // documented hazard). Their old placement was safe only TEMPORALLY
        // (the RAM clear, ~360k cycles ≈ 47ms, strictly dominates the
        // display-off fill's ~21ms), never topologically — a future shrink of
        // the clear would have re-opened a real-hardware race with no gate to
        // catch it. Keep VDP-decoded accesses OUT of this window.

        // Z80 init (§0.5)
        move.w  d0, (a2)                    // assert Z80 reset
        move.w  d7, (a1)                    // request Z80 bus
        move.w  d7, (a2)                    // release Z80 reset

    .wait_z80:
        btst    d0, (a1)                    // wait for bus grant (d0 = 0 → test bit 0)
        bne     .wait_z80

        // Copy Z80 program to Z80 RAM (a5 already points at the included blob).
        // d1 is a BYTE count minus 1 and the loop below is byte-wide — the Z80
        // program is a byte stream, not words. "Optimizing" this to move.w and
        // halving the count would copy half the driver.
        if SOUND_DRIVER_ENABLED == 1 {
            move.w  #Z80_SOUND_SIZE-1, d1   // bytes-1 (move.w, not moveq: the blob exceeds moveq's signed-8 immediate)
        } else {
            moveq   #Z80_IDLE_SIZE-1, d1    // bytes-1
        }
    .load_z80:
        move.b  (a5)+, (a0)+
        dbf     d1, .load_z80

        // Z80 reset with YM2612-safe delay
        move.w  d0, (a2)                    // assert reset
        moveq   #25, d2
    .ym_delay:
        dbf     d2, .ym_delay               // ~264 cycles (YM2612 needs >= 192)
        move.w  d7, (a2)                    // release reset — Z80 starts idle loop
        move.w  d0, (a1)                    // release bus — Z80 has control

        // Clear Work RAM — ALL 64KB, on warm boots as well as cold (§0.7).
        // There is deliberately no preserved region, and this is now a RULING
        // (Volence, 2026-08-05), not an unfinished feature: soft-reset
        // persistence is OUT, and SRAM (arch §9.6) is this engine's persistence
        // mechanism — it survives power-off, not just a RESET press. A soft
        // reset is a full restart. Do not re-propose a CrossResetRAM-style
        // carve-out here; the design was deleted from the arch doc precisely
        // because standing text kept generating false review findings against
        // this loop (reviewers "discovering" it wipes a region that never
        // existed). See arch §0.11 / §9.5.
        movea.l d0, a6                      // a6 = 0
        move.w  d6, d2                      // d2 = $3FFF dbf count → $4000 longs = 64KB
    .clear_ram:
        move.l  d0, -(a6)                   // wraps: $00000000 → $FFFFFFFC → ... → $FFFF0000
        dbf     d2, .clear_ram

        // --- WAIT FOR DMA FILL TO COMPLETE ---
    .wait_fill:
        move.w  (a4), d2
        btst    #1, d2
        bne     .wait_fill

        // PSG silence (§0.6) — 4 bytes from data table. Deliberately AFTER
        // .wait_fill: the PSG is decoded inside the VDP, so a write here while
        // the VRAM fill is still in flight is a real-hardware hazard. The
        // (a5)+ table cursor is NOT disturbed by the move — .wait_fill touches
        // only a4 (read) and d2, and the 4 PSG bytes still sit between the Z80
        // blob and boot_tail's auto-increment word in the same sequential
        // order. Do not move these back above .wait_fill.
        moveq   #3, d2
    .silence_psg:
        move.b  (a5)+, PSG_DATA_OFF(a3)     // PSG_PORT-VDP_DATA off the data-port base
        dbf     d2, .silence_psg
        // code address is even here — the table walk needs no alignment pad.

        // Restore auto-increment to 2
        move.w  (a5)+, (a4)                 // vdpReg($0F, $02)

        // Clear CRAM — 128 bytes (§0.7)
        move.l  (a5)+, (a4)                 // vdpComm(0, CRAM, WRITE)
        moveq   #bytes_to_lcnt($80), d2
    .clear_cram:
        move.l  d0, (a3)
        dbf     d2, .clear_cram

        // Clear VSRAM — 80 bytes (§0.7)
        move.l  (a5)+, (a4)                 // vdpComm(0, VSRAM, WRITE)
        moveq   #bytes_to_lcnt($50), d2
    .clear_vsram:
        move.l  d0, (a3)
        dbf     d2, .clear_vsram

        // YM2612 key-off — silence all 6 FM channels (§0.6). CHOSEN
        // compromise: these writes are NOT busy-paced (~3.5us apart vs the
        // chip's ~25us busy window), so on real silicon most are swallowed —
        // boot silence is actually guaranteed by the >=192-cycle /IC reset
        // pulse above; this block is belt-and-braces. If it ever becomes
        // load-bearing, poll $A04000 bit 7 between data writes.
        // There is a SECOND, sharper defect here that this comment used to
        // miss: in a sound build the Z80 driver has been running since the bus
        // release above, and the bus request can halt it BETWEEN its own YM
        // address and data writes — the 68k then latches $28 and the Z80's data
        // write lands on the Key On/Off register. Both defects, the two
        // candidate fixes, and the owner ruling that this block stays
        // BYTE-FOR-BYTE UNCHANGED (no real hardware to verify timing against; a
        // wrong fix is worse because it would look addressed) are written up in
        // docs/specs/boot-ym-keyoff-race.md. Read it before touching this block
        // OR the /IC reset pulse above — shortening that pulse is what would
        // make these six writes load-bearing.
        with z80_stopped {
            lea     YM2612_A0, a6
            move.b  #$28, (a6)                  // select Key On/Off register
            moveq   #2, d2
        .keyoff_part1:
            move.b  d2, 1(a6)                   // key off channels 0-2
            dbf     d2, .keyoff_part1
            moveq   #6, d2
            moveq   #2, d1
        .keyoff_part2:
            move.b  d2, 1(a6)                   // key off channels 4-6 ($04,$05,$06)
            subq.w  #1, d2
            dbf     d1, .keyoff_part2
        }

        // Clear d0-a6 from just-cleared RAM (sp keeps the reset-vector stack)
        movem.l (RAM_Start).w, d0-a6        // explicit .w: movem's abs seam is pinned-width (relaxable movem form ledgered)

        // Disable all interrupts
        move.w  #$2700, sr

        // Init VDP shadow table (§0.4)
        jbsr    VDP_Shadow_Init

        // Init DMA queue (§1.1)
        jbsr    Init_DMA_Queue

        // Init sprite table link chain (§1.3)
        jbsr    Init_SpriteTable

        // Build static DMA entries (§1.5)
        jbsr    BuildStaticDMA

        // Set initial VBlank handler (§1.2)
        move.l  #VInt_Level, (VInt_Ptr).w   // explicit .w: link-imm source + relaxable dest can't share an instruction (core.emp kept-width class)

        // Region detection (§0.8) — NTSC-only product ruling (2026-08-02, B):
        // the region-adaptive DMA budget IS consumed (the drain reads it); the
        // PAL fixed-timestep machinery (Timing_Step/Frame_Accumulator) had zero
        // readers and was deleted rather than left as dead scaffolding.
        move.b  HW_VERSION, d0
        move.b  d0, Hardware_Region
        andi.b  #$C0, d0                    // keep bits 7:6 (domestic/export, NTSC/PAL)
        move.b  d0, Region_Flags
        btst    #6, d0                      // bit 6 = PAL
        bne     .pal
        // Explicit `.w` dest kept: a link-imm source and a relaxable dest can't
        // share an instruction (core.emp kept-width class, gap-ledger row 1046).
        move.w  #DMA_BUDGET_NTSC, (DMA_Budget_Default).w
        jbra    .region_done
    .pal:
        move.w  #DMA_BUDGET_PAL, (DMA_Budget_Default).w
    .region_done:

        // Controller port init (§0.9)
        move.b  #$40, HW_PORT_1_CTRL        // TH as output
        move.b  #$40, HW_PORT_2_CTRL
        move.b  #$40, HW_EXPANSION_CTRL
        move.b  #$40, HW_PORT_1_DATA        // TH high (initial state)
        move.b  #$40, HW_PORT_2_DATA
        move.b  #$40, HW_PORT_EXP_DATA

        // Init HBlank vector slot to idle (§0.10). Written BEFORE interrupts
        // unmask — RAM-clear leaves $0000, not a legal instruction; the slot
        // must decode to a real rte before IRQ4 can fire. The long write fills
        // the first two slot words with rte ($4E73) — offset 0 is the one that
        // executes; the second rte is defensive. move.l (vs move.w) keeps this
        // init 8 bytes, so boot stays byte-neutral and the trampoline re-pin is
        // confined to the hblank region and below.
        move.l  #$4E734E73, HBlank_Vector_Slot

        // Enable VBlank interrupt (set VDP reg $01 bit 5) — write-through the
        // VDP shadow, which is the register's authority.
        move.b  #$34, VDP_Shadow_Table + VDP_MODE2_OFF      // $14 | $20 (VInt enable) = $34

        // Flush shadow to hardware — VInt must be enabled in VDP before unmasking
        jbsr    Flush_VDP_Shadow

        // Enable interrupts
        move.w  #$2300, sr

        if DEBUG == 1 {
            // Golden compression self-test — decompressors vs build encoders.
            // Runs before any game state touches Art_Staging_Buffer.
            jbsr    CompressionSelfTest
        }

        if SOUND_DRIVER_ENABLED == 1 {
            // Sound mailbox idle handshake. Z80 already has the bus and the
            // driver is running; registers are free here (post-boot setup).
            jbsr    Sound_Init
        }
        // The game's boot hook (Game.boot_hook). Bound game-side only in the
        // sound test-harness shape; `= empty` in every canonical build, where it
        // emits nothing. When bound it lowers to an absolute jsr (engine→game,
        // placement-independent).
        invoke  Game.boot_hook

        // Set initial game state — the game supplies the entry contract via its
        // manifest (Game.entry = the first game-state routine, Game.ENTRY_ID = its
        // game-state id). Both stores keep explicit `.w` dests (the row-1046
        // kept-width class — link-imm source + relaxable dest).
        move.l  #Game.entry, (Game_State).w
        move.b  #Game.ENTRY_ID, (Game_State_ID).w
        clr.b   Game_State_Init

        // Enter main loop — never returns
        jbra    GameLoop
}
