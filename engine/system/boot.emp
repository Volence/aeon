// Boot sequence — TMSS, VDP init, Z80 init, memory clearing
//
// The BootData table (movem preloads, VDP register bytes, DMA fill command,
// Z80 blob, PSG bytes, post-DMA commands) stays AS-side in
// engine/system/boot_data.asm — the code walks it with ONE sequential (a5)+
// cursor, and the table's geometry is locked by the assert wall there. The
// .emp reaches the table head via `lea BootData(pc)` across the region seam.
module engine.boot in boot

use engine.vdp.{VDP_DATA, VDP_CTRL, VDP_MODE2_OFF}
use engine.z80_bus.{stop_z80, start_z80}

// The hardware ports below (HW_*, TMSS_REGISTER, YM2612_A0) are bare
// link-resolved addresses (truth: engine/constants.asm) — EA-position only,
// so nothing here needs a comptime mirror (the z80_bus Z80_BUS_REQUEST
// class). VDP_DATA/VDP_CTRL come from the shared engine.vdp twin because the
// PSG displacement below needs them at COMPTIME.

// PSG data port (truth: engine/constants.asm) — needed at COMPTIME for the
// PSG displacement off the VDP_DATA base in a3. Module-local until a second
// .emp consumer earns it a shared-twin slot. PSG_DATA_OFF is the directional
// derive the displacement slot consumes (the engine.vdp consumer-side
// derive pattern) — the twin spells the same subtraction inline.
const PSG_PORT = $C00011
const PSG_DATA_OFF = PSG_PORT - VDP_DATA
ensure(extern("PSG_PORT") == PSG_PORT, "engine/constants.asm and boot.emp disagree on PSG_PORT — update the mirror")

// vdpReg (engine/macros.asm): VDP register-set command word — $8000 base,
// register number in the high byte, value in the low byte. The refinements
// close the macro's silent bit-collisions (vram_art precedent): reg > $17
// would name a register the VDP doesn't have, val > $FF would bleed into the
// register-number byte.
comptime fn vdp_reg(reg: int where 0..$17, val: int where 0..$FF) -> int {
    return $8000 | (reg << 8) | val
}

// bytesToLcnt (engine/macros.asm): byte count -> dbf longword-loop count.
// Bounded to the real clear-loop domain; a non-multiple-of-4 count would
// silently floor (the AS function shares that edge — documentary).
comptime fn bytes_to_lcnt(n: int where 4..$10000) -> int {
    return n / 4 - 1
}

// -----------------------------------------------
// EntryPoint — first instruction after reset
// Never returns (falls through Warm/Cold boot into the GameLoop tail), so the
// contract is the honest ⊤ bound: the body destroys every register.
// -----------------------------------------------
pub proc EntryPoint () clobbers(d0-d7/a0-a6/sr) {
        tst.l   HW_PORT_A_CTRL_FULL
        bne     .warm_boot
        tst.w   HW_EXPANSION_CTRL_FULL
        beq     .cold_boot

    // -----------------------------------------------
    // Warm boot — soft reset path
    // -----------------------------------------------
    .warm_boot:
        // Wait for any in-progress DMA
    .wait_dma:
        move.w  VDP_CTRL, d0
        btst    #1, d0                      // VDP status bit 1 = DMA busy
        bne     .wait_dma

        // Fall through to cold boot.

    // -----------------------------------------------
    // Cold boot — full hardware initialization
    // -----------------------------------------------
    .cold_boot:
        // TMSS handshake (§0.2)
        move.b  HW_VERSION, d0
        andi.b  #$F, d0                     // low nibble = hardware version (0 = pre-TMSS)
        beq     .no_tmss
        move.l  #$53454741, TMSS_REGISTER       // "SEGA"
    .no_tmss:

        // Reset VDP command word state machine
        move.w  VDP_CTRL, d0

        // Preload hardware addresses via movem — the table head assigns:
        // d5=$8000 (VDP reg cmd base) d6=RAM-clear dbf count d7=$0100 (reg
        // stride / Z80 bus value); a0=Z80_RAM a1=Z80_BUS_REQUEST a2=Z80_RESET
        // a3=VDP_DATA a4=VDP_CTRL (boot_data.asm owns the values).
        lea     BootData(pc), a5
        movem.w (a5)+, d5-d7
        movem.l (a5)+, a0-a4

        // VDP register init — 24 registers from table (§0.3)
        moveq   #23, d1
    .vdp_loop:
        move.b  (a5)+, d5
        move.w  d5, (a4)
        add.w   d7, d5                  // d7 = $0100 → next register
        dbf     d1, .vdp_loop

        // Start VRAM DMA fill (§0.7) — runs in background on VDP clock
        move.w  #vdp_reg($0F, $01), (a4)    // auto-increment = 1 for byte-by-byte DMA fill
        move.l  (a5)+, (a4)                 // vdpComm(0, VRAM, DMA)
        moveq   #0, d0
        move.w  d0, (a3)                    // trigger fill (fill byte = 0)

        // --- PARALLEL WORK WHILE DMA FILLS VRAM ---

        // Z80 init (§0.5)
        move.w  d0, (a2)                    // assert Z80 reset
        move.w  d7, (a1)                    // request Z80 bus
        move.w  d7, (a2)                    // release Z80 reset

    .wait_z80:
        btst    d0, (a1)                    // wait for bus grant (d0 = 0 → test bit 0)
        bne     .wait_z80

        // Copy Z80 program to Z80 RAM (a5 already points at the included blob)
        if SOUND_DRIVER_ENABLED == 1 {
            move.w  #Z80_SOUND_SIZE-1, d1   // byte count — the blob size exceeds moveq's signed-8 immediate
        } else {
            moveq   #Z80_IDLE_SIZE-1, d1
        }
    .load_z80:
        move.b  (a5)+, (a0)+
        dbf     d1, .load_z80

        // Z80 reset with YM2612-safe delay
        move.w  d0, (a2)                    // assert reset
        moveq   #25, d2
    .ym_delay:
        dbf     d2, .ym_delay               // ~264 cycles (YM2612 needs >= 192)
        move.w  d7, (a2)                    // release reset — Z80 starts idle loop
        move.w  d0, (a1)                    // release bus — Z80 has control

        // Clear Work RAM — 64KB (§0.7)
        movea.l d0, a6                      // a6 = 0
        move.w  d6, d2                      // d2 = $3FFF dbf count → $4000 longs = 64KB
    .clear_ram:
        move.l  d0, -(a6)                   // wraps: $00000000 → $FFFFFFFC → ... → $FFFF0000
        dbf     d2, .clear_ram

        // PSG silence (§0.6) — 4 bytes from data table
        moveq   #3, d2
    .silence_psg:
        move.b  (a5)+, PSG_DATA_OFF(a3)     // PSG_PORT-VDP_DATA off the data-port base
        dbf     d2, .silence_psg
        // (the twin carries an `align 2` here — code is even, it emits nothing)

        // --- WAIT FOR DMA FILL TO COMPLETE ---
    .wait_fill:
        move.w  (a4), d2
        btst    #1, d2
        bne     .wait_fill

        // Restore auto-increment to 2
        move.w  (a5)+, (a4)                 // vdpReg($0F, $02)

        // Clear CRAM — 128 bytes (§0.7)
        move.l  (a5)+, (a4)                 // vdpComm(0, CRAM, WRITE)
        moveq   #bytes_to_lcnt($80), d2
    .clear_cram:
        move.l  d0, (a3)
        dbf     d2, .clear_cram

        // Clear VSRAM — 80 bytes (§0.7)
        move.l  (a5)+, (a4)                 // vdpComm(0, VSRAM, WRITE)
        moveq   #bytes_to_lcnt($50), d2
    .clear_vsram:
        move.l  d0, (a3)
        dbf     d2, .clear_vsram

        // YM2612 key-off — silence all 6 FM channels (§0.6)
        stop_z80()
        lea     YM2612_A0, a6
        move.b  #$28, (a6)                  // select Key On/Off register
        moveq   #2, d2
    .keyoff_part1:
        move.b  d2, 1(a6)                   // key off channels 0-2
        dbf     d2, .keyoff_part1
        moveq   #6, d2
        moveq   #2, d1
    .keyoff_part2:
        move.b  d2, 1(a6)                   // key off channels 4-6 ($04,$05,$06)
        subq.w  #1, d2
        dbf     d1, .keyoff_part2
        start_z80()

        // Clear all 68K registers
        movem.l (RAM_Start).w, d0-a6        // explicit .w: movem's abs seam is pinned-width (relaxable movem form ledgered)

        // Disable all interrupts
        move.w  #$2700, sr

        // Init VDP shadow table (§0.4)
        jbsr    VDP_Shadow_Init

        // Init DMA queue (§1.1)
        jbsr    Init_DMA_Queue

        // Init sprite table link chain (§1.3)
        jbsr    Init_SpriteTable

        // Build static DMA entries (§1.5)
        jbsr    BuildStaticDMA

        // Set initial VBlank handler (§1.2)
        move.l  #VInt_Level, (VInt_Ptr).w   // explicit .w: link-imm source + relaxable dest can't share an instruction (core.emp kept-width class)

        // Region detection (§0.8)
        move.b  HW_VERSION, d0
        move.b  d0, Hardware_Region
        andi.b  #$C0, d0                    // keep bits 7:6 (domestic/export, NTSC/PAL)
        move.b  d0, Region_Flags
        btst    #6, d0                      // bit 6 = PAL
        bne     .pal
        move.w  #NTSC_TIMING_STEP, (Timing_Step).w          // explicit .w x4: link-imm source +
        move.w  #DMA_BUDGET_NTSC, (DMA_Budget_Default).w    // relaxable dest can't share an
        jbra    .region_done
    .pal:
        move.w  #PAL_TIMING_STEP, (Timing_Step).w           // instruction (core.emp kept-width
        move.w  #DMA_BUDGET_PAL, (DMA_Budget_Default).w     // class, row 1046)
    .region_done:
        move.w  #0, Frame_Accumulator

        // Controller port init (§0.9)
        move.b  #$40, HW_PORT_1_CTRL        // TH as output
        move.b  #$40, HW_PORT_2_CTRL
        move.b  #$40, HW_EXPANSION_CTRL
        move.b  #$40, HW_PORT_1_DATA        // TH high (initial state)
        move.b  #$40, HW_PORT_2_DATA
        move.b  #$40, HW_PORT_EXP_DATA

        // Init HBlank vector slot to idle (§0.10). Written BEFORE interrupts
        // unmask — RAM-clear leaves $0000, not a legal instruction; the slot
        // must decode to a real rte before IRQ4 can fire. The long write fills
        // the first two slot words with rte ($4E73) — offset 0 is the one that
        // executes; the second rte is defensive. move.l (vs move.w) keeps this
        // init 8 bytes, so boot stays byte-neutral and the trampoline re-pin is
        // confined to the hblank region and below.
        move.l  #$4E734E73, HBlank_Vector_Slot

        // Enable VBlank interrupt (set VDP reg $01 bit 5) — write-through the
        // VDP shadow + dirty mask (the setVDPReg macro's expansion).
        move.b  #$34, VDP_Shadow_Table + VDP_MODE2_OFF      // $14 | $20 (VInt enable) = $34
        ori.l   #(1 << VDP_MODE2_OFF), VDP_Dirty_Mask

        // Flush shadow to hardware — VInt must be enabled in VDP before unmasking
        jbsr    Flush_VDP_Shadow

        // Enable interrupts
        move.w  #$2300, sr

        if DEBUG == 1 {
            // Golden compression self-test — decompressors vs build encoders.
            // Runs before any game state touches Art_Staging_Buffer.
            jbsr    CompressionSelfTest
        }

        if SOUND_DRIVER_ENABLED == 1 {
            // Sound mailbox idle handshake. Z80 already has the bus and the
            // driver is running; registers are free here (post-boot setup).
            jbsr    Sound_Init
        }
        // sonic4's gameBootHook expansion, mirrored — the game-contract boot
        // hook (games/sonic4/config/game.asm; kill-list row: this file must
        // follow that macro body). Empty in normal builds.
        if SOUND_DEBUG_HOTKEYS == 1 && SOUND_DRIVER_ENABLED == 1 {
            // bsr.w / (X).w spellings are structural: this block byte-follows
            // the gameBootHook macro body (kill row 45).
            moveq   #$3C, d0                // ping with a recognizable value
            bsr.w   Sound_Ping
            moveq   #SONG_MOVINGTRUCKS, d0  // autoplay the test song
            bsr.w   Sound_PlayMusic
            move.b  #1, (Dbg_Music_On).w    // track play state for the Start-toggle
        }

        // Set initial game state — the game supplies the entry contract:
        //   Game_Entry    = the first game-state routine
        //   GAME_ENTRY_ID = its game-state id
        move.l  #Game_Entry, (Game_State).w // explicit .w x2: link-imm source + relaxable dest
        move.b  #GAME_ENTRY_ID, (Game_State_ID).w   // can't share an instruction (core.emp kept-width class)
        clr.b   Game_State_Init

        // Enter main loop — never returns
        jbra    GameLoop
}
