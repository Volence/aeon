// HBlank dispatch — RAM-patched handler (§0.10)
//
// The whole module lives in the `hblank` section, pinned by the sigil map
// at the per-shape reference address.
module engine.hblank in hblank

// Contract type (contract-grammar v2 §4) — the HBlank handler bound. The
// dispatch saves/restores ONLY d0-d1/a0 around the `jsr (a0)`, so an installed
// raster handler may clobber ONLY those (interrupt context — everything else
// must survive for the interrupted main line).
type HBlankHandler = proc () clobbers(d0, d1, a0)

// -----------------------------------------------
// HBlank_Dispatch — ROM stub, dispatches through the RAM pointer
// (HBlank_Handler_Ptr): RAM-indirect dispatch for per-line raster effects.
// Clobbers nothing — the movem pair is the declared contract (S2-D6b).
//
// HANDLER CONTRACT: the dispatch saves/restores ONLY d0-d1/a0 around
// the `jsr (a0)`, so the installed HBlank handler may clobber ONLY d0-d1/a0.
// Every other register (d2-d7/a1-a6) MUST survive — this runs mid-frame in
// interrupt context, and the interrupted main-line code expects them intact.
// -----------------------------------------------
pub proc HBlank_Dispatch () preserves(d0-d1/a0) {
        movem.l d0-d1/a0, -(sp)
        movea.l HBlank_Handler_Ptr, a0
        jsr     (a0) as HBlankHandler
        movem.l (sp)+, d0-d1/a0
        rte
}

// -----------------------------------------------
// HBlank_Null — default handler (no raster effects)
// -----------------------------------------------
pub proc HBlank_Null () clobbers() {
        rts
}
