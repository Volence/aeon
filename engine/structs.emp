// Shared ROM level-descriptor struct twins — Act (the 34-byte act descriptor)
// and Sec (the 66-byte section descriptor). Both are TYPE-ONLY twins: this
// module emits ZERO bytes. It gives every consumer (act_descriptor.emp,
// section.emp, tile_cache.emp, entity_window.emp) ONE typed home for Sec/Act
// field access — `Sec.sec_bg_layout(a0)`, `offsetof(Act, grid_w)` — instead of
// per-file offset-const mirrors.
//
// engine/structs.asm's `Act`/`Sec` structs stay authoritative for the layout
// until structs.asm itself ports (Spec 5, the twin-scaffolding kill). Two
// locks hold this side to that side: the auto-computed field offsets are
// pinned by the per-field `offsetof(S, f) == extern("S_f")` drift wall below
// (strictly stronger than a sizeof-only guard — it catches a swapped
// same-size adjacent pair), and the total sizes by the `sizeof == *_len`
// guards. Field names are VERBATIM from structs.asm (the `sec_`/`act_`
// stutter included) for cross-seam greppability; renames are a Spec-5
// decision.
module engine.structs

// -----------------------------------------------
// Act Descriptor (§4) — 34 bytes ($22), ROM table
// -----------------------------------------------
pub struct Act {
    sec_grid_ptr:        *u8,           // $00 — section definition array
    grid_w:              u16,           // $04 — sections wide
    grid_h:              u16,           // $06 — sections tall
    start_local_x:       u16,           // $08 — player start X within section
    start_local_y:       u16,           // $0A — player start Y within section
    start_sec_x:         u8,            // $0C — starting section X index
    start_sec_y:         u8,            // $0D — starting section Y index
    act_bg_layout:       *u8,           // $0E — zone-wide Plane B layout (T1 default)
    act_bg_tiles:        *u8,           // $12 — zone-wide Plane B tile blob
    act_parallax_config: *u8,           // $16 — default parallax config
    act_art_pool_table:  *u8,           // $1A — page-address table (generated)
    act_art_pool_pages:  u16,           // $1E — pool page count (generated)
    edge_mode:           u8,            // $20 — vertical edge behavior (EDGE_*)
    pad_21:              u8 = 0,        // $21 — reserved word pad (anonymous in structs.asm)
}

// -----------------------------------------------
// Section Definition (§4) — 66 bytes ($42), ROM table
// All fields: 0 = keep current / no change
// -----------------------------------------------
pub struct Sec {
    sec_block_index:     *u8,           // $00 — 256-entry block index table
    sec_objects:         *u8,           // $04 — objentry list (dc.w -1 terminated)
    sec_rings:           *u8,           // $08 — X-sorted ring entries
    sec_plc:             *u8 = 0,       // $0C — S4LZ art PLC list
    sec_pal:             *u8,           // $10 — 128-byte palette
    sec_parallax_config: *u8 = 0,       // $14 — 0 = inherit the act default
    sec_raster_table:    *u8 = 0,       // $18 — raster command table
    sec_bg_layout:       *u8 = 0,       // $1C — NULL = use Act_act_bg_layout
    sec_type_table:      *u8,           // $20 — dc.b count,pad; dc.l ObjDef×N
    sec_pal_cycle:       *u8 = 0,       // $24 — palette cycling script
    sec_sound_bank:      *u8 = 0,       // $28 — DAC sample bank
    sec_block_dict:      *u8,           // $2C — raw dict region (LZ pre-seed)
    sec_anim_blocks:     *u8 = 0,       // $30 — animated tile script
    sec_collision_s4lz:  *u8 = 0,       // $34 — reserved
    sec_flags:           u16 = 0,       // $38 — SF_* bitmask
    sec_music:           u16 = 0,       // $3A — music track (0 = keep current)
    sec_pcfg_pad_3C:     u8 = 0,        // $3C — reserved
    sec_camera_lookahead: u8 = 0,       // $3D — lookahead px (0 = zone default)
    sec_pcfg_pad_3E:     u8 = 0,        // $3E — reserved
    sec_pcfg_pad_3F:     u8 = 0,        // $3F — reserved
    sec_block_dict_len:  u16,           // $40 — dict bytes (768×K, K≤3)
}

// ---- total-size guards (structs.asm's `if *_len <> $XX` checks) ----
ensure(sizeof(Act) == extern("Act_len"), "Act twin drifted from structs.asm: {sizeof(Act)}")
ensure(sizeof(Sec) == extern("Sec_len"), "Sec twin drifted from structs.asm: {sizeof(Sec)}")

// ---- per-field drift wall (strictly stronger than sizeof) — every named
// field's offset pinned to its structs.asm-generated `<Struct>_<field>` equ.
// Act's $21 pad is ANONYMOUS in structs.asm (no equ), covered by sizeof(Act). ----
ensure(offsetof(Act, sec_grid_ptr)        == extern("Act_sec_grid_ptr"),        "Act.sec_grid_ptr drifted: {offsetof(Act, sec_grid_ptr)}")
ensure(offsetof(Act, grid_w)              == extern("Act_grid_w"),              "Act.grid_w drifted: {offsetof(Act, grid_w)}")
ensure(offsetof(Act, grid_h)              == extern("Act_grid_h"),              "Act.grid_h drifted: {offsetof(Act, grid_h)}")
ensure(offsetof(Act, start_local_x)       == extern("Act_start_local_x"),       "Act.start_local_x drifted: {offsetof(Act, start_local_x)}")
ensure(offsetof(Act, start_local_y)       == extern("Act_start_local_y"),       "Act.start_local_y drifted: {offsetof(Act, start_local_y)}")
ensure(offsetof(Act, start_sec_x)         == extern("Act_start_sec_x"),         "Act.start_sec_x drifted: {offsetof(Act, start_sec_x)}")
ensure(offsetof(Act, start_sec_y)         == extern("Act_start_sec_y"),         "Act.start_sec_y drifted: {offsetof(Act, start_sec_y)}")
ensure(offsetof(Act, act_bg_layout)       == extern("Act_act_bg_layout"),       "Act.act_bg_layout drifted: {offsetof(Act, act_bg_layout)}")
ensure(offsetof(Act, act_bg_tiles)        == extern("Act_act_bg_tiles"),        "Act.act_bg_tiles drifted: {offsetof(Act, act_bg_tiles)}")
ensure(offsetof(Act, act_parallax_config) == extern("Act_act_parallax_config"), "Act.act_parallax_config drifted: {offsetof(Act, act_parallax_config)}")
ensure(offsetof(Act, act_art_pool_table)  == extern("Act_act_art_pool_table"),  "Act.act_art_pool_table drifted: {offsetof(Act, act_art_pool_table)}")
ensure(offsetof(Act, act_art_pool_pages)  == extern("Act_act_art_pool_pages"),  "Act.act_art_pool_pages drifted: {offsetof(Act, act_art_pool_pages)}")
ensure(offsetof(Act, edge_mode)           == extern("Act_edge_mode"),           "Act.edge_mode drifted: {offsetof(Act, edge_mode)}")

ensure(offsetof(Sec, sec_block_index)     == extern("Sec_sec_block_index"),     "Sec.sec_block_index drifted: {offsetof(Sec, sec_block_index)}")
ensure(offsetof(Sec, sec_objects)         == extern("Sec_sec_objects"),         "Sec.sec_objects drifted: {offsetof(Sec, sec_objects)}")
ensure(offsetof(Sec, sec_rings)           == extern("Sec_sec_rings"),           "Sec.sec_rings drifted: {offsetof(Sec, sec_rings)}")
ensure(offsetof(Sec, sec_plc)             == extern("Sec_sec_plc"),             "Sec.sec_plc drifted: {offsetof(Sec, sec_plc)}")
ensure(offsetof(Sec, sec_pal)             == extern("Sec_sec_pal"),             "Sec.sec_pal drifted: {offsetof(Sec, sec_pal)}")
ensure(offsetof(Sec, sec_parallax_config) == extern("Sec_sec_parallax_config"), "Sec.sec_parallax_config drifted: {offsetof(Sec, sec_parallax_config)}")
ensure(offsetof(Sec, sec_raster_table)    == extern("Sec_sec_raster_table"),    "Sec.sec_raster_table drifted: {offsetof(Sec, sec_raster_table)}")
ensure(offsetof(Sec, sec_bg_layout)       == extern("Sec_sec_bg_layout"),       "Sec.sec_bg_layout drifted: {offsetof(Sec, sec_bg_layout)}")
ensure(offsetof(Sec, sec_type_table)      == extern("Sec_sec_type_table"),      "Sec.sec_type_table drifted: {offsetof(Sec, sec_type_table)}")
ensure(offsetof(Sec, sec_pal_cycle)       == extern("Sec_sec_pal_cycle"),       "Sec.sec_pal_cycle drifted: {offsetof(Sec, sec_pal_cycle)}")
ensure(offsetof(Sec, sec_sound_bank)      == extern("Sec_sec_sound_bank"),      "Sec.sec_sound_bank drifted: {offsetof(Sec, sec_sound_bank)}")
ensure(offsetof(Sec, sec_block_dict)      == extern("Sec_sec_block_dict"),      "Sec.sec_block_dict drifted: {offsetof(Sec, sec_block_dict)}")
ensure(offsetof(Sec, sec_anim_blocks)     == extern("Sec_sec_anim_blocks"),     "Sec.sec_anim_blocks drifted: {offsetof(Sec, sec_anim_blocks)}")
ensure(offsetof(Sec, sec_collision_s4lz)  == extern("Sec_sec_collision_s4lz"),  "Sec.sec_collision_s4lz drifted: {offsetof(Sec, sec_collision_s4lz)}")
ensure(offsetof(Sec, sec_flags)           == extern("Sec_sec_flags"),           "Sec.sec_flags drifted: {offsetof(Sec, sec_flags)}")
ensure(offsetof(Sec, sec_music)           == extern("Sec_sec_music"),           "Sec.sec_music drifted: {offsetof(Sec, sec_music)}")
ensure(offsetof(Sec, sec_pcfg_pad_3C)     == extern("Sec_sec_pcfg_pad_3C"),     "Sec.sec_pcfg_pad_3C drifted: {offsetof(Sec, sec_pcfg_pad_3C)}")
ensure(offsetof(Sec, sec_camera_lookahead) == extern("Sec_sec_camera_lookahead"), "Sec.sec_camera_lookahead drifted: {offsetof(Sec, sec_camera_lookahead)}")
ensure(offsetof(Sec, sec_pcfg_pad_3E)     == extern("Sec_sec_pcfg_pad_3E"),     "Sec.sec_pcfg_pad_3E drifted: {offsetof(Sec, sec_pcfg_pad_3E)}")
ensure(offsetof(Sec, sec_pcfg_pad_3F)     == extern("Sec_sec_pcfg_pad_3F"),     "Sec.sec_pcfg_pad_3F drifted: {offsetof(Sec, sec_pcfg_pad_3F)}")
ensure(offsetof(Sec, sec_block_dict_len)  == extern("Sec_sec_block_dict_len"),  "Sec.sec_block_dict_len drifted: {offsetof(Sec, sec_block_dict_len)}")
