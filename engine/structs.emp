// Shared engine struct definitions — Act (the act descriptor), Region (the act's
// identity rectangles), Sec (the section descriptor), DMAEntry (the DMA-queue entry),
// parallax_config (the parallax ROM config header), and VdpShadow (the RAM mirror of
// VDP registers $00-$12).
//
// THE SIZES USED TO BE SPELLED OUT ON THIS LINE AND ONE OF THEM HAD DECAYED 94% HIGH:
// Sec was described as "the 66-byte section descriptor" while `sizeof(Sec)` is 34, and
// the same stale 66 had been copied into tools/preset_lab_witness.py. No wrong stride ever
// executed — every reader spells `sizeof(Sec)` — but the number a person reads was wrong
// for longer than the number a machine reads could have been. So the sizes are not
// restated here at all: `sizeof()` is the answer, and the four that a consumer's code
// depends on are already pinned where that dependence lives —
//   sizeof(Sec) == 26      engine/level/section.emp, engine/level/tile_cache.emp
//   sizeof(DMAEntry) == 14 engine/system/buffers.emp, engine/system/dma_queue.emp
// each with a message naming what re-derives if it moves. Those pins are the mechanism;
// a size in this banner was only ever a claim.
// All are TYPE-ONLY: this module emits ZERO bytes. It gives every consumer
// (act_descriptor.emp, section.emp, tile_cache.emp, entity_window.emp,
// dma_queue.emp) ONE typed home for field access —
// `Sec.sec_bg_layout(a0)`, `DMAEntry.SizeH(a1)`, `offsetof(Act, grid_w)` —
// instead of per-file offset-const mirrors.
//
// This module is the SOLE AUTHOR of these layouts. The residual AS reads the
// field offsets + total sizes it needs (the residual root's `ds` slot sizes, and the
// `Sec`/`Act` access in games/sonic4/data/levels/ojz/act1/act_descriptor.emp) through
// the struct-offset harvest:
// the build harvests each struct's `<Struct>_<field>` / `<Struct>_len` and
// injects them as guarded AS defines, the struct-offset sibling of the constants
// flip. Field names are VERBATIM the AS spelling (the `sec_`/`act_` stutter
// included) for cross-seam greppability.
//
// BOUNDARY: this module carries LAYOUT and layout-adjacent struct knowledge
// (offsets, sizes, blessed sub-field views like the grid-dim low bytes) — NOT
// consumer-specific usage detail. A derived view read by multiple consumers
// belongs here with the layout; a one-consumer computed offset stays file-local.
module engine.structs

// -----------------------------------------------
// Act Descriptor (§4) — 46 bytes ($2E), ROM table (sizeof is the truth; no _len const)
// -----------------------------------------------
pub struct Act {
    sec_grid_ptr:        *u8,           // $00 — section definition array
    grid_w:              u16,           // $04 — sections wide
    grid_h:              u16,           // $06 — sections tall
    start_local_x:       u16,           // $08 — player start X within section
    start_local_y:       u16,           // $0A — player start Y within section
    start_sec_x:         u8,            // $0C — starting section X index
    start_sec_y:         u8,            // $0D — starting section Y index
    act_bg_layout:       *u8,           // $0E — zone-wide Plane B layout (T1 default)
    act_bg_tiles:        *u8,           // $12 — zone-wide Plane B tile blob
    act_parallax_config: *u8,           // $16 — default parallax config
    act_art_pool_table:  *u8,           // $1A — manifest v2 table: [PageManifest; act_art_pool_pages] (generated)
    act_art_pool_pages:  u16,           // $1E — pool page count (generated)
    edge_mode:           u8,            // $20 — vertical edge behavior (EDGE_*)
    pad_21:              u8 = 0,        // $21 — reserved byte pad (was anonymous in the deleted engine/structs.asm, c745d75e)
    act_sec_local_maps:  *u8,           // $22 — [*u8; grid_w*grid_h] per-section local->global tables (P2b, generated)
    act_art_budget:      u16,           // $26 — per-act steady-state art-streaming byte budget (B&R
                                        //       pattern, P2c Task 9): PageIn_Process's once-per-physical-
                                        //       frame Frame_Counter tick reloads
                                        //       Art_Budget_Remaining from it; page_in charges
                                        //       each landing's DMA bytes and defers when exhausted.
                                        //       Steady-state governor (init bulk-load runs <=1 page/frame,
                                        //       under the budget, so it never throttles the display-off load).
    // Painted-regions v1: the act's identity scope. APPENDED so no existing offset moves.
    act_regions:         *u8,           // $28 — [Region; act_region_count], the act's region table
    act_region_count:    u16,           // $2C — REQUIRED, no default. Region_Resolve's dbf counts
                                        //       it down from count-1, so 0 would scan 65,536 rows:
                                        //       the act constructor ensures it is >= 1.
}

// -----------------------------------------------
// Region (painted-regions v1; extended by regions part 2 step 1) — 22 bytes, ROM table:
// [Region; Act.act_region_count] at Act.act_regions.
//
// A world-pixel RECTANGLE that names an identity record. The identity record is the
// EffectsPreset the engine already has; the rectangle replaces the section grid as the
// SCOPE at which that record is bound. Storage (tiles, blocks, collision, objects,
// rings, type tables) stays per section and is not touched. Design:
// docs/superpowers/designs/2026-09-09-regions-v1-design.md.
//
// FOUR DECISIONS, each for a reason:
//   * SPAN-MAJOR per axis (x0, x1, y0, y1), not corner-major: the crossing caches the
//     live rectangle in RAM, and span-major makes that cache two move.l, not four move.w.
//   * INCLUSIVE on both ends: the point test is four unsigned compares with no
//     adjustment, and an inclusive x1 for an act that fills its axis is at most $7FFF,
//     below the word where a signed compare would change meaning.
//   * rg_effects has NO `= 0` default, and the omission is the guard: Effects_InstallPreset
//     dereferences it untested, so an omitted binding is a compile error in every shape.
//   * NOTHING ELSE: no music/sound-bank/PLC/lookahead/flags. Those were Sec fields deleted
//     on 2026-09-04 for having no reader; a field is added the day a consumer wants it.
//
// REGIONS PART 2, STEP 1 (2026-09-15) — THE BACKGROUND PLACEMENT JOINS THE RECORD.
// Spec: empyrean docs/superpowers/specs/2026-09-14-regions-part-2-design.md §4.1. Two
// fields, APPENDED, so no offset above moves and Parallax_CheckBoundary's two `move.l`
// cache fills (engine/level/parallax.emp, the span-major rectangle) are untouched:
//
//   * rg_bg_layout — the nametable blob this region shows. 0 = the act default
//     (Act.act_bg_layout). It inherited that convention from Sec.sec_bg_layout, which it has
//     since REPLACED (step 3 deleted the field), and it is why act 1's ten rows compile with
//     no change to their bindings.
//   * rg_bg_span — the background map's HEIGHT in px, i.e. the modulus the derived BG
//     scroll is clamped against once the row streamer exists. 0 = PLANE_B_SPAN, the
//     plane's own height, which is what every region gets today.
//
// STEP 3 GAVE rg_bg_layout ITS FIRST READER (2026-09-16): Section_RedrawPlanes resolves the
// region under the camera CENTRE and blits that row's layout, which is what deleting
// Sec.sec_bg_layout paid for. rg_bg_span still has none — the clamp that reads it is step 4 —
// and that is the step boundary, not an oversight. The per-row ensures that make an author's span legal live at the
// CALL SITE, in each act's own `ojz_region()`-style constructor, not here — a comptime
// fn's ensures evaluate where it is called, which is what makes them live.
//
// TWO FIELDS AND NOT FIVE. The study's "move the anchor triple into the region" is already
// true through one indirection: v_center_y / v_offset / v_factor_bg live in parallax_config
// and rg_parallax names a config. A region that differs only in where the SAME picture is
// anchored is a second parallax_config, not a new field.
//
// Two rows naming the same rg_effects ARE the same region for every purpose the engine
// has, because nothing downstream reads a region id: an L-shape is two rows.
//
// THE TRAILING `// $HH` COMMENTS ARE A GATE, NOT DECORATION, exactly as Sec's below:
// tools/region_table.py cross-checks every one against the field types.
// -----------------------------------------------
pub struct Region (size: 22) {
    rg_x0:               u16,           // $00 — inclusive left edge, world px
    rg_x1:               u16,           // $02 — inclusive right edge
    rg_y0:               u16,           // $04 — inclusive top edge
    rg_y1:               u16,           // $06 — inclusive bottom edge
    rg_effects:          *u8,           // $08 — EffectsPreset*; REQUIRED (see above)
    rg_parallax:         *u8 = 0,       // $0C — outranks the preset's ep_parallax; 0 = defer
                                        //       (Effects_ResolveParallax rung 1)
    rg_bg_layout:        *u8 = 0,       // $10 — nametable blob; 0 = Act.act_bg_layout.
                                        //       READ by engine/level/section.emp's
                                        //       Section_RedrawPlanes and by Draw_BG_TileRow
                                        //       (engine/level/plane_buffer.emp).
    rg_bg_span:          u16 = 0,       // $14 — BG map height in px (the scroll modulus);
                                        //       0 = PLANE_B_SPAN. No reader yet (the clamp
                                        //       is step 4).
}
// A `(size: N)` DECLARATION IS NOT CHECKED BY ANY PASS THAT WALKS DECLARED STRUCTS — it is
// verified only inside `layout_of_struct`, i.e. only when something in the build FORCES this
// struct's layout. Measured by the sigil lane over seventeen shapes with a positive control
// beside each: a struct declared in the entry module and never referenced builds CLEAN with
// its size off by 87, exit 0, no diagnostic; importing it by name and never using it is
// silent too. For `Region` at aeon `c283b95b`, `sizeof(Region)` is spelled in exactly three
// places — engine/level/parallax.emp's `lea sizeof(Region)(a0), a0` and two
// `mul_const.w d0, #sizeof(Region)` sites in games/sonic4/test/ojz_scroll_test.emp — and in
// the SHIPPING closure that leaves the one `lea` as the entire reason the declaration is
// enforced at all. Respell that stride as a constant in some future tidy-up and the
// declaration goes silent with nothing anywhere going red.
//
// THIS `ensure` IS THE ZERO-COST REMEDY and it does not depend on anything else forcing the
// layout, because spelling `sizeof(Region)` here IS that force. Proven red by mutation (a
// field widened u16 -> u32 with the declaration moved to match, so the declaration check
// PASSED and this line was the only thing left to fail); it costs zero ROM bytes, measured
// as a byte-identical debug ROM across adding it.
//
// The same class is LIVE in this tree at engine/objects/children.emp's
// `pub struct SpawnDesc (size: 4)`, which builds clean mutated to `(size: 41)` under both
// games. Booked in docs/DEFERRED_WORK.md rather than fixed here — different file, different
// parcel's subject.
ensure(sizeof(Region) == 22,
       "engine/structs.emp: sizeof(Region) is {sizeof(Region)}, and the record is 22 bytes. The `(size: ...)` declaration above is NOT self-checking: sigil verifies it only inside layout_of_struct, i.e. only when something in the build forces this struct's layout, and in the shipping closure that is ONE site (engine/level/parallax.emp's `lea sizeof(Region)(a0), a0` in Region_Resolve). This `ensure` is what makes the size a build-time fact independent of that site. If you meant to change the record, change the declaration and this line together, and re-read Parallax_CheckBoundary's two span-major `move.l` cache fills — they read x0:x1 and y0:y1 as pairs and assume the first four fields' order")

// -----------------------------------------------
// Page manifest entry (Art-streaming P2b, manifest v2) — 8 bytes.
// Act.act_art_pool_table points at [PageManifest; act_art_pool_pages].
// PageIn_Process strides this table by sizeof(PageManifest) and dispatches on
// pm_form (ART_PAGE_FORM_*); pm_flags carries ART_PAGE_FLAG_PINNED (residency).
// -----------------------------------------------
pub struct PageManifest {
    pm_source:           *u8,           // $00 — page blob ptr (ZX0 wrapper, or raw payload)
    pm_tiles:            u16,           // $04 — decompressed tile count (landing DMA length = *32)
    pm_form:             u8,            // $06 — ART_PAGE_FORM_ZX0 / ART_PAGE_FORM_RAW
    pm_flags:            u8,            // $07 — ART_PAGE_FLAG_PINNED bit0
}

// Low-byte views of the word grid dims — safe: grid_w, grid_h ≤
// MAX_ACT_SECTIONS (48) < 256, guarded by the act constructor.
// (`.field + N` does not compose in disp arithmetic — row 1068.) A blessed
// sub-field view read by all three consumers (section/tile_cache/entity_window)
// is layout-adjacent struct knowledge, so it lives WITH the layout — not
// consumer-specific detail (rule-1 amendment).
pub const Act_grid_w_lo = offsetof(Act, grid_w) + 1
pub const Act_grid_h_lo = offsetof(Act, grid_h) + 1

// -----------------------------------------------
// Page-in request (§9.7) — 4 bytes, one FIFO slot (engine.page_in).
// The dispatcher's request queue holds these; page_id indexes the act's
// page-address table, pr_flags carries the PGRQ_DEMAND priority bit.
// -----------------------------------------------
pub struct PageInReq {
    pr_page_id:          u16,           // $00 — pool page index (into act_art_pool_table)
    pr_flags:            u8,            // $02 — PGRQ_DEMAND bit0 (demand vs prefetch)
    pr_pad:              u8 = 0,        // $03 — reserved
}

// -----------------------------------------------
// Page frame (§5) — one 64-tile VRAM art slot in the residency cache
// (engine.page_cache). Page_Frames[i] describes frame i; frame*64 is its base
// tile index in the FG art window. pf_next threads the FREE list (the only
// list left); eviction order is the pf_stamp age (F-1 stamp eviction)
// AND the free list (a frame is in at most one list); PAGE_NOT_RESIDENT($FF)
// terminates a link. 8 bytes — sizeof is compiler truth (no manual _len).
// -----------------------------------------------
pub struct PageFrame {
    pf_page:             u16,           // $00 — resident page id, or $FFFF when free/unassigned
    pf_refcount:         u16,           // $02 — cache nametable words referencing this frame
    pf_stamp:            u16,           // $04 — Frame_Counter when the frame became evictable (F-1
                                        //       stamp eviction: victim = max unsigned age among
                                        //       PF_EVICTABLE frames; wrap at 65536 frames merely
                                        //       mis-ages a candidate, never breaks safety)
    pf_next:             u8,            // $06 — FREE-list forward link only (frame idx / $FF);
                                        //       eviction order is the stamp, not a list
    pf_flags:            u8,            // $07 — PF_PINNED / PF_EVICTABLE bits
}

// -----------------------------------------------
// Section Definition (§4) — 22 bytes ($16), ROM table — STORAGE ONLY (painted-regions v1)
//
// 26 -> 22 ON 2026-09-16 (regions part 2, step 3; spec §4.1/§4.5): sec_bg_layout DELETED. The
// background is the REGION's now — Region.rg_bg_layout, same 0-means-the-act-default convention
// — because the scope a background belongs to is the same painted rectangle an EffectsPreset and
// a parallax config belong to, not a grid cell. It had exactly ONE reader when it went
// (engine/level/section.emp's Section_RedrawPlanes; the second, Draw_BG_TileColumn, was deleted
// unused in step 2), and all nine of act 1's rows passed `default`, so no shipped picture moved.
// 4 B x 9 sections = 36 ROM bytes. What is left is pure storage: blocks, objects, rings, the type
// table and the dict — every remaining field is a pointer to bytes this section owns.
//
// 34 -> 26 ON 2026-09-13 (painted-regions v1, step 4): sec_parallax_config and sec_effects, the
// section's IDENTITY binding, moved to the Region record above — a rectangle is the scope an
// EffectsPreset is bound at now, not a grid cell. 8 B x 9 sections = 72 ROM bytes.
//
// 66 -> 34 ON 2026-09-04 (painted-regions audit row 3). Nine fields and the three
// reserved pads were deleted: sec_plc, sec_pal, sec_raster_table, sec_pal_cycle,
// sec_sound_bank, sec_anim_blocks, sec_flags, sec_music, sec_camera_lookahead,
// sec_pcfg_pad_3C/_3E/_3F. This was not a discretionary cleanup — it is the second
// half of a work order written into games/sonic4/.../act_descriptor.emp ("deleting
// them is Task 13's job, once reachability of the preset path is established"),
// whose precondition Task 13 (e6b016e5, effects-P3-C2) discharged in the same commit
// that was to perform it and then did not perform. Re-verified field by field at
// 2026-09-04: a grep of engine/ games/ for all twelve names returned this definition,
// act_descriptor.emp's writes, and PROSE ONLY — zero code readers. The three that were
// still fed live values (sec_pal / sec_raster_table / sec_pal_cycle) were fed by
// constructor arguments that had themselves been inert since Task 13 deleted their
// readers (Palette_LoadSection, Palette_InstallCycleSection, Raster_InstallSection);
// every channel they used to name arrives through the preset (Region.rg_effects since v1).
// 32 B x 9 sections = 288 ROM bytes.
//
// THE TRAILING `// $HH` COMMENTS ARE KEPT EXACT. Until painted-regions v1 tools/
// parallax_crossing_gate.py parsed them against the field TYPES; since then no tool reads
// Sec at all (Region's comments are the gated ones). Renumber when you edit anyway.
//
// Surviving fields whose value may be 0: 0 = "defer / none", never "keep current".
// The pre-Task-13 "0 = keep whatever the previous section had" semantic is gone with
// the fields that carried it.
// -----------------------------------------------
pub struct Sec {
    sec_block_index:     *u8,           // $00 — 256-entry block index table
    sec_objects:         *u8,           // $04 — objentry list (dc.w -1 terminated)
    sec_rings:           *u8,           // $08 — X-sorted ring entries
    sec_type_table:      *u8,           // $0C — dc.b count,pad; dc.l ObjDef×N
    sec_block_dict:      *u8,           // $10 — raw dict region (LZ pre-seed)
    sec_block_dict_len:  u16,           // $14 — dict bytes (768×K, K≤3)
}
// The Region twin of the note above, for the same reason and with one difference: `Sec`
// carries no `(size: N)` declaration at all, so there is no declared number to go silent —
// this `ensure` is the only place the 22 is written down as a FACT rather than implied by
// the fields. Its two out-of-module twins (engine/level/section.emp and
// engine/level/tile_cache.emp) pin the same number at the two `mul_const.w #sizeof(Sec)`
// stride sites; this one stands beside the declaration so that a field edit meets the number
// in the same file it is editing. Proven red by mutation, in isolation from the twins.
ensure(sizeof(Sec) == 22,
       "engine/structs.emp: sizeof(Sec) is {sizeof(Sec)}, not 22. A field was added or removed above. THREE things follow the size and none of them will tell you: the two `mul_const.w dN, #sizeof(Sec)` strides (engine/level/section.emp's Section_GetSecPtrXY and engine/level/tile_cache.emp's TileCache_DecompressBlock, each with its own copy of this pin), and act_descriptor.emp's MAX_ACT_SECTIONS x sizeof(Sec) <= $7FFF ceiling, which is what keeps Section_GetSecPtrXY's sign-extending `adda.w` from wrapping. Also re-ask the question the two twins exist to force: has an OUT-OF-ASSEMBLER reader of the Sec layout appeared? There was none as of 2026-09-16")

// -----------------------------------------------
// DMA Queue Entry (§1.2) — 14 bytes, RAM queue slots
// VDP reg numbers at even offsets, data at odd offsets — movep's
// alternate-byte writes interleave value bytes between the pre-filled
// register markers, so one movep.l lands a whole field family.
// -----------------------------------------------
pub struct DMAEntry {
    Reg94:   u8,            // +0  VDP reg $14 marker
    SizeH:   u8,            // +1  DMA length high byte
    Reg93:   u8,            // +2  VDP reg $13 marker
    SizeL:   u8,            // +3  DMA length low byte
    Reg97:   u8,            // +4  VDP reg $17 marker
    SrcH:    u8,            // +5  source address bits 22-16
    Reg96:   u8,            // +6  VDP reg $16 marker
    SrcM:    u8,            // +7  source address bits 15-8
    Reg95:   u8,            // +8  VDP reg $15 marker
    SrcL:    u8,            // +9  source address bits 7-0
    Command: u32,           // +10 VDP command (destination + DMA trigger)
}

// -----------------------------------------------
// Parallax config (§4.6) — 30-byte header + N × band_entry inline, ROM data.
// Pointed-to by Region.rg_parallax, EffectsPreset.ep_parallax and Act.act_parallax_config; shared freely.
// Shared consumers: engine.parallax (the whole pipeline) + engine.buffers
// (Enqueue_Dirty_Buffers keys the HScroll DMA length off the deform-table
// fields). band_entry stays parallax-private (single consumer).
//
// 28 -> 30 ON 2026-08-27, WHEN MAX_PARALLAX_BANDS WENT 8 -> 16. `pcfg_layer_mask` is one
// bit per band and `Parallax_Update` selects with `btst d5, d6`, so at a u8 every band
// from index 8 up tested a bit that was structurally ZERO, took `.band_disabled`, and
// inherited the band above it — a build that is green and a picture that is silently
// wrong. There is no guard-only workaround: an all-enabled 12-band scene needs $FFF.
//
// WHY THE SIZE GREW RATHER THAN THE MASK ABSORBING pcfg_v_factor_fg (the rejected option).
// Absorbing byte $02 would have held sizeof at 28 and moved no other field, but it deletes
// a LIVE contract field: games/sonic4/test/poison/poison_scene_vfactor_range.emp exists
// solely to guard its range, scene_equiv_proof.emp's differ compares it, tools/
// effects_gen.py lists it in SCENE_SCALARS, and empyrean retyped it deliberately on
// 2026-08-23 (a32bcb0, CR-1). Deleting a live field across three repos to save 40 ROM
// bytes (2 B x 20 configs) is the wrong trade.
//
// WHAT THE SIZE ACTUALLY HAS TO SATISFY IS *EVEN*, NOT 28 — the older comment here
// overstated it. engine/level/parallax.emp's `copy_run_longs()` `ensure(sizeof(parallax_config) % 2 == 0,
// ...)`: this size IS the band array's base offset, so an odd one starts copy_band_entry's
// `move.l` run on an odd address. 30 is even and passes; nothing in the tree requires 28.
//
// FIELD ORDER — the mask sits at $02 rather than in the new tail, deliberately:
//   * $02 is EVEN, which `move.w` / `btst` on a 68000 require (an odd word address faults).
//   * The mask's LOW byte lands at $03, exactly where the u8 mask was, and its HIGH byte
//     lands on $02, which every shipped config left at 0 (`v_factor_fg` is authored
//     nowhere in games/sonic4/data/effects/). So bytes $00..$1B of every shipped header
//     are UNCHANGED by this widening; the record grows by two tail bytes and the band
//     array that follows it shifts by two. That is the whole ROM diff per config.
//   * It keeps the mask adjacent to `pcfg_band_count` — the two fields that between them
//     describe the band set — instead of stranding it 26 bytes away behind a dead pad.
// `pcfg_v_factor_fg` moves to the tail because it is the only field with NO runtime
// reader (see its note), so it is the one that pays for being relocated.
//
// THE OFFSET COMMENTS ARE A GATE, NOT DECORATION: tools/parallax_crossing_gate.py's
// struct_offsets() accumulates the offsets from the field TYPES and compares every
// trailing `// $HH` against that accumulation, raising a setup error on disagreement. A
// field inserted without renumbering stops that gate instead of sliding every read.
// -----------------------------------------------
pub struct parallax_config {
    pcfg_band_count:        u8,    // $00
    pcfg_v_factor_bg:       u8,    // $01 — whole-plane Plane B vshift (used when v_deform_table_bg = 0)
    pcfg_layer_mask:        u16,   // $02 — bit per band; 1 = active. u16 since MAX_PARALLAX_BANDS = 16
    pcfg_v_center_y:        u16,   // $04 — section's "natural" camera Y
    pcfg_v_offset:          u16,   // $06 — vscroll BG value at center_y
    pcfg_transition:        u8,    // $08 — 0 = smooth lerp (default), 1 = instant snap
    pcfg_deform_speed_fg:   u8,    // $09 — FG H-deform table phase increment per frame
    pcfg_deform_speed_bg:   u8,    // $0A — BG H-deform table phase increment per frame
    // World-anchored deform overlay (Parcel W). PARALLAX_ANCHOR_NONE ($FF) = no overlay;
    // otherwise a patch channel whose Effects_World_Y[] anchor places a SCREEN LINE at
    // which the band under it is split, with every band from there down taking the two
    // shifts below. Claimed from the former pcfg_pad — the overlay costs ZERO bytes.
    pcfg_anchor_ch:         u8,    // $0B
    pcfg_deform_table_fg:   *u8,   // $0C — ROM ptr to 256-byte signed FG H-deform (0 = none)
    pcfg_deform_table_bg:   *u8,   // $10 — ROM ptr to 256-byte signed BG H-deform (0 = none)
    pcfg_v_deform_table_bg: *u8,   // $14 — ROM ptr to 256-byte signed BG V-column (0 = whole-plane)
    pcfg_v_deform_speed_bg: u8,    // $18 — 0 = static column shape, >0 = animated
    pcfg_v_deform_shift_bg: u8,    // $19 — amplitude shift on V-column samples
    // The deform shifts the overlay writes into every band at or below the anchored line
    // (15 = no deform on that plane, same sentinel as band_deform_shift_a/b). Claimed from
    // the former pcfg_pad2 — see pcfg_anchor_ch above. Bands keep their own SCROLL factors;
    // only the wave amplitude is overridden, which is what lets structure below a water
    // surface survive instead of being flattened onto one band.
    pcfg_anchor_dsa:        u8,    // $1A — Plane A deform shift below the anchored line
    pcfg_anchor_dsb:        u8,    // $1B — Plane B deform shift below the anchored line
    // RESERVED — the v1 pipeline always sets fg_vscroll = camY, so NOTHING reads this at
    // runtime; its only consumers are the two lowerings and scene_equiv_proof's differ.
    // Moved from $02 to the tail on 2026-08-27 to free an even slot for the widened mask
    // (see the banner). It is kept, not deleted: it is a live authoring + schema field.
    pcfg_v_factor_fg:       u8,    // $1C
    // THE SCENE-LEVEL VERTICAL BOB (EFFECTS-W1 item 7). Two nibbles in one byte:
    //
    //   bits 7-4  amplitude shift a — peak excursion = SINE_AMPLITUDE >> a pixels
    //   bits 3-0  period shift p    — one full sway = SINE_CYCLE_ENTRIES << p ticks
    //   the WHOLE BYTE 0            — NO BOB. Not a nibble value: the sentinel is the
    //                                 byte, and that is what makes this field free.
    //
    // CLAIMED FROM pcfg_pad_29, the even-size pad, exactly the way pcfg_anchor_ch was
    // claimed from the former pcfg_pad and pcfg_anchor_dsa/dsb from pcfg_pad2. THE BOB
    // THEREFORE COSTS ZERO CONFIG BYTES: sizeof stays 30, the band array that follows the
    // header does not shift, and every one of the twenty shipped records — all of which
    // author no bob and so emit 0 here, the same byte the pad emitted — is unchanged.
    // That is why the sentinel had to be the byte and could not be a nibble: `a = 0` is a
    // 256-px sway and `a = 15` (the house "no deform" sentinel, pcfg_anchor_dsa's) packs
    // to $F0, so either spelling would have moved twenty records for nothing.
    //
    // TWO NIBBLES AND NOT TWO BYTES, deliberately: a second byte takes sizeof to 31, which
    // is odd, which takes it to 32 — +2 bytes on every config AND a two-byte shift of
    // every band array behind every header. The price of the pack is one `lsr.w #4` (14
    // cycles) on a BOBBING scene's frame and nothing at all on any other.
    //
    // Read once per frame by Parallax_Step5_Vscroll at `.v_pack`, which is the single site
    // the whole pipeline's BG vertical origin flows through — so one term there sways the
    // plane, the band rotation, the per-column base and the deform phase together.
    //
    // NO DEFAULT, for pcfg_pad_29's two reasons unchanged: both constructors
    // (scene_dsl.emp's scene_hdr and scene_equiv_proof.emp's hdr) must spell it so a third
    // cannot forget it, and tools/left_col_mask_probe.py's field parser skips any field
    // carrying `= <default>` and would silently under-report sizeof if this one did.
    pcfg_bob:               u8,    // $1D
}

// -----------------------------------------------
// Character Definition (§5) — 32 bytes ($20), ROM table (sizeof is the truth; no
// _len const). ONE record per playable character; the game's roster index table
// (`CharacterDefs`, games/sonic4/player/characters.emp) is an array of
// pointers to these, indexed by CHAR_*.
//
// This is the data the player frame dispatches through instead of naming a
// character: `Player_Chardef` (game RAM) caches the resolved record for the
// active slot, and Player_InitAssets / Player_RefreshPhysics / Player_LoadArt
// read their asset + physics sources from it. Adding Tails or Knuckles is a new
// record plus its art, NOT a new branch in the shared player code.
//
// All-primitive by design (like every other struct in this file): the pointer
// fields are typed to MATCH their consumers — cd_mappings/cd_animtable feed the
// `u32` Sst.mappings/anim_table fields, cd_dplc/cd_artbase/cd_phys/cd_ability
// feed address registers.
// -----------------------------------------------
pub struct CharacterDef {
    cd_phys:      *u8,           // $00 — 8-word physics base row (PhysTable shape;
                                 //       block-copied into the slot's PlayerBlock)
    cd_mappings:  u32,           // $04 — sprite mapping index (-> Sst.mappings)
    cd_dplc:      *u8,           // $08 — DPLC index (Perform_DPLC's a2)
    cd_artbase:   *u8,           // $0C — uncompressed art base (Perform_DPLC's a3)
    cd_animtable: u32,           // $10 — animation script index (-> Sst.anim_table)
    cd_ability:   *u8,           // $14 — AbilityHook: the jump-press hook the air
                                 //       state calls (Ability_None = no double jump)
    cd_vrambase:  u16,           // $18 — character DPLC region base TILE INDEX. The
                                 //       art word is vram_art(tile,0,0) == tile (the
                                 //       player renders at palette 0, priority 0);
                                 //       the DPLC destination is vram_bytes = tile<<5.
    cd_stand_wh:  u16,           // $1A — standing collision box, W<<8|H (full dims,
                                 //       2r+1 — the set_standing_size values)
    cd_roll_wh:   u16,           // $1C — rolling collision box, W<<8|H (set_ball_size)
    cd_flags:     u16,           // $1E — reserved capability bits (0 today)
    cd_palette:   *u8,           // $20 — pointer to a 32-byte CRAM line-0 image, or
                                 //       0 for "leave the current line 0 alone".
                                 //       Copied into Palette_Buffer + line 0 marked
                                 //       dirty by Player_RefreshPhysics on every
                                 //       character resolve.
    cd_ability_wh: u16,          // $24 — the ABILITY-state collision box (Knuckles'
                                 //       glide/slide/climb), W<<8|H full dims (2r+1).
                                 //       0 = no ability box (Sonic, Tails). Set by
                                 //       PHook_EnsureAbility with NO y-shift — S3K
                                 //       applies none on glide entry (:32565-32567).
                                 //       A THIRD box alongside cd_stand_wh/cd_roll_wh:
                                 //       the box machinery knew only two, and coming
                                 //       from a 21x21 ability box PHook_EnsureStanding's
                                 //       old cd_roll_wh-keyed guard missed and never
                                 //       restored standing (the §0 blocker). Appended
                                 //       AFTER cd_palette so $00-$1E stay byte-stable.
}

// cd_palette + cd_ability_wh are LAST deliberately, so every offset $00-$1E above is
// byte-stable and no `CharacterDef.cd_*(a1)` displacement in the player code moves.
//
// WHY A PER-CHARACTER PALETTE EXISTS AT ALL. Two of the three characters could
// share one CRAM line: Sonic's art is already in our index order, and Tails' was
// brought into it by a lossless index PERMUTATION at asset-build time
// (gen_characters.py). Knuckles cannot be — his art uses S3K index 5 ($0080) for
// 3,272 pixels and our line 0 carries that colour at no index, so no permutation
// is lossless for him. S3K solves this the same way, by swapping Pal_Knuckles into
// CRAM line 0 when Knuckles is the player.
//
// THE FORECLOSURE, stated here because this field is where it becomes true: with a
// per-character line 0, Sonic and Knuckles cannot be simultaneously resident on
// one CRAM line. That only constrains a CPU FOLLOWER (two characters on screen at
// once), which is blocked on its own VRAM ruling; a solo character swap is
// unaffected. Three costed options are ledgered in docs/DEFERRED_WORK.md.
//
// A 0 here is legal and means "inherit whatever line 0 already holds", which is
// what a game with one character wants. Note it is NOT the right value for a
// character in a roster that can be CYCLED: the debug hotkey walks
// Sonic -> Tails -> Knuckles -> Sonic, so if Sonic's record said 0 the trip back
// from Knuckles would leave Knuckles' palette in line 0 and render Sonic in his
// colours. Every record in a cycling roster needs a real pointer.

// The HEIGHT halves of the two packed boxes — blessed sub-field views (the
// module boundary above admits these), because the curl geometry is a function
// of the two heights alone and more than one consumer needs them: the player's
// curl hooks derive the feet-planted y-shift, and the unroll ceiling probes in
// player_ground / player_air derive the standing head rise. S3K computes the
// same pair per character (`y_radius - default_y_radius`), which is why they are
// data here and not an engine-wide constant.
//
// Spelled as comptime fns rather than `+ 1` at the use site because a field
// reference does not compose with arithmetic in a displacement — the same reason
// engine.objects.sst spells interact_off() and size_wh_off() this way.
pub comptime fn cd_stand_h_off() -> int {
    return offsetof(CharacterDef, cd_stand_wh) + 1
}
pub comptime fn cd_roll_h_off() -> int {
    return offsetof(CharacterDef, cd_roll_wh) + 1
}

// -----------------------------------------------
// VDP Shadow Table (§0.4) — 19 bytes, RAM mirror of VDP registers $00-$12.
// Registers $13-$17 (DMA) are NOT shadowed. VDP_Shadow_Init copies boot
// register values in; Flush_VDP_Shadow then re-blits ALL 19 back to the VDP
// every VBlank, unconditionally — no dirty bitmask, no per-register skip (the
// `VDP_Dirty_Mask` field this comment used to describe was deleted 2026-08-14).
// So this table is the AUTHORITY for $00-$12, not a cache of it: whatever a byte
// holds at frame top is what the hardware register holds for that frame. Two
// consequences worth knowing before you touch it. (1) A persistent register
// change MUST land here (`Set_VDP_Reg`, or an inline read-modify-write for a
// single bit) — a hardware-only write is undone by the next flush, every frame,
// with nothing gating it. (2) A mid-frame raster poke needs no paired frame-top
// reset word, because the flush already is one; that is the whole reason the
// dirty mask went. The build harvests these field offsets (`VDP_Shadow_vdp_*`) + `VDP_Shadow_len`
// for the residual AS (its `ds` reservations and `setVDPReg` expansions);
// engine.vdp mirrors the register offsets it needs as convenience constants
// (VDP_MODE1_OFF/…, e.g. demo_state.emp's display-enable).
// -----------------------------------------------
pub struct VdpShadow {
    vdp_mode1:       u8,   // reg $00
    vdp_mode2:       u8,   // reg $01
    vdp_plane_a:     u8,   // reg $02
    vdp_window:      u8,   // reg $03
    vdp_plane_b:     u8,   // reg $04
    vdp_sprite:      u8,   // reg $05
    vdp_sprite_gen:  u8,   // reg $06
    vdp_bgcolor:     u8,   // reg $07
    vdp_unused08:    u8,   // reg $08
    vdp_unused09:    u8,   // reg $09
    vdp_hint_rate:   u8,   // reg $0A
    vdp_mode3:       u8,   // reg $0B
    vdp_mode4:       u8,   // reg $0C
    vdp_hscroll:     u8,   // reg $0D
    vdp_nametable_gen: u8, // reg $0E
    vdp_increment:   u8,   // reg $0F
    vdp_plane_size:  u8,   // reg $10
    vdp_window_h:    u8,   // reg $11
    vdp_window_v:    u8,   // reg $12
}
