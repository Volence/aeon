// S4LZ v3 decompressor and tile-delta undo

module engine.s4lz in s4lz

use engine.constants.{TILE_SIZE}

// The dictionary blob is an opaque word-aligned ROM byte region with no
// record shape — DictBase is a MARKER type so `a4: *DictBase` documents
// intent at signatures and call sites (it is not interchangeable with the
// stream or dest pointers).
struct DictBase { }

// -----------------------------------------------
// S4LZ_Decompress — blocking S4LZ v3 stream decompressor
//
// Word-aligned format — every field is word-sized; the stream is read
// with word fetches only.
//
// Header (4 bytes):
//   $00.w = uncompressed size (BE, bytes)
//   $02.b = flags (bit 0 = tile-delta)
//   $03.b = version (1 = v3; this decoder is v3-only — asserted in debug)
//
// Per sequence, one token WORD = [token.b][offmark.b]:
//   token.b high nibble (7-4) = literal word count (0-14, 15 = ext word)
//   token.b low nibble  (3-0) = match word count   (0-14, 15 = ext word)
//   token.b $00 = end of stream (offmark.b is $00 too, so EOS word = $0000
//                 and is consumed whole — a0 ends even, past the stream)
//   offmark.b = match_offset/2 when the byte offset is 2..510 (short form
//               — no offset word in the stream); $00 = long form (a u16 BE
//               offset word follows the literals) or match nibble is 0
// Stream order per sequence:
//   token word, [literal count word], literals,
//   [offset word — long form only], [match count word]
//
// In:  a0 = source (compressed S4LZ data, word-aligned)
//      a1 = destination (word-aligned RAM buffer)
// Out: a0 = past end of compressed data (even — EOS word fully consumed)
// Clobbers: d0-d3, a1-a3
//           a1 is the destination write cursor, left wherever writing stopped.
//           That is NOT an output: a stream that decompresses to zero bytes
//           never writes a1 at all, so the value is then the caller's own dest
//           start. The header size word is the authoritative extent — a
//           consumer that needs the endpoint derives dest_start + size, never
//           (a1 − dest_start). For odd declared sizes the encoder pads to a
//           word boundary and the decoder writes the pad byte, so the written
//           extent is declared_size+1.
//           Offsets must stay < $8000 (suba.w sign-extends): plain entry —
//           dest buffers ≤ 32766 bytes; DICT entry — dest_written + dict_len
//           ≤ 32766 (a deeper legal offset would wrap the suba.w and silently
//           read ABOVE the dest, skipping the debug range assert). Today's
//           deepest use is tile_cache's 768-byte slot + 2304-byte dict = 3072.
//           (a4/d4 untouched — load_art keeps both live across this call)
//
// S4LZ_DecompressDict entry: the LZ window is pre-seeded with a ROM
// dictionary logically prepended to the output. The encoder measures match
// offsets as distances in the dict+data concatenation, so a match source
// below the dest start belongs to the dictionary TAIL. One rebase constant,
// computed once per call, redirects it:
//       a4 = dict_base + dict_len - dest_start
//   so  a2' = a2 + a4 = dict_base + dict_len - (dest_start - a2)
// Trace: a2 one word below dest (offset reaches 2 bytes into the dict) →
//   a2 = dest_start - 2 → a2' = dict_base + dict_len - 2 = last dict word ✓
//   a2 = dest_start - dict_len (deepest legal) → a2' = dict_base ✓
// The encoder never emits matches that straddle the dict/data boundary,
// so an ascending copy starting in the dict stays inside the dict.
// Extra In:  a4 = dict base (ROM, word-aligned)
//            d4.w = dict length in bytes (even, ≤ 3*768; 0 = no dict)
// Extra clobbers: a4 (becomes the rebase constant). d4 preserved.
//   a0 is CLOBBERS here (not out, unlike the plain entry): it ends past the
//   stream identically, but no dict-entry caller consumes it.
// Cost: +16 cycles per match (cmpa.l + taken branch) on the in-buffer path,
//       shared with the plain entry — whose branch never fires on valid
//       no-dict streams (offsets never reach below the dest start), so the
//       plain entry neither reads nor writes a4/d4.
//
// RELEASE-SHAPE FAULT CHECKS (LS-17, owner ruling 2026-09-09 — `crash`)
// ---------------------------------------------------------------------
// Three checks in this decoder are present in the SHIPPED ROM, not just the
// DEBUG shape, and fault deliberately into the crash-report screen the release
// build already carries rather than letting a corrupt stream run off into
// memory. They are gated `DEBUG == 1 || CRASH_REPORT == 1` — the crash-report
// axis (CODING_CONVENTIONS §1.7), NOT bare `DEBUG`, because the thing they
// depend on is the `error_handler` island, which rides that axis. The lean
// profile (CRASH_REPORT=0) has no island to fault into and pays nothing.
//
//   code 1  .fault_version  stream version byte != 1     once/call, 6 bytes
//   code 2  .fault_dict     match reaches below the dict per dict-hit match,
//                           base (the case the ruling names)  8 B, ~24 cyc
//   code 3  .fault_extent   written extent disagrees with once/call, 10 bytes
//                           the header size word
//
// All three branch to ONE `raise_error` tail; d0 carries the code, and at code 2
// d1 carries how many bytes below the dict base the match reached. Codes 1 and 2
// were `assert`s here before this ruling (zero bytes outside DEBUG); code 3 is
// new. What is deliberately NOT promoted: the dict-length-even assert in
// S4LZ_DecompressDict stays DEBUG-only, because an odd dict length lands a2 on
// an odd address and the 68000 raises an ADDRESS ERROR, which already routes to
// the same crash screen through the vector table — a release-shape check there
// would buy a nicer message for real bytes and no new coverage.
// -----------------------------------------------
// ⚠ DO NOT NARROW THIS `clobbers` LIST. Its body writes d0 (DEBUG only) and a4, and
// NOTHING ELSE — so any reader, any lint, and any static analysis will report 8 of the 9
// declared registers as provably unnecessary. THEY ARE NOT. This proc `falls_into
// S4LZ_Decompress`, and the fall-through target is what writes them; a caller that trusts
// a narrowed list here restores registers the fall-through has already destroyed.
// Measured by the sigil lane 2026-09-09 while pricing a narrowing pass: of their 90-proc
// residue, 11 declare `falls_into`, which their closure does not model as an edge at all,
// and THIS PROC is the example they named. Had that pass started from the producer count,
// a register would have been deleted from a contract that needs it, along with its
// caller's correct save. Their own conclusion, and the reason it is written here rather
// than in a doc: the next reader meets a declaration that looks provably unnecessary and
// is wrong, so the reason has to sit where the temptation is.
pub proc S4LZ_DecompressDict (a0: *u8, a1: *u8, a4: *DictBase, d4: u16) clobbers(d0-d3/a0-a4) falls_into S4LZ_Decompress {
        if DEBUG == 1 {
            move.w  d4, d0
            andi.w  #1, d0
            assert.w d0, eq                     // dict length must be word-even
        }
        adda.w  d4, a4                          // a4 = dict end (d4 ≤ 2304, positive)
        suba.l  a1, a4                          // a4 = rebase (dict_end - dest_start)
        // fall through — body below is shared with the no-dict entry
}

pub proc S4LZ_Decompress (a0: *u8, a1: *u8) clobbers(d0-d3/a1-a3) out(a0) {
        movea.l a1, a3                          // a3 = dest start (for tile-delta)
        move.w  (a0)+, d3                       // d3.w = uncompressed size
        move.b  (a0)+, d2                       // d2.b = flags
    if DEBUG == 1 || CRASH_REPORT == 1 {
        // LS-17 check 1 — v3 stream required (version byte = 1). RELEASE-SHAPE:
        // this was `assert.b d0, eq, #1` (zero bytes outside DEBUG); a wrong
        // version byte means the following bytes are not an S4LZ v3 token
        // stream at all, so the loop below would write arbitrary lengths from
        // arbitrary offsets. Once per call, 6 bytes; ~20 cycles when it passes
        // (cmpi.b #imm,(An) 12 + untaken bne 8, 68000 timing table — derived, not
        // measured: no emulator ran in this parcel).
        cmpi.b  #1, (a0)
        bne     .fault_version
    }
        addq.l  #1, a0                          // skip version byte

    .token_loop:
        move.w  (a0)+, d0                       // d0 = [token.b][offmark.b]
        beq     .stream_done                    // $0000 = end of stream

        // --- Extract literal count (token word bits 15-12) ---
        move.w  d0, d1
        rol.w   #4, d1                          // high nibble -> bits 3-0
        andi.w  #$0F, d1                        // d1 = LIT_CNT (0-15)
        beq     .no_literals                    // 0 literals -> skip
        cmpi.w  #15, d1
        beq     .lit_extended                   // 15 = read count word (unsized: the span crosses the LS-17 dict-hit check block, whose size is now the same in both shapes — measured 2026-09-09, `beq.s` disp $7E, 126 of 127, in plain AND debug. One more byte in the span and sigil relaxes it to .w on its own; that is correct, not a hazard)

        // --- Unrolled literal copy (1-14 words) ---
        add.w   d1, d1                          // count * 2 bytes per move.w instruction
        neg.w   d1
        jmp     .lit_end(pc,d1.w)

        move.w  (a0)+, (a1)+                    // entry 14
        move.w  (a0)+, (a1)+                    // entry 13
        move.w  (a0)+, (a1)+                    // entry 12
        move.w  (a0)+, (a1)+                    // entry 11
        move.w  (a0)+, (a1)+                    // entry 10
        move.w  (a0)+, (a1)+                    // entry 9
        move.w  (a0)+, (a1)+                    // entry 8
        move.w  (a0)+, (a1)+                    // entry 7
        move.w  (a0)+, (a1)+                    // entry 6
        move.w  (a0)+, (a1)+                    // entry 5
        move.w  (a0)+, (a1)+                    // entry 4
        move.w  (a0)+, (a1)+                    // entry 3
        move.w  (a0)+, (a1)+                    // entry 2
        move.w  (a0)+, (a1)+                    // entry 1
    .lit_end:

    .no_literals:
        // --- Decode match offset from offmark (token word low byte) ---
        moveq   #0, d1
        move.b  d0, d1                          // d1 = offmark, zero-extended (unsigned 1-255)
        beq     .offmark_zero
        add.w   d1, d1                          // short form: offset = offmark * 2 (2-510)
        lsr.w   #8, d0
        andi.w  #$0F, d0                        // d0 = MATCH_CNT (offmark != 0 guarantees > 0)
        jbra    .have_offset

    .offmark_zero:
        lsr.w   #8, d0
        andi.w  #$0F, d0                        // d0 = MATCH_CNT (0-15)
        beq     .token_loop                     // 0 matches -> next token
        move.w  (a0)+, d1                       // long form: offset word (after literals)

    .have_offset:
        movea.l a1, a2
        suba.w  d1, a2                          // a2 = match source (dest - offset)
        cmpa.l  a3, a2
        bhs     .src_in_dest                    // common case: source within output
        // dictionary hit — redirect into the dict tail (see header trace)
    if DEBUG == 1 || CRASH_REPORT == 1 {
        // LS-17 check 2 — the match source must stay INSIDE the dictionary.
        // RELEASE-SHAPE: this was `assert.w d4, hs, d1` (zero bytes outside
        // DEBUG), and it is the exact case the ruling names — a corrupt offset
        // reaching deeper than dict_len rebases to `dict_base - n` and the copy
        // then reads ROM from below the dictionary, silently. The cost is paid
        // ONLY on the dict-hit path (a match that reaches below the dest start),
        // never on the in-buffer path: 8 bytes, and ~24 cycles per dict-hit match
        // when it passes (4 + 8 + 4 + untaken 8, 68000 timing table — derived, not
        // measured). For scale: the pre-existing cmpa.l/branch on this same path
        // is documented above at +16.
        move.l  a3, d1                          // d1 (offset) is dead past suba
        sub.l   a2, d1                          // bytes below dest start
        cmp.w   d1, d4                          // dict_len - depth
        blo     .fault_dict                     // depth > dict_len -> outside the dict
    }
        adda.l  a4, a2                          // a2 = dict_end - (dest_start - a2)
    .src_in_dest:
        cmpi.w  #15, d0
        beq     .match_extended                 // 15 = read count word

        // --- Unrolled match copy (1-14 words, word-ascending for overlap) ---
        add.w   d0, d0
        neg.w   d0
        jmp     .match_end(pc,d0.w)

        move.w  (a2)+, (a1)+                    // entry 14
        move.w  (a2)+, (a1)+                    // entry 13
        move.w  (a2)+, (a1)+                    // entry 12
        move.w  (a2)+, (a1)+                    // entry 11
        move.w  (a2)+, (a1)+                    // entry 10
        move.w  (a2)+, (a1)+                    // entry 9
        move.w  (a2)+, (a1)+                    // entry 8
        move.w  (a2)+, (a1)+                    // entry 7
        move.w  (a2)+, (a1)+                    // entry 6
        move.w  (a2)+, (a1)+                    // entry 5
        move.w  (a2)+, (a1)+                    // entry 4
        move.w  (a2)+, (a1)+                    // entry 3
        move.w  (a2)+, (a1)+                    // entry 2
        move.w  (a2)+, (a1)+                    // entry 1
    .match_end:
        jbra    .token_loop

        // --- Extended literal count ---
    .lit_extended:
        move.w  (a0)+, d1                       // literal count (word)
        subq.w  #1, d1                          // adjust for dbf
    .lit_dbf_loop:
        move.w  (a0)+, (a1)+
        dbf     d1, .lit_dbf_loop
        jbra    .no_literals                    // continue to match portion (unsized: the span crosses the LS-17 dict-hit check block; measured 2026-09-09 it emits `bra.s` -$66 in both shapes)

        // --- Extended match count (a2 = match source, set in .have_offset) ---
        // Short form: this word directly follows the literals.
        // Long form: it follows the offset word — matching the encoder order.
    .match_extended:
        move.w  (a0)+, d0                       // match count (word)
        subq.w  #1, d0                          // adjust for dbf
    .match_dbf_loop:
        move.w  (a2)+, (a1)+                    // word-ascending — overlap-safe
        dbf     d0, .match_dbf_loop
        jbra    .token_loop

        // --- Stream complete ---
    .stream_done:
    if DEBUG == 1 || CRASH_REPORT == 1 {
        // LS-17 check 3 — the written extent must agree with the header size.
        // RELEASE-SHAPE, and the only one of the three with no DEBUG twin (see
        // the parcel note in DEFERRED_WORK: it is the one an owner who wants the
        // narrowest possible reading of the ruling can drop as a single hunk).
        // The file's own contract (header, "Out:") is that the decoder writes
        // exactly `declared_size` bytes, or `declared_size + 1` when the size is
        // odd and the encoder padded to a word. So written - declared is 0 or 1
        // and nothing else; a corrupt token stream that over-runs the caller's
        // buffer, under-runs it, or carries a garbage size word all land here.
        // It matters most for the tile-delta tail immediately below: TileDelta_Undo
        // walks `d3 >> 5` tiles from the buffer start XORing as it goes, so a
        // garbage size word is a write walk of up to 64 KB through RAM. Faulting
        // here happens BEFORE that walk starts.
        // NOTE it is a detector, not a bound: an over-run has already happened by
        // the time this fires. The real bound needs a dest-extent parameter, which
        // is an ABI change across every caller — filed as the LS-17 follow-up.
        // Once per call, 10 bytes; ~28 cycles when it passes (4 + 8 + 4 + 4 +
        // untaken 8, 68000 timing table — derived, not measured).
        move.l  a1, d0                          // d0 = dest cursor
        sub.l   a3, d0                          // d0.w = bytes actually written
        sub.w   d3, d0                          // - declared size
        subq.w  #2, d0                          // 0 or 1 -> borrow (in contract)
        bcc     .fault_extent                   // no borrow -> >= 2, or negative
    }
        btst    #0, d2                          // tile-delta flag?
        beq     .return
        move.l  a0, -(sp)                       // save compressed-end pointer
        movea.l a3, a0                          // a0 = buffer start
        move.w  d3, d0                          // d0.w = uncompressed size
        jbsr    TileDelta_Undo                  // clobbers a1; its XOR walk ends at
                                                // buffer_end = the decode's own cursor
                                                // (size is a multiple of 32), and for ≤1 tile
                                                // it returns before touching a1 at all — so
                                                // the cursor is unmoved either way
        movea.l (sp)+, a0                       // restore compressed-end pointer

    .return:
        rts

    if DEBUG == 1 || CRASH_REPORT == 1 {
        // LS-17 — the shared deliberate-fault tail (see the FAULT CODES block in
        // this file's header). ONE raise site, reached by a 4-byte dispatch from
        // each check, because three separate `raise_error`s would each carry
        // their own ~20-byte frame plus their own message text and the ruling's
        // accepted cost was tens of bytes, not hundreds. d0 is the code; the
        // crash screen dumps every other register, and at code 2 d1 carries the
        // overrun depth in bytes.
        // This is the EXISTING crash path — `raise_error` lowers to the same
        // MDDBG__ErrorHandler frame every other raise site in the tree uses, and
        // the error_handler island rides `DEBUG || CRASH_REPORT`, which is why
        // the whole block (checks included) carries that predicate: at
        // CRASH_REPORT=0 (the lean profile) the island is absent, so there is
        // nothing to fault into and the checks correctly cost nothing.
    .fault_version:
        moveq   #1, d0
        jbra    .fault
    .fault_dict:
        moveq   #2, d0
        jbra    .fault
    .fault_extent:
        moveq   #3, d0
    .fault:
        raise_error "S4LZ stream fault %<.w d0>"
    }
}

// -----------------------------------------------
// TileDelta_Undo — reverse tile-delta encoding in-place
// Each 32-byte tile is XOR'd against the previous tile.
// First tile (32 bytes) is unchanged.
// In:  a0 = buffer start (decompressed tile data)
//      d0.w = total size in bytes (must be multiple of 32)
// Out: none (buffer modified in-place)
// Clobbers: d0-d1, a0-a1
// -----------------------------------------------
proc TileDelta_Undo (a0: *u8, d0: u16) clobbers(d0-d1/a0-a1) {
        lsr.w   #5, d0                          // d0 = tile count (bytes/TILE_SIZE; 32 = 1<<5, forced by the 8x8 4bpp tile format)
        subq.w  #1, d0                          // subtract 1 for first tile (unchanged)
        ble     .done                           // 0 or 1 tiles -> nothing to do
        subq.w  #1, d0                          // adjust for dbf

        movea.l a0, a1
        adda.w  #TILE_SIZE, a1                  // a1 = second tile

    .tile_loop:
        // XOR 8 longwords (32 bytes) from previous tile into current
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        move.l  (a0)+, d1
        eor.l   d1, (a1)+
        dbf     d0, .tile_loop

    .done:
        rts
}
