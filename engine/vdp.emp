// Typed VDP command interface — shared module (§ shared-VDP consolidation)
//
// The typed VDP command vocabulary + the address→command derivations, a shared
// module. Consumers `use engine.vdp` and call vdp_comm / vdp_comm_reg.
//
// Pure comptime module: opens no section and emits ZERO bytes anywhere in the
// ROM — bytes appear only where a consumer splices vdp_comm_reg or folds a
// vdp_comm constant.
module engine.vdp

// VDP command target/op as pure sum types: an out-of-vocabulary target or
// op cannot compile. Discriminants live ONCE — in the mapper fns below, not on
// the variants — so the enum is the vocabulary and the mapper is the single
// source of the %-encodings.
// Comptime-only (never emitted as data). (Consumers use Vram/Write; the full
// vocabulary is declared so a future consumer is type-checked and the exhaustive
// mappers force an update when a variant is added.)
pub comptime enum VdpTarget { Vram, Cram, Vsram }
pub comptime enum VdpOp     { Read, Write, Dma }

// The VDP port base addresses (VDP_DATA / VDP_CTRL) live in engine.constants
// (the hardware-address authority the residual AS harvests). Consumers
// `use engine.constants.{VDP_DATA, VDP_CTRL}` and keep any directional derives
// (e.g. `VDP_CTRL_OFF = VDP_CTRL - VDP_DATA`) local.

// VDP_Shadow register-slot offsets — the write-through-shadow consumers read
// registers back through these. They mirror the VdpShadow struct (engine.structs,
// the layout author whose offsets the build harvests as `VDP_Shadow_vdp_*`); a
// wrong value here changes the emitted `VDP_Shadow_Table + off` displacement, so
// the six-target byte-identity is the drift check.
pub const VDP_MODE1_OFF = $00                // reg $00 (Mode Set 1) — carries IE1
pub const VDP_MODE2_OFF = $01                // reg $01 (Mode Set 2) — carries VInt enable
pub const VDP_MODE3_OFF = $0B                // reg $0B (Mode Set 3) — ext-int/scroll modes
pub const VDP_HINT_OFF  = $0A                // reg $0A — HInt line counter

// vdp_reg: VDP register-set command word — $8000 base, register number in the
// high byte, value in the low byte. The `where` bounds close the silent
// bit-collisions (vram_art precedent): reg > $17 names a register the VDP lacks,
// val > $FF bleeds into the register-number byte.
pub comptime fn vdp_reg(reg: int where 0..$17, val: int where 0..$FF) -> int {
    return $8000 | (reg << 8) | val
}

// bytes_to_lcnt: byte count -> dbf longword-loop count. Bounded to the real
// clear-loop domain; a non-multiple-of-4 count floors.
pub comptime fn bytes_to_lcnt(n: int where 4..$10000) -> int {
    return n / 4 - 1
}

// The %-encodings (truth: engine.constants — VRAM/CRAM/VSRAM/READ/WRITE/DMA). Exhaustive match — Plan-3
// totality checks it, so a new variant FORCES the mapper to grow.
comptime fn target_bits(t: VdpTarget) -> int {
    match t {
        Vram  => %100001,
        Cram  => %101011,
        Vsram => %100101,
    }
}
comptime fn op_bits(o: VdpOp) -> int {
    match o {
        Read  => %001100,
        Write => %000111,
        Dma   => %100111,
    }
}

// Drift-lock the MAPPING, not just the constants: each arm is pinned to its
// engine.constants value through the link seam, so the match itself can't drift.
ensure(target_bits(VdpTarget.Vram) == extern("VRAM"), "engine.constants and engine.vdp disagree on VRAM — update target_bits")
ensure(target_bits(VdpTarget.Cram) == extern("CRAM"), "engine.constants and engine.vdp disagree on CRAM — update target_bits")
ensure(target_bits(VdpTarget.Vsram) == extern("VSRAM"), "engine.constants and engine.vdp disagree on VSRAM — update target_bits")
ensure(op_bits(VdpOp.Read) == extern("READ"), "engine.constants and engine.vdp disagree on READ — update op_bits")
ensure(op_bits(VdpOp.Write) == extern("WRITE"), "engine.constants and engine.vdp disagree on WRITE — update op_bits")
ensure(op_bits(VdpOp.Dma) == extern("DMA"), "engine.constants and engine.vdp disagree on DMA — update op_bits")

// vdp_comm — build-time VDP command longword from a VRAM/CRAM/VSRAM byte
// address. The typed target/op feed the
// mappers; the derivation is the AS bit-trick verbatim.
pub comptime fn vdp_comm(addr: int, target: VdpTarget, op: VdpOp) -> int {
    let type = target_bits(target)
    let rwd = op_bits(op)
    // The address scatter is vdp_comm_delta's derivation — composed, not
    // re-spelled, so the scatter lives once in this module.
    return (((type & rwd) & 3) << 30) | vdp_comm_delta(addr) | (((type & rwd) & $FC) << 2)
}

// vdp_comm_reg — convert a VRAM/CRAM/VSRAM byte address in `reg` to a VDP
// command longword IN PLACE (mirrors the AS `vdpCommReg` macro). The four guards
// below all select ENCODING CASES (which instructions to emit for the resolved
// bit pattern) — none are vocabulary validation, so the sum types added no
// unreachable guard to delete; they add call-site safety. Each guard is a small
// helper spliced into the one asm block (the lead_move/aabb pattern), so a
// not-taken arm emits nothing. `clr` defaults to `true`, the dominant vdpCommReg
// value ENGINE-WIDE (section ×2 + one DMA-queue write pass clr=1; two DMA-queue
// `VRAM,DMA,0` sites + plane_buffer's two drain heads pass clr=0).
comptime fn vcr_addq(tr: int, reg: Reg) -> Code {
    let bits = tr & 3
    if bits != 0 { return asm { addq.w  #{bits}, {reg} } }
    return asm { }
}
comptime fn vcr_clr(clr: bool, reg: Reg) -> Code {
    if clr { return asm { andi.w  #3, {reg} } }
    return asm { }
}
comptime fn vcr_type(tr: int, reg: Reg) -> Code {
    let hi = tr & $FC
    if hi == $20 { return asm { tas.b   {reg} } }
    if hi != 0 { return asm { ori.w   #{hi << 2}, {reg} } }
    return asm { }
}
pub comptime fn vdp_comm_reg(reg: Reg, target: VdpTarget, op: VdpOp, clr: bool = true) -> Code {
    let tr = target_bits(target) & op_bits(op)
    return asm {
        lsl.l   #2, {reg}
        {vcr_addq(tr, reg)}
        ror.w   #2, {reg}
        swap    {reg}
        {vcr_clr(clr, reg)}
        {vcr_type(tr, reg)}
    }
}

// -----------------------------------------------
// DMA/plane address derivations. Pure comptime int fns: the byte gates
// bind every fold. dma_source takes COMPTIME addresses only — a link-time
// RAM source (Palette_Buffer class) cannot reach a comptime fn and rides a
// consumer-side `equ` spelling the same derivation over extern() (the
// row-1004 comptime/link boundary; buffers.emp is the worked example).
// -----------------------------------------------

// dma_source: byte address -> DMA source word address for VDP regs $95-$97
// (bit 23 excluded: reg $17 bit 7 is DMD1, not an address).
pub comptime fn dma_source(addr: int) -> int {
    return (addr >> 1) & $7FFFFF
}

// dma_length: byte count -> DMA length in words for VDP regs $93-$94.
pub comptime fn dma_length(bytes: int) -> int {
    return (bytes >> 1) & $FFFF
}

// vdp_comm_delta: VRAM byte-address DELTA -> the same
// scrambled bit layout as the command longword's address field, so adding it
// to a write command advances the destination by `addr` bytes.
pub comptime fn vdp_comm_delta(addr: int) -> int {
    return ((addr & $3FFF) << 16) | ((addr & $C000) >> 14)
}

// vdp_comm_addr — the INVERSE scatter: recover the byte address from a command
// longword. Lives here, touching vdp_comm_delta, because a scatter and its inverse
// drift as a pair or not at all; spelled in a consumer it would be a hand-synced twin
// of the line above, which is the failure mode this module already avoids by having
// vdp_comm compose vdp_comm_delta rather than re-spell it.
//
// The consumer is the dense raster tier, which is handed a prebuilt CRAM command and
// must DERIVE its pal_dirty_mask from it rather than accept the author's claim — a
// mask naming the wrong line leaves a mid-frame write latched forever (the observed
// P1 bug). See engine/effects/raster.emp, raster_gradient_program.
pub comptime fn vdp_comm_addr(cmd: int) -> int {
    return ((cmd >> 16) & $3FFF) | ((cmd & 3) << 14)
}

// The round trip, pinned at three addresses that exercise both halves of the scatter:
// below $4000 (low bits only), and above it (where bits 14-15 land in the low word).
ensure(vdp_comm_addr(vdp_comm_delta($48)) == $48,
       "vdp_comm_addr is not the inverse of vdp_comm_delta at $48")
ensure(vdp_comm_addr(vdp_comm_delta($3FFE)) == $3FFE,
       "vdp_comm_addr is not the inverse of vdp_comm_delta at $3FFE")
ensure(vdp_comm_addr(vdp_comm_delta($C000)) == $C000,
       "vdp_comm_addr is not the inverse of vdp_comm_delta at $C000 — the high address bits ride in the command's LOW word")

// plane_loc: nametable cell (col, row) -> byte offset in a plane `width` cells
// wide.
pub comptime fn plane_loc(width: int, col: int, row: int) -> int {
    return ((width * row) + col) * 2
}
