// Typed VDP command interface — shared module (§ shared-VDP consolidation)
//
// The typed VDP command vocabulary + the address→command derivations, hoisted
// out of section.emp when plane_buffer became the 2nd consumer (gap-ledger
// row 1073 — the TILE_CACHE_* / Sec-Act shared-struct-module precedent: the 2nd
// .emp consumer triggers consolidation). Consumers `use engine.vdp` and call
// vdp_comm / vdp_comm_reg; the AS twins keep their inline/macro spelling
// (`vdpComm` / `vdpCommReg`), byte-identical to these.
//
// Pure comptime module: opens no section and emits ZERO bytes anywhere in the
// ROM — bytes appear only where a consumer splices vdp_comm_reg or folds a
// vdp_comm constant.
module engine.vdp

use engine.structs.{VdpShadow}

// VDP command target/op as pure sum types: an out-of-vocabulary target or
// op cannot compile. Discriminants live ONCE — in the mapper fns below, not on
// the variants — so the enum is the vocabulary and the mapper is the single
// source of the %-encodings that feed the AS `(type & rwd)` derivation verbatim.
// Comptime-only (never emitted as data). (Consumers use Vram/Write; the full
// vocabulary is declared so a future consumer is type-checked and the exhaustive
// mappers force an update when a variant is added.)
pub comptime enum VdpTarget { Vram, Cram, Vsram }
pub comptime enum VdpOp     { Read, Write, Dma }

// The VDP port base addresses (truth: engine/constants.asm) — hoisted here
// when bg became the 3rd `.emp` consumer (parallax + plane_buffer carried
// local mirrors; the 2nd-consumer rule had already triggered). Consumers
// `use engine.vdp.{VDP_DATA, VDP_CTRL}` and keep any directional derives
// (e.g. `VDP_DATA_OFF = VDP_DATA - VDP_CTRL`) local.
pub const VDP_DATA = $C00000
pub const VDP_CTRL = $C00004
ensure(extern("VDP_DATA") == VDP_DATA, "engine/constants.asm and engine.vdp disagree on VDP_DATA — update the twin")
ensure(extern("VDP_CTRL") == VDP_CTRL, "engine/constants.asm and engine.vdp disagree on VDP_CTRL — update the twin")

// VDP_Shadow register-slot offsets — the write-through-shadow consumers read
// registers back through these. Derived from the VdpShadow struct (engine.structs,
// the sole layout author), so a struct field reorder moves these in lockstep and
// there is no separate literal to drift.
pub const VDP_MODE1_OFF = offsetof(VdpShadow, vdp_mode1)   // reg $00 (Mode Set 1) — carries IE1
pub const VDP_MODE2_OFF = offsetof(VdpShadow, vdp_mode2)   // reg $01 (Mode Set 2) — carries VInt enable
pub const VDP_MODE3_OFF = offsetof(VdpShadow, vdp_mode3)   // reg $0B (Mode Set 3) — ext-int/scroll modes
pub const VDP_HINT_OFF  = offsetof(VdpShadow, vdp_hint_rate) // reg $0A — HInt line counter

// The %-encodings (truth: engine/constants.asm). Exhaustive match — Plan-3
// totality checks it, so a new variant FORCES the mapper to grow.
comptime fn target_bits(t: VdpTarget) -> int {
    match t {
        Vram  => %100001,
        Cram  => %101011,
        Vsram => %100101,
    }
}
comptime fn op_bits(o: VdpOp) -> int {
    match o {
        Read  => %001100,
        Write => %000111,
        Dma   => %100111,
    }
}

// Drift-lock the MAPPING, not just the constants: each arm is pinned to its
// AS-side equ through the link seam, so the match itself can't drift.
ensure(target_bits(VdpTarget.Vram) == extern("VRAM"), "engine/constants.asm and engine.vdp disagree on VRAM — update target_bits")
ensure(target_bits(VdpTarget.Cram) == extern("CRAM"), "engine/constants.asm and engine.vdp disagree on CRAM — update target_bits")
ensure(target_bits(VdpTarget.Vsram) == extern("VSRAM"), "engine/constants.asm and engine.vdp disagree on VSRAM — update target_bits")
ensure(op_bits(VdpOp.Read) == extern("READ"), "engine/constants.asm and engine.vdp disagree on READ — update op_bits")
ensure(op_bits(VdpOp.Write) == extern("WRITE"), "engine/constants.asm and engine.vdp disagree on WRITE — update op_bits")
ensure(op_bits(VdpOp.Dma) == extern("DMA"), "engine/constants.asm and engine.vdp disagree on DMA — update op_bits")

// vdp_comm — build-time VDP command longword from a VRAM/CRAM/VSRAM byte
// address (mirrors the AS `vdpComm` function). The typed target/op feed the
// mappers; the derivation is the AS bit-trick verbatim.
pub comptime fn vdp_comm(addr: int, target: VdpTarget, op: VdpOp) -> int {
    let type = target_bits(target)
    let rwd = op_bits(op)
    // The address scatter is vdp_comm_delta's derivation — composed, not
    // re-spelled, so the scatter lives once in this module.
    return (((type & rwd) & 3) << 30) | vdp_comm_delta(addr) | (((type & rwd) & $FC) << 2)
}

// vdp_comm_reg — convert a VRAM/CRAM/VSRAM byte address in `reg` to a VDP
// command longword IN PLACE (mirrors the AS `vdpCommReg` macro). The four guards
// below all select ENCODING CASES (which instructions to emit for the resolved
// bit pattern) — none are vocabulary validation, so the sum types added no
// unreachable guard to delete; they add call-site safety. Each guard is a small
// helper spliced into the one asm block (the lead_move/aabb pattern), so a
// not-taken arm emits nothing. `clr` defaults to `true`, the dominant vdpCommReg
// value ENGINE-WIDE (section ×2 + one DMA-queue write pass clr=1; two DMA-queue
// `VRAM,DMA,0` sites + plane_buffer's two drain heads pass clr=0).
comptime fn vcr_addq(tr: int, reg: Reg) -> Code {
    let bits = tr & 3
    if bits != 0 { return asm { addq.w  #{bits}, {reg} } }
    return asm { }
}
comptime fn vcr_clr(clr: bool, reg: Reg) -> Code {
    if clr { return asm { andi.w  #3, {reg} } }
    return asm { }
}
comptime fn vcr_type(tr: int, reg: Reg) -> Code {
    let hi = tr & $FC
    if hi == $20 { return asm { tas.b   {reg} } }
    if hi != 0 { return asm { ori.w   #{hi << 2}, {reg} } }
    return asm { }
}
pub comptime fn vdp_comm_reg(reg: Reg, target: VdpTarget, op: VdpOp, clr: bool = true) -> Code {
    let tr = target_bits(target) & op_bits(op)
    return asm {
        lsl.l   #2, {reg}
        {vcr_addq(tr, reg)}
        ror.w   #2, {reg}
        swap    {reg}
        {vcr_clr(clr, reg)}
        {vcr_type(tr, reg)}
    }
}

// -----------------------------------------------
// DMA/plane address derivations (mirror the AS functions in
// engine/macros.asm; joined at the tranche-21 buffers port — the row-1052
// shared-home adoption's second half). Pure comptime int fns: the byte gates
// bind every fold. dma_source takes COMPTIME addresses only — a link-time
// RAM source (Palette_Buffer class) cannot reach a comptime fn and rides a
// consumer-side `equ` spelling the same derivation over extern() (the
// row-1004 comptime/link boundary; buffers.emp is the worked example).
// -----------------------------------------------

// dmaSource (engine/macros.asm): byte address -> DMA source word address for
// VDP regs $95-$97 (bit 23 excluded: reg $17 bit 7 is DMD1, not an address).
pub comptime fn dma_source(addr: int) -> int {
    return (addr >> 1) & $7FFFFF
}

// dmaLength (engine/macros.asm): byte count -> DMA length in words for VDP
// regs $93-$94.
pub comptime fn dma_length(bytes: int) -> int {
    return (bytes >> 1) & $FFFF
}

// vdpCommDelta (engine/macros.asm): VRAM byte-address DELTA -> the same
// scrambled bit layout as the command longword's address field, so adding it
// to a write command advances the destination by `addr` bytes.
pub comptime fn vdp_comm_delta(addr: int) -> int {
    return ((addr & $3FFF) << 16) | ((addr & $C000) >> 14)
}

// planeLoc (engine/macros.asm): nametable cell (col, row) -> byte offset in a
// plane `width` cells wide.
pub comptime fn plane_loc(width: int, col: int, row: int) -> int {
    return ((width * row) + col) * 2
}
