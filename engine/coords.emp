// Coordinate-domain templates — shared module.
//
// The engine stores positions as 16.16 fixed point (`Coord`): whole pixels in
// the HIGH word, the subpixel fraction in the low word. Anything that arrives
// as integer pixels — a descriptor offset, a camera position, a spawn point —
// has to be PROMOTED into that layout before it can be added to or stored in a
// Coord field, and the promotion is always the same two instructions.
//
// Consumers `use engine.coords.{pixels_to_coord}`.
//
// Pure comptime module: opens no section and emits ZERO bytes anywhere in the
// ROM — bytes appear only where a consumer splices the template.
module engine.coords

// Promote integer pixels held in the LOW word of `v` to a 16.16 `Coord` in the
// whole of `v`: the pixel value moves to the high word and the subpixel
// fraction is cleared. The caller sign-extends first if its source was a byte
// (`ext.w`) — this template promotes, it does not widen.
//
// Reads as "these pixels are now a Coord" at the call site, which is the
// point: the bare `swap`/`clr.w` pair runs ten times in children.emp alone and
// again in camera.emp (×3) and the game's spawn code, and it says nothing
// about what it means.
pub comptime fn pixels_to_coord(v: Reg) -> Code {
    return asm {
        swap    {v}
        clr.w   {v}
    }
}

// abs_w — |v| in place: negate the word when it is negative. The .emp
// counterpart of the corpus's most-repeated absolute-value idiom (the bpl/neg.w
// pair), with a hygienic `.abs` label per expansion (the mask_opposing_lr splice
// pattern). Shared here in engine.coords beside pixels_to_coord — a corpus-wide
// engine idiom: player physics (player_ground/air), |slot-center| eviction
// (entity_window), AABB |delta| (collision), and |pos-camera| culling (core) all
// splice it. The caller must have v's sign live in the condition codes — every
// site loads/computes v immediately before, so the bpl reads v's own sign (no
// self-tst, exactly the inline idiom).
// In:  v = data register holding a signed word; N reflects its sign
// Out: v = |v|
pub comptime fn abs_w(v: Reg) -> Code {
    return asm {
        bpl     .abs
        neg.w   {v}
    .abs:
    }
}
