// Engine RAM layout — the `.emp` region form (item #7).
//
// Two address windows, declared as `region`s and populated by `vars` blocks that
// allocate at exact, deterministic addresses:
//   lower_ram ($FFFF0000+) — large buffers, `.l`-addressed (tile cache, block
//                            staging, streaming).
//   upper_ram ($FFFF8000+) — hot data, `.w`-addressed for speed (system, DMA
//                            queue, sprite/camera/tile-cache metadata, entity/
//                            ring window, sound state).
//
// This module is the SOLE author of the engine RAM layout: its `pub` labels are
// the link authority every consumer (`.emp` and residual AS) resolves against.
// The overflow guards, the `.w`-addressability bit-15 rule, and the buffer-reuse
// overlap are compiler checks now — the region `limit`s, `w_addressable`, and the
// `alias`+`ensure` below replace ram.asm's `if/error` directives.

module engine.ram

// Glob-import the engine constants: many sizes below are DERIVED consts
// (e.g. TILE_CACHE_NT_SIZE = TILE_CACHE_COLS * TILE_CACHE_ROWS * 2), whose RHS
// is evaluated in THIS module's scope, so their base consts must be in scope too
// — the glob brings the whole invariant set (the game-VARYING sizes still arrive
// as -D defines: MAX_RING_BUFFER, COLLECTED_WINDOW_SLOTS, DEBUG).
use engine.constants.*
use engine.structs.{DMAEntry, VdpShadow, PageInReq, PageFrame}
use engine.objects.sst.{Sst}
// Sst's fields carry the engine.types domain vocabulary (Coord/Velocity/… — all
// erase to raw widths); computing sizeof(Sst)/[Sst; N] here resolves those field
// types in this module's scope, so the vocabulary must be imported.
use engine.types.*

// --- struct lengths whose owners live in CODE modules (entity_window /
//     parallax) and so are not comptime-importable here. Mirror the value as a
//     local const, drift-guarded against the build's harvested struct length
//     (the same `_len` the AS side reads) — the rings.emp / entity_window.emp
//     RING_BUFFER_ENTRY_SIZE pattern. -------------------------------------------
const ENTITY_SCAN_STATE_LEN = $1A   // sizeof(EntityScanState); pinned in entity_window.emp
const BAND_ENTRY_LEN        = 10    // sizeof(band_entry); pinned in parallax.emp
// BAND_EXT_BYTES — the per-band DEFORM EXTENSION, and it is a SECOND constant on purpose
// (P3 Task 9). A shadow band occupies `BAND_ENTRY_LEN + BAND_EXT_BYTES`, not one widened
// number, because the two are pinned to different things and only one of them can ever
// move:
//   * BAND_ENTRY_LEN mirrors the LEGACY `band_entry`, which sigil harvests ambiently and
//     which never gains a field (see parallax.emp's band_record banner for why it cannot).
//     The `extern("band_entry_len")` pin below holds it there FOR EVER.
//   * BAND_EXT_BYTES mirrors `sizeof(band_ext) * BAND_EXT_N` — the capability-selected
//     tail. ram.emp is lowered by a focused, CONTRACT-BLIND build and cannot read the
//     capability, so this is the one edit a capability flip needs on this side, and
//     parallax.emp's reservation guard names it.
//
// THIS SPLIT REPLACES A CONTRADICTION P3 TASK 9 WALKED INTO. Task 8's reservation guard
// said "widen BAND_ENTRY_LEN by sizeof(band_ext)", and doing exactly that fails the mirror
// pin one line down — BAND_ENTRY_LEN is the legacy struct's size and the harvest says so.
// Following the advice made the build red in a second place, which is the worst kind of
// guidance: correct-sounding, and a dead end. Measured 2026-08-20 raising the capability
// for Task 9's instrument build.
const BAND_EXT_BYTES        = 0     // sizeof(band_ext) * BAND_EXT_N; pinned in parallax.emp
// BAND_CURVE_BYTES — the per-band CURVE tail (P3 Task 10), a THIRD constant for the same
// reason BAND_EXT_BYTES is a second one: it mirrors a DIFFERENT capability bit
// (CAP_FACTOR_CURVE, not CAP_MULTI_DEFORM_TABLE), and a game may declare either, both or
// neither. A shadow band occupies BAND_ENTRY_LEN + BAND_EXT_BYTES + BAND_CURVE_BYTES, and
// parallax.emp's reservation guard names whichever one is short.
// MOVED TO 10 BY THE d-15 SHOWCASE PARCEL (2026-08-26), in the same commit as
// parallax.emp's BAND_CURVE_N = 1, because the OJZ showcase now authors a curve.
const BAND_CURVE_BYTES      = 10    // sizeof(band_curve) * BAND_CURVE_N; pinned in parallax.emp
// CURVE_CARRY_WORDS — the two words a curve fill parks between an anchored split and the
// layer it split, DERIVED from the tail mirror above rather than being a fourth constant a
// capability flip would have to remember. A curve tail (10 B) means a carry (2 words); no
// tail means no carry and no bytes. The two-value pin is what keeps the division honest.
ensure(BAND_CURVE_BYTES == 0 || BAND_CURVE_BYTES == 10, "BAND_CURVE_BYTES is {BAND_CURVE_BYTES}, which is neither 0 (no curve tail) nor sizeof(band_curve) = 10 — CURVE_CARRY_WORDS below divides it, and parallax.emp's reservation guard is what checks the 10")
const CURVE_CARRY_WORDS     = BAND_CURVE_BYTES / 5
// BAND_DRIFT_BYTES — the per-band DRIFT tail (band drift), a FOURTH constant for the reason
// BAND_CURVE_BYTES is a third one: it mirrors a DIFFERENT capability bit (CAP_BAND_DRIFT), and
// a game may declare any subset of the three. A shadow band occupies
// BAND_ENTRY_LEN + BAND_EXT_BYTES + BAND_CURVE_BYTES + BAND_DRIFT_BYTES, and parallax.emp's
// reservation guard names whichever one is short.
// MOVED TO 4 BY THE DRIFT ADOPTION PARCEL (EFFECTS-W1 item 3, 2026-09-02), in the same commit
// as parallax.emp's BAND_DRIFT_N = 1, because Scene_OJZ_Default now authors a rate.
const BAND_DRIFT_BYTES      = 4     // sizeof(band_drift) * BAND_DRIFT_N; pinned in parallax.emp
// DRIFT_ACC_LONGS — the per-band 16.16 accumulators (Parallax_Drift_Acc), DERIVED from the
// tail mirror above rather than being a fifth constant a capability flip would have to
// remember. This copies CURVE_CARRY_WORDS' shape deliberately: A CAPABILITY FLIP MUST EDIT ONE
// NUMBER ON THIS SIDE, NOT TWO. A drift tail (4 B) means one accumulator long per band; no
// tail means no accumulator and no bytes. The two-value pin is what keeps the division honest.
ensure(BAND_DRIFT_BYTES == 0 || BAND_DRIFT_BYTES == 4, "BAND_DRIFT_BYTES is {BAND_DRIFT_BYTES}, which is neither 0 (no drift tail) nor sizeof(band_drift) = 4 — DRIFT_ACC_LONGS below divides it, and parallax.emp's reservation guard is what checks the 4")
const DRIFT_ACC_LONGS       = BAND_DRIFT_BYTES / 4
ensure(extern("EntityScanState_len") == ENTITY_SCAN_STATE_LEN, "EntityScanState size drifted from ram.emp's mirror — update ENTITY_SCAN_STATE_LEN")
ensure(extern("band_entry_len") == BAND_ENTRY_LEN, "band_entry size drifted from ram.emp's mirror — update BAND_ENTRY_LEN")

// The VDP shadow table has TWO authorities for one number and nothing related
// them. This module reserves the buffer as `[u8; sizeof(VdpShadow)]` (derived),
// while engine.vdp_init bounds BOTH its init copy loop and its flush walk with
// the separately-declared `VDP_Shadow_len` const — which the constant harvest
// deliberately excludes from the struct-offset injector, so the two are
// independent by construction. Equality is the right relation because BOTH
// directions are live: too small and a shadowed register silently never reaches
// the hardware (no crash, no golden byte); too large and BOTH walks run past the
// buffer's pad into whatever RAM follows — the init copy stomps it, the flush
// ships it to VDP_CTRL as register writes. vdp_init's own `<= 24` guard is a
// ceiling and passes for 19 and 20 alike. This is the one place both
// authorities are already in scope.
ensure(VDP_Shadow_len == sizeof(VdpShadow),
       "VDP_Shadow_len ({VDP_Shadow_len}) and sizeof(VdpShadow) disagree — the shadow buffer and the flush-loop bound would cover different register counts")

// --- game-config buffer-layout sizes: ENGINE-INVARIANT (identical in every
//     game's config/constants.emp), homed here as engine consts + drift-guarded
//     against the AS game config (the rings.emp convention). MAX_RING_BUFFER /
//     COLLECTED_WINDOW_SLOTS VARY per game and arrive as -D defines.
//     RING_BUFFER_ENTRY_SIZE / COLLECTED_SLOT_SIZE used to live here too; review
//     item 30/G moved those two FORMATS to engine.constants (the glob import
//     above supplies them now), so their game-config copies and the extern drift
//     guards that policed them are gone. --------------------------------------
const COLLECTED_PARK_SLOTS     = 4    // park entries (rolling overwrite)
const COLLECTED_PARK_ENTRY_SIZE = 33  // 1 id byte + collected + killed masks (byte-packed)
ensure(extern("COLLECTED_PARK_SLOTS") == COLLECTED_PARK_SLOTS, "game config/constants.emp and ram.emp disagree on COLLECTED_PARK_SLOTS")
ensure(extern("COLLECTED_PARK_ENTRY_SIZE") == COLLECTED_PARK_ENTRY_SIZE, "game config/constants.emp and ram.emp disagree on COLLECTED_PARK_ENTRY_SIZE")

pub region lower_ram @ $FFFF0000 .. $FFFF8000
pub region upper_ram @ $FFFF8000 .. SYSTEM_STACK, w_addressable

// -----------------------------------------------
// Lower RAM — 2D tile cache, block staging, streaming buffers (§4.7).
// Art_Staging_Buffer is a dedicated 2048-byte buffer (P2b): steady-state page-in
// stages a decompressed art page here before its DMA lands.
// -----------------------------------------------
pub vars lower_ram {
    // 2D tile cache — world-space sliding window (replaces 1D strip cache)
    Tile_Cache_Nametable:   [u8; TILE_CACHE_NT_SIZE],                       // 9600 bytes (80×60×2)
    // Collision: two planes contiguous in memory.
    //   Plane A: Tile_Cache_Collision + 0                    (2400 bytes, 80×30)
    //   Plane B: Tile_Cache_Collision + TILE_CACHE_COLL_SIZE (2400 bytes, 80×30)
    // Tile_Cache_GetCollision selects the plane via the caller's SST_layer value.
    Tile_Cache_Collision:   [u8; TILE_CACHE_COLL_SIZE * TILE_CACHE_COLL_PLANES],  // 4800 bytes
    // RESERVED, not an alignment pad. The collision region above is 4800 bytes —
    // already even — so this contributes nothing to alignment; the "pad to even"
    // it used to claim was wrong. Kept as 2 reserved bytes rather than converted
    // to a computed `& 1` pad because a computed pad evaluates to 0 today and
    // would shift all of lower RAM by −2 (a layout change, out of scope for a
    // comment/guard parcel — reclaim it with the D7 deletion batch).
    pad(2),                                                                 // reserved (region already even)

    // Block staging cache — recently decompressed blocks (§4.7). BLOCK_STAGE_SLOTS
    // slots of BLOCK_RAW_SIZE each: nametable (512 B) + collision plane A (128 B)
    // + collision plane B (128 B). Keys live in upper RAM (Block_Stage_Keys).
    Block_Stage_Buffers:    [u8; BLOCK_RAW_SIZE * BLOCK_STAGE_SLOTS],       // BLOCK_STAGE_SLOTS × BLOCK_RAW_SIZE = 16 × 768 = 12288 bytes

    // --- Staging probe index (streaming fix F4) — the O(1) replacement for the
    //     16-key linear scan TileCache_FindStagedBlock used to run.
    //
    //     THIS IS NOT A DIRECT-MAPPED CACHE. Slot assignment is still strict
    //     round-robin over Block_Stage_Keys (Block_Stage_Next) — the eviction
    //     POLICY is fix F2's subject and this parcel does not touch it. What
    //     follows is a faithful side index over whatever slots that policy picks,
    //     so a probe returns exactly the slot the linear scan returned, key for
    //     key, and the staged HIT/MISS sequence is unchanged by construction.
    //
    //     Bucket = the block index (0..BLOCK_INDEX_ENTRIES-1), which the probe
    //     already holds in d2 — the hash costs zero instructions. Two staged
    //     blocks share a bucket only when they carry the same intra-section block
    //     index in DIFFERENT sections, i.e. sit exactly BLOCKS_PER_SECTION_AXIS
    //     blocks (256 tiles) apart on an axis; the tile cache is 80×60 tiles and
    //     the claim history spans far less than that, so it does not arise on
    //     shipped geometry. The CHAIN is here so that exactness does not REST on
    //     that argument: a false miss would decompress a block the scan would have
    //     found, changing the staging schedule — the one thing a lookup fix must
    //     never do. Separate chaining is exact for any hash.
    //
    //     INVARIANT (maintained in exactly two places, TileCache_InvalidateStaging
    //     and TileCache_DecompressBlock's claim): for every slot s, if
    //     Block_Stage_Keys[s] != $FFFFFFFF then s appears exactly once in the chain
    //     of bucket (key & $FF), and if it is $FFFFFFFF then s appears in no chain.
    //
    //     Both tables address a slot by slot*4 — the SAME index the stride-4
    //     Keys/Ptrs/Maps arrays use — because the probe's clobber license is
    //     d3-d4/a1 and d3 carries the key, leaving exactly one index register.
    //     Block_Stage_Chain is therefore stride-4 with only its 0-mod-4 bytes
    //     live; the 48 dead bytes buy that register. $FF = empty / end of chain.
    Block_Stage_Bucket:     [u8; BLOCK_STAGE_BUCKETS],                      // 256 bytes — per block_index, head slot*4 or $FF
    Block_Stage_Chain:      [u8; BLOCK_STAGE_SLOTS * 4],                    // 64 bytes — per slot*4, next slot*4 or $FF

    // --- Speculation residency guard + prefetch-memo eviction masks (fix F2) ---
    //     IN LOWER RAM ON PURPOSE, and it is not about addressing. This is
    //     once-per-LOGIC-TICK state read by exactly one routine, so the .w window
    //     buys 4 cycles a tick; an addition at the upper_ram TAIL, where the rest
    //     of the prefetch memo lives, moves Engine_RAM_End and costs a full
    //     game-side repin. Placed here (ahead of the residency tables) it moves
    //     four lower_ram symbols and NOTHING game-side — the same trade F4 made
    //     for Block_Stage_Bucket/Chain directly above.
    //
    //     Cache_Spec_Gen_Ring holds Block_Stage_Gen as it stood at each of the
    //     last BLOCK_SPEC_LEAD_TICKS ticks, indexed `Logic_Tick & (LEAD-1)`;
    //     current gen minus the entry about to be overwritten IS the claim count
    //     over the prefetch lead, with no division and no rate estimator. It is
    //     PRIMED to the live generation by TileCache_InvalidateStaging, never left
    //     zero: a zeroed ring reads as a huge claim count and would suppress
    //     speculation for the first LEAD ticks of every act.
    Cache_Spec_Gen_Ring:    [u16; BLOCK_SPEC_LEAD_TICKS],   // 16 bytes — per-tick Block_Stage_Gen history
    Cache_Spec_Window:      u16,        // claims over the last LEAD ticks (the guard's input; probe-readable)
    Cache_Spec_Blocked:     u16,        // Schmitt latch: nonzero = speculation suppressed this tick
    Cache_Spec_Skips:       u16,        // ticks the guard suppressed speculation on (release, monotone)
    // Prefetch-memo covered-slot masks (fix F2, the memo re-key). Bit s = "the
    // scan's all-staged result rests on staging slot s". A later claim only
    // invalidates the memo if it EVICTED one of these slots, which the memo check
    // derives from the round-robin cursor rather than from the raw generation —
    // the generation is bumped by every claim in the engine, including the scan's
    // own, which is what made the old key unable to hit at any interesting rate.
    Pfx_Memo_Mask:          u16,        // vertical scan: slots the memoized all-hits result covers
    Cs_Memo_Mask:           u16,        // horizontal scan: ditto

    // Art staging — one ZX0-form art page decodes here before its staging->VRAM
    // DMA lands (P2b). DEDICATED buffer (2048 B): steady-state page-in streams
    // during gameplay, so it can no longer overlay live tile-cache RAM the way the
    // init-only alias did. A single staging slot (the landing handshake serialises
    // decode vs DMA — see engine/level/page_in.emp).
    // -- Residency cache tables (P2b Task 6, engine.page_cache) --
    // lower_ram (not the tight upper .w window): both are indexed base+offset
    // arrays (the hot copy-loop patch leas a base register regardless of region,
    // so .w-addressability buys nothing) and together they are ~408 B. The hot
    // scalars (free head, stall flag) live in upper_ram instead — see there.
    // Residency tables PLACED BEFORE Art_Staging_Buffer (defense-in-depth): the
    // staging buffer is the decode target. No decode path is known to write past the
    // 2048 boundary — the chain-65 corruption was PageCache_Publish's stale-offset
    // write, since fixed, not a sliced-path overrun — but keeping staging LAST in the
    // region means any hypothetical over-decode spills into the unused
    // Lower_RAM_End..region-end gap instead of corrupting Page_Table's low entries.
    Page_Table:     [u8; PAGE_TABLE_MAX],                                   // 256 bytes — page id -> frame idx / PAGE_NOT_RESIDENT
    Page_Frames:    [PageFrame; PAGE_FRAMES_MAX],                           // CAPACITY-sized (15 × 8 = 120 B), NOT count-sized:
                                                                            // a pool resize must not move RAM (2026-08-11 ruling —
                                                                            // see PAGE_FRAMES_MAX in engine/system/constants.emp).
                                                                            // Runtime walks bound by PAGE_FRAMES; tail slots idle.
    Page_Queued_Bits: [u8; PAGE_TABLE_MAX / 8],                             // 32 bytes — "page already in the request FIFO" bitset (PageCache_Request dedupe)

    // Art staging LAST in lower_ram (defense-in-depth): a hypothetical over-decode
    // would spill into the free gap after Lower_RAM_End, never into the residency
    // tables above.
    Art_Staging_Buffer: [u8; ART_STAGING_BUFFER_SIZE],                      // 2048 bytes (64-tile page)

    mark Lower_RAM_End,
}

// -----------------------------------------------
// Upper RAM — hot data (.w addressing)
// -----------------------------------------------
pub vars upper_ram {
    mark RAM_Start,

    // --- System ---
    VBlank_Flag:            u8,
    pad(1),
    Frame_Counter:          u16,
    Logic_Tick:             u32,        // logic-TICK counter (game loop, post-VSync) —
                                        // lag-immune, unlike Frame_Counter (VBlank count).
                                        // The replay/determinism timebase (spec 2026-08-02).
    Game_State:             u32,
    Game_State_ID:          u8,
    Game_State_Init:        u8,

    // --- VDP Shadow Table (§0.4) ---
    VDP_Shadow_Table:       [u8; sizeof(VdpShadow)],
    pad(1),                             // pad to even (sizeof(VdpShadow) is 19 = odd)

    // --- Interrupt dispatch ---
    // HBlank dispatch runs through HBlank_Vector_Slot (defined at the RAM tail — so
    // its addition ripples zero existing upper-RAM addresses). This reserved word
    // holds that layout stable.
    pad(4),                             // reserved (interrupt dispatch)

    // --- Region detection (§0.8) ---
    // NTSC-only product ruling (2026-08-02, B): the PAL fixed-timestep fields
    // (Timing_Step/Frame_Accumulator) had zero readers and were deleted. The
    // region-adaptive DMA budget (written at boot from Region_Flags) stays live.
    Hardware_Region:        u8,
    Region_Flags:           u8,

    // --- Controllers ---
    Ctrl_1_Held:            u8,
    Ctrl_1_Press:           u8,         // tick-stable: latched by VInt_Level, consumed by game logic
    Ctrl_2_Held:            u8,
    Ctrl_2_Press:           u8,
    Ctrl_1_Press_Accum:     u8,         // edges OR'd here by EVERY VBlank (incl. lag)
    Ctrl_2_Press_Accum:     u8,         // latched into Ctrl_*_Press by the non-lag handler

    // 6-button extension (2026-08-02 input parcel): MXYZ nibble per pad
    // (0 on a 3-button pad) + per-frame-refreshed pad type. Same
    // accumulate/latch discipline as the main bytes.
    Ctrl_1_Ext_Held:        u8,         // 0000MXYZ
    Ctrl_1_Ext_Press:       u8,         // tick-stable (latched like Ctrl_1_Press)
    Ctrl_2_Ext_Held:        u8,
    Ctrl_2_Ext_Press:       u8,
    Ctrl_1_Ext_Press_Accum: u8,
    Ctrl_2_Ext_Press_Accum: u8,
    Pad_1_Type:             u8,         // PAD_3BTN / PAD_6BTN (re-detected EVERY frame)
    Pad_2_Type:             u8,

    // --- Replay (engine/system/replay.emp — spec 2026-08-02) ---
    // Live cells: sit adjacent to the controller block so the input state reads as
    // one region. INPUT_LIVE (0, boot-clear default) makes Input_Tick a no-op.
    Input_Source:           u8,         // INPUT_LIVE / INPUT_PLAYBACK / INPUT_RECORD
    Replay_Exit_Request:    u8,         // live Start pressed during playback (game polls; NEVER merged into Ctrl)
    Replay_Done:            u8,         // stream ended (playback) or ring full (record)
    Replay_Hold:            u8,         // remaining ticks of the current RLE run (hold_minus_1 semantics)
    Replay_Prev:            u8,         // previous tick's STREAM byte (press-edge derivation, never the live pad)
    pad(1),
    Replay_Ptr:             u32,        // current stream position (ROM)

    // --- RNG ---
    RNG_Seed:               u32,

    // --- VBlank dispatch (§1 — VDP Pipeline) ---
    VInt_Ptr:               u32,        // pointer to current VBlank handler
    VBlank_Ready:           u8,         // set by main loop, cleared by VBlank
    pad(1),

    // --- DMA Queue (§1.1) — three priority sub-queues, contiguous in memory ---
    mark DMA_Queue,
    DMA_Critical:           [u8; DMA_CRITICAL_SLOTS * sizeof(DMAEntry)],
    mark DMA_Critical_End,
    DMA_Important:          [u8; DMA_IMPORTANT_SLOTS * sizeof(DMAEntry)],
    mark DMA_Important_End,
    DMA_Deferrable:         [u8; DMA_DEFERRABLE_SLOTS * sizeof(DMAEntry)],
    mark DMA_Deferrable_End,
    mark DMA_Queue_End,

    DMA_Critical_Slot:      u16,        // next free Critical slot
    DMA_Important_Slot:     u16,        // next free Important slot
    DMA_Deferrable_Slot:    u16,        // next free Deferrable slot

    DMA_Budget_Default:     u16,        // per-frame byte budget (set at boot)
    DMA_Budget_Remaining:   u16,        // remaining bytes this frame
    DMA_Enq_Bytes_Frame:    u16,        // Vectorman dual cap (P2c Task 8): running enqueue-side byte
                                        // total this frame, reset in VInt_Level beside
                                        // DMA_Budget_Remaining. Every QueueDMA_* enqueue charges it;
                                        // over DMA_ENQ_BYTE_CAP -> enqueue rejected (carry) like a full queue.

    // --- RAM Buffers and Dirty Flags (§1.3) ---
    Palette_Buffer:         [u8; 128],  // 4 lines × 32 bytes
    Palette_Dirty:          u8,         // bits 0-3 = per-line dirty
    pad(1),

    Sprite_Table_Buffer:    [u8; 640],  // 80 entries × 8 bytes
    Sprite_Table_Dirty:     u8,
    Sprite_Emit_Active:     u8,         // NEW-3 bracket: main loop is inside
                                        // Render_Sprites — buffer/length are
                                        // mid-mutation; IRQ6 must not ship a
                                        // drop-retained dirty against them

    Hscroll_Buffer:         [u8; 896],  // 224 lines × 4 bytes (FG + BG)
    pad(2),                             // reserved (pad)

    Vscroll_Factor:         u32,        // FG word + BG word

    // --- Parallax state (§4.6) — `104 + 28 * MAX_PARALLAX_BANDS` bytes at the shipped
    // capability set (BAND_EXT_N 0, BAND_CURVE_N 1, BAND_DRIFT_N 0): 552 B at MAX 16, up
    // from 328 B at MAX 8 (+224 on 2026-08-27). ---
    // (104 ceiling-independent = 3 phase words + vscroll word + 2 config longs +
    //  4 transition/section bytes + 80 B column buf + 4 B curve carry. 28 per band =
    //  2 current-scroll words + a 20 B shadow band + 2 shadow-scroll words.
    //  RAISING BAND_DRIFT_N TO 1 TAKES THE PER-BAND TERM TO 36 and the span to 680 B at
    //  MAX 16 (+128): +4 for the widened shadow band and +4 for the accumulator long. Both
    //  terms are capability-sized, so a game that declares no drift pays zero.
    //  Marked by Parallax_State/_End; PARALLAX_STATE_LONGS in parallax.emp is the
    //  clear-count mirror and its drift `ensure` checks it against this span.)
    mark Parallax_State,
    Parallax_Deform_Phase_FG:    u16,   // (frame_counter * speed_fg) & $FF
    Parallax_Deform_Phase_BG:    u16,
    Parallax_V_Deform_Phase_BG:  u16,   // for animated per-column V-scroll
    Parallax_Current_Scroll_A:   [u16; MAX_PARALLAX_BANDS],  // lerp accumulators, Plane A
    Parallax_Current_Scroll_B:   [u16; MAX_PARALLAX_BANDS],  // Plane B
    Parallax_Current_Vscroll_BG: u16,
    Parallax_Current_Config:     u32,   // ptr to active parallax_config
    Parallax_Target_Config:      u32,   // ptr to incoming during transition
    Parallax_Transition_Frames:  u8,    // frames remaining; 0 = stable
    Parallax_Snap_Pending:       u8,    // 1 = next Update writes target_scroll directly to current (skip lerp)
    // Per-section parallax: section grid coords under the camera centre on the
    // previous frame. A change in either is a section-boundary crossing, which
    // re-selects the active config via Parallax_CheckBoundary. Seeded to $FF in
    // Parallax_Init so the first frame always re-selects.
    Parallax_Prev_Sec_X:         u8,
    Parallax_Prev_Sec_Y:         u8,
    Parallax_Vscroll_Column_Buf: [u8; 80],  // 40 VSRAM entries × 2 bytes
    // Per-frame screen-space band view (Step 4a): the config's plane-space band
    // list rotated by Vscroll_BG, tops rebased to screen cells. Fillers consume
    // this (or the config's own arrays when vshift = 0).
    // The curve fill's cross-band carry (P3 Task 10): [0] the last curve entry's final
    // accumulator, [1] its final Bresenham error. An anchored split resumes from these so
    // the ramp runs THROUGH the boundary instead of restarting at it. Zero words — and zero
    // bytes — in a game that declares no curves.
    // The band-drift accumulators: ONE 16.16 long PER BAND, laid out [pixels:i16][fraction:u16]
    // with the pixels in the HIGH word, indexed by CONFIG BAND INDEX exactly as
    // Parallax_Current_Scroll_A/_B above are. It CANNOT live in the shadow band record: that
    // view is re-copied from ROM every frame AND rotated, so an accumulator there would be
    // both wiped and mis-attributed (engine/level/parallax.emp's band_drift banner has the
    // two-reason derivation). Zero longs — and zero bytes — in a game that declares no drift.
    //
    // PLACED IMMEDIATELY BEFORE Parallax_Curve_Carry ON PURPOSE. parallax.emp pins both arrays
    // by ADJACENT-SYMBOL DIFFERENCE (Curve_Carry - Drift_Acc, and Shadow_Bands - Curve_Carry),
    // which is what lets a short reservation name ITSELF instead of only failing the total.
    // Inserting a field between any two of these three breaks the pin it splits.
    Parallax_Drift_Acc:          [u32; DRIFT_ACC_LONGS * MAX_PARALLAX_BANDS],
    Parallax_Curve_Carry:        [u16; CURVE_CARRY_WORDS],
    Parallax_Shadow_Bands:       [u8; (BAND_ENTRY_LEN + BAND_EXT_BYTES + BAND_CURVE_BYTES + BAND_DRIFT_BYTES) * MAX_PARALLAX_BANDS],
    Parallax_Shadow_Scroll_A:    [u16; MAX_PARALLAX_BANDS],
    Parallax_Shadow_Scroll_B:    [u16; MAX_PARALLAX_BANDS],
    mark Parallax_State_End,

    // --- Raster state (effects P1) — the sparse HInt dispatcher's working set
    // (engine/effects/raster.emp). Its span is cross-checked there by an
    // `ensure` against RASTER_STATE_SIZE, so a drift on either side fails the
    // build. RASTER_BUF_SIZE is mirrored here as a literal because ram.emp
    // cannot import a CODE module's consts (same constraint bg_anim.emp
    // documents at BGANIM_MAX_BANDS); raster.emp is the authority.
    mark Raster_State,
    Raster_Program:     u32,        // installed compiled program (0 = none)
    Raster_Cursor:      u32,        // HInt walk cursor into the active buffer
    Raster_Pending:     u32,        // staged by Raster_Install, consumed at VBlank
    Raster_Line:        u16,        // line the cursor's next entry group starts at
    Raster_Buf_A:       [u8; 128],  // working copy (active)       — RASTER_BUF_SIZE
    Raster_Buf_B:       [u8; 128],  // working copy (P2 patch seam) — RASTER_BUF_SIZE
    Raster_Active_Buf:  u32,        // -> Raster_Buf_A or Raster_Buf_B
    // Dense-run state (effects P2 Task 5) — OP_RUN_GRADIENT switches the handler into a
    // per-line MODE: while Raster_Dense_Mode != 0 the handler bypasses the record walk,
    // writes Raster_Dense_Cmd + a per-line payload, and re-arms reg $0A=0.
    //
    // THE ACTIVE FLAG IS Raster_Dense_Mode, NOT THIS COUNTER (Tier-3 item 3, 2026-08-19).
    // It used to be `Raster_Dense_Lines != 0`, with a SECOND word read per scanline to pick
    // the body. One word answers both questions now; see Mode's note below.
    Raster_Dense_Lines:  u16,       // scanlines remaining; counts down, meaningful only
                                    // while Raster_Dense_Mode != 0
    Raster_Dense_Cursor: u32,       // ROM stream cursor (3 words/line) for the run
    Raster_Dense_Cmd:    u32,       // constant CRAM write command for every line of the run
    // The single-channel water slot that used to sit here (Raster_Water_Line, the derived
    // screen row, and Raster_Water_World_Y, the authored world Y) is DELETED in effects-P3
    // P-b. Its authored half generalised into Effects_World_Y[] below — one anchor per patch
    // channel instead of one per PROGRAM — and its derived half is not stored at all any
    // more: Raster_BuildSchedule recomputes each screen line into a register and consumes it in
    // the same breath, so there is no derived cell left to go stale against the camera.

    // --- Dense RAMP state (OP_RUN_RAMP). The dense tier's second body: instead of
    // streaming three baked words per line it COMPUTES one word per line from a 16.16
    // accumulator, which is what makes a dense effect parameterisable at RUNTIME rather
    // than frozen in ROM. Five reference engines converged on exactly this shape (Ristar's
    // perspective floor, Vectorman's table-free scaler, Gunstar, Alien Soldier, TF4).
    //
    // Acc and Step are the RUNTIME PARAMETERS: a game may rewrite them any frame to
    // animate the ramp, which no ROM-streamed gradient can do. Mode selects which body
    // runs, because both share Raster_Dense_Lines/Cmd and the every-line arm.
    //
    // MODE IS TRI-STATE, AND THAT IS THE WHOLE OF TIER-3 ITEM 3 (2026-08-19). It used to be
    // a two-state `Raster_Dense_Kind` (0 gradient / 1 ramp) sitting BESIDE a separate
    // run-active test on Raster_Dense_Lines, so `Raster_HInt` read two RAM words and took
    // two branches on every scanline of a run to answer one question. Folding "is a run
    // active" and "which body" into one signed word answers both from a single `tst.w`:
    // the top-of-handler test is unchanged in shape and cost (so the SPARSE fire base does
    // not move), and the dense side pays one `bmi.s` where it used to pay a whole second
    // load and branch. The counter reaching 0 is what clears this word.
    Raster_Dense_Mode:  u16,        // 0 = no run · +1 = gradient (stream) · -1 = ramp (compute)
    Raster_Ramp_Acc:    u32,        // 16.16 accumulator; high word is the emitted value
    Raster_Ramp_Step:   u32,        // 16.16 per-line delta, signed

    // --- The patch channel bank (effects P3 Parcel P-b) -----------------------
    // One authored world Y per patchable raster channel. Raster_BuildSchedule derives each
    // boundary's screen line as world_y - Camera_Y every VBlank, so a boundary stays on a
    // place in the LEVEL rather than at a fixed height on the display.
    //
    // NAMED FOR EFFECTS, NOT RASTER, deliberately. Parcel W gives the world anchor an
    // owner, and the parallax deformation system is expected to become a second READER of
    // these same values (a complete underwater section is a palette boundary AND a shimmer
    // at the same line). Naming them Raster_* would force W to relocate storage rather than
    // simply add a reader — the difference between a re-cut and an addition.
    //
    // They live in RAM, not in the preset's ROM array, because that is what makes them
    // MOVABLE: rising lava, a flood line and a beat-driven pulse all rewrite an anchor at
    // runtime through Effects_SetWorldY. The preset's inline array is the seed, not the
    // storage. Re-entering a section therefore RESETS an animated anchor to its authored
    // value — a declared delta, matching the OP_RUN_RAMP seed philosophy above.
    // The 4 MIRRORS RASTER_MAX_PATCH as a literal, and must: ram.emp is built by a separate
    // ram-harvest pass that is OUTSIDE the COMPTIME_HELPERS glob injection, so naming the
    // constant here fails with `unknown name RASTER_MAX_PATCH` (measured 2026-08-15). Same
    // rule the palette block below documents. raster.emp is the authority, and its
    // RASTER_STATE_SIZE ensure measures the real emitted span of this region, so a drift
    // between this literal and the constant fails the build there rather than going quiet.
    Effects_World_Y:    [u16; 4],

    // The LATCHED, UNCLAMPED screen line of each patch channel: world_y - Camera_Y, signed,
    // recomputed once per frame in the MAIN LOOP (Effects_LatchWorldLines) after Camera_Update
    // and before Parallax_Update.
    //
    // IT EXISTS TO BE THE ONLY DERIVATION OF L. Three places used to compute anchor - Camera_Y
    // independently: Raster_BuildSchedule in VBlank, the parallax overlay in the main loop, and now
    // the frame-top ship. On a VInt_Lag frame VBlank runs twice against one main-loop update, so
    // independent derivations put the fire line and the boundary state on DIFFERENT cameras and
    // every transition pops. One latch, three readers, one camera.
    //
    // UNCLAMPED IS THE WHOLE POINT. Raster_BuildSchedule clamps the fire line into the record's
    // authored band because a negative inter-record gap stores as $FF, which IS the park word and
    // would kill every later fire in the frame. That clamp is load-bearing and stays — but it also
    // means the fire line cannot express "the boundary is above the screen", which is exactly the
    // state the off-screen ship responds to. These are the values the clamp cannot see.
    //
    // The 4 mirrors RASTER_MAX_PATCH as a literal, for the ram-harvest reason above.
    Effects_Screen_L:   [u16; 4],

    // -> the live program's off-screen ship entry (the 14-byte DMAEntry inside its ROM trailer),
    // or 0 when the installed program declares none. Written UNCONDITIONALLY by every preset
    // install, which is what keeps it from becoming a side channel: a cell that is a pure
    // function of the installed program cannot express "the previous section's effect survived".
    Effects_Offscreen_Entry: u32,

    // -> the ROM patch table, at (patched template + RASTER_BUF_SIZE).
    //
    // ZERO MEANS "no patched program is live", and this is the ONLY liveness test
    // Raster_BuildSchedule may use. Raster_Active_Buf is NOT a substitute: Raster_VBlank's
    // explicit-clear path zeroes Raster_Program and idles the trampoline but never touches
    // Active_Buf, so after a Raster_Install(0) following a patched section Active_Buf still
    // reads Buf_B forever — and an Active_Buf-gated patcher would go on writing bytes into a
    // dead buffer every frame. Latent today only because the preset path installs
    // Raster_Program_None rather than 0.
    Raster_Patch_Tab:   u32,
    mark Raster_State_End,

    // --- Palette engine state (effects P2) — the composition pipeline's working
    // set (engine/effects/palette.emp). Its span is cross-checked there by an
    // `ensure` against PALETTE_STATE_SIZE, so a drift on either side fails the
    // build. The named sizes below are mirrored as literals because ram.emp cannot
    // import a CODE module's consts (the Raster_State constraint above documents
    // the same rule); palette.emp is the authority.
    //
    // The pipeline (design suite §5): base -> cycling -> cross-fade -> operators
    // -> variants, composed once per frame into Palette_Buffer. Pal_Composed is
    // DELIBERATELY ELIDED (plan Task 1 Step 1 option): the compose writes straight
    // into Palette_Buffer lines 1-3 and the variant derive reads Palette_Buffer as
    // "the live composed palette", so no separate pre-variant image is kept. Only
    // Base/Target survive here (the two cross-fade endpoints). Saves 128 B + a copy.
    //
    // Everything the engine writes is LINES 1-3 ONLY (96 bytes) — line 0 is the
    // character's (Player_ApplyCharacter / CharacterDef.cd_palette). No field here
    // is ever indexed to a line-0 byte; the compose ORs at most %1110 into
    // Palette_Dirty. This is the P1 invariant the Knuckles palette round-trip needs.
    mark Palette_State,
    Pal_Base:           [u8; 96],   // section palette lines 1-3 — cross-fade source A / static base
    Pal_Target:         [u8; 96],   // incoming section palette lines 1-3 — cross-fade source B
    // Variant derive staging — PAL_MAX_VARIANTS slots of a full 128-byte 4-line
    // image each; the derive fills the covered lines at their natural line*32
    // offset, and OP_PAL_REGION's build-time source pointer indexes straight in
    // (Pal_Variant_Stage + slot*128 + line*32 + entry*2). Pre-derived at frame time
    // because a 16-colour derive is ~far beyond the ~60-cycle HBlank budget.
    Pal_Variant_Stage:  [u8; 128 * 2],  // PAL_MAX_VARIANTS(2) x 128
    Pal_Variant_Ptr:    [u32; 2],   // PAL_MAX_VARIANTS active pal_variant* (0 = slot idle)
    Pal_Cycle_Script:   u32,        // active sec_pal_cycle script (0 = none)
    Pal_Cycle_Timers:   [u8; 4],    // PAL_CYCLE_MAX_CHANNELS per-channel frame countdown
    Pal_Fade_Frames:    u8,         // cross-fade frames remaining (0 = stable)
    Pal_Op:             u8,         // active global operator (PAL_OP_*; 0 = none)
    Pal_Op_Step:        u8,         // operator progress / component step
    Pal_Op_Timer:       u8,         // operator flicker/step cadence countdown
    Pal_Active:         u8,         // any-layer summary: 0 = Palette_Compose early-outs (one compare)
    Pal_Base_Dirty:     u8,         // 1 = a fresh base was loaded; compose copies it in once
    Pal_Compose_Lines:  u8,         // lines (bits 1-3) the pending base touched -> Palette_Dirty
    Pal_Fade_Request:   u8,         // one-shot: next Palette_LoadSection cross-fades (loads Target) not snaps (loads Base)
    mark Palette_State_End,

    // Driver-keyed BG tile-band animation (engine/level/bg_anim.emp)
    BgAnim_LastStep:        [u16; BGANIM_MAX_BANDS],  // per band: last DMA'd step; -1 = none yet

    // --- Static DMA Entries (§1.5) — pre-computed 14-byte entries for fixed transfers ---
    Static_Pal_Line0:       [u8; sizeof(DMAEntry)],
    Static_Pal_Line1:       [u8; sizeof(DMAEntry)],
    Static_Pal_Line2:       [u8; sizeof(DMAEntry)],
    // The off-screen ship's entry (engine.effects.raster). Unlike its neighbours it is NOT
    // built at boot: its source, length and destination come from the installed patched
    // program's ROM trailer, so Raster_InstallPatched rebuilds it on every install. It lives
    // here rather than beside the raster state because it is a DMAEntry like the rest of this
    // block, built by the same one builder.
    Static_Pal_Ship:        [u8; sizeof(DMAEntry)],
    Static_Pal_Line3:       [u8; sizeof(DMAEntry)],
    Static_Sprite_DMA:      [u8; sizeof(DMAEntry)],
    Static_Hscroll_Line:    [u8; sizeof(DMAEntry)],   // §4.6 — 896-byte HScroll table (the one layout; per-cell twin deleted 2026-08-26, d-29-corrected)

    // --- Debug profiling (§1.7) — zero in release builds ---
    if DEBUG == 1 @shape_divergent {
        DMA_Bytes_ThisFrame:    u16,
        DMA_Peak_Critical:      u16,
        DMA_Peak_Important:     u16,
        DMA_Peak_Deferrable:    u16,
        DMA_Overflow_Count:     u16,
        Dbg_DMA_Enq_Capped:     u16,    // enqueues rejected by the byte cap (P2c Task 8); 0 in normal play
        Lag_Frame_Count:        u32,

        Prof_RunObjects:        u16,    // V counter lines spent in RunObjects
        Prof_TouchResponse:     u16,    // V counter lines spent in TouchResponse
        Prof_RenderSprites:     u16,    // V counter lines spent in Render_Sprites
        Prof_FrameTotal:        u16,    // V counter lines for full game loop
        Prof_Peak_RunObjects:   u16,    // peak RunObjects across all frames
        Prof_Peak_Touch:        u16,    // peak TouchResponse
        Prof_Peak_Render:       u16,    // peak Render_Sprites
        Prof_Peak_Frame:        u16,    // peak full frame
        Prof_Dynamic_Used:      u16,    // dynamic slots in use this frame
        Prof_Effect_Used:       u16,    // effect slots in use this frame

        // Debug harness: scene-pin flag. Nonzero = GameState_OJZScroll_Update
        // skips Camera_Update + EntityWindow_Scan so a write_memory camera+ring
        // scene survives (R-A1 ring-cull boundary verification).
        Debug_Scene_Freeze:     u8,     // 0 = normal, nonzero = pin OJZScroll scene
        pad(1),                         // pad to even (keep the DEBUG block word-aligned)

        // --- Art-streaming P2a page-in instrumentation (survey §5) ---
        // Defined in Task 2; the VBlank bookmark bumps Preempts, PageIn_Flush bumps
        // Flushes, a suspended-decode re-entry bumps Resumes.
        Dbg_PageIn_Preempts:    u16,    // bookmark redirects (decode sliced by a VBlank)
        Dbg_PageIn_Flushes:     u16,    // PageIn_Flush cancellations
        Dbg_PageIn_Resumes:     u16,    // suspended-decode re-entries

        // --- Residency-cache instrumentation + audit (P2b Task 6) ---
        Dbg_PageCache_Demands:  u16,    // PageCache_Request(demand) enqueues (0 in Task 6 — pool resident)
        // --- Prefetch + D3-gate instrumentation (P2b Task 7) ---
        Dbg_PageCache_Prefetches: u16,  // PageCache_Request(prefetch) enqueues (page prefetch warms the ahead strip)
        Dbg_PageIn_PfxSkips:    u16,    // speculative decode STARTS skipped by the D3 trailing-lag gate
        Dbg_PageIn_Deferred:    u16,    // page landings deferred by the per-act art budget (P2c Task 9); 0 in normal play
        Dbg_Cam_Clamp_Frames:   u16,    // frames the camera soft-clamp held an axis (P2c Task 10); 0 in normal play
        // Chain-70 soak diagnostic: dispatch found PageIn_Pool_Table != the immutable act
        // descriptor's base -> a stray write corrupted the cached base. Nonzero CONFIRMS
        // the root cause (the resolve now derives the base from ROM, so gameplay is
        // unaffected; this counts how often the cache was found stale).
        Dbg_PageIn_BaseCorrupt: u16,
        // Chain-74 demand-stall watchdog: consecutive frames Cache_Art_Stall has stayed
        // set (fill demand-stalled and never resolved). Tile_Cache_Fill raise_errors at
        // STALL_WATCHDOG_FRAMES so a working-set-exceeds-dynamic-frames livelock is LOUD,
        // not a silent black hang. Reset to 0 the first frame the fill does not stall.
        Cache_Stall_Watchdog:   u16,
        Page_Audit_Ticks:       u16,    // LOGIC TICKS since the last during-play refcount audit (PageCache_AuditTick)
        Page_Audit_Scratch:     [u16; PAGE_FRAMES_MAX],   // per-frame refcount recomputed from the nametable (audit).
                                                          // CAPACITY-sized like Page_Frames — this array shrinking by
                                                          // 2 B is exactly what slid every debug cell below it (incl.
                                                          // the free stacks) by -2 and desynced the replay fixtures
                                                          // on the 2026-08-11 pool resize.
        // Ground-truth snapshot the audit fills at entry, so a red-screen freezes a
        // compact readable copy of the residency map (Task-6 mapping-bug debug):
        //   [0]=Page_Free_Head [1]=[2]=$FF reserved (dead LRU heads) [3]=pad
        //   [4..4+16)   = Page_Table[0..15]           (page -> frame)
        //   [20..20+30) = per frame 0..14: pf_page.lo, pf_flags  (2 bytes each)
        Page_Audit_Snapshot:    [u8; 52],
    }

    // --- Object System (§3) ---
    // Object RAM — all slots contiguous, stride = sizeof(Sst) ($50). Reserved
    // tracked-entity slots — engine camera/rings/collision address slot 0/1
    // directly; the game's player code claims them at spawn.
    mark Object_RAM,
    Player_1:               Sst,
    Player_2:               Sst,
    Dynamic_Slots:          [Sst; NUM_DYNAMIC],
    System_Slots:           [Sst; NUM_SYSTEM],
    Effect_Slots:           [Sst; NUM_EFFECTS],
    mark Object_RAM_End,

    // Free slot stacks — word arrays of SST addresses, one per pool
    Dynamic_Free_Stack:     [u16; NUM_DYNAMIC],
    Dynamic_Free_SP:        u16,

    Effect_Free_Stack:      [u16; NUM_EFFECTS],
    Effect_Free_SP:         u16,

    // --- Sprite Rendering (§3.5) ---
    // Priority band lists — each band holds up to SPRITES_PER_BAND object addresses
    Sprite_Bands:           [u16; SPRITES_PER_BAND * PRIORITY_BANDS],
    Sprite_Band_Counts:     [u8; PRIORITY_BANDS],
    pad(PRIORITY_BANDS & 1),            // computed: 0 today (PRIORITY_BANDS=8, even).
                                        // Was a comment asserting "already even — no pad
                                        // needed"; an odd band count would have silently
                                        // address-errored the words below.

    Sprites_Rendered:       u16,        // total sprites rendered this frame
    Sprite_Cycle_Counter:   u16,        // link-order cycling frame counter

    // Sprite X=0 masking configuration. Set SpriteMask_Y to VDP Y (screen Y + 128)
    // and SpriteMask_Height to scanlines to mask; SpriteMask_After_Band = band
    // index after which mask sprites insert. SpriteMask_Y = 0 disables masking.
    SpriteMask_Y:           u16,        // VDP Y position of mask top (0 = disabled)
    SpriteMask_Height:      u16,        // scanlines to cover
    SpriteMask_After_Band:  u8,         // insert after this band (0-7)
    pad(1),

    // Scanline band sprite budgeting (§3.5) — 7 bands of 32 scanlines
    Scanline_Band_Sprites:  [u8; SCANLINE_BANDS],
    pad(SCANLINE_BANDS & 1),            // computed: 1 today (SCANLINE_BANDS=7, odd).
                                        // Was a fixed `1` that silently assumed an odd
                                        // band count — an even one would have shifted
                                        // every field below by 1.

    // --- Camera (stub for §3, real implementation in §4) ---
    Camera_X:               u32,        // 16.16 camera X position
    Camera_Y:               u32,        // 16.16 camera Y position

    // Frame-constant biased camera (Render_Sprites): Camera_{X,Y} integer minus the
    // VDP +128 SAT offset, computed once per render frame so the Emit loops drop
    // the per-piece `addi #128`. Integer words only.
    Camera_X_Biased:        u16,        // Camera_X(int) - VDP_SPRITE_X_OFFSET
    Camera_Y_Biased:        u16,        // Camera_Y(int) - VDP_SPRITE_Y_OFFSET

    Game_Paused:            u8,         // game pause / freeze flag
    pad(1),

    // --- Level System (§4) ---
    // Deferred plane write buffer — game loop appends, VBlank drains
    Plane_Buffer:           [u8; PLANE_BUFFER_SIZE],   // 1536 bytes
    Plane_Buffer_Ptr:       u16,        // byte offset (0 = empty)

    // Camera position history — 64 frames × 4 bytes (X.w, Y.w)
    Pos_table:              [u8; 256],
    H_scroll_frame_offset:  u8,         // camera lag depth (0 = no lag)
    pad(1),

    // Camera parameters
    Camera_Deadzone_Base:   u16,        // base deadzone width in pixels
    Camera_Lookahead:       u16,        // zone-default lookahead pixels
    Camera_Pan_Offset:      u16,        // current extended lookahead pan
    Camera_X_Max:           u16,        // per-act clamp ceiling: (grid_w << SECTION_SIZE_SHIFT) - SCREEN_WIDTH
    Camera_Y_Max:           u16,        // per-act clamp ceiling: (grid_h << SECTION_SIZE_SHIFT) - SCREEN_HEIGHT

    // The LEADER: a POINTER to the SST the camera follows (and that the game's
    // other leader-following systems track — path swap today). One indirection
    // replaces every hardwired `lea Player_1`, so a roster where slot 0 is not
    // the followed character needs no engine change: the level init writes this
    // cell and everything downstream agrees.
    //
    // A WORD, not a long: every SST lives in upper_ram ($FFFF8000+), so bit 15
    // is set and `movea.w Camera_Target, aN` sign-extends to the right address —
    // the same idiom Sprite_Bands and the free stacks already use for SST
    // addresses, and half the storage of a long.
    //
    // That premise is STRUCTURALLY enforced, not assumed: the whole SST pool
    // (Object_RAM .. Object_RAM_End above — Player_1/2, Dynamic, System, Effect)
    // is a field run of THIS region, and the region carries `w_addressable`,
    // which the compiler checks across its entire `[base, limit)` window
    // ([region.not-w-addressable]). Moving the pool out of a `.w`-addressable
    // region therefore fails the build before this read can go wrong; no
    // separate `ensure` is needed here. (The game-side twin in
    // games/sonic4/player_common.emp — `ensure((extern("Player_1") &
    // $FFFF8000) == $FFFF8000)` for its `cmpa.w` sites — exists because a GAME
    // module cannot see this region declaration, not because the property is
    // unenforced.)
    //
    // It is engine RAM (not game RAM) because engine.camera reads it
    // unconditionally, and engine.camera is compiled into EVERY game — including
    // `demo`, which defines no game-side player symbols at all (that is exactly
    // why the landing-lock probe below it is comptime-gated on
    // Game.CAMERA_JUMP_LOCK). A game-RAM home fails the demo link outright.
    //
    // NOT boot-safe by default: Work-RAM boot-clears to 0, and 0 is not a valid
    // SST — it is a null pointer into the vector table, not a benign "slot 0".
    // Level init MUST seed it before the first Camera_Update.
    Camera_Target:          u16,        // leader SST pointer (word, sign-extended)

    // How far Camera_Update lifts the tracked point while Camera_Target is
    // CURLED (its ST_ROLLING bit set) — the pixels a game's curl displaces the
    // SST origin by, so the camera keeps following the same body point across a
    // curl instead of stepping by the difference.
    //
    // ENGINE OWNS THE CELL, THE GAME FILLS IT. The number is a property of the
    // game's character (Sonic curls by 5px, Tails by 1 — S3K derives it per
    // character as `y_radius - default_y_radius`), so the engine cannot compute
    // it; but engine.camera reads it unconditionally and is compiled into EVERY
    // game, so it cannot live in game RAM either. That is the same bind
    // Camera_Target is in, and this is the same answer — which is deliberately
    // NOT the answer the landing lock gives just below it: reaching into a game
    // symbol behind a Game.* comptime gate works, but every such hole has to be
    // gated again for `demo`'s sake, and a cell needs no gate at all.
    //
    // Sonic 4 writes it in Player_RefreshPhysics — the chokepoint every
    // Player_Chardef write passes through — from the active record's two box
    // heights, the same derivation its curl hooks and ceiling probes use.
    //
    // BOOT-SAFE, unlike Camera_Target: Work-RAM clears to 0 and 0 means "this
    // game's tracked object does not curl", which is the correct answer for a
    // game that never sets ST_ROLLING (`demo`) and unreachable for one that
    // does — the bit is set by the player's own state machine, which cannot
    // have run before the character was resolved.
    Camera_Curl_Offset:     u16,        // px lifted while the target is curled (0 = no curl)

    Camera_Hold_Frames:     u8,         // frames the camera holds position (game code sets it;
                                        // Camera_Update tests it each frame to suppress movement,
                                        // then decrements)
    Camera_Art_Hold:        u8,         // art-streaming soft-clamp bits (P2c Task 10): bit
                                        // ART_HOLD_X_BIT / ART_HOLD_Y_BIT held while a demand-stalled
                                        // fill leaves not-yet-resident art near the visible edge on
                                        // that axis. tile_cache sets (per axis) at its stall sites and
                                        // clears the whole word each fill pass; Camera_Update zeroes a
                                        // held axis' step. 0 in normal play (OJZ working set == pool).

    // --- 2D Tile Cache metadata (§4.7 — .w addressable) ---
    Cache_Left_Col:         u16,        // world tile col of leftmost valid column
    Cache_Head_Col:         u16,        // world tile col of rightmost valid column
    Cache_Top_Row:          u16,        // world tile row of topmost valid row
    Cache_Bottom_Row:       u16,        // world tile row of bottommost valid row
    Cache_Origin_Col:       u16,        // physical col index where Cache_Left_Col maps (circular)
    Cache_Origin_Row:       u16,        // physical row index where Cache_Top_Row maps (circular; kept even)
    Cache_Fill_Last_Frame:  u16,        // Frame_Counter of last fill (cascade prevention)
    Cache_Fill_Resume_Col:  u16,        // partial FillColumn resume column ($FFFF = none pending)
    Cache_Fill_Resume_Row:  u16,        // partial FillColumn resume row (valid when Resume_Col set)
    // Residency-cache demand stall (P2b Task 6): a copy-site word whose page is
    // NOT resident sets this (and enqueues a PageCache_Request(demand)); the fill
    // then returns partial exactly like a budget-out and resumes the same
    // column/row next frame. Cleared at Tile_Cache_Fill entry. Dormant while the
    // whole pool is resident (Task 6); Task 7 eviction exercises it.
    Cache_Art_Stall:        u16,        // nonzero = a fill stalled this frame on a non-resident page

    // --- Residency-cache hot scalar (P2b Task 6) — upper .w window; the big
    //     tables sit in lower_ram. (The LRU head/tail cells died with the
    //     linked list — F-1 stamp eviction orders candidates by pf_stamp.) ---
    Page_Free_Head:         u8,         // head of the never-assigned free-frame list / $FF
    pad(1),                             // keep the region word-aligned
    Cache_Fill_Budget:      u16,        // per-frame block decompress allowance (shared: columns + rows)
    Cache_Fill_RowResume_Row: u16,      // partial FillRow resume world row ($FFFF = none)
    Cache_Fill_RowResume_Col: u16,      // partial FillRow resume col cursor
    Cache_Fill_Rows_Left:   u16,        // rows-this-frame cap countdown (reset to VFILL_ROWS_PER_FRAME)
    Cache_Prev_Cam_Row:     u16,        // last frame's camera world tile row (vertical prefetch direction)
    // Horizontal prefetch state (unified direction-aware prefetch, §4.7).
    Cache_Prev_Cam_X:       u16,        // last frame's camera px (low word) — H prefetch delta/hysteresis
    Cache_H_Pfx_Dir:        u16,        // latched H prefetch direction (0=none, +1=right, -1=left)
    Cache_H_Pfx_Accum:      u16,        // net opposite-motion px accumulator (>=0) for the hysteresis flip
    Cache_Pfx_Row_Target:   u16,        // this-frame vertical prefetch target row ($FFFF = none) — corner input
    Cache_Pfx_Col_Target:   u16,        // this-frame horizontal prefetch target col ($FFFF = none) — corner input
    Cache_Pfx_Skip_Armed:   u16,        // 1 = prefetch skipped last frame (bound: never skip two running)
    Cache_Pfx_Lag_Flag:     u16,        // set =1 by the tile-cache frame gate when Frame_Counter advanced by
                                        // >1 since the last fill (a frame lagged — trailing detect); the
                                        // prefetch H4 gate consumes it (skip this frame if the prev lagged)

    // Block staging metadata — keys parallel to Block_Stage_Buffers slots.
    // Key format: sec_x.b | sec_y.b | block_index.w ($FFFFFFFF = empty).
    // The key's LOW BYTE is the block index and therefore also its bucket in the
    // F4 staging index (Block_Stage_Bucket, lower_ram) — TileCache_DecompressBlock's
    // unlink derives the evicted key's bucket straight from the key it is about to
    // overwrite, so the format is load-bearing for more than the compare now.
    Block_Stage_Keys:       [u32; BLOCK_STAGE_SLOTS],
    Block_Stage_Next:       u16,        // next round-robin slot to evict

    // Row streaming state (vertical)
    Section_Top_Row_Written:    u16,
    Section_Bottom_Row_Written: u16,

    // Section streaming state
    Section_Plane_Dirty:    u8,         // full plane redraw pending (level init + cache recovery)
    pad(1),                             // pad to even (Section_Plane_Dirty is 1 odd byte)

    // Column streaming state — world tile columns (Camera_X/8 domain)
    Section_Right_Col_Written: u16,     // last tile col written to nametable on the right side of view
    Section_Left_Col_Written:  u16,     // last tile col written to nametable on the left side of view

    // §4.2 preview: cached neighbor section data pointers. Set at teleport/init;
    // NULL if no neighbor exists (act boundary).
    Section_Fwd_Neighbor_Data: u32,
    Section_Bwd_Neighbor_Data: u32,

    // Dynamic tile override (16 entries × 6 bytes: col.w, row.w, new_tile.w)
    Tile_Override_Table:    [u8; 96],

    // --- Entity System (§4.9 — camera-driven sliding window) ---
    // Unified ring buffer — MAX_RING_BUFFER entries × RING_BUFFER_ENTRY_SIZE
    // (dc.w x, y; dc.b section_id, list_index). sonic4: 128 × 6 = 768 B;
    // demo: 16 × 6 = 96 B. The entry count is the game knob; the 6-byte entry
    // format is engine-owned (engine.constants).
    Ring_Buffer:            [u8; MAX_RING_BUFFER * RING_BUFFER_ENTRY_SIZE],

    // Ring count (unified) + buffer diagnostics (reset by RingBuffer_Clear at level init)
    Ring_Count:             u8,
    Ring_HighWater:         u8,         // max Ring_Count observed
    Ring_Add_Dropped:       u8,         // RingBuffer_Add failures (buffer full) — DEBUG-fatal
    pad(1),

    // Entity scan state — 4 tracked sections × EntityScanState_len bytes
    Entity_Scan_State:      [u8; MAX_TRACKED_SECTIONS * ENTITY_SCAN_STATE_LEN],

    // Ring state
    Ring_Counter:           u16,        // total collected rings (player HUD)
    Ring_Anim_Frame:        u8,         // global ring animation counter (0-3)
    Ring_Anim_Timer:        u8,         // countdown to next animation tick

    // Entity window tracking
    Entity_Window_Active:   u8,         // 4-bit entry validity mask (bit n = entry n valid)
    Entity_Window_Center_ID: u8,        // section_id of rolling bitmask center
    Entity_Window_Anchor:   [u8; 2],    // absolute (sec_x0, sec_y0) of entry 0 — slide trigger + teleport invariance
    Entity_Window_OriginX:  u16,        // column-0 origin base, world px (sec_x0 * SECTION_SIZE)
    Entity_Window_OriginY:  u16,        // row-0 origin base, world px (sec_y0 * SECTION_SIZE)
    Entity_Loaded_Masks:    [u8; MAX_TRACKED_SECTIONS * ENTITY_LOADED_SLOT_SIZE],  // 128B — per-entry ring/obj loaded bits (§4.9 ph2)
    Entity_Mask_Scratch:    [u8; 4 + MAX_TRACKED_SECTIONS * ENTITY_LOADED_SLOT_SIZE],  // 132B (even) — slide snapshot: 4 old section ids + 4×32B old masks
    Camera_Y_Coarse_Prev:   u16,        // camY & $FF80 at last vertical re-scan

    // Rolling collected/killed bitmask — COLLECTED_WINDOW_SLOTS × COLLECTED_SLOT_SIZE
    // (sonic4: 9 × 34 = 306 B; demo: 4 × 34 = 136 B). The slot count is the game
    // knob; the 34-byte stride is the engine format.
    Ring_Collected_Window:  [u8; COLLECTED_WINDOW_SLOTS * COLLECTED_SLOT_SIZE],
    // RESERVED, not an alignment pad. COLLECTED_SLOT_SIZE is even, so the region
    // above is even for ANY slot count — this contributes nothing to alignment and
    // the "pad to even" it used to claim was wrong. Kept as 2 reserved bytes rather
    // than converted to a computed `& 1` pad because a computed pad evaluates to 0
    // today and would shift every field below it by −2 (a layout change, out of
    // scope for a comment/guard parcel — reclaim it with the D7 deletion batch).
    pad(2),                             // reserved (region already even)

    // Respawn park (§4.9.4) — 4 entries × 33 bytes (byte-packed, copied bytewise)
    Ring_Collected_Park:    [u8; COLLECTED_PARK_SLOTS * COLLECTED_PARK_ENTRY_SIZE],  // 132 bytes
    pad((COLLECTED_PARK_SLOTS * COLLECTED_PARK_ENTRY_SIZE) & 1),  // pad to even (132 — none needed)
    Collected_Park_Next:    u8,         // rolling write index (0..COLLECTED_PARK_SLOTS-1)
    pad(1),                             // pad to even

    // Active level pointer
    Current_Act_Ptr:        u32,

    // --- Sound driver runtime state ---
    Ring_Sfx_Speaker:       u8,         // toggles 0/1 each ring collect; 0→LEFT, 1→RIGHT
    pad(1),                             // pad to even
    // A2 fix: 68k-side pending-SFX ring. Sound_PlaySFX enqueues here;
    // Sound_DrainSfxRing (game_loop, post-VSync) posts ONE id/frame into the
    // single-byte SND_REQ_SFX mailbox once the Z80 has cleared it, so two SFX
    // requested in one 68k frame are delivered over two frames instead of the
    // 2nd clobbering the 1st. Empty == (Rd == Wr); cleared to 0 by boot.
    Sfx_Ring_Buf:           [u8; 8],    // SFX_RING_DEPTH (sound_constants.asm) = 8 pending SFX ids
    Sfx_Ring_Wr:            u8,         // write cursor (0..SFX_RING_MASK)
    Sfx_Ring_Rd:            u8,         // read cursor  (0..SFX_RING_MASK); SFX_RING_DEPTH(8)+2 = 10 even

    // Sound driver debug mirror. Declared unconditionally (176 bytes, negligible)
    // so that IT adds no DEBUG/release divergence of its own. (The shapes are NOT
    // otherwise identical: the DEBUG profiler block above adds 36 bytes and the
    // DEBUG replay block at the RAM tail adds 10,244, so every field from the
    // profiler block down sits 36 bytes higher under DEBUG and Engine_RAM_End
    // moves by 10,280.) Only WRITTEN under
    // DEBUG + SOUND_DRIVER_ENABLED + SOUND_DBG_MIRROR. Lets the Exodus MCP — which
    // reads 68k RAM but not Z80 RAM at $A00000 — observe the driver's
    // mailbox+status+sequencer state. Sized for the 5-channel sequencer window +
    // trace ring: 64 + 78 + 32 = 174 <= 176 (kept EVEN with a 2-byte margin).
    Sound_Dbg_Mirror:       [u8; 176],  // DEBUG: Z80 mailbox/status, playback state, seq header, 5 SeqChannel slots, trace ring

    // --- Object-pool occupancy — the dynamic-pool "run objects list" ---
    // Word SST-addresses of the live DYNAMIC slots, in SPAWN order, + count + a
    // frame-end-compaction dirty flag. SST code_addr==0 stays the single source of
    // truth; this list is a conservative over-approximation (may briefly hold dead
    // slots, never misses a live one) that lets RunObjects / TouchResponse /
    // EntityWindow skip the typically-empty dynamic slots. Placed at the RAM TAIL:
    // the addition ripples ZERO existing RAM addresses (only Engine_RAM_End + game
    // RAM shift). Genesis RAM has no locality cost, so tail placement is free.
    Dynamic_Live:           [u16; NUM_DYNAMIC],  // 80B — live dynamic slot addresses, spawn order
    Dynamic_Live_Count:     u16,        // live entries (0..NUM_DYNAMIC)
    Dynamic_Live_Dirty:     u8,         // a dynamic deletion happened; compact at frame end
    // A2 walk-live rail: set while a dynamic live-list walk holds a cursor into
    // Dynamic_Live, asserted CLEAR at CompactDynamicLive entry — a set flag there
    // means a mid-walk compaction is about to move entries under a live cursor
    // (the A2 hazard). Occupies the release pad slot, so THIS FIELD adds no
    // DEBUG/release divergence — nothing below it moves relative to it in either
    // shape. It does not make Engine_RAM_End shape-invariant: the DEBUG profiler
    // block (+36) and the DEBUG replay block (+10,244) already diverge the shapes,
    // so Engine_RAM_End sits 10,280 bytes higher under DEBUG.
    if DEBUG == 1 {
        Dynamic_Live_Walking:   u8,     // DEBUG-only: a dynamic live-list walk is in progress
    } else {
        pad(1),                         // pad to even
    }

    // Occupancy amendment A2 (overflow latch, spec §9) — RELEASE (both shapes).
    // AllocDynamic at a full live list latches the popped slot word here instead of
    // compacting mid-frame under a live walker; RunObjects' tail drains it. Placed
    // after the DEBUG/pad byte so both shapes carry it at the same offset
    // (Engine_RAM_End moves identically in both). Word count for even alignment.
    Dynamic_Live_Pending:       [u16; NUM_DYNAMIC_PENDING],  // latched slot addresses (alloc order)
    Dynamic_Live_Pending_Count: u16,    // latch occupancy (0..NUM_DYNAMIC_PENDING)

    // Prefetch scan memoize — a generation word plus one keyed memo per axis. The
    // vertical (.pfx_scan) and horizontal (.cs_scan) prefetch scans skip their
    // FindStagedBlock all-hits re-probe walk when the memo still describes the
    // same set of blocks AND none of the slots holding them has been evicted.
    // Placed at the RAM tail: the addition ripples ZERO existing RAM addresses.
    //
    // STREAMING FIX F2 RE-KEYED BOTH HALVES OF THIS (2026-08-20). It used to key
    // on the RAW cache bounds and on plain equality of Block_Stage_Gen, and the
    // packet (CHOKE-DIAGNOSIS §3) called that "a design-level self-defeat":
    //   * the generation is bumped by EVERY staging claim in the engine, including
    //     the ones the scans themselves make, so the memo could not hit at any
    //     interesting claim rate. It is now the base of a DELTA: the check turns
    //     (gen - gen_at_record) plus the round-robin cursor into the exact set of
    //     slots evicted since, and only a hit against Pfx_Memo_Mask / Cs_Memo_Mask
    //     (engine RAM, lower_ram) kills the memo.
    //   * the bounds were the RAW Cache_Left_Col/Head_Col (resp. Top/Bottom), which
    //     move every tick the camera moves — while the scan only ever visits
    //     BLOCK-ALIGNED lines, so the visited SET changes once every 8 ticks. The
    //     recorded bounds are now block-aligned, and the fields are named for it.
    // The "no memo" sentinel moved with the re-key: it is now $FFFF in the TARGET
    // (Pfx_Memo_Row / Cs_Memo_Col), which is unrepresentable because every target
    // is block-aligned. It could not stay on the generation, because under a delta
    // key a $FFFF generation is not far from a small live one, it is 1 before it.
    Block_Stage_Gen:        u16,        // bumped on every staging claim + invalidate; the memo delta base
    Pfx_Memo_Row:           u16,        // vertical scan: memoized target row ($FFFF = no memo)
    Pfx_Memo_L16:           u16,        // vertical scan: BLOCK-ALIGNED Cache_Left_Col at record (bounds guard — load-bearing)
    Pfx_Memo_H16:           u16,        // vertical scan: BLOCK-ALIGNED Cache_Head_Col at record (bounds guard — load-bearing)
    Pfx_Memo_Gen:           u16,        // vertical scan: Block_Stage_Gen at record (delta base for the eviction test)
    Cs_Memo_Col:            u16,        // horizontal scan: memoized target col ($FFFF = no memo)
    Cs_Memo_T16:            u16,        // horizontal scan: BLOCK-ALIGNED Cache_Top_Row at record (bounds guard — load-bearing)
    Cs_Memo_B16:            u16,        // horizontal scan: BLOCK-ALIGNED Cache_Bottom_Row at record (bounds guard — load-bearing)
    Cs_Memo_Gen:            u16,        // horizontal scan: Block_Stage_Gen at record (delta base for the eviction test)

    // HBlank vector slot (§0.10) — the IRQ4 vector points DIRECTLY here. Holds a
    // 6-byte executable instruction: idle rte ($4E73) when no raster handler is
    // installed, or `jmp handler.l` ($4EF9 + 4-byte target) when HBlank_Install
    // arms one. Entered with no wrapper — the handler owns its save/restore + rte.
    // Placed at the RAM TAIL: the addition ripples ZERO existing RAM addresses.
    HBlank_Vector_Slot:     [u8; 6],

    // Block staging data pointers (§4.7) — one per staging slot, parallel to
    // Block_Stage_Keys. DecompressBlock writes the slot's staged-data base here at
    // claim time; FindStagedBlock returns it. A compressed block points at its RAM
    // slot; a raw block points straight at the uncompressed ROM block; an empty
    // block points at the shared zero page below. Consumers only READ through the
    // pointer, so ROM / zero-page targets are safe. Placed at the RAM TAIL.
    Block_Stage_Ptrs:       [u32; BLOCK_STAGE_SLOTS],   // 64 bytes — per-slot staged data pointer

    // F-3 merge-translation: per-slot local->global map pointer, parallel to
    // Block_Stage_Ptrs (staged nametable words are LOCAL; the map is applied per
    // word at the patch/scan consumers). Written by DecompressBlock at claim
    // time; FindStagedBlock republishes the hit slot's entry into
    // Cache_Cur_LocalMap, the "current block" cell PageCache_PatchWord and the
    // prefetch scan read. Every map's [0] entry is global 0 (blank) —
    // generator-guaranteed — so the shared zero page reads as blank through any
    // section's map.
    Block_Stage_Maps:       [u32; BLOCK_STAGE_SLOTS],   // 64 bytes — per-slot local->global map ptr
    Cache_Cur_LocalMap:     u32,                        // current staged block's map (PatchWord/scan input)

    // Shared all-zero staged block — every empty (blank / out-of-grid) block points
    // here instead of paying a 768-byte zero-fill. BLOCK_RAW_SIZE bytes
    // (nametable + collision), word-even, in the boot-cleared 64KB Work RAM; never
    // written after boot (the staged-pointer read-only contract keeps it zero).
    Block_Stage_ZeroPage:   [u8; BLOCK_RAW_SIZE],       // 768 bytes — read-only zero staged block

    // --- Art-streaming P2a page-in bookmark record (survey §1) ---
    // Engine-owned, RELEASE (all shapes): the VBlank bookmark banks the resumable
    // decoder's ENTIRE live register set + CCR here at preemption, and
    // PageIn_Process resumes from it. 7 longs (d0-d2/a0-a3) + PC long + SR word =
    // 34 bytes, plus two byte flags. Banked/restored via individual moves (NOT
    // movem-to-absolute: the 68000 supports movem to/from absolute-long with no
    // pointer register, but sigil cannot yet emit movem to a symbolic absolute
    // operand — the same lowering gap as abs-sym + second extension-word operand.
    // When it can, the 7-move bank/resume pairs in page_in should become movem,
    // ~92 cycles saved per preempt+resume). NO hand
    // VBH_STACKED_PC constant anywhere — the hook uses the Sigil irq_frame.pc
    // accessor. Placed at the RAM TAIL: the addition ripples ZERO existing RAM
    // addresses (only Engine_RAM_End + the game RAM chained after it shift).
    PageIn_Saved_D0:        u32,        // d0-d2/a0-a3 banked at preemption
    PageIn_Saved_D1:        u32,
    PageIn_Saved_D2:        u32,
    PageIn_Saved_A0:        u32,
    PageIn_Saved_A1:        u32,
    PageIn_Saved_A2:        u32,
    PageIn_Saved_A3:        u32,
    PageIn_Saved_PC:        u32,        // interrupted decoder PC (banked by the hook)
    PageIn_Saved_SR:        u16,        // decoder CCR/SR at preemption
    PageIn_InFlight:        u8,         // nonzero while ZX0R may be on the resumable path (hook arm)
    PageIn_Suspended:       u8,         // nonzero = banked context awaits resume

    // --- Art-streaming P2a page-in request FIFO + landing state (Task 4) ---
    // The dispatcher's demand-before-prefetch request queue (front-packed) plus the
    // single-page landing handshake. All RELEASE (the streaming path is present in
    // every shape). Placed with the bookmark record at the RAM tail so the addition
    // ripples only Engine_RAM_End + the game RAM chained after it.
    PageIn_Staging_Busy:    u8,         // nonzero = a published page's staging->VRAM DMA is in flight (blocks a new decode)
    PageIn_Land_Pending:    u8,         // nonzero = a decoded page in staging awaits its landing DMA (Important queue was full)
    PageIn_Queue_Count:     u8,         // front-packed FIFO occupancy (0..PAGEIN_QUEUE_SLOTS)
    PageIn_Cur_Flags:       u8,         // in-flight request flags (raw-form retry preserves priority)
    PageIn_Queue:           [PageInReq; PAGEIN_QUEUE_SLOTS],   // 8 x 4 = 32 bytes
    PageIn_Cur_Dest:        u16,        // in-flight page VRAM byte dest (read by the landing DMA)
    PageIn_Cur_Bytes:       u16,        // in-flight page uncompressed byte length (landing DMA length)
    PageIn_Cur_Page:        u16,        // in-flight page id (raw-form retry)
    PageIn_Cur_Frame:       u8,         // frame allocated for the in-flight page (P2b Task 6; published at land)
    PageIn_Bulk_Drain:      u8,         // nonzero while Level_LoadArt's bulk pool load + drain-wait is active:
                                        // BULK-FIRST discipline (chain 78) — PageCache_Prefetch yields so the
                                        // init drain reaches quiescence (41 pages > 15 frames would otherwise
                                        // prefetch<->evict-churn the FIFO forever, a black-screen livelock).
                                        // (Consumes the former word-align pad byte — RAM layout unchanged.)
    PageIn_Pool_Table:      u32,        // current act's page-address table (FIFO resolution base; set by Level_LoadArt)
    PageIn_Pool_Pages:      u16,        // current act's pool page count (set by Level_LoadArt) — dispatch page-id bound;
                                        // resolve-context source that does NOT depend on the flaky Current_Act_Ptr
    PageIn_Fully_Resident:  u8,         // nonzero = pool_pages <= PAGE_FRAMES_CLAMP (latched by Level_LoadArt):
                                        // the whole pool is permanently resident after the bulk load, so
                                        // PageCache_Prefetch early-outs — its ahead-strip scan can never find a
                                        // non-resident page (§9.7 degenerate path, all shipped content)
    PageCache_Direct_Map:   u8,         // nonzero = the DIRECT-MAP patch regime (streaming fix F1): fully
                                        // resident AND Page_Table is the identity (Page_Table[p]==p for every
                                        // p < PageIn_Pool_Pages), verified by Level_LoadArt once the pool has
                                        // landed. Under it `physical == global` for every word, so the copy-site
                                        // patch runs collapse to read/mask/one map read/attr-merge/store — no
                                        // page->frame indirection and no refcount pair. Cleared by
                                        // PageCache_Init, so it is FALSE for the whole of any act load until the
                                        // pool is proven identity-mapped. (Consumes the former word-align pad
                                        // byte — RAM layout unchanged.)

    // --- Art-streaming P2b Task 7: page prefetch + D3 trailing-lag admission gate ---
    // RELEASE (the streaming path is present in every shape). The D3 gate gates
    // SPECULATIVE (prefetch) decode STARTS only (demand + resumes are NEVER gated),
    // via PageIn's OWN Frame_Counter-delta latch — NOT the fill-owned
    // Cache_Pfx_Lag_Flag (which is only as fresh as the last Tile_Cache_Fill call).
    PageIn_Last_Frame:      u16,        // Frame_Counter at the last once-per-frame PageIn tick
    PageIn_Prev_Lagged:     u16,        // 1 = the previous frame lagged (Frame_Counter advanced >1)
    PageIn_Pfx_Skip_Armed:  u16,        // 1 = a speculative start was skipped last frame (bound: <=1 running)
    Page_Pfx_Budget:        u16,        // per-frame page-prefetch enqueue budget (reset PAGE_PREFETCH_MAX)

    // --- Art-streaming P2c Task 9: per-act art-streaming byte budget (B&R pattern) ---
    // RELEASE (present in every shape). Act_Art_Budget is copied from the act
    // descriptor at level init; PageIn_Process reloads Art_Budget_Remaining from it in
    // its once-per-physical-frame tick (co-located with the charge, in-phase across the
    // VInt_Level/VInt_Lag paths — chain-77). page_in charges each page landing's DMA
    // bytes against Art_Budget_Remaining and DEFERS further page-ins (request stays
    // queued) when a frame is exhausted. Steady-state governor, NOT an arbiter (D2).
    Act_Art_Budget:         u16,        // per-act steady-state art-DMA byte budget (from Act.act_art_budget)
    Art_Budget_Remaining:   u16,        // remaining art-DMA bytes this frame (reloaded in PageIn_Process's tick)

    // --- Controller HELD raw shadows (IRQ-owned) ---
    // The bytes Read_Controllers actually writes each physical VBlank, and the
    // previous-value source for its press-edge detection. The PUBLISHED
    // Ctrl_x_Held / Ctrl_x_Ext_Held bytes up in the controller block are latched
    // from these by VInt_Level ONLY, giving HELD the same tick-stability PRESS has
    // always had.
    //
    // Before this split, Read_Controllers wrote the published bytes directly and
    // VInt_Lag calls it too — so any lag VBlank landing mid-tick replaced the
    // logic tick's held input with the live pad. Under replay playback the pad is
    // untouched ($00), so a lag frame silently dropped ALL held input for the rest
    // of that tick while the 11 game-side re-reads kept sampling it: a guaranteed
    // desync, and the mechanism replay.emp claimed was "killed structurally" (it
    // was killed for PRESS only).
    //
    // Placed at the RAM TAIL so the addition ripples ZERO existing engine-RAM
    // addresses (only Engine_RAM_End + the game RAM chained after it). Four bytes
    // keeps the run even.
    Ctrl_1_Held_Raw:        u8,         // live pad, rewritten EVERY VBlank (incl. lag)
    Ctrl_2_Held_Raw:        u8,
    Ctrl_1_Ext_Held_Raw:    u8,         // 0000MXYZ, same discipline
    Ctrl_2_Ext_Held_Raw:    u8,

    // --- Parcel R1: the band restore's source (engine/effects/raster.emp OP_PAL_RESTORE) ---
    // Per-line copy of Palette_Buffer taken at each line's frame-top DMA enqueue
    // (engine/system/buffers.emp, spliced at the bclr — copy iff dirty AND accepted).
    // INVARIANT: Palette_Ship_Snap[line] == THIS FRAME'S base-DMA payload for that line
    // (specs/2026-08-16-parcel-r1-palette-bands-v6.md §2.2 — stated at full strength there:
    // a band's own line is dirty, enqueued, snapshotted and DELIVERED every frame).
    // Placed at the RAM TAIL, before the @shape_divergent block: ripples ZERO engine-RAM
    // addresses; Engine_RAM_End + all game RAM shift — a full game-side repin, routine.
    Palette_Ship_Snap:      [u8; 128],

    // --- Replay recorder (engine/system/replay.emp, DEBUG only) ---
    // The 8 KB held-byte ring + the 2 KB (Logic_Tick, hash) checkpoint log. Placed
    // at the RAM TAIL and @shape_divergent (size-varying group — REQUIRED by the
    // region lowerer, [vars.shape-divergent]): the DEBUG-shape addition ripples ZERO
    // existing engine-RAM addresses; only Engine_RAM_End (and the game RAM chained
    // after it) shift, and only in the DEBUG shape (which is already shape-divergent
    // from the profiling block above). Never present in release builds.
    if DEBUG == 1 @shape_divergent {
        Replay_Record_Idx:      u16,        // ticks recorded (byte index into the ring)
        Replay_Check_Idx:       u16,        // checkpoint entries written
        Replay_Record_Buf:      [u8; REPLAY_RECORD_TICKS],   // 8192 raw Ctrl_1_Held bytes
        Replay_Check_Log:       [u8; 256 * 8],               // 256 × (Logic_Tick u32, hash u32) pairs
    }

    // --- Sprite ownership map (engine/objects/sprites.emp, DEBUG only) ---
    // Entry i = the SST address WORD of the object that emitted SAT entry i this
    // frame. Sentinels: $0000 = none / unknown, $0001 = ring (DrawRings), $0002 =
    // X=0 mask sprite (InsertSpriteMasks). Lets the emulator join a clicked
    // hardware sprite back to the object that drew it (SPRITE-OWNER, DEFERRED_WORK).
    // Sized FROM MAX_VDP_SPRITES — one entry per SAT slot, by construction.
    //
    // Placed at the RAM TAIL, AFTER the replay block, and @shape_divergent
    // (size-varying group — REQUIRED by the region lowerer, [vars.shape-divergent]):
    // the DEBUG-shape addition ripples ZERO existing engine-RAM addresses (not even
    // the replay ring's) — only Engine_RAM_End and the game RAM chained after it
    // move, and only in the DEBUG shape, which is already shape-divergent.
    // DEVIATION FROM THE BOOKING, deliberate: it asked for this "beside
    // Sprites_Rendered", which would have slid every engine-RAM field below the
    // sprite block in the DEBUG shape for no gain — Genesis RAM has no locality
    // cost and the array is reached through a single `lea` held in a6.
    if DEBUG == 1 @shape_divergent {
        Sprite_Owner:           [u16; MAX_VDP_SPRITES],  // 160 B today (80 slots)
    }

    // --- Canopy-gap capture instrument (engine/level/section.emp, DEBUG only) ---
    // WHAT THIS IS FOR, stated because a reader will otherwise price it as bloat: the
    // reported canopy gap has outlived TWO derived explanations (DEFERRED_WORK, "CANOPY
    // GAP"), both refuted by measurement. This block is the state a THIRD derivation
    // would need and cannot get after the fact — see Canopy_Probe in
    // engine/level/section.emp for the predicates and Canopy_Rec_* for the latch.
    //
    // THE ONE FACT THAT MAKES THE SHADOW MANDATORY: which world cell a plane cell holds
    // is NOT recoverable from VRAM. The act's tileset is globally deduplicated, so the
    // same tile word legitimately appears at many world cells; reading plane A after a
    // sighting cannot say which world column produced a given plane column. Only the
    // writer knows, and only at the moment it writes. Hence a shadow, not a post-hoc read.
    //
    // Placed at the RAM TAIL, AFTER the sprite-owner block, and @shape_divergent, for
    // exactly the reason the block above states: it ripples ZERO existing engine-RAM
    // addresses, moving only Engine_RAM_End and the game RAM chained after it, and only
    // in the DEBUG shape.
    if DEBUG == 1 @shape_divergent {
        // -- LIVE shadow: what each plane cell's last writer intended. --
        // Per plane COLUMN P: the column writer (Draw_TileColumn / Section_RedrawPlanes'
        // .pla_fill) writes all 64 rows of P from ONE world column, mapping cache rows
        // onto NT rows through the Cache_Top_Row anchor it read at that instant.
        Canopy_ColW:            [u16; PLANE_H_CELLS],   // world col written into plane col P ($FFFF = never)
        Canopy_ColTop:          [u16; PLANE_H_CELLS],   // Cache_Top_Row anchor that write used for P's 64 rows
        Canopy_ColFrame:        [u16; PLANE_H_CELLS],   // Frame_Counter at that write (0 = never)
        // Per plane ROW Q: the row writer (Draw_TileRow_FromCache) writes all 64 columns
        // of Q from ONE cache row, mapping cache cols onto NT cols through the anchor
        // R = min(Section_Right_Col_Written, Cache_Head_Col) it read at that instant.
        Canopy_RowR:            [u16; PLANE_V_CELLS],   // that anchor R ($FFFF = never row-written)
        Canopy_RowFrame:        [u16; PLANE_V_CELLS],   // Frame_Counter at that write (0 = never)

        // -- The LATCH. First fire wins and is never overwritten; Canopy_Hits counts
        //    every fire including the first. A later fire is a consequence of the first,
        //    which is why the first is the one kept. --
        // Draw_TileRow_FromCache's two-part hand-off: the row's identity is known at the
        // top of that proc, the anchor it is written with only sixty lines later. A RAM
        // stash rather than a reserved register — see the comment at the write site.
        Canopy_Tmp_Idx:         u16,    // plane row × 2
        Canopy_Tmp_V:           u16,    // world row

        // Per-code counters and per-code first-fire frames. These exist SEPARATELY from
        // the single latch below because how OFTEN a code fires is a measurement in its
        // own right, and the latch can only hold one fire: a C4 that fires four hundred
        // times in ordinary play says the row anchor mismatches routinely and cannot be a
        // rare-sighting explanation; a C4 that never fires says so just as loudly.
        // Indexed by (code - 1); slots 1 and 2 (codes 2 and 3) are permanently zero, see
        // the note at CANOPY_C1 in engine/system/constants.emp.
        Canopy_Hits:            [u16; 4],
        Canopy_First_Fr:        [u16; 4],   // Frame_Counter at each code's FIRST fire

        // The C1 persistence gate — see CANOPY_PERSIST_FRAMES. A disagreement must be the
        // same (code, plane index) for this many consecutive sweeps before it latches.
        Canopy_Pend_Code:       u16,
        Canopy_Pend_Idx:        u16,
        Canopy_Pend_Age:        u16,

        Canopy_Halt:            u16,    // owner-armed from the bus: nonzero = raise_error on the NEXT fire
        Canopy_Cost:            u16,    // V-counter lines the last sweep took (self-price)
        Canopy_Cost_Peak:       u16,    // peak of the above

        // The last full-plane redraw, latched LIVE by Section_UpdateColumns' dirty arm
        // (copied into the record at the fire). Section_RedrawPlanes' d5/d7 ARE the
        // caller's tracker writes, so these three say whether a redraw is what put the
        // trackers where the fire found them — the (b) attribution.
        Canopy_Redraw_Fr:       u16,    // Frame_Counter of the last Section_RedrawPlanes (0 = none since boot)
        Canopy_Redraw_L:        u16,    // the d5 it returned
        Canopy_Redraw_R:        u16,    // the d7 it returned

        Canopy_Rec_Code:        u16,    // 0 = empty. See CANOPY_C1..C4 in engine/level/section.emp
        Canopy_Rec_Frame:       u16,    // Frame_Counter at the fire
        Canopy_Rec_CamX:        u32,    // Camera_X 16.16 as read by the check
        Canopy_Rec_CamY:        u32,
        Canopy_Rec_Idx:         u16,    // plane col P (codes 1,2) or plane row Q (codes 3,4)
        Canopy_Rec_Want:        u16,    // world col W (1,2) / world row V (3,4) the fire was looking at
        Canopy_Rec_Got:         u16,    // Canopy_ColW[P] (1) / Canopy_ColTop[P] (2) / the anchor R (3,4)
        Canopy_Rec_Stamp:       u16,    // Canopy_ColFrame[P] (1,2) / Canopy_RowFrame[Q] (3,4)
        // The trackers and the cache window as they stood. Canopy_Rec_SecR against
        // Canopy_Redraw_R and against the Canopy_Snap_ColW spread is the (b)
        // discriminator: a tracker claiming further right than any column writer ever
        // reached is an over-claim, not an anchor error.
        Canopy_Rec_SecR:        u16,    // Section_Right_Col_Written
        Canopy_Rec_SecL:        u16,    // Section_Left_Col_Written
        Canopy_Rec_SecB:        u16,    // Section_Bottom_Row_Written
        Canopy_Rec_SecT:        u16,    // Section_Top_Row_Written
        Canopy_Rec_CacheHead:   u16,    // Cache_Head_Col
        Canopy_Rec_CacheLeft:   u16,    // Cache_Left_Col
        Canopy_Rec_CacheTop:    u16,    // Cache_Top_Row
        Canopy_Rec_CacheBot:    u16,    // Cache_Bottom_Row
        Canopy_Rec_OrgCol:      u16,    // Cache_Origin_Col   (ring phase — the reading error of 2026-08-29)
        Canopy_Rec_OrgRow:      u16,    // Cache_Origin_Row
        Canopy_Rec_ResumeCol:   u16,    // Cache_Fill_Resume_Col    ($FFFF = no partial)
        Canopy_Rec_ResumeRow:   u16,    // Cache_Fill_RowResume_Row ($FFFF = no partial)
        Canopy_Rec_PBPtr:       u16,    // Plane_Buffer_Ptr at the check (a near-full buffer bails the four loops)
        Canopy_Rec_Stall:       u16,    // Cache_Art_Stall — a demand-stalled fill is a different cause again
        Canopy_Rec_RedrawFr:    u16,    // Canopy_Redraw_Fr as it stood at the fire
        Canopy_Rec_RedrawL:     u16,    // Canopy_Redraw_L
        Canopy_Rec_RedrawR:     u16,    // Canopy_Redraw_R

        // -- The SNAPSHOT: the whole live shadow, frozen at the first fire. The scalars
        //    above name ONE offending index; this says how many there are, whether they
        //    are contiguous, and which side of the window they fall on — the difference
        //    between "one column lost its twin" and "the anchor moved". Without it a
        //    sighting read minutes later reads a shadow that has long since moved on. --
        Canopy_Snap_ColW:       [u16; PLANE_H_CELLS],
        Canopy_Snap_ColTop:     [u16; PLANE_H_CELLS],
        Canopy_Snap_ColFrame:   [u16; PLANE_H_CELLS],
        Canopy_Snap_RowR:       [u16; PLANE_V_CELLS],
        Canopy_Snap_RowFrame:   [u16; PLANE_V_CELLS],
    }

    // Engine RAM ends here — game RAM continues from Engine_RAM_End
    // (games/<game>/config/ram.emp declares `game_ram @ after(upper_ram)`).
    mark Engine_RAM_End,
}
