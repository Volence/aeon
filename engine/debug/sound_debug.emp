// DEBUG-only sound driver state mirror — exposes the Z80 mailbox+status to the
// Oracle MCP. Zero bytes in BOTH canonical shapes (the triple gate
// __DEBUG__ + SOUND_DRIVER_ENABLED + SOUND_DBG_MIRROR; SOUND_DBG_MIRROR defaults
// 0 in build.sh). Placed only at the MIRROR shape (DEBUG=1 SOUND_DBG_MIRROR=1);
// the canonical shapes prove emptiness. Gate: the call site's
// `if DEBUG == 1 && SOUND_DRIVER_ENABLED == 1 && SOUND_DBG_MIRROR == 1`
// (engine/system/vblank.emp) plus placement by the off-canonical config_a profile
// (`sigil build --native --config-a`). (This read "SIGIL_EMP_SOUND_DEBUG
// (engine.inc)"; engine.inc is deleted and that name exists nowhere in the tree —
// gap lens sweep A2-17, 2026-09-12.)
//
// Sound_DebugMirror copies the Z80 mailbox+status ($A01F00..$A01F3F) plus the
// playback/sequencer state and trace ring into Sound_Dbg_Mirror (68k RAM) so the
// MCP can observe driver state (its emulator_read_memory errors on $A00000, so we
// snapshot the Z80 region into 68k RAM each frame). Stops the Z80 for the copy,
// then restarts it — a bus-held window long enough to be an audible 60Hz tick
// (~164 bytes copied off the held Z80 bus; the exact µs is oracle-measurable but
// not verified here), which keeps the mirror OFF by default.
//
// A SeqChannel is `SeqChannel_len` bytes (60, pinned by an ensure in
// engine/sound/sound_constants.emp), too large to mirror in FULL within the
// Sound_Dbg_Mirror reservation. The mirror is a DEBUG observability window, not a
// faithful struct copy, so we mirror a PREFIX of each channel (SEQ_MIRROR_CHBYTES
// bytes) that captures the controller-observed liveness fields. The shipping songs
// have 3 channels (FM1, FM2, PSG1), so 3 slots is the window.
//
// Per-channel mirror prefix (offsets within the 20-byte slot, from SeqChannel +0):
//   +0/+1 sc_stream_ptr, +2/+3 sc_mod_ptr, +4 sc_dur_count, +5 sc_dur_default,
//   +6 sc_patch, +7 sc_last_patch, +8 sc_volume, +9 sc_note, +10 sc_flags,
//   +11 sc_route, +12/+13 sc_loop_ptr, +14/+15 sc_repeat_ptr, +16 sc_repeat_count,
//   +17 sc_tempo_mod, +18 sc_tempo_accum, +19 sc_pt_count.
// (sc_pan +27, sc_opbias +28..+31, sc_last_pan +36 live PAST the 20-byte prefix,
// so they are not mirrored.)
// Mirror layout (offsets from Sound_Dbg_Mirror): header [64..71], ch0 [72..91],
// ch1 [92..111], ch2 [112..131]; trace ring [132..163]. Upper window = 64 + 8 +
// 3*20 + 32 = 164, against a 176-byte reservation — 12 spare, and the fit ensure
// below measures the reservation rather than restating it.
//
// ⚠ THIS FILE IS THE LAYOUT AUTHORITY, and engine/ram.emp's reservation is only the
// space. That block used to describe a DIFFERENT layout — "5 SeqChannel slots …
// 64 + 78 + 32 = 174" — which is five 14-byte slots and is not what any build has
// ever written; it has been corrected to point here. That matters because this
// window exists to be decoded from OUTSIDE the assembler. ENUMERATED 2026-09-07 by
// what actually reads it: the only in-tree reader is this writer; oracle and seraph
// contain no decoder at all; empyrean/docs/STUDIO_VISION.md and the seraph handoff
// name a sound-state HUD that would read it AFTER Oracle Phase 2, and aeon's own
// 2026-06 sound plans give hand-followed MCP recipes against the pre-Phase-3
// 64-byte window. So no built consumer was decoding the wrong description — but the
// planned one is the reason the offsets belong in one place with the code.

module engine.debug.sound_debug in sound_debug

use engine.z80_bus.{z80_stopped}
// The `vblank` GRANTED context, named by this module's `requires(vblank)` clause below.
use engine.irq.{vblank}

// The sound contract's single authority (SeqChannel_len, SND_SEQ_TRACE_LEN, the
// Z80 RAM bases). The glob brings the SND_SEQ_TRACE derivation chain into scope;
// SeqChannel_len (a `sizeof`) and SND_SEQ_TRACE_LEN (=32) fold at comptime, so the
// `(SeqChannel_len - SEQ_MIRROR_CHBYTES)(a0)` displacement and the
// `#SND_SEQ_TRACE_LEN-1` moveq immediate size correctly.
use engine.sound_constants.*

// Z80_RAM is the engine's hardware-address authority (engine.constants); the
// SND_* offsets are sound_constants'.
equ SND_MIRROR_DEST = extern("Sound_Dbg_Mirror")
equ SND_REQ_SRC     = extern("Z80_RAM") + SND_REQ_BASE
equ SND_STATE_SRC   = extern("Z80_RAM") + SND_STATE_BASE
equ SND_SEQ_SRC     = extern("Z80_RAM") + SND_SEQ_BASE
equ SND_TRACE_SRC   = extern("Z80_RAM") + SND_SEQ_TRACE

const SEQ_MIRROR_CHANNELS = 3
const SEQ_MIRROR_CHBYTES  = 20                       // per-channel prefix (<= SeqChannel_len)
const SEQ_MIRROR_HDRCH    = 8 + SEQ_MIRROR_CHANNELS * SEQ_MIRROR_CHBYTES

// Fit guards (comptime): the ensures below enforce the size bounds.
ensure(SEQ_MIRROR_CHBYTES <= SeqChannel_len,
       "SEQ_MIRROR_CHBYTES exceeds SeqChannel_len")
// MEASURES THE RESERVATION, NOT A COPY OF IT. This bound used to be the literal 176,
// hand-copied from engine/ram.emp — so shrinking the `[u8; 176]` there left this guard
// green while the window silently truncated. The span is now taken as the distance to the
// NEXT symbol in engine/ram.emp, the adjacent-symbol-difference idiom that file's three
// parallax reservation pins already use.
//
// WHY NOT A `Sound_Dbg_Mirror_End` MARK, which would read better: measured 2026-09-07,
// adding that one mark and nothing else moved demo.debug.bin by 955 bytes. A `mark` emits
// no ROM bytes, but it adds a deb2 symbol and build.sh appends the deb2 table into the
// ROM, so the mark is a ROM change wearing a zero-byte costume. engine/ram.emp carries
// the full note beside the reservation, including the ⚠ that Dynamic_Live must stay the
// next symbol for this measurement to mean what it says.
//
// WHAT IT DOES NOT COVER, stated because the gap is the interesting part: it bounds only
// the TOTAL. It cannot see the per-slot LAYOUT, which is what an out-of-process consumer
// actually decodes, and it says nothing about SEQ_MIRROR_CHANNELS matching the shipping
// song's channel count. It also only evaluates in a shape that PLACES this module — the
// MIRROR shape (`sigil build --native --config-a`) — so a canonical `./build.sh` proves
// nothing about it either way.
ensure(64 + SEQ_MIRROR_HDRCH + SND_SEQ_TRACE_LEN <= extern("Dynamic_Live") - extern("Sound_Dbg_Mirror"),
       "the sound debug mirror window is {64 + SEQ_MIRROR_HDRCH + SND_SEQ_TRACE_LEN} bytes and Sound_Dbg_Mirror reserves only {extern(\"Dynamic_Live\") - extern(\"Sound_Dbg_Mirror\")} — widen the reservation in engine/ram.emp or drop SEQ_MIRROR_CHANNELS / SEQ_MIRROR_CHBYTES, and re-derive the offset map in this file's header")

// `requires(vblank)` IS THIS PROC'S MASK PROOF, not a description of where it happens
// to be called (LS-13a, 2026-09-07). The `with z80_stopped` below is a 68k hold of the
// Z80 bus, and every such hold must be ENTERED with interrupts masked: the hold is a
// latch, so an IRQ6 landing in the spliced `.wait_z80` spin runs the VBlank handler,
// whose own brackets release the bus on the way out, and nothing below that label
// re-issues the request (engine/z80_bus.emp). What masks this one is the 68000's own
// IPL 6 on interrupt entry — which is only true if this proc is UNREACHABLE from the
// main loop. Until this clause it was reachable in principle: the argument was an
// enumeration of today's call sites (one, engine/system/vblank.emp:90), and an
// enumeration of callers is a claim about every future caller. `requires(vblank)` turns
// it into a claim sigil CHECKS at every call site (`[context.unsatisfied]`,
// engine/irq.emp), against a capability whose sole grant root is VBlank_Handler.
// The clause is contract-only — it emits no bytes and adds no symbol.
pub proc Sound_DebugMirror () clobbers(d0-d1/a0-a1) requires(vblank) {
    with z80_stopped {
        lea     SND_MIRROR_DEST, a1                  // (SND_MIRROR_DEST).w — 68k RAM dest
        lea     SND_REQ_SRC, a0                      // (SND_REQ_SRC).l — Z80_RAM+$1F00, abs.l by the width rule; [0..47] = $1F00..$1F2F (req slots + status)
        // This 48-byte copy already covers SND_STAT_TICK ($1F13 -> mirror byte 19),
        // the scheduler tick counter the controller reads to verify the Timer-A
        // overflow rate (tempo $C0 -> ~208/sec). No extra mirror entry needed.
        moveq   #48-1, d0
        .copy1:
            move.b  (a0)+, (a1)+
            dbf     d0, .copy1
        lea     SND_STATE_SRC, a0                    // (SND_STATE_SRC).l; [48..63] = $18F0..$18FF (playback state)
        moveq   #16-1, d0
        .copy2:
            move.b  (a0)+, (a1)+
            dbf     d0, .copy2
        // --- [64..] sequencer window (Phase 3) ---
        // a1 now points at Sound_Dbg_Mirror+64. Copy the 8-byte sequencer header,
        // then a SEQ_MIRROR_CHBYTES-byte PREFIX of each channel (a full SeqChannel is
        // SeqChannel_len bytes — 60, pinned by sound_constants.emp; this line used to
        // say 36, which was the struct's width several widenings ago and disagreed with
        // this file's own header), then the SND_SEQ_TRACE_LEN-byte trace ring.
        //   [64] SND_SEQ_TEMPO      [65] SND_SEQ_CHCOUNT
        //   [66..67] SND_SEQ_PATCHTAB
        //   [68] SND_SEQ_ACTIVE     [69] SND_SEQ_BADOP
        //   [70] SND_SEQ_TRACE_WR   [71] SND_SEQ_TEMPO_MOD
        //   [72..] channel prefixes (SEQ_MIRROR_CHBYTES each) — see the field map above.
        //   [...] SND_SEQ_TRACE ring (32 bytes); each = (route<<4)|event_code.
        lea     SND_SEQ_SRC, a0                      // (SND_SEQ_SRC).l; $1A00.. (header)
        moveq   #8-1, d0
        .copy3h:
            move.b  (a0)+, (a1)+
            dbf     d0, .copy3h
        // per-channel prefixes: copy SEQ_MIRROR_CHBYTES, then skip the rest of the
        // Z80 SeqChannel slot. a0 already at SND_SEQ_CHANNELS ($1A08) after the
        // header copy (the header is exactly the 8 bytes $1A00..$1A07).
        moveq   #SEQ_MIRROR_CHANNELS-1, d1
        .copy3c:
            moveq   #SEQ_MIRROR_CHBYTES-1, d0
            .copy3cb:
                move.b  (a0)+, (a1)+
                dbf     d0, .copy3cb
            lea     (SeqChannel_len-SEQ_MIRROR_CHBYTES)(a0), a0   // skip the unmirrored tail
            dbf     d1, .copy3c
        lea     SND_TRACE_SRC, a0                    // (SND_TRACE_SRC).l; trace ring (32 B, derived addr)
        moveq   #SND_SEQ_TRACE_LEN-1, d0
        .copy4:
            move.b  (a0)+, (a1)+
            dbf     d0, .copy4
    }
    rts
}
