// DEBUG boot self-test — 68000 decompressors verified against the build encoders
//
// This module exists ONLY in the debug shape: the build/harness includes it
// only when DEBUG=1 — the plain shape carries zero bytes and no symbols. The
// five
// golden vectors are `.emp`-native: the CSelf_* labels below `embed()` the
// blobs tools/gen_compression_vectors.py writes, and the three CSELF_* values
// are `use`d from the generated constants module (that generator is their sole
// author — nothing here hardcodes them).

module engine.compression_selftest in compression_selftest

use engine.compression_vectors.{CSELF_PAYLOAD_SIZE, CSELF_PAYLOAD_SUM, CSELF_DICT_LEN}

// Addressing modes: every CSelf_*/Art_Staging_Buffer operand is spelled BARE
// and the width rule picks the mode — the CSelf_* ROM labels sit below $8000
// (abs.w), Art_Staging_Buffer at $FFFF0000 sits outside the sign-extended
// abs.w window (abs.l). The ensure below is the fit-lock: if the generated
// vectors ever push the LAST label to $8000+, this fails loudly instead of
// silently relaxing the bare operands from abs.w to abs.l.
ensure(extern("CSelf_Expected") < $8000, "generated compression vectors grew past the abs.w window — re-widen the CSelf_* operands (s4lz selftest)")

// -----------------------------------------------
// CompressionSelfTest — decode golden vectors, assert checksums
//
// The build emits one fixed payload compressed three ways (S4LZ v3 plain,
// S4LZ v3 + dictionary, ZX0) plus its expected 16-bit additive word
// checksum (tools/gen_compression_vectors.py — the generator PROVES at
// build time which decoder paths each vector exercises). This routine
// decompresses each vector into Art_Staging_Buffer at cold boot — before the
// buffer's first real use — and asserts the checksum. Any divergence
// between a 68000 decompressor and its encoder halts on the assert screen.
//
// The buffer is poisoned between vectors: all three share one payload, so
// a no-op decode would otherwise pass on the previous vector's output.
//
// In:  none
// Out: none
// Clobbers: d0-d4, a0-a4
// -----------------------------------------------
pub proc CompressionSelfTest () clobbers(d0-d4/a0-a4) {
        // --- S4LZ v3 plain through Art_Decompress dispatch (covers S4LZ branch) ---
        jbsr    .poison
        lea     CSelf_S4LZ_Plain, a0
        lea     Art_Staging_Buffer, a1
        jbsr    Art_Decompress
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- S4LZ v3 + dictionary (window rebase path) ---
        jbsr    .poison
        lea     CSelf_S4LZ_Dict, a0
        lea     Art_Staging_Buffer, a1
        lea     CSelf_Dict_Blob, a4
        move.w  #CSELF_DICT_LEN, d4
        jbsr    S4LZ_DecompressDict
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- ZX0 through the version-dispatch wrapper (Art_Decompress) ---
        jbsr    .poison
        lea     CSelf_ZX0, a0
        lea     Art_Staging_Buffer, a1
        jbsr    Art_Decompress
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare
        rts

    .poison:
        lea     Art_Staging_Buffer, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        move.w  #$A5A5, d0                  // must match generator POISON_WORD
    .poison_loop:
        move.w  d0, (a1)+
        dbf     d1, .poison_loop
        rts

    .checksum:
        // Out: d0.w = additive word checksum over the payload region
        // Clobbers: d1, a1
        lea     Art_Staging_Buffer, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        moveq   #0, d0
    .sum_loop:
        add.w   (a1)+, d0
        dbf     d1, .sum_loop
        rts

    .byte_compare:
        // Word-by-word compare of Art_Staging_Buffer against CSelf_Expected.
        // Counts mismatches in d0.w; asserts d0.w == 0 on exit.
        // Clobbers: d0, d1, a0, a1
        lea     Art_Staging_Buffer, a0
        lea     CSelf_Expected, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        moveq   #0, d0
    .cmp_loop:
        cmpm.w  (a0)+, (a1)+
        beq     .cmp_match
        addq.w  #1, d0
    .cmp_match:
        dbf     d1, .cmp_loop
        assert.w d0, eq, #0
        rts
}

// -----------------------------------------------
// Golden vectors — one payload, three encodings + the expected plaintext.
// Each blob is the SAME generated file the build writes
// (tools/gen_compression_vectors.py); `embed` reads it root-relative. These
// labels sit immediately after the code, so the module region runs
// [CompressionSelfTest, next placement) — the exact span the AS `include` used
// to fill.
//
// Each item declares `(align: 2)`: the runtime `lea CSelf_*, a0` + word ops need
// every label word-aligned. Per-item alignment pins each base to a word boundary
// independent of what precedes it, so an odd blob gets a single pad byte instead
// of misaligning the next label. Word alignment is relaxation-invariant (every
// m68k relaxation delta is even), so the pad survives the CompressionSelfTest
// proc's branch relaxables above; a link-time congruence assert backstops the
// final address. Today every blob is even-length, so every pad is zero bytes.
// -----------------------------------------------
pub data CSelf_S4LZ_Plain (align: 2) = embed("engine/debug/generated/s4lz_plain.bin")
pub data CSelf_S4LZ_Dict  (align: 2) = embed("engine/debug/generated/s4lz_dict.bin")
pub data CSelf_Dict_Blob  (align: 2) = embed("engine/debug/generated/s4lz_dict_blob.bin")
pub data CSelf_ZX0        (align: 2) = embed("engine/debug/generated/zx0.bin")
pub data CSelf_Expected   (align: 2) = embed("engine/debug/generated/payload.bin")
