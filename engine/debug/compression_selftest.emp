// DEBUG boot self-test — 68000 decompressors verified against the build encoders
//
// This module exists ONLY in the debug shape: the build/harness includes it
// only when DEBUG=1 — the plain shape carries zero bytes and no symbols. The
// five
// golden vectors are `.emp`-native: the CSelf_* labels below `embed()` the
// blobs tools/gen_compression_vectors.py writes, and the three CSELF_* values
// are `use`d from the generated constants module (that generator is their sole
// author — nothing here hardcodes them).

module engine.compression_selftest in compression_selftest

use engine.compression_vectors.{CSELF_PAYLOAD_SIZE, CSELF_PAYLOAD_SUM, CSELF_DICT_LEN}
use engine.structs.{Act, PageManifest}
use engine.constants.{ART_HDR_SIZE, ART_HDR_VERSION, ART_VER_ZX0, ART_STAGING_BUFFER_SIZE, BLOCK_RAW_SIZE, BLOCK_STAGE_SLOTS, ART_PAGE_FORM_ZX0}

// Equivalence-walk buffer sizing (comptime, zero bytes): the largest act-pool page
// is ART_STAGING_BUFFER_SIZE (= one decompressed pool page). Buffer A =
// Art_Staging_Buffer is sized to it by construction; buffer B = Block_Stage_Buffers
// must be at least as large, or the largest page's ZX0R output would overrun it.
ensure(BLOCK_RAW_SIZE * BLOCK_STAGE_SLOTS >= ART_STAGING_BUFFER_SIZE,
       "CompressionSelfTest: Block_Stage_Buffers (equivalence buffer B) is smaller than the largest act-pool page")

// The three golden vectors decode into Art_Staging_Buffer (buffer A); the payload
// must fit the DEDICATED staging buffer (2048 B since the P2b cutover, no longer
// the 9,600-B tile-cache alias). Mirrors tools/gen_compression_vectors.py's bound.
ensure(CSELF_PAYLOAD_SIZE <= ART_STAGING_BUFFER_SIZE,
       "CompressionSelfTest: golden payload exceeds Art_Staging_Buffer (2048 B)")

// Addressing modes: every CSelf_*/Art_Staging_Buffer operand is spelled BARE
// and the width rule picks the mode per shape — Art_Staging_Buffer at
// $FFFF0000 is always abs.l; the CSelf_* ROM labels sat below $8000 (abs.w)
// until the bug005-sprites-player parcel's DEBUG growth pushed Config-A past
// the window (2026-08-03). DECISION: the per-shape widening to abs.l is
// ACCEPTED (+4 bytes x 5 sites, overflowing DEBUG shapes only; boot-time
// cold path, cycles irrelevant). The old `CSelf_Expected < $8000` fit-lock
// is retired — it existed to make exactly this crossing conscious, and the
// width rule handles either side correctly.

// -----------------------------------------------
// CompressionSelfTest — decode golden vectors, assert checksums
//
// The build emits one fixed payload compressed three ways (S4LZ v3 plain,
// S4LZ v3 + dictionary, ZX0) plus its expected 16-bit additive word
// checksum (tools/gen_compression_vectors.py — the generator PROVES at
// build time which decoder paths each vector exercises). This routine
// decompresses each vector into Art_Staging_Buffer at cold boot — before the
// buffer's first real use — and asserts the checksum. Any divergence
// between a 68000 decompressor and its encoder halts on the assert screen.
//
// The buffer is poisoned between vectors: all three share one payload, so
// a no-op decode would otherwise pass on the previous vector's output.
//
// In:  none
// Out: none
// Clobbers: d0-d4, a0-a4
// -----------------------------------------------
pub proc CompressionSelfTest () clobbers(d0-d4/a0-a4) {
        // --- S4LZ v3 plain through Art_Decompress dispatch (covers S4LZ branch) ---
        jbsr    .poison
        lea     CSelf_S4LZ_Plain, a0
        lea     Art_Staging_Buffer, a1
        jbsr    Art_Decompress
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- S4LZ v3 + dictionary (window rebase path) ---
        jbsr    .poison
        lea     CSelf_S4LZ_Dict, a0
        lea     Art_Staging_Buffer, a1
        lea     CSelf_Dict_Blob, a4
        move.w  #CSELF_DICT_LEN, d4
        jbsr    S4LZ_DecompressDict
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- ZX0 through the version-dispatch wrapper (Art_Decompress) ---
        jbsr    .poison
        lea     CSelf_ZX0, a0
        lea     Art_Staging_Buffer, a1
        jbsr    Art_Decompress
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- ZX0R resumable-decoder equivalence over the act art pool (P2a) ---
        // Proves the resumable stack-flat decoder (ZX0R_Decompress) produces output
        // byte-identical to the blocking ZX0_Decompress on every real act-pool page.
        // Decodes each page twice: blocking ZX0 -> Art_Staging_Buffer (buffer A),
        // resumable ZX0R -> Block_Stage_Buffers (buffer B), then asserts both produce
        // the wrapper's uncompressed length AND identical bytes. Runs at cold boot,
        // interrupts off (blocking use — preemption is Task 3's test), before the tile
        // cache goes live, so both buffers are free scratch and never overlap.
        // Only the sonic4 game ships an act art pool; demo defines HAS_ACT_ART_POOL 0
        // and this walk is comptime-discarded there (this engine module is demo-shared).
        //
        // MANIFEST V2 (P2b): act_art_pool_table is now a stride-sizeof(PageManifest)=8
        // array of {pm_source.l, pm_tiles.w, pm_form.b, pm_flags.b}. We stride 8, take
        // the source from pm_source, the uncompressed length from pm_tiles*TILE_SIZE,
        // SKIP pm_tiles==0 pages (mirrors page_in's size-0 guard), and equivalence-test
        // ONLY pm_form==ART_PAGE_FORM_ZX0 pages — ZX0-vs-ZX0R equivalence is meaningless
        // on a raw-direct page (ZX0R would misparse raw payload bytes). ZX0 pages still
        // carry the 4-byte wrapper, so both decoders take a0 PAST it.
    if HAS_ACT_ART_POOL == 1 {
        lea     OJZ_Act1_Descriptor, a0
        move.w  Act.act_art_pool_pages(a0), d4     // d4 = page count
        beq     .eq_done                            // empty pool -> nothing to check
        subq.w  #1, d4                              // d4 = count-1 (dbf counter)
        movea.l Act.act_art_pool_table(a0), a4      // a4 = PageManifest table cursor (stride 8)
    .eq_page:
        move.w  PageManifest.pm_tiles(a4), d3       // d3 = decompressed tile count
        beq     .eq_next                            // size-0 page -> skip (page_in guard mirror)
        cmpi.b  #ART_PAGE_FORM_ZX0, PageManifest.pm_form(a4)
        bne     .eq_next                            // raw form -> ZX0R equivalence N/A, skip
        lsl.w   #5, d3                              // d3 = uncompressed bytes = tiles * TILE_SIZE(32)
        movea.l PageManifest.pm_source(a4), a3      // a3 = ZX0 page wrapper ptr

        lea     ART_HDR_SIZE(a3), a0               // a0 = ZX0 stream past the wrapper
        lea     Art_Staging_Buffer, a1
        jbsr    ZX0_Decompress                     // buffer A; d3/d4/a4 preserved
        move.l  a1, d0
        sub.l   #Art_Staging_Buffer, d0            // d0 = bytes A produced
        cmp.w   d3, d0
        bne     .eq_bad                             // A length != tiles*32

        lea     ART_HDR_SIZE(a3), a0               // (a3 still = wrapper ptr here)
        lea     Block_Stage_Buffers, a1
        lea     .eq_resume, a3                      // a3 = continuation (ZX0R jmp target)
        jbra    ZX0R_Decompress                    // buffer B; exits jmp (a3)
    .eq_resume:
        move.l  a1, d0
        sub.l   #Block_Stage_Buffers, d0           // d0 = bytes B produced
        cmp.w   d3, d0
        bne     .eq_bad                             // B length != tiles*32

        lea     Art_Staging_Buffer, a0
        lea     Block_Stage_Buffers, a1
        move.w  d3, d0
        lsr.w   #1, d0                              // page bytes = tiles*32 -> even -> words
        subq.w  #1, d0
    .eq_cmp:
        cmpm.w  (a0)+, (a1)+
        bne     .eq_bad
        dbf     d0, .eq_cmp
    .eq_next:
        lea     sizeof(PageManifest)(a4), a4       // advance to the next v2 record (stride 8)
        dbf     d4, .eq_page
        jbra    .eq_done                            // all pages matched -> skip the raise
    .eq_bad:
        if DEBUG == 1 {
            raise_error "CompressionSelfTest: ZX0R decode diverges from ZX0 on an act-pool page"
        }
    .eq_done:
    }
        rts

    .poison:
        lea     Art_Staging_Buffer, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        move.w  #$A5A5, d0                  // must match generator POISON_WORD
    .poison_loop:
        move.w  d0, (a1)+
        dbf     d1, .poison_loop
        rts

    .checksum:
        // Out: d0.w = additive word checksum over the payload region
        // Clobbers: d1, a1
        lea     Art_Staging_Buffer, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        moveq   #0, d0
    .sum_loop:
        add.w   (a1)+, d0
        dbf     d1, .sum_loop
        rts

    .byte_compare:
        // Word-by-word compare of Art_Staging_Buffer against CSelf_Expected.
        // Counts mismatches in d0.w; asserts d0.w == 0 on exit.
        // Clobbers: d0, d1, a0, a1
        lea     Art_Staging_Buffer, a0
        lea     CSelf_Expected, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        moveq   #0, d0
    .cmp_loop:
        cmpm.w  (a0)+, (a1)+
        beq     .cmp_match
        addq.w  #1, d0
    .cmp_match:
        dbf     d1, .cmp_loop
        assert.w d0, eq, #0
        rts
}

// -----------------------------------------------
// The blocking decompressors — DEBUG equipment owned by their SOLE consumer
// (F-6 ruling): release ships the streaming decoders only (ZX0R_Decompress /
// S4LZ_DecompressDict); the blocking pair below exists to give this self-test
// its version-dispatch and A/B-decode arms. Moving them here (from
// engine/level/load_art.emp + engine/compression/zx0.emp, both deleted paths)
// removed the last unreachable equipment bytes from release ROMs.
// -----------------------------------------------

// -----------------------------------------------
// Art_Decompress — version-dispatched blocking art decompressor.
//
// Every compressed art blob starts with the 4-byte wrapper
// [u16 BE uncompressed size][u8 flags][u8 version]:
//   version 1 (ART_VER_S4LZ) -> S4LZ_Decompress (parses the wrapper itself)
//   version 2 (ART_VER_ZX0)  -> ZX0_Decompress (wrapper skipped here)
// Callers must skip size-0 blobs BEFORE calling (empty stubs carry no
// decodable stream).
//
// Dispatch order (§2.2 — common case falls through): ZX0 is the common case
// on every production path. The two-tier split puts ZX0 on the load-time art
// tier, and every act-pool page the engine ships is a .zx0 blob
// (games/sonic4/data/generated/**/act_pool_page*.zx0); the S4LZ arm is
// reached only from the DEBUG compression self-test, which exercises both
// arms deliberately. So the ZX0 test is the not-taken branch.
//
// In:  a0 = source ROM pointer (wrapper at start, word-aligned)
//      a1 = destination buffer
// Out: a0 = past end of compressed data
// Clobbers: d0-d3, a1-a3 (the S4LZ path; of these the ZX0 path touches only
//      d0-d1 and the a1 cursor) — the exhaustive license: a4/d4 are preserved
//      on both paths and callers keep them live across the call.
//      a1 is the destination write cursor and is left wherever writing
//      stopped — not an output. The two arms do not agree on it: ZX0 always
//      produces it, but an S4LZ stream that decompresses to zero bytes never
//      writes it, leaving the caller's own dest start. The wrapper's size word
//      is the authoritative extent.
// -----------------------------------------------
pub proc Art_Decompress (a0: *u8, a1: *u8) clobbers(d0-d3/a1-a3) out(a0) {
        cmpi.b  #ART_VER_ZX0, ART_HDR_VERSION(a0)
        bne     .s4lz                           // rare arm out of line (§2.2)
        addq.l  #ART_HDR_SIZE, a0               // ZX0 stream starts past wrapper
        jbra    ZX0_Decompress
    .s4lz:
        jbra    S4LZ_Decompress                 // S4LZ_Decompress reads its own wrapper
}

// -----------------------------------------------
// ZX0_Decompress — blocking ZX0 stream decompressor
//
// Decodes the modern (V2) ZX0 format as emitted by salvador's default
// mode (tools/salvador — do NOT pass -classic). Bitstream decoder:
// byte-granular output, interlaced elias-gamma lengths — Kosinski-class
// speed. Budgeted ONLY for load-time paths (section preload window,
// level init); never call this per-frame.
//
// The build wraps every compressed art blob in a 4-byte header
// [u16 BE uncompressed size][u8 flags][u8 version=2]. That wrapper is
// OURS, not ZX0's — the caller peeks size/version and passes a0 already
// advanced past it (see Art_Decompress above in this module).
//
// In:  a0 = compressed ZX0 stream (PAST the 4-byte wrapper)
//      a1 = destination buffer
// Out: a0 = past end of compressed data
//      a1 = past end of decompressed data
// Clobbers: d0-d1 (d2/a2 used but saved/restored)
//
// Adapted from unzx0_68000.S (88-byte V2 depacker) by Emmanuel Marty:
//   https://github.com/emmanuel-marty/unzx0_68000
// Changes from the original: movea.l/adda.l mnemonics for address-register
// moves, house header. Algorithm untouched.
//
// ZX0 compression (c) 2021 Einar Saukas, https://github.com/einar-saukas/ZX0
//
// Copyright (C) 2021 Emmanuel Marty
//
// This software is provided 'as-is', without any express or implied
// warranty.  In no event will the authors be held liable for any damages
// arising from the use of this software.
//
// Permission is granted to anyone to use this software for any purpose,
// including commercial applications, and to alter it and redistribute it
// freely, subject to the following restrictions:
//
// 1. The origin of this software must not be misrepresented; you must not
//    claim that you wrote the original software. If you use this software
//    in a product, an acknowledgment in the product documentation would be
//    appreciated but is not required.
// 2. Altered source versions must be plainly marked as such, and must not be
//    misrepresented as being the original software.
// 3. This notice may not be removed or altered from any source distribution.
// -----------------------------------------------
// d2 (rep-offset) and a2 (backreference cursor) are scratch INSIDE the call
// but movem-preserved for the caller — `preserves(d2/a2)` is the enforced
// spelling (§5-verified). The single rts at `.got_elias` serves BOTH the
// internal `.get_elias` subroutine returns and, via `.done`'s restore, the
// proc exit — the only true exit path is the EOD branch through `.done`.
// Elias values accumulate in d0.l but both copy loops count with dbf (word):
// safe by construction — our u16 wrapper caps the uncompressed size at 65535,
// so no run length can exceed a word (upstream-exact; do not "fix").
pub proc ZX0_Decompress (a0: *u8, a1: *u8) clobbers(d0-d1) out(a0, a1) preserves(d2/a2) {
        movem.l a2/d2, -(sp)            // preserve registers
        moveq   #-128, d1               // initialize empty bit queue
                                        // plus bit to roll into carry
        moveq   #-1, d2                 // initialize rep-offset to 1

    .literals:
        jbsr    .get_elias              // read number of literals to copy
        subq.l  #1, d0                  // dbf will loop until d0 is -1, not 0
    .copy_lits:
        move.b  (a0)+, (a1)+            // copy literal byte
        dbf     d0, .copy_lits          // loop for all literal bytes

        add.b   d1, d1                  // read 'match or rep-match' bit
        bcs     .get_offset             // if 1: read offset, if 0: rep-match

    .rep_match:
        jbsr    .get_elias              // read match length (starts at 1)
    .do_copy:
        subq.l  #1, d0                  // dbf will loop until d0 is -1, not 0
    .do_copy_offs:
        movea.l a1, a2                  // calculate backreference address
        adda.l  d2, a2                  // (dest + negative match offset)
    .copy_match:
        move.b  (a2)+, (a1)+            // copy matched byte
        dbf     d0, .copy_match         // loop for all matched bytes

        add.b   d1, d1                  // read 'literal or match' bit
        bcc     .literals               // if 0: go copy literals

    .get_offset:
        moveq   #-2, d0                 // initialize value to $fe
        jbsr    .elias_loop             // read high byte of match offset
        addq.b  #1, d0                  // obtain negative offset high byte
        beq     .done                   // exit if EOD marker
        move.w  d0, d2                  // transfer negative high byte into d2
        lsl.w   #8, d2                  // shift it to make room for low byte

        moveq   #1, d0                  // initialize length value to 1
        move.b  (a0)+, d2               // read low byte of offset + 1 bit of len
        asr.l   #1, d2                  // shift len bit into carry/offset in place
        bcs     .do_copy_offs           // if len bit is set, no need for more
        jbsr    .elias_bt               // read rest of elias-encoded match length
        jbra    .do_copy_offs           // go copy match

    .get_elias:
        moveq   #1, d0                  // initialize value to 1
    .elias_loop:
        add.b   d1, d1                  // shift bit queue, high bit into carry
        bne     .got_bit                // queue not empty, bits remain
        move.b  (a0)+, d1               // read 8 new bits
        addx.b  d1, d1                  // shift bit queue, high bit into carry
                                        // and shift 1 from carry into bit queue

    .got_bit:
        bcs     .got_elias              // done if control bit is 1
    .elias_bt:
        add.b   d1, d1                  // read data bit
        addx.l  d0, d0                  // shift data bit into value in d0
        jbra    .elias_loop             // keep reading

    .done:
        movem.l (sp)+, a2/d2            // restore preserved registers, fall into the shared rts
    .got_elias:
        rts                             // BOTH the .get_elias subroutine return (bcs lands here,
                                        // skipping the restore) AND the proc exit via .done
}

// -----------------------------------------------
// Golden vectors — one payload, three encodings + the expected plaintext.
// Each blob is the SAME generated file the build writes
// (tools/gen_compression_vectors.py); `embed` reads it root-relative. These
// labels sit immediately after the code, so the module region runs
// [CompressionSelfTest, next placement) — the exact span the AS `include` used
// to fill.
//
// Each item declares `(align: 2)`: the runtime `lea CSelf_*, a0` + word ops need
// every label word-aligned. Per-item alignment pins each base to a word boundary
// independent of what precedes it, so an odd blob gets a single pad byte instead
// of misaligning the next label. Word alignment is relaxation-invariant (every
// m68k relaxation delta is even), so the pad survives the CompressionSelfTest
// proc's branch relaxables above; a link-time congruence assert backstops the
// final address. Today every blob is even-length, so every pad is zero bytes.
// -----------------------------------------------
pub data CSelf_S4LZ_Plain (align: 2) = embed("engine/debug/generated/s4lz_plain.bin")
pub data CSelf_S4LZ_Dict  (align: 2) = embed("engine/debug/generated/s4lz_dict.bin")
pub data CSelf_Dict_Blob  (align: 2) = embed("engine/debug/generated/s4lz_dict_blob.bin")
pub data CSelf_ZX0        (align: 2) = embed("engine/debug/generated/zx0.bin")
pub data CSelf_Expected   (align: 2) = embed("engine/debug/generated/payload.bin")
