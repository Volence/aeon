// DEBUG boot self-test — 68000 decompressors verified against the build encoders
//
// This module exists ONLY in the debug shape: the build/harness includes it
// only when DEBUG=1 — the plain shape carries zero bytes and no symbols. The
// five
// golden vectors are `.emp`-native: the CSelf_* labels below `embed()` the
// blobs tools/gen_compression_vectors.py writes, and the three CSELF_* values
// are `use`d from the generated constants module (that generator is their sole
// author — nothing here hardcodes them).

module engine.compression_selftest in compression_selftest

use engine.compression_vectors.{CSELF_PAYLOAD_SIZE, CSELF_PAYLOAD_SUM, CSELF_DICT_LEN}
use engine.structs.{Act, PageManifest}
use engine.constants.{ART_HDR_SIZE, ART_STAGING_BUFFER_SIZE, BLOCK_RAW_SIZE, BLOCK_STAGE_SLOTS, ART_PAGE_FORM_ZX0}

// Equivalence-walk buffer sizing (comptime, zero bytes): the largest act-pool page
// is ART_STAGING_BUFFER_SIZE (= one decompressed pool page). Buffer A =
// Art_Staging_Buffer is sized to it by construction; buffer B = Block_Stage_Buffers
// must be at least as large, or the largest page's ZX0R output would overrun it.
ensure(BLOCK_RAW_SIZE * BLOCK_STAGE_SLOTS >= ART_STAGING_BUFFER_SIZE,
       "CompressionSelfTest: Block_Stage_Buffers (equivalence buffer B) is smaller than the largest act-pool page")

// Addressing modes: every CSelf_*/Art_Staging_Buffer operand is spelled BARE
// and the width rule picks the mode per shape — Art_Staging_Buffer at
// $FFFF0000 is always abs.l; the CSelf_* ROM labels sat below $8000 (abs.w)
// until the bug005-sprites-player parcel's DEBUG growth pushed Config-A past
// the window (2026-08-03). DECISION: the per-shape widening to abs.l is
// ACCEPTED (+4 bytes x 5 sites, overflowing DEBUG shapes only; boot-time
// cold path, cycles irrelevant). The old `CSelf_Expected < $8000` fit-lock
// is retired — it existed to make exactly this crossing conscious, and the
// width rule handles either side correctly.

// -----------------------------------------------
// CompressionSelfTest — decode golden vectors, assert checksums
//
// The build emits one fixed payload compressed three ways (S4LZ v3 plain,
// S4LZ v3 + dictionary, ZX0) plus its expected 16-bit additive word
// checksum (tools/gen_compression_vectors.py — the generator PROVES at
// build time which decoder paths each vector exercises). This routine
// decompresses each vector into Art_Staging_Buffer at cold boot — before the
// buffer's first real use — and asserts the checksum. Any divergence
// between a 68000 decompressor and its encoder halts on the assert screen.
//
// The buffer is poisoned between vectors: all three share one payload, so
// a no-op decode would otherwise pass on the previous vector's output.
//
// In:  none
// Out: none
// Clobbers: d0-d4, a0-a4
// -----------------------------------------------
pub proc CompressionSelfTest () clobbers(d0-d4/a0-a4) {
        // --- S4LZ v3 plain through Art_Decompress dispatch (covers S4LZ branch) ---
        jbsr    .poison
        lea     CSelf_S4LZ_Plain, a0
        lea     Art_Staging_Buffer, a1
        jbsr    Art_Decompress
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- S4LZ v3 + dictionary (window rebase path) ---
        jbsr    .poison
        lea     CSelf_S4LZ_Dict, a0
        lea     Art_Staging_Buffer, a1
        lea     CSelf_Dict_Blob, a4
        move.w  #CSELF_DICT_LEN, d4
        jbsr    S4LZ_DecompressDict
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- ZX0 through the version-dispatch wrapper (Art_Decompress) ---
        jbsr    .poison
        lea     CSelf_ZX0, a0
        lea     Art_Staging_Buffer, a1
        jbsr    Art_Decompress
        jbsr    .checksum
        assert.w d0, eq, #CSELF_PAYLOAD_SUM
        jbsr    .byte_compare

        // --- ZX0R resumable-decoder equivalence over the act art pool (P2a) ---
        // Proves the resumable stack-flat decoder (ZX0R_Decompress) produces output
        // byte-identical to the blocking ZX0_Decompress on every real act-pool page.
        // Decodes each page twice: blocking ZX0 -> Art_Staging_Buffer (buffer A),
        // resumable ZX0R -> Block_Stage_Buffers (buffer B), then asserts both produce
        // the wrapper's uncompressed length AND identical bytes. Runs at cold boot,
        // interrupts off (blocking use — preemption is Task 3's test), before the tile
        // cache goes live, so both buffers are free scratch and never overlap.
        // Only the sonic4 game ships an act art pool; demo defines HAS_ACT_ART_POOL 0
        // and this walk is comptime-discarded there (this engine module is demo-shared).
        //
        // MANIFEST V2 (P2b): act_art_pool_table is now a stride-sizeof(PageManifest)=8
        // array of {pm_source.l, pm_tiles.w, pm_form.b, pm_flags.b}. We stride 8, take
        // the source from pm_source, the uncompressed length from pm_tiles*TILE_SIZE,
        // SKIP pm_tiles==0 pages (mirrors page_in's size-0 guard), and equivalence-test
        // ONLY pm_form==ART_PAGE_FORM_ZX0 pages — ZX0-vs-ZX0R equivalence is meaningless
        // on a raw-direct page (ZX0R would misparse raw payload bytes). ZX0 pages still
        // carry the 4-byte wrapper, so both decoders take a0 PAST it.
    if HAS_ACT_ART_POOL == 1 {
        lea     OJZ_Act1_Descriptor, a0
        move.w  Act.act_art_pool_pages(a0), d4     // d4 = page count
        beq     .eq_done                            // empty pool -> nothing to check
        subq.w  #1, d4                              // d4 = count-1 (dbf counter)
        movea.l Act.act_art_pool_table(a0), a4      // a4 = PageManifest table cursor (stride 8)
    .eq_page:
        move.w  PageManifest.pm_tiles(a4), d3       // d3 = decompressed tile count
        beq     .eq_next                            // size-0 page -> skip (page_in guard mirror)
        cmpi.b  #ART_PAGE_FORM_ZX0, PageManifest.pm_form(a4)
        bne     .eq_next                            // raw form -> ZX0R equivalence N/A, skip
        lsl.w   #5, d3                              // d3 = uncompressed bytes = tiles * TILE_SIZE(32)
        movea.l PageManifest.pm_source(a4), a3      // a3 = ZX0 page wrapper ptr

        lea     ART_HDR_SIZE(a3), a0               // a0 = ZX0 stream past the wrapper
        lea     Art_Staging_Buffer, a1
        jbsr    ZX0_Decompress                     // buffer A; d3/d4/a4 preserved
        move.l  a1, d0
        sub.l   #Art_Staging_Buffer, d0            // d0 = bytes A produced
        cmp.w   d3, d0
        bne     .eq_bad                             // A length != tiles*32

        lea     ART_HDR_SIZE(a3), a0               // (a3 still = wrapper ptr here)
        lea     Block_Stage_Buffers, a1
        lea     .eq_resume, a3                      // a3 = continuation (ZX0R jmp target)
        jbra    ZX0R_Decompress                    // buffer B; exits jmp (a3)
    .eq_resume:
        move.l  a1, d0
        sub.l   #Block_Stage_Buffers, d0           // d0 = bytes B produced
        cmp.w   d3, d0
        bne     .eq_bad                             // B length != tiles*32

        lea     Art_Staging_Buffer, a0
        lea     Block_Stage_Buffers, a1
        move.w  d3, d0
        lsr.w   #1, d0                              // page bytes = tiles*32 -> even -> words
        subq.w  #1, d0
    .eq_cmp:
        cmpm.w  (a0)+, (a1)+
        bne     .eq_bad
        dbf     d0, .eq_cmp
    .eq_next:
        lea     sizeof(PageManifest)(a4), a4       // advance to the next v2 record (stride 8)
        dbf     d4, .eq_page
        jbra    .eq_done                            // all pages matched -> skip the raise
    .eq_bad:
        if DEBUG == 1 {
            raise_error "CompressionSelfTest: ZX0R decode diverges from ZX0 on an act-pool page"
        }
    .eq_done:
    }
        rts

    .poison:
        lea     Art_Staging_Buffer, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        move.w  #$A5A5, d0                  // must match generator POISON_WORD
    .poison_loop:
        move.w  d0, (a1)+
        dbf     d1, .poison_loop
        rts

    .checksum:
        // Out: d0.w = additive word checksum over the payload region
        // Clobbers: d1, a1
        lea     Art_Staging_Buffer, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        moveq   #0, d0
    .sum_loop:
        add.w   (a1)+, d0
        dbf     d1, .sum_loop
        rts

    .byte_compare:
        // Word-by-word compare of Art_Staging_Buffer against CSelf_Expected.
        // Counts mismatches in d0.w; asserts d0.w == 0 on exit.
        // Clobbers: d0, d1, a0, a1
        lea     Art_Staging_Buffer, a0
        lea     CSelf_Expected, a1
        move.w  #CSELF_PAYLOAD_SIZE/2-1, d1
        moveq   #0, d0
    .cmp_loop:
        cmpm.w  (a0)+, (a1)+
        beq     .cmp_match
        addq.w  #1, d0
    .cmp_match:
        dbf     d1, .cmp_loop
        assert.w d0, eq, #0
        rts
}

// -----------------------------------------------
// Golden vectors — one payload, three encodings + the expected plaintext.
// Each blob is the SAME generated file the build writes
// (tools/gen_compression_vectors.py); `embed` reads it root-relative. These
// labels sit immediately after the code, so the module region runs
// [CompressionSelfTest, next placement) — the exact span the AS `include` used
// to fill.
//
// Each item declares `(align: 2)`: the runtime `lea CSelf_*, a0` + word ops need
// every label word-aligned. Per-item alignment pins each base to a word boundary
// independent of what precedes it, so an odd blob gets a single pad byte instead
// of misaligning the next label. Word alignment is relaxation-invariant (every
// m68k relaxation delta is even), so the pad survives the CompressionSelfTest
// proc's branch relaxables above; a link-time congruence assert backstops the
// final address. Today every blob is even-length, so every pad is zero bytes.
// -----------------------------------------------
pub data CSelf_S4LZ_Plain (align: 2) = embed("engine/debug/generated/s4lz_plain.bin")
pub data CSelf_S4LZ_Dict  (align: 2) = embed("engine/debug/generated/s4lz_dict.bin")
pub data CSelf_Dict_Blob  (align: 2) = embed("engine/debug/generated/s4lz_dict_blob.bin")
pub data CSelf_ZX0        (align: 2) = embed("engine/debug/generated/zx0.bin")
pub data CSelf_Expected   (align: 2) = embed("engine/debug/generated/payload.bin")
