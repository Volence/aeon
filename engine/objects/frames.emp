// frame_piece_count — read a sprite frame's piece-count word (comptime-fn template)
//
// A mappings frame begins with 4 bounding-box bytes, then the piece-count word
// at FRAME_PIECE_COUNT (+4). Callers hold the frame's base pointer and a
// pre-doubled word offset into the frame table; this template reads the count:
//
//   move.w  FRAME_PIECE_COUNT(base, off.w), dest
//
// Register contract:
//   base — frame-table base pointer (An, read-only)
//   off  — word offset to the frame within the table (Dn, read-only, .w index)
//   dest — receives the piece-count word (Dn)
//
// NOT yet the single .emp source of truth for the +4
// offset: sprites.emp imports FRAME_PIECE_COUNT and spells the read itself at
// two sites, because it has already `lea`'d the frame offset into its base
// register (it needs the frame pointer for FRAME_BBOX_*/FRAME_PIECES anyway)
// and so needs a DISPLACEMENT form, not this indexed one. A two-argument
// sibling would make the claim true — ledgered.
//
// Pure comptime-fn module: opens no section and emits ZERO bytes anywhere in
// the ROM — bytes appear only where a consumer splices the template.
module engine.objects.frames

use engine.constants.{FRAME_PIECE_COUNT}
use engine.objects.sst.{Sst}

pub comptime fn frame_piece_count(base: Reg, off: Reg, dest: Reg) -> Code {
    return asm { move.w FRAME_PIECE_COUNT({base}, {off}.w), {dest} }
}

// refresh_piece_count — recompute an SST's cached sprite_piece_count AND
// cached frame-data offset (Sst.frame_off, the H1 render cache) from the
// frame its `mappings`/`mapping_frame` currently name.
//
// The engine needs this in two places that do NOT share a proc: the animator
// (after an anim script changes the frame) and the child/effect spawners
// (after a fresh slot inherits its parent's mappings). They could call one
// another, but they hold the SST in different registers and have different
// preservation duties, and the spawn path would pay a cross-region call for
// nine instructions. So the SHAPE is the shared thing — this template is its
// single source of truth, spliced into both.
//
// Register contract:
//   sst     — the SST pointer (An, read-only)
//   ptr     — scratch address register; receives the mappings pointer (An)
//   scratch — scratch data register; the frame offset, then the count (Dn)
//
// A null `mappings` leaves `sprite_piece_count` untouched (a slot with no
// mappings draws nothing, so a stale count cannot be observed) but writes 0
// to `frame_off` — the render consumers guard on mappings before adding the
// cache, so the zero is a defined default, never a dangling offset.
pub comptime fn refresh_piece_count(sst: Reg, ptr: Reg, scratch: Reg) -> Code {
    return asm {
        movea.l Sst.mappings({sst}), {ptr}
        move.l  {ptr}, {scratch}
        beq     .no_mappings
        moveq   #0, {scratch}
        move.b  Sst.mapping_frame({sst}), {scratch}
        add.w   {scratch}, {scratch}             // frame index -> word offset
        move.w  ({ptr},{scratch}.w), {scratch}   // offset to this frame's data
        move.w  {scratch}, Sst.frame_off({sst})  // H1 cache: frame-data offset
        // frame header: 4 signed bbox bytes (FRAME_BBOX_*), then the
        // piece-count word at FRAME_PIECE_COUNT, then pieces at FRAME_PIECES
        move.w  FRAME_PIECE_COUNT({ptr}, {scratch}.w), {scratch}
        move.b  {scratch}, Sst.sprite_piece_count({sst})
        jbra    .rpc_done
    .no_mappings:
        clr.w   Sst.frame_off({sst})             // defined default for the H1 cache
    .rpc_done:
    }
}
