// engine.objects.mapping_dsl — the sprite-mapping authoring DSL.
//
// The VDP mapping format a game's `offsets` frame index is built from: the
// single-piece frame record and the comptime helpers that pack it. A frame
// record is the 4-byte signed bounding box (far edges), a piece count word, then
// that many 8-byte VDP pieces (Y offset, size|link, tile attrs, X offset).
//
// This is a types + comptime-fn module: it emits no bytes. Games `use` it so the
// mapping shape is authored once (the demo template and the sonic4 test mappings
// share this home).
module engine.objects.mapping_dsl

// One VDP sprite piece: Y offset, size byte (spr_size), link placeholder, tile
// attribute word (relative to art_tile), X offset.
pub struct MapPiece {
    y_off: i16,
    size:  u8,
    link:  u8,
    tile:  u16,
    x_off: i16,
}

// A single-piece frame: signed bbox (far edges), a piece count of 1, the piece.
pub struct MapFrame1 {
    x_min: i8,
    x_max: i8,
    y_min: i8,
    y_max: i8,
    piece_count: u16,
    piece: MapPiece,
}

// A centered single-piece frame: bbox = (-half, +half) each axis, the piece
// offset to center (y_off/x_off = -half). w/h are cell counts (8px); tile is the
// base tile index. The size byte is the VDP packing: (w-1) in bits 3:2,
// (h-1) in bits 1:0 (sprites.emp size_link and hardware agree).
pub comptime fn centered(half: int, w: int where 1..4, h: int where 1..4, tile: int) -> MapFrame1 {
    return MapFrame1{
        x_min: -half,
        x_max: half,
        y_min: -half,
        y_max: half,
        piece_count: 1,
        piece: MapPiece{
            y_off: -half,
            size:  ((w - 1) << 2) | (h - 1),
            link:  0,
            tile:  tile,
            x_off: -half,
        },
    }
}

// One piece at an EXPLICIT offset from the object's origin — the general form
// that `centered` is the symmetric special case of. w/h are cell counts (8px);
// `tile` is the attribute word the render loop ADDS to the object's art_tile, so
// flip bits belong in it (sprites.emp tile_term). The `link` byte is a pad here
// exactly as it is in `centered`: the SAT writer overwrites it with its own
// chain counter (sprites.emp size_link).
//
// Wanted by any frame whose art does not sit centred on the object's origin — a
// spring's squash frame sinks 4px and its extend frame lifts 12px off the same
// origin, and neither is expressible through `centered(half:)`.
pub comptime fn piece(x: int, y: int, w: int where 1..4, h: int where 1..4, tile: int) -> MapPiece {
    return MapPiece{
        y_off: y,
        size:  ((w - 1) << 2) | (h - 1),
        link:  0,
        tile:  tile,
        x_off: x,
    }
}

// A two-piece frame. Byte-for-byte a MapFrame1 with a second MapPiece appended,
// which is exactly what the render loop expects: it reads the count at
// FRAME_PIECE_COUNT (+4) and walks `count` consecutive MapPiece records from
// FRAME_PIECES (+6) (sprites.emp Render_Sprites). Nothing in the loop is arity-aware —
// this struct exists so the COUNT and the number of pieces cannot disagree,
// because a MapFrame1 with `piece_count: 2` would have the SAT writer read six
// bytes of whatever the placer put after the frame and draw it as a sprite.
//
// Wanted by any sprite whose silhouette is not one VDP piece. The spring is the
// first: its plate is 4x1 and its coil 2x1 or 2x3, and a single piece large
// enough to cover both would be 4x3 of mostly-empty tiles — 12 tiles where 6 do.
pub struct MapFrame2 {
    x_min: i8,
    x_max: i8,
    y_min: i8,
    y_max: i8,
    piece_count: u16,
    piece0: MapPiece,
    piece1: MapPiece,
}

// The layout claim above, made checkable: the second piece must begin exactly
// one MapPiece past the first, or the render loop's `lea`-and-stride walk reads
// a misaligned record. sizeof/offsetof are comptime, so this costs no bytes.
ensure(offsetof(MapFrame2, piece1) - offsetof(MapFrame2, piece0) == sizeof(MapPiece),
       "MapFrame2's pieces must be CONTIGUOUS — the render loop strides by sizeof(MapPiece) from FRAME_PIECES and does not re-read a per-piece offset")
// …and it must share MapFrame1's HEADER layout, spelled as two guards because
// the render loop reaches the count and the first piece at FIXED offsets and has
// no idea which of the two structs it is walking.
ensure(offsetof(MapFrame2, piece_count) == offsetof(MapFrame1, piece_count),
       "MapFrame2's piece count must sit at MapFrame1's offset — the render loop reads FRAME_PIECE_COUNT blind")
ensure(offsetof(MapFrame2, piece0) == offsetof(MapFrame1, piece),
       "MapFrame2's first piece must sit at MapFrame1's offset — the render loop lea's FRAME_PIECES blind")

// A non-square witness locks the packing orientation: every live caller is
// square (where the swap is invisible), so this is the one guard that makes a
// width/height transposition a build error instead of a CRC-silent latent bug.
ensure(centered(half: 8, w: 2, h: 1, tile: 0).piece.size == 0b0100,
       "sprSize must pack (w-1) in bits 3:2 and (h-1) in bits 1:0")

// The same witness against `piece`, spelled INDEPENDENTLY rather than by
// comparing the two constructors to each other: they pack the size byte with two
// separate expressions, so a transposition introduced in one has to fail on its
// own terms. A constructor-vs-constructor guard would go green if both drifted
// the same way, which is how a shared-helper refactor silently voids a guard.
ensure(piece(x: 0, y: 0, w: 2, h: 1, tile: 0).size == 0b0100,
       "piece() must pack (w-1) in bits 3:2 and (h-1) in bits 1:0, as centered() does")
