// Entity window — camera-driven sliding entity loader
// §4.9: rings and objects load/despawn based on camera proximity
//
// Build-shape inputs (-D NAME=0|1, the mt_bank/game_loop convention): DEBUG
// gates the list-index range asserts, the park no-dup invariant, and the
// single-axis slide invariant. A bare `assert` self-gates on DEBUG
// (core.emp precedent); multi-line debug blocks wrap in `if DEBUG == 1 {}`
// because their non-assert setup needs gating too.

module engine.objects.entity_window in entity_window

use engine.constants.{SLOT_TAG_UNTAGGED, SCREEN_WIDTH, SCREEN_HEIGHT}
use engine.constants.{SECTION_SIZE, SECTION_SIZE_SHIFT, SEC_VOID}
use engine.constants.{MAX_TRACKED_SECTIONS, MAX_LIST_ENTRIES, ENTITY_LOAD_BUFFER, ENTITY_DESPAWN_BUFFER}
use engine.constants.{ENTITY_LOAD_BUFFER_Y, ENTITY_DESPAWN_BUFFER_Y, ENTITY_LOADED_SLOT_SIZE, ENTITY_LOADED_OBJ_OFFSET}
use engine.constants.{ENTITY_RESCAN_COARSE_MASK, ENTITY_RESCAN_ROW_SIZE, COLLECTED_BITMASK_OFFSET, KILLED_BITMASK_OFFSET}
use engine.constants.{COLLECTED_EMPTY_TAG, COLLECTED_MASK_BYTES, OEF_TYPE_SHIFT, OEF_TYPE_MASK, OBJ_ENTRY_SIZE}
use engine.objects.sst.{Sst}
use engine.structs.{Sec, Act_grid_w_lo}
use engine.coords.{abs_w}

// GAME-config input (truth: games/<game>/config/constants.asm).
// COLLECTED_WINDOW_SLOTS VARIES per game (sonic4: 9; demo: 4), so the engine
// takes it as a comptime define (-D, the SOUND_DRIVER_ENABLED class) rather
// than hardcoding sonic4's 9 — the engine/game split's contract. The ensure
// below cross-checks it against the game's AS-side extern. COLLECTED_SLOT_SIZE
// / COLLECTED_PARK_SLOTS are ENGINE-invariant slot layout (every game's config
// carries the same values), so they stay engine consts, ensure-guarded.
const COLLECTED_SLOT_SIZE       = 34
const COLLECTED_PARK_SLOTS      = 4
const COLLECTED_PARK_ENTRY_SIZE = 1 + 2*COLLECTED_MASK_BYTES
const RING_BUFFER_ENTRY_SIZE    = 6

// EntityScanState — one scan-state record per tracked section (4 entries in
// Entity_Scan_State, $16 bytes each). TYPE-ONLY twin: emits zero bytes and
// gives typed `EntityScanState.ess_*(aN)` field access plus `sizeof`/`offsetof`
// in place of hand-carried displacement consts. This struct is the sole author
// of its layout: every field carries an `@` literal offset and the struct a
// `(size: $1A)`, both verified in-file; the build harvests `EntityScanState_len`
// for ram.asm's `ds` reservation. This struct has a single consumer (this
// module), so it lives here rather than in its own module — the complement to
// sst.emp's precedent that a SHARED struct earns its own.
struct EntityScanState (size: $1A) {
    ess_ring_right_idx: u16 @ $00,    // $00 — ring X-scan ratchet (right edge)
    ess_obj_right_idx: u16 @ $02,     // $02 — object X-scan ratchet (right edge)
    ess_rom_ring_ptr: u32 @ $04,      // $04 — ROM ring list pointer
    ess_rom_obj_ptr: u32 @ $08,       // $08 — ROM object list pointer
    ess_rom_type_tbl_ptr: u32 @ $0C,  // $0C — ROM type-table pointer
    ess_origin_x: u16 @ $10,          // $10 — section origin X (engine-space px)
    ess_section_id: u8 @ $12,         // $12 — flat section id
    ess_entry_idx: u8 @ $13,          // $13 — window entry index (0-3)
    ess_origin_y: u16 @ $14,          // $14 — section origin Y (engine-space px)
    ess_ring_next_x: u16 @ $16,       // $16 — engine-X of next ring entering right (trigger cache; $FFFF = none)
    ess_obj_next_x: u16 @ $18,        // $18 — engine-X of next object entering right (trigger cache; $FFFF = none)
}

// Sec (ROM section descriptor) + Act field access comes from the shared
// engine.structs module (`Sec.field(aN)`, the grid-dim low byte via Act_grid_w_lo).

// Drift-locks: every mirrored value pinned to its AS-side truth. A layout or
// value change on either side fails the link naming the constant.
// COLLECTED_WINDOW_SLOTS is a game-varying GAME->ENGINE `-D` interface value
// (native.rs emp_defines; sonic4 9, demo 4) with no `.emp`/AS authority to
// cross-check against — six-target byte-identity is its drift net (a wrong `-D`
// moves ROM bytes). COLLECTED_SLOT_SIZE/PARK_* are engine-invariant game config
// (game `.emp` / demo AS authority), so their link cross-checks stay.
ensure(extern("COLLECTED_SLOT_SIZE") == COLLECTED_SLOT_SIZE, "game config and entity_window.emp disagree on COLLECTED_SLOT_SIZE — update both")
ensure(extern("COLLECTED_PARK_SLOTS") == COLLECTED_PARK_SLOTS, "games/sonic4/config/constants.asm and entity_window.emp disagree on COLLECTED_PARK_SLOTS — update both")
ensure(extern("COLLECTED_PARK_ENTRY_SIZE") == COLLECTED_PARK_ENTRY_SIZE, "games/sonic4/config/constants.asm and entity_window.emp disagree on COLLECTED_PARK_ENTRY_SIZE — update both")
ensure(extern("RING_BUFFER_ENTRY_SIZE") == RING_BUFFER_ENTRY_SIZE, "games/sonic4/config/constants.asm and entity_window.emp disagree on RING_BUFFER_ENTRY_SIZE — update both")
// (Act/Sec field access comes from engine.structs, the sole layout author.)

// Loaded-mask geometry static asserts (AS `if <> / error` → ensure).
ensure(ENTITY_LOADED_SLOT_SIZE == 32, "EntityLoaded primitives assume 32-byte slots (lsl #5)")
ensure(ENTITY_LOADED_OBJ_OFFSET*8 == MAX_LIST_ENTRIES, "Loaded-mask half-slot does not cover MAX_LIST_ENTRIES bits")

// Section-size power-of-two invariant (SECTION_SIZE_SHIFT = log2 SECTION_SIZE).
ensure(SECTION_SIZE == 1 << SECTION_SIZE_SHIFT, "SECTION_SIZE_SHIFT out of sync with SECTION_SIZE")

// Load-bearing Y-band invariants (Y despawn / re-scan): the despawn hysteresis
// and the load buffer must each cover a full 128px coarse row, or band-edge
// entities churn / fast vertical travel skips a row between re-scans.
ensure((ENTITY_DESPAWN_BUFFER_Y - ENTITY_LOAD_BUFFER_Y) >= ENTITY_RESCAN_ROW_SIZE, "Y despawn hysteresis < coarse row size — band-edge entities will churn")
ensure(ENTITY_LOAD_BUFFER_Y >= ENTITY_RESCAN_ROW_SIZE, "ENTITY_LOAD_BUFFER_Y < coarse row size — vertical re-scan can skip entities")

// clear_slot_bitmasks — zero a collected-window slot's pad byte + both 16-byte
// bitmasks (ring collected + object killed); a0 = slot pointer, preserved.
// The tag byte at (a0) is stamped by the caller.
comptime fn clear_slot_bitmasks() -> Code {
    return asm {
        clr.b   1(a0)
        clr.l   COLLECTED_BITMASK_OFFSET(a0)
        clr.l   COLLECTED_BITMASK_OFFSET+4(a0)
        clr.l   COLLECTED_BITMASK_OFFSET+8(a0)
        clr.l   COLLECTED_BITMASK_OFFSET+12(a0)
        clr.l   KILLED_BITMASK_OFFSET(a0)
        clr.l   KILLED_BITMASK_OFFSET+4(a0)
        clr.l   KILLED_BITMASK_OFFSET+8(a0)
        clr.l   KILLED_BITMASK_OFFSET+12(a0)
    }
}

// =====================================================
// Rolling Collected/Killed Bitmask
// =====================================================

// -----------------------------------------------
// Collected_Init — fill all 9 slots with COLLECTED_EMPTY_TAG, empty the park
// Clobbers: d1, a0
// -----------------------------------------------
proc Collected_Init () clobbers(d1, a0) {
        lea     Ring_Collected_Window, a0
        moveq   #COLLECTED_WINDOW_SLOTS-1, d1
    .loop:
        move.b  #COLLECTED_EMPTY_TAG, (a0)
        clear_slot_bitmasks()
        lea     COLLECTED_SLOT_SIZE(a0), a0
        dbf     d1, .loop

        // park: ids only — mask bytes are never read until a park stamps an id
        lea     Ring_Collected_Park, a0
        moveq   #COLLECTED_PARK_SLOTS-1, d1
    .park_loop:
        move.b  #COLLECTED_EMPTY_TAG, (a0)
        lea     COLLECTED_PARK_ENTRY_SIZE(a0), a0
        dbf     d1, .park_loop
        clr.b   Collected_Park_Next
        rts
}

// -----------------------------------------------
// Collected_FindSlot — find bitmask slot for a section
//
// In:  d0.b = section_id
// Out: a0 = slot pointer, Z clear = found; Z set = not found
// Clobbers: d1
// -----------------------------------------------
proc Collected_FindSlot () clobbers(d1) out(a0) {
        lea     Ring_Collected_Window, a0
        moveq   #COLLECTED_WINDOW_SLOTS-1, d1
    .scan:
        cmp.b   (a0), d0
        beq     .found
        lea     COLLECTED_SLOT_SIZE(a0), a0
        dbf     d1, .scan
        moveq   #0, d1                  // Z set = not found
        rts
    .found:
        moveq   #1, d1                  // Z clear = found
        rts
}

// -----------------------------------------------
// Collected_CheckRing — test if ring was previously collected
//
// In:  d0.b = section_id
//      d1.w = list_index (0-based)
// Out: Z clear = collected (skip), Z set = uncollected (spawn)
// Clobbers: d2, a0
// -----------------------------------------------
proc Collected_CheckRing () clobbers(d2, a0) preserves(d1) {
        movem.l d1, -(sp)                       // Collected_FindSlot clobbers d1 — saved to honor preserves(d1); d0 it preserves
        jbsr    Collected_FindSlot
        movem.l (sp)+, d1
        beq     .uncollected

        assert.w d1, lo, #MAX_LIST_ENTRIES
        move.w  d1, d2
        lsr.w   #3, d2
        btst    d1, COLLECTED_BITMASK_OFFSET(a0, d2.w)
        rts

    .uncollected:
        moveq   #0, d2                  // Z set
        rts
}

// -----------------------------------------------
// Collected_MarkRing — mark ring as collected in bitmask
//
// In:  d2.b = section_id (from ring buffer entry)
//      d3.b = list_index (from ring buffer entry)
// Out: none
// Clobbers: d0-d1, a0
// -----------------------------------------------
pub proc Collected_MarkRing () clobbers(d0-d1, a0) {
        move.b  d2, d0
        jbsr    Collected_FindSlot
        beq     .done
        moveq   #0, d1
        move.b  d3, d1
        assert.w d1, lo, #MAX_LIST_ENTRIES
        move.w  d1, d0
        lsr.w   #3, d0
        bset    d1, COLLECTED_BITMASK_OFFSET(a0, d0.w)
    .done:
        rts
}

// -----------------------------------------------
// Killed_CheckObject — test if object was previously killed
//
// In:  d0.b = section_id
//      d1.w = list_index (0-based)
// Out: Z clear = killed (skip), Z set = alive (spawn)
// Clobbers: d2, a0
// -----------------------------------------------
proc Killed_CheckObject () clobbers(d2, a0) preserves(d1) {
        movem.l d1, -(sp)                       // Collected_FindSlot clobbers d1 — saved to honor preserves(d1); d0 it preserves
        jbsr    Collected_FindSlot
        movem.l (sp)+, d1
        beq     .alive

        assert.w d1, lo, #MAX_LIST_ENTRIES
        move.w  d1, d2
        lsr.w   #3, d2
        btst    d1, KILLED_BITMASK_OFFSET(a0, d2.w)
        rts

    .alive:
        moveq   #0, d2
        rts
}

// -----------------------------------------------
// Killed_MarkObject — mark object as killed in bitmask
// Also clears the loaded bit — a killed object's SST is gone, so the
// loaded mask must agree or respawn paths skip the (dead) slot forever.
//
// In:  d0.b = section_id
//      d1.b = list_index
// Out: none
// Clobbers: d0-d3, a0
// -----------------------------------------------
pub proc Killed_MarkObject () clobbers(d0-d3, a0) {
        move.b  d0, d3                  // section_id survives FindSlot for the loaded-bit clear
        move.w  d1, -(sp)
        jbsr    Collected_FindSlot
        move.w  (sp)+, d1
        beq     .markdone               // unsized: relaxes .w in DEBUG (assert expands between here and the target), .s in plain
        moveq   #0, d2
        move.b  d1, d2
        assert.w d2, lo, #MAX_LIST_ENTRIES
        move.w  d2, d0
        lsr.w   #3, d0
        bset    d2, KILLED_BITMASK_OFFSET(a0, d0.w)

        move.b  d3, d0                  // section_id
        jbsr    EntityWindow_EntryForSection
        tst.w   d0
        bmi     .markdone               // section untracked — no loaded bits
        move.w  d2, d1                  // list_index (d2 untouched by EntryForSection)
        moveq   #ENTITY_LOADED_OBJ_OFFSET, d2
        jbsr    EntityLoaded_Clear
    .markdone:
        rts
}

// -----------------------------------------------
// Collected_ClaimSlot — claim an empty slot for a section
// Fresh claims check the respawn park — a re-entering section's
// collected/killed state is copied back (§4.9.4).
//
// In:  d0.b = section_id
// Out: a0 = slot pointer
//      Z clear = success, Z set = no empty slots
// Clobbers: d1, a0-a1
// -----------------------------------------------
proc Collected_ClaimSlot () clobbers(d1, a1) out(a0) {
        jbsr    Collected_FindSlot
        bne     .already_owned

        lea     Ring_Collected_Window, a0
        moveq   #COLLECTED_WINDOW_SLOTS-1, d1
    .find:
        cmpi.b  #COLLECTED_EMPTY_TAG, (a0)
        beq     .claim
        lea     COLLECTED_SLOT_SIZE(a0), a0
        dbf     d1, .find
        moveq   #0, d1                 // Z set = no slot
        rts

    .claim:
        move.b  d0, (a0)
        clear_slot_bitmasks()
        jbsr    Collected_UnparkSlot    // jbsr spans the ParkSlot body — stays .w both shapes
    .already_owned:
        moveq   #1, d1                 // Z clear = ok
        rts
}

// -----------------------------------------------
// Collected_ParkSlot — save an evicted slot's state in the respawn park
// Pristine slots (all-zero masks) are NOT parked — restoring nothing
// equals default state, so parking them would only waste park capacity.
// Same-id entries are reused; otherwise the rolling index picks the
// oldest entry (overwrite) and advances. Cold path — bytewise copies
// because park entries are 33 bytes (unaligned).
//
// In:  a0 = window slot being evicted (id byte still stamped)
// Out: none
// Clobbers: d0-d1, a1
// -----------------------------------------------
proc Collected_ParkSlot () clobbers(d0-d1, a1) preserves(a0) {
        move.l  COLLECTED_BITMASK_OFFSET(a0), d0
        or.l    COLLECTED_BITMASK_OFFSET+4(a0), d0
        or.l    COLLECTED_BITMASK_OFFSET+8(a0), d0
        or.l    COLLECTED_BITMASK_OFFSET+12(a0), d0
        or.l    KILLED_BITMASK_OFFSET(a0), d0
        or.l    KILLED_BITMASK_OFFSET+4(a0), d0
        or.l    KILLED_BITMASK_OFFSET+8(a0), d0
        or.l    KILLED_BITMASK_OFFSET+12(a0), d0
        bne     .park
        rts                             // pristine — don't consume a park entry

    .park:
        move.b  (a0), d0                // section id
        lea     Ring_Collected_Park, a1
        moveq   #COLLECTED_PARK_SLOTS-1, d1
    .reuse_scan:
        cmp.b   (a1), d0
        beq     .write                  // park already holds this id — reuse
        lea     COLLECTED_PARK_ENTRY_SIZE(a1), a1
        dbf     d1, .reuse_scan

        // no existing entry — take the rolling slot and advance the index
        // (entry stride is 33 — step a pointer rather than decompose a multiply)
        lea     Ring_Collected_Park, a1
        move.b  Collected_Park_Next, d1
        ext.w   d1
        subq.w  #1, d1
        bmi     .index_done
    .index_step:
        lea     COLLECTED_PARK_ENTRY_SIZE(a1), a1
        dbf     d1, .index_step
    .index_done:
        addq.b  #1, Collected_Park_Next
        cmpi.b  #COLLECTED_PARK_SLOTS, Collected_Park_Next
        blo     .write
        clr.b   Collected_Park_Next

    .write:
        move.b  d0, (a1)+               // stamp id; a1 → park mask bytes
        move.l  a0, -(sp)
        lea     COLLECTED_BITMASK_OFFSET(a0), a0
        moveq   #COLLECTED_MASK_BYTES-1, d1
    .copy_ring:
        move.b  (a0)+, (a1)+
        dbf     d1, .copy_ring
        movea.l (sp), a0
        lea     KILLED_BITMASK_OFFSET(a0), a0
        moveq   #COLLECTED_MASK_BYTES-1, d1
    .copy_killed:
        move.b  (a0)+, (a1)+
        dbf     d1, .copy_killed
        movea.l (sp)+, a0

        if DEBUG == 1 {
            // no duplicate section ids in the park (reuse path must have caught them)
            move.w  d2, -(sp)
            lea     Ring_Collected_Park, a1
            moveq   #0, d1                  // match count
            moveq   #COLLECTED_PARK_SLOTS-1, d2
        .dup_scan:
            cmp.b   (a1), d0
            bne     .dup_next
            addq.b  #1, d1
        .dup_next:
            lea     COLLECTED_PARK_ENTRY_SIZE(a1), a1
            dbf     d2, .dup_scan
            move.w  (sp)+, d2
            assert.b d1, eq, #1
        }
        rts
}

// -----------------------------------------------
// Collected_UnparkSlot — restore parked state into a re-claimed slot
// On a park hit both masks are copied into the slot and the park entry
// is freed (id → COLLECTED_EMPTY_TAG). Miss is a no-op.
//
// In:  d0.b = section_id
//      a0   = freshly claimed window slot (masks zeroed)
// Out: none
// Clobbers: d1, a1
// -----------------------------------------------
proc Collected_UnparkSlot () clobbers(d1, a1) preserves(a0) {
        lea     Ring_Collected_Park, a1
        moveq   #COLLECTED_PARK_SLOTS-1, d1
    .scan:
        cmp.b   (a1), d0
        beq     .hit
        lea     COLLECTED_PARK_ENTRY_SIZE(a1), a1
        dbf     d1, .scan
        rts                             // not parked — fresh slot stays zeroed

    .hit:
        move.b  #COLLECTED_EMPTY_TAG, (a1)+     // free the park entry; a1 → masks
        move.l  a0, -(sp)
        lea     COLLECTED_BITMASK_OFFSET(a0), a0
        moveq   #COLLECTED_MASK_BYTES-1, d1
    .copy_ring:
        move.b  (a1)+, (a0)+
        dbf     d1, .copy_ring
        movea.l (sp), a0
        lea     KILLED_BITMASK_OFFSET(a0), a0
        moveq   #COLLECTED_MASK_BYTES-1, d1
    .copy_killed:
        move.b  (a1)+, (a0)+
        dbf     d1, .copy_killed
        movea.l (sp)+, a0
        rts
}

// -----------------------------------------------
// Collected_UpdateCenter — evict slots outside new 3×3 range (±1 in each axis)
// Radius ±1 gives a 3×3 = 9-section keep-neighborhood, matching COLLECTED_WINDOW_SLOTS.
// Increasing the radius beyond ±1 would overflow the 9 available slots.
// Evicted slots with any collected/killed bit park in the respawn buffer (§4.9.4).
//
// In:  d0.b = new center section_id
//      d1.b = grid_w
// Out: none
// Clobbers: d0-d5, a0-a1
// -----------------------------------------------
proc Collected_UpdateCenter () clobbers(d0-d5, a0-a1) {
        move.b  d0, Entity_Window_Center_ID

        // Compute center_x, center_y via repeated subtraction
        // center_y = id / grid_w, center_x = id % grid_w
        moveq   #0, d2
        move.b  d0, d2                  // center_id
        moveq   #0, d3
        move.b  d1, d3                  // grid_w
        moveq   #0, d4                  // center_y
    .div_center:
        cmp.w   d3, d2
        blo     .div_center_done
        sub.w   d3, d2
        addq.w  #1, d4
        jbra    .div_center
    .div_center_done:
        // d2 = center_x, d4 = center_y, d3 = grid_w (preserved)

        lea     Ring_Collected_Window, a0
        moveq   #COLLECTED_WINDOW_SLOTS-1, d5

    .slot_loop:
        move.b  (a0), d0
        cmpi.b  #COLLECTED_EMPTY_TAG, d0
        beq     .slot_next

        // Compute slot's grid coords
        moveq   #0, d1
        move.b  d0, d1                  // slot section_id
        moveq   #0, d0                  // slot_y
    .div_slot:
        cmp.w   d3, d1
        blo     .div_slot_done
        sub.w   d3, d1
        addq.w  #1, d0
        jbra    .div_slot
    .div_slot_done:
        // d1 = slot_x, d0 = slot_y

        // Check |slot_x - center_x| <= 1
        sub.w   d2, d1
        abs_w(d1)
        cmpi.w  #1, d1
        bhi     .evict

        // Check |slot_y - center_y| <= 1
        sub.w   d4, d0
        abs_w(d0)
        cmpi.w  #1, d0
        bls     .slot_next

    .evict:
        jbsr    Collected_ParkSlot      // preserves a0/d2-d5; clobbers d0-d1/a1 (dead here)
        move.b  #COLLECTED_EMPTY_TAG, (a0)
        clear_slot_bitmasks()

    .slot_next:
        lea     COLLECTED_SLOT_SIZE(a0), a0
        dbf     d5, .slot_loop
        rts
}

// =====================================================
// Loaded bitmasks — §4.9
// One ENTITY_LOADED_SLOT_SIZE (32-byte) slot per scan entry:
// bytes 0-15 ring bits, 16-31 object bits, bit = list_index (0-127).
// Set at spawn, cleared at despawn/removal, cleared wholesale when an
// entry's section changes (EntityWindow_InitSection). Window slides
// migrate surviving sections' masks to their new entries by identity
// (EntityWindow_MigrateMasks).
// Spawn paths test the bit first, which makes the X scan, the slide
// populate, and the vertical re-scan (EntityWindow_RescanY) mutually
// idempotent.
// =====================================================

// -----------------------------------------------
// EntityLoaded_Test — test a loaded bit
// In:  d0.b = entry index (0-3)
//      d1.w = list_index
//      d2.w = 0 (rings) or ENTITY_LOADED_OBJ_OFFSET (objects)
// Out: Z clear = loaded, Z set = not loaded
// Clobbers: d0, d2, a0
// -----------------------------------------------
pub proc EntityLoaded_Test () clobbers(d0, d2, a0) {
        assert.w d1, lo, #MAX_LIST_ENTRIES
        lsl.w   #5, d0                  // entry × ENTITY_LOADED_SLOT_SIZE
        add.w   d0, d2
        lea     Entity_Loaded_Masks, a0
        adda.w  d2, a0
        move.w  d1, d0
        lsr.w   #3, d0                  // byte offset; btst Dn,mem uses bit# mod 8
        btst    d1, (a0, d0.w)
        rts
}

// -----------------------------------------------
// EntityLoaded_Set — set a loaded bit (same inputs as Test)
// Clobbers: d0, d2, a0
// -----------------------------------------------
pub proc EntityLoaded_Set () clobbers(d0, d2, a0) {
        assert.w d1, lo, #MAX_LIST_ENTRIES
        lsl.w   #5, d0
        add.w   d0, d2
        lea     Entity_Loaded_Masks, a0
        adda.w  d2, a0
        move.w  d1, d0
        lsr.w   #3, d0
        bset    d1, (a0, d0.w)
        rts
}

// -----------------------------------------------
// EntityLoaded_Clear — clear a loaded bit (same inputs as Test)
// Clobbers: d0, d2, a0
// -----------------------------------------------
pub proc EntityLoaded_Clear () clobbers(d0, d2, a0) {
        assert.w d1, lo, #MAX_LIST_ENTRIES
        lsl.w   #5, d0
        add.w   d0, d2
        lea     Entity_Loaded_Masks, a0
        adda.w  d2, a0
        move.w  d1, d0
        lsr.w   #3, d0
        bclr    d1, (a0, d0.w)
        rts
}

// -----------------------------------------------
// EntityWindow_EntryForSection — map section_id → entry index
// In:  d0.b = section_id (a real id from a live entity — never SEC_VOID,
//      so void entries can't false-match)
// Out: d0.w = entry index 0-3, or -1 if untracked
// Clobbers: d1, a0
// -----------------------------------------------
pub proc EntityWindow_EntryForSection () clobbers(d1, a0) out(d0) {
        lea     Entity_Scan_State+offsetof(EntityScanState, ess_section_id), a0
        moveq   #0, d1
    .efs_loop:
        cmp.b   (a0), d0
        beq     .efs_found
        lea     sizeof(EntityScanState)(a0), a0
        addq.w  #1, d1
        cmpi.w  #MAX_TRACKED_SECTIONS, d1
        blo     .efs_loop
        moveq   #-1, d0
        rts
    .efs_found:
        move.w  d1, d0
        rts
}

// =====================================================
// Entity Window Core
// =====================================================

// -----------------------------------------------
// EntityWindow_InitSection — populate one EntityScanState entry
//
// In:  a0 = Sec struct pointer (ROM)
//      a1 = EntityScanState pointer (RAM)
//      d0.w = section origin X (engine-space)
//      d1.b = section_id
//      d2.w = section origin Y (engine-space)
//      d6.b = entry index (0-3)
// Out: none
// Clobbers: d3, a2 (mask clear)
// -----------------------------------------------
proc EntityWindow_InitSection () clobbers(d3, a2) {
        assert.l a0, ne, #0     // NULL Sec ptr = caller passed a void/out-of-grid slot

        // Loaded mask is per-entry state about ONE section — clear it when
        // this entry's section changes. Same-section re-init preserves the
        // bits; on a slide the entry's section changes, so this clears here
        // and EntityWindow_MigrateMasks copies survivors in.
        cmp.b   EntityScanState.ess_section_id(a1), d1
        beq     .same_section
        moveq   #0, d3
        move.b  d6, d3
        lsl.w   #5, d3                  // entry × ENTITY_LOADED_SLOT_SIZE (32)
        lea     Entity_Loaded_Masks, a2
        adda.w  d3, a2
        moveq   #ENTITY_LOADED_SLOT_SIZE/4-1, d3
    .clear_mask:
        clr.l   (a2)+
        dbf     d3, .clear_mask
    .same_section:

        move.l  Sec.sec_rings(a0), EntityScanState.ess_rom_ring_ptr(a1)
        move.l  Sec.sec_objects(a0), EntityScanState.ess_rom_obj_ptr(a1)
        move.l  Sec.sec_type_table(a0), EntityScanState.ess_rom_type_tbl_ptr(a1)
        move.w  d0, EntityScanState.ess_origin_x(a1)
        move.w  d2, EntityScanState.ess_origin_y(a1)
        move.b  d1, EntityScanState.ess_section_id(a1)
        move.b  d6, EntityScanState.ess_entry_idx(a1)
        clr.w   EntityScanState.ess_ring_right_idx(a1)
        clr.w   EntityScanState.ess_obj_right_idx(a1)
        // trigger caches cleared to 0 so the first post-init scan always runs
        // (0 < any right edge -> the section-loop gate never skips it)
        clr.w   EntityScanState.ess_ring_next_x(a1)
        clr.w   EntityScanState.ess_obj_next_x(a1)
        rts
}

// -----------------------------------------------
// EntityWindow_DeriveWindow — absolute window anchor from the WORLD camera
//
// The tracked 2×2 = the sections overlapped by the camera's DESPAWN envelope
// (the widest band), so any live windowed entity's section is always tracked.
// Envelope spans < SECTION_SIZE on both axes → always exactly 2 cols × 2 rows
// (screen+2×buffer < SECTION_SIZE on both axes — see engine.constants).
//
// Continuous-scroll: Camera_X/Y are WORLD px, so the anchor section is derived
// straight from the world camera.
//   sec_x0 = (Camera_X − ENTITY_DESPAWN_BUFFER) >> SECTION_SIZE_SHIFT
// asr floors toward −1 near the world origin (intentional); the unsigned grid
// range check in Section_GetSecPtrXY voids the resulting "negative" cell.
//
// Out: d2.b = sec_x0 (may be "negative"/past-grid; the grid range check voids
//             such cells downstream)
//      d3.b = sec_y0
//      d4.w = sec_x0 (word copy — entry origin derivation needs it)
//      d5.w = sec_y0 (word)
// Clobbers: d0
// -----------------------------------------------
proc EntityWindow_DeriveWindow () clobbers(d0) out(d2-d5) {
        move.w  Camera_X, d4            // world X px (16.16 high word)
        subi.w  #ENTITY_DESPAWN_BUFFER, d4
        moveq   #SECTION_SIZE_SHIFT, d0
        asr.w   d0, d4                  // d4 = sec_x0 (floor)
        bpl     .x0_ok                  // world-origin underflow: camera within
        moveq   #0, d4                  // ENTITY_DESPAWN_BUFFER of the LEFT edge → the
    .x0_ok:                             // anchor would be -1 ($FF as a byte), mis-parsed as
        move.w  Camera_Y, d5           // section 255 (NOT voided) and tripping the single-
        subi.w  #ENTITY_DESPAWN_BUFFER_Y, d5 // axis slide assert. Clamp to section 0, mirroring
        asr.w   d0, d5                  // the tile cache's Cache_Left_Col/Top_Row clamp
        bpl     .y0_ok                  // (tile_cache.asm).
        moveq   #0, d5
    .y0_ok:                             // clamp to section 0 to prevent -1 from being misinterpreted as section 255
        move.w  d4, d2                  // d2.b = sec_x0 (clamped to [0, grid))
        move.w  d5, d3                  // d3.b = sec_y0 (clamped)
        rts
}

// -----------------------------------------------
// EntityWindow_BuildEntries — (re)configure the 4 entries from the camera
// envelope (visibility-derived window — see spec 2026-06-11).
//
// Quadrants: entry 0 = (sec_x0, sec_y0) … entry 3 = (sec_x0+1, sec_y0+1).
// Stores the absolute anchor in Entity_Window_Anchor (the slide trigger
// reads it) and the column-0/row-0 WORLD origin
// bases in Entity_Window_OriginX/Y. Void quadrants ("negative"/past-grid
// coordinates via Section_GetSecPtrXY's unsigned range check) get
// SEC_VOID-stamped entries and a clear validity bit.
//
// In:  none (reads Camera_X/Y, Current_Act_Ptr)
// Out: Entity_Window_Active = validity mask; Entity_Window_Anchor +
//      Entity_Window_OriginX/Y updated
// Clobbers: d0-d7, a0-a3
// -----------------------------------------------
proc EntityWindow_BuildEntries () clobbers(d0-d7, a0-a3) {
        jbsr    EntityWindow_DeriveWindow       // d2/d3 = anchor, d4/d5 = sec_x0/sec_y0
        move.b  d2, Entity_Window_Anchor
        move.b  d3, Entity_Window_Anchor+1
        // origin bases: sec_x0/sec_y0 × SECTION_SIZE = world px of column-0/row-0
        // section left/top edge (signed words; "negative" cols are voided)
        moveq   #SECTION_SIZE_SHIFT, d0
        asl.w   d0, d4
        move.w  d4, Entity_Window_OriginX       // origin_x of column 0 (world px)
        asl.w   d0, d5
        move.w  d5, Entity_Window_OriginY       // origin_y of row 0 (world px)

        lea     Entity_Scan_State, a3
        moveq   #0, d7                  // d7 = validity mask
        moveq   #0, d6                  // d6 = entry index 0-3

    .entry_loop:
        // entry geometry from the stored anchor — d2/d3 don't survive the
        // loop body (d2 reused for origin_y, InitSection clobbers d3), so
        // reload each iteration
        move.b  Entity_Window_Anchor, d2        // d2 = sec_x0
        move.b  Entity_Window_Anchor+1, d3      // d3 = sec_y0
        move.w  d6, d0
        andi.w  #1, d0                  // d0 = column offset (entry & 1)
        add.b   d0, d2 as GridX         // d2 = sec_x0 + (entry & 1)
        move.w  d6, d1
        lsr.w   #1, d1                  // d1 = row offset (entry >> 1)
        add.b   d1, d3 as GridY         // d3 = sec_y0 + (entry >> 1)
        movea.l Current_Act_Ptr, a2
        jbsr    Section_GetSecPtrXY     // a0 = Sec ptr, Z set = out of grid
        beq     .void_entry             // (unsigned check voids "negative" bytes too)

        jbsr    Section_FlatIDXY        // d0.w = flat id (d2/d3/a2 preserved)
        move.w  d0, d1                  // d1.b = section_id

        // origins: column/row base + (entry bit) × SECTION_SIZE
        move.w  Entity_Window_OriginX, d0
        btst    #0, d6                  // right column?
        beq     .x_done
        addi.w  #SECTION_SIZE, d0
    .x_done:
        move.w  Entity_Window_OriginY, d2
        btst    #1, d6                  // lower row?
        beq     .y_done
        addi.w  #SECTION_SIZE, d2
    .y_done:

        lea     (a3), a1
        jbsr    EntityWindow_InitSection

        // claim a collected/killed bitmask slot for this section
        // Collected_ClaimSlot preserves d6,d7,a3 (clobbers d1,a1) and the span
        // writes only d0, so nothing here needs saving across the call.
        moveq   #0, d0
        move.b  EntityScanState.ess_section_id(a1), d0
        jbsr    Collected_ClaimSlot

        bset    d6, d7                  // mark entry valid
        jbra    .next_entry

    .void_entry:
        // stamp SEC_VOID — despawn paths read entry ids unconditionally;
        // a stale id would keep dead-section survivors alive forever
        move.b  #SEC_VOID, EntityScanState.ess_section_id(a3)
        move.b  d6, EntityScanState.ess_entry_idx(a3)

    .next_entry:
        lea     sizeof(EntityScanState)(a3), a3
        addq.w  #1, d6
        cmpi.w  #MAX_TRACKED_SECTIONS, d6
        blo     .entry_loop

        move.b  d7, Entity_Window_Active
        rts
}

// -----------------------------------------------
// EntityWindow_Init — set up entity window at level start
//
// In:  none (reads Camera_X/Y, Current_Act_Ptr —
//      camera must be positioned before this runs)
// Out: none
// Clobbers: d0-d7, a0-a4
// -----------------------------------------------
pub proc EntityWindow_Init () clobbers(d0-d7, a0-a4) falls_into EntityWindow_Scan {
        jbsr    RingBuffer_Clear
        jbsr    Collected_Init
        clr.b   Entity_Window_Active

        // cold boot: loaded masks + scan-state section ids are garbage —
        // clear everything so InitSection's compare-clear starts clean
        lea     Entity_Loaded_Masks, a0
        moveq   #(MAX_TRACKED_SECTIONS*ENTITY_LOADED_SLOT_SIZE)/4-1, d0
    .clear_loaded:
        clr.l   (a0)+
        dbf     d0, .clear_loaded
        lea     Entity_Scan_State, a0
        move.w  #(MAX_TRACKED_SECTIONS*sizeof(EntityScanState))-1, d0
    .clear_scan:
        clr.b   (a0)+
        dbf     d0, .clear_scan
        // anchor + origin bases: first BuildEntries overwrites them, but an
        // explicit clear documents that no pre-derivation state survives boot
        clr.w   Entity_Window_Anchor
        clr.w   Entity_Window_OriginX
        clr.w   Entity_Window_OriginY

        // center the 3×3 collected window on the section under the camera
        // center BEFORE claiming slots (continuous-scroll: derive straight
        // from the world camera — same camX+160 / camY+112 math as the
        // per-slide recenter in EntityWindow_Slide; always in-grid at init,
        // so FlatIDXY needs no range check)
        move.w  Camera_X, d2            // world X px
        addi.w  #SCREEN_WIDTH/2, d2
        moveq   #SECTION_SIZE_SHIFT, d0
        asr.w   d0, d2                  // d2 = sec_x of the camera center (u8)
        move.w  Camera_Y, d3            // world Y px
        addi.w  #SCREEN_HEIGHT/2, d3
        asr.w   d0, d3 as GridY         // d3 = sec_y of the camera center
        movea.l Current_Act_Ptr, a2
        jbsr    Section_FlatIDXY        // d0.w = camera-center flat id
        moveq   #0, d1
        move.b  Act_grid_w_lo(a2), d1
        jbsr    Collected_UpdateCenter

        jbsr    EntityWindow_BuildEntries

        // vertical re-scan trigger baseline
        move.w  Camera_Y, d0
        andi.w  #ENTITY_RESCAN_COARSE_MASK, d0
        move.w  d0, Camera_Y_Coarse_Prev

        // falls through to EntityWindow_Scan (physically the next proc) — the
        // initial scan loads entities in camera range
}

// -----------------------------------------------
// EntityWindow_Scan — per-frame camera-range entity scan
//
// In:  none
// Out: none
// Clobbers: d0-d7, a0-a4
// -----------------------------------------------
pub proc EntityWindow_Scan () clobbers(d0-d7, a0-a4) {
        move.b  Entity_Window_Active, d5
        beq     .scan_done

        // Compute window edges
        move.w  Camera_X, d7
        addi.w  #SCREEN_WIDTH+ENTITY_LOAD_BUFFER, d7   // d7 = right load edge

        // Vertical re-scan: fires when camY crosses a 128px coarse row.
        // ENTITY_LOAD_BUFFER_Y (256px) > row size, so band motion between
        // crossings can never skip past an entity unseen.
        move.w  Camera_Y, d0
        andi.w  #ENTITY_RESCAN_COARSE_MASK, d0
        cmp.w   Camera_Y_Coarse_Prev, d0
        beq     .no_rescan
        move.w  d0, Camera_Y_Coarse_Prev
        movem.l d5, -(sp)                       // EntityWindow_RescanY clobbers d5 (saved); it preserves d7
        jbsr    EntityWindow_RescanY
        movem.l (sp)+, d5
    .no_rescan:

        // window slide: fires when the camera envelope crosses a section
        // boundary (≤ once per ~2048px of travel; one axis per frame at the
        // 16px/f camera clamp). DeriveWindow clobbers d5 — the validity mask
        // is reloaded below on both paths.
        jbsr    EntityWindow_DeriveWindow       // d2/d3 = anchor candidate
        cmp.b   Entity_Window_Anchor, d2
        bne     .slide
        cmp.b   Entity_Window_Anchor+1, d3
        beq     .no_slide
    .slide:
        move.w  d7, -(sp)                       // right load edge (camera unchanged by slide)
        jbsr    EntityWindow_Slide
        move.w  (sp)+, d7
    .no_slide:
        move.b  Entity_Window_Active, d5        // reload — DeriveWindow/Slide clobbered it

        lea     Entity_Scan_State, a3
        moveq   #0, d6                  // d6.b = entry index (0-3)

    .section_loop:
        btst    d6, d5
        beq     .section_next
        lea     (a3), a1
        // Trigger-cache gate: each walker cached the engine-X of the next entity
        // entering from the right (or $FFFF at the list end). Skip the call while
        // the right load edge d7 has not reached that X — nothing new can enter.
        // d7 < cached => skip. ScanRingsRight preserves a1 for the object gate.
        move.w  EntityScanState.ess_ring_next_x(a1), d0
        cmp.w   d0, d7
        blo     .skip_rings
        jbsr    EntityWindow_ScanRingsRight
    .skip_rings:
        move.w  EntityScanState.ess_obj_next_x(a1), d0
        cmp.w   d0, d7
        blo     .skip_objs
        jbsr    EntityWindow_ScanObjectsRight
    .skip_objs:
    .section_next:
        lea     sizeof(EntityScanState)(a3), a3
        addq.b  #1, d6
        cmpi.b  #MAX_TRACKED_SECTIONS, d6
        blo     .section_loop

    .scan_done:
        jbsr    EntityWindow_DespawnRings
        jbra    EntityWindow_DespawnObjects
}

// -----------------------------------------------
// EntityWindow_TrySpawnRing — gate one ROM ring entry, add if it passes
//
// Gates (cheapest first): Y load band → collected bit → loaded bit.
// On RingBuffer_Add success, sets the loaded bit. Buffer-full leaves
// the bit clear — the X ratchet has already passed this ring, so only
// a later re-scan or slide populate retries it.
// X-edge filtering is the WALKERS' job — this helper never reads
// Camera_X, so the slide populate can add off-screen-X rings.
//
// In:  a0 = ROM ring entry (dc.w local X, dc.w local Y)
//      a1 = EntityScanState pointer
//      d4.w = list index
// Out: none
// Clobbers: d0-d2 (d3-d7/a0-a6 preserved; d3/d4/a0 saved internally)
// -----------------------------------------------
proc EntityWindow_TrySpawnRing () clobbers(d0-d2, a0) preserves(d3, d4) {
        // Y load band: camY-LOAD_Y .. camY+SCREEN_HEIGHT+LOAD_Y
        move.w  2(a0), d1
        add.w   EntityScanState.ess_origin_y(a1), d1    // engine Y
        move.w  Camera_Y, d2
        subi.w  #ENTITY_LOAD_BUFFER_Y, d2
        cmp.w   d2, d1
        blt     .out_of_band            // above band (unsized: .w in DEBUG, .s in plain)
        addi.w  #SCREEN_HEIGHT+2*ENTITY_LOAD_BUFFER_Y, d2
        cmp.w   d2, d1
        bgt     .out_of_band            // below band (unsized, see above)

        // one save window for both checks + the add (subcalls clobber a0)
        movem.l d3-d4/a0, -(sp)

        // collected on a previous visit?
        move.b  EntityScanState.ess_section_id(a1), d0
        moveq   #0, d1
        move.w  d4, d1                  // list_index
        jbsr    Collected_CheckRing     // clobbers d2, a0
        bne     .gated                  // Z clear = collected (unsized: .w in DEBUG, .s in plain)

        // already in the buffer? (loaded bit — set on add, cleared on remove)
        moveq   #0, d0
        move.b  EntityScanState.ess_entry_idx(a1), d0
        moveq   #0, d1
        move.w  d4, d1                  // list_index
        moveq   #0, d2                  // ring bits
        jbsr    EntityLoaded_Test       // clobbers d0, d2, a0
        bne     .gated                  // loaded → skip (unsized, see above)

        // spawn ring into buffer
        movea.l 8(sp), a0               // ROM entry (a0 slot of movem frame)
        move.w  (a0), d0
        add.w   EntityScanState.ess_origin_x(a1), d0    // engine X
        move.w  2(a0), d1
        add.w   EntityScanState.ess_origin_y(a1), d1    // engine Y
        move.b  EntityScanState.ess_section_id(a1), d2  // section_id
        move.b  d4, d3                  // list_index

        if DEBUG == 1 {
            // No-dup invariant (spec §3): slides populate only genuinely-new
            // sections, so a (section_id, list_index)
            // pair offered here must never already sit in the live buffer — the
            // loaded bit would have gated it. This is the shared add site for the
            // X scan, the vertical re-scan AND PopulateSectionRings, so it guards
            // every spawn path. d4/a0 are clobberable (RingBuffer_Add clobbers
            // both); d5 must survive — push it.
            move.w  d5, -(sp)
            moveq   #0, d4
            move.b  d2, d4
            lsl.w   #8, d4
            move.b  d3, d4                  // d4 = (section_id<<8)|list_index
            moveq   #0, d5
            move.b  Ring_Count, d5
            beq     .nodup_ok
            subq.w  #1, d5
            lea     Ring_Buffer, a0
        .nodup_scan:
            cmp.w   4(a0), d4               // entry key word: sec.b, idx.b at +4
            beq     .nodup_hit
            addq.w  #RING_BUFFER_ENTRY_SIZE, a0
            dbf     d5, .nodup_scan
            jbra    .nodup_ok
        .nodup_hit:
            move.w  4(a0), d5               // register comparand for the assert
            assert.w d5, ne, d4             // always fails: duplicate (sec,idx)
        .nodup_ok:
            move.w  (sp)+, d5
        }

        jbsr    RingBuffer_Add          // clobbers d4, a0
        bcs     .gated                  // full — no bit; re-scan/populate retries
        moveq   #0, d0
        move.b  EntityScanState.ess_entry_idx(a1), d0
        moveq   #0, d1
        move.b  d3, d1                  // list_index (RingBuffer_Add's d3 input)
        moveq   #0, d2                  // ring bits
        jbsr    EntityLoaded_Set
    .gated:
        movem.l (sp)+, d3-d4/a0
    .out_of_band:
        rts
}

// -----------------------------------------------
// EntityWindow_ScanRingsRight — load rings entering right edge
//
// Y-skipped entries still advance the X ratchet (S3K semantics) —
// the vertical re-scan catches them when the band reaches them.
//
// In:  a1 = EntityScanState pointer
//      d7.w = right edge (Camera_X + SCREEN_WIDTH + ENTITY_LOAD_BUFFER)
// Out: none
// Clobbers: d0-d4, a0
// -----------------------------------------------
proc EntityWindow_ScanRingsRight () clobbers(d0-d4, a0) {
        move.w  EntityScanState.ess_ring_right_idx(a1), d4
        move.l  EntityScanState.ess_rom_ring_ptr(a1), d0
        beq     .at_terminator          // null list: no rings ever enter (ratchet unchanged)
        movea.l d0, a0
        move.w  EntityScanState.ess_origin_x(a1), d3

        // Advance a0 to current index (4 bytes per ROM entry: dc.w X, dc.w Y)
        move.w  d4, d0
        lsl.w   #2, d0
        adda.w  d0, a0

    .loop:
        move.l  (a0), d0                // terminator: dc.l 0
        beq     .at_terminator
        move.w  (a0), d0
        add.w   d3, d0                  // engine X

        // Past right edge? List is X-sorted, stop
        cmp.w   d7, d0
        bhi     .at_edge

        jbsr    EntityWindow_TrySpawnRing
        addq.w  #1, d4
        addq.w  #4, a0
        jbra    .loop

    .at_edge:
        // d0 = engine-X of the first ring past the edge — cache it as the trigger
        move.w  d0, EntityScanState.ess_ring_next_x(a1)
        move.w  d4, EntityScanState.ess_ring_right_idx(a1)
        rts
    .at_terminator:
        // list end or null list: no more rings to the right — $FFFF disables the gate
        move.w  #$FFFF, EntityScanState.ess_ring_next_x(a1)
        move.w  d4, EntityScanState.ess_ring_right_idx(a1)
        rts
}

// -----------------------------------------------
// EntityWindow_PopulateSectionRings — full ring populate for one entry
//
// Offers EVERY listed ring to TrySpawnRing (no X edge filter), so
// in-band, uncollected, not-yet-loaded rings load across the whole
// section width; sets ring_right_idx to the camera-relative position
// (first ring past right load edge). Called by the slide path for
// newly tracked sections only — surviving sections' loaded bits
// migrate with them, so a re-offer couldn't double-add anyway (the
// no-dup invariant is DEBUG-asserted at the shared add site inside
// EntityWindow_TrySpawnRing).
// Out-of-band rings are NOT added — the vertical re-scan picks them
// up when camY reaches them.
//
// In:  a1 = EntityScanState pointer (fully initialized)
// Out: ring_right_idx set
// Clobbers: d0-d4, a0, a2
// -----------------------------------------------
proc EntityWindow_PopulateSectionRings () clobbers(d0-d4, a0, a2) {
        move.l  EntityScanState.ess_rom_ring_ptr(a1), d0
        beq     .pdone
        movea.l d0, a2
        move.w  EntityScanState.ess_origin_x(a1), d3

        // Pass 1: find ring_right_idx (first ring past right load edge)
        move.w  Camera_X, d0
        addi.w  #SCREEN_WIDTH+ENTITY_LOAD_BUFFER, d0
        movea.l a2, a0
        moveq   #0, d4
    .pfind:
        move.l  (a0), d1
        beq     .pfound
        move.w  (a0), d1
        add.w   d3, d1
        cmp.w   d0, d1
        bhi     .pfound
        addq.w  #1, d4
        addq.w  #4, a0
        jbra    .pfind
    .pfound:
        move.w  d4, EntityScanState.ess_ring_right_idx(a1)
        // The trigger cache is left at its InitSection-cleared 0 here: the first
        // post-slide EntityWindow_Scan runs the ring walker once (0 never gates a
        // skip) and it re-establishes the cache from the ratchet. Slides are rare,
        // so seeding it here would buy one skipped walker call per ~2048px.

        // Pass 2: offer every listed ring (band/collected/loaded gates inside)
        movea.l a2, a0
        moveq   #0, d4
    .ploop:
        move.l  (a0), d0                // terminator: dc.l 0
        beq     .pdone
        jbsr    EntityWindow_TrySpawnRing
        addq.w  #1, d4
        addq.w  #4, a0
        jbra    .ploop

    .pdone:
        rts
}

// -----------------------------------------------
// EntityWindow_TrySpawnObject — gate one ROM object entry, spawn if it passes
//
// Entry format (v2): 6 bytes — dc.w x, y, flags|type|subtype
//   +0 dc.w  section-local X
//   +2 dc.w  section-local Y   (ess_origin_y added here)
//   +4 dc.w  flags|type|subtype  (OEF_* bits; flows to Load_Object in d2)
// Gates: ANY_Y/Y load band → killed bit → loaded bit. On Load_Object
// success: SST_slot_tag = entry index | ANY_Y<<7 (never collides with
// SLOT_TAG_UNTAGGED=$FF), section id + list index stored, loaded bit set.
// Alloc failure leaves the bit clear — a later re-scan retries.
// X-edge filtering is the WALKERS' job — no Camera_X reads here.
//
// In:  a0 = ROM object entry
//      a1 = EntityScanState pointer
//      d4.w = list index
// Out: none
// Clobbers: d0-d2, a2 (d3-d7/a0-a1/a3 preserved; d3/d5/a0-a1/a3 saved internally)
// -----------------------------------------------
proc EntityWindow_TrySpawnObject () clobbers(d0-d2, a0-a3) preserves(d3, d5) {
        // ANY_Y (placement bit 15) skips the Y band check
        move.w  4(a0), d2               // placement word
        bmi     .y_ok

        // Y load band: camY-LOAD_Y .. camY+SCREEN_HEIGHT+LOAD_Y
        move.w  2(a0), d1
        add.w   EntityScanState.ess_origin_y(a1), d1    // engine Y
        move.w  Camera_Y, d0
        subi.w  #ENTITY_LOAD_BUFFER_Y, d0
        cmp.w   d0, d1
        blt     .out_of_band            // above band
        addi.w  #SCREEN_HEIGHT+2*ENTITY_LOAD_BUFFER_Y, d0
        cmp.w   d0, d1
        bgt     .out_of_band            // below band
    .y_ok:
        // one save window for both checks + the spawn
        // (frame: d3=0, d5=4, a0=8, a1=12, a3=16; Load_Object clobbers a1-a3)
        movem.l d3/d5/a0-a1/a3, -(sp)

        // killed on a previous visit?
        move.b  EntityScanState.ess_section_id(a1), d0
        moveq   #0, d1
        move.w  d4, d1                  // list_index
        jbsr    Killed_CheckObject      // clobbers d2, a0
        bne     .gated                  // Z clear = killed

        // already spawned? (loaded bit — set on spawn, cleared on despawn/kill)
        moveq   #0, d0
        move.b  EntityScanState.ess_entry_idx(a1), d0
        moveq   #0, d1
        move.w  d4, d1                  // list_index
        moveq   #ENTITY_LOADED_OBJ_OFFSET, d2
        jbsr    EntityLoaded_Test       // clobbers d0, d2, a0
        bne     .gated                  // loaded → skip

        // spawn (d5 stashes section_id — Load_Object preserves d4-d7)
        movea.l 8(sp), a0               // ROM entry (a0 slot of movem frame)
        moveq   #0, d5
        move.b  EntityScanState.ess_section_id(a1), d5

        move.w  (a0), d0
        add.w   EntityScanState.ess_origin_x(a1), d0    // engine X
        move.w  2(a0), d1
        add.w   EntityScanState.ess_origin_y(a1), d1    // engine Y
        move.w  4(a0), d2               // full placement word — Load_Object reads flips from bits 13-14

        // Type extraction: bits 12-8 → d3, then type-table lookup
        move.w  d2, d3
        lsr.w   #OEF_TYPE_SHIFT, d3
        andi.w  #OEF_TYPE_MASK, d3
        movea.l EntityScanState.ess_rom_type_tbl_ptr(a1), a2
        lsl.w   #2, d3                  // type × 4 (longword)
        addq.w  #2, d3                  // skip count+pad header
        movea.l (a2, d3.w), a1          // a1 = ObjDef pointer

        jbsr    Load_Object             // clobbers d0-d3/a1-a3, preserves d4-d7/a0
        bne     .gated                  // alloc failed — no bit, re-scan retries

        // Tag spawned object (a1 = new SST from Load_Object)
        // slot_tag = entry index; bit 7 = ANY_Y (placement bit 15)
        movea.l 12(sp), a2              // scan state (a1 slot of movem frame)
        move.b  EntityScanState.ess_entry_idx(a2), d0
        move.w  4(a0), d3               // placement word (a0 survived Load_Object)
        bpl     .tag_plain
        bset    #7, d0
    .tag_plain:
        move.b  d0, Sst.slot_tag(a1)
        move.b  d5, Sst.entity_section_id(a1)
        move.b  d4, Sst.entity_list_index(a1)

        // mark loaded (entry index WITHOUT the ANY_Y bit — it's a mask base)
        moveq   #0, d0
        move.b  EntityScanState.ess_entry_idx(a2), d0
        moveq   #0, d1
        move.w  d4, d1                  // list_index
        moveq   #ENTITY_LOADED_OBJ_OFFSET, d2
        jbsr    EntityLoaded_Set
    .gated:
        movem.l (sp)+, d3/d5/a0-a1/a3
    .out_of_band:
        rts
}

// -----------------------------------------------
// EntityWindow_ScanObjectsRight — load objects entering right edge
//
// List is X-sorted; bhi exits as soon as X exceeds load edge. Terminated
// by dc.w -1 (X is section-local, always >= 0 → bmi fires on sentinel).
// Y-skipped entries still advance the X ratchet (S3K semantics) —
// the vertical re-scan catches them when the band reaches them.
//
// In:  a1 = EntityScanState pointer
//      d7.w = right edge (Camera_X + SCREEN_WIDTH + ENTITY_LOAD_BUFFER)
// Out: none
// Clobbers: d0-d4, a0-a3
// -----------------------------------------------
proc EntityWindow_ScanObjectsRight () clobbers(d0-d4, a0-a3) {
        move.w  EntityScanState.ess_obj_right_idx(a1), d4
        move.l  EntityScanState.ess_rom_obj_ptr(a1), d0
        beq     .obj_at_terminator      // null list: no objects ever enter (ratchet unchanged)
        movea.l d0, a0
        move.w  EntityScanState.ess_origin_x(a1), d3

        // Advance a0 to current index: d4 × 6 via ×2, ×3, ×6
        move.w  d4, d0
        add.w   d0, d0                  // d0 = d4 × 2
        add.w   d4, d0                  // d0 = d4 × 3
        add.w   d0, d0                  // d0 = d4 × 6
        adda.w  d0, a0

    .obj_loop:
        move.w  (a0), d0                // section-local X (or $FFFF sentinel)
        bmi     .obj_at_terminator      // bmi fires on -1 terminator

        add.w   d3, d0                  // engine X

        // Past right edge? List is X-sorted, stop
        cmp.w   d7, d0
        bhi     .obj_at_edge

        jbsr    EntityWindow_TrySpawnObject
        addq.w  #1, d4
        addq.w  #OBJ_ENTRY_SIZE, a0
        jbra    .obj_loop

    .obj_at_edge:
        // d0 = engine-X of the first object past the edge — cache it as the trigger
        move.w  d0, EntityScanState.ess_obj_next_x(a1)
        move.w  d4, EntityScanState.ess_obj_right_idx(a1)
        rts
    .obj_at_terminator:
        // list end or null list: no more objects to the right — $FFFF disables the gate
        move.w  #$FFFF, EntityScanState.ess_obj_next_x(a1)
        move.w  d4, EntityScanState.ess_obj_right_idx(a1)
        rts
}

// -----------------------------------------------
// EntityWindow_RescanY — vertical re-scan after a coarse camY change
//
// Walks each valid entry's ROM lists from index 0 to the X ratchet
// (right_idx) — only entities already passed by the X scan — and
// spawns anything now in band whose loaded bit is clear. Loaded bits
// make this idempotent; collected/killed still filter.
// Cost: O(entities in X range) per 128px of vertical travel.
//
// In:  none
// Out: none
// Clobbers: d0-d6, a0-a3
// -----------------------------------------------
proc EntityWindow_RescanY () clobbers(d0-d6, a0-a3) {
        move.b  Entity_Window_Active, d5
        beq     .done
        lea     Entity_Scan_State, a3
        moveq   #0, d6
    .entry_loop:
        btst    d6, d5
        beq     .entry_next
        lea     (a3), a1
        jbsr    EntityWindow_RescanRings
        lea     (a3), a1
        jbsr    EntityWindow_RescanObjects
    .entry_next:
        lea     sizeof(EntityScanState)(a3), a3
        addq.w  #1, d6
        cmpi.w  #MAX_TRACKED_SECTIONS, d6
        blo     .entry_loop
    .done:
        rts
}

// -----------------------------------------------
// EntityWindow_RescanRings — re-offer rings 0..ring_right_idx-1
//
// No X edge test: everything below the ratchet already passed it.
// Defensive terminator stop guards a ratchet beyond list end.
//
// In:  a1 = EntityScanState pointer
// Out: none
// Clobbers: d0-d4, a0
// -----------------------------------------------
proc EntityWindow_RescanRings () clobbers(d0-d4, a0) {
        move.l  EntityScanState.ess_rom_ring_ptr(a1), d0
        beq     .done
        movea.l d0, a0
        move.w  EntityScanState.ess_ring_right_idx(a1), d3      // X ratchet bound
        beq     .done
        moveq   #0, d4
    .loop:
        move.l  (a0), d0                // terminator: dc.l 0
        beq     .done
        jbsr    EntityWindow_TrySpawnRing
        addq.w  #1, d4
        addq.w  #4, a0
        cmp.w   d3, d4
        blo     .loop
    .done:
        rts
}

// -----------------------------------------------
// EntityWindow_RescanObjects — re-offer objects 0..obj_right_idx-1
//
// In:  a1 = EntityScanState pointer
// Out: none
// Clobbers: d0-d4, a0-a3
// -----------------------------------------------
proc EntityWindow_RescanObjects () clobbers(d0-d4, a0-a3) {
        move.l  EntityScanState.ess_rom_obj_ptr(a1), d0
        beq     .done
        movea.l d0, a0
        move.w  EntityScanState.ess_obj_right_idx(a1), d3       // X ratchet bound
        beq     .done
        moveq   #0, d4
    .loop:
        tst.w   (a0)                    // defensive: -1 sentinel below the ratchet
        bmi     .done
        jbsr    EntityWindow_TrySpawnObject
        addq.w  #1, d4
        addq.w  #OBJ_ENTRY_SIZE, a0
        cmp.w   d3, d4
        blo     .loop
    .done:
        rts
}

// -----------------------------------------------
// EntityWindow_DespawnRings — remove rings outside camera range
//
// X rule: rings despawn when out-of-X UNLESS their section is
// an active window entry. Y rule: EVERY ring — active section
// or not — must sit inside the Y despawn band or it goes. The Y band
// uses ENTITY_DESPAWN_BUFFER_Y (wider than load = hysteresis: a ring
// between the bands neither loads nor despawns, so no churn).
// Iterates backward for safe swap-with-last removal.
// -----------------------------------------------
proc EntityWindow_DespawnRings () clobbers(d0-d7, a0-a1) {
        moveq   #0, d5
        move.b  Ring_Count, d5
        beq     .done
        subq.w  #1, d5

        move.w  Camera_X, d6
        move.w  d6, d7
        subi.w  #ENTITY_DESPAWN_BUFFER, d6
        addi.w  #SCREEN_WIDTH+ENTITY_DESPAWN_BUFFER, d7

    .loop:
        // Compute entry address
        move.w  d5, d0
        add.w   d0, d0
        add.w   d5, d0
        add.w   d0, d0                  // d0 = index × 6
        lea     Ring_Buffer, a0
        move.w  (a0, d0.w), d1          // engine_X

        cmp.w   d6, d1
        blt     .check_active
        cmp.w   d7, d1
        ble     .check_y                // X in window → still Y-gated

    .check_active:
        move.b  4(a0, d0.w), d1
        cmp.b   Entity_Scan_State+offsetof(EntityScanState, ess_section_id), d1
        beq     .check_y
        cmp.b   Entity_Scan_State+(sizeof(EntityScanState)*1+offsetof(EntityScanState, ess_section_id)), d1
        beq     .check_y
        cmp.b   Entity_Scan_State+(sizeof(EntityScanState)*2+offsetof(EntityScanState, ess_section_id)), d1
        beq     .check_y
        cmp.b   Entity_Scan_State+(sizeof(EntityScanState)*3+offsetof(EntityScanState, ess_section_id)), d1
        bne     .remove                 // X straggler in a dead section

    .check_y:
        // Y despawn band: camY-DESPAWN_Y .. camY+SCREEN_HEIGHT+DESPAWN_Y
        move.w  2(a0, d0.w), d1         // engine_Y
        move.w  Camera_Y, d2
        subi.w  #ENTITY_DESPAWN_BUFFER_Y, d2
        cmp.w   d2, d1
        blt     .remove                 // far above
        addi.w  #SCREEN_HEIGHT+2*ENTITY_DESPAWN_BUFFER_Y, d2
        cmp.w   d2, d1
        ble     .next                   // in band → keep
                                        // far below → fall into .remove

    .remove:
        // clear the loaded bit before removal (no-op when section
        // untracked; Y despawn makes this live for active sections too)
        // clearLoadedRing a0,d0 (macro inline-expanded)
        moveq   #0, d3
        move.b  5(a0, d0.w), d3         // list_index
        move.b  4(a0, d0.w), d0         // section_id
        jbsr    EntityWindow_EntryForSection
        tst.w   d0
        bmi     .clr_ring_skip          // section untracked — no loaded bits
        move.w  d3, d1
        moveq   #0, d2                  // ring bits
        jbsr    EntityLoaded_Clear
    .clr_ring_skip:
        // RingBuffer_Remove preserves d5,d6,d7 (clobbers d1-d2/a0-a1) and the
        // span writes only d0 (d5 stays the dbf loop counter below), so nothing
        // here needs saving across the call.
        move.w  d5, d0
        jbsr    RingBuffer_Remove

    .next:
        dbf     d5, .loop

    .done:
        rts
}

// -----------------------------------------------
// EntityWindow_DespawnObjects — delete dynamic objects outside range
//
// Section-lifetime first, then the Y band: an object whose section left
// the visibility window despawns regardless of X (under the envelope
// derivation, every legitimate survivor's section is tracked — the only
// untracked-section objects are same-frame slide stragglers and ANY_Y
// escapees). Tracked-section objects are kept by X unconditionally and
// gated by the Y despawn band; ANY_Y objects (slot_tag bit 7) are exempt
// from the Y BAND only, never from section lifetime — an untracked
// section's ANY_Y survivor would otherwise live forever in the X window
// and duplicate when its section re-enters (its loaded bit died with the
// entry).
// -----------------------------------------------
proc EntityWindow_DespawnObjects () clobbers(d0-d7, a0-a3) {
        // Walk the dynamic live list (spawn order) instead of the fixed
        // 40-slot Dynamic_Slots sweep — empty slots cost ZERO. a2 = list
        // cursor; it must survive the DeleteObject call below (see .despawn).
        move.w  Dynamic_Live_Count, d5
        bne     .have_live
        rts
    .have_live:
        // Walk-flag assert rail: the fourth dynamic live-list walker. DespawnObjects
        // only deletes (no alloc → no mid-walk compaction today), but flag the walk so the
        // CompactDynamicLive assert stays TOTAL if a spawn is ever added here.
        if DEBUG == 1 { st Dynamic_Live_Walking }
        lea     Dynamic_Live, a2
        subq.w  #1, d5

    .loop:
        move.w  (a2)+, d0               // load entry, null-guard a zeroed
        beq     .next                   //     entry (same-frame delete) — no deref
        movea.w d0, a0
        tst.w   Sst.code_addr(a0)       // truth guard: dead-but-uncompacted slot
        beq     .next

        cmpi.b  #SLOT_TAG_UNTAGGED, Sst.slot_tag(a0)
        beq     .next

    .check_active:
        move.b  Sst.entity_section_id(a0), d1
        cmp.b   Entity_Scan_State+offsetof(EntityScanState, ess_section_id), d1
        beq     .check_y
        cmp.b   Entity_Scan_State+(sizeof(EntityScanState)*1+offsetof(EntityScanState, ess_section_id)), d1
        beq     .check_y
        cmp.b   Entity_Scan_State+(sizeof(EntityScanState)*2+offsetof(EntityScanState, ess_section_id)), d1
        beq     .check_y
        cmp.b   Entity_Scan_State+(sizeof(EntityScanState)*3+offsetof(EntityScanState, ess_section_id)), d1
        bne     .despawn                // section untracked → despawn

    .check_y:
        move.b  Sst.slot_tag(a0), d1
        bmi     .next                   // bit 7 = ANY_Y → exempt from the Y band (section already checked)
        move.w  Sst.y_pos(a0), d1
        move.w  Camera_Y, d2
        subi.w  #ENTITY_DESPAWN_BUFFER_Y, d2
        cmp.w   d2, d1
        blt     .despawn                // far above
        addi.w  #SCREEN_HEIGHT+2*ENTITY_DESPAWN_BUFFER_Y, d2
        cmp.w   d2, d1
        ble     .next                   // in band → keep
                                        // far below → fall into .despawn

    .despawn:
        movem.l d5-d7/a0/a2, -(sp)      // +a2: live cursor must survive DeleteObject
        // clear the loaded bit before the SST vanishes (Y despawn makes
        // this live for active sections too)
        // clearLoadedObj a0 (macro inline-expanded)
        moveq   #0, d3
        move.b  Sst.entity_list_index(a0), d3
        move.b  Sst.entity_section_id(a0), d0
        jbsr    EntityWindow_EntryForSection
        tst.w   d0
        bmi     .clr_obj_skip           // section untracked — no loaded bits
        move.w  d3, d1
        moveq   #ENTITY_LOADED_OBJ_OFFSET, d2
        jbsr    EntityLoaded_Clear
    .clr_obj_skip:
        movea.l 12(sp), a0              // SST ptr (a0 slot of the movem frame)
        jbsr    DeleteObject
        movem.l (sp)+, d5-d7/a0/a2

    .next:
        dbf     d5, .loop
        if DEBUG == 1 { sf Dynamic_Live_Walking }
        rts
}

// -----------------------------------------------
// EntityWindow_MigrateMasks — move loaded masks to sections' new entries
//
// Generic identity match: for each NEW entry, find its section id in the
// old snapshot; on match copy the old 32-byte mask into the entry's live
// slot. Sections new to the window keep the compare-clear's zeroed mask.
// Handles any slide direction — including the (DEBUG-asserted-impossible)
// diagonal. Old SEC_VOID snapshot ids can't false-match: new valid ids are real.
// Cold path (slides only) — clarity over cycles.
//
// In:  a4 = snapshot: 4 bytes old section ids + 4×32 bytes old masks
// Out: none
// Clobbers: d0-d3, a0-a1
// -----------------------------------------------
proc EntityWindow_MigrateMasks () clobbers(d0-d3, a0-a1) {
        moveq   #0, d3                  // d3 = new entry index
    .new_loop:
        // d2.b = new entry d3's section id (entry stride $16: ×22 = ×16+×4+×2)
        move.w  d3, d0
        lsl.w   #4, d0
        move.w  d3, d1
        lsl.w   #2, d1
        add.w   d1, d0
        move.w  d3, d1
        add.w   d1, d1
        add.w   d1, d0
        lea     Entity_Scan_State+offsetof(EntityScanState, ess_section_id), a0
        move.b  (a0, d0.w), d2
        cmpi.b  #SEC_VOID, d2
        beq     .new_next               // void entry — nothing to receive

        lea     (a4), a0                // snapshot section ids
        moveq   #0, d0                  // d0 = old entry index
    .old_loop:
        cmp.b   (a0)+, d2
        beq     .match
        addq.w  #1, d0
        cmpi.w  #MAX_TRACKED_SECTIONS, d0
        blo     .old_loop
        jbra    .new_next               // not previously tracked — mask stays zeroed

    .match:
        lea     4(a4), a0               // snapshot mask block
        lsl.w   #5, d0                  // old entry × ENTITY_LOADED_SLOT_SIZE
        adda.w  d0, a0
        lea     Entity_Loaded_Masks, a1
        move.w  d3, d1
        lsl.w   #5, d1                  // new entry × ENTITY_LOADED_SLOT_SIZE
        adda.w  d1, a1
        moveq   #ENTITY_LOADED_SLOT_SIZE/4-1, d1
    .copy:
        move.l  (a0)+, (a1)+
        dbf     d1, .copy

    .new_next:
        addq.w  #1, d3
        cmpi.w  #MAX_TRACKED_SECTIONS, d3
        blo     .new_loop
        rts
}

// -----------------------------------------------
// EntityWindow_Slide — re-derive the window after the envelope crossed a
// section boundary
//
// Snapshot old ids+masks → recenter collected 3×3 (evict BEFORE BuildEntries
// claims — claim-before-evict failed silently at 9/9 occupancy) → BuildEntries
// (compare-clear zeroes genuinely-new sections' masks) → migrate surviving
// masks by section identity → populate sections that weren't tracked before.
// Cold path (≤ once per ~2048px of travel) — clarity over cycles.
//
// In:  none (reads Camera_X/Y, Current_Act_Ptr)
// Out: none
// Clobbers: d0-d7, a0-a4
// -----------------------------------------------
proc EntityWindow_Slide () clobbers(d0-d7, a0-a4) {
        // snapshot the old window: 4 section-id bytes + the 128-byte mask block
        lea     Entity_Mask_Scratch, a0
        move.b  Entity_Scan_State+offsetof(EntityScanState, ess_section_id), (a0)+
        move.b  Entity_Scan_State+(sizeof(EntityScanState)*1+offsetof(EntityScanState, ess_section_id)), (a0)+
        move.b  Entity_Scan_State+(sizeof(EntityScanState)*2+offsetof(EntityScanState, ess_section_id)), (a0)+
        move.b  Entity_Scan_State+(sizeof(EntityScanState)*3+offsetof(EntityScanState, ess_section_id)), (a0)+
        lea     Entity_Loaded_Masks, a1
        moveq   #(MAX_TRACKED_SECTIONS*ENTITY_LOADED_SLOT_SIZE)/4-1, d0
    .snapshot:
        move.l  (a1)+, (a0)+
        dbf     d0, .snapshot

        // recenter the collected/killed 3×3 on the section containing the
        // camera CENTER (DeriveWindow-style world math on camX+160 / camY+112 —
        // always in-grid, so FlatIDXY needs no range check)
        move.w  Camera_X, d4            // world X px
        addi.w  #SCREEN_WIDTH/2, d4
        moveq   #SECTION_SIZE_SHIFT, d0
        asr.w   d0, d4                  // d2 = sec_x of the camera center
        move.w  Camera_Y, d5           // world Y px
        addi.w  #SCREEN_HEIGHT/2, d5
        asr.w   d0, d5                  // d3 = sec_y of the camera center
        move.w  d4, d2                 // sec_x (u8)
        move.w  d5, d3 as GridY        // sec_y
        movea.l Current_Act_Ptr, a2
        jbsr    Section_FlatIDXY        // d0.w = camera-center flat id
        moveq   #0, d1
        move.b  Act_grid_w_lo(a2), d1
        jbsr    Collected_UpdateCenter

        if DEBUG == 1 {
            move.w  Entity_Window_Anchor, -(sp)     // old anchor (snapshot holds ids, not the anchor)
        }
        jbsr    EntityWindow_BuildEntries

        if DEBUG == 1 {
            // single-axis invariant: at most one anchor byte changes per slide
            // (16px/f camera clamp)
            move.w  (sp)+, d0               // old anchor
            move.w  Entity_Window_Anchor, d1
            eor.w   d0, d1                  // nonzero byte = that axis moved
            tst.b   d1
            beq     .axis_ok                // sec_y0 unchanged → at most X slid
            andi.w  #$FF00, d1              // sec_y0 slid → sec_x0 must not have
            assert.w d1, eq
        .axis_ok:
        }

        // migrate surviving sections' loaded masks to their new entries
        lea     Entity_Mask_Scratch, a4
        jbsr    EntityWindow_MigrateMasks

        // populate entries whose section was NOT tracked before (band-gated;
        // survivors' ids are in the snapshot)
        lea     Entity_Scan_State, a3
        moveq   #0, d6
    .populate_loop:
        move.b  Entity_Window_Active, d0
        btst    d6, d0
        beq     .populate_next
        move.b  EntityScanState.ess_section_id(a3), d0
        lea     Entity_Mask_Scratch, a0
        moveq   #MAX_TRACKED_SECTIONS-1, d1
    .old_id_scan:
        cmp.b   (a0)+, d0
        dbeq    d1, .old_id_scan
        beq     .populate_next          // id survived the slide — nothing new
        lea     (a3), a1
        jbsr    EntityWindow_PopulateSectionRings       // clobbers d0-d4/a0/a2 — d6/a3 safe
    .populate_next:
        lea     sizeof(EntityScanState)(a3), a3
        addq.w  #1, d6
        cmpi.w  #MAX_TRACKED_SECTIONS, d6
        blo     .populate_loop
        rts
}
