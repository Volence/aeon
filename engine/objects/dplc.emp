// DPLC — Dynamic Pattern Load Cue (per-frame sprite art loading via DMA)
//
// DPLC table format:
//   Offset table: word per frame (offset from file start to frame data)
//   Frame data:   word entry_count, then entry_count words
//   Entry word:   bits 15-12 = tile_count-1 (1-16), bits 11-0 = tile_start
//
// A frame may carry 1..N entries (each a separate DMA), so the entry loop
// below is load-bearing — NOT dead generality. (Item 6 originally asserted
// "exactly 1 entry" per the contiguous-art optimization note; the ObjectTest
// oracle soak DISPROVED it — DPLC_Sonic frames legitimately carry up to 6
// entries — so that assert was removed. If a single-DMA guarantee is wanted
// for the shipping art, it belongs in the build tool, not this shared runtime
// path.)
//
// Cross-seam: QueueDMA_Important / QueueDMA_Deferrable resolve at link.

module engine.objects.dplc in dplc

use engine.objects.sst.{Sst}

// Boundary contracts (contract-grammar v2 §3) — the two DMA-queue .asm entries
// this file calls via perform_dplc(QueueDMA_*). Emit nothing; they let the
// transitive closure see past the cross-seam calls. (The carry-out `dropped`
// result these routines document rides G2's out(carry:); G1 declares only the
// register clobbers.) Both share the QueueDMATransfer core, so one contract.
// drift-guard: engine/system/dma_queue.asm:51 — In: d1.l/d2.w/d3.w · Clobbers: d0-d4, a1-a2
extern proc QueueDMA_Important (d1, d2, d3) clobbers(d0-d4/a1-a2)
// drift-guard: engine/system/dma_queue.asm:56 — In: d1.l/d2.w/d3.w · Clobbers: d0-d4, a1-a2
extern proc QueueDMA_Deferrable (d1, d2, d3) clobbers(d0-d4/a1-a2)

// -----------------------------------------------
// perform_dplc — the shared DPLC body (single-sourced; the Important and
// Deferrable procs differ ONLY in which QueueDMA priority they call, so the
// 30-line load loop lives here once). `queue` selects the DMA queue proc.
// In/Out/Clobbers are the two procs' documented contract (see below).
// -----------------------------------------------
comptime fn perform_dplc(queue: Label) -> Code {
    return asm {
        move.b  Sst.mapping_frame(a0), d0
        cmp.b   Sst.prev_frame(a0), d0
        beq     .done                           // frame unchanged, skip (bare Bcc — sigil relaxes per-shape)
        // prev_frame is committed AFTER a successful enqueue (below), NOT
        // here — QueueDMATransfer returns carry-set when the queue is full and it
        // silently drops the request. Committing before meant a dropped frame left
        // prev_frame == mapping_frame, so the object believed its art loaded and
        // showed stale tiles until mapping_frame changed again. d0 still holds
        // mapping_frame for the resolve below.

        // Resolve DPLC frame data
        andi.w  #$FF, d0
        add.w   d0, d0
        adda.w  (a2,d0.w), a2                   // a2 = frame data pointer
        move.w  (a2)+, d4                        // d4 = entry count
        subq.w  #1, d4
        bmi     .done                            // 0 entries

        move.w  d1, d2                           // d2 = running VRAM dest

    .entry_loop:
        move.w  (a2)+, d0                        // DPLC entry word
        move.w  d0, d3
        lsr.w   #8, d3
        lsr.w   #4, d3                           // d3 = tile_count - 1
        addq.w  #1, d3                           // d3 = tile_count

        andi.l  #$0FFF, d0                       // tile_start_index
        lsl.l   #5, d0                           // byte offset
        move.l  a3, d1                           // art base
        add.l   d0, d1                           // d1.l = source address

        lsl.w   #5, d3                           // d3.w = length (bytes)

        movem.l d2-d4/a2-a3, -(sp)
        jbsr    {queue}                          // carry SET = dropped (queue full)
        movem.l (sp)+, d2-d4/a2-a3               // movem preserves CCR — the carry survives
        bcs     .done                            // dropped — leave prev_frame stale so next frame RETRIES

        add.w   d3, d2
        dbf     d4, .entry_loop
        // All entries enqueued OK — NOW commit prev_frame. Re-read
        // mapping_frame (unchanged this routine; d0 was consumed by the loop).
        move.b  Sst.mapping_frame(a0), d0
        move.b  d0, Sst.prev_frame(a0)
    .done:
        rts
    }
}

// -----------------------------------------------
// Perform_DPLC — load art for current mapping frame if changed
//
// In:  a0 = SST pointer
//      a2 = DPLC table pointer (ROM)
//      a3 = uncompressed art base address (ROM)
//      d1.w = VRAM destination (byte address)
// Out: none
// Clobbers: d0-d4, a1-a2
// -----------------------------------------------
pub proc Perform_DPLC () clobbers(d0-d4/a1-a2) {
        perform_dplc(QueueDMA_Important)
}

// -----------------------------------------------
// Perform_DPLC_Deferrable — same as Perform_DPLC but Deferrable priority
// Used for non-player objects (budget-gated, can slip one frame)
//
// In:  a0 = SST pointer
//      a2 = DPLC table pointer (ROM)
//      a3 = uncompressed art base address (ROM)
//      d1.w = VRAM destination (byte address)
// Out: none
// Clobbers: d0-d4, a1-a2
// -----------------------------------------------
pub proc Perform_DPLC_Deferrable () clobbers(d0-d4/a1-a2) {
        perform_dplc(QueueDMA_Deferrable)
}
