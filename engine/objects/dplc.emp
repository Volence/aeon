// DPLC — Dynamic Pattern Load Cue (per-frame sprite art loading via DMA)
//
// DPLC table format:
//   Offset table: word per frame (offset from file start to frame data)
//   Frame data:   word entry_count, then entry_count words
//   Entry word:   bits 15-12 = tile_count-1 (1-16), bits 11-0 = tile_start
//                 (DPLC_TILE_COUNT_BITS / DPLC_TILE_START_BITS below name the split)
//
// A frame may carry 1..N entries (each a separate DMA), so the entry loop
// below is load-bearing — NOT dead generality. If a single-DMA guarantee is
// wanted for the shipping art, it belongs in the build tool, not this shared
// runtime path.
//
// ENTRY COUNT IS A QUEUE-SLOT COST, AND IT IS THE BINDING CONSTRAINT.
// Each entry is one QueueDMA_Important enqueue, so a frame costs
// entry_count slots out of DMA_IMPORTANT_SLOTS (12). Measured from the
// shipped blobs (dplc_peak_entries below, corroborated by
// tools/verify_sprites.py):
//
//     optimized/sonic.bin   10 entries    knuckles.bin              5
//     optimized/tails.bin    2            optimized/tails_tail.bin  1
//     generated/dust/dplc_dust.bin  1
//
// Every one of those is now walled by a real `ensure` at the module that embeds
// it — `dplc_peak_entries(x) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS`. Sonic
// was the last holdout: it shipped at 13 behind a RATCHET, and d-47 `targeted`
// (parcel/dplc-entry-recut) re-cut the sheet to 10 = the wall exactly, so the
// ratchet became the assert. collision_data.emp carries the method.
//
// This header previously claimed "up to 6 entries (ObjectTest oracle soak)" and
// knuckles_data.emp claimed "well inside DMA_IMPORTANT_SLOTS ... (DPLC_Sonic
// carries up to 13)". Both were wrong, and they disagreed with each other.
// dplc_peak_tiles guards only the VRAM footprint, so nothing bounded entries
// against slots at all — which is why nobody noticed the 13.
//
// WHY THE WALL IS WORTH ITS PRICE, since 10 + 2 == 12 leaves nothing spare. At
// 12/12 the Important queue is 100% player and PageIn_EnqueueLanding is
// deterministically dropped — a streaming stall on exactly the frames the player
// holds (LookUp; the walk-tilt frames, during ordinary running). At 13 it is
// worse and PERMANENT: perform_dplc enqueues 12, the 13th returns carry-set, and
// the `bcs .done` bails BEFORE committing prev_frame — so every subsequent frame
// re-enqueues all 12 and drops the 13th forever. That entry's tiles never load.
//
// ⚠ AND THE `ensure` STILL CANNOT SEE THE WHOLE COST. A transfer whose ROM source
// straddles a $20000 boundary is SPLIT BY QueueDMA INTO TWO entries, so a frame
// really costs `entries + straddles`, and whether an entry straddles depends on
// where the art LANDED — a link-time fact no comptime parser of the blob can
// reach. tools/dplc_straddle.py --gate measures SLOTS and runs in build.sh; the
// comptime walls here are necessary and not sufficient.
//
// Cross-module: QueueDMA_Important / QueueDMA_Deferrable live in
// engine.dma_queue and resolve at link.

module engine.objects.dplc in dplc

use engine.objects.sst.{Sst}

// QueueDMA_Important / QueueDMA_Deferrable are .emp-owned procs
// (engine.dma_queue) — their real signatures carry the contract
// (`(d1, d2, d3) clobbers(d0-d4/a1-a2) out(carry: dropped)`; both share the
// QueueDMA_Deferrable.transfer core, so one contract). Carry SET = the queue
// was full and the request was silently dropped — a caller MUST consume it
// (perform_dplc's `bcs .done` does), or the [call.flag-result-unused] check
// fires.

// -----------------------------------------------
// DPLC_ENTRY_RESERVE — Important slots a DPLC frame must leave free.
//
// The player's DPLC is not the queue's only Important customer in a frame:
// PageIn_EnqueueLanding publishes a decoded art page (and a landing whose ROM
// source straddles a $20000 boundary is SPLIT into two entries by
// QueueDMA — .split_reject needs BOTH free or it rejects the whole entry).
// Character art totals ~354 KB across the cast, i.e. ~2.7 x 128 KB, so at least
// two boundary-straddling entries exist by construction.
//
// Two is the floor, not a comfortable margin. Raise it before adding another
// per-frame Important producer.
// -----------------------------------------------
pub const DPLC_ENTRY_RESERVE = 2

// -----------------------------------------------
// THE ENTRY WORD'S FIELD WIDTHS — named ONCE, here, and derived from nowhere else.
//
// The entry word is 16 bits split `[count-1 : 4][tile_start : 12]`. Until this
// block existed the split lived only in prose: the header comment at the top of
// this file, `knuckles_data.emp`'s "only TWELVE bits (max 4095)", two Python
// asserts, and the `andi.l` mask in perform_dplc below — five restatements, no
// name, and nothing that fails when one of them drifts. `4095` is now spelled
// exactly nowhere: it is `(1 << DPLC_TILE_START_BITS) - 1`.
//
// DPLC_ADDRESSABLE_TILES is the number this engine's callers actually need. A
// tile_start names a tile INDEX into a character's art sheet, so a sheet with
// more than `DPLC_TILE_START_MAX + 1` tiles has tiles no entry can point at —
// and the producer that tries silently wraps into the low indices instead of
// failing (games/sonic4/data/characters/knuckles_data.emp records the one time
// that happened: 25 entries across frames 234-250 loaded early-frame art).
// -----------------------------------------------
pub const DPLC_TILE_COUNT_BITS   = 4
pub const DPLC_TILE_START_BITS   = 12
pub const DPLC_TILE_START_MAX    = (1 << DPLC_TILE_START_BITS) - 1      // 4095
pub const DPLC_ADDRESSABLE_TILES = DPLC_TILE_START_MAX + 1              // 4096
pub const DPLC_MAX_TILES_PER_ENTRY = 1 << DPLC_TILE_COUNT_BITS          // 16

// The two fields are the WHOLE word — widening one has to narrow the other, and
// this is the guard that says so. It is also the pin for the literals inlined in
// dplc_peak_tiles / dplc_peak_entries below: a comptime fn's free names resolve at
// its CALL site (docs/EMP_PITFALLS.md §2), so those bodies cannot spell the
// constants above and hold `$F` / `>> 12` as literals instead. Move a width here
// and this ensure fires, naming the bodies that have to move with it.
ensure(DPLC_TILE_COUNT_BITS + DPLC_TILE_START_BITS == 16,
       "the DPLC entry word is 16 bits: {DPLC_TILE_COUNT_BITS} count bits + {DPLC_TILE_START_BITS} tile_start bits do not fill it. Widening one field narrows the other — and the `>> 12` / `& $F` literals in dplc_peak_tiles and dplc_peak_entries, and the `andi.l`/`lsr.w` pair in perform_dplc, all encode this split")

// -----------------------------------------------
// ⚠ THERE IS NO `dplc_max_tile_start()` HERE, AND ADDING ONE WOULD BE A GATE THAT
// CANNOT FAIL. Read this before writing the obvious guard.
//
// The obvious guard is "walk the shipped blob, take the largest tile_start, assert
// it is <= DPLC_TILE_START_MAX". It is VACUOUS BY CONSTRUCTION: a stored tile_start
// is the low 12 bits of a 16-bit word, so `word & $FFF` is <= 4095 for every
// possible input. There is no blob, valid or corrupt, hand-edited or generated,
// that can make that ensure fire. Measured over all six shipped tables (max
// tile_start 3045 / 3621 / 272 / 4070 / 39 / 60): all under, all necessarily under.
//
// The overflow happens UPSTREAM OF THE BLOB. A producer computes a tile index >=
// 4096 for a run, packs it into a 12-bit field, and the value that lands in the
// file is the WRAPPED one — a legal-looking low index. By the time anything parses
// the emitted file the evidence is gone; that is exactly how the Knuckles `_opt`
// defect was shipped and then found by reconstructing frames from art, not by
// reading the DPLC.
//
// So the checkable precondition is a property of the ART SHEET, not of the table:
//
//     art tiles <= DPLC_ADDRESSABLE_TILES
//
// i.e. no tile in the sheet sits at an index a tile_start cannot name, so no layout
// a producer might choose can wrap. Each art blob's own module states it (the art
// blob is not visible from here), and tools/test_dplc_tile_start.py enumerates the
// modules so a new character cannot arrive without one. It is deliberately the
// CONSERVATIVE form of the bound: an entry legally reaches `tile_start + 15`, so a
// sheet of up to 4111 tiles could in principle be addressed if every run above 4080
// happened to start low enough — a layout accident no producer promises, and the
// remedy when this fires ("re-page or shrink the sheet") is the same either way.
// -----------------------------------------------

// -----------------------------------------------
// dplc_peak_entries — COMPTIME: the largest per-frame ENTRY count in a DPLC
// table, i.e. the peak Important-queue SLOT cost of one frame change.
//
// The sibling of dplc_peak_tiles, and the one the queue actually cares about:
// tiles size the VRAM window, entries consume queue slots, and the two are
// unrelated (a 29-tile frame can be 2 entries; a 16-tile frame can be 13).
// Pair it with the slot budget to make the wall a comptime fact:
//
//     ensure(dplc_peak_entries(_dplc_x) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS, "...")
//
// Same parser and same format spec as dplc_peak_tiles — a format change has to
// move both, and they are adjacent for that reason.
// -----------------------------------------------
pub comptime fn dplc_peak_entries(d: Data) -> int {
    comptime var peak = 0
    for f in 0..(((d[0] << 8) | d[1]) >> 1) {                  // frames = table[0] / 2
        comptime var fo = (d[f << 1] << 8) | d[(f << 1) + 1]   // frame block offset
        comptime var n = (d[fo] << 8) | d[fo + 1]              // that frame's entry count
        if n > peak { peak = n }
    }
    return peak
}

// -----------------------------------------------
// dplc_peak_tiles — COMPTIME: the largest per-frame tile total in a DPLC table,
// read straight out of the embedded blob. This is the number that decides how
// wide a character's VRAM DPLC window has to be, and until now it lived only in
// a comment (`up to N tiles`) that no build step checked — an art re-export that
// grew one frame would have silently DMA'd past the window into whatever was
// allocated next. A caller pairs this with its window base to make the wall a
// comptime fact:
//
//     ensure(VRAM_TEST_SONIC + dplc_peak_tiles(_dplc_sonic) <= VRAM_TEST_OBJ, "...")
//
// It parses the same format the runtime loop above walks — the format doc at the
// top of this file IS the spec, which is why the parser lives here and not in a
// game data module: a format change has to move both readers, and they are now
// adjacent. Frame count comes from the first offset word (the pointer table
// occupies exactly `frames * 2` bytes, so `table[0] / 2` is the count).
//
// A single ENTRY cannot exceed 16 tiles (the 4-bit count field) — the build tool
// splits longer runs — but a FRAME is the sum of its entries and has no such cap,
// so the sum is what this returns.
// -----------------------------------------------
// (The big-endian word reads are spelled out rather than factored into a helper:
// a private comptime fn is not visible at the CALLER's expansion site, and
// exporting a `be16` from the DPLC module would be a worse trade than three
// repetitions.)
pub comptime fn dplc_peak_tiles(d: Data) -> int {
    comptime var peak = 0
    for f in 0..(((d[0] << 8) | d[1]) >> 1) {                  // frames = table[0] / 2
        comptime var fo = (d[f << 1] << 8) | d[(f << 1) + 1]   // frame block offset
        comptime var total = 0
        for e in 0..(((d[fo] << 8) | d[fo + 1])) {             // that frame's entry count
            comptime var eo = fo + 2 + (e << 1)
            // entry word: bits 15-12 = tile_count-1, bits 11-0 = tile_start
            total = total + ((((d[eo] << 8) | d[eo + 1]) >> 12) & $F) + 1
        }
        if total > peak { peak = total }
    }
    return peak
}

// -----------------------------------------------
// perform_dplc — the shared DPLC body (single-sourced; the Important and
// Deferrable procs differ ONLY in which QueueDMA priority they call, so the
// 30-line load loop lives here once). `queue` selects the DMA queue proc.
// In/Out/Clobbers are the two procs' documented contract (see below).
// -----------------------------------------------
comptime fn perform_dplc(queue: Label) -> Code {
    return asm {
        move.b  Sst.mapping_frame(a0), d0
        cmp.b   Sst.prev_frame(a0), d0
        beq     .done                           // frame unchanged, skip (bare Bcc — sigil relaxes per-shape)
        // prev_frame is committed AFTER a successful enqueue (below), NOT
        // here — QueueDMATransfer returns carry-set when the queue is full and it
        // silently drops the request. Committing before meant a dropped frame left
        // prev_frame == mapping_frame, so the object believed its art loaded and
        // showed stale tiles until mapping_frame changed again. d0 still holds
        // mapping_frame for the resolve below.

        // Resolve DPLC frame data
        andi.w  #$FF, d0
        add.w   d0, d0
        adda.w  (a2,d0.w), a2                   // a2 = frame data pointer
        move.w  (a2)+, d4                        // d4 = entry count
        subq.w  #1, d4
        bmi     .done                            // 0 entries

        move.w  d1, d2                           // d2 = running VRAM dest

    .entry_loop:
        move.w  (a2)+, d0                        // DPLC entry word
        move.w  d0, d3
        lsr.w   #8, d3
        lsr.w   #4, d3                           // d3 = tile_count - 1
        addq.w  #1, d3                           // d3 = tile_count

        andi.l  #DPLC_TILE_START_MAX, d0         // tile_start_index — THE 12-bit field, from its one name
        lsl.l   #5, d0                           // byte offset (x32 = engine.constants.TILE_SIZE, forced by the 8x8 4bpp tile format)
        move.l  a3, d1                           // art base
        add.l   d0, d1                           // d1.l = source address

        lsl.w   #5, d3                           // d3.w = length (x32 = engine.constants.TILE_SIZE, forced by the 8x8 4bpp tile format)

        movem.l d2-d4/a2, -(sp)                  // a3 is live across the call but QueueDMA preserves it
        jbsr    {queue}                          // carry SET = dropped (queue full)
        movem.l (sp)+, d2-d4/a2                  // movem preserves CCR — the carry survives
        bcs     .done                            // dropped — leave prev_frame stale so next frame RETRIES

        add.w   d3, d2
        dbf     d4, .entry_loop
        // All entries enqueued OK — NOW commit prev_frame. Re-read
        // mapping_frame (unchanged this routine; d0 was consumed by the loop).
        move.b  Sst.mapping_frame(a0), d0
        move.b  d0, Sst.prev_frame(a0)
    .done:
        rts
    }
}

// -----------------------------------------------
// Perform_DPLC — load art for current mapping frame if changed
//
// In:  a0 = SST pointer
//      a2 = DPLC table pointer (ROM)
//      a3 = uncompressed art base address (ROM)
//      d1.w = VRAM destination (byte address)
// Out: none
// Clobbers: d0-d4, a1-a2
// -----------------------------------------------
pub proc Perform_DPLC (a0: *Sst, a2: *u8, a3: *u8, d1: u16) clobbers(d0-d4/a1-a2) {
        perform_dplc(QueueDMA_Important)
}

// -----------------------------------------------
// Perform_DPLC_Deferrable — same as Perform_DPLC but Deferrable priority
// Used for non-player objects (budget-gated, can slip one frame)
//
// In:  a0 = SST pointer
//      a2 = DPLC table pointer (ROM)
//      a3 = uncompressed art base address (ROM)
//      d1.w = VRAM destination (byte address)
// Out: none
// Clobbers: d0-d4, a1-a2
// -----------------------------------------------
pub proc Perform_DPLC_Deferrable (a0: *Sst, a2: *u8, a3: *u8, d1: u16) clobbers(d0-d4/a1-a2) {
        perform_dplc(QueueDMA_Deferrable)
}
