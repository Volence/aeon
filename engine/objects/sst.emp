// The spawn-template structs — Sst (the live $50-byte object record) and
// ObjDef (its compact 26-byte ROM source image). Both are TYPE-ONLY twins:
// this module emits ZERO bytes (no section, no placement). Sst gives object
// code typed field access (`Sst.code_addr(a0)`, and bare `code_addr(a0)` on
// an `a0: *Sst` param) instead of hand-carried displacement equs; ObjDef is
// the shape the objdef() emitter (engine/objects/objdef.emp) fills and
// consumers place. Sst is the SOLE author of the object-record layout: the
// build harvests its field offsets (`SST_*`) + size (`SST_len`) and injects
// them as guarded AS defines so the residual AS (ram.asm's `ds SST_len` slots,
// the gated player/test header equates) reads the same offsets.
//
// Sst's field offsets are pinned in-file: every field carries an `@` literal
// offset and the struct a `(size: $50)` — the layout engine verifies both, so
// a drifted field fails the module's own lowering. ObjDef is pinned to Sst by
// the burst-copy ensure-chain (below).
//
// Field types are the engine.types domain vocabulary (construct-walk #3,
// Volence-ratified): every type erases to the raw width, so the layout and
// offsets are untouched — the annotations carry MEANING
// (Coord vs Velocity vs a raw counter) and the fixed<I,F> scales.
module engine.objects.sst

use engine.types.{Coord, Velocity, Angle, ObjRoutine, HitboxDim, VramArtTile, AnimId, AnimFrame, MappingFrame}

pub struct Sst (size: $50) {
    // --- dispatch + position ------------------------------------------------
    // The first word IS the dispatch: the object executor jumps to
    // ObjCodeBase + code_addr each frame (0 = empty slot, the bank's safety
    // rts). Stores spell the value as a link-time difference — see the
    // object modules' `equ ROUTINE_* = extern("...") - OBJ_CODE_BASE`.
    code_addr: ObjRoutine,               // $00 — object code offset from ObjCodeBase [template word]
    x_pos: Coord @ $02,             // $02 — 16.16 subpixel X position [patched at spawn]
    y_pos: Coord @ $06,             // $06 — 16.16 subpixel Y position [patched at spawn]

    // --- template block $0A-$1F: copied verbatim from ObjDef at spawn -------
    x_vel: Velocity @ $0A,             // $0A — horizontal velocity (8.8 fixed-point)
    y_vel: Velocity @ $0C,             // $0C — vertical velocity (8.8 fixed-point)
    render_flags: u8 @ $0E,       // $0E — bit 0 = on-screen, 1 = x-flip, 2 = y-flip,
                                  //       3 = coordinate mode, 4 = multi-sprite,
                                  //       bits 5-7 = priority band
    collision_resp: u8 @ $0F,     // $0F — collision type dispatch (0 = none)
    mappings: u32 @ $10,          // $10 — sprite mapping pointer (ROM)
    art_tile: VramArtTile @ $14,          // $14 — VRAM tile index + palette + priority
    width_pixels: HitboxDim @ $16,    // $16 — collision width (full, not half)
    height_pixels: HitboxDim @ $17,   // $17 — collision height (full, not half)
    anim: AnimId @ $18,               // $18 — desired animation ID
    subtype: u8 @ $19,            // $19 — object subtype
    anim_table: u32 @ $1A,        // $1A — animation table pointer (ROM)
    status: u8 @ $1E,             // $1E — player/object status bits (ST_* constants)
    angle: Angle @ $1F,              // $1F — terrain angle (player, slope-aligned objects)

    // --- runtime block $20+: initialized individually at spawn --------------
    prev_anim: AnimId @ $20,          // $20 — previous anim ID (change detection; $FF at spawn)
    anim_frame: AnimFrame @ $21,  // $21 — byte cursor within the running animation script
    anim_timer: u8 @ $22,         // $22 — frame duration countdown
    mapping_frame: MappingFrame @ $23, // $23 — current mapping frame index
    prev_frame: MappingFrame @ $24,    // $24 — previous mapping_frame (DPLC change detection; $FF at spawn)
    sprite_piece_count: u8 @ $25, // $25 — current frame's piece count (overflow prediction)
    parent_ptr: u16 @ $26,        // $26 — parent object RAM address
    sibling_ptr: u16 @ $28,       // $28 — sibling link (multi-part objects)
    slot_tag: u8 @ $2A,           // $2A — entity window quadrant entry index 0-3 ($FF = untagged)
    entity_section_id: u8 @ $2B,  // $2B — spawning section's flat id (despawn bookkeeping)
    entity_list_index: u8 @ $2C,  // $2C — index in section's ROM object list (killed bitmask)
    layer: u8 @ $2D,              // $2D — collision layer select (0 = path A, 1 = path B)

    // --- per-object custom data ----------------------------------------------
    sst_custom: [u8; 34] @ $2E,   // $2E-$4F — overlay window (`vars X: sst_custom`)
}

// SST_interact ($4E): the tail word of the custom window, engine-owned for the
// TouchResponse lifecycle (the solid that claimed a PLAYER slot this pass) — NOT
// a Sst struct field, so it can't be reached by field name. `sizeof(Sst) - 2` is
// the record's tail word; the build harvests the same value as the AS SST_interact
// equ. Spelled as a comptime fn because a bare const in displacement position on a
// TYPED register is (correctly) closed to the field namespace — the call-expr form
// is the escape (collision + player_sensors consume it).
pub comptime fn interact_off() -> int {
    return sizeof(Sst) - 2
}

// -----------------------------------------------
// ObjDef — the v2 archetype spawn template. A COMPACT 26-byte ROM image
// (code_addr word + a 24-byte block) that Load_Object burst-copies into a
// fresh SST at spawn (load_object.emp). It is Sst's source image, not a
// second layout of it: the compact record closes the $02..$09 gap that
// Sst spends on runtime-only fields (x_pos/y_pos), so a template field at
// ObjDef offset N lands at Sst offset N + TEMPLATE_COPY_SHIFT — except
// code_addr, which copies at shift 0. This module co-locates ObjDef with
// Sst so the burst-copy correspondence (the ensure-chain below) checks
// both structs' `offsetof` in-file, at comptime.
// -----------------------------------------------
pub struct ObjDef (size: 26) {
    code_addr:      ObjRoutine  @ $00,   // objroutine(code) — code − ObjCodeBase (link word)
    x_vel:          Velocity    @ $02,   // 8.8 fixed-point
    y_vel:          Velocity    @ $04,
    render_flags:   u8          @ $06,   // render_bits | (priority << RF_PRIORITY_SHIFT)
    collision_resp: u8          @ $07,
    mappings:       u32         @ $08,   // sprite mapping pointer (ROM)
    art_tile:       VramArtTile @ $0C,
    width_pixels:   HitboxDim   @ $0E,
    height_pixels:  HitboxDim   @ $0F,
    anim:           AnimId      @ $10,
    subtype:        u8          @ $11,
    anim_table:     u32         @ $12,   // animation table pointer (ROM)
    status:         u8          @ $16,
    angle:          Angle       @ $17,
    pad:            u16         @ $18,    // → Sst $20-$21 (prev_anim/anim_frame), re-inited at spawn
}

// The +8 the template block gains when Load_Object does `lea Sst.x_vel(a1)`
// before the burst copy: Sst.x_vel($0A) − Sst.code_addr($00) − code_addr's
// 2 bytes = 8, the count of Sst-only bytes ($02..$09: x_pos/y_pos) the
// compact ObjDef omits.
const TEMPLATE_COPY_SHIFT = 8

// -----------------------------------------------
// Burst-copy correspondence — the ObjDef-twin payoff. Each ObjDef field
// must land on the matching Sst field when Load_Object copies it: code_addr
// at shift 0, every template field at +TEMPLATE_COPY_SHIFT. Both structs are
// in-file, so these are eager comptime `offsetof` compares — a layout drift
// on either side fails the BUILD naming the field. (Distinct from the
// extern() drift guards above, which cross the link seam to AS's structs.asm.)
// -----------------------------------------------
ensure(offsetof(ObjDef, code_addr) == offsetof(Sst, code_addr), "ObjDef/Sst burst-copy correspondence broken at code_addr")
ensure(offsetof(ObjDef, x_vel) + TEMPLATE_COPY_SHIFT == offsetof(Sst, x_vel), "ObjDef/Sst burst-copy correspondence broken at x_vel")
ensure(offsetof(ObjDef, y_vel) + TEMPLATE_COPY_SHIFT == offsetof(Sst, y_vel), "ObjDef/Sst burst-copy correspondence broken at y_vel")
ensure(offsetof(ObjDef, render_flags) + TEMPLATE_COPY_SHIFT == offsetof(Sst, render_flags), "ObjDef/Sst burst-copy correspondence broken at render_flags")
ensure(offsetof(ObjDef, collision_resp) + TEMPLATE_COPY_SHIFT == offsetof(Sst, collision_resp), "ObjDef/Sst burst-copy correspondence broken at collision_resp")
ensure(offsetof(ObjDef, mappings) + TEMPLATE_COPY_SHIFT == offsetof(Sst, mappings), "ObjDef/Sst burst-copy correspondence broken at mappings")
ensure(offsetof(ObjDef, art_tile) + TEMPLATE_COPY_SHIFT == offsetof(Sst, art_tile), "ObjDef/Sst burst-copy correspondence broken at art_tile")
ensure(offsetof(ObjDef, width_pixels) + TEMPLATE_COPY_SHIFT == offsetof(Sst, width_pixels), "ObjDef/Sst burst-copy correspondence broken at width_pixels")
ensure(offsetof(ObjDef, height_pixels) + TEMPLATE_COPY_SHIFT == offsetof(Sst, height_pixels), "ObjDef/Sst burst-copy correspondence broken at height_pixels")
ensure(offsetof(ObjDef, anim) + TEMPLATE_COPY_SHIFT == offsetof(Sst, anim), "ObjDef/Sst burst-copy correspondence broken at anim")
ensure(offsetof(ObjDef, subtype) + TEMPLATE_COPY_SHIFT == offsetof(Sst, subtype), "ObjDef/Sst burst-copy correspondence broken at subtype")
ensure(offsetof(ObjDef, anim_table) + TEMPLATE_COPY_SHIFT == offsetof(Sst, anim_table), "ObjDef/Sst burst-copy correspondence broken at anim_table")
ensure(offsetof(ObjDef, status) + TEMPLATE_COPY_SHIFT == offsetof(Sst, status), "ObjDef/Sst burst-copy correspondence broken at status")
ensure(offsetof(ObjDef, angle) + TEMPLATE_COPY_SHIFT == offsetof(Sst, angle), "ObjDef/Sst burst-copy correspondence broken at angle")
ensure(offsetof(ObjDef, pad) + TEMPLATE_COPY_SHIFT == offsetof(Sst, prev_anim), "ObjDef/Sst burst-copy correspondence broken at pad→prev_anim")
