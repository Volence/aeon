// aabb_axis_test — single-axis AABB overlap test (comptime-fn template).
// The single source of truth for the overlap math. Call twice (X then Y) for
// full 2D overlap.
//
// Tests: abs(apos - bpos) * 2 < (adim + bdim)
// Falls through if overlap on this axis; branches to mlab if not.
//
// Register contract:
//   apos        — position A (read-only, e.g. cached player X/Y)
//   breg + boff — position B memory operand boff(breg) (read-only;
//                 boff 0 collapses to (breg), asl parity)
//   adim,bdim   — widths/heights (consumed — aliasing with cdim/delt allowed)
//   cdim        — receives adim + bdim (may alias adim for zero-copy)
//   delt        — receives apos - bpos, signed (may alias bdim)
//   stmp        — scratch, clobbered (MUST NOT alias cdim or delt)
//   mlab        — label to branch to on no overlap
//
// Template labels are hygienic, so each instantiation gets its own .aov.
//
// The two branch widths stay PINNED `.s` (exempt from the bare-Bcc house
// rule, Volence-ratified 2026-07-10): mlab is a caller-supplied label, so the
// `.s` enforces the near-target reach contract — a far mlab must fail loud, not
// silently widen.
//
// Pure comptime-fn module: opens no section and emits ZERO bytes anywhere
// in the ROM — bytes appear only where a consumer splices the template.
module engine.objects.aabb

// Zero-copy skip: when cdim aliases adim the lead move is a no-op (its flags
// die at the following add), so emit it ONLY when the registers are distinct.
// A conditionally-empty Code value spliced into the stream: for the aliasing
// case (every call site today) it returns empty and inlines NOTHING — the
// byte-neutral no-op. Formerly this was an `if`-branch whose `asm{}` yielded
// Unit, so the would-be-emitting branch was latently DEAD; the splice makes it
// real, working code for the first non-aliasing caller.
comptime fn lead_move(adim: Reg, cdim: Reg) -> Code {
    if adim != cdim { return asm { move.w  {adim}, {cdim} } }
    return asm { }
}

pub comptime fn aabb_axis_test(apos: Reg, breg: Reg, boff: int, adim: Reg, bdim: Reg, cdim: Reg, delt: Reg, stmp: Reg, mlab: Label) -> Code {
    // The contract's stmp non-alias rule was prose only — the template
    // spliced whatever Reg it was handed, so `stmp == cdim` / `stmp == delt`
    // assembled CLEAN and miscompiled (the neg/double scratch clobbers a live
    // value). Reg equality is comptime-decidable (lead_move already compares
    // adim != cdim) — make the mis-instantiation a COMPILE error instead.
    ensure(stmp != cdim, "aabb_axis_test: stmp MUST NOT alias cdim — the scratch neg/double would destroy the combined dimension")
    ensure(stmp != delt, "aabb_axis_test: stmp MUST NOT alias delt — the scratch neg/double would destroy the signed delta")
    return asm {
        {lead_move(adim, cdim)}
        add.w   {bdim}, {cdim}

        move.w  {apos}, {delt}
        sub.w   {boff}({breg}), {delt}

        move.w  {delt}, {stmp}
        bpl     .aov
        // NOTE: delt == -32768 survives neg.w as $8000 → doubled = 0 →
        // false overlap. Unreachable via current callers (cull windows bound
        // |delta| << $4000); a new caller with unbounded delta must guard.
        neg.w   {stmp}
    .aov:
        add.w   {stmp}, {stmp}
        cmp.w   {cdim}, {stmp}
        bhs.s   {mlab}                  // PINNED .s (splice-hole exception): {mlab} is a caller-supplied label; the .s locks the near-target reach contract — a far target must fail loud, not silently widen
    }
}
