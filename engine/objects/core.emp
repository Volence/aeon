// Object system core — allocation, dispatch, deletion
//
// Build-shape input (-D __DEBUG__ AS-side → DEBUG==1 .emp-side): the
// Debug_AssertObjLoop proc + the two ifdebug call sites (in .run_always /
// .run_culled) exist only in the debug shape, so the region length differs
// per shape (plain 0x1C4, debug 0x2EC).

module engine.objects.core in core

use engine.objects.sst.{Sst}
use engine.constants.{NUM_PLAYERS, NUM_DYNAMIC, NUM_DYNAMIC_PENDING,
                      NUM_SYSTEM, NUM_EFFECTS,
                      OBJ_CODE_BANK, CULL_DISTANCE_X,
                      CULL_DISTANCE_Y, SLOT_TAG_UNTAGGED}

// Contract type (contract-grammar v2 §4) — the object-dispatch bound. Every
// object's code routine is entered with a0 = SST pointer and MUST preserve
// a0 and d7 (the loop count); everything else is clobberable. Enforced in
// debug by Debug_AssertObjLoop, now bounded at compile time. Referenced by the
// object-dispatch `jsr (a1) as ObjRoutine` here and animate.emp's callback.
pub type ObjRoutine = proc (a0: *Sst) preserves(a0, d7)

// Link-time drift-lock: RunObjects_Frozen's merged
// System+Effect sweep (`lea System_Slots, a0` + `move.w #NUM_SYSTEM+NUM_EFFECTS-1`)
// walks the two pools as ONE contiguous run — it depends on Effect_Slots
// immediately following the System_Slots block in RAM, which nothing else
// enforces. extern() resolves the RAM labels at link (collision.emp's SST_interact
// precedent); a ram.asm reorder that broke the adjacency would fail the link.
ensure(extern("Effect_Slots") == extern("System_Slots") + sizeof(Sst)*NUM_SYSTEM, "ram.asm: Effect_Slots must immediately follow the System_Slots block — RunObjects_Frozen sweeps System+Effect as one contiguous NUM_SYSTEM+NUM_EFFECTS run")

// Store d0 (the fill value) to (a0)+ n times — the unrolled long-word
// clear/fill. Emits `move.l d0, (a0)+` × n, byte-identical to the hand
// unroll; the count derives from the type so an SST size change re-emits
// the right number of stores instead of drifting a hand list.
// LOCKSTEP: core.asm's DeleteObject spells this as n hand-written
// `move.l d0, (a0)+` lines (no AS `rept`) — the debug/plain byte gates are
// the guard; an SST size change must update both sides (the gate names the
// first diverging byte if only one moves).
comptime fn clear_longs(n: int) -> Code {
    return 0..n |> fold(asm {}, |acc, _i| acc ++ asm { move.l d0, (a0)+ })
}

// -----------------------------------------------
// InitObjectRAM — clear all slots, push addresses to free stacks
// Called at game state init (level start, etc.)
// In:  none
// Out: none
// Clobbers: d0-d1, a0-a1
// -----------------------------------------------
pub proc InitObjectRAM () clobbers(d0-d1/a0-a1) {
        // Zero all Object RAM
        lea     Object_RAM, a0
        move.w  #(extern("Object_RAM_End")-extern("Object_RAM"))/4-1, d0
        moveq   #0, d1
    .clear:
        move.l  d1, (a0)+
        dbf     d0, .clear

        // Init dynamic free stack — push slot addresses low-to-high (slot 2
        // pushed first ... slot 41 pushed last). Pops are LIFO, so the
        // LAST-pushed (highest) slot is allocated first; the pool fills
        // downward toward slot 2.
        lea     Dynamic_Free_Stack, a0
        lea     Dynamic_Slots, a1
        move.w  #NUM_DYNAMIC-1, d0
    .push_dyn:
        move.w  a1, (a0)+
        lea     sizeof(Sst)(a1), a1
        dbf     d0, .push_dyn
        move.w  #extern("Dynamic_Free_Stack")+NUM_DYNAMIC*2, (Dynamic_Free_SP).w   // explicit .w kept: a link-imm source + bare (relaxable) symbolic dest can't both defer — the imm-link lowering gap

        // Init effect free stack
        lea     Effect_Free_Stack, a0
        lea     Effect_Slots, a1
        move.w  #NUM_EFFECTS-1, d0
    .push_eff:
        move.w  a1, (a0)+
        lea     sizeof(Sst)(a1), a1
        dbf     d0, .push_eff
        move.w  #extern("Effect_Free_Stack")+NUM_EFFECTS*2, (Effect_Free_SP).w   // explicit .w kept: link-imm source + bare symbolic dest — imm-link lowering gap (see line 63)

        // Reset the dynamic live-list (spawn-order occupancy): empty, not dirty.
        // The Dynamic_Live array itself needs no clear — Count 0 means no entry
        // is valid. d1 still 0 from the .clear loop.
        move.w  d1, Dynamic_Live_Count
        move.b  d1, Dynamic_Live_Dirty
        rts
}

// -----------------------------------------------
// AllocDynamic — pop a free dynamic slot
// In:  none
// Out: a1 = SST address of allocated slot (d0=0/Z set on success)
//      d0=1/Z clear if pool exhausted
//      Slot is tagged SLOT_TAG_UNTAGGED on return.
// Clobbers: d0
// CALLER INVARIANT: the caller MUST write the returned slot's
// code_addr before the NEXT AllocDynamic. The append-on-full guard runs
// CompactDynamicLive, which treats code_addr==0 as dead and drops the slot
// from the live list — so a caller that allocs a second slot before
// initializing the first would silently lose the first (a claimed-but-invisible
// zombie), reachable only at a full count. All current callers write code_addr
// immediately (children/load_object/object_test emitters).
// -----------------------------------------------
pub proc AllocDynamic () clobbers(d0) out(a1 if eq) preserves(a0) {
        cmpi.w  #extern("Dynamic_Free_Stack"), (Dynamic_Free_SP).w   // explicit .w kept: link-imm source + bare symbolic dest — imm-link lowering gap (see AllocDynamic init)
        beq     .full
        movea.w Dynamic_Free_SP, a1
        subq.w  #2, Dynamic_Free_SP
        movea.w -(a1), a1
        move.b  #SLOT_TAG_UNTAGGED, Sst.slot_tag(a1)
        // Spawn-order occupancy: append the popped slot to the live list
        // (Dynamic_Live[Count++] = a1), UNIQUE by construction — DeleteObject
        // zeroed any prior entry for this slot, so a LIFO recycle can't
        // list it twice. a0 is saved LONG — callers hold a full 32-bit pointer
        // (Load_ObjectList's ROM list ptr). Spawn-time only.
        // Overflow latch (spec §9): at a FULL live list, latch the popped
        // slot for the frame-end drain instead of compacting mid-frame under a
        // held walker cursor (the mid-walk-compact hazard). The slot IS
        // allocated (the caller sets code_addr); it joins Dynamic_Live at the
        // frame-end drain and first dispatches NEXT frame — so a latched spawn
        // misses same-frame TouchResponse (collision begins next frame). The
        // live list is NEVER mutated mid-frame by the alloc path now.
        cmpi.w  #NUM_DYNAMIC, Dynamic_Live_Count
        bne     .append
        cmpi.w  #NUM_DYNAMIC_PENDING, Dynamic_Live_Pending_Count
        beq     .latch_full            // latch full → roll back the pop, alloc-fail
        move.l  a0, -(sp)
        lea     Dynamic_Live_Pending, a0
        move.w  Dynamic_Live_Pending_Count, d0
        add.w   d0, d0                 // word index -> byte offset
        move.w  a1, (a0, d0.w)
        addq.w  #1, Dynamic_Live_Pending_Count
        movea.l (sp)+, a0
        moveq   #0, d0                 // Z set = success (latched; dispatches next frame)
        rts
    .append:
        move.l  a0, -(sp)
        lea     Dynamic_Live, a0
        move.w  Dynamic_Live_Count, d0
        add.w   d0, d0                  // word index -> byte offset
        move.w  a1, (a0, d0.w)
        addq.w  #1, Dynamic_Live_Count
        movea.l (sp)+, a0
        moveq   #0, d0                  // Z set = success
        rts
    .latch_full:
        // The slot was already popped before the full count was known; return it
        // to the free stack so it is not leaked (re-exposed at the current SP).
        addq.w  #2, Dynamic_Free_SP
        // fall into .full
    .full:
        moveq   #1, d0                  // Z clear = pool exhausted (or latch full)
        rts
}

// -----------------------------------------------
// AllocEffect — pop a free effect slot
// In:  none
// Out: a1 = SST address of allocated slot (d0=0/Z set on success)
//      d0=1/Z clear if pool exhausted
// Clobbers: d0
// -----------------------------------------------
pub proc AllocEffect () clobbers(d0) out(a1 if eq) {
        cmpi.w  #extern("Effect_Free_Stack"), (Effect_Free_SP).w   // explicit .w kept: link-imm source + bare symbolic dest — imm-link lowering gap (see AllocDynamic)
        beq     .full
        movea.w Effect_Free_SP, a1
        subq.w  #2, Effect_Free_SP
        movea.w -(a1), a1
        // No slot_tag write (unlike AllocDynamic): slot_tag is the entity-window
        // quadrant index, read ONLY by the entity-window Y-despawn band. Effects
        // are never entity-window-managed (object code allocs them and they
        // self-delete), so their slot_tag is never read — nothing to initialize.
        moveq   #0, d0
        rts
    .full:
        moveq   #1, d0
        rts
}

// -----------------------------------------------
// DeleteObject — push slot back to appropriate free stack, zero SST
// Pool detection (RAM order: Player | Dynamic | System | Effect):
//   addr < Dynamic_Slots           → player slot (no stack push)
//   addr >= Dynamic_Slots AND
//          addr < System_Slots     → dynamic pool
//   addr >= System_Slots AND
//          addr < Effect_Slots     → system slot (no stack push)
//   addr >= Effect_Slots AND
//          addr < Effect_Slots+
//                 SST_len*NUM_EFFECTS → effect pool
// In:  a0 = SST address of object to delete
// Out: none
// Clobbers: d0, a1
// -----------------------------------------------
pub proc DeleteObject (a0: *Sst) clobbers(d0-d1, a1) preserves(a0) {
        // DEBUG rails: a0 must point at a live SST inside Object_RAM.
        // An out-of-range a0 falls to .clear_slot and zeroes wild memory; a
        // code_addr==0 slot is an already-deleted (double-delete) slot whose
        // re-push corrupts the free stack (the classic double-alloc bug). d0 is
        // clobbered — free as the scratch comparand. Byte-neutral in release.
        if DEBUG == 1 {
        assert.l a0, hs, #Object_RAM
        assert.l a0, lo, #Object_RAM_End
        move.w  Sst.code_addr(a0), d0
        assert.w d0, ne, #0
        }
        // Check Effect pool first (highest address range)
        cmpa.w  #extern("Effect_Slots"), a0
        bhs     .check_effect

        // Below Effect_Slots — check System_Slots
        cmpa.w  #extern("System_Slots"), a0
        bhs     .clear_slot             // system slot: just clear, no push

        // Below System_Slots — check Dynamic_Slots
        cmpa.w  #extern("Dynamic_Slots"), a0
        bhs     .dynamic_pool

        // Below Dynamic_Slots — player slot: just clear, no push
        jbra    .clear_slot

    .check_effect:
        // Past Effect_Slots — confirm it's within the effect range
        cmpa.w  #extern("Effect_Slots")+sizeof(Sst)*NUM_EFFECTS, a0
        bhs     .clear_slot             // out of effect range (shouldn't happen)
        // Fall through: it's a valid effect slot

    .effect_pool:
        movea.w Effect_Free_SP, a1
        move.w  a0, (a1)+
        move.w  a1, Effect_Free_SP
        jbra    .clear_slot

    .dynamic_pool:
        movea.w Dynamic_Free_SP, a1
        move.w  a0, (a1)+
        move.w  a1, Dynamic_Free_SP
        st      Dynamic_Live_Dirty      // dynamic deletion -> compact live list at frame end
        // ZERO this slot's live-list entry so a same-frame LIFO realloc can't
        // list it twice (the permanent-duplicate hazard, §6). Scan is <=NUM_DYNAMIC
        // words and deletes are rare; zeroing moves nothing, so a live walker's
        // cursor stays valid (the null-guard skips a zeroed entry). d1 is saved —
        // it is not in the clobber contract.
        move.w  d1, -(sp)
        move.w  a0, d1                  // d1 = low16(slot addr) = the entry to find
        lea     Dynamic_Live, a1
        move.w  Dynamic_Live_Count, d0
        beq     .dyn_zero_pending
        subq.w  #1, d0
    .dyn_zero_scan:
        cmp.w   (a1)+, d1
        beq     .dyn_zero_hit
        dbf     d0, .dyn_zero_scan
        jbra    .dyn_zero_pending
    .dyn_zero_hit:
        clr.w   -(a1)                  // (a1)+ passed the match; step back and zero it
    .dyn_zero_pending:
        // Overflow latch (spec §9): also zero a matching PENDING-latch entry. A slot latched
        // THIS frame (allocated, code_addr set, not yet in the live list) can be
        // DeleteObject'd the same frame; the stale latch entry would make the
        // frame-end drain re-append it (and a LIFO re-latch would list it twice —
        // the permanent double-dispatch that entry-zeroing killed). Zeroing keeps "exactly once"
        // total over the latch too; the drain null-guards a zeroed entry.
        lea     Dynamic_Live_Pending, a1
        move.w  Dynamic_Live_Pending_Count, d0
        beq     .dyn_zero_done
        subq.w  #1, d0
    .dyn_pend_scan:
        cmp.w   (a1)+, d1
        beq     .dyn_pend_hit
        dbf     d0, .dyn_pend_scan
        jbra    .dyn_zero_done
    .dyn_pend_hit:
        clr.w   -(a1)
    .dyn_zero_done:
        move.w  (sp)+, d1

    .clear_slot:
        // Zero all sizeof(Sst) bytes of the SST entry, one long at a time.
        moveq   #0, d0
        clear_longs(sizeof(Sst) / 4)
        lea     -sizeof(Sst)(a0), a0 // restore a0 to slot start
        rts
}

// -----------------------------------------------
// CompactDynamicLive — reconcile the dynamic live-list
// Rewrites Dynamic_Live in place, KEEPING only entries that are nonzero AND
// point at a live slot (code_addr != 0); drops zeroed entries (deleted slots) and
// dead-code_addr entries alike, then recounts and clears the dirty flag.
// Because it MOVES entries down over drops, it MUST run only when no dynamic
// live-list walk holds a cursor. Since the overflow latch (spec §9) it is called ONLY from the
// RunObjects frame-end reconcile (all walks done → no walk live by
// construction): the AllocDynamic full-count path now LATCHES instead of
// compacting, so the mid-walk-compact hazard is gone. The DEBUG
// Dynamic_Live_Walking rail asserts the walk flag is clear here as a
// regression guard — it should now NEVER fire. The §6-2/§6-3 post-state
// invariant asserts moved to DrainDynamicPending (they must verify the list
// AFTER the latch drain appends).
// In:  none
// Out: none
// Clobbers: d0, d1, a0, a1, a2
// -----------------------------------------------
proc CompactDynamicLive () clobbers(d0-d1/a0-a2) {
        // Walk-flag assert rail: a live-list walk must NOT be in progress — compaction
        // moves entries down under any held cursor (the mid-walk double-dispatch
        // hazard). d0 is free at entry (clobbered below). DEBUG-only, byte-neutral.
        if DEBUG == 1 {
        move.b  Dynamic_Live_Walking, d0
        assert.b d0, eq, #0
        }
        lea     Dynamic_Live, a0        // read cursor
        lea     Dynamic_Live, a1        // write cursor (compacts down over drops)
        move.w  Dynamic_Live_Count, d1
        assert.w d1, ls, #NUM_DYNAMIC   // §6 (1): count never exceeds capacity
        beq     .recount
        subq.w  #1, d1
    .loop:
        move.w  (a0)+, d0               // entry word
        beq     .next                   // zeroed (deleted) — drop
        movea.w d0, a2
        tst.w   (a2)                    // slot code_addr
        beq     .next                   // dead slot — drop
        move.w  d0, (a1)+               // keep — copy down
    .next:
        dbf     d1, .loop
    .recount:
        lea     Dynamic_Live, a0        // new count = (write - base) / 2
        suba.l  a0, a1
        move.w  a1, d0
        lsr.w   #1, d0
        move.w  d0, Dynamic_Live_Count
        sf      Dynamic_Live_Dirty
        rts
}

// -----------------------------------------------
// DrainDynamicPending — append the overflow latch to the live list
// (spec §9). Runs at the RunObjects frame-end reconcile, immediately AFTER
// CompactDynamicLive (which reclaimed room from the frame's deletions). Appends
// each non-zero Dynamic_Live_Pending entry to Dynamic_Live IN ALLOC ORDER, so a
// latched (saturated-frame) spawn keeps spawn-order dispatch and first runs the
// NEXT frame. A zeroed latch entry (deleted-while-latched) is
// dropped. Then clears the latch count.
// Room is guaranteed (no overflow): only NUM_DYNAMIC physical dynamic slots
// exist, and at drain every occupied slot has EXACTLY ONE live entry, in the
// live list OR the latch, never both (DeleteObject zeroes the deleted slot's
// entry in both; once count hits NUM_DYNAMIC it stays there with no mid-frame
// compact, so a latched slot can only be re-latched). Hence (live count) +
// (non-zero latch) = occupied ≤ NUM_DYNAMIC → room ≥ latch entries appended.
// In:  none  Out: none
// Clobbers: d0, d1, d2, a0, a1
// -----------------------------------------------
proc DrainDynamicPending () clobbers(d0-d2/a0-a1) {
        move.w  Dynamic_Live_Pending_Count, d1
        beq     .clear                  // empty (dirty-only reconcile) — nothing to append
        subq.w  #1, d1
        lea     Dynamic_Live_Pending, a0
        lea     Dynamic_Live, a1
        move.w  Dynamic_Live_Count, d0
        add.w   d0, d0                  // d0 = live byte offset (append cursor)
    .loop:
        move.w  (a0)+, d2               // latched entry
        beq     .next                   // zeroed (deleted while latched) — drop
        move.w  d2, (a1, d0.w)          // append in alloc order → spawn-order preserved
        addq.w  #2, d0
        addq.w  #1, Dynamic_Live_Count
    .next:
        dbf     d1, .loop
    .clear:
        clr.w   Dynamic_Live_Pending_Count
        // §6-2/§6-3 invariant on the FINAL reconciled list (moved here from
        // CompactDynamicLive, which now runs pre-drain): post-drain count == a
        // full-pool tst.w live sweep (no duplicate, none missing — the
        // no-double-dispatch check entry-zeroing enables), count <= capacity (the §9 room proof), and
        // every live entry points into object RAM.
        if DEBUG == 1 {
        move.w  Dynamic_Live_Count, d0
        lea     Dynamic_Slots, a0
        move.w  #NUM_DYNAMIC-1, d1
    .sweep_loop:
        tst.w   (a0)
        beq     .sweep_next
        subq.w  #1, d0
    .sweep_next:
        lea     sizeof(Sst)(a0), a0
        dbf     d1, .sweep_loop
        assert.w d0, eq, #0             // count == occupied (≤ NUM_DYNAMIC by the §9 room proof)
        move.w  Dynamic_Live_Count, d1
        beq     .dbg_done
        lea     Dynamic_Live, a0
        subq.w  #1, d1
    .entry_check:
        movea.w (a0)+, a1
        assert.l a1, hs, #Object_RAM
        assert.l a1, lo, #Object_RAM_End
        dbf     d1, .entry_check
    .dbg_done:
        }
        rts
}

// -----------------------------------------------
// RunObjects — dispatch all active object slots
// Per-pool loops: players/system/effects always execute,
// dynamic pool is culled by distance from camera.
// Objects that want to die call DeleteObject directly.
//
// Convention: object routines receive a0 = self SST pointer.
// Object routines MUST preserve a0 and d7.
// In:  none
// Out: none
// Clobbers: d0-d6, a0-a6 (object code may clobber freely except a0/d7)
// -----------------------------------------------
pub proc RunObjects () clobbers(d0-d7/a0-a6) {
        tst.b   Game_Paused
        bne     RunObjects_Frozen

        // --- Player slots (always execute) ---
        lea     Player_1, a0
        move.w  #NUM_PLAYERS-1, d7
        jbsr    .run_always

        // --- Dynamic slots (culled by distance, walked in spawn order via
        //     the live list — empty slots cost zero; .run_culled sets up its
        //     own cursor + count) ---
        jbsr    .run_culled

        // --- System slots (always execute) ---
        lea     System_Slots, a0
        move.w  #NUM_SYSTEM-1, d7
        jbsr    .run_always

        // --- Effect slots (always execute) ---
        lea     Effect_Slots, a0
        move.w  #NUM_EFFECTS-1, d7
        jbsr    .run_always

        // --- Frame-end reconcile (spec §9): every walk is done (no walk
        //     live), so CompactDynamicLive can move entries down over drops, then
        //     DrainDynamicPending appends the overflow latch IN ALLOC ORDER
        //     (spawn-order preserved). Runs when a deletion dirtied the list OR
        //     the latch holds pending spawns — latch-non-empty ⇒ dirty by
        //     construction, but the OR guards against ever leaking a latched
        //     object. O(1) on a quiet frame. ---
        tst.b   Dynamic_Live_Dirty
        bne     .reconcile
        tst.w   Dynamic_Live_Pending_Count
        beq     .no_reconcile
    .reconcile:
        jbsr    CompactDynamicLive
        jbsr    DrainDynamicPending
    .no_reconcile:
        rts

    // Dispatch loop — no culling
    .run_always:
    .always_loop:
        moveq   #OBJ_CODE_BANK, d0
        swap    d0
        move.w  (a0), d0
        beq     .always_next
        movea.l d0, a1
        jsr     (a1) as ObjRoutine
        // debug builds: catch object routines violating the a0/d7
        // preservation contract at the source.
        if DEBUG == 1 { jbsr Debug_AssertObjLoop }
    .always_next:
        lea     sizeof(Sst)(a0), a0
        dbf     d7, .always_loop
        rts

    // Dispatch loop — dynamic pool, walked in SPAWN order via the live list.
    // Empty slots cost ZERO (never appended); a dead-but-uncompacted entry
    // (deleted this frame, compaction pending) costs one tst.w guard. d7
    // snapshots the count at entry, so a child appended mid-walk first runs
    // NEXT frame (deterministic). a2 is the list cursor; object code may
    // clobber it (only a0/d7 are preserved across dispatch), so it is saved
    // across the jsr.
    .run_culled:
        // Walk-flag assert rail: dispatched object code may AllocDynamic mid-walk, and
        // a2 holds a live cursor into Dynamic_Live — flag the walk so a resulting
        // CompactDynamicLive trips the assert instead of moving entries silently.
        if DEBUG == 1 { st Dynamic_Live_Walking }
        lea     Dynamic_Live, a2
        move.w  Dynamic_Live_Count, d7
        beq     .culled_done
        subq.w  #1, d7
    .culled_loop:
        move.w  (a2)+, d0               // load the entry and null-guard a
        beq     .culled_next            //     zeroed entry (same-frame delete) —
        movea.w d0, a0                  //     don't dereference a zero
        tst.w   (a0)                    // truth guard: skip a dead-uncompacted slot
        beq     .culled_next

        // X distance check: abs(obj_x - camera_x)
        move.w  Sst.x_pos(a0), d0
        sub.w   Camera_X, d0
        bpl     .culled_xpos
        neg.w   d0
    .culled_xpos:
        cmpi.w  #CULL_DISTANCE_X, d0
        bhi     .culled_next

        // Y distance check: abs(obj_y - camera_y)
        move.w  Sst.y_pos(a0), d0
        sub.w   Camera_Y, d0
        bpl     .culled_ypos
        neg.w   d0
    .culled_ypos:
        cmpi.w  #CULL_DISTANCE_Y, d0
        bhi     .culled_next

        // Within range — dispatch (a2 saved: object code may clobber it)
        moveq   #OBJ_CODE_BANK, d0
        swap    d0
        move.w  (a0), d0
        movea.l d0, a1
        move.l  a2, -(sp)
        jsr     (a1) as ObjRoutine
        movea.l (sp)+, a2
        // debug builds: catch a0/d7 preservation-contract violations at the source
        if DEBUG == 1 { jbsr Debug_AssertObjLoop }
    .culled_next:
        dbf     d7, .culled_loop
    .culled_done:
        if DEBUG == 1 { sf Dynamic_Live_Walking }
        rts
}

// -----------------------------------------------
// Debug_AssertObjLoop — verify the RunObjects loop contract after dispatch
// Object routines must return with a0 = own SST and d7 = loop counter
// intact. A violation here means object routines clobbered a0/d7,
// causing free-stack words to dispatch as code offsets.
// In:  a0 = slot just dispatched, d7 = loop counter
// Out: none (raises debugger error on violation)
// Clobbers: none
//
// DEBUG-shape only (AS twin's `ifdef __DEBUG__`): the whole proc emits ZERO
// bytes in the plain shape — the body sits inside `if DEBUG == 1 {}` so the
// region length is shape-dependent (rings.emp precedent).
// -----------------------------------------------
pub proc Debug_AssertObjLoop (a0: *Sst, d7: u16) clobbers() {
    if DEBUG == 1 {
        // wrapper elides the whole proc body in the plain shape (asserts
        // self-gate; the rts does not — core_port's debug_shape_length_diverges
        // pins plain = zero bytes)
        // a0 must point into Object_RAM (own SST), d7 into the loop counter
        // range — a violation means an object routine clobbered the contract.
        assert.l a0, hs, #Object_RAM
        assert.l a0, lo, #Object_RAM_End
        assert.w d7, lo, #NUM_DYNAMIC
        rts
    }
}

// -----------------------------------------------
// RunObjects_Frozen — render-only pass (player death, pause)
// Calls Draw_Sprite for each occupied slot, skips object logic. Player + system
// + effect keep small fixed sweeps (26 slots); the dynamic segment walks the
// spawn-order live list, so paused frames skip the ~37 empty dynamic slots too.
// In:  none
// Out: none
// Clobbers: d0-d6, a0-a6
// -----------------------------------------------
pub proc RunObjects_Frozen () clobbers(d0-d7/a0-a6) {
        // Players (fixed sweep, 2 slots)
        lea     Player_1, a0
        move.w  #NUM_PLAYERS-1, d7
        jbsr    .frozen_fixed

        // Dynamic pool — spawn-order live list (empty slots cost zero). a2 is
        // the cursor; Draw_Sprite preserves a0/d7/a2, so no save is needed
        // (unlike .run_culled, whose dispatched object code may clobber a2).
        // Walk-flag assert rail: Draw_Sprite doesn't alloc today, but flag the walk so
        // the CompactDynamicLive assert stays TOTAL if it ever gains a spawn.
        if DEBUG == 1 { st Dynamic_Live_Walking }
        lea     Dynamic_Live, a2
        move.w  Dynamic_Live_Count, d7
        beq     .frozen_dyn_done
        subq.w  #1, d7
    .frozen_dyn_loop:
        move.w  (a2)+, d0               // null-guard a zeroed entry — no deref
        beq     .frozen_dyn_next
        movea.w d0, a0
        tst.w   (a0)                    // truth guard: dead-but-uncompacted slot
        beq     .frozen_dyn_next
        jbsr    Draw_Sprite
    .frozen_dyn_next:
        dbf     d7, .frozen_dyn_loop
    .frozen_dyn_done:
        if DEBUG == 1 { sf Dynamic_Live_Walking }

        // System + Effect (fixed sweep, contiguous 24 slots)
        lea     System_Slots, a0
        move.w  #NUM_SYSTEM+NUM_EFFECTS-1, d7
        jbsr    .frozen_fixed
        rts

    // Fixed-pool sweep — Draw each occupied slot across an [a0 .. a0+d7] run
    .frozen_fixed:
    .frozen_fixed_loop:
        tst.w   (a0)
        beq     .frozen_fixed_next
        jbsr    Draw_Sprite
    .frozen_fixed_next:
        lea     sizeof(Sst)(a0), a0
        dbf     d7, .frozen_fixed_loop
        rts
}

// -----------------------------------------------
// ObjectMove — apply velocity to position (X and Y)
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc ObjectMove (a0: *Sst) clobbers(d0) {
        move.w  Sst.x_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.x_pos(a0)
        move.w  Sst.y_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.y_pos(a0)
        rts
}

// -----------------------------------------------
// ObjectMoveX — apply X velocity only
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc ObjectMoveX (a0: *Sst) clobbers(d0) {
        move.w  Sst.x_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.x_pos(a0)
        rts
}

// -----------------------------------------------
// ObjectMoveY — apply Y velocity only (gravity, falling)
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc ObjectMoveY (a0: *Sst) clobbers(d0) {
        move.w  Sst.y_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.y_pos(a0)
        rts
}
