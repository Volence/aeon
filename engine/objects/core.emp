// Object system core — allocation, dispatch, deletion
//
// Build-shape input (-D __DEBUG__ AS-side → DEBUG==1 .emp-side): the
// Debug_AssertObjLoop proc + the two ifdebug call sites (in .run_always /
// .run_culled) exist only in the debug shape, so the region length differs
// per shape (plain 0x1C4, debug 0x2EC).

module engine.objects.core in core

use engine.objects.sst.{Sst}
use engine.constants.{NUM_PLAYERS, NUM_DYNAMIC, NUM_SYSTEM, NUM_EFFECTS,
                      NUM_TOTAL_SLOTS, OBJ_CODE_BANK, CULL_DISTANCE_X,
                      CULL_DISTANCE_Y, SLOT_TAG_UNTAGGED}

// Store d0 (the fill value) to (a0)+ n times — the unrolled long-word
// clear/fill. Emits `move.l d0, (a0)+` × n, byte-identical to the hand
// unroll; the count derives from the type so an SST size change re-emits
// the right number of stores instead of drifting a hand list.
// LOCKSTEP: core.asm's DeleteObject spells this as n hand-written
// `move.l d0, (a0)+` lines (no AS `rept`) — the debug/plain byte gates are
// the guard; an SST size change must update both sides (the gate names the
// first diverging byte if only one moves).
comptime fn clear_longs(n: int) -> Code {
    return 0..n |> fold(asm {}, |acc, _i| acc ++ asm { move.l d0, (a0)+ })
}

// -----------------------------------------------
// InitObjectRAM — clear all slots, push addresses to free stacks
// Called at game state init (level start, etc.)
// In:  none
// Out: none
// Clobbers: d0-d1, a0-a1
// -----------------------------------------------
pub proc InitObjectRAM () clobbers(d0, d1, a0, a1) {
        // Zero all Object RAM
        lea     Object_RAM, a0
        move.w  #(extern("Object_RAM_End")-extern("Object_RAM"))/4-1, d0
        moveq   #0, d1
    .clear:
        move.l  d1, (a0)+
        dbf     d0, .clear

        // Init dynamic free stack — push slot addresses low-to-high (slot 2
        // pushed first ... slot 41 pushed last). Pops are LIFO, so the
        // LAST-pushed (highest) slot is allocated first; the pool fills
        // downward toward slot 2.
        lea     Dynamic_Free_Stack, a0
        lea     Dynamic_Slots, a1
        move.w  #NUM_DYNAMIC-1, d0
    .push_dyn:
        move.w  a1, (a0)+
        lea     sizeof(Sst)(a1), a1
        dbf     d0, .push_dyn
        move.w  #extern("Dynamic_Free_Stack")+NUM_DYNAMIC*2, (Dynamic_Free_SP).w

        // Init effect free stack
        lea     Effect_Free_Stack, a0
        lea     Effect_Slots, a1
        move.w  #NUM_EFFECTS-1, d0
    .push_eff:
        move.w  a1, (a0)+
        lea     sizeof(Sst)(a1), a1
        dbf     d0, .push_eff
        move.w  #extern("Effect_Free_Stack")+NUM_EFFECTS*2, (Effect_Free_SP).w

        // Reset the dynamic live-list (spawn-order occupancy): empty, not dirty.
        // The Dynamic_Live array itself needs no clear — Count 0 means no entry
        // is valid. d1 still 0 from the .clear loop.
        move.w  d1, Dynamic_Live_Count
        move.b  d1, Dynamic_Live_Dirty

        // Reset spawn counter (d1 still 0 from .clear loop)
        move.w  d1, Spawn_Count
        rts
}

// -----------------------------------------------
// AllocDynamic — pop a free dynamic slot
// In:  none
// Out: a1 = SST address of allocated slot (d0=0/Z set on success)
//      d0=1/Z clear if pool exhausted
//      Slot is tagged SLOT_TAG_UNTAGGED on return.
// Clobbers: d0
// -----------------------------------------------
pub proc AllocDynamic () clobbers(d0) out(a1) {
        cmpi.w  #extern("Dynamic_Free_Stack"), (Dynamic_Free_SP).w
        beq     .full
        movea.w (Dynamic_Free_SP).w, a1
        subq.w  #2, (Dynamic_Free_SP).w
        movea.w -(a1), a1
        move.b  #SLOT_TAG_UNTAGGED, Sst.slot_tag(a1)
        // Spawn-order occupancy: append the popped slot to the live list
        // (Dynamic_Live[Count++] = a1). a0 is saved as a LONG — callers hold a
        // full 32-bit pointer (Load_ObjectList's ROM list ptr) across the call,
        // so a word save/restore would truncate it. O(1), spawn-time only.
        move.l  a0, -(sp)
        lea     Dynamic_Live, a0
        move.w  Dynamic_Live_Count, d0
        add.w   d0, d0                  // word index -> byte offset
        move.w  a1, (a0, d0.w)
        addq.w  #1, Dynamic_Live_Count
        movea.l (sp)+, a0
        moveq   #0, d0                  // Z set = success
        rts
    .full:
        moveq   #1, d0                  // Z clear = pool exhausted
        rts
}

// -----------------------------------------------
// AllocEffect — pop a free effect slot
// In:  none
// Out: a1 = SST address of allocated slot (d0=0/Z set on success)
//      d0=1/Z clear if pool exhausted
// Clobbers: d0
// -----------------------------------------------
pub proc AllocEffect () clobbers(d0) out(a1) {
        cmpi.w  #extern("Effect_Free_Stack"), (Effect_Free_SP).w
        beq     .full
        movea.w (Effect_Free_SP).w, a1
        subq.w  #2, (Effect_Free_SP).w
        movea.w -(a1), a1
        // No slot_tag write (unlike AllocDynamic): slot_tag is the entity-window
        // quadrant index, read ONLY by the entity-window Y-despawn band. Effects
        // are never entity-window-managed (object code allocs them and they
        // self-delete), so their slot_tag is never read — nothing to initialize.
        moveq   #0, d0
        rts
    .full:
        moveq   #1, d0
        rts
}

// -----------------------------------------------
// DeleteObject — push slot back to appropriate free stack, zero SST
// Pool detection (RAM order: Player | Dynamic | System | Effect):
//   addr < Dynamic_Slots           → player slot (no stack push)
//   addr >= Dynamic_Slots AND
//          addr < System_Slots     → dynamic pool
//   addr >= System_Slots AND
//          addr < Effect_Slots     → system slot (no stack push)
//   addr >= Effect_Slots AND
//          addr < Effect_Slots+
//                 SST_len*NUM_EFFECTS → effect pool
// In:  a0 = SST address of object to delete
// Out: none
// Clobbers: d0, a1
// -----------------------------------------------
pub proc DeleteObject () clobbers(d0, a1) {
        // Check Effect pool first (highest address range)
        cmpa.w  #extern("Effect_Slots"), a0
        bhs     .check_effect

        // Below Effect_Slots — check System_Slots
        cmpa.w  #extern("System_Slots"), a0
        bhs     .clear_slot             // system slot: just clear, no push

        // Below System_Slots — check Dynamic_Slots
        cmpa.w  #extern("Dynamic_Slots"), a0
        bhs     .dynamic_pool

        // Below Dynamic_Slots — player slot: just clear, no push
        jbra    .clear_slot

    .check_effect:
        // Past Effect_Slots — confirm it's within the effect range
        cmpa.w  #extern("Effect_Slots")+sizeof(Sst)*NUM_EFFECTS, a0
        bhs     .clear_slot             // out of effect range (shouldn't happen)
        // Fall through: it's a valid effect slot

    .effect_pool:
        movea.w (Effect_Free_SP).w, a1
        move.w  a0, (a1)+
        move.w  a1, (Effect_Free_SP).w
        jbra    .clear_slot

    .dynamic_pool:
        movea.w (Dynamic_Free_SP).w, a1
        move.w  a0, (a1)+
        move.w  a1, (Dynamic_Free_SP).w
        st      Dynamic_Live_Dirty      // dynamic deletion -> compact live list at frame end
                                        // (the entry stays put mid-walk; the slot
                                        // clear below is what actually kills it)

    .clear_slot:
        // Zero all sizeof(Sst) bytes of the SST entry, one long at a time.
        moveq   #0, d0
        clear_longs(sizeof(Sst) / 4)
        lea     -sizeof(Sst)(a0), a0 // restore a0 to slot start
        rts
}

// -----------------------------------------------
// RunObjects — dispatch all active object slots
// Per-pool loops: players/system/effects always execute,
// dynamic pool is culled by distance from camera.
// Objects that want to die call DeleteObject directly.
//
// Convention: object routines receive a0 = self SST pointer.
// Object routines MUST preserve a0 and d7.
// In:  none
// Out: none
// Clobbers: d0-d6, a0-a6 (object code may clobber freely except a0/d7)
// -----------------------------------------------
pub proc RunObjects () clobbers(d0-d6/a0-a6) {
        moveq   #0, d0
        move.w  d0, Spawn_Count

        tst.b   Game_Paused
        bne     RunObjects_Frozen

        // --- Player slots (always execute) ---
        lea     Player_1, a0
        move.w  #NUM_PLAYERS-1, d7
        jbsr    .run_always

        // --- Dynamic slots (culled by distance) ---
        lea     Dynamic_Slots, a0
        move.w  #NUM_DYNAMIC-1, d7
        jbsr    .run_culled

        // --- System slots (always execute) ---
        lea     System_Slots, a0
        move.w  #NUM_SYSTEM-1, d7
        jbsr    .run_always

        // --- Effect slots (always execute) ---
        lea     Effect_Slots, a0
        move.w  #NUM_EFFECTS-1, d7
        jbsr    .run_always
        rts

    // Dispatch loop — no culling
    .run_always:
    .always_loop:
        moveq   #OBJ_CODE_BANK, d0
        swap    d0
        move.w  (a0), d0
        beq     .always_next
        movea.l d0, a1
        jsr     (a1)
        // debug builds: catch object routines violating the a0/d7
        // preservation contract at the source.
        if DEBUG == 1 { jbsr Debug_AssertObjLoop }
    .always_next:
        lea     sizeof(Sst)(a0), a0
        dbf     d7, .always_loop
        rts

    // Dispatch loop — skip objects far from camera
    .run_culled:
    .culled_loop:
        tst.w   (a0)
        beq     .culled_next

        // X distance check: abs(obj_x - camera_x)
        move.w  Sst.x_pos(a0), d0
        sub.w   Camera_X, d0
        bpl     .culled_xpos
        neg.w   d0
    .culled_xpos:
        cmpi.w  #CULL_DISTANCE_X, d0
        bhi     .culled_next

        // Y distance check: abs(obj_y - camera_y)
        move.w  Sst.y_pos(a0), d0
        sub.w   Camera_Y, d0
        bpl     .culled_ypos
        neg.w   d0
    .culled_ypos:
        cmpi.w  #CULL_DISTANCE_Y, d0
        bhi     .culled_next

        // Within range — dispatch
        moveq   #OBJ_CODE_BANK, d0
        swap    d0
        move.w  (a0), d0
        movea.l d0, a1
        jsr     (a1)
        // debug builds: catch a0/d7 preservation-contract violations at the source
        if DEBUG == 1 { jbsr Debug_AssertObjLoop }
    .culled_next:
        lea     sizeof(Sst)(a0), a0
        dbf     d7, .culled_loop
        rts
}

// -----------------------------------------------
// Debug_AssertObjLoop — verify the RunObjects loop contract after dispatch
// Object routines must return with a0 = own SST and d7 = loop counter
// intact. A violation here means object routines clobbered a0/d7,
// causing free-stack words to dispatch as code offsets.
// In:  a0 = slot just dispatched, d7 = loop counter
// Out: none (raises debugger error on violation)
// Clobbers: none
//
// DEBUG-shape only (AS twin's `ifdef __DEBUG__`): the whole proc emits ZERO
// bytes in the plain shape — the body sits inside `if DEBUG == 1 {}` so the
// region length is shape-dependent (rings.emp precedent).
// -----------------------------------------------
pub proc Debug_AssertObjLoop () clobbers() {
    if DEBUG == 1 {
        // wrapper elides the whole proc body in the plain shape (asserts
        // self-gate; the rts does not — core_port's debug_shape_length_diverges
        // pins plain = zero bytes)
        // a0 must point into Object_RAM (own SST), d7 into the loop counter
        // range — a violation means an object routine clobbered the contract.
        assert.l a0, hs, #Object_RAM
        assert.l a0, lo, #Object_RAM_End
        assert.w d7, lo, #NUM_DYNAMIC
        rts
    }
}

// -----------------------------------------------
// RunObjects_Frozen — render-only pass (player death, pause)
// Calls Draw_Sprite for each occupied slot, skips object logic
// In:  none
// Out: none
// Clobbers: d0-d6, a0-a6
// -----------------------------------------------
pub proc RunObjects_Frozen () clobbers(d0-d6/a0-a6) {
        lea     Object_RAM, a0
        move.w  #NUM_TOTAL_SLOTS-1, d7
    .loop:
        tst.w   (a0)
        beq     .next
        jbsr    Draw_Sprite
    .next:
        lea     sizeof(Sst)(a0), a0
        dbf     d7, .loop
        rts
}

// -----------------------------------------------
// ObjectMove — apply velocity to position (X and Y)
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc ObjectMove () clobbers(d0) {
        move.w  Sst.x_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.x_pos(a0)
        move.w  Sst.y_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.y_pos(a0)
        rts
}

// -----------------------------------------------
// ObjectMoveX — apply X velocity only
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc ObjectMoveX () clobbers(d0) {
        move.w  Sst.x_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.x_pos(a0)
        rts
}

// -----------------------------------------------
// ObjectMoveY — apply Y velocity only (gravity, falling)
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0
// -----------------------------------------------
pub proc ObjectMoveY () clobbers(d0) {
        move.w  Sst.y_vel(a0), d0
        ext.l   d0
        asl.l   #8, d0
        add.l   d0, Sst.y_pos(a0)
        rts
}
