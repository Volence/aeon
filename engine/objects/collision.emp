// TouchResponse — player-vs-object AABB collision detection and dispatch

module engine.objects.collision in collision

use engine.objects.sst.{Sst, interact_off}
use engine.objects.aabb.{aabb_axis_test}
use engine.coords.{abs_w}
use engine.constants.{NUM_PLAYERS, NUM_DYNAMIC, NUM_SYSTEM, NUM_EFFECTS,
                      COLLISION_TOUCH, ST_ON_OBJECT, ST_IN_AIR}

// Contract type (contract-grammar v2 §4) — the Touch_HandlerTable dispatch
// bound. The caller saves d6-d7/a2-a4 around the `jsr (a0, d4.w)`, so a handler
// MAY clobber those and must preserve everything else (the 11 Touch_* stubs
// clobber nothing). Bound = the caller-saved set.
type TouchHandler = proc (a0: *Sst) clobbers(d6-d7/a2-a4)

// -----------------------------------------------
// touch_test_target — one candidate object vs. the current player (a2)
// The per-target body shared by TouchResponse's two segments (the dynamic
// live-list walk and the fixed system/effect sweep) — the ONLY difference
// between them is how a3 (the target SST) was obtained, so the gate + AABB +
// dispatch body is single-sourced here (the emit_piece_loop skeleton-with-holes
// pattern). Splice it; each instantiation branches its no-overlap / no-collide
// exits to `skip` (the caller's per-segment .next label). Hygienic locals
// (.overlap_done, the aabb .aov) are per-instantiation.
//
// In:  a2 = player SST, a3 = candidate SST, d4/d5 = cached player X/Y
// Uses/clobbers d0-d4, a0-a1; on overlap dispatches the handler (see the
// handler contract on TouchResponse). Falls through to `skip` on no contact.
// A comptime fn spliced inline into both collision segments.
comptime fn touch_test_target(skip: Label) -> Code {
    return asm {
        tst.w   Sst.code_addr(a3)
        beq     {skip}
        tst.b   Sst.collision_resp(a3)
        beq     {skip}

        // --- AABB overlap via the shared template (§4.9) ---
        moveq   #0, d0
        move.b  Sst.width_pixels(a2), d0
        moveq   #0, d1
        move.b  Sst.width_pixels(a3), d1

        {aabb_axis_test(d4, a3, offsetof(Sst, x_pos), d0, d1, d0, d1, d2, skip)}

        movea.w d0, a0                  // stash combined_w
        movea.w d1, a1                  // stash signed delta_x

        moveq   #0, d2
        move.b  Sst.height_pixels(a2), d2
        moveq   #0, d3
        move.b  Sst.height_pixels(a3), d3

        {aabb_axis_test(d5, a3, offsetof(Sst, y_pos), d2, d3, d2, d3, d0, skip)}

        move.w  a0, d0                  // d0 = combined_w
        move.w  a1, d1                  // d1 = signed delta_x

        // Dispatch via collision_resp jump table
        moveq   #0, d4
        move.b  Sst.collision_resp(a3), d4
        cmpi.b  #COLLISION_TOUCH, d4
        bhi     {skip}                  // invalid type: no handler ran, so the
                                        // d4/d5 position cache is still fresh —
                                        // skip the reload

        // a4 (the dynamic cursor) joins the saved set: the handler may clobber
        // it, and it must survive to the next live-list step. The save/reload
        // only fires on an actual overlap.
        movem.l d6-d7/a2-a4, -(sp)

        // Dispatch via a0-based indexing (a0 is free — its combined_w stash was
        // consumed into d0 above). PC-relative `table(pc,d4.w)` can't be used:
        // its 8-bit displacement can't reach the table from BOTH spliced sites.
        lea     Touch_HandlerTable, a0
        add.w   d4, d4
        add.w   d4, d4                  // type * 4 (bra.w entry size)
        jsr     (a0, d4.w) as TouchHandler

        movem.l (sp)+, d6-d7/a2-a4

    .overlap_done:
        // Reload cached player position (handler may have moved player)
        move.w  Sst.x_pos(a2), d4
        move.w  Sst.y_pos(a2), d5
    }
}

// -----------------------------------------------
// TouchResponse — check player(s) against all collidable objects
// Iterates dynamic + system + effect slots. For each with
// collision_resp != 0, performs AABB overlap test against each
// player. On overlap, dispatches to per-type handler via jump table.
//
// Handler register convention (d0-d3 set before dispatch):
//   d0.w = combined_w (player.width + target.width)
//   d1.w = signed delta_x (player.x - target.x)
//   d2.w = combined_h (player.height + target.height)
//   d3.w = signed delta_y (player.y - target.y)
//   a2   = player SST
//   a3   = target SST
//
// Handler contract (effective clobber license = the dispatch movem): a handler
// may clobber d0-d7 / a0-a4; TouchResponse reloads d4/d5 (player X/Y) and the
// movem restores d6-d7 / a2-a4 — a5-a6 MUST survive. (Handlers are stubs today;
// this states the rule for the first real one.)
//
// In:  none (reads Object_RAM directly)
// Out: none
// Clobbers: d0-d7, a0-a3
// -----------------------------------------------
pub proc TouchResponse () clobbers(d0-d7/a0-a4) {
        // a4 is the dynamic live-list cursor; saved/restored at the proc
        // boundary so the clobbers(a0-a3) caller contract is unchanged.
        move.l  a4, -(sp)
        lea     Player_1, a2
        let     a2: *Sst                // C2: a2 self-loaded → typed here down
        move.w  #NUM_PLAYERS-1, d7

    .player_loop:
        tst.w   code_addr(a2)
        beq     .next_player

        // On-object lifecycle: bit AND interact pointer cleared HERE (pass
        // start), re-set by Touch_Solid's top-contact within this same pass
        // if the player is still standing on a solid — so a walk-off drops
        // both, and they are LIVE for the player's entire next tick (state
        // dispatch AND the animation classifier's ledge probe both read
        // last pass's truth). The old mid-frame clear in player_common sat
        // between the dispatch and the classifier, blinding the balance
        // check. SST_interact carries WHICH solid claimed us — the probe
        // reads it directly (no stale-bit slot scan).
        // No P1-hardcode bug to hunt here: status is a per-SST byte written a2-relative, so this engine has no ST_P1_*/ST_P2_* globals to get wrong.
        bclr    #ST_ON_OBJECT, status(a2)
        clr.w   interact_off()(a2)

        move.w  x_pos(a2), d4       // cache player X integer
        move.w  y_pos(a2), d5       // cache player Y integer

        // --- Dynamic pool: spawn-order live list (empty slots cost zero) ---
        // Walk-flag assert rail: a4 holds a live cursor and a dispatched touch handler
        // may AllocDynamic mid-walk — flag the walk so a resulting
        // CompactDynamicLive trips the assert instead of moving entries silently.
        if DEBUG == 1 { st Dynamic_Live_Walking }
        lea     Dynamic_Live, a4
        move.w  Dynamic_Live_Count, d6
        beq     .dyn_done
        subq.w  #1, d6
    .dyn_loop:
        move.w  (a4)+, d0               // null-guard a zeroed entry — no deref
        beq     .dyn_next
        movea.w d0, a3
        touch_test_target(.dyn_next)
    .dyn_next:
        dbf     d6, .dyn_loop
    .dyn_done:
        if DEBUG == 1 { sf Dynamic_Live_Walking }

        // --- System + Effect pools: fixed sweep (24 contiguous slots) ---
        lea     System_Slots, a3
        move.w  #NUM_SYSTEM+NUM_EFFECTS-1, d6
    .fixed_loop:
        touch_test_target(.fixed_next)
    .fixed_next:
        lea     sizeof(Sst)(a3), a3
        dbf     d6, .fixed_loop

    .next_player:
        lea     sizeof(Sst)(a2), a2
        dbf     d7, .player_loop
        movea.l (sp)+, a4
        rts
}

// -----------------------------------------------
// Handler jump table — bra.w entries, 4 bytes each
// Type 0 (COLLISION_NONE) through 12 (COLLISION_TOUCH)
// bra.w is LOAD-BEARING: the dispatcher indexes type*4, so the entry
// stride is ABI — these must never relax (no jbra here)
//
// On entry: d0 = combined_w, d1 = signed delta_x,
//           d2 = combined_h, d3 = signed delta_y,
//           a2 = player SST, a3 = target SST
// -----------------------------------------------
proc Touch_HandlerTable () {
        bra.w   Touch_None              // 0 — COLLISION_NONE
        bra.w   Touch_Enemy             // 1 — COLLISION_ENEMY
        bra.w   Touch_Boss              // 2 — COLLISION_BOSS
        bra.w   Touch_Hurt              // 3 — COLLISION_HURT
        bra.w   Touch_Monitor           // 4 — COLLISION_MONITOR
        bra.w   Touch_Ring              // 5 — COLLISION_RING
        bra.w   Touch_Bubble            // 6 — COLLISION_BUBBLE
        bra.w   Touch_Projectile        // 7 — COLLISION_PROJECTILE
        bra.w   Touch_Solid             // 8 — COLLISION_SOLID
        bra.w   Touch_SolidBreak        // 9 — COLLISION_SOLID_BREAK
        bra.w   Touch_Spring            // 10 — COLLISION_SPRING
        bra.w   Touch_SolidHurt         // 11 — COLLISION_SOLID_HURT
        bra.w   Touch_Touch             // 12 — COLLISION_TOUCH
}

// -----------------------------------------------
// Stub handlers — return immediately until implemented
// (empty falls_into chain: every label aliases the single rts, and a stub
// gaining a body without a terminator fails the fallthrough lint)
// -----------------------------------------------
proc Touch_None () clobbers() falls_into Touch_Enemy {}
proc Touch_Enemy () clobbers() falls_into Touch_Boss {}
proc Touch_Boss () clobbers() falls_into Touch_Monitor {}
proc Touch_Monitor () clobbers() falls_into Touch_Ring {}
proc Touch_Ring () clobbers() falls_into Touch_Bubble {}
proc Touch_Bubble () clobbers() falls_into Touch_Projectile {}
proc Touch_Projectile () clobbers() falls_into Touch_SolidBreak {}
proc Touch_SolidBreak () clobbers() falls_into Touch_SolidHurt {}
proc Touch_SolidHurt () clobbers() falls_into Touch_Touch {}
proc Touch_Touch () clobbers() {
        rts
}

// -----------------------------------------------
// Touch_Hurt — damage the player (stub)
// In:  a2 = player SST, a3 = target SST, d0-d3 = overlap data
// Out: none
// Clobbers: none
// -----------------------------------------------
proc Touch_Hurt (d0: u16, d1: i16, d2: u16, d3: i16, a2: *Sst, a3: *Sst) clobbers() {
        rts
}

// -----------------------------------------------
// solid_face_response — the contact-face decision and push-out that every solid
// share, whatever its top face then means.
//
// Contains: the minimum-penetration-axis choice, both horizontal pushes, and the
// stop-a-rising-player push-down-from-below. It does NOT contain what a TOP
// contact means, because that is the only thing the solid family disagrees
// about — a block is landed on, a spring launches — so the caller supplies that
// as `{top}`, which this template branches to and never returns from. Every
// other path `rts` inside the template.
//
// Splicing it beats giving Touch_Spring its own copy of the penetration
// arithmetic, and beats the reference: S3K routes each spring orientation
// through SolidObjectFull2_1P and then RE-DERIVES the contact face per
// orientation afterwards (Obj_Spring_Up's standing-bit test at
// sonic3k.asm:47668 vs Obj_Spring_Horizontal's status/x_pos compare at
// :47786-47794), which is the duplication this exists not to reproduce.
//
// In:  a2 = player SST, a3 = target SST
//      d0.w = combined_w, d1.w = signed delta_x
//      d2.w = combined_h, d3.w = signed delta_y
// At {top}: d2.w = pen_y and d3.w = |delta_y|, a2/a3 untouched — `add.w d3, d2`
//      recovers combined_half_h, which is what a top-edge snap needs. Both
//      consumers do exactly that as their first instruction.
// Clobbers: d0-d5
//
// Template labels are hygienic, so each instantiation gets its own .sfr_*.
// -----------------------------------------------
comptime fn solid_face_response(top: Label) -> Code {
    return asm {
        lsr.w   #1, d0                  // d0 = combined_half_w
        lsr.w   #1, d2                  // d2 = combined_half_h

        // pen_x = combined_half_w - abs(delta_x)
        move.w  d1, d4                  // d4 = signed delta_x (for direction)
        abs_w(d1)
        sub.w   d1, d0                  // d0 = pen_x
        ble     .sfr_done

        // pen_y = combined_half_h - abs(delta_y)
        move.w  d3, d5                  // d5 = signed delta_y (for direction)
        abs_w(d3)
        sub.w   d3, d2                  // d2 = pen_y
        ble     .sfr_done

        // Minimum penetration axis: pen_x vs pen_y
        cmp.w   d2, d0
        blo     .sfr_side               // pen_x < pen_y → side contact

        // --- Vertical contact (pen_y <= pen_x) ---
        tst.w   d5
        bmi     .sfr_above              // player above target

        // Player below target — snap below, zero y_vel if rising
        // +1/-1 offsets keep 1px overlap so next frame's AABB check still passes
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        add.w   d2, d1                  // target.y + combined_half_h
        subq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)
        tst.w   y_vel(a2)
        bpl     .sfr_done
        clr.w   y_vel(a2)
        rts

    .sfr_above:
        // Only a FALLING player makes top contact. For a block that is "don't
        // snap a player rising through it"; for a spring it is additionally the
        // whole re-fire interlock, which is why the test lives in the shared
        // half rather than in either consumer.
        tst.w   y_vel(a2)
        bmi     .sfr_done               // still rising — no top contact
        jbra    {top}

    .sfr_side:
        // Push player horizontally — subtract 1 from pen to maintain contact
        subq.w  #1, d0
        tst.w   d4
        bmi     .sfr_push_left

        add.w   d0, x_pos(a2)           // push right
        clr.w   x_vel(a2)
        rts

    .sfr_push_left:
        sub.w   d0, x_pos(a2)           // push left
        clr.w   x_vel(a2)

    .sfr_done:
        rts
    }
}

// -----------------------------------------------
// Touch_Solid — AABB solid object collision response
// Determines contact face via minimum-penetration-axis,
// then pushes the player out and zeroes the relevant velocity.
//
// In:  a2 = player SST, a3 = target SST
//      d0.w = combined_w, d1.w = signed delta_x
//      d2.w = combined_h, d3.w = signed delta_y
// Out: none
// Clobbers: d0-d5
// -----------------------------------------------
proc Touch_Solid (d0: u16, d1: i16, d2: u16, d3: i16, a2: *Sst, a3: *Sst) clobbers(d0-d5) {
        solid_face_response(.solid_top)

    .solid_top:
        // Player above target — snap above, zero y_vel, set grounded
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        sub.w   d2, d1                  // target.y - combined_half_h
        addq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)
        clr.w   y_vel(a2)
        bclr    #ST_IN_AIR, status(a2)
        bset    #ST_ON_OBJECT, status(a2)
        // Claim: record WHICH solid this player stands on — the ledge
        // probe (player_sensors) reads it directly. Fresh every pass
        // (cleared at the player-loop top), so it can never go stale and
        // never needs per-player bit selection.
        move.w  a3, interact_off()(a2)
        rts
}

// -----------------------------------------------
// Touch_Spring — a solid that LAUNCHES instead of being landed on.
//
// Side-solid and bottom-solid in exactly the sense COLLISION_SOLID is: the body
// above this line is literally Touch_Solid's, spliced from the same template, so
// walking into a spring from either side pushes out and kills x_vel, and jumping
// into its underside stops a rising player. Only the TOP face differs.
//
// THE SPRING'S OWN y_vel IS ITS LAUNCH STRENGTH. A spring never moves, so the
// field is free, and spending it this way means the strength rides in the
// 26-byte ObjDef template: a second spring at a different strength is a second
// objdef and NO new code — no init routine, no subtype decode, no custom SST
// byte. S3K instead keeps it in $30(a0) and decodes subtype bit 1 into it at
// spawn (sonic3k.asm:47641-47643, table at :47654-47656), which is a spawn-time
// branch, a data field and a per-orientation entry point to say one number.
//
// The player's STATE is not the engine's business — the engine has no player
// state machine — so the transition leaves through Game.spring_launched with
// a2 = player, a3 = spring, and the game decides what airborne means for it.
// A game that places a COLLISION_SPRING object MUST bind that hook: unbound, the
// launch would set a velocity on a player whose own grounded state re-attaches
// him on the next tick, i.e. a spring that visibly does nothing.
//
// NO COOLDOWN FIELD, AND NONE IS MISSING. The re-fire interlock is the falling
// test inside the shared template: a launched player's y_vel is large and
// negative for far longer than it takes to clear the box, so `bmi` refuses every
// contact until he is on his way down again. S3K's vertical spring likewise
// carries no timer (Obj_Spring_Up, sonic3k.asm:47659-47684, and sub_22F98,
// :47717-47770, hold no counter between them) — its interlock is the standing
// bit rather than the sign of y_vel, but the shape of the answer is the same.
//
// In:  a2 = player SST, a3 = target SST
//      d0.w = combined_w, d1.w = signed delta_x
//      d2.w = combined_h, d3.w = signed delta_y
// Out: none
// Clobbers: d0-d5 (the template's) + the hook's declared d0-d2/a0-a2
// -----------------------------------------------
proc Touch_Spring (d0: u16, d1: i16, d2: u16, d3: i16, a2: *Sst, a3: *Sst) clobbers(d0-d5/a0-a2) {
        solid_face_response(.spring_top)

    .spring_top:
        // Seat the player on the spring's top edge exactly as a solid would —
        // same +1 contact bias — and only THEN write the impulse. The order
        // matters: the hook may hand the player to an enter hook that shifts
        // y_pos (the uncurl), and it must shift from the seated position.
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        sub.w   d2, d1                  // target.y - combined_half_h
        addq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)

        move.w  y_vel(a3), y_vel(a2)    // THE LAUNCH — see the header
        invoke  Game.spring_launched
        rts
}
