// TouchResponse — player-vs-object AABB collision detection and dispatch

module engine.objects.collision in collision

use engine.objects.sst.{Sst, interact_off}
use engine.objects.aabb.{aabb_axis_test}
use engine.coords.{abs_w}
use engine.constants.{NUM_PLAYERS, NUM_DYNAMIC, NUM_SYSTEM, NUM_EFFECTS,
                      COLLISION_TOUCH, ST_ON_OBJECT, ST_IN_AIR}

// Contract type (contract-grammar v2 §4) — the Touch_HandlerTable dispatch
// bound. The caller saves d6-d7/a2-a4 around the `jsr (a0, d4.w)`, so a handler
// MAY clobber those and must preserve everything else (the 11 Touch_* stubs
// clobber nothing). Bound = the caller-saved set.
type TouchHandler = proc (a0: *Sst) clobbers(d6-d7/a2-a4)

// -----------------------------------------------
// touch_test_target — one candidate object vs. the current player (a2)
// The per-target body shared by TouchResponse's two segments (the dynamic
// live-list walk and the fixed system/effect sweep) — the ONLY difference
// between them is how a3 (the target SST) was obtained, so the gate + AABB +
// dispatch body is single-sourced here (the emit_piece_loop skeleton-with-holes
// pattern). Splice it; each instantiation branches its no-overlap / no-collide
// exits to `skip` (the caller's per-segment .next label). Hygienic locals
// (.overlap_done, the aabb .aov) are per-instantiation.
//
// In:  a2 = player SST, a3 = candidate SST, d4/d5 = cached player X/Y
// Uses/clobbers d0-d4, a0-a1; on overlap dispatches the handler (see the
// handler contract on TouchResponse). Falls through to `skip` on no contact.
// A comptime fn spliced inline into both collision segments.
comptime fn touch_test_target(skip: Label) -> Code {
    return asm {
        tst.w   Sst.code_addr(a3)
        beq     {skip}
        tst.b   Sst.collision_resp(a3)
        beq     {skip}

        // --- AABB overlap via the shared template (§4.9) ---
        moveq   #0, d0
        move.b  Sst.width_pixels(a2), d0
        moveq   #0, d1
        move.b  Sst.width_pixels(a3), d1

        {aabb_axis_test(d4, a3, offsetof(Sst, x_pos), d0, d1, d0, d1, d2, skip)}

        movea.w d0, a0                  // stash combined_w
        movea.w d1, a1                  // stash signed delta_x

        moveq   #0, d2
        move.b  Sst.height_pixels(a2), d2
        moveq   #0, d3
        move.b  Sst.height_pixels(a3), d3

        {aabb_axis_test(d5, a3, offsetof(Sst, y_pos), d2, d3, d2, d3, d0, skip)}

        move.w  a0, d0                  // d0 = combined_w
        move.w  a1, d1                  // d1 = signed delta_x

        // Dispatch via collision_resp jump table
        moveq   #0, d4
        move.b  Sst.collision_resp(a3), d4
        cmpi.b  #COLLISION_TOUCH, d4
        bhi     {skip}                  // invalid type: no handler ran, so the
                                        // d4/d5 position cache is still fresh —
                                        // skip the reload

        // a4 (the dynamic cursor) joins the saved set: the handler may clobber
        // it, and it must survive to the next live-list step. The save/reload
        // only fires on an actual overlap.
        movem.l d6-d7/a2-a4, -(sp)

        // Dispatch via a0-based indexing (a0 is free — its combined_w stash was
        // consumed into d0 above). PC-relative `table(pc,d4.w)` can't be used:
        // its 8-bit displacement can't reach the table from BOTH spliced sites.
        lea     Touch_HandlerTable, a0
        add.w   d4, d4
        add.w   d4, d4                  // type * 4 (bra.w entry size)
        jsr     (a0, d4.w) as TouchHandler

        movem.l (sp)+, d6-d7/a2-a4

    .overlap_done:
        // Reload cached player position (handler may have moved player)
        move.w  Sst.x_pos(a2), d4
        move.w  Sst.y_pos(a2), d5
    }
}

// -----------------------------------------------
// TouchResponse — check player(s) against all collidable objects
// Iterates dynamic + system + effect slots. For each with
// collision_resp != 0, performs AABB overlap test against each
// player. On overlap, dispatches to per-type handler via jump table.
//
// Handler register convention (d0-d3 set before dispatch):
//   d0.w = combined_w (player.width + target.width)
//   d1.w = signed delta_x (player.x - target.x)
//   d2.w = combined_h (player.height + target.height)
//   d3.w = signed delta_y (player.y - target.y)
//   a2   = player SST
//   a3   = target SST
//
// Handler contract (effective clobber license = the dispatch movem): a handler
// may clobber d0-d7 / a0-a4; TouchResponse reloads d4/d5 (player X/Y) and the
// movem restores d6-d7 / a2-a4 — a5-a6 MUST survive. (Handlers are stubs today;
// this states the rule for the first real one.)
//
// In:  none (reads Object_RAM directly)
// Out: none
// Clobbers: d0-d7, a0-a3
// -----------------------------------------------
pub proc TouchResponse () clobbers(d0-d7/a0-a4) {
        // a4 is the dynamic live-list cursor; saved/restored at the proc
        // boundary so the clobbers(a0-a3) caller contract is unchanged.
        move.l  a4, -(sp)
        lea     Player_1, a2
        let     a2: *Sst                // C2: a2 self-loaded → typed here down
        move.w  #NUM_PLAYERS-1, d7

    .player_loop:
        tst.w   code_addr(a2)
        beq     .next_player

        // On-object lifecycle: bit AND interact pointer cleared HERE (pass
        // start), re-set by Touch_Solid's top-contact within this same pass
        // if the player is still standing on a solid — so a walk-off drops
        // both, and they are LIVE for the player's entire next tick (state
        // dispatch AND the animation classifier's ledge probe both read
        // last pass's truth). The old mid-frame clear in player_common sat
        // between the dispatch and the classifier, blinding the balance
        // check. SST_interact carries WHICH solid claimed us — the probe
        // reads it directly (no stale-bit slot scan).
        // No P1-hardcode bug to hunt here: status is a per-SST byte written a2-relative, so this engine has no ST_P1_*/ST_P2_* globals to get wrong.
        bclr    #ST_ON_OBJECT, status(a2)
        clr.w   interact_off()(a2)

        move.w  x_pos(a2), d4       // cache player X integer
        move.w  y_pos(a2), d5       // cache player Y integer

        // --- Dynamic pool: spawn-order live list (empty slots cost zero) ---
        // Walk-flag assert rail: a4 holds a live cursor and a dispatched touch handler
        // may AllocDynamic mid-walk — flag the walk so a resulting
        // CompactDynamicLive trips the assert instead of moving entries silently.
        if DEBUG == 1 { st Dynamic_Live_Walking }
        lea     Dynamic_Live, a4
        move.w  Dynamic_Live_Count, d6
        beq     .dyn_done
        subq.w  #1, d6
    .dyn_loop:
        move.w  (a4)+, d0               // null-guard a zeroed entry — no deref
        beq     .dyn_next
        movea.w d0, a3
        touch_test_target(.dyn_next)
    .dyn_next:
        dbf     d6, .dyn_loop
    .dyn_done:
        if DEBUG == 1 { sf Dynamic_Live_Walking }

        // --- System + Effect pools: fixed sweep (24 contiguous slots) ---
        lea     System_Slots, a3
        move.w  #NUM_SYSTEM+NUM_EFFECTS-1, d6
    .fixed_loop:
        touch_test_target(.fixed_next)
    .fixed_next:
        lea     sizeof(Sst)(a3), a3
        dbf     d6, .fixed_loop

    .next_player:
        lea     sizeof(Sst)(a2), a2
        dbf     d7, .player_loop
        movea.l (sp)+, a4
        rts
}

// -----------------------------------------------
// Handler jump table — bra.w entries, 4 bytes each
// Type 0 (COLLISION_NONE) through 12 (COLLISION_TOUCH)
// bra.w is LOAD-BEARING: the dispatcher indexes type*4, so the entry
// stride is ABI — these must never relax (no jbra here)
//
// On entry: d0 = combined_w, d1 = signed delta_x,
//           d2 = combined_h, d3 = signed delta_y,
//           a2 = player SST, a3 = target SST
// -----------------------------------------------
proc Touch_HandlerTable () {
        bra.w   Touch_None              // 0 — COLLISION_NONE
        bra.w   Touch_Enemy             // 1 — COLLISION_ENEMY
        bra.w   Touch_Boss              // 2 — COLLISION_BOSS
        bra.w   Touch_Hurt              // 3 — COLLISION_HURT
        bra.w   Touch_Monitor           // 4 — COLLISION_MONITOR
        bra.w   Touch_Ring              // 5 — COLLISION_RING
        bra.w   Touch_Bubble            // 6 — COLLISION_BUBBLE
        bra.w   Touch_Projectile        // 7 — COLLISION_PROJECTILE
        bra.w   Touch_Solid             // 8 — COLLISION_SOLID
        bra.w   Touch_SolidBreak        // 9 — COLLISION_SOLID_BREAK
        bra.w   Touch_Spring            // 10 — COLLISION_SPRING
        bra.w   Touch_SolidHurt         // 11 — COLLISION_SOLID_HURT
        bra.w   Touch_Touch             // 12 — COLLISION_TOUCH
}

// -----------------------------------------------
// Stub handlers — return immediately until implemented
// (empty falls_into chain: every label aliases the single rts, and a stub
// gaining a body without a terminator fails the fallthrough lint)
// -----------------------------------------------
proc Touch_None () clobbers() falls_into Touch_Enemy {}
proc Touch_Enemy () clobbers() falls_into Touch_Boss {}
proc Touch_Boss () clobbers() falls_into Touch_Monitor {}
proc Touch_Monitor () clobbers() falls_into Touch_Ring {}
proc Touch_Ring () clobbers() falls_into Touch_Bubble {}
proc Touch_Bubble () clobbers() falls_into Touch_Projectile {}
proc Touch_Projectile () clobbers() falls_into Touch_SolidBreak {}
proc Touch_SolidBreak () clobbers() falls_into Touch_SolidHurt {}
proc Touch_SolidHurt () clobbers() falls_into Touch_Touch {}
proc Touch_Touch () clobbers() {
        rts
}

// -----------------------------------------------
// Touch_Hurt — damage the player (stub)
// In:  a2 = player SST, a3 = target SST, d0-d3 = overlap data
// Out: none
// Clobbers: none
// -----------------------------------------------
proc Touch_Hurt (d0: u16, d1: i16, d2: u16, d3: i16, a2: *Sst, a3: *Sst) clobbers() {
        rts
}

// -----------------------------------------------
// THE SOLID FACE TEMPLATE, IN FOUR PIECES (split 2026-09-06, DEFERRED_WORK SP-5)
//
// It used to be ONE comptime fn, `solid_face_response(top)`, holding the
// geometry and all three face responses, with only the TOP face parameterised.
// That was exactly right while the only disagreement in the solid family was
// what a top contact means (a block is landed on, a spring launches upward).
// It stopped being right the moment a spring could point sideways or down: a
// side spring's SIDE face and a down spring's UNDERSIDE face are the two arms
// the old template kept to itself, so both directions were unreachable by
// construction and not by omission.
//
// So the geometry is now one fn and each of the three default face bodies is
// its own, and a consumer splices the geometry with THREE `Label` arguments and
// then splices back whichever default bodies it does not override. Every
// default body is self-contained and `rts`-terminated, so no fragment ever
// branches into another fragment's labels.
//
// WHY THREE LABELS AND NOT THREE `Code` PARAMETERS. `Code`-typed comptime
// params exist and would read better — the consumer would hand the template its
// own face body and the template would splice it in place. They cannot be used
// here: a branch from a spliced `Code` fragment to a label in the ENCLOSING
// routine is a hard cross-fragment error in sigil, and every face body needs to
// reach either the shared `rts` or a sibling arm. A `Label` argument branched to
// with `jbra {top}` is the proven mechanism (it is what the original template
// used for its one parameter), so all three parameters use it.
//
// COST, measured rather than estimated — see the commit message. The geometry
// is byte-neutral (the below arm's fallthrough `bmi .sfr_above` became a `bpl
// {below}`, one branch either way); the whole cost is that the below arm can no
// longer share the geometry's `rts`.
//
// In:  a2 = player SST, a3 = target SST
//      d0.w = combined_w, d1.w = signed delta_x
//      d2.w = combined_h, d3.w = signed delta_y
// Out, at all three labels: d0.w = pen_x, d2.w = pen_y, d3.w = |delta_y|,
//      d4.w = signed delta_x, d5.w = signed delta_y, a2/a3 untouched.
//      `add.w d3, d2` recovers combined_half_h, which is what a vertical snap
//      needs; `d4`'s sign is which side of the target the player is on.
// Clobbers: d0-d5, plus whatever the spliced bodies' hooks declare.
//
// Template labels are hygienic, so each instantiation gets its own.
// -----------------------------------------------
comptime fn solid_face_geometry(top: Label, side: Label, below: Label) -> Code {
    return asm {
        lsr.w   #1, d0                  // d0 = combined_half_w
        lsr.w   #1, d2                  // d2 = combined_half_h

        // pen_x = combined_half_w - abs(delta_x)
        move.w  d1, d4                  // d4 = signed delta_x (for direction)
        abs_w(d1)
        sub.w   d1, d0                  // d0 = pen_x
        ble     .sfg_done

        // pen_y = combined_half_h - abs(delta_y)
        move.w  d3, d5                  // d5 = signed delta_y (for direction)
        abs_w(d3)
        sub.w   d3, d2                  // d2 = pen_y
        ble     .sfg_done

        // Minimum penetration axis: pen_x vs pen_y
        cmp.w   d2, d0
        blo     {side}                  // pen_x < pen_y → side contact

        // --- Vertical contact (pen_y <= pen_x) ---
        tst.w   d5
        bpl     {below}                 // player BELOW target (delta_y >= 0)

        // Only a FALLING player makes top contact. For a block that is "don't
        // snap a player rising through it"; for an upward spring it is
        // additionally the whole re-fire interlock, which is why the test lives
        // in the shared geometry rather than in either consumer.
        tst.w   y_vel(a2)
        bmi     .sfg_done               // still rising — no top contact
        jbra    {top}

    .sfg_done:
        rts
    }
}

// -----------------------------------------------
// solid_top_land — the DEFAULT top face: land on it.
//
// Snap the player to the target's top edge, zero his fall, mark him grounded and
// record WHICH solid he stands on. Was Touch_Solid's own body until SP-5; it is
// a shared fn now because a spring that points sideways or down must still be
// landable on top, and "landable on top" must be the same code in both places
// or the two will drift.
//
// In:  the geometry's outputs. Out: never returns to the caller (rts).
// -----------------------------------------------
comptime fn solid_top_land() -> Code {
    return asm {
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        sub.w   d2, d1                  // target.y - combined_half_h
        addq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)
        clr.w   y_vel(a2)
        bclr    #ST_IN_AIR, status(a2)
        bset    #ST_ON_OBJECT, status(a2)
        // Claim: record WHICH solid this player stands on — the ledge
        // probe (player_sensors) reads it directly. Fresh every pass
        // (cleared at the player-loop top), so it can never go stale and
        // never needs per-player bit selection.
        move.w  a3, interact_off()(a2)
        rts
    }
}

// -----------------------------------------------
// solid_below_stop — the DEFAULT underside face: stop a rising player.
//
// Snap him below the target and zero his y_vel, but only if he was rising: a
// falling player under a solid is leaving it, and zeroing his fall would hang
// him in the air. The +1/-1 offsets keep 1px of overlap so the next frame's
// AABB check still fires.
//
// In:  the geometry's outputs. Out: never returns to the caller (rts).
// -----------------------------------------------
comptime fn solid_below_stop() -> Code {
    return asm {
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        add.w   d2, d1                  // target.y + combined_half_h
        subq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)
        tst.w   y_vel(a2)
        bpl     .sbs_done
        clr.w   y_vel(a2)
    .sbs_done:
        rts
    }
}

// -----------------------------------------------
// solid_side_push — the DEFAULT side face: push out, and kill the speed.
//
// THE DIRECTION GATE here is LOAD-BEARING, not a refinement, and the failure it
// prevents is total. The push deliberately leaves 1px of overlap so the next
// frame's AABB still fires, which means a player standing beside a solid
// re-enters this arm EVERY frame for as long as he stands there. An
// UNCONDITIONAL speed kill would therefore zero his speed every frame while he
// is merely adjacent — he could never walk away from any solid in the game, and
// the obvious test (walk into it, let go, measure where he rests) would not see
// it, because a player who is already stopped rests in exactly the right place.
// So the kill fires only when he is travelling INTO the face, which is S3K's own
// structure (sonic3k.asm:1E042-1E056 tests the sign of x_vel against the push
// direction before zeroing anything) and what the witness's escape leg checks.
//
// The push itself is UNCONDITIONAL (S3K's is too, sonic3k.asm:1E06E): position
// is corrected whichever way the player is travelling.
//
// In:  the geometry's outputs. Out: never returns to the caller (rts).
// Clobbers: additionally whatever Game.solid_pushed declares (sonic4's binding
//      declares clobbers() — it is one `clr.w`).
// -----------------------------------------------
comptime fn solid_side_push() -> Code {
    return asm {
        subq.w  #1, d0                  // maintain contact
        tst.w   d4
        bmi     .ssp_push_left

        add.w   d0, x_pos(a2)           // push right (player is to the RIGHT)
        // Moving INTO the face is x_vel < 0 here. Anything else — moving away,
        // or a dead stop — returns without touching either velocity. See "THE
        // DIRECTION GATE" in the header; this is not an optimisation.
        tst.w   x_vel(a2)
        bmi     .ssp_stop
        rts

    .ssp_push_left:
        sub.w   d0, x_pos(a2)           // push left (player is to the LEFT)
        tst.w   x_vel(a2)               // into the face is x_vel > 0 here
        ble     .ssp_done               // moving away, or a dead stop

    .ssp_stop:
        // KILL THE PLAYER'S SPEED, BOTH HALVES OF IT.
        //
        // x_vel is the airborne driver and the engine owns it. The GROUNDED
        // driver is the game's inertia (sonic4: PlayerV.ground_speed), which the
        // ground state re-derives x_vel from every tick — so clearing x_vel
        // alone holds the player's POSITION and never touches his speed. That
        // was measured (DEFERRED_WORK SP-1): holding a direction into a 16px
        // solid he rested 10px from its centre against a 17px contact face, a
        // full top-speed step INSIDE it, re-rammed and re-pushed every frame;
        // release the button and friction took 140 frames to settle him at the
        // real face. S3K zeroes both at the same instruction pair
        // (sonic3k.asm:1E056 `move.w #0,ground_vel` + `move.w #0,x_vel`).
        //
        // The engine cannot name the game's inertia field — that is the same
        // wall that sends the spring's launch out through Game.spring_launched —
        // so the second half leaves through Game.solid_pushed, which costs zero
        // bytes for a game that binds nothing (demo).
        clr.w   x_vel(a2)
        invoke  Game.solid_pushed

    .ssp_done:
        rts
    }
}

// -----------------------------------------------
// Touch_Solid — AABB solid object collision response
// Determines contact face via minimum-penetration-axis,
// then pushes the player out and zeroes the relevant velocity.
//
// In:  a2 = player SST, a3 = target SST
//      d0.w = combined_w, d1.w = signed delta_x
//      d2.w = combined_h, d3.w = signed delta_y
// Out: none
// Clobbers: d0-d5
// -----------------------------------------------
proc Touch_Solid (d0: u16, d1: i16, d2: u16, d3: i16, a2: *Sst, a3: *Sst) clobbers(d0-d5) {
        solid_face_geometry(.solid_top, .solid_side, .solid_below)

    .solid_top:
        solid_top_land()

    .solid_side:
        solid_side_push()

    .solid_below:
        solid_below_stop()
}

// -----------------------------------------------
// Touch_Spring — a solid that LAUNCHES on the face it points out of.
//
// THE SPRING'S OWN VELOCITY PAIR IS ITS LAUNCH VECTOR, and since SP-5 that is
// the whole of what the engine knows about spring directions. A spring never
// moves, so both fields are free; the game writes them at spawn from whatever
// it wants to call a subtype, and this handler reads nothing else:
//
//     y_vel < 0  → the TOP face launches (upward spring)
//     y_vel > 0  → the UNDERSIDE face launches (downward spring)
//     x_vel != 0 → the face on the side x_vel POINTS AT launches, and only
//                  that one (a rightward spring launches a player who is to
//                  its right; its left face stays solid)
//
// Every face that does NOT launch splices the ordinary solid default, so a
// sideways spring is landable on top and a downward one is a wall from the
// side. That fallback is not a nicety: without the `y_vel < 0` test, a
// sideways spring's top face would have handed the player its ZERO y_vel and
// dropped him into the game's airborne state with no impulse at all — a
// spring you fall through the top of.
//
// WHY THE VELOCITY PAIR AND NOT THE SUBTYPE. A subtype is the GAME's encoding
// — S3K packs direction into bits 6-4 and strength into bit 1, and neither
// number means anything to an engine that has no springs of its own. Reading
// the vector instead keeps the engine seam exactly where the vertical spring
// put it (nothing here knows red from yellow, or up from left) and makes the
// unimplemented cases safe by construction: a spring whose game-side decode
// produced (0, 0) is simply a solid block on all four faces.
//
// The player's STATE is not the engine's business — the engine has no player
// state machine — so every launch leaves through Game.spring_launched with
// a2 = player, a3 = spring, and the game decides what the impulse means. That
// is also where a HORIZONTAL launch's other half lives: the grounded driver is
// the game's inertia field (sonic4: PlayerV.ground_speed), which the engine may
// not name, so setting x_vel here moves an airborne player and nothing else
// until the binding writes the inertia. A game that places a COLLISION_SPRING
// object MUST bind the hook.
//
// NO COOLDOWN FIELD, AND NONE IS MISSING. Each launching face carries its own
// interlock and each is a sign test on the player's own velocity, so a launched
// player cannot re-trigger the face he just left: the top face requires him to
// be FALLING (the geometry's shared test), the underside requires him to be
// RISING, and the side face throws him away from itself at 16px/frame so he is
// out of the box on the next tick. S3K's vertical spring likewise carries no
// timer (Obj_Spring_Up, sonic3k.asm:47659-47684, and sub_22F98, :47717-47770,
// hold no counter between them) — its interlock is the standing bit rather than
// the sign of y_vel, but the shape of the answer is the same.
//
// THE SIDE FACE DOES NOT PUSH THE PLAYER OUT before launching, and that is
// deliberate rather than forgotten. A launch REPLACES solidity for that face:
// the player leaves at the spring's own speed, which clears the box within one
// frame, and a push would additionally fight the launch it precedes. He may be
// re-launched on the frame he is still overlapping — at the identical speed, so
// it is not observable.
//
// In:  a2 = player SST, a3 = target SST
//      d0.w = combined_w, d1.w = signed delta_x
//      d2.w = combined_h, d3.w = signed delta_y
// Out: none
// Clobbers: d0-d5 (the template's) + the hook's declared d0-d2/a0-a2
// -----------------------------------------------
proc Touch_Spring (d0: u16, d1: i16, d2: u16, d3: i16, a2: *Sst, a3: *Sst) clobbers(d0-d5/a0-a2) {
        solid_face_geometry(.spring_top, .spring_side, .spring_below)

    .spring_top:
        tst.w   y_vel(a3)
        bpl     .spring_top_land        // not an UPWARD spring — land on it
        // Seat the player on the spring's top edge exactly as a solid would —
        // same +1 contact bias — and only THEN write the impulse. The order
        // matters: the hook may hand the player to an enter hook that shifts
        // y_pos (the uncurl), and it must shift from the seated position.
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        sub.w   d2, d1                  // target.y - combined_half_h
        addq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)

        move.w  y_vel(a3), y_vel(a2)    // THE LAUNCH — see the header
        invoke  Game.spring_launched
        rts

    .spring_top_land:
        solid_top_land()

    .spring_side:
        // Which side is the player on, and is it the side this spring points
        // at? d4 is the signed delta_x (positive = the player is to the RIGHT),
        // and x_vel is the launch vector, so the two agreeing in SIGN is exactly
        // "he is standing where this spring throws things". The `eor` is that
        // comparison in one instruction: bit 15 of the result is set iff the
        // signs differ. A zero x_vel is not a horizontal spring at all and takes
        // the same solid exit, so no separate arm is needed for the common case.
        move.w  x_vel(a3), d1
        beq     .spring_side_push       // not a horizontal spring
        move.w  d1, d5                  // d5 (signed delta_y) is dead here
        eor.w   d4, d5
        bmi     .spring_side_push       // the BACK face — solid, as S3K's is
        move.w  d1, x_vel(a2)           // THE LAUNCH — no push-out, see header
        invoke  Game.spring_launched
        rts

    .spring_side_push:
        solid_side_push()

    .spring_below:
        tst.w   y_vel(a3)
        ble     .spring_below_stop      // not a DOWNWARD spring — stop him
        tst.w   y_vel(a2)
        bpl     .spring_below_stop      // he is falling AWAY from the underside;
                                        // this is the re-fire interlock, and it
                                        // is the mirror of the top face's
        // Seat him under the spring's bottom edge, same -1 contact bias the
        // default underside uses, then launch him downward.
        add.w   d3, d2                  // restore combined_half_h
        move.w  y_pos(a3), d1
        add.w   d2, d1                  // target.y + combined_half_h
        subq.w  #1, d1                  // maintain contact
        move.w  d1, y_pos(a2)

        move.w  y_vel(a3), y_vel(a2)    // THE LAUNCH — downward
        invoke  Game.spring_launched
        rts

    .spring_below_stop:
        solid_below_stop()
}
