// Sprite rendering — priority-banded display list + VDP SAT builder

module engine.objects.sprites in sprites

use engine.objects.sst.{Sst}
use engine.constants.{PRIORITY_BANDS, SPRITES_PER_BAND, SCANLINE_BANDS,
                      SCANLINE_SPRITE_LIMIT, SCREEN_WIDTH, SCREEN_HEIGHT,
                      RF_ONSCREEN, RF_XFLIP, RF_YFLIP, RF_COORDMODE,
                      RF_MULTISPRITE, RF_PRIORITY_SHIFT,
                      FRAME_BBOX_X_MIN, FRAME_BBOX_X_MAX,
                      FRAME_BBOX_Y_MIN, FRAME_BBOX_Y_MAX,
                      FRAME_PIECE_COUNT, FRAME_PIECES,
                      MAX_VDP_SPRITES, VDP_SPRITE_X_OFFSET, VDP_SPRITE_Y_OFFSET}

// Sprite X=0 masking — VDP size code for mask sprites (1×4 cells = 8×32 pixels)
const SPRITE_MASK_SIZE   = %00000011     // width=1, height=4 (32 scanlines per mask)
const SPRITE_MASK_HEIGHT = 32

// -----------------------------------------------
// InitSpriteSystem — clear priority band counts and scanline band counters
// Called at frame start, before RunObjects.
// In:  none
// Out: none
// Clobbers: d0, a0
// -----------------------------------------------
pub proc InitSpriteSystem () clobbers(d0, a0) {
        // Clear all band counts (8 bytes, padded to even = 8 bytes)
        lea     Sprite_Band_Counts, a0
        moveq   #0, d0
        move.l  d0, (a0)+              // bands 0-3
        move.l  d0, (a0)+              // bands 4-7 + pad byte

        // Clear scanline band sprite counters (8 bytes: 7 bands + 1 pad)
        lea     Scanline_Band_Sprites, a0
        move.l  d0, (a0)+
        move.l  d0, (a0)

        // Sprites_Rendered is deliberately NOT reset here: it must persist
        // across frames so Render_Sprites' had-sprites -> none edge test
        // (.empty_table) fires the hidden SAT terminator exactly once.
        // Render_Sprites owns it on every exit path; the cold-boot RAM clear
        // seeds it to 0 (VRAM SAT also starts cleared, so frame 1 is correct).
        rts
}

// -----------------------------------------------
// Draw_Sprite — add an object to its priority band's display list
// Culls against per-frame precomputed bbox (exact piece extents).
// Sets/clears RF_ONSCREEN in render_flags.
// In:  a0 = SST pointer
// Out: none
// Clobbers: d0-d3, a1
// Preserves: a0, d7 (required by RunObjects_Frozen loop)
// -----------------------------------------------
pub proc Draw_Sprite (a0: *Sst) clobbers(d0-d3/a1) {
        // --- Child-skip guard for multi-sprite parents ---
        // If our parent has RF_MULTISPRITE set, we render via the parent's
        // sibling walk in Render_Sprites — don't register independently.
        move.w  Sst.parent_ptr(a0), d0
        beq   .no_parent
        movea.w d0, a1
        btst    #RF_MULTISPRITE, Sst.render_flags(a1)
        bne   .offscreen              // parent batches — clear ONSCREEN, don't register
        // NOTE (B2): a multisprite CHILD lands at .offscreen here and keeps
        // RF_ONSCREEN CLEAR even though it IS rendered (via the parent's
        // sibling walk in Render_Sprites). Nothing may key culling or logic on
        // a child's RF_ONSCREEN — for children the flag is meaningless.
    .no_parent:

        // Check if object has mappings — skip if null (must guard before frame resolution)
        movea.l Sst.mappings(a0), a1
        move.l  a1, d0
        beq   .offscreen

        // --- Check coordinate mode ---
        btst    #RF_COORDMODE, Sst.render_flags(a0)
        bne   .screen_coords          // screen-relative objects are always on-screen

        // --- Resolve current frame for its precomputed bbox ---
        moveq   #0, d0
        move.b  Sst.mapping_frame(a0), d0
        add.w   d0, d0                  // d0 = frame * 2 (word offset table)
        move.w  (a1,d0.w), d0          // d0 = word offset to frame data
        lea     (a1,d0.w), a1          // a1 = frame data (bbox at +0)

        // --- Exact X cull ---
        // screen_x = SST_x_pos - Camera_X (origin screen position)
        // Visible if: screen_x + x_min < SCREEN_WIDTH AND screen_x + x_max > 0
        move.w  Sst.x_pos(a0), d0
        sub.w   Camera_X, d0        // d0 = screen-relative X origin
        move.b  FRAME_BBOX_X_MIN(a1), d2
        ext.w   d2
        add.w   d0, d2                 // d2 = screen_x + x_min (left edge)
        cmpi.w  #SCREEN_WIDTH, d2
        bge   .offscreen             // left edge at/past right side — invisible
        move.b  FRAME_BBOX_X_MAX(a1), d2
        ext.w   d2
        add.w   d0, d2                 // d2 = screen_x + x_max (right edge)
        ble   .offscreen             // right edge at/left of screen — invisible

        // --- Exact Y cull ---
        move.w  Sst.y_pos(a0), d0
        sub.w   Camera_Y, d0        // d0 = screen-relative Y origin
        move.b  FRAME_BBOX_Y_MIN(a1), d2
        ext.w   d2
        add.w   d0, d2                 // d2 = screen_y + y_min (top edge)
        cmpi.w  #SCREEN_HEIGHT, d2
        bge   .offscreen             // top edge at/past bottom — invisible
        move.b  FRAME_BBOX_Y_MAX(a1), d2
        ext.w   d2
        add.w   d0, d2                 // d2 = screen_y + y_max (bottom edge)
        ble   .offscreen             // bottom edge at/above screen — invisible

    .screen_coords:
        // --- Object is on-screen ---
        bset    #RF_ONSCREEN, Sst.render_flags(a0)

        // Get priority band index from render_flags bits 5-7.
        // lsr discards bits 0-4 — no mask needed, and 3 bits can't
        // exceed PRIORITY_BANDS-1 by construction.
        moveq   #0, d0
        move.b  Sst.render_flags(a0), d0
        lsr.b   #RF_PRIORITY_SHIFT, d0

        // Check band overflow — cascade to lower bands if full
        lea     Sprite_Band_Counts, a1
        moveq   #0, d1
        move.b  (a1,d0.w), d1
        cmpi.b  #SPRITES_PER_BAND, d1
        blo   .band_has_room

        // CHOSEN (B2): a full band cascades the sprite DOWN into a lower band
        // (it renders BEHIND lower-priority sprites) rather than dropping it.
        // A saturated high band degrades z-order gracefully instead of the
        // sprite vanishing — visible-but-mis-layered beats invisible.
    .cascade:
        subq.w  #1, d0
        bmi   .all_bands_full         // all bands full, truly drop
        move.b  (a1,d0.w), d1
        cmpi.b  #SPRITES_PER_BAND, d1
        bhs   .cascade

    .band_has_room:
        // Compute slot index in Sprite_Bands:
        // offset = band * SPRITES_PER_BAND * 2 + count * 2
        move.w  d0, d2
        lsl.w   #6, d2                 // d2 = band * 64 (SPRITES_PER_BAND=32, *2 bytes)
        move.w  d1, d3
        add.w   d3, d3                 // d3 = count * 2
        add.w   d3, d2                 // d2 = byte offset into Sprite_Bands

        // Store object address in band list
        lea     Sprite_Bands, a1
        move.w  a0, (a1,d2.w)         // store SST address (RAM = .w addressable)

        // Increment band count
        lea     Sprite_Band_Counts, a1
        addq.b  #1, (a1,d0.w)

    .all_bands_full:
        rts

    .offscreen:
        bclr    #RF_ONSCREEN, Sst.render_flags(a0)
        rts
}

// -----------------------------------------------
// Render_Sprites — build VDP SAT from priority bands (7 to 0)
// Walks bands front-to-back (7=front, 0=back), reads each
// queued object's mappings, and writes VDP SAT entries into
// Sprite_Table_Buffer.
//
// VDP SAT entry format (8 bytes per hardware sprite):
//   +0 word: Y position (screen Y + 128)
//   +2 byte: size code (bits 3-2=width-1, bits 1-0=height-1)
//   +3 byte: link (next sprite index)
//   +4 word: tile attributes (priority|palette|flip|tile)
//   +6 word: X position (screen X + 128)
//
// Mapping format per piece (VDP-order, 8 bytes):
//   +0 word: Y offset (signed, relative to object center)
//   +2 byte: VDP size code
//   +3 byte: padding (overwritten with link)
//   +4 word: tile attributes (relative — added to art_tile)
//   +6 word: X offset (signed, relative to object center)
//
// Mapping table: word offsets from table base, indexed by mapping_frame.
//
// In:  none
// Out: none
// Clobbers: d0-d7, a0-a6
// -----------------------------------------------
pub proc Render_Sprites () clobbers(d0-d7/a0-a6) {
        addq.w  #1, Sprite_Cycle_Counter

        // Camera-bias fold: read Camera_X/Y ONCE here (final for this
        // frame's render — the single value every per-object world path
        // consumes) and store Camera - VDP_SPRITE_*_OFFSET. The
        // per-object setup subtracts the BIASED camera, folding the +128 SAT
        // offset in, so all four Emit loops drop their per-piece `addi #128`
        // (16 cyc/piece). Behavior-identical; screen-coord paths compensate.
        move.w  Camera_X, d0
        subi.w  #VDP_SPRITE_X_OFFSET, d0
        move.w  d0, Camera_X_Biased
        move.w  Camera_Y, d0
        subi.w  #VDP_SPRITE_Y_OFFSET, d0
        move.w  d0, Camera_Y_Biased

        lea     Sprite_Table_Buffer, a4        // a4 = SAT buffer write pointer
        moveq   #0, d5                      // d5 = VDP sprite index (0-based)

        // Use a5 as band counter (7 down to 0) to avoid d6 conflicts
        movea.w #PRIORITY_BANDS-1, a5       // a5 = band counter (7)

    .band_loop:
        move.w  a5, d6                      // d6 = current band index
        lea     Sprite_Band_Counts, a1
        moveq   #0, d7
        move.b  (a1,d6.w), d7              // d7.w = number of objects in this band
        beq   .next_band                  // skip empty bands

        // Get base of this band's object list
        move.w  d6, d0
        lsl.w   #6, d0                     // d0 = band * 64 (SPRITES_PER_BAND=32, *2 bytes)
        lea     Sprite_Bands, a2
        adda.w  d0, a2                     // a2 = pointer to this band's list

        subq.w  #1, d7                     // adjust for dbf (must be .w — dbf uses full word)

        // --- Link-order cycling: reverse intra-band order on odd frames ---
        // CHOSEN (B2): same-band overlap z-order flips EVERY frame, even with
        // no band overflow — per-frame fairness (no sprite is permanently
        // occluded by a same-band neighbour) is preferred over a stable
        // z-order. The flicker is the cost of the fairness.
        btst    #0, Sprite_Cycle_Counter+1    // odd byte = frame parity; (Sprite_Cycle_Counter+1).w ram.asm
        bne   .reverse_band
        move.w  #2, -(sp)                  // even frame: forward step
        jbra   .object_loop
    .reverse_band:
        move.w  d7, d0
        add.w   d0, d0                     // d0 = (count-1) * 2
        adda.w  d0, a2                     // a2 → last entry in band
        move.w  #-2, -(sp)                 // odd frame: reverse step

    .object_loop:
        // Check VDP sprite limit
        cmpi.w  #MAX_VDP_SPRITES, d5
        bge   .band_limit_pop            // pop step, then done

        // Get object SST address (step direction from stack)
        movea.w (a2), a0
        adda.w  (sp), a2                   // advance by +2 or -2

        // Guard: skip NULL band entries (safety net for mid-frame deletion)
        move.w  a0, d0
        beq   .next_object

        // --- Total-piece overflow pre-check (§1.2) ---
        // Skip whole object if its cached piece count would push us past
        // the 80-piece SAT cap. For uncached objects (sprite_piece_count=0),
        // this is a no-op since d5 + 0 can never exceed the cap that the
        // outer .object_loop check (above) already guarded.
        moveq   #0, d0
        move.b  Sst.sprite_piece_count(a0), d0
        add.w   d5, d0
        cmpi.w  #MAX_VDP_SPRITES, d0
        bhi   .next_object               // would overflow — skip whole object

        // Guard: skip objects deleted mid-frame (slot zeroed after Draw_Sprite)
        movea.l Sst.mappings(a0), a3       // a3 = mapping table base
        move.l  a3, d0
        beq   .next_object

        // Get frame offset from mapping table
        moveq   #0, d0
        move.b  Sst.mapping_frame(a0), d0  // d0 = frame index
        add.w   d0, d0                     // d0 = frame * 2 (word offset table)
        move.w  (a3,d0.w), d0             // d0 = word offset to frame data
        lea     (a3,d0.w), a3             // a3 = pointer to frame data (bbox at +0)

        // Piece count is at FRAME_PIECE_COUNT (+4), pieces start at FRAME_PIECES (+6)
        move.w  FRAME_PIECE_COUNT(a3), d4  // d4 = piece count
        beq   .next_object               // skip if zero pieces
        lea     FRAME_PIECES(a3), a3       // a3 = pointer to first piece

        // Compute screen position from world coords
        // Object render_flags bit 3 = coordinate mode
        btst    #RF_COORDMODE, Sst.render_flags(a0)
        bne   .screen_pos

        // World coords: d2/d3 = object_pos - biased_camera = screen_pos + 128
        // (the +128 SAT offset folded in via the biased camera).
        move.w  Sst.x_pos(a0), d2         // object X integer
        sub.w   Camera_X_Biased, d2        // d2 = screen X + 128
        move.w  Sst.y_pos(a0), d3         // object Y integer
        sub.w   Camera_Y_Biased, d3        // d3 = screen Y + 128
        jbra   .have_pos

    .screen_pos:
        // Screen coords: position IS the screen position; add the +128 SAT
        // offset explicitly (this path skips the biased-camera subtract).
        move.w  Sst.x_pos(a0), d2
        addi.w  #VDP_SPRITE_X_OFFSET, d2
        move.w  Sst.y_pos(a0), d3
        addi.w  #VDP_SPRITE_Y_OFFSET, d3

    .have_pos:
        move.w  Sst.art_tile(a0), d6

        // --- Scanline band budget check ---
        // SOFT heuristic that UNDERCOUNTS by design (B1): the early-out below
        // (d5 < SCANLINE_SPRITE_LIMIT) skips the COMMIT too, so the first
        // SCANLINE_SPRITE_LIMIT sprites are never charged to the per-band
        // counters (budget lenient ~2× per band); and multi-sprite CHILDREN
        // (the sibling walk) bypass the budget entirely. The VDP drops excess
        // per-line sprites in hardware regardless — the budget only shapes
        // WHICH sprites drop, so an approximate charge is acceptable.
        // (Volence's gate call: keep soft, or always-commit + charge children.)
        cmpi.w  #SCANLINE_SPRITE_LIMIT, d5
        blo   .budget_ok
        move.w  d3, d0                     // d0 = biased Y (screen Y + 128)
        subi.w  #VDP_SPRITE_Y_OFFSET, d0   // d0 = true screen-relative Y (unbias)
        bmi   .budget_ok                 // above screen — allow
        lsr.w   #5, d0                     // d0 = screen_y >> 5 = band index (0-6)
        cmpi.w  #SCANLINE_BANDS, d0
        bhs   .budget_ok                 // below screen — allow
        lea     Scanline_Band_Sprites, a1
        move.b  (a1,d0.w), d1
        add.b   d4, d1                     // d1 = current count + this object's pieces
        cmpi.b  #SCANLINE_SPRITE_LIMIT, d1
        bhs   .next_object               // band overloaded — skip object
        move.b  d1, (a1,d0.w)             // commit updated count
    .budget_ok:

        // Determine flip variant from render_flags bits 1-2
        move.b  Sst.render_flags(a0), d0
        andi.w  #(1<<RF_XFLIP)|(1<<RF_YFLIP), d0

        // --- Multi-sprite branch (Approach 1 + semantic C) ---
        btst    #RF_MULTISPRITE, Sst.render_flags(a0)
        bne   .multi_sprite

        // Single-sprite: emit pieces and continue to next band entry
        jbsr   Emit_ObjectPieces
        jbra   .next_object

    .multi_sprite:
        // Save band-pointer a2; repurpose a2 = parent SST throughout sibling walk
        move.l  a2, -(sp)
        movea.l a0, a2
        jbsr   Emit_ObjectPieces       // emit parent's pieces

        move.w  Sst.sibling_ptr(a2), d0
    .sibling_loop:
        tst.w   d0
        beq   .multi_done

        movea.w d0, a0                  // a0 = current child SST

        // Read child's mappings; index using PARENT's mapping_frame (semantic C)
        move.l  Sst.mappings(a0), d1
        beq   .sibling_advance
        movea.l d1, a3
        moveq   #0, d1
        move.b  Sst.mapping_frame(a2), d1   // PARENT's mapping_frame
        add.w   d1, d1
        move.w  (a3,d1.w), d1
        lea     (a3,d1.w), a3                // a3 = child's frame data (bbox at +0)
        move.w  FRAME_PIECE_COUNT(a3), d4    // piece count at +4
        beq   .sibling_advance
        lea     FRAME_PIECES(a3), a3         // advance to first piece (+6)

        // Just-in-time overflow pre-check (uses live count, not cache)
        move.w  d5, d1
        add.w   d4, d1
        cmpi.w  #MAX_VDP_SPRITES, d1
        bhi   .sibling_advance             // would overflow — skip just this child

        // Compute child screen position
        btst    #RF_COORDMODE, Sst.render_flags(a0)
        bne   .child_screen_pos
        move.w  Sst.x_pos(a0), d2
        sub.w   Camera_X_Biased, d2        // screen X + 128
        move.w  Sst.y_pos(a0), d3
        sub.w   Camera_Y_Biased, d3        // screen Y + 128
        jbra   .child_have_pos
    .child_screen_pos:
        move.w  Sst.x_pos(a0), d2
        addi.w  #VDP_SPRITE_X_OFFSET, d2   // screen path: add the +128 SAT offset
        move.w  Sst.y_pos(a0), d3
        addi.w  #VDP_SPRITE_Y_OFFSET, d3
    .child_have_pos:
        move.w  Sst.art_tile(a0), d6
        move.b  Sst.render_flags(a0), d0
        andi.b  #(1<<RF_XFLIP)|(1<<RF_YFLIP), d0

        // Save child SST across Emit (a0 clobbered by subroutine)
        move.l  a0, -(sp)
        jbsr   Emit_ObjectPieces
        movea.l (sp)+, a0

    .sibling_advance:
        move.w  Sst.sibling_ptr(a0), d0
        jbra   .sibling_loop

    .multi_done:
        movea.l (sp)+, a2               // restore band-pointer

    .next_object:
        dbf     d7, .object_loop
        addq.w  #2, sp                    // pop step value after band complete

    .next_band:
        // --- Sprite X=0 mask insertion at band boundary ---
        move.w  a5, d0                    // d0 = band we just finished (or about to start)
        cmp.b   SpriteMask_After_Band, d0
        bne   .no_mask_insert
        tst.w   SpriteMask_Y
        beq   .no_mask_insert
        jbsr   InsertSpriteMasks
    .no_mask_insert:

        // Decrement band counter
        subq.w  #1, a5
        move.w  a5, d0
        bpl   .band_loop                // continue while band >= 0

        jbsr   DrawRings                 // emit ring sprites (§4.9)

    .done:
        // Fix up last sprite's link to 0 (end of chain)
        tst.w   d5
        beq   .empty_table              // nothing rendered
        move.b  #0, -5(a4)               // overwrite last sprite's link byte with 0
        // BUG-005 net: walk the finished link chain from entry 0; the link-path
        // length must equal the emitted count. Traps in-frame with the builder's
        // registers live (d5 = count, a4 = write ptr). Bounded at MAX_VDP_SPRITES
        // so a cyclic chain traps on the mismatch instead of hanging.
        if DEBUG == 1 {
        lea     Sprite_Table_Buffer, a0
        moveq   #0, d0                  // d0 = current entry index
        moveq   #0, d1                  // d1 = links walked
        move.w  #MAX_VDP_SPRITES-1, d2  // loop bound
    .chain_walk:
        addq.w  #1, d1
        move.w  d0, d3
        lsl.w   #3, d3                  // entry * 8
        moveq   #0, d0
        move.b  3(a0,d3.w), d0          // link byte -> next index (sets Z from link)
        dbeq    d2, .chain_walk         // stop on link 0 (terminator)
        assert.w d1, eq, d5             // link-path length == Sprites_Rendered
        }
        move.w  d5, Sprites_Rendered
        move.b  #1, Sprite_Table_Dirty
        rts

    .empty_table:
        // Zero sprites this frame. Without an explicit hidden terminator
        // at sprite 0, the previous frame's SAT (full link chain) stays
        // in VRAM and its sprites freeze on screen. Edge-triggered: only
        // written on the had-sprites → none transition.
        tst.w   Sprites_Rendered
        beq   .still_empty              // already terminated last frame
        moveq   #0, d0
        move.l  d0, (a4)+                // Y=0, size=0, link=0 (chain ends)
        move.l  d0, (a4)                 // tile=0, X=0
        move.w  d0, Sprites_Rendered
        move.b  #1, Sprite_Table_Dirty
    .still_empty:
        rts

    .band_limit_pop:
        // NOTE (B2): the cap path jumps straight to .done, SKIPPING the
        // DrawRings call the normal band-loop exit makes (before .done). This
        // is equivalent to the normal path ONLY because DrawRings cannot emit
        // once d5 == MAX_VDP_SPRITES (the cap we hit to get here) — it early-
        // outs at the cap. If DrawRings is ever changed to emit at the cap,
        // this shortcut silently drops rings; route DrawRings before .done.
        addq.w  #2, sp                    // pop step value before done
        jbra   .done
}

// -----------------------------------------------
// Flip offset lookup table (indexed by raw VDP size byte)
// VDP size byte: bits 3-2 = width-1, bits 1-0 = height-1
//
// Width adjustment for X-flipped sprites
// Returns pixel width: (((size>>2)&3)+1)*8
// -----------------------------------------------
data CellOffsets_XFlip: [u8; 16] = [
        8,  8,  8,  8,             // width=1 (8px)
       16, 16, 16, 16,             // width=2 (16px)
       24, 24, 24, 24,             // width=3 (24px)
       32, 32, 32, 32,             // width=4 (32px)
]

// -----------------------------------------------
// Per-piece SAT-emit term helpers — each returns the straight-line Code for
// one flip-dependent segment of the piece loop (§2026-07-11 asm code-splice).
// Label-free by construction (x_term's .x_ok is self-contained), so they drop
// into the emit_piece_loop skeleton as holes without touching its .piece_loop.
// -----------------------------------------------

// Y position: flipped negates then subtracts the sprite height; upright just
// adds the camera-relative origin.
comptime fn y_term(yflip: int) -> Code {
    if yflip != 0 {
        return asm {
            neg.w   d0
            andi.w  #3, d1                  // height-1 from VDP size code low 2 bits
            addq.w  #1, d1
            lsl.w   #3, d1                  // height in pixels
            sub.w   d1, d0
            add.w   d3, d0                  // d3 = Camera_Y_Biased origin (+128 pre-folded)
            move.w  d0, (a4)+
        }
    }
    return asm {
        add.w   d3, d0                  // d3 = Camera_Y_Biased origin (+128 pre-folded)
        move.w  d0, (a4)+              // SAT +0: Y
    }
}

// size code + link: the yflip height calc clobbered d1 → re-read it first.
comptime fn size_link(yflip: int) -> Code {
    if yflip != 0 {
        return asm {
            move.b  -6(a3), d1              // re-read VDP size code
            move.b  d1, (a4)+              // SAT +2: size code
            addq.b  #1, d5
            move.b  d5, (a4)+              // SAT +3: link
        }
    }
    return asm {
        move.b  d1, (a4)+              // SAT +2: size code
        addq.b  #1, d5
        move.b  d5, (a4)+              // SAT +3: link
    }
}

// tile attrs: toggle the flip bits — X=$0800, Y=$1000, both=$1800.
comptime fn tile_term(xflip: int, yflip: int) -> Code {
    if xflip != 0 {
        if yflip != 0 {
            return asm {
                move.w  a6, d0
                eori.w  #$1800, d0              // toggle both flip bits
                add.w   d6, d0
                move.w  d0, (a4)+
            }
        }
        return asm {
            move.w  a6, d0
            eori.w  #$0800, d0              // toggle X flip bit
            add.w   d6, d0
            move.w  d0, (a4)+
        }
    }
    if yflip != 0 {
        return asm {
            move.w  a6, d0
            eori.w  #$1000, d0              // toggle Y flip bit
            add.w   d6, d0
            move.w  d0, (a4)+
        }
    }
    return asm {
        move.w  a6, d0
        add.w   d6, d0
        move.w  d0, (a4)+              // SAT +4: tile attrs
    }
}

// X position: flipped negates then subtracts the sprite width (from
// CellOffsets_XFlip via a0); upright just adds the origin. The .x_ok label +
// its bne are BOTH here (self-contained) → resolved within this block, so the
// splice never touches the skeleton's .piece_loop.
comptime fn x_term(xflip: int) -> Code {
    if xflip != 0 {
        return asm {
            move.w  a1, d0
            neg.w   d0
            moveq   #0, d1
            move.b  -6(a3), d1              // re-read VDP size code
            move.b  (a0,d1.w), d1           // X-flip width from CellOffsets_XFlip
            sub.w   d1, d0
            add.w   d2, d0                  // d2 = Camera_X_Biased origin (+128 pre-folded)
            bne     .x_ok
            moveq   #1, d0
        .x_ok:
            move.w  d0, (a4)+
        }
    }
    return asm {
        move.w  a1, d0
        add.w   d2, d0                  // d2 = Camera_X_Biased origin (+128 pre-folded)
        bne     .x_ok
        moveq   #1, d0
    .x_ok:
        move.w  d0, (a4)+              // SAT +6: X
    }
}

// -----------------------------------------------
// emit_piece_loop — the per-piece SAT-emit loop skeleton, parametrized by
// flip. The loop-back label (.piece_loop) and its dbeq live in THIS ONE block;
// the flip-dependent segments are label-free {term()} splices (holes). The
// caller jumps to the matching instantiation, so the code stays fully UNROLLED
// (zero JSR per piece). Byte-identical to the four former inline variants.
// -----------------------------------------------
comptime fn emit_piece_loop(xflip: int, yflip: int) -> Code {
    return asm {
        subq.w  #1, d4
    .piece_loop:
        move.w  (a3)+, d0               // Y offset (signed)
        move.b  (a3)+, d1               // VDP size code
        addq.w  #1, a3                  // skip padding byte
        move.w  (a3)+, a6              // tile attrs (relative)
        move.w  (a3)+, a1              // X offset (signed)
        {y_term(yflip)}
        {size_link(yflip)}
        {tile_term(xflip, yflip)}
        {x_term(xflip)}
        cmpi.b  #MAX_VDP_SPRITES, d5
        dbeq    d4, .piece_loop
        rts
    }
}

// -----------------------------------------------
// Emit_ObjectPieces — emit one object's mapping pieces to the SAT buffer
// Reusable across single-object render path and multi-sprite sibling walk.
// Dispatches on the (already-masked) flip byte to the matching unrolled
// emit_piece_loop instantiation (four variants, zero JSR per piece).
//
// In:  a3 = pointer to first piece data (after piece-count word)
//      a4 = SAT buffer write pointer
//      d2.w = screen X (camera-adjusted)
//      d3.w = screen Y (camera-adjusted)
//      d4.w = piece count (raw, not yet dbf-adjusted)
//      d5.w = running sprite total (in/out, incremented per piece)
//      d6.w = art_tile (palette/priority/tile base)
//      d0.b = flip variant (RF_XFLIP|RF_YFLIP bits, ALREADY MASKED)
// Out: a3 advanced past consumed pieces
//      a4 advanced past emitted SAT entries
//      d5 incremented per emitted piece (capped at MAX_VDP_SPRITES)
//      d4 = -1 (consumed by dbf)
// Clobbers: d0, d1, d4, a0 (repurposed for flip-table), a1, a3 (walked past
//   the consumed pieces), a6
// Preserves: d2, d3, d6, d7
// -----------------------------------------------
proc Emit_ObjectPieces (a3: *u8, a4: *u8, d0: u8, d2: i16, d3: i16, d4: u16, d5: u16, d6: u16) clobbers(d0-d1/d4/a0-a1/a3/a6) out(d5, a4) {
        lea     CellOffsets_XFlip(pc), a0  // a0 = flip-table base for variants
        tst.b   d0
        beq   .pieces_unflipped
        cmpi.b  #1<<RF_XFLIP, d0
        beq   .pieces_xflip
        cmpi.b  #1<<RF_YFLIP, d0
        beq   .pieces_yflip
        jbra   .pieces_xyflip

    .pieces_unflipped:
        emit_piece_loop(0, 0)
    .pieces_xflip:
        emit_piece_loop(1, 0)
    .pieces_yflip:
        emit_piece_loop(0, 1)
    .pieces_xyflip:
        emit_piece_loop(1, 1)
}

// -----------------------------------------------
// InsertSpriteMasks — write X=0 mask sprites into the SAT buffer
// Inserts enough 8×32 mask sprites to cover SpriteMask_Height scanlines
// starting at SpriteMask_Y. Sprites after these in the link chain are
// hidden on the covered scanlines (VDP hardware feature).
//
// C1 (accepted limitation, Volence 2026-07-11): the VDP X=0 mask honours the
// FIRST-SPRITE-ON-LINE exemption — masking takes effect ONLY when an EARLIER-
// linked (higher-priority) sprite already touches the masked scanline. A mask
// inserted at a band boundary whose HIGHER bands are empty is itself the first
// sprite on those lines, so it does NOT hide anything there. Known limitation;
// masking is reliable only where the masked lines carry a leading sprite. A
// future guaranteed-leader fix is ledgered (campaign-gap-ledger, consumer-gated).
//
// In:  a4 = SAT buffer write pointer (current position)
//      d5 = current VDP sprite index
// Out: a4 = advanced past mask entries
//      d5 = updated sprite index
// Clobbers: d0-d1
// -----------------------------------------------
proc InsertSpriteMasks (a4: *u8, d5: u16) clobbers(d0-d1) out(d5, a4) {
        move.w  SpriteMask_Y, d0        // d0 = VDP Y start position
        move.w  SpriteMask_Height, d1        // d1 = remaining scanlines to cover
        ble   .masks_done

    .mask_loop:
        cmpi.w  #MAX_VDP_SPRITES, d5
        bge   .masks_done

        move.w  d0, (a4)+                 // SAT +0: Y position
        move.b  #SPRITE_MASK_SIZE, (a4)+  // SAT +2: size (1×4 = 8×32px)
        addq.b  #1, d5
        move.b  d5, (a4)+                 // SAT +3: link to next sprite
        move.w  #0, (a4)+                 // SAT +4: tile 0 (transparent)
        move.w  #0, (a4)+                 // SAT +6: X = 0 (triggers masking)

        addi.w  #SPRITE_MASK_HEIGHT, d0   // advance Y by 32 scanlines
        subi.w  #SPRITE_MASK_HEIGHT, d1   // subtract covered height
        // NOTE (B2): coverage rounds UP to whole 32-scanline mask sprites —
        // SpriteMask_Height is effectively ceil'd to a multiple of 32 (the
        // loop emits one full 8×32 mask per pass while d1 > 0). Intended: a
        // partial final band still gets a full mask sprite covering its 32
        // lines; over-covering a few blank scanlines is harmless.
        bgt   .mask_loop                // continue if scanlines remain

    .masks_done:
        rts
}
