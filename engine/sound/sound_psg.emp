// ===========================================================================
// engine/sound/sound_psg.emp — SN76489 PSG voice writer (Sound 1C, Task 4)
// ===========================================================================
// The rung-2 CONTRACT-model acceptance corpus (design note
// 2026-07-29-z80-rung2-contracts.md). Assembled INLINE inside the
// z80_sound_driver.emp `phase 0` blob (4th of 5: sequencer -> sfx -> fm -> psg ->
// tables), so its labels resolve into Z80 RAM and it reaches PsgDivisorTableZ /
// the PsgVolEnv_* tables with direct Z80
// addressing (no $8000-window banking). Turns the sequencer's PSG-route hooks
// into real SN76489 register writes: the three tone channels + the noise
// channel become audible.
//
// The CANONICAL, only source (no .asm twin). Native-linked via seam-1
// (emit_sound_blob): the five sound `.emp` files link as one Z80 module set and
// the whole-ROM byte gate proves both shapes. This section declares NO `vma:` —
// seam-1 DERIVES every resident base from a running cursor over the preceding
// modules' emitted spans (sigil `seam1::place_resident_sections`), so no base
// address is written down anywhere and a size change cannot leave a stale pin.
// The phase-0 window is still SHAPE-VARIANT: psg sits lower in the plain shape
// than in the debug shape, because the upstream driver/sequencer/sfx/fm grow under
// __DEBUG__ before psg. psg's OWN layout is shape-invariant (no __DEBUG__ here),
// so the two shapes differ only in the absolute base embedded in the internal
// call/jp targets + the external symbol values — seam-1 links both.
//
// --- PSG PORT + COEXISTENCE WITH THE 1B DAC LOOP --------------------------
// The PSG is a single write port at $7F11 (SND_Z80_PSG). Every write is a plain
// `ld (SND_Z80_PSG),a`. Unlike the YM2612:
//   * NO inter-byte delay — latch + data bytes are written back-to-back.
//   * NO busy-poll, NO bus-contention guard — the Z80 owns the PSG; nothing else
//     writes it. PSG writes touch NO YM port ($4000-$4003), so they never disturb
//     the parked-$2A address latch and need no Fm_ReparkDac. They DO clobber `de`,
//     however (Psg_NoteOn/Psg_EmitDivisor load the divisor-table base into de): the
//     DAC loop's de=$4001 invariant is re-established by the Timer-A tick CALLER
//     (SndDrv_IdleTick reloads de; Snd_TimerA_Rearm re-parks $2A), NOT by PSG code
//     preserving de.
//
// --- CHANNEL-INDEX DERIVATION (route -> hardware ch / command bytes) -------
//   route  CHROUTE_  hw ch  tone latch  vol latch   used bytes
//     5      PSG1       0      $80         $90       tone freq + atten
//     6      PSG2       1      $A0         $B0        "
//     7      PSG3       2      $C0         $D0        "
//     8      PSGN     (noise)   —          $F0        noise ctrl ($E0..) + atten
// For the three tone channels the hardware ch index = route - CHROUTE_PSG1
// (0..2); ch<<5 gives the latch/vol base offset. PSGN is the dedicated noise
// channel (its own control + volume bytes), routed to Psg_Noise by the hook.
//
// --- VOLUME MAP (decision 1: linear->attenuation by SHIFT, no LUT) ---------
//   atten = ($7F - vol) >> 3        ; linear 0..127 -> 4-bit attenuation 0..15
// Endpoints: vol 127 -> atten 0 (loudest), vol 0 -> atten $0F (silent). The PSG
// attenuation ladder is ALREADY logarithmic (~2 dB/step), so a LINEAR-domain
// subtract+shift is the correct mapping — PSG volume is deliberately NOT routed
// through the FM 256-byte LogVolumeLutZ (that would double-log and crush the low
// end). The subtract can't underflow for vol<=$7F; vol>$7F clamps to atten 0
// since the high bits are masked off by the final `and $0F`.
//
// --- NOISE NOTE MAPPING (CHROUTE_PSGN) -------------------------------------
// The SN76489 noise control byte ($E0|mode|rate; D2 = 0 periodic / 1 white;
// D1-D0 = rate 00 clk/512, 01 clk/1024, 10 clk/2048, 11 = clock from tone-ch2's
// frequency) selects mode+rate; the LFSR resets only when this byte is WRITTEN, so
// it is set ON-CHANGE (not per note). MUSIC and SFX encode the noise differently:
//   MUSIC: MEV_PSGNOISE ($F2) owns the control byte (sets it + caches sc_noise_mode
//     + silences tone-ch2's tone volume $DF). A noise NOTE then carries a real PITCH:
//     in rate-3 mode Psg_Noise writes that note's divisor to tone-ch2's frequency
//     latch ($C0) = the noise clock, so the hat tracks pitch (S3K-faithful). Each hit
//     is shaped by the per-note PSG volume envelope (the LFSR free-runs).
//   SFX: the SFX transcoder drops smpsPSGform, so a noise note's low 3 bits ARE the
//     mode/rate -> control byte = $E0|(note&7) (legacy; fixed rate, no tone-ch2 clock).
// Both: note-on sets the noise VOLUME from sc_volume; a rest sets it silent ($FF).
//
// --- ix PRESERVATION (project-critical contract) --------------------------
// Every routine here PRESERVES ix (the SeqChannel pointer the channel loop relies
// on) — none of them touch ix at all (it is only read as `(ix+d)`). This is the
// module-scope `invariant: preserves(ix)`: the checker inherits it onto every
// proc and verifies it over the push/pop stack model + the callee-preserves
// oracle (a `call`/tail-jump to a routine that itself preserves ix does not
// clobber it). The full register contract is machine-checked: `out(<reg>)` names
// each result register, `clobbers(...)` the destroyed scratch (the `af` split —
// `a` is the result, `f` the flag scratch), `preserves(...)` the save/restored or
// untouched set (a false clobber comment caused a prior bug — the checker closes
// that class). The cross-module callees resolve by import, so the oracle credits
// their ix (and de) preservation from the definitions' own contracts.
// ===========================================================================

module engine.sound_psg (cpu: z80, invariant: preserves(ix))

// The cross-module resident callees psg sub-calls, resolved by import: their
// contracts (including the project-wide ix preservation) are the definitions'.
// Snd_ChanClass classifies the active channel (preserves bc/de, on which
// Psg_SetVolume relies); Mod_ReArm re-arms pitch mod; Mod_Advance steps it.
use engine.sound_fm.{Snd_ChanClass}
use engine.sound_sequencer.{Mod_ReArm, Mod_Advance}

section sound_psg (cpu: z80) {

    // ------------------------------------------------------------------
    // Psg_HwCh — derive the hardware tone-channel index (0..2) from sc_route.
    // In:  ix = SeqChannel (uses sc_route, CHROUTE_PSG1..3).
    // Out: a = hw ch (0..2). (PSGN never reaches here — the hook routes it to
    //      Psg_Noise before any tone-channel math.)
    // ------------------------------------------------------------------
    // Contract: out(a) = hw ch; clobbers f (the sub flags); preserves bc, de, hl
    // (ix inherited from the module invariant). The `af` header splits: `a` is the
    // result, `f` the scratch.
    pub proc Psg_HwCh () out(a) clobbers(f) preserves(bc, de, hl) {
        ld      a, (ix+sc_route)
        sub     CHROUTE_PSG1            // route 5/6/7 -> hw ch 0/1/2
        ret
    }

    // ------------------------------------------------------------------
    // Psg_ChBase — derive ch<<5 (the latch/vol base offset) for a tone channel.
    // In:  ix = SeqChannel.  Out: a = ch<<5 ($00/$20/$40 for hw ch 0/1/2).
    // ------------------------------------------------------------------
    // Contract: out(a) = ch<<5; clobbers f (rrca carry); preserves bc, de, hl (via
    // Psg_HwCh's contract, credited by the callee-preserves oracle) + ix (inherited).
    pub proc Psg_ChBase () out(a) clobbers(f) preserves(bc, de, hl) {
        call    Psg_HwCh               // a = hw ch (0..2)
        rrca                           // ch<<5: rotate right 3 == <<5 mod 256
        rrca                           //   (ch<=2 -> bits land in D6-D5, no wrap
        rrca                           //    into D7 since ch fits in 2 bits)
        ret
    }

    // ------------------------------------------------------------------
    // Psg_VolToAtten — map a linear volume (0..127) to 4-bit PSG attenuation.
    // In:  a = linear volume.  Out: a = attenuation (0..15; 0 loudest, $0F silent).
    // atten = (($7F - vol) >> 3) & $0F   (decision 1; see file header).
    // ------------------------------------------------------------------
    // Contract: out(a) = atten; clobbers f (the and/srl flags); preserves bc, de, hl
    // (ix inherited). The `af` header splits: `a` is the result, `f` the scratch.
    //
    // Computed with xor + rrca rather than a literal subtract-and-shift. Two facts
    // make it exact:
    //   * The answer only ever depends on BITS 6..3 of ($7F - vol), because the old
    //     form's trailing `and $0F` discards everything above bit 6 after the >>3.
    //     And bits 6..0 of ($7F - vol) are exactly bits 6..0 of (vol xor $7F), for
    //     every one of the 256 inputs — including vol > $7F, where the subtract
    //     borrows: $7F-($80+w) = $FF-w, whose low seven bits are $7F-w = (w xor $7F).
    //     So the xor replaces the subtract AND removes the need for a scratch
    //     register to hold the subtrahend.
    //   * rrca is 1 byte where srl a is 2. Rotating right 3 puts bits 6..3 into bits
    //     3..0, which the SAME `and $0F` the old form already needed then extracts —
    //     the rotated-in high bits are discarded by a mask that was never optional.
    // 13 B and a dead `b` become 8 B and a free one. Verified by enumerating the
    // whole byte domain: 256 inputs, zero mismatches. Endpoints unchanged: vol $7F ->
    // atten 0 (loudest), vol 0 -> atten $0F (silent), vol > $7F -> atten 0.
    // (Same rrca-instead-of-shift idiom as Psg_ChBase above.)
    pub proc Psg_VolToAtten () out(a) clobbers(f) preserves(bc, de, hl) {
        xor     SND_FM_TL_MAX          // bits 6..0 = bits 6..0 of ($7F - vol)
        rrca                           // rotate right 3: bits 6..3 land in bits 3..0
        rrca
        rrca
        and     SND_PSG_ATTEN_SILENT   // $0F — keeps exactly those four bits
        ret
    }

    // ------------------------------------------------------------------
    // Psg_EnvCursorReset — restart the PSG vol-env contour on a fresh attack.
    // sc_psgenv_cur (+40) exists on BOTH music and SFX SeqChannels, so no
    // channel-class gate is needed. Harmless on a no-env channel (the cursor is
    // unused while sc_psgenv=0).
    // In: ix = SeqChannel/SfxChannel.
    // ------------------------------------------------------------------
    // Contract: clobbers nothing — the two (ix+d) immediate stores touch no
    // register (the .asm's `Clobbers af` over-claims). Preserves af, bc, de, hl (ix
    // inherited); the checker VERIFIES the af the header wrongly claimed clobbered.
    pub proc Psg_EnvCursorReset () preserves(af, bc, de, hl) {
        ld      (ix+sc_psgenv_cur), 0  // restart the contour from frame 0
        ld      (ix+sc_psgenv_out), 0  // drop the previous note's env tail so the
                                       // attack's volume emit (Psg_NoteOn's SetVolume,
                                       // right after this) starts clean, not one frame
                                       // of the old note's stale attenuation delta
        ret
    }

    // ------------------------------------------------------------------
    // PsgVolEnv_Resolve — map a 1-based PSG vol-env id (a) to its body ptr (hl) via
    // the PsgVolEnv_Ids/PsgVolEnv_Ptrs parallel-array map (sound_tables_z80.emp).
    // Out: carry clear + hl = body base on a match; carry set on an unknown id.
    // In: a = 1-based env id.
    // This is only the THREE-CONSTANT HEAD — count + the two table bases — falling
    // into the shared scan (VolEnv_ResolveScan). The FM mirror is byte-identical
    // apart from those three constants, so the scan exists once and each family
    // supplies its own head. See VolEnv_ResolveScan for why this is not a generic.
    // ------------------------------------------------------------------
    // Contract: out(hl) = body base + out(carry: found); clobbers a, b, de, f
    // (scan scratch); preserves c (untouched) + ix (inherited). The `bc` header
    // over-claims — only `b` (the djnz counter) dies, `c` survives.
    pub proc PsgVolEnv_Resolve () out(hl, carry: found) clobbers(a, b, de, f) preserves(c) falls_into VolEnv_ResolveScan {
        ld      b, PSGVOLENV_COUNT
        ld      hl, PsgVolEnv_Ids      // banked table; label = its $8000-window ptr
        ld      de, PsgVolEnv_Ptrs     // banked ptr array (entries are window ptrs)
        // fall into VolEnv_ResolveScan
    }

    // ------------------------------------------------------------------
    // VolEnv_ResolveScan — the shared parallel-array lookup behind both vol-env id
    // resolvers. Walks the id array comparing `a`, and on a hit reads the
    // same-index entry out of the parallel pointer array.
    // In:  a = 1-based env id, b = entry count, hl = ids array, de = ptrs array.
    // Out: carry clear + hl = body base on a match; carry set on an unknown id.
    //
    // NOT A GENERIC. Instantiating this per constant-set would emit two copies of
    // the scan, which is precisely the duplication being deleted — the whole point
    // is that ONE copy of the code serves both tables at runtime.
    // Only ONE head can fall through; PsgVolEnv_Resolve is placed immediately above
    // and takes it, and FmVolEnv_Resolve pays a 2-byte `jr` to get here. The
    // `falls_into` contract makes that placement machine-checked instead of a
    // comment that a later edit can quietly invalidate.
    // ------------------------------------------------------------------
    // Contract: out(hl) = body base + out(carry: found); clobbers a, b, de, f;
    // preserves c (untouched) + ix (inherited).
    pub proc VolEnv_ResolveScan () out(hl, carry: found) clobbers(a, b, de, f) preserves(c) {
    .scan:
        cp      (hl)
        jr      z, .found
        inc     hl                     // next id byte
        inc     de
        inc     de                     // next ptr (2 bytes)
        djnz    .scan
        scf                            // not found
        ret
    .found:
        ex      de, hl                 // hl = &ptr entry
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ex      de, hl                 // hl = body base
        or      a                      // carry clear
        ret
    }

    // ------------------------------------------------------------------
    // FmVolEnv_Resolve — map a 1-based FM vol-env id (a) to its body ptr (hl) via
    // the FmVolEnv_Ids/FmVolEnv_Ptrs parallel arrays (sound_tables_z80.emp, banked
    // $8000 window). The FM mirror of PsgVolEnv_Resolve: the same head shape with
    // the FM family's three constants, jumping to the shared scan (it cannot fall
    // through — PsgVolEnv_Resolve has that slot).
    // Out: carry clear + hl = body base on a match; carry set on an unknown id.
    // In: a = 1-based env id.
    // ------------------------------------------------------------------
    // Contract: out(hl) = body base + out(carry: found); clobbers a, b, de, f
    // (scan scratch); preserves c (untouched) + ix (inherited). The FM mirror of
    // PsgVolEnv_Resolve; the same `bc`-header over-claim (`c` survives).
    pub proc FmVolEnv_Resolve () out(hl, carry: found) clobbers(a, b, de, f) preserves(c) {
        ld      b, FMVOLENV_COUNT
        ld      hl, FmVolEnv_Ids       // banked table; label = its $8000-window ptr
        ld      de, FmVolEnv_Ptrs      // banked ptr array (entries are window ptrs)
        jr      VolEnv_ResolveScan
    }

    // ------------------------------------------------------------------
    // Psg_NoteOn — key a tone note on a PSG tone channel.
    // In:  ix = SeqChannel (PSG1..3), a = pitch index (0..94).
    // PsgDivisorTableZ[pitch] = 10-bit divisor (little-endian word). Emit:
    //   latch = $80 | (ch<<5) | (div & $0F)   then   data = (div >> 4) & $3F.
    // Then set the channel volume from sc_volume so the note is audible.
    // Sets SCF_KEYED.
    // ------------------------------------------------------------------
    // Contract: clobbers af, bc, de, hl; preserves ix (inherited — verified across
    // the calls + the `jp Psg_SetVolume` tail, each an ix-preserving callee).
    pub proc Psg_NoteOn () clobbers(af, bc, de, hl) {
        // hl = &PsgDivisorTableZ[pitch] = base + pitch*2
        ld      l, a
        ld      h, 0
        add     hl, hl                 // pitch*2 (word entries)
        ld      de, PsgDivisorTableZ   // banked table; label = its $8000-window ptr
        add     hl, de
        ld      e, (hl)                // e = divisor low byte
        inc     hl
        ld      d, (hl)                // d = divisor high byte (only D1-D0 used)
        // --- FINE DETUNE (spec §4): add the sign-extended sc_detune to the looked-up
        // tone divisor BEFORE the latch + emit, so vibrato/portamento inherit it. PSG
        // has no block — plain 16-bit add. NOTE the sign inversion vs FM: the divisor
        // is the PERIOD, so +detune LOWERS PSG pitch. sc_detune==0 -> byte-identical
        // skip. (hl = stale divisor-table ptr, no longer needed; clobber-safe.)
        ld      a, (ix+sc_detune)
        or      a
        jr      z, .no_detune
        ld      c, a
        add     a, a
        sbc     a, a
        ld      b, a                   // bc = sign-extended sc_detune
        ld      h, d
        ld      l, e
        add     hl, bc                 // divisor + detune
        // FLOOR GUARD (M5), same family and same shape as Psg_ApplyMod's. A NEGATIVE
        // detune on a small divisor underflows: the table's top 13 entries are $0001,
        // so a detune of -1 there reaches exactly 0 and anything beyond wraps to
        // $FFxx, which the emit path masks into a garbage low note. Clamp to 1 (the
        // same inaudible ~111.9 kHz floor), covering BOTH the wrapped-negative and
        // the exact-zero case — clamping only the negative half is precisely the bug
        // that shipped in Psg_ApplyMod. Unreachable with today's authored content (no
        // negative detune on top-octave PSG notes), so this is a guard, not a repair.
        // The no-detune path needs no clamp: PsgDivisorTableZ is generated with a
        // floor of 1, so the looked-up value alone can never be 0.
        bit     7, h
        jr      nz, .det_floor
        ld      a, h
        or      l
        jr      nz, .det_ok
    .det_floor:
        ld      hl, 1                  // clamp at the divisor floor
    .det_ok:
        ld      d, h
        ld      e, l
    .no_detune:
        // --- latch the base divisor for PSG pitch modulation (spec §5) ---
        // sc_base_freq holds (hi,lo) = (d,e); Psg_ApplyMod sums the vibrato/sweep
        // offset onto it each frame. Music + SFX PSG both latch now (sc_base_freq
        // exists on both structs at the same offset). hl still holds the divisor
        // table ptr (the stores below do not touch hl).
        ld      (ix+sc_base_freq), d
        ld      (ix+(sc_base_freq+1)), e
        // de = 10-bit divisor; latch it (shared with Psg_ApplyMod's re-latch).
        call    Psg_EmitDivisor        // write latch + data bytes

        // --- set the channel volume so the note sounds (re-reads sc_volume) ---
        set     SCF_KEYED_B, (ix+sc_flags)
        call    Psg_EnvCursorReset     // restart the vol-env contour on this attack
        // --- per-note pitch-mod re-arm (spec §5) — music + SFX PSG ---------------
        // Mod_ReArm clears accum + reloads steps for this fresh attack; it reads
        // sc_mod_*/sc_base_freq/sc_last_freq (latched above). No-op when
        // sc_mod_ctrl==0 (every un-modulated channel pays only one test).
        call    Mod_ReArm              // PSG pitch-mod re-arm (preserves bc/de/hl/ix)
        // --- PORTAMENTO note-on (PSG, spec §4): attack at sc_porta_accum + glide, or
        // snap accum = target. Reload from sc_porta_accum/sc_base_freq (Psg_EmitDivisor/
        // Mod_ReArm clobbered de). de = the start divisor (armed) for the no-rekey re-latch.
        ld      a, (ix+sc_porta_incr)
        or      (ix+(sc_porta_incr+1))
        jr      z, .porta_snap
        ld      d, (ix+sc_porta_accum)
        ld      e, (ix+(sc_porta_accum+1))
        ld      (ix+sc_last_freq), d
        ld      (ix+(sc_last_freq+1)), e
        call    Psg_EmitDivisor        // re-latch start divisor (no re-key); preserves hl,ix
        jr      .porta_done
    .porta_snap:
        ld      d, (ix+sc_base_freq)
        ld      e, (ix+(sc_base_freq+1))
        ld      (ix+sc_porta_accum), d
        ld      (ix+(sc_porta_accum+1)), e
    .porta_done:
        ld      a, (ix+sc_volume)
        jp      Psg_SetVolume          // (preserves ix; ret from there)
    }

    // ------------------------------------------------------------------
    // Psg_NoteOff — silence a PSG channel (tone OR noise) via its attenuation.
    // In:  ix = SeqChannel.  Clears SCF_KEYED.
    // Tone:  vol byte = $90 | (ch<<5) | $0F.   Noise: $F0 | $0F = $FF.
    // ------------------------------------------------------------------
    // Contract: clobbers af; preserves bc, de, hl (via Psg_ChBase's contract) + ix
    // (inherited).
    pub proc Psg_NoteOff () clobbers(af) preserves(bc, de, hl) {
        res     SCF_KEYED_B, (ix+sc_flags)
        ld      a, (ix+sc_route)
        cp      CHROUTE_PSGN
        jr      z, .noise
        call    Psg_ChBase             // a = ch<<5
        or      SND_PSG_VOL_LATCH      // $90 | (ch<<5)
        or      SND_PSG_ATTEN_SILENT   // | $0F  -> silent
        ld      (SND_Z80_PSG), a
        ret
    .noise:
        ld      a, SND_PSG_SILENCE_N   // $FF = noise vol, max attenuation
        ld      (SND_Z80_PSG), a
        ret
    }

    // ------------------------------------------------------------------
    // Psg_ApplyMod — one frame of PSG pitch modulation (spec §5). The PSG analogue
    // of Mod_ApplyVibrato: both call the SHARED Mod_Advance triangle core
    // (sound_sequencer.asm). The only difference is the WRITE TARGET: Mod_Advance
    // returns the modulated 16-bit word = sc_base_freq + sc_mod_accum, and here that
    // word is the PSG tone DIVISOR (10 bits used), re-latched WITHOUT re-keying.
    // Tone routes only (noise has no divisor).
    // In: ix = PSG TONE channel (SFX), sc_mod_ctrl != 0.
    // Falls into Psg_EmitDivisor (tail; no inserted jump — byte-critical).
    // ------------------------------------------------------------------
    // Contract: clobbers af, bc, de, hl; preserves ix (inherited — Mod_Advance
    // preserves it). falls_into Psg_EmitDivisor.
    pub proc Psg_ApplyMod () clobbers(af, bc, de, hl) falls_into Psg_EmitDivisor {
        call    Mod_Advance            // advance triangle; CF set => no write this frame
        ret     c
        // FLOOR GUARD (spec fix 4): a downward sweep can drive base+accum 16-bit
        // negative; the emit path masks the wrapped word into garbage divisor bits.
        // Clamp to 1, not 0 — divisor 0 is chip-ambiguous on the SN76489 family.
        // Divisor 1 = ~111.9 kHz (3579545/32), inaudible: a floored sweep goes
        // silent-high instead of wrapping to a wrong low note. (The UPWARD overflow
        // past $3FF is left as-is — S3K's zDoModulation wraps identically there.)
        //
        // The guard used to test `bit 7,d` ALONE, which catches only a NEGATIVE sum
        // and so contradicted the "clamp to 1, not 0" it is written under: an EXACT
        // ZERO passed straight through to the chip. Reachable, not theoretical —
        // PsgDivisorTableZ ships its top 13 entries as $0001, so a single step of
        // downward mod (accum -1) lands exactly on 0. Psg_EmitNoiseClock has always
        // done this correctly (or e / jr nz / inc e); this is that test, here.
        bit     7, d                   // negative 16-bit sum = the sweep underflowed
        jr      nz, .div_floor
        ld      a, d
        or      e                      // ... or an exact-zero sum (the missed case)
        jr      nz, .div_ok
    .div_floor:
        ld      de, 1                  // clamp at the divisor floor
    .div_ok:
        // de = modulated divisor (d=hi, e=lo). Re-latch via the shared emit helper
        // (no re-key — pitch only). Falls into Psg_EmitDivisor (tail), which rets.
    }

    // ------------------------------------------------------------------
    // Psg_EmitDivisor — write a 10-bit tone DIVISOR to the SN76489 tone register for
    // the current channel (latch + data bytes), WITHOUT keying/volume. Shared by
    // Psg_NoteOn (fresh note) and Psg_ApplyMod (per-frame pitch sweep) so the
    // divisor-split exists once.
    //   latch byte = $80 | (ch<<5) | (div & $0F);   data byte = (div >> 4) & $3F.
    // In: ix = PSG tone channel, d = div hi, e = div lo.
    // Falls into Psg_EmitDivisorTo (tail; c = latch base, de = divisor).
    // ------------------------------------------------------------------
    // Contract: clobbers a, c, f (latch scratch); preserves b, de, hl (de is
    // push/pop-bracketed across Psg_ChBase, hl via ChBase's contract, b untouched)
    // + ix (inherited). The `af, bc, de` header over-claims — de and b survive.
    // falls_into Psg_EmitDivisorTo.
    pub proc Psg_EmitDivisor () clobbers(a, c, f) preserves(b, de, hl) falls_into Psg_EmitDivisorTo {
        push    de                     // save divisor across Psg_ChBase
        call    Psg_ChBase             // a = ch<<5 ($00/$20/$40)
        or      SND_PSG_TONE_LATCH     // a = $80 | (ch<<5)
        ld      c, a                   // c = tone latch base
        pop     de                     // e = div lo, d = div hi
        // fall into Psg_EmitDivisorTo (c = latch base, de = divisor)
    }

    // ------------------------------------------------------------------
    // Psg_EmitDivisorTo — write a 10-bit divisor (d=hi, e=lo) to the PSG with the
    // latch BASE in c ($80|(ch<<5) for a tone channel; $C0 for the rate-3 noise
    // clock):
    //   latch = c | (div & $0F);   data = (div >> 4) & $3F.
    // Shared by Psg_EmitDivisor (tone), Psg_ApplyMod (pitch sweep) and
    // Psg_EmitNoiseClock so the divisor-split exists once.
    // ------------------------------------------------------------------
    // Contract: clobbers a, b, f (data-byte scratch); preserves c, de, hl (c is the
    // read-only latch base, de the read-only divisor, hl untouched) + ix (inherited).
    pub proc Psg_EmitDivisorTo () clobbers(a, b, f) preserves(c, de, hl) {
        ld      a, e
        and     $0F                    // div & $0F (freq low 4 bits)
        or      c                      // latch base | low nibble
        ld      (SND_Z80_PSG), a       // latch byte

        // data byte = (div >> 4) & $3F : div bits 9..4 (e>>4 | d<<4).
        ld      a, d
        add     a, a
        add     a, a
        add     a, a
        add     a, a                   // a = d << 4 (div bits 9..8 land in D5..D4)
        ld      b, a
        ld      a, e
        srl     a
        srl     a
        srl     a
        srl     a                      // a = e >> 4 = div bits 7..4
        or      b                      // a = ((d<<4)|(e>>4)) = (div >> 4)
        and     $3F                    // data byte is 6 bits
        ld      (SND_Z80_PSG), a       // data byte (freq high)
        ret
    }

    // ------------------------------------------------------------------
    // Psg_EmitNoiseClock — write a note's PSG divisor to tone-2's frequency latch
    // ($C0). In rate-3 noise mode ($x7/$x3) the SN76489 clocks the noise from
    // tone-2's frequency, so this sets the noise pitch/color. Divisor clamped >= 1
    // (hardware breaks the noise clock at tone-2 frequency 0). Writing $C0 does NOT
    // reset the LFSR.
    // In: a = pitch index 0..94.
    // ------------------------------------------------------------------
    // Contract: clobbers af, bc, de, hl; preserves ix (inherited — the
    // `jr Psg_EmitDivisorTo` tail preserves it and ix is untouched here).
    pub proc Psg_EmitNoiseClock () clobbers(af, bc, de, hl) {
        ld      l, a
        ld      h, 0
        add     hl, hl                 // pitch*2 (word entries)
        ld      de, PsgDivisorTableZ   // banked table; label = its $8000-window ptr
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                // de = 10-bit divisor
        ld      a, d
        or      e
        jr      nz, .nonzero
        inc     e                      // divisor 0 -> 1 (hardware clamp)
    .nonzero:
        ld      c, $C0                 // tone-2 frequency latch = the rate-3 noise clock
        jr      Psg_EmitDivisorTo
    }

    // ------------------------------------------------------------------
    // Psg_FoldAtten — fold one FM-TL-unit operand into the running PSG attenuation.
    //   c = min($0F, c + (a >> 3))
    // In: a = the operand in FM-TL units (0.75 dB/step, NONZERO — both call sites
    // fast-path a zero operand out before calling), c = running attenuation.
    // The >>3 converts TL units to the PSG's 4-bit ladder. Shared by the two
    // class-exclusive folds in Psg_SetVolume — the per-SFX sfh_gain and the
    // master-fade+duck total — which were two byte-identical copies of this block.
    // NOTE this is a TRUE SATURATING fold (cp $0F+1), unlike the vol-env fold in
    // Psg_SetVolume, which tests `bit 4` and therefore does NOT saturate. That
    // difference is why the two folds cannot be freely reordered; see the comment
    // at the env fold.
    // ------------------------------------------------------------------
    // Contract: out(c) = folded attenuation; clobbers af (a is the scratch, the
    // shifts/cp write f). preserves b, de, hl (+ ix inherited — leaf).
    pub proc Psg_FoldAtten () out(c) clobbers(af) preserves(b, de, hl) {
        srl     a
        srl     a
        srl     a                      // TL units >> 3 -> atten units
        add     a, c
        cp      SND_PSG_ATTEN_SILENT+1
        jr      c, .store
        ld      a, SND_PSG_ATTEN_SILENT  // clamp $0F (silent)
    .store:
        ld      c, a
        ret
    }

    // ------------------------------------------------------------------
    // Psg_SetVolume — set the channel attenuation from a linear volume.
    // In:  ix = SeqChannel (PSG1..3 OR PSGN), a = linear vol (0..127).
    // Tone:  emit $90 | (ch<<5) | atten.   Noise: emit $F0 | atten.
    // ------------------------------------------------------------------
    // Contract: clobbers af, bc, hl; preserves de (de survives via the callees'
    // contracts — Psg_VolToAtten/Snd_ChanClass/Psg_ChBase all preserve de) + ix
    // (inherited). hl is NOT preserved: Snd_ChanClass returns ix in it and no
    // caller needs it live across this routine (the one site that does —
    // Seq_HookSetVol's stream pointer, sound_sequencer.emp — brackets the call
    // itself), so the two push hl/pop hl pairs that used to honour the old claim
    // were pure cost. The .emp contract checker enforces this against every caller.
    pub proc Psg_SetVolume () clobbers(af, bc, hl) preserves(de) {
        call    Psg_VolToAtten         // a = 4-bit attenuation (clobbers b)
        ld      c, a                   // c = attenuation

        // --- Stage B sfh_gain (SFX slots only): +sx_gain>>3 in PSG atten units.
        // Mirrors the fade/duck fold's TL->atten (>>3) conversion below — the shared
        // Psg_FoldAtten. Music SeqChannels have no sx_gain -> gate on SFX class.
        // Gain 0 -> no-op (fast-pathed here, so the fold never sees a zero).
        call    Snd_ChanClass          // CARRY set => MUSIC
        jr      c, .no_sfx_gain
        ld      a, (ix+sx_gain)
        or      a
        jr      z, .no_sfx_gain
        call    Psg_FoldAtten          // c = min($0F, c + sx_gain>>3)
    .no_sfx_gain:

        // --- PSG volume envelope (spec §4): add the per-frame env atten delta ----
        // sc_psgenv_out is the S3K VolEnv delta (attenuation units, higher = quieter),
        // computed by PsgEnvUpdate. Add it BEFORE the duck fold and BEFORE the noise
        // branch (the noise route gets the contour too — the hi-hat). A channel with
        // no envelope has it = 0 -> the `or a / jr z` fast path skips the fold. Underflow
        // guard (S3K `bit 4,a`): if the sum sets bit 4 (>= $10) force $0F silent.
        //
        // ORDERING IS LOAD-BEARING HERE — do not hoist this fold past the two
        // class-exclusive folds around it to save a Snd_ChanClass call. `bit 4,a` is a
        // SINGLE-BIT test, not a magnitude test, so unlike Psg_FoldAtten this fold does
        // NOT saturate: a sum of $20..$2F leaves bit 4 clear and passes through, and a
        // later saturating fold would have clamped it while an earlier one would not.
        // Exhaustively enumerated over atten x env x operand: the two orderings differ
        // in 517440 of 1048576 cases (smallest witness: atten $00, env $11, operand
        // $78 -> $0F if env folds first, $20 if it folds second). They agree only while
        // every env body byte stays <= $10, which is true of today's authored content
        // but is NOT asserted anywhere yet. Reorder once that ceiling is build-enforced,
        // not before.
        ld      a, (ix+sc_psgenv_out)
        or      a
        jr      z, .env_done           // no env delta -> skip
        add     a, c                   // atten + env delta
        bit     4, a                   // >= $10 ?
        jr      z, .env_ok
        ld      a, SND_PSG_ATTEN_SILENT  // $0F (silent) clamp
    .env_ok:
        ld      c, a
    .env_done:

        // --- master fade + Phase 5a music ducking fold (music-only) --------------
        // Sum the GLOBAL master-fade scalar (SND_MASTER_FADE) and the SFX duck level
        // in carrier-TL units, map to PSG attenuation (>>3), and fold into the
        // attenuation so EVERY music volume write fades/ducks automatically. Clamp the
        // sum to $0F (silent) so it can't wrap — the shared Psg_FoldAtten does both the
        // >>3 and the clamp. A full fade ($7F TL) >>3 = $0F = silent; fade 0 + duck 0
        // -> byte-identical.
        call    Snd_ChanClass          // CARRY set => ix below the SFX page => MUSIC
        jr      nc, .no_global_atten   // SFX channel -> never fade/duck
        ld      a, (SND_SFX_DUCK_LEVEL)
        ld      b, a
        ld      a, (SND_MASTER_FADE)
        add     a, b                   // a = (duck + fade) in carrier-TL units
        or      a
        jr      z, .no_global_atten    // nothing to add (no fade, no duck)
        call    Psg_FoldAtten          // c = min($0F, c + (duck+fade)>>3)
    .no_global_atten:

        ld      a, (ix+sc_route)
        cp      CHROUTE_PSGN
        jr      z, .noise
        call    Psg_ChBase             // a = ch<<5
        or      SND_PSG_VOL_LATCH      // $90 | (ch<<5)
        or      c                      // | atten
        ld      (SND_Z80_PSG), a
        ret
    .noise:
        ld      a, SND_PSG_NOISE_VOL   // $F0
        or      c                      // | atten
        ld      (SND_Z80_PSG), a
        ret
    }

    // ------------------------------------------------------------------
    // Psg_Noise — handle a `note` on the noise route (CHROUTE_PSGN). Branches on
    // channel class because MUSIC and SFX encode the noise differently:
    //   MUSIC: the note is a real PITCH. The noise control byte was set ON-CHANGE by
    //     MEV_PSGNOISE (cached in sc_noise_mode); here, in rate-3 mode ($x7/$x3),
    //     write the note's divisor to tone-2's frequency latch ($C0) = the noise clock
    //     (S3K-faithful timbre that tracks the note), then set the noise volume. The
    //     PSG vol-env shapes each hit. Preset rates ($E4/$E5/$E6) ignore tone-2, so the
    //     $C0 write is skipped.
    //   SFX: legacy — the SFX transcoder drops smpsPSGform, so the note's low 3 bits
    //     ARE the mode/rate; write $E0|(note&7) as the control + set the noise volume.
    // In: ix = SeqChannel, a = note value. Sets SCF_KEYED.
    // ------------------------------------------------------------------
    // Contract: clobbers af, bc, de, hl; preserves ix (inherited — Snd_ChanClass,
    // the sub-calls, and the `jp Psg_SetVolume` tails all preserve ix).
    pub proc Psg_Noise () clobbers(af, bc, de, hl) {
        ld      b, a                   // save note (pitch/mode) — Snd_ChanClass clobbers a
        call    Snd_ChanClass          // CARRY set => MUSIC channel (preserves bc)
        jr      nc, .sfx
        // --- MUSIC noise: tone-2 clock (rate-3) + noise volume ---
        set     SCF_KEYED_B, (ix+sc_flags)
        call    Psg_EnvCursorReset     // retrigger the PSG vol-env (per-hit decay)
        ld      a, (ix+sc_noise_mode)
        and     3                      // rate bits (11 = clock from tone-2)
        cp      3
        jr      nz, .music_vol         // preset rate -> don't perturb tone-2's frequency
        ld      a, b                   // a = pitch
        call    Psg_EmitNoiseClock     // write the note's divisor to $C0 (clamped >=1)
    .music_vol:
        ld      a, (ix+sc_volume)
        jp      Psg_SetVolume          // noise volume ($F0) + envelope fold (preserves ix; ret)
    .sfx:
        ld      a, b                   // legacy: note low 3 bits = mode<<2 | rate
        and     7
        or      SND_PSG_NOISE_CTRL     // $E0 | (note & 7)
        ld      (SND_Z80_PSG), a       // noise control byte (stays latched)
        set     SCF_KEYED_B, (ix+sc_flags)
        call    Psg_EnvCursorReset
        ld      a, (ix+sc_volume)
        jp      Psg_SetVolume          // noise volume path (preserves ix; ret)
    }

    // ------------------------------------------------------------------
    // Psg_SilenceAll — emit the four PSG silence latches ($9F/$BF/$DF/$FF) so all
    // three tone channels + the noise channel go to max attenuation. Used by
    // Sequencer_StopAll (StopMusic, Task 6).
    // ------------------------------------------------------------------
    // Contract: clobbers af; preserves bc, de, hl (untouched) + ix (inherited).
    pub proc Psg_SilenceAll () clobbers(af) preserves(bc, de, hl) {
        ld      a, SND_PSG_SILENCE_T1  // $9F
        ld      (SND_Z80_PSG), a
        ld      a, SND_PSG_SILENCE_T2  // $BF
        ld      (SND_Z80_PSG), a
        ld      a, SND_PSG_SILENCE_T3  // $DF
        ld      (SND_Z80_PSG), a
        ld      a, SND_PSG_SILENCE_N   // $FF
        ld      (SND_Z80_PSG), a
        ret
    }
}
