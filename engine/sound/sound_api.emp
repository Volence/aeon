// ======================================================================
// engine/sound/sound_api.emp — 68k-side sound API (Phase 1)
// Posts commands into per-type Z80 RAM request slots. 68k access to Z80 RAM
// ($A00000+) is only valid while the Z80 bus is held — reads return garbage AND
// writes are silently ignored otherwise (confirmed real hardware, gen-hw.txt /
// plutiedev). So every transaction holds the bus, with interrupts masked so a
// VBlank stopZ80/startZ80 pair (the DMA window in ALL builds — vblank.asm — and
// the DEBUG state-mirror; neither nestable) can't release the bus mid-write. A single-byte slot is atomic under the bus hold, so there is no
// pending flag and no wait-idle spin (latest-wins, Flamedriver model).
// See docs/superpowers/specs/2026-06-16-sound-command-api.md.
//
// stop_z80()/start_z80() below are the engine macros (engine/macros.asm)
// as comptime-fn templates — each call site splices its own hygienic
// `.wait_z80` poll loop.
// ======================================================================
module engine.sound_api in sound_api

use engine.z80_bus.{stop_z80, start_z80}
use engine.irq.{sr_masked}

use engine.types.{SongId, SfxId}

// Immediate-position mirrors (kill-list row 10): values the immediates need
// at COMPTIME. EA-position slot ADDRESSES are not mirrored — those stay
// AS-owned (sound_constants.asm; the MUSIC_PARAM block floats with the Z80
// driver's RAM layout) and resolve through the link. Each mirror is
// drift-guarded against its AS-side truth.
const SND_ALIVE_MARKER  = $5A   // driver-alive handshake byte (sound_constants.asm)
const SND_MUSIC_STOP    = $FF   // SND_REQ_MUSIC stop sentinel (out of moveq's signed range)
const SND_FADE_CMD_OUT  = 1     // SND_REQ_FADE: ramp to silence
const SND_FADE_CMD_IN   = 2     // SND_REQ_FADE: snap silent, ramp to full
const SFX_RING_MASK     = $07   // pending-SFX ring cursor wrap (depth 8)
const SFXID_RING_RIGHT: SfxId = $33   // collect-ring SFX, right speaker (config/sound_ids.asm)
const SFXID_RING_LEFT: SfxId  = $34   // collect-ring SFX, left speaker

// DEBUG watchdog budget for the two Z80-handshake spins (Sound_PlayMusic's
// await_slot and Sound_Init's wait_alive). At ~15-20us per stop/probe/release
// iteration, $8000 iterations is ~250ms+ — orders of magnitude above any healthy
// slot-consumption or driver-boot latency, so only a genuinely wedged Z80 trips
// it. DEBUG-only: the counter + raise_error self-gate to zero bytes in plain,
// where the documented no-timeout tradeoff (a dead driver is a build/ROM fault)
// stands.
const SPIN_WATCHDOG_LIMIT = $8000

ensure(extern("SND_ALIVE_MARKER") == SND_ALIVE_MARKER, "SND_ALIVE_MARKER drifted from sound_constants.asm: {SND_ALIVE_MARKER}")
ensure(extern("SND_MUSIC_STOP") == SND_MUSIC_STOP, "SND_MUSIC_STOP drifted from sound_constants.asm: {SND_MUSIC_STOP}")
ensure(extern("SND_FADE_CMD_OUT") == SND_FADE_CMD_OUT, "SND_FADE_CMD_OUT drifted from sound_constants.asm: {SND_FADE_CMD_OUT}")
ensure(extern("SND_FADE_CMD_IN") == SND_FADE_CMD_IN, "SND_FADE_CMD_IN drifted from sound_constants.asm: {SND_FADE_CMD_IN}")
ensure(extern("SFX_RING_MASK") == SFX_RING_MASK, "SFX_RING_MASK drifted from sound_constants.asm: {SFX_RING_MASK}")
ensure(extern("SFXID_RING_RIGHT") == SFXID_RING_RIGHT, "SFXID_RING_RIGHT drifted from config/sound_ids.asm: {SFXID_RING_RIGHT}")
ensure(extern("SFXID_RING_LEFT") == SFXID_RING_LEFT, "SFXID_RING_LEFT drifted from config/sound_ids.asm: {SFXID_RING_LEFT}")

// 68k-side slot addresses (SND_Z80_BASE + Z80 offset), one equ per slot —
// link-folded sums over extern() reads, so the VALUES stay AS-OWNED
// (sound_constants.asm; the MUSIC_PARAM block derives from a Z80-driver RAM
// label and floats with every driver resize — nothing here to drift). The
// *_SLOT names are new (an equ re-spelling an AS name would collide in the
// shared link).
equ ALIVE_SLOT        = extern("SND_Z80_BASE") + extern("SND_STAT_ALIVE")
equ PING_SLOT         = extern("SND_Z80_BASE") + extern("SND_REQ_PING")
equ SAMPLE_SLOT       = extern("SND_Z80_BASE") + extern("SND_REQ_SAMPLE")
equ MUSIC_SLOT        = extern("SND_Z80_BASE") + extern("SND_REQ_MUSIC")
equ SFX_SLOT          = extern("SND_Z80_BASE") + extern("SND_REQ_SFX")
equ TEMPO_SLOT        = extern("SND_Z80_BASE") + extern("SND_REQ_TEMPO")
equ FADE_SLOT         = extern("SND_Z80_BASE") + extern("SND_REQ_FADE")
equ PARAM_BANK        = extern("SND_Z80_BASE") + extern("SND_MUSIC_PARAM_BANK")
equ PARAM_PTR_LO      = extern("SND_Z80_BASE") + extern("SND_MUSIC_PARAM_PTR")
equ PARAM_PTR_HI      = PARAM_PTR_LO + 1
equ PARAM_FLAGS       = extern("SND_Z80_BASE") + extern("SND_MUSIC_PARAM_FLAGS")
equ PARAM_PATCHPTR_LO = extern("SND_Z80_BASE") + extern("SND_MUSIC_PARAM_PATCHPTR")
equ PARAM_PATCHPTR_HI = PARAM_PATCHPTR_LO + 1

// The two song tables (games/sonic4 sound data; .emp-side under SIGIL_EMP_MT
// in the mixed build) — read as link-time imm32 sources below.
equ SONG_TABLE       = extern("SongTable")
equ SONG_PATCH_TABLE = extern("SongPatchTable")

// stop_z80/start_z80 come from the shared engine.z80_bus module (hoisted
// there when bg became the 2nd consumer; the macro↔template lockstep story
// lives with the module).

// z80_bank / z80_window — split a 68k ROM address into the two parts the Z80
// uses to read that ROM through its banked $8000 window: `bank` selects the
// $8000-byte page, `window` is the in-page pointer ORed with $8000. Same
// derivation the DacSample table bakes in at build time (see PlayMusic).
//   bank   = (addr & $7F8000) >> 15     (lsr.l #8 then #7 — >>15 in two steps)
//   window = (addr & $7FFF) | $8000
// Each moves {src} into {dst} first, then reduces {dst} in place.
comptime fn z80_bank(dst: Reg, src: Reg) -> Code {
    return asm {
        move.l  {src}, {dst}
        andi.l  #$7F8000, {dst}
        lsr.l   #8, {dst}
        lsr.l   #7, {dst}
    }
}
comptime fn z80_window(dst: Reg, src: Reg) -> Code {
    return asm {
        move.l  {src}, {dst}
        andi.l  #$7FFF, {dst}
        ori.l   #$8000, {dst}
    }
}

// ----------------------------------------------------------------------
// Sound_PostByte — write d0.b into the Z80 RAM request slot at (a0).
// In:  d0.b = value (nonzero = request, 0 = idle), a0 = 68k addr of the slot.
// Clobbers: SR restored; nothing else.
// ----------------------------------------------------------------------
pub proc Sound_PostByte (d0: u16, a0: *u8) clobbers() preserves(sr) {
        sr_masked(asm {
            {stop_z80()}
            move.b  d0, (a0)                // mask: no mirror-stopZ80 nesting
            {start_z80()}
        })
        rts
}

// ----------------------------------------------------------------------
// Sound_Init — block until the Z80 driver has finished its own init.
// The driver clears its slots + writes STAT_ALIVE during SndDrv_Init; the 68k
// must not post until that marker appears. Each probe holds the Z80 bus (the
// only way the 68k reads Z80 RAM reliably), THEN RELEASES it (startZ80 inside
// the loop) between probes so the Z80 can actually run and finish booting — a
// continuous hold would deadlock the handshake (the driver never runs, the
// marker never appears). No timeout in the plain shape: a driver that never
// boots hangs here forever — a chosen tradeoff (a dead sound driver is a
// build/ROM fault, not a runtime state worth recovering from). The DEBUG build
// adds a bounded SPIN_WATCHDOG_LIMIT counter that raise_errors on a wedge, so the
// otherwise-silent hang is loud under DEBUG.
// The marker byte is CAPTURED into d0 under the bus hold and compared AFTER
// start_z80: start_z80's bus-release write (move.w #0, Z80_BUS_REQUEST) sets the
// CCR, so a compare straddling the release would test the release's flags, not
// the marker — the loop condition must come from the captured register. The
// probe must still release the bus each iteration (the Z80 needs the bus to run
// and post the marker), so branch-before-release is not an option here.
// Clobbers: d0 (marker scratch), d1 (DEBUG watchdog counter); SR preserved.
// (boot calls this in post-boot setup where registers are free.)
// ----------------------------------------------------------------------
pub proc Sound_Init () clobbers(d0/d1) preserves(sr) {
        move.w  sr, -(sp)
        if DEBUG == 1 { move.l #SPIN_WATCHDOG_LIMIT, d1 }   // DEBUG watchdog budget
    .wait_alive:
        move.w  #$2700, sr
        stop_z80
        move.b  ALIVE_SLOT, d0                 // capture marker under the hold
        start_z80
        cmp.b   #SND_ALIVE_MARKER, d0          // test AFTER release (flags clean)
        if DEBUG == 1 {
            beq    .alive_go                    // marker present -> proceed to exit
            subq.l #1, d1                       // absent -> spend one iteration of budget
            bne    .wait_alive                  // budget remains -> keep probing
            raise_error "Sound_Init: STAT_ALIVE never posted - Z80 driver wedged?"
        .alive_go:
        }
        bne     .wait_alive
        move.w  (sp)+, sr
        rts
}

// ----------------------------------------------------------------------
// Sound_Ping — debug: ask the driver to echo d0.b into STAT_PING_ECHO.
// In:  d0.b = nonzero echo token value.
// ----------------------------------------------------------------------
pub proc Sound_Ping (d0: u16) clobbers(a0) {
        lea     PING_SLOT, a0
        jbra    Sound_PostByte
}

// ----------------------------------------------------------------------
// Sound_PlaySample — start DAC playback of a sample id.
// In:  d0.b = sample id (nonzero).
// ----------------------------------------------------------------------
pub proc Sound_PlaySample (d0: u16) clobbers(a0) {
        lea     SAMPLE_SLOT, a0
        jbra    Sound_PostByte
}

// ----------------------------------------------------------------------
// Sound_PlayMusic — start a song (Task 6 + Sound 1D). The 68k pre-derives the
// song's bank + $8000-window ptr from SongTable (its own ROM, read directly — no
// bus hold), reads the song's SH_FLAGS byte (the FIRST header byte at the song
// address) and the song's FM-patch-bank window ptr (from the parallel
// SongPatchTable), then posts the SND_MUSIC_PARAM block AND the SND_REQ_MUSIC
// trigger under ONE Z80 bus hold (param FIRST, trigger LAST) so the Z80 can't read
// a half-updated param block. The Z80's SND_REQ_MUSIC handler (in the VBlank ISR,
// DAC paused) banks the song in, streams it from ROM through the banked $8000
// window (every song streams — the copy path was deleted, budget A.1), and arms
// the sequencer. The flags are forwarded because the Z80 loader reads the
// adaptive-FM6 bit (SH_F_FM6_ADAPTIVE) from the param block during the header
// parse (SH_F_FM6_FM is materialized at pack time; never read at runtime).
// In:  d0.b = song id (1..SONG_COUNT).
// Clobbers: d0/d1/d2/d3/d4/a0/a1; SR restored.
// ----------------------------------------------------------------------
pub proc Sound_PlayMusic (d0: SongId) clobbers(d0-d4/a0-a1) preserves(sr) {
        // H-1 repost gate: a second Sound_PlayMusic landing while the Z80 is mid
        // Snd_LoadSong would tear the 6-byte param block AND lose this trigger (the
        // Z80 clears the slot after consuming the params). Spin until the previous
        // request is consumed (MUSIC_SLOT == 0) before touching the block. Common
        // case — no load in flight — the slot is already 0 and this falls straight
        // through. stop_z80 per iteration so the read is reliable AND the Z80 runs
        // between reads to actually clear the slot (a held bus would deadlock).
        // The slot byte is CAPTURED into d1 under the hold and tested AFTER
        // start_z80: the bus-release write sets the CCR, so the loop condition
        // must come from the captured register, not a test straddling the release.
        // See docs/superpowers/2026-07-16-sound-repost-gate-design.md.
    if DEBUG == 1 { move.l #SPIN_WATCHDOG_LIMIT, d4 }   // DEBUG watchdog budget
    .await_slot:
        stop_z80
        move.b  MUSIC_SLOT, d1                 // capture the slot under the hold
        start_z80
        tst.b   d1                             // test AFTER release (flags clean)
        if DEBUG == 1 {
            beq    .await_go                    // slot cleared -> proceed to exit
            subq.l #1, d4                       // still set -> spend one iteration of budget
            bne    .await_slot                  // budget remains -> keep spinning
            raise_error "Sound_PlayMusic: MUSIC_SLOT never cleared - Z80 wedged?"
        .await_go:
        }
        bne   .await_slot

        andi.l  #$FF, d0                    // d0 = song id (1-based)
        // a bad id indexes past SongTable[id-1] and
        // posts a garbage bank/window/patch block to the Z80 (it streams as
        // noise). Bounds the 1-based id against the game-owned SONG_COUNT (a link
        // symbol from games/sonic4/data/sound/song_table.asm). DEBUG-only; the
        // asserts self-gate to zero bytes in the plain shape.
        assert.w  d0, ne, #0                  // id != 0
        assert.w  d0, ls, #SONG_COUNT         // id <= SONG_COUNT
        move.l  d0, d2                      // d2 = song id (preserved for the trigger)
        subq.l  #1, d0                      // index = id-1
        lsl.l   #2, d0                      // *4 (dc.l entries)
        // --- song window ptr + flags from SongTable[id-1] ---
        movea.l #SONG_TABLE, a0
        adda.l  d0, a0
        movea.l (a0), a1                    // a1 = song 68k ROM address (dc.l)
        move.b  (a1), d3                    // d3.b = SH_FLAGS (header +0 = song address)
        z80_bank(d1, a1)                     // d1 = bank id (the $8000-page of the song)
        z80_window(d4, a1)                   // d4 = song window ptr (in-page, +$8000)
        // --- patch-bank window ptr from the parallel SongPatchTable[id-1]. The
        // patch bank shares the song's bank; the Z80 reads it through the same
        // $8000 window. window_ptr = (patch_addr & $7FFF) | $8000. ---
        movea.l #SONG_PATCH_TABLE, a0
        adda.l  d0, a0                      // d0 still = index*4
        movea.l (a0), a1                    // a1 = patch-bank 68k ROM address
        z80_window(d0, a1)                  // d0 = patch-bank window ptr (shares the song's bank)
        // --- post the param block + trigger under one bus hold (SR-masked so the
        // DEBUG mirror's stopZ80 can't nest and release the bus mid-write). ---
        sr_masked(asm {
            {stop_z80()}
            // param block FIRST. bank, song window_ptr (LE), flags, patch window_ptr (LE).
            move.b  d1, PARAM_BANK
            move.b  d4, PARAM_PTR_LO        // song window ptr low byte
            lsr.w   #8, d4
            move.b  d4, PARAM_PTR_HI        // song window ptr high byte
            move.b  d3, PARAM_FLAGS         // song SH_FLAGS byte
            move.b  d0, PARAM_PATCHPTR_LO   // patch window ptr low
            lsr.w   #8, d0
            move.b  d0, PARAM_PATCHPTR_HI   // patch window ptr high
            // trigger LAST: the song id (1..$FE) tells the Z80 a load is pending.
            move.b  d2, MUSIC_SLOT
            {start_z80()}
        })
        rts
}

// ----------------------------------------------------------------------
// Sound_PlaySFX — request an SFX by id. ENQUEUES it into the 68k-side Sfx_Ring_Buf;
// Sound_DrainSfxRing (GameLoop, post-VSync) drains ONE id/frame into the SND_REQ_SFX
// mailbox. Posting straight to the single mailbox byte meant a 2nd SFX
// requested in the SAME 68k frame clobbered the 1st before the Z80 (once/VBlank)
// consumed it — one was silently DROPPED, priority-blind. The ring + per-frame drain
// deliver BOTH to the Z80's downstream 3-deep priority queue (over 2 frames). A same-id
// dedup vs the most-recent pending entry suppresses a same-frame double-fire (keyed on
// EXACT id, so the L/R ring pair $33/$34 is never collapsed). This touches ONLY 68k
// RAM (no Z80 bus hold at call time -> less bus contention than the old direct post).
// In:  d0.b = sfx id (nonzero).
// Clobbers: d0 (the id — callers must treat it as consumed).
// Preserves: everything except d0. Under the exhaustive-license convention
//   (Volence-ratified 2026-07-12) a register NOT in the
//   clobber set is CONTRACTUALLY preserved and callers MAY rely on it — this is
//   what the S2-D6 checked-clobbers lint will verify. So a1, d2-d7, and SR are
//   guaranteed, not "incidental". preserves(d1/a0) adds movem-ENFORCED emphasis
//   on the two hot reliances, so the d0-only clobber survives even if the body
//   grows to touch d1/a0 (e.g. animate dropping BOTH saves around this call).
// ----------------------------------------------------------------------
pub proc Sound_PlaySFX (d0: SfxId) preserves(d1/a0) {
        tst.b   d0                          // defensive: id 0 = nothing to queue
        beq     .ps_ret
        movem.l d1/a0, -(sp)                // preserve d1 + caller's a0 (keep the d0-only contract)
        lea     Sfx_Ring_Buf, a0        // a0 = ring base
        // d1 is used as an (a0,d1.w) INDEX below, so its full low WORD must be
        // clean — `move.b` alone leaves the caller's bits 8-15 in d1.w and the
        // write lands up to $FF00 bytes past the ring (found live 2026-07-03:
        // the spindash-release caller leaves $09xx in d1, so its dash post
        // wrote to ring+$9xx — the id vanished and a stray byte hit unrelated
        // RAM; rev callers happened to leave d1 clean, masking the bug).
        // moveq clears the whole register before every byte-cursor load.
        moveq   #0, d1
        move.b  Sfx_Ring_Wr, d1         // d1 = Wr (index-safe: d1.w clean)
        cmp.b   Sfx_Ring_Rd, d1         // Wr == Rd -> ring empty -> no last entry, skip dedup
        beq     .ps_checkfull
        // --- same-id dedup vs the most-recent pending slot (Wr-1)&MASK ---
        subq.b  #1, d1
        and.w   #SFX_RING_MASK, d1          // d1 = last index (WORD mask: keep d1.w index-safe)
        cmp.b   (a0,d1.w), d0
        beq     .ps_drop                    // same id already pending -> skip (no double-fire)
        moveq   #0, d1
        move.b  Sfx_Ring_Wr, d1         // reload d1 = Wr (index-safe)
    .ps_checkfull:
        lea     (a0,d1.w), a0               // a0 = &Sfx_Ring_Buf[Wr]  (capture BEFORE Wr is bumped)
        addq.b  #1, d1
        and.b   #SFX_RING_MASK, d1          // d1 = nextWr (byte ops only from here: cmp.b + move.b commit)
        cmp.b   Sfx_Ring_Rd, d1         // nextWr == Rd -> ring full -> drop (>7 same-frame: never)
        // assert the ring-full "never"
        // claim (>7 DISTINCT SFX ids enqueued in one frame before the drain ran =
        // a content bug, keyed on EXACT id so the L/R pair is never collapsed).
        // DEBUG-only, and placed BEFORE the shared drop branch so the plain shape
        // stays byte-IDENTICAL — the whole block elides, no extra label ships in
        // the release ROM. Fires ONLY on the full path: the dedup-skip reaches
        // .ps_drop from earlier and never runs this cmp. RingBuffer_Add precedent.
        if DEBUG == 1 {
        bne     .ps_full_ok             // not full -> skip; the cmp's Z survives to the beq below
        raise_error "Sound_PlaySFX: SFX ring full (>7 in one frame)"
    .ps_full_ok:
        }
        beq     .ps_drop
        move.b  d0, (a0)                    // Sfx_Ring_Buf[Wr] = id  (data BEFORE pointer)
        move.b  d1, Sfx_Ring_Wr         // commit Wr = nextWr
    .ps_drop:
        movem.l (sp)+, d1/a0
    .ps_ret:
        rts
}

// ----------------------------------------------------------------------
// Sound_DrainSfxRing — post the next pending SFX id (Sfx_Ring_Buf) into SND_REQ_SFX,
// AT MOST ONE per frame, ONLY when the Z80 has cleared the previous (mailbox reads 0).
// Called once/frame from GameLoop right after VSync. The mailbox read-of-0 and the
// post are done inside ONE stopZ80/startZ80 bus hold (SR-masked, exactly like
// Sound_PostByte) so the Z80's once/VBlank consume cannot land between them. Empty ring
// is a fast no-op.
// Clobbers: d0/d1/a0. SR (precise contract): the
//   interrupt MASK is never altered on either path. The empty fast-path
//   (beq .dr_ret) saves no SR and leaves CCR clobbered (the cmp result) — cheaper,
//   and harmless to the only caller (GameLoop discards flags). The posting path
//   saves and restores the FULL SR around the mask. preserves(sr) marks that
//   posting-path save/restore — the load-bearing reliance: the DMA-window stopZ80
//   can't nest and corrupt the caller's mask. (S2-D7 CCR-liveness lint is the
//   deferred enforcement that would make the empty-path CCR clobber a checked fact.)
// ----------------------------------------------------------------------
pub proc Sound_DrainSfxRing () clobbers(d0, d1, a0) preserves(sr) {
        moveq   #0, d0                      // d0 is an (a0,d0.w) index below — clear the
                                            // caller's bits 8-15 (same class as the
                                            // Sound_PlaySFX index bug, found 2026-07-03)
        move.b  Sfx_Ring_Rd, d0
        cmp.b   Sfx_Ring_Wr, d0
        beq     .dr_ret                     // Rd == Wr -> ring empty -> nothing to drain
        move.w  sr, -(sp)
        move.w  #$2700, sr                  // mask ints (no mirror-stopZ80 nesting), like Sound_PostByte
        stop_z80
        tst.b   SFX_SLOT   // mailbox still holds a pending id?
        bne     .dr_done                    // yes -> Z80 not consumed; leave Rd, just release the bus
        lea     Sfx_Ring_Buf, a0
        move.b  (a0,d0.w), d1               // d1 = next pending id (d0 = Rd)
        move.b  d1, SFX_SLOT   // post it — still inside the same bus hold
        addq.b  #1, d0
        and.b   #SFX_RING_MASK, d0
        move.b  d0, Sfx_Ring_Rd         // advance Rd (slot consumed)
    .dr_done:                               // ONE startZ80, reached z80-stopped from both paths
        start_z80
        move.w  (sp)+, sr
    .dr_ret:
        rts
}

// ----------------------------------------------------------------------
// Sound_PlayRing — collect-ring SFX with internal L/R alternation. Toggles
// Ring_Sfx_Speaker each call, posting SFXID_RING_RIGHT or _LEFT.
// In: none. Clobbers: d0 (tightened from d0/a0:
//   the body never touches a0, and the Sound_PlaySFX tail-callee preserves it
//   ENFORCED, so a0 is contractually preserved through the tail-call). SR restored.
// ----------------------------------------------------------------------
pub proc Sound_PlayRing () clobbers(d0) {
        move.b  Ring_Sfx_Speaker, d0
        eori.b  #1, d0
        move.b  d0, Ring_Sfx_Speaker
        beq     .left
        moveq   #SFXID_RING_RIGHT, d0 as SfxId   // born SfxId at the literal; the moveq degrades, the bless re-types
        jbra    Sound_PlaySFX
    .left:
        moveq   #SFXID_RING_LEFT, d0 as SfxId    // ditto — SfxId into Sound_PlaySFX's d0 slot
        jbra    Sound_PlaySFX
}

// ----------------------------------------------------------------------
// Sound_StopMusic — stop the song (Task 6). Posts the $FF stop sentinel into
// SND_REQ_MUSIC (single bus-held byte, like Sound_PostByte). The Z80 handler
// key-offs every FM channel, silences PSG, and clears the sequencer-active
// flag. Timer A keeps running — it is the whole-driver frame clock (SFX + DAC
// refill hang off it). (The 1B DAC keeps running — DAC is owned by 1B.)
// Clobbers: d0, a0; SR restored.
// ----------------------------------------------------------------------
pub proc Sound_StopMusic () clobbers(d0, a0) {
        move.b  #SND_MUSIC_STOP, d0         // $FF (out of moveq's signed range)
        lea     MUSIC_SLOT, a0
        jbra    Sound_PostByte
}

// ----------------------------------------------------------------------
// Sound_SetTempo — ramp the global music speed to a target. d0.b = target tempo mod
// (S3K TempoWait units: raw per-frame accumulator addend; 0 = full speed / tick
// every frame, BIGGER = SLOWER — each accumulator carry skips one event-tick;
// rate = (256-mod)/256), or SND_TEMPO_RESTORE ($FF) to return to the song's
// authored header tempo. The CALLER supplies d0.b (this does NOT set it, like
// Sound_Ping / Sound_PlaySample); d0 preserved. SR restored.
// ----------------------------------------------------------------------
pub proc Sound_SetTempo (d0: u16) clobbers(a0) {
        lea     TEMPO_SLOT, a0
        jbra    Sound_PostByte
}

// ----------------------------------------------------------------------
// Sound_FadeOut — ramp the music master volume down to silence (~1s). The song keeps
// playing; the game typically follows with Sound_StopMusic when silent. Music-only
// (SFX stay full). Clobbers: d0, a0; SR restored.
// ----------------------------------------------------------------------
pub proc Sound_FadeOut () clobbers(d0, a0) {
        move.b  #SND_FADE_CMD_OUT, d0
        lea     FADE_SLOT, a0
        jbra    Sound_PostByte
}

// ----------------------------------------------------------------------
// Sound_FadeIn — snap the master volume to silence and ramp it up to full (~1s). Use
// right after Sound_PlayMusic to fade a song in. Clobbers: d0, a0; SR restored.
// ----------------------------------------------------------------------
pub proc Sound_FadeIn () clobbers(d0, a0) {
        move.b  #SND_FADE_CMD_IN, d0
        lea     FADE_SLOT, a0
        jbra    Sound_PostByte
}
