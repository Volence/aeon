// The resident FM/PSG writers scan these tables COUNT entries deep. The count
// is the emitted byte span of the id-list (one `db` per env), measured at
// comptime by `span(...)`, so the resident scan count and the emitted table
// can never drift. seam-1's `sound_tables_authority_consts` reads them here.
pub const PSGVOLENV_COUNT = span(PsgVolEnv_Ids)
pub const FMVOLENV_COUNT  = span(FmVolEnv_Ids)
