// ===========================================================================
// engine/sound/dac_sample_tab.emp — the DAC sample descriptor table
// (1-based id → 12-byte DacSample descriptor).
// ===========================================================================
// The .emp port of dac_sample_tab.asm (this directory). 10 descriptors: ids
// 1=temp_blip 2=kick 3=snare 4=hat, then the 6 S3K HCZ2 drums (5=s3k_kick ..
// 10=s3k_floortom, matching tools/smps_import.py HCZ2_DAC_REMAP). Each 12-byte
// descriptor is db ds_bank / db ds_rate / db ds_codec / dw ds_ptr / dw ds_length
// / dw ds_loop_ofs / db ds_vol / dw ds_mix_rsvd (the DacSample struct in
// sound_constants.emp; grown 9->12 by the 2026-07-03 ratification insurance —
// ds_vol + mix-cursor reserve appended so no existing offset moves, v1 engine
// ignores all three). rate/loop_ofs are 0 (the 1B FILL loop drives the rate;
// one-shot). ds_codec = 0 (raw 8-bit PCM; the reserved codec-selector slot).
// vol/mix_rsvd are 0 (reserved for a future mixer).
//
// All bank/ptr/len cells are the build-time SND_* constants from
// data/sound/dac_samples.emp — COMPTIME values, read here as comptime ints. They
// are byte/word data cells, not link addresses: a width-1 `db` cannot carry a
// link symbol in a Z80 section (the un-windowed-pointer guard), and these ARE
// constants, so they fold to literals. The size invariant is drift-guarded
// against the engine's DacSample_len / DAC_SAMPLE_COUNT via `extern(...)` below.
//
// BANKED at the engine-table head of the song/SFX bank — placed by the
// `soundBankHead` macro (engine/sound/sound_bank.inc — DELETED in 1afa9aa; the
// contract is now games/<game>/map.toml's `sound_bank` anchor + soundbankhead.emp), which is the contract
// now; the old `cpu z80 / phase 08000h` block in main.asm that this comment
// used to name is gone. Being banked, it costs ZERO against the resident
// Z80-code ceiling. The table label equals its $8000-window pointer
// (Snd_DacLookup's pointer math is unchanged).
//
// PLACEMENT CONSTRAINT — this table must be readable under the SONG bank, NOT a
// DAC sample bank: the descriptor fields are read by Snd_StartSample
// (z80_sound_driver.asm), whose $E2 call context runs MID-Sequencer_Frame where
// the window holds SND_SONG_BANK and MUST stay there (a switch corrupts the rest
// of that frame's song-stream reads — the B2 stash-only rule). The DAC samples
// themselves span TWO banks (blip bank != drums bank), so there is no single
// "sample bank" to host the table anyway; each descriptor's ds_bank names its
// payload bank and the B1/B3/B4 brackets latch it for the FILL.
//
// BANK GUARANTEES at the read sites (both == THIS bank today):
//   * $E2 (Seq_HookDac → Snd_StartSample): window = SND_SONG_BANK (B1), and
//     every song lives in this bank (song_table.asm asserts).
//   * mailbox SND_REQ_SAMPLE (SndDrv_PollMailbox → Snd_StartSample): the sample
//     block does an explicit SetBank(SND_ENGINE_TABLE_BANK) before the lookup
//     (this path has no ambient guarantee — streaming ticks leave the sample
//     bank in the window, cold-boot ISRs bank 0).
// ===========================================================================

module engine.dac_sample_tab (cpu: z80)

// The size invariant reads the engine's DacSample stride + descriptor count from
// the sound-constants authority. The seam-2 DAC-head co-link seeds these two as
// comptime `-D` (sourced from `sound_constants.emp` — the same one-authority path
// the resident blob folds its consts through), so the guard folds at COMPTIME.
use engine.sound_constants.{DAC_SAMPLE_COUNT, DacSample_len}

// The table emits 10 descriptors of 12 bytes (db,db,db,dw,dw,dw,db,dw) = 120 bytes.
// `span(DacSampleTable)` folds the EMITTED byte span of the table body at
// comptime, so this guard catches BOTH the engine's declared count × stride
// drifting AND this body emitting the wrong NUMBER of descriptors — the LHS is a
// measured length, not a hand literal. (`span` is the comptime emitted-span
// primitive; it reads this same-module pure-data proc's lowering.)
ensure(span(DacSampleTable) == DAC_SAMPLE_COUNT * DacSample_len,
       "DacSampleTable emitted span disagrees with DAC_SAMPLE_COUNT × DacSample_len")

// Pure data table — the proc emits only `db`/`dc.w` cells and touches no
// register, so `clobbers()` is the honest empty contract.
section dac_sample_tab (cpu: z80, vma: $8000) {
    pub proc DacSampleTable () clobbers() {
        // id 1 = temp_blip
        dc.b    SND_BLIP_BANK           // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (codec selector; 0 = raw 8-bit PCM)
        dc.w    SND_BLIP_PTR            // ds_ptr (little-endian dw)
        dc.w    SND_BLIP_LEN            // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 2 = kick
        dc.b    SND_KICK_BANK           // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_KICK_PTR            // ds_ptr
        dc.w    SND_KICK_LEN            // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 3 = snare
        dc.b    SND_SNARE_BANK          // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_SNARE_PTR           // ds_ptr
        dc.w    SND_SNARE_LEN           // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 4 = hat
        dc.b    SND_HAT_BANK            // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_HAT_PTR             // ds_ptr
        dc.w    SND_HAT_LEN             // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // --- S3K HCZ2 drums (Phase 5; ids match tools/smps_import.py HCZ2_DAC_REMAP) ---
        // id 5 = s3k_kick
        dc.b    SND_S3K_KICK_BANK       // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_S3K_KICK_PTR        // ds_ptr
        dc.w    SND_S3K_KICK_LEN        // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 6 = s3k_snare
        dc.b    SND_S3K_SNARE_BANK      // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_S3K_SNARE_PTR       // ds_ptr
        dc.w    SND_S3K_SNARE_LEN       // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 7 = s3k_hitom
        dc.b    SND_S3K_HITOM_BANK      // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_S3K_HITOM_PTR       // ds_ptr
        dc.w    SND_S3K_HITOM_LEN       // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 8 = s3k_midtom
        dc.b    SND_S3K_MIDTOM_BANK     // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_S3K_MIDTOM_PTR      // ds_ptr
        dc.w    SND_S3K_MIDTOM_LEN      // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 9 = s3k_lowtom
        dc.b    SND_S3K_LOWTOM_BANK     // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_S3K_LOWTOM_PTR      // ds_ptr
        dc.w    SND_S3K_LOWTOM_LEN      // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
        // id 10 = s3k_floortom
        dc.b    SND_S3K_FLOORTOM_BANK   // ds_bank
        dc.b    0                       // ds_rate (reserved)
        dc.b    0                       // ds_codec (raw 8-bit PCM)
        dc.w    SND_S3K_FLOORTOM_PTR    // ds_ptr
        dc.w    SND_S3K_FLOORTOM_LEN    // ds_length
        dc.w    0                       // ds_loop_ofs (reserved; 0 = one-shot)
        dc.b    0                       // ds_vol (reserved; v1 ignored)
        dc.w    0                       // ds_mix_rsvd (reserved; v1 ignored)
    }

    // --- Head-tail 8-alignment pad (package 3 fix, 2026-08-10) ---
    // This table is the LAST engine-table head in the sound bank; the MT song
    // bank packs immediately after it, and the SFX block after that. The SFX
    // block's base must land ≡ 0 (mod 8): the placement chainer 8-aligns that
    // section's base while seam-2's sound_layout fold packs contiguously — at
    // a misaligned base every baked SfxTable pointer cell (and every
    // SfxBlobWinTab window pointer) comes out short of the placed blobs
    // (plain SFX went silent at -2 when this table's 9->12 growth flipped the
    // tail parity; a mod-4-only pad still came out -4 — the placed base moved
    // $5BB0C -> $5BB10, pinning the quantum at 8, with the old working bases
    // $5BAE8/$5D558 ≡ 0 mod 8 excluding 16). The alignment is enforced in two
    // comptime steps: THIS pad rounds the head total to ≡ 0 (mod 8) (so the
    // MT bank — whose seam-2 lowering baseline assumes an aligned section
    // base — starts ≡ 0 mod 8 at the 8-aligned $58000 map anchor), and
    // mt_bank.emp's tail pad keeps the MT total ≡ 0 (mod 8). A source
    // `align` CANNOT do this job here: seam-2 lowers these modules against
    // baseline/vma positions that differ from final placement, so `align`'s
    // pad count comes out wrong (its D2.29 link-time congruence assert
    // catches it loudly — that is how this was learned). Comptime pad size
    // instead: the four heads before this table are FIXED-size
    // ($357+$108+$10E+$40 = $5AD, each individually walled in
    // soundbankhead.emp, which also walls the head total % 8 == 0 — the loud
    // tripwire if this prefix ever drifts), so the pad self-adjusts to any
    // DacSampleTable growth (the S3K drum kit next).
    ensure(DAC_HEAD_PAD < 8, "DAC head pad must be 0..7")
    data DacHeadPad_a = if DAC_HEAD_PAD >= 1 { byte(0) } else { Data.empty }
    data DacHeadPad_b = if DAC_HEAD_PAD >= 2 { byte(0) } else { Data.empty }
    data DacHeadPad_c = if DAC_HEAD_PAD >= 3 { byte(0) } else { Data.empty }
    data DacHeadPad_d = if DAC_HEAD_PAD >= 4 { byte(0) } else { Data.empty }
    data DacHeadPad_e = if DAC_HEAD_PAD >= 5 { byte(0) } else { Data.empty }
    data DacHeadPad_f = if DAC_HEAD_PAD >= 6 { byte(0) } else { Data.empty }
    data DacHeadPad_g = if DAC_HEAD_PAD >= 7 { byte(0) } else { Data.empty }
}

// The fixed-size head prefix before this table (soundbankhead.emp walls each
// piece) + the pad formula: round the head total up to the next multiple of 8.
// NOTE the third term is the SfxBlobWinTab span, which is SFX_TABLE_LEN*2 and so
// MOVES whenever the SFX id range grows. $10E -> $112 when $BA/$BB extended the
// range to $BB (2 more cells = 4 bytes). It is spelled as a literal rather than
// read from the win-tab because this is the DAC head's own arithmetic and the
// soundbankhead walls cross-check every term; if the two ever disagree the
// head-total %8 wall below fires loudly rather than silently mis-padding.
const DAC_HEAD_PREFIX = $357 + $108 + $112 + $40   // = $5B1
const DAC_HEAD_PAD = (8 - ((DAC_HEAD_PREFIX + DAC_SAMPLE_COUNT * DacSample_len) % 8)) % 8
