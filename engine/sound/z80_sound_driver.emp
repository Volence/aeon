// ===========================================================================
// engine/sound/z80_sound_driver.emp — Z80-autonomous DAC streaming driver
// (MegaPCM-2 model: free-running, every-path-equal-cost streaming loop)
// ===========================================================================
// The TOP of the sound stack and the LAST Z80 CODE file — the CANONICAL, only
// source (no .asm twin). Assembled INLINE inside the 68k ROM at `phase 0`: this
// file DEFINES the blob origin ($0000) every downstream sound file's base is
// measured from — seam-1 derives each later module's base from a running cursor
// over the preceding spans, so no section here declares a `vma:` and no base
// address is written down. Native-linked via seam-1 (emit_sound_blob): the five
// sound `.emp` files link as one Z80 module set and the whole-ROM byte gate
// proves both shapes.
//
// --- SHAPE VARIANCE: same SIZE both shapes, but NOT byte-identical -----------
// The driver has ZERO internal __DEBUG__ content, so its own code is
// shape-invariant in SIZE and POSITION ($0000, the origin) in BOTH shapes. But it
// is NOT byte-identical across shapes: five `call` sites target callees that
// live AFTER the sequencer's +$7E debug growth (Sequencer_StopAll / Sfx_StopAll /
// SfxDispatch all shift +$7E in the debug shape), so those call operands differ
// plain vs debug. Sequencer_Frame (immediately after the driver) is the one
// shape-INVARIANT external target. seam-1 therefore links each shape at its own
// per-shape addresses and gates BOTH shapes (the two blobs are NOT equal bytes).
//
// --- HARDWARE / TIMING CONTRACTS (C3 audit surface) ------------------------
//   * de = $4001 (YM2612 part-I DATA port) is held INVARIANT for the whole
//     driver lifetime: the steady-state DAC write is `ld (de),a` (7 cyc), never
//     an ix-indexed write. Re-established at scattered points (init; every tick/
//     idle/startsample reloads `ld de, SND_Z80_YM_A1`); the re-establishment is
//     too scattered for a clean module-register invariant, so it is a
//     hardware-contract PROSE fact here, not a checkable register invariant.
//   * Reg $2A stays parked on the $4000 ADDR port so every `ld (de),a` writes
//     DAC data; it is re-parked at every path that writes a non-$2A reg to $4000 —
//     init, the idle loop, the Timer-A tick, .stop, Snd_StartSample, Snd_LoadSong,
//     and the Timer-A programs (ProgramFixed/Rearm). A YM address-port latch is not
//     a Z80 register, so no register-contract class expresses it — PROSE.
//   * di/ei lattice: the streaming loop runs `di` for the WHOLE sample. The
//     load-bearing claim — "the once-per-frame /INT never lands in the long di
//     window, so the VBlank ISR does not fire during streaming; the Timer-A tick
//     services the mailbox instead" — is a real-time /INT-edge argument the
//     assembler cannot evaluate. So di/ei carry NO contract-clause surface; they
//     live here as C3 hardware-timing prose (a di/ei-balance lint would check the
//     trivial half while giving false confidence about the unmodelable half).
//   * RESIDENT-CODE / BANKED-DATA discipline: only DATA tables live in the banked
//     $8000 window; all in-frame CODE stays RAM-resident (banked in-frame code would
//     fetch opcodes through a bus-contended window — the corpus resident-code rule,
//     stated in sound_sequencer.emp, not a driver-.asm claim). The .asm-BACKED half
//     is the DacSampleTable BANK CONTRACT: the driver's one banked reader is
//     Snd_StartSample's 5-byte descriptor read, valid only while the caller holds the
//     engine-table bank in the window; the ring-lead budget absorbs its latency.
//
// --- ix PRESERVATION (per-proc, NOT a module invariant) --------------------
// UNLIKE psg/fm, the driver has NO module-scope `invariant: preserves(ix)`: it
// CLOBBERS ix in SndDrv_Sample (ROM window ptr), SndDrv_TimerATick (reloads ix),
// Snd_LoadSong (ix = SeqChannel ptr), and transitively in SndDrv_IdleTick /
// SndDrv_ISR. A module invariant would (correctly) fire on all of them. So
// `preserves(ix)` is declared PER-PROC only where the checker can verify it
// (Snd_StartSample's push/pop ix; SetBank / RouteClassFlags / the command procs
// never touch ix). This mirrors sound_sequencer.emp's explicit per-proc shape.
//
// --- THE CYCLE-BALANCE PROOF (rung 4: T-states, C1's first Z80 subject) -----
// The register-resident 1:1 streaming loop is the sample clock: every pass emits
// ONE ring byte to the YM DAC and costs the IDENTICAL Z80 cycles regardless of
// path, so the output rate is rock-steady and load-independent. The three hot
// paths are selected with `jp cc` (constant 10 cyc taken OR not — never `jr cc`,
// 12/7, which would itself be jitter). The header's balance arithmetic is now a
// CHECKED comptime fact — the three `ensure(cycles(...))` at the tail of
// SndDrv_Sample (self-gating to ZERO emitted bytes):
//   FILL (steady state)   = 195   consumer 22 + poll 30 + phase 30 + DMA 27 +
//                                 FILL body 44 + shadow len-- 22 + exit 20.
//                                 SND_LOOP_CYC 195 -> 3579545/195 = 18356 Hz.
//   DRAIN (68k DMA active) = 195   prefix 109 + `rept 19/nop` body 86; the nop
//                                 pad EXISTS to equal FILL (lead recovered at tick).
//   DRAINING_TAIL (PHASE 2)= 194   prefix 82 + tail body 112; 1 cyc under FILL,
//                                 tail-only -> accepted-inaudible.
// The `jp`-not-`jr` hot-path discipline is now a COMPILE ERROR: a `jr cc`/`djnz`
// inside a `cycles()` span fires `[cycles.ambiguous-branch]` (the hot-loop `jp cc`s
// are STRUCTURAL width pins — the cycles ensures ARE the pin). NOT modeled (stay
// prose): cartridge-bus contention (the ~3.3-cyc banked-ROM penalty on FILL's
// `ld a,(ix+0)`, silicon-only, "noted, not padded"); interrupt latency; 68k bus
// arbitration; the Timer-A tick's off-hot-path cost; whole-CFG bounds.
//
// INHERENT PITCH ASYMMETRY (silicon-only, accepted): the ~3.3-cyc banked-ROM bus
// penalty lands ONLY on FILL's `ld a,(ix+0)`; DRAIN and DRAINING read no ROM, so
// they never pay it. FILL's true period is therefore ~195+3.3 cyc while DRAIN/
// DRAINING run at 195/194 -> during a 68k DMA (DRAIN) or the sample tail (DRAINING)
// the output pitch runs SHARP vs the FILL steady state: DRAIN ~29 cents
// (1200*log2(198.3/195)), DRAINING ~38 cents (1200*log2(198.3/194)). It CANNOT be
// padded out (matching the penalty on DRAIN would require the ROM read DRAIN must
// avoid while the 68k holds the bus), it is silicon-only (Exodus does not model
// cartridge-bus contention), and it is transient (DRAIN spans only a DMA window,
// DRAINING only the buffered tail) -> ACCEPTED, not fixed.
//
// --- INBOUND CALLEES THIS DRIVER DEFINES -----------------------------------
// Four symbols the sibling sound modules `use`-import from this driver:
// SndDrv_SetBank + Snd_RouteClassFlags (sound_sfx) and Snd_StartSample +
// Snd_DacLookup (sound_sequencer). The importer's credit is DERIVED from the def
// below (its declared clauses, clobbers-complemented), so there is no separate
// caller-side decl to drift from the definition.
// ===========================================================================

module engine.z80_sound_driver (cpu: z80)

// The cross-file resident callees this driver calls, resolved by import.
// Sequencer_Frame is the only shape-invariant target; the other three
// shift +$7E in the debug shape. SndDrv_IdleTick relies on Sequencer_Frame
// preserving iy (its definition clobbers af/bc/de/hl/ix — iy untouched).
// The YM2612 address->data spacing floor in Z80 T-states. MUST equal
// sound_fm.emp's YM_ADDR_TO_DATA_MIN_T, where the derivation and the
// measurement convention are documented. It is re-declared per module rather
// than shared because seam-1 injects only a FIXED authority list of constants
// from sound_constants.emp (a new name added there is invisible to the resident
// modules), and a `use` clause imports procs, not consts.
const YM_ADDR_TO_DATA_MIN_T = 8

// --- Game-feel seam mirrors (pkg 1). The seam-1 const list is FIXED (see the
// file header): a NEW sound_constants.emp name is invisible here, so each new
// contract address/value is a module-local const derived from an INJECTED
// anchor by the same chain the authority uses. sound_constants.emp pins the
// absolute values (SND_PAUSED == $1CD3, SND_STAT_SEQ_ACTIVE == $1F15), so an
// authority layout move fails THERE, loudly, before these could drift.
const SND_REQ_CTRL         = SND_REQ_PING + $07       // $1F07: transport ctrl slot
const SND_REQ_JINGLE       = SND_REQ_PING + $08       // $1F08: jingle push slot
const SND_STAT_SEQ_ACTIVE  = SND_STAT_DAC_ACTIVE + 1  // $1F15: SND_SEQ_ACTIVE mirror
const SND_STAT_COMM        = SND_STAT_DAC_ACTIVE + 2  // $1F16: score-authored cue byte
const SND_STAT_JINGLE      = SND_STAT_DAC_ACTIVE + 3  // $1F17: SND_JINGLE_ACTIVE mirror
const SND_STAT_FADE_BUSY   = SND_STAT_DAC_ACTIVE + 4  // $1F18: fade-ramp off-target flag
const SND_PAUSED           = SND_TEMPO_BASE + 1       // $1CD3: 0 run / 1 music / 2 all
const SND_JINGLE_ACTIVE    = SND_TEMPO_BASE + 2       // $1CD4: nonzero while a jingle plays
const SND_JINGLE_ID        = SND_TEMPO_BASE + 3       // $1CD5: the pushed jingle's SFX id
const SND_FADE_TERM        = SND_TEMPO_BASE + 4       // $1CD6: composed fade terminal (0/1/2)
ensure(SND_PAUSED == $1CD3 && SND_STAT_SEQ_ACTIVE == $1F15,
       "game-feel seam mirrors drifted off the pinned authority addresses")
// Transport / fade command values (authority: sound_constants.emp, same fixed-
// list constraint). SND_FADE_CMD_IN is injected; its siblings are mirrored.
const SND_CTRL_PAUSE_MUSIC   = 1
const SND_CTRL_UNPAUSE_MUSIC = 2
const SND_CTRL_PAUSE_ALL     = 3
const SND_CTRL_UNPAUSE_ALL   = 4
const SND_PAUSED_MUSIC       = 1
const SND_PAUSED_ALL         = 2
const SND_FADE_CMD_OUT_STOP  = 3                      // composed: out + StopMusic
// R4 fade-rate model: SND_FADE_DELAY_CTR is repurposed as the ROTATING
// spread-bit rate pattern (the authority documents this at its definition).
const SND_FADE_PATTERN       = SND_FADE_DELAY_CTR
const SND_FADE_PAT_DEFAULT   = $FF                    // rate 7: step every frame
// Jingle auto-pop resume: the frozen song re-enters under a short fade-in
// starting at this attenuation (ramps to 0 at the default rate).
const JINGLE_RESUME_FADE     = $28

use engine.sound_sequencer.{Sequencer_Frame, Sequencer_StopAll, Seq_SilenceMusicVoices}
use engine.sound_sfx.{Sfx_StopAll, SfxDispatch, Sfx_UnpauseRestore}

section z80_sound_driver (cpu: z80) {

    // --- reset vector + IM1 VBlank vector --------------------------------
    // $0000: jump over the vector region into init. The Genesis asserts the Z80
    // /INT once per VBlank; with `im 1` the CPU does RST 38h, vectoring to $0038.
    // AS `phase` only relocates label addresses (it does not emit the gap bytes),
    // so the $0038 vector is reached by zero-filling $0003..$0037 with real bytes
    // ($00) that the boot loader copies — the vector then physically lands at
    // $0038 (filled by the explicit 53-byte fill below).
    // The blob-internal reset-vector entry at the phased VMA $0000. Named
    // Z80_Sound_Entry, NOT Z80_Sound_Start: the 68k symbol `Z80_Sound_Start` is the
    // blob's LMA ($3DE) — owned by boot_data.emp (the boot copy + layout-assert
    // wall read it there), never at VMA $0000. Reusing that name here would name the same point in
    // two address spaces and collide at the native link. Reached by the Z80 reset,
    // never by symbol. Non-returning: `jp SndDrv_Init` runs the whole driver, so it
    // clobbers everything transitively (the contract is vacuous — no caller returns).
    @noreturn
    proc Z80_Sound_Entry () clobbers(af, bc, de, hl, ix, iy) {
        jp      SndDrv_Init             // $0000-$0002
    }

    // $0003..$0037: zero-fill so the RST-38h VBlank vector lands at $0038
    // (53 bytes; $00 = the Z80 NOP opcode — dead space, never executed).
    data SndDrv_VectorGap: [u8; 53] = [
        $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
        $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
        $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00,
        $00, $00, $00, $00, $00,
    ]

    // $0038: RST 38h / IM1 VBlank vector -> the minimal VBlank ISR (mailbox poll).
    // `jp SndDrv_ISR` folds its callee's clobbers: SndDrv_ISR destroys ix/iy (the
    // idle context holds none live across `ei`, so the ISR need not save them).
    pub proc SndDrv_VBlank () clobbers(ix, iy) {
        jp      SndDrv_ISR
    }

    // --- entry -----------------------------------------------------------
    // The driver runs WITH interrupts: `im 1` vectors the VBlank /INT to RST 38h
    // ($0038) where the MINIMAL ISR polls the mailbox and returns. DMA survival is
    // the producer's DRAIN path (gated on the 68k's SND_CTRL_DMA_ACTIVE flag), not
    // the ISR's job. `ei` is issued only AFTER the ring is primed. Falls into the
    // IDLE loop.
    @noreturn
    pub proc SndDrv_Init () clobbers(af, bc, de, hl, ix, iy) falls_into SndDrv_Idle {
        di
        im      1                       // VBlank /INT -> RST 38h -> $0038
        ld      sp, SND_STACK_TOP       // stack top $1FFE (z80-ram-map spec)

        // BOOT-WINDOW GARBAGE (B1). boot.asm loads this blob INSTEAD of the
        // RAM-clearing idle program, so the SfxChannel array, the two duck bytes
        // and the SeqChannels are POWER-ON GARBAGE until the first Snd_LoadSong.
        // Sequencer_Frame falls through to .run_sfx even with SND_SEQ_ACTIVE=0, so
        // Sfx_Frame would walk 7 garbage channels every frame from the first tick
        // after `ei` — garbage SCF_ACTIVE means stream interpretation over random
        // pointers, i.e. possible wild chip and bank-latch writes, and the garbage
        // duck folds into every pre-song volume write. Sfx_StopAll clears exactly
        // that state (active bits, priorities, queue count, both duck bytes) and
        // costs the same 3 bytes as the `ld (SND_SFX_QUEUE_CNT),a` it replaces
        // below. Emulators zero RAM at power-on, so the oracle can NEVER show this.
        //
        // MUST STAY ABOVE THE `ld de` BELOW. Sfx_StopAll clobbers de (it loads
        // SeqChannel_len/SfxChannel_len into it to stride the arrays). Moving this
        // call down into the store block — where the cleared byte it replaces used
        // to live — would leave de = 68 instead of $4001, pointing every
        // steady-state `ld (de),a` DAC write at Z80 RAM $0044. Silent, total.
        // It also RMWs garbage sc_flags on the SeqChannels (clearing only
        // SCF_SFX_OVERRIDE_B and leaving other garbage bits set); harmless while
        // SND_SEQ_ACTIVE=0 and SND_SEQ_CHCOUNT=0, and Snd_LoadSong wipes the
        // channel block wholesale before it raises either.
        call    Sfx_StopAll             // returns a = 0 (its own trailing xor a)

        // de = $4001 = YM2612 part-I DATA port. Held INVARIANT for the whole
        // driver lifetime (steady-state DAC write is `ld (de),a`, 7 cyc).
        ld      de, SND_Z80_YM_A1       // de = $4001 (DATA port)

        // YM ready: wait for busy flag (bit7 of $4000) to clear.
        ld      hl, SND_Z80_YM_A0       // hl = $4000 (ADDR/status port)
    .wait_ym:
        bit     7, (hl)
        jr      nz, .wait_ym

        // HARDWARE LFO ENABLE ONCE: $22 = $08 (LFO on, freq 0 = 3.82 Hz). The
        // YM's GLOBAL low-freq oscillator drives every channel's AMS/FMS depth
        // bits (each patch's $B4); without this master switch those bits are inert.
        // Written BEFORE the addr port parks on $2A below.
        ld      (hl), SND_REG_LFO       // $4000 = $22 (select LFO reg)
        ld      a, $08                  // LFO enable (bit3) + freq 0 (= 3.82 Hz)
        ld      (de), a                 // $4001 = $08

        // DAC ENABLE ONCE: $2B = $80 (DAC mode on), then SELECT $2A once, then
        // PRIME the $2A latch to $80 (DC center). After this the addr port stays
        // parked on $2A forever, so every `ld (de),a` writes DAC data. $2B is
        // NEVER toggled again (no per-play enable edge -> no click).
        ld      (hl), SND_REG_DAC_ENABLE // $4000 = $2B (select DAC-enable reg)
        ld      a, $80
        ld      (de), a                 // $4001 = $80 -> DAC mode ON
        ld      (hl), SND_REG_DAC_DATA  // $4000 = $2A (select DAC DATA reg — parked here)
        ld      a, $80
        ld      (de), a                 // $4001 = $80 -> prime latch to DC center

        // Clear the driver's RAM contract regions — four rolled Snd_ZeroBlock
        // sweeps (pkg-1 reclaim: replaces ~30 individual stores):
        //   $18F0-$18FC  DAC/bank/ring state (phase, banks, RD/WR ptrs, FM6;
        //                SND_CUR_BANK is re-seeded $FF below)
        //   $1F00-$1F08  request slots + the SND_CTRL_DMA_ACTIVE flag bracket
        //   $1F10-$1F18  status region (STAT_ALIVE re-written at the end of init)
        //   $1CCC-$1CD6  fade/tempo globals + game-feel state (pkg 1)
        // (SND_SFX_QUEUE_CNT is cleared by the Sfx_StopAll call above, along with
        // the SfxChannel array and both duck bytes — see the B1 note.)
        ld      hl, SND_DAC_PHASE       // $18F0: the DAC/bank state block
        ld      b, SND_FM6_ADAPTIVE - SND_DAC_PHASE + 1
        call    Snd_ZeroBlock
        ld      hl, SND_REQ_PING        // $1F00: request slots + DMA flag
        ld      b, SND_REQ_JINGLE - SND_REQ_PING + 1
        call    Snd_ZeroBlock
        ld      hl, SND_STAT_ALIVE      // $1F10: status region
        ld      b, SND_STAT_FADE_BUSY - SND_STAT_ALIVE + 1
        call    Snd_ZeroBlock
        ld      hl, SND_MASTER_FADE     // $1CCC: expression globals + game-feel
        ld      b, SND_FADE_TERM - SND_MASTER_FADE + 1
        call    Snd_ZeroBlock
        xor     a
        ld      (SND_SEQ_ACTIVE), a     // sequencer idle until a song loads
        ld      (SND_SEQ_CHCOUNT), a    // no channels until a song loads
        ld      (Snd_SpindashRev), a    // spindash rev escalation starts at 0
        // R4: the fade rate pattern is ALWAYS a valid spread byte (never 0 — a
        // zero pattern would never step). Seed the default; Snd_FadeCommand
        // re-latches it per command.
        ld      a, SND_FADE_PAT_DEFAULT
        ld      (SND_FADE_PATTERN), a

        // PRE-FILL the whole 256-byte ring with $80 so the idle/lead-in output is
        // DC-center silence (no click, no garbage). (The ring RD/WR pointers and
        // SND_STAT_DAC_ACTIVE were zeroed by the state-block sweep above.)
        ld      hl, SND_RING_BASE
        ld      b, 0                    // 256 bytes (b=0 -> djnz runs 256x)
        ld      a, $80
    .fill_ring:
        ld      (hl), a
        inc     hl
        djnz    .fill_ring

        // Seed the SetBank cache with an impossible bank id ($FF) so the first
        // play's SetBank always switches (the cached-no-op check never matches).
        ld      a, $FF
        ld      (SND_CUR_BANK), a

        // announce we are alive.
        ld      a, SND_ALIVE_MARKER
        ld      (SND_STAT_ALIVE), a

        // program Timer A to the FIXED frame rate ONCE (SND_TIMERA_N -> ~59.92 Hz),
        // region-independent, NOT a per-song tempo selector. The DAC/idle-loop
        // Timer-A overflow poll fires Sequencer_Frame once per frame.
        call    Snd_TimerA_ProgramFixed

        ei                              // state consistent -> allow the VBlank IRQ
        // falls into the IDLE loop
    }

    // --- IDLE loop -------------------------------------------------------
    // DAC inactive. NOT cycle-balanced (it is silence). Keeps the `ei` window
    // alive so the VBlank ISR's mailbox poll can flip DAC_ACTIVE=1 and start a
    // sample. Feeds $80 (DC center) on each ~59 Hz tick so the output never clicks
    // while idle. de=$4001 and reg $2A stay selected. MUST ALSO poll Timer A so
    // the SEQUENCER ticks while the DAC is silent (a song whose first DAC trigger
    // is its $E2 needs a tick to run before the DAC starts). On overflow: rearm +
    // tick, then re-check DAC_ACTIVE to enter the streaming loop.
    @noreturn
    pub proc SndDrv_Idle () clobbers(af, bc, de, hl, ix, iy) {
        di
        ld      a, (SND_STAT_DAC_ACTIVE)
        or      a
        jr      z, .stay_idle           // DAC idle -> run the idle body below
        // B4: a mailbox/ISR armed a sample (Snd_StartSample stashed SND_ROM_BANK).
        // Latch the sample bank on the idle->streaming entry so the first FILL
        // reads the right bank (usually a cached no-op — the arming ISR already
        // latched it on exit).
        ld      a, (SND_ROM_BANK)
        call    SndDrv_SetBank          // B4: enter streaming on the sample bank
        jp      SndDrv_Sample           // sample armed -> enter streaming loop
    .stay_idle:
        // Timer-A poll (sequencer tick clock while idle).
        ld      a, (SND_Z80_YM_A0)      // YM status ($4000): bit0 = Timer A overflow
        and     SND_TIMERA_OVF_MASK
        jr      z, .idle_settled        // no tick -> DAC latch holds $80, $2A parked
        call    SndDrv_IdleTick         // overflow -> rearm + Sequencer_Frame
        // A tick ran: Sequencer_Frame's writes moved the $4000 addr latch, so
        // re-park $2A and re-assert DC center ONCE here. Between ticks the DAC
        // latch holds $80, so re-writing $80 every idle spin would be pure
        // VGM-logger flood; gating the write to the ~59 Hz tick keeps DC-center
        // silence and lets the VGM capture stay faithful.
        call    Snd_ParkDac             // re-select $2A on the ADDR port ($4000)
        ld      a, $80
        ld      (de), a                 // DAC <- $80 (DC center silence)
    .idle_settled:
        ei                              // VBlank IRQ may land here (between samples)
        jp      SndDrv_Idle
    }

    // Idle-context Timer-A frame: rearm + run the per-frame engine, then restore
    // de=$4001 (Sequencer_Frame clobbers de). Returns to the idle loop, which
    // re-checks DAC_ACTIVE at the top so a $E2-armed sample enters streaming next.
    // Clobbers iy: Run_SeqFrame_OnSongBank -> Sequencer_Frame -> Sfx_Frame destroys
    // it (safe — the idle context holds no live iy).
    pub proc SndDrv_IdleTick () clobbers(af, bc, de, hl, ix, iy) {
        call    Snd_TimerA_Rearm        // clear overflow, keep counting, re-park $2A
        call    Run_SeqFrame_OnSongBank // B1: frame on song bank, restore sample bank
        ld      de, SND_Z80_YM_A1       // restore de = $4001 (DAC DATA port invariant)
        ret
    }

    // --- SndDrv_Sample — the free-running, every-path-equal-cost streaming loop.
    // ONE straight-line iteration per sample (see the balance proof in the file
    // header). Live registers across iterations: ALL streaming state (de=$4001,
    // h=ring page, c=RD, b=WR, ix=ROM ptr, hl'=ROM len) is held in registers for
    // the whole sample. Safe WITHOUT per-pass spills because the loop runs `di`
    // end to end and the VBlank ISR does not fire during streaming — only the
    // Timer-A tick interrupts it, and that tick spills/reloads these registers
    // itself around Sequencer_Frame. Non-returning loop entry; clobbers broadly.
    @noreturn
    pub proc SndDrv_Sample () clobbers(af, bc, de, hl, ix, iy) {
        // ENTRY (from SndDrv_Idle once a sample is armed): load the streaming
        // state into REGISTERS, held across every pass. Register map (held all
        // streaming; the Timer-A tick spills->RAM / reloads around Sequencer_Frame):
        //   de = $4001 (DAC data)      h  = SND_RING_PAGE ($19, ring page)
        //   c  = ring RD   b = ring WR   ix = ROM window ptr   hl' (shadow) = ROM len
        di
        ld      de, SND_Z80_YM_A1       // de = $4001 (DAC data port; held all streaming)
        ld      h, SND_RING_PAGE        // h  = $19 (ring page; held all streaming)
        ld      a, (SND_RING_RD)
        ld      c, a                    // c = ring RD
        ld      a, (SND_RING_WR)
        ld      b, a                    // b = ring WR
        ld      ix, (SND_ROM_PTR)       // ix = ROM window ptr
        exx
        ld      hl, (SND_ROM_LEN)       // hl' = ROM len (shadow set)
        exx

    .loop:
        // CONSUMER: emit ring[rd] -> $2A ($4001). NO per-sample $2A re-select; the
        // addr port stays parked on $2A. RAM ring read — DMA-safe.
        ld      l, c                    // l = RD (h = $19)
        ld      a, (hl)                 // ring[rd]
        ld      (de), a                 // -> YM $2A DATA ($4001)
        inc     c                       // RD++

        // TIMER-A poll (the sequencer-tick clock; the only thing that pauses
        // streaming, for one Sequencer_Frame + bulk-refill, once per ~59 Hz frame).
        ld      a, (SND_Z80_YM_A0)      // YM status: bit0 = Timer A overflow
        and     SND_TIMERA_OVF_MASK
        jp      nz, SndDrv_TimerATick   // overflow -> tick (spill/frame/refill/reload), rejoin
    export .afterPoll:
        // DRAINING_TAIL? (PHASE==2: producer exhausted, emit the buffered tail).
        ld      a, (SND_DAC_PHASE)
        cp      2
        jp      z, .draining
    .dma_check:                         // cycles() span cut label (zero bytes)
        // 68k DMA in progress? -> DRAIN (consumer keeps emitting from the RAM ring;
        // the producer must NOT read ROM while the 68k holds the bus).
        ld      a, (SND_CTRL_DMA_ACTIVE)
        or      a
        jp      nz, .drain
    .fill_body:                         // cycles() span cut label (zero bytes)
        // FILL one RAW 8-bit byte: ROM(ix) -> ring[wr]; WR++, ROM++, len-- (1:1).
        ld      a, (ix+0)               // raw 8-bit sample (banked $8000 window)
        ld      l, b                    // l = WR
        ld      (hl), a                 // ring[wr] = sample
        inc     b                       // WR++
        inc     ix                      // ROM++
        exx
        dec     hl                      // len-- (shadow)
        ld      a, h
        or      l
        exx
        jp      z, .exhaust             // len == 0 -> enter DRAINING_TAIL
        jp      .loop

    .exhaust:
        // Producer done: switch to DRAINING_TAIL (emit the buffered lead, no more
        // ROM). One-shot per sample — the small extra cost is not rate-critical.
        ld      a, 2
        ld      (SND_DAC_PHASE), a      // PHASE = 2 (DRAINING_TAIL)
        jp      .loop

    // DRAINING_TAIL (PHASE==2): the producer exhausted; the consumer (loop top)
    // just emitted a buffered tail byte. Stop once the lead drains to 0.
    // Register-resident (b=WR, c=RD; lead = WR-RD). Padded ~to the FILL pass
    // (194 vs 195) — tail-only, so the 1-cyc rounding is inaudible. Pad reg-safe
    // (a dead; ix/hl' unused while draining).
    .draining:
        ld      a, b                    // WR
        sub     c                       // lead = (WR - RD) & $FF
        jp      z, .stop                // lead 0 -> fully drained -> stop
    .draining_pad:                      // cut label: prefix|pad boundary for the derived pad
        // DERIVED timing pad -> DRAINING = 194 (FILL - 1). measured non-pad
        // cost = prefix cycles(.loop,.dma_check)=82 + this body pre-pad
        // cycles(.draining,.draining_pad)=18 + trailing jp .loop=10 = 110;
        // pad = 194-110 = 84 T. DENSE: 84/12 = 7 unconditional `jr` (12 T in 2 B
        // each), no nop remainder -> 14 B instead of 21 nops. Same T-total, and the
        // `.draining` ensure below re-measures it, so the pitch stays build-proven.
        pad_to_cycles(194, cycles(.loop, .dma_check) + cycles(.draining, .draining_pad) + 10, dense: true)
        jp      .loop

    .stop:
        // One-shot terminal event (once per sample). DC-center the DAC, clear
        // active, PHASE=idle, return to the idle loop (which re-enables interrupts).
        // RD/WR are final (lead 0); the next Snd_StartSample re-primes them in RAM.
        call    Snd_ParkDac             // re-park $2A on $4000 (OUTSIDE the cycles span:
                                        // .stop is the span END label, so this body is excluded)
        ld      a, $80
        ld      (SND_Z80_YM_A1), a      // $2A = $80 (DC center silence)
        // Layer 7 adaptive: hand ch6 back to FM6 music. ORDER MATTERS (click
        // avoidance): $2A is ALREADY centered ($80), so disabling the DAC now flips
        // ch6 to FM with no DC step. Then re-key FM6's held note so music resumes
        // ($28=$F6 is a real 0->1 EG edge). Re-key ONLY if FM6 holds a note
        // (SCF_KEYED) — a rest stays silent. Gated on SND_FM6_ADAPTIVE.
        ld      a, (SND_FM6_ADAPTIVE)
        or      a
        jr      z, .stop_done
        ld      a, SND_REG_DAC_ENABLE   // $2B
    .stop_dacoff_addr:
        ld      (SND_Z80_YM_A0), a
        xor     a
    .stop_dacoff_data:
        ld      (SND_Z80_YM_A1), a      // $2B = $00 -> ch6 returns to FM (output was centered)
        ld      ix, (SND_FM6_CHAN_PTR)
        push    ix
        pop     hl
        ld      a, h
        or      l
        jr      z, .stop_repark         // no FM6 channel (defensive) -> just re-park $2A
        bit     SCF_KEYED_B, (ix+sc_flags)
        jr      z, .stop_repark         // FM6 resting -> leave it silent
        ld      a, SND_REG_KEY_ONOFF    // $28 (key on/off, part I)
    .stop_rekey_addr:
        ld      (SND_Z80_YM_A0), a
        ld      a, SND_FM_KEYON_OPMASK|6 // $F0 | chsel(FM6 = $06) = $F6 -> key ON (all ops)
    .stop_rekey_data:
        ld      (SND_Z80_YM_A1), a      // real 0->1 edge -> EG re-attacks FM6's held note
    .stop_repark:
        call    Snd_ParkDac             // re-park $2A on $4000 (the FM writes moved the addr port)
    .stop_done:
        xor     a
        ld      (SND_STAT_DAC_ACTIVE), a // clear active
        ld      (SND_DAC_PHASE), a      // PHASE = idle (0)
        jp      SndDrv_Idle             // idle loop re-enables interrupts

    // DRAIN (68k DMA in progress): the consumer already emitted at the loop top;
    // the producer must NOT read ROM while the 68k holds the bus. Pad to the FILL
    // pass (195) so the rate never jitters during a DMA; the lead burned here is
    // recovered by the Timer-A tick's bulk-refill. Pure nop pad (reg-safe).
    .drain:
        // DERIVED timing pad -> DRAIN = 195 (== FILL). measured non-pad cost =
        // prefix cycles(.loop,.fill_body)=109 + trailing jp .loop=10 = 119;
        // pad = 195-119 = 76 T (the lead is recovered at the tick). DENSE:
        // 76/12 = 6 unconditional `jr` (12 T in 2 B each) + 76%12/4 = 1 nop -> 13 B
        // instead of 19 nops. Same T-total; the `.drain_end` ensure below re-measures
        // it. Reg-safe like the nop pad (a `jr` writes no register and no flag).
        pad_to_cycles(195, cycles(.loop, .fill_body) + 10, dense: true)
        jp      .loop
    .drain_end:                         // cycles() span cut label (zero bytes)

        // --- CYCLE-BALANCE PROOF as CHECKED comptime facts (zero emitted bytes).
        // FILL is one clean fall-through span; DRAIN/DRAINING share the loop-top
        // prefix and add a separate body (Finding 4). The `jp cc` constant cost
        // makes every span a plain straight-line sum; a `jr cc`/`djnz` in any span
        // fires [cycles.ambiguous-branch] (the jp-not-jr hot-path pin).
        ensure(cycles(.loop, .exhaust) == 195, "FILL streaming pass must be 195 T-states (the sample clock)")
        // DRAIN = prefix 109 (consumer+poll+phase+DMA-taken) + `rept 19/nop` body 86.
        ensure(cycles(.loop, .fill_body) + cycles(.drain, .drain_end) == 195, "DRAIN pass must equal FILL (195 T-states)")
        // DRAINING_TAIL = prefix 82 (consumer+poll+phase-taken) + tail body 112.
        ensure(cycles(.loop, .dma_check) + cycles(.draining, .stop) == 194, "DRAINING_TAIL pass must be 194 T-states (FILL - 1, tail-only)")

        // --- YM address->data spacing, machine-checked (Task 9.2) --------------
        // The `.stop` epilogue writes the YM DIRECTLY (not through Fm_YmWrite), so
        // the funnel's ensures do not cover it. Both pairs sit AFTER `.stop`, which
        // is the END label of the DRAINING span above, so these labels add nothing
        // to any timed hot-path span (and, being labels, no bytes either).
        ensure(cycles(.stop_dacoff_addr, .stop_dacoff_data) >= YM_ADDR_TO_DATA_MIN_T,
               "DAC stop $2B disable: address->data gap is under the YM2612 floor")
        ensure(cycles(.stop_rekey_addr, .stop_rekey_data) >= YM_ADDR_TO_DATA_MIN_T,
               "DAC stop $28 FM6 re-key: address->data gap is under the YM2612 floor")
    }

    // --- SndDrv_ISR — minimal VBlank ISR (RST 38h $0038 -> jp here). Mailbox poll
    // ONLY, then ei/ret. NO draining (the 68k flag bracket handles DMA survival
    // via the producer's DRAIN path). Preserves af/bc/de/hl via push/pop (it
    // interrupts the main/idle loop). It does NOT save ix/iy, and PollMailbox DOES
    // clobber them — SAFE for two reasons: (1) the IDLE loop holds NO live ix/iy
    // across its `ei`; (2) the SAMPLE loop DOES hold live ix/hl' but runs `di` end
    // to end, so the ISR never fires during streaming (the Timer-A tick services
    // the mailbox there instead, spilling/reloading ix + the hl' shadow itself).
    // INVARIANT: idle-context loop code must never keep a live ix/iy across `ei`.
    pub proc SndDrv_ISR () clobbers(ix, iy) preserves(af, bc, de, hl) {
        push    af
        push    bc
        push    de
        push    hl
        // B3: poll the mailbox bank-transparently. The VBlank IRQ services the
        // mailbox while the driver is IDLE; SndDrv_TimerATick services it during
        // DAC streaming (the IRQ does NOT fire then). Same helper from both so the
        // bank-transparency is identical.
        call    Snd_PollMailbox_Banked
        // The per-frame engine (Sequencer_Frame) is driven ONLY by the Timer-A
        // overflow poll -> SndDrv_TimerATick/SndDrv_IdleTick (not from here).
        pop     hl
        pop     de
        pop     bc
        pop     af
        ei
        ret
    }

    // --- Snd_PollMailbox_Banked — run SndDrv_PollMailbox bank-transparently.
    // PollMailbox may SetBank (a song load, an SFX-blob dispatch, or a mailbox
    // sample re-stash all bank the $8000 window). On return, leave the window
    // banked for the caller's resumed context: the SAMPLE bank (SND_ROM_BANK) if a
    // DAC sample is streaming — which a mid-stream cross-bank retrigger may have
    // just changed to a NEW bank, so we must NOT blindly restore the pre-call bank
    // — otherwise (idle/song context) the pre-call bank. Both restores are cached
    // (no-op if unchanged). Called from BOTH the VBlank ISR (idle context) and
    // SndDrv_TimerATick (streaming context). Clobbers af,bc,de,hl,ix (PollMailbox's
    // set) + iy transitively via Snd_LoadSong.
    pub proc Snd_PollMailbox_Banked () clobbers(af, bc, de, hl, ix, iy) {
        ld      a, (SND_CUR_BANK)
        push    af                      // save the pre-call bank
        call    SndDrv_PollMailbox      // RAM + $6000 latch only -> DMA-safe (may SetBank)
        pop     af                      // a = saved pre-call bank
        ld      c, a                    // stash it
        ld      a, (SND_STAT_DAC_ACTIVE)
        or      a
        ld      a, c                    // default (DAC idle): the pre-call bank
        jr      z, .pmb_restore
        ld      a, (SND_ROM_BANK)       // DAC streaming: the (possibly new) sample bank
    .pmb_restore:
        jp      SndDrv_SetBank          // tail-call (cached); leaves the window banked
    }

    // --- SndDrv_PollMailbox — act on any nonzero request slot, then clear it.
    // Reached via Snd_PollMailbox_Banked from the VBlank ISR (idle) AND the
    // Timer-A tick (streaming). Does NOT read ROM directly (the SFX-blob/song-load
    // sub-paths read it through the $8000 window — the banked wrapper + the ring
    // lead handle that). Clobbers de; the callers save/restore de=$4001.
    pub proc SndDrv_PollMailbox () clobbers(af, bc, de, hl, ix, iy) {
        // ping request? echo the value back.
        ld      a, (SND_REQ_PING)
        or      a
        jr      z, .no_ping
        ld      (SND_STAT_PING_ECHO), a // echo the request value
        ld      hl, SND_REQ_PING
        call    Snd_AckSlot             // clear slot (consumed) + bump ACK_COUNT
    .no_ping:
        // music request? (1..$FE play SongTable[id-1], $FF stop).
        ld      a, (SND_REQ_MUSIC)
        or      a
        jr      z, .no_music            // 0 -> nothing pending
        cp      SND_MUSIC_STOP          // $FF -> stop
        jr      z, .music_stop          // in range (.music_stop is 5 B ahead)
        call    Snd_LoadSong            // 1..$FE -> load + arm the song (clears the slot)
        jr      .after_music
    .music_stop:
        // Timer A stays RUNNING: it is the whole-driver frame clock, not the music
        // clock. An idle tick with SND_SEQ_ACTIVE=0 is a cheap early-out.
        // STOP WINS (pkg 1 spec §4 edge): a stop while paused clears the pause
        // (and any jingle/terminal bookkeeping) — otherwise the next song would
        // start frozen, or a dead jingle would phantom-pop over silence.
        xor     a
        ld      (SND_PAUSED), a
        ld      (SND_JINGLE_ACTIVE), a
        ld      (SND_FADE_TERM), a
        call    Sequencer_StopAll       // key-off FM + silence PSG + clear active flag
        call    Sfx_StopAll             // clear overrides + kill SfxChannels + queue/duck
        ld      hl, SND_REQ_MUSIC
        call    Snd_AckSlot             // clear slot (consumed) + bump ACK_COUNT
    .after_music:
    .no_music:
        // SFX request? (id -> SfxDispatch ENQUEUE; the queue drain later starts it).
        // Inserted BEFORE the SAMPLE block's `ret z` so a frame with only an SFX
        // request still dispatches. SfxDispatch reads the SFX blob via the $8000
        // window (banks it in, leaves it set) — same ROM-read safety as
        // Snd_LoadSong, i.e. the ring lead absorbs it. (NOT "DAC-paused": this
        // path also runs from the Timer-A tick with a sample in flight.)
        ld      a, (SND_REQ_SFX)
        or      a
        jr      z, .no_sfx
        call    SfxDispatch             // resolve blob + read header prio/flags + ENQUEUE
                                        // (it does NOT init a slot or steal a voice —
                                        // Sfx_QueueDrain -> Sfx_BeginSound does that)
        ld      hl, SND_REQ_SFX
        call    Snd_AckSlot             // clear slot (consumed) + bump ACK_COUNT
    .no_sfx:
        // fade request? (1 = out, 2 = in).
        ld      a, (SND_REQ_FADE)
        or      a
        jr      z, .no_fade
        call    Snd_FadeCommand         // set target + seed delay ctr (RAM only; bank-safe)
        ld      hl, SND_REQ_FADE
        call    Snd_AckSlot             // clear slot (consumed) + bump ACK_COUNT
    .no_fade:
        // tempo request? (1..$FE target mod, bigger = slower; $FF restore base).
        ld      a, (SND_REQ_TEMPO)
        or      a
        jr      z, .no_tempo
        call    Snd_TempoCommand        // set SND_TEMPO_TARGET (RAM only; bank-safe)
        ld      hl, SND_REQ_TEMPO
        call    Snd_AckSlot             // clear slot (consumed) + bump ACK_COUNT
    .no_tempo:
        // transport ctrl? (1 pause-music / 2 unpause / 3 pause-all / 4 unpause-all).
        ld      a, (SND_REQ_CTRL)
        or      a
        jr      z, .no_ctrl
        call    Snd_CtrlCommand         // pause/unpause (RAM + chip; bank-safe)
        ld      hl, SND_REQ_CTRL
        call    Snd_AckSlot             // clear slot (consumed) + bump ACK_COUNT
    .no_ctrl:
        // sample request? (id -> DacSampleTable[id-1] -> Snd_StartSample).
        ld      a, (SND_REQ_SAMPLE)
        or      a
        ret     z                       // nothing else pending
        // DacSampleTable is BANKED (engine-table head of the song/SFX bank). THIS
        // path has no ambient bank guarantee (a cold-boot ISR has bank 0), so bank
        // the table bank in deterministically before Snd_StartSample's descriptor
        // reads. The banked wrapper's exit re-latches the resumed context's bank.
        // SetBank clobbers af+hl; the id rides in c.
        ld      c, a                    // preserve the sample id across SetBank
        ld      a, SND_ENGINE_TABLE_BANK
        call    SndDrv_SetBank          // $6000 latch only (DMA-safe); cached no-op if current
        ld      a, c                    // a = sample id again
        call    Snd_DacLookup           // a = id -> hl = descriptor (or carry set if bad id)
        jr      c, .sample_done         // bad id -> ignore (still clear the slot below)
        call    Snd_StartSample         // start DAC playback from the descriptor at hl
    .sample_done:
        ld      hl, SND_REQ_SAMPLE
        jp      Snd_AckSlot             // clear slot + bump ACK_COUNT (tail-call; its ret is ours)
    }

    // --- Snd_AckSlot / Snd_AckBump — the mailbox request tail, factored.
    // Every consumed request ends the same way: zero the request slot the 68k
    // wrote, then bump SND_STAT_ACK_COUNT (the 68k's "the driver saw it" counter).
    // Two entry points sharing one tail:
    //   Snd_AckSlot — in: hl = the request slot to clear. Falls into Snd_AckBump.
    //   Snd_AckBump — no input; bumps the ack count only (Snd_LoadSong's tail,
    //                 where the slot was already cleared early by the H-1 repost gate).
    // `hl` is DEAD at all six clear-sites (each is immediately followed by an
    // absolute-addressed `ld a,(SND_REQ_*)` or a return) and at Snd_LoadSong's
    // tail; `a` is likewise dead at every site, so leaving the bumped count in it
    // costs nothing. RESIDENT + RAM-only, so it is bank-safe from the ISR and the
    // Timer-A tick alike.
    proc Snd_AckSlot () clobbers(af) preserves(bc, de, hl, ix, iy) falls_into Snd_AckBump {
        ld      (hl), 0                 // clear the consumed request slot
    }

    pub proc Snd_AckBump () clobbers(af) preserves(bc, de, hl, ix, iy) {
        ld      a, (SND_STAT_ACK_COUNT)
        inc     a
        ld      (SND_STAT_ACK_COUNT), a
        ret
    }

    // --- Snd_ZeroBlock — zero `b` bytes at (hl). The init/arm RAM-clear
    // workhorse (pkg-1 reclaim: four rolled sweeps replace ~30 individual
    // `ld (nn), a` stores in SndDrv_Init + Snd_LoadSong's .arm). Touches RAM
    // only; flag-transparent (ld/inc16/djnz write no flags), so callers may
    // carry live flags across it. In: hl = base, b = count (1..255).
    pub proc Snd_ZeroBlock () clobbers(b, hl) preserves(a, c, de, ix, iy) {
    .z:
        ld      (hl), 0
        inc     hl
        djnz    .z
        ret
    }

    // --- Snd_ParkDac — re-select YM reg $2A on the part-I ADDR port ($4000).
    // The $2A park is a DRIVER-LIFETIME hardware contract (see the file header):
    // the steady-state consumer write is a bare `ld (de),a` with de = $4001, so
    // reg $2A must be the selected address at all times. Every path that writes a
    // NON-$2A register to $4000 must therefore re-park before returning to the
    // consumer — nine such paths exist (idle tick, .stop, .stop_repark, both
    // Snd_StartSample re-asserts, the Timer-A tick's .reparkDac, ProgramFixed,
    // Rearm, Snd_LoadSong), and each spelled the same two instructions inline.
    // Callers that had this as their LAST act tail-call it (`jp`, its ret is
    // theirs); the rest `call` it. `a` is dead at all nine sites — every one either
    // reloads `a` immediately or returns — so leaving $2A in it is free.
    // NOT in any cycles() span: `.stop` is the END label of the DRAINING span, so
    // its body (and .stop_repark below it) is excluded by construction; the
    // remaining sites are in other procs entirely. The hot streaming loop
    // (.loop..exhaust) contains no $2A re-select at all — that is the whole point
    // of the park.
    // Effect on YM write spacing is one-directional: the call/ret only WIDENS the
    // gap between the $4000 address write and any following data write.
    pub proc Snd_ParkDac () clobbers(af) preserves(bc, de, hl, ix, iy) {
        ld      a, SND_REG_DAC_DATA     // $2A (DAC DATA reg)
        ld      (SND_Z80_YM_A0), a      // $4000 = $2A — parked
        ret
    }

    // --- Snd_TempoCommand — a = $FF (restore authored base) or a target tempo mod
    // (1..$FE; S3K TempoWait units — bigger = slower, 0 = full speed). Sets
    // SND_TEMPO_TARGET; Tempo_Ramp glides cur toward it. RESIDENT: reached from the
    // mailbox/streaming context (SAMPLE bank in the window); touches only RAM, so
    // it must NOT live in the $8000 song-bank window. Clobbers af.
    pub proc Snd_TempoCommand () clobbers(af) preserves(bc, de, hl, ix, iy) {
        cp      SND_TEMPO_RESTORE       // $FF -> restore authored base
        jr      nz, .have
        ld      a, (SND_TEMPO_BASE)
    .have:
        ld      (SND_TEMPO_TARGET), a
        ret
    }

    // --- Snd_FadeCommand — a = SND_FADE_CMD_OUT (1) or SND_FADE_CMD_IN (2). OUT:
    // ramp the scalar UP to silence. IN: snap to silence, ramp DOWN to full. Seeds
    // the step-delay counter so Fade_Ramp steps next frame. RESIDENT (RAM only).
    // Clobbers af.
    pub proc Snd_FadeCommand () clobbers(af) preserves(bc, de, hl, ix, iy) {
        cp      SND_FADE_CMD_IN
        jr      z, .fade_in
        ld      a, SND_FADE_SILENCE     // fade out: target = silent
        ld      (SND_FADE_TARGET), a
        jr      .seed
    .fade_in:
        ld      a, SND_FADE_SILENCE
        ld      (SND_MASTER_FADE), a    // start silent
        ld      (SND_FADE_DIRTY), a     // nonzero -> ModUpdate re-asserts held-note
                                        // volumes at the snapped level THIS frame
        xor     a
        ld      (SND_FADE_TARGET), a    // target = full volume
    .seed:
        ld      a, SND_FADE_DELAY
        ld      (SND_FADE_DELAY_CTR), a
        ret
    }

    // --- Snd_CtrlCommand — transport control (pkg 1 §4). a = SND_CTRL_*:
    // 1 pause-music / 2 unpause-music / 3 pause-all / 4 unpause-all; unknown
    // codes are ignored. Idempotent by construction: the state writes are
    // absolute, the mute sweep and the resume restore are both safe to repeat.
    // Codes 2 and 4 share one resume path (the SFX side has no state to
    // restore — the pause-all freeze simply stops calling Sfx_Frame).
    // RESIDENT; RAM + chip + (on resume) banked patch reads via the wrapper's
    // bank discipline. Clobbers af,bc,de,hl,ix,iy (folds the resume restore).
    pub proc Snd_CtrlCommand () clobbers(af, bc, de, hl, ix, iy) {
        cp      SND_CTRL_PAUSE_MUSIC
        jr      z, Snd_PauseMusic
        cp      SND_CTRL_PAUSE_ALL
        jr      z, .pause_all
        cp      SND_CTRL_UNPAUSE_MUSIC
        jr      z, .unpause
        cp      SND_CTRL_UNPAUSE_ALL
        ret     nz                      // unknown code -> ignore
    .unpause:                           // codes 2 and 4 share the resume path
        jp      Snd_ResumeMusic
    .pause_all:
        ld      a, SND_PAUSED_ALL
        jr      Snd_PauseMusic.pause_common
    }

    // --- Snd_PauseMusic — pause-music entry (also the fade-terminal-2 target
    // and the jingle-push freeze). Freeze-in-place: set SND_PAUSED, then mute
    // the chip (key-offs + pan gates + PSG attenuation) WITHOUT touching any
    // SeqChannel state — the streams resume exactly where they froze.
    // Clobbers af,bc,hl (= the mute sweep's set).
    pub proc Snd_PauseMusic () clobbers(af, bc, hl) preserves(de, ix, iy) {
        ld      a, SND_PAUSED_MUSIC
    export .pause_common:               // entry with a = the SND_PAUSED_* scope
        ld      (SND_PAUSED), a
        jp      Seq_SilenceMusicVoices  // chip mute; sequencer state untouched
    }

    // --- Snd_ResumeMusic — shared unpause tail (pkg 1 §4; also the jingle
    // pop's resume). SND_PAUSED = 0, then repair what the mute sweep closed:
    // re-seed the dedicate DAC pan ($B6 = $C0, Snd_LoadSong's seed repeated —
    // an ADAPTIVE song's FM6 is a music channel whose patch re-upload below
    // re-derives $B6 instead), and re-upload the FM music voices + pan shadows
    // (Sfx_UnpauseRestore). Held notes stay silent until their next musical
    // event (spec §4 honest-resume; SCF_KEYED untouched).
    pub proc Snd_ResumeMusic () clobbers(af, bc, de, hl, ix, iy) {
        xor     a
        ld      (SND_PAUSED), a
        ld      a, (SND_FM6_ADAPTIVE)
        or      a
        jr      nz, .fm6_owned          // adaptive -> FM6's own patch re-derives $B6
        ld      a, SND_REG_LR_AMS_FMS+2 // $B6 (ch6 L/R/AMS/FMS), part II
    .b6_addr:
        ld      (SND_Z80_YM_A2), a      // $4002 = reg select (part II)
        nop                             // inter-write delay (no busy-poll), as Fm_YmWrite
        ld      a, $C0                  // L+R on, AMS=FMS=0 -> the dedicate default
    .b6_data:
        ld      (SND_Z80_YM_A3), a      // $4003 = data
    .fm6_owned:
        jp      Sfx_UnpauseRestore      // FM voice re-upload + shadow zero (tail-call)

        // YM address->data spacing, machine-checked (the direct part-II pair).
        ensure(cycles(.b6_addr, .b6_data) >= YM_ADDR_TO_DATA_MIN_T,
               "Snd_ResumeMusic $B6 re-seed: address->data gap is under the YM2612 floor")
    }

    // --- Snd_DacLookup — map a 1-based DAC sample id (in `a`) to its descriptor
    // ptr. Out: hl = &DacSampleTable[id-1], carry CLEAR on success; carry SET
    // (id 0 or id > DAC_SAMPLE_COUNT) on a bad id (hl undefined). (Stride
    // DacSample_len = 9, computed as index*8 + index.) DacSampleTable is BANKED:
    // hl is a WINDOW address — pure pointer math here (no ROM read), dereferenceable
    // only while the window holds the engine-table bank (the caller's contract).
    // Clobbers a + de (the index/offset math) + f (the id-validity flags and the
    // final `add hl` carry); hl carries the descriptor pointer result; bc, ix, iy
    // are untouched.
    pub proc Snd_DacLookup () out(hl, carry: ok) clobbers(a, de, f) preserves(bc, ix, iy) {
        or      a
        scf
        ret     z                       // id 0 -> bad (carry set)
        cp      DAC_SAMPLE_COUNT+1      // carry SET iff id <= COUNT (valid)
        jr      c, .valid
        scf                             // id > COUNT -> bad (carry set)
        ret
    .valid:
        dec     a                       // index = id-1
        // hl = DacSampleTable + index*DacSample_len (9). index*9 = index*8 + index,
        // but computed in 8-BIT math instead of the old 16-bit shift chain: the
        // widest value the chain reaches is (DAC_SAMPLE_COUNT-1)*9 = 81, so nothing
        // can carry out of the byte. That deletes the `ld e,l / ld d,h` index save
        // and the `add hl,de` that consumed it; only the final base add remains.
        ld      l, a                    // keep index for the +index term
        add     a, a
        add     a, a
        add     a, a                    // a = index*8
        add     a, l                    // a = index*9 = the byte offset into the table
        ld      l, a
        ld      h, 0
        ld      de, DacSampleTable
        add     hl, de                  // hl = &DacSampleTable[index]
        or      a                       // clear carry (success — the add above sets it)
        ret
        // The fact the 8-bit form rests on (zero emitted bytes). The stride literal 9
        // is the SAME one the `*8 + *1` chain above encodes; the struct-side stride
        // is pinned by the sizeof-guard in sound_constants.emp, the authority. (That
        // guard's symbol is not in this module's seam-1 const list, so it cannot be
        // named here directly.)
        ensure(DAC_SAMPLE_COUNT * 9 <= 256,
               "DacSampleTable ({DAC_SAMPLE_COUNT} x 9 B) must fit a byte offset for Snd_DacLookup's 8-bit index math")
        // NOT TAKEN — the page-aligned form (h = DacSampleTable>>8, another -4 B):
        // `ensure((DacSampleTable & $FF) == 0)` FAILS. The table is NOT at the head
        // of the $8000 window; seam-2's sound_layout derivation places it at $85AD,
        // after the other engine-head tables. Worth revisiting only if that head is
        // ever laid out with DacSampleTable page-aligned; keep the ensure with it.
    }

    // --- Snd_StartSample — start DAC playback from a DacSample descriptor at `hl`.
    // Reads bank/ptr/len from the 9-byte descriptor (ds_bank +0, ds_ptr +3,
    // ds_length +5), re-asserts DAC mode WITHOUT toggling the $2B edge (no click),
    // resets the ring RD=0 + re-primes the $80 lead + WR=LEAD_PRIME, and sets
    // SND_STAT_DAC_ACTIVE=1. TWO CALL CONTEXTS: (a) mailbox SND_REQ_SAMPLE (VBlank
    // ISR, DAC paused, de saved); (b) sequencer $E2 (SndDrv_TimerATick, inside the
    // loop's `di` window, between samples). BANK CONTRACT: the descriptor lives in
    // the BANKED DacSampleTable, so this routine's only ROM reads are the 5
    // descriptor bytes through the $8000 window — the CALLER must have that bank in.
    // This routine NEVER SetBanks (B2: stash-only) and reads no sample payload. It
    // re-parks reg $2A on $4000 and restores de=$4001 at the END. Clobbers
    // af,bc,de,hl. Preserves ix (the sequencer channel loop relies on it) + iy.
    pub proc Snd_StartSample () clobbers(af, bc, de, hl) preserves(ix, iy) {
        push    ix                      // preserve the sequencer channel ptr
        push    hl                      // descriptor ptr (we re-read fields below)
        // Layer 7 adaptive: key OFF FM6's music note BEFORE the DAC takes ch6, so
        // the exhaust re-key ($28=$F6) is a real 0->1 edge. Pure chip key-off ($28
        // part I = chsel FM6 $06, op-mask 0); SCF_KEYED is LEFT set. Gated: dedicate
        // songs have no FM6 music -> SND_FM6_ADAPTIVE = 0 -> skip.
        ld      a, (SND_FM6_ADAPTIVE)
        or      a
        jr      z, .ss_no_fm6_keyoff
        ld      a, SND_REG_KEY_ONOFF    // $28 (key on/off, part I)
    .ss_keyoff_addr:
        ld      (SND_Z80_YM_A0), a
        ld      a, 6                    // chsel FM6 = $06, op-mask 0 -> key OFF
    .ss_keyoff_data:
        ld      (SND_Z80_YM_A1), a
    .ss_no_fm6_keyoff:
        // Re-assert DAC mode ($2B bit7), then re-park $2A. (One-time per trigger,
        // not per loop -> no recurring click.)
        ld      a, SND_REG_DAC_ENABLE
    .ss_dacen_addr:
        ld      (SND_Z80_YM_A0), a      // $4000 = $2B (select DAC-enable reg)
        ld      a, $80
    .ss_dacen_data:
        ld      (SND_Z80_YM_A1), a      // $4001 = $80 -> DAC mode ON
        call    Snd_ParkDac             // $4000 = $2A (re-park addr port on DAC DATA)
        // FM6 $B6 (DAC pan): NOT forced here — the dedicate default ($C0, centered)
        // is set ONCE at song load; forcing it per sample-start would stomp any pan
        // the DAC stream authors via MEV_REGWRITE. ADAPTIVE keeps FM6's music $B6.
        pop     hl                      // hl = descriptor base ($8000-window ptr; live per the caller's BANK CONTRACT)
        // Read ALL descriptor fields BEFORE banking. SndDrv_SetBank CLOBBERS hl, so
        // reading fields off it afterward would hit the $6000 bank-register region.
        ld      a, (hl)                 // ds_bank (+0)
        ld      (SND_ROM_BANK), a       // stash the sample bank (banked in below)
        // ds_ptr (+3) and ds_length (+5) are ADJACENT little-endian words in the
        // descriptor, and their destinations SND_ROM_PTR/SND_ROM_LEN are adjacent
        // little-endian words in Z80 RAM — so the four bytes move as ONE block
        // instead of two hand-unrolled (hl)-walks through de. Both adjacencies are
        // now ASSERTED below rather than assumed: if either struct or the RAM map is
        // ever re-laid-out, this becomes a build error, not a silently wrong ptr/len
        // pair (which would stream garbage ROM at a garbage length).
        // Reads still come from the $8000 window under the caller's BANK CONTRACT —
        // same 4 descriptor bytes, same order, no payload read, no SetBank.
        ld      de, DacSample_ds_ptr    // +3 (start of the ptr/length pair)
        add     hl, de
        ld      de, SND_ROM_PTR         // ... -> SND_ROM_PTR, SND_ROM_LEN
        ld      bc, 4
        ldir
        // The two adjacencies the block move rests on (zero emitted bytes).
        ensure(SND_ROM_LEN == SND_ROM_PTR+2,
               "SND_ROM_LEN ({SND_ROM_LEN}) must follow SND_ROM_PTR ({SND_ROM_PTR}) for Snd_StartSample's ldir")
        ensure(DacSample_ds_length == DacSample_ds_ptr+2,
               "DacSample.ds_length (+{DacSample_ds_length}) must follow ds_ptr (+{DacSample_ds_ptr}) for Snd_StartSample's ldir")
        // B2: stash-only. The sample bank was stashed to SND_ROM_BANK above; do NOT
        // SetBank here (in the $E2 context this runs mid-Sequencer_Frame where the
        // window MUST stay on the SONG bank). The brackets latch the sample at the
        // right moment: B1 after every frame; B3 on ISR exit while DAC active; B4 on
        // the idle->streaming entry.

        // Reset ring pointers + prime the lead. To avoid a start underrun WITHOUT
        // reading sample ROM (which could land mid-DMA in the ISR context), set WR
        // ahead of RD by SND_RING_LEAD_PRIME and leave those lead bytes at the $80
        // the ring was pre-filled with — a click-free DC-center lead-in.
        xor     a
        ld      (SND_RING_RD), a        // RD = 0
        ld      hl, SND_RING_BASE       // ring page base
        ld      b, SND_RING_LEAD_PRIME
        ld      a, $80
    .prime_lead:
        ld      (hl), a
        inc     hl
        djnz    .prime_lead
        ld      a, SND_RING_LEAD_PRIME
        ld      (SND_RING_WR), a        // WR = LEAD_PRIME -> lead bytes of $80 ready

        ld      a, 1
        ld      (SND_STAT_DAC_ACTIVE), a // arm streaming (idle loop jumps in)
        ld      (SND_DAC_PHASE), a      // PHASE = 1 (playing) — two-stage stop SM
        // restore the DAC consumer's invariants for BOTH call contexts: re-park reg
        // $2A on $4000, and de = $4001 (the streaming-loop DATA port).
        call    Snd_ParkDac             // re-park $2A on the addr port
        ld      de, SND_Z80_YM_A1       // de = $4001 (DAC DATA port invariant)
        pop     ix
        ret

        // YM address->data spacing, machine-checked (Task 9.2). These two pairs
        // write the YM DIRECTLY, not through Fm_YmWrite, so the funnel's ensures
        // do not cover them.
        ensure(cycles(.ss_keyoff_addr, .ss_keyoff_data) >= YM_ADDR_TO_DATA_MIN_T,
               "Snd_StartSample $28 key-off: address->data gap is under the YM2612 floor")
        ensure(cycles(.ss_dacen_addr, .ss_dacen_data) >= YM_ADDR_TO_DATA_MIN_T,
               "Snd_StartSample $2B DAC-enable: address->data gap is under the YM2612 floor")
    }

    // --- SndDrv_SetBank — select ROM bank in `a` into the Z80 $8000 window; no-op
    // if already current. MegaPCM 9-bit set-bank trick: the $6000 latch is a 9-bit
    // shift register loaded LSB-first by 9 single-bit writes; SND_CUR_BANK caches
    // the last bank so the 9 writes are skipped when it already matches.
    // `a` = (sample_addr & $7F8000) >> 15. Touches the $6000 latch only — NEVER ROM
    // — so it is DMA-safe. CLOBBERS af AND hl (hl ends at SND_CUR_BANK on the cached
    // path, or $6000 otherwise) — callers MUST NOT rely on hl surviving.
    // ALSO CLOBBERS `b` (the 8-bit rolled bit-write counter), but NOT `c`: the
    // contract is spelled at 8-bit granularity on purpose, because
    // SndDrv_PollMailbox parks the pending sample id in `c` across its SetBank call
    // and that must stay build-enforced. `b` is dead at every call site
    // (SndDrv_Idle -> the sample loop reloads it from RAM; Snd_PollMailbox_Banked,
    // Run_SeqFrame_OnSongBank, Snd_LoadSong, Sfx_Frame and Sfx_ResolveBlob's two
    // callers all clobber bc themselves). NOTE the cached path returns before
    // touching b — the clause is the honest worst case, not a per-path claim.
    pub proc SndDrv_SetBank () clobbers(af, b, hl) preserves(c, de, ix, iy) {
        ld      hl, SND_CUR_BANK
        cp      (hl)
        ret     z                       // already current -> no I/O
        ld      (hl), a                 // cache the new bank
        ld      hl, SND_Z80_BANKREG     // $6000 bank latch
        // 8 writes of the current LSB (b0..b7), LSB-first, rotating each bit in.
        // Rolled, not unrolled: identical bytes on the wire, 10 fewer bytes of ROM.
        // `rrca` is an 8-bit rotate, so the 8 rotations also restore `a` to the
        // ORIGINAL bank, exactly as the unrolled form did.
        ld      b, 8
    .bit_write:
        ld      (hl), a
        rrca
        djnz    .bit_write
        // 9th write = bit8 (the latch is 9-bit). After 8 rotations `a` is back to the
        // ORIGINAL bank (its bit0 is b0, NOT b8). All our banks are < $100, so b8 = 0;
        // write 0 explicitly.
        xor     a                       // b8 = 0 (banks < $100)
        ld      (hl), a                 // 9th write (bit8)
        ret
    }

    // --- Run_SeqFrame_OnSongBank — B1 bracket. Run one sequencer frame with the
    // $8000 window on the SONG bank, then restore it to the SAMPLE bank. The frame
    // engine streams the song through the window (must see the song bank); the DAC
    // FILL reads the sample payload through the same window (bank restored after).
    // Both SetBanks are cached. Clobbers af,bc,de,hl,ix,iy (= Sequencer_Frame's
    // set — its `jp Sfx_Frame` tail destroys iy; there is no push/pop bracket here,
    // so this pass does NOT preserve iy). The tail-call does NOT re-park $2A or
    // restore de=$4001 — CALLERS must.
    pub proc Run_SeqFrame_OnSongBank () clobbers(af, bc, de, hl, ix, iy) {
        ld      a, (SND_SONG_BANK)
        call    SndDrv_SetBank          // window -> song bank (cached no-op if current)
        call    Sequencer_Frame         // one per-frame engine pass (reads the song stream)
        ld      a, (SND_ROM_BANK)
        jp      SndDrv_SetBank          // window -> sample bank (tail-call; cached no-op)
    }

    // --- SndDrv_TimerATick — the Timer-A overflow handler (the PER-FRAME tick).
    // Reached ONLY from the hot loop's poll `jp nz` at the FIXED frame rate, inside
    // the loop's `di` window. The hot loop is REGISTER-RESIDENT (1:1) and
    // Sequencer_Frame + PollMailbox clobber EVERYTHING (incl. ix + the shadow set),
    // so this tick: (1) SPILL the live ring/ROM state (b=WR, c=RD, ix=ROM ptr,
    // hl'=len) to RAM; (2) rearm + Run_SeqFrame_OnSongBank + mailbox poll; (3)
    // RELOAD the register-resident state (a retrigger may have reset it); (4)
    // BULK-REFILL the ring lead the consumer burned while 68k DMAs blocked the
    // producer this frame (len-bounded; runs THROUGH an active DMA); (5) re-park
    // $2A and rejoin .afterPoll. Non-returning (rejoins the hot loop).
    pub proc SndDrv_TimerATick () clobbers(af, bc, de, hl, ix, iy) {
        // 1. SPILL the register-resident state to RAM (RD already includes this
        // pass's consumer inc; the frame/poll/retrigger operate on RAM).
        ld      a, c
        ld      (SND_RING_RD), a
        ld      a, b
        ld      (SND_RING_WR), a
        ld      (SND_ROM_PTR), ix
        exx
        ld      (SND_ROM_LEN), hl
        exx
        // 2. rearm + per-frame engine (B1) + mailbox service.
        call    Snd_TimerA_Rearm        // clear overflow, keep counting, re-park $2A
        call    Run_SeqFrame_OnSongBank // B1: frame on song bank, restore sample bank
        call    Snd_PollMailbox_Banked  // mid-sample SFX/music service (bank-transparent)
        // 3. RELOAD the register-resident state (StartSample may have re-primed it).
        ld      a, (SND_RING_RD)
        ld      c, a
        ld      a, (SND_RING_WR)
        ld      b, a
        ld      ix, (SND_ROM_PTR)
        exx
        ld      hl, (SND_ROM_LEN)
        exx
        ld      h, SND_RING_PAGE        // restore h = $19 (frame clobbered it)
        ld      de, SND_Z80_YM_A1       // restore de = $4001
        // 4. BULK-REFILL: top the lead up to SND_RING_LEAD_TARGET every frame, then
        // stop at sample end. Does NOT defer on an active 68k DMA — filling THROUGH
        // the DMA recovers the lead every frame and prevents the underrun (the read
        // still returns correct data; the DAC is already holding here). Window on
        // the sample bank (B1 tail); reads via ix.
    .refill:
        ld      a, b
        sub     c                       // lead = WR - RD
        cp      SND_RING_LEAD_TARGET
        jr      nc, .refillDone         // lead >= target -> topped up
        exx
        ld      a, h
        or      l                       // len == 0 (sample exhausted)?
        exx
        jr      z, .refillDone
        ld      a, (ix+0)               // fill 1 byte: ROM(ix) -> ring[wr]
        ld      l, b
        ld      (hl), a
        inc     b                       // WR++
        inc     ix                      // ROM++
        exx
        dec     hl                      // len--
        exx
        jr      .refill
    .refillDone:
        // if the refill (or a prior pass) exhausted the sample, enter DRAINING_TAIL
        // so .afterPoll routes to .draining instead of FILLing past the sample.
        exx
        ld      a, h
        or      l
        exx
        jr      nz, .reparkDac
        ld      a, 2
        ld      (SND_DAC_PHASE), a      // len 0 -> PHASE = DRAINING_TAIL
    .reparkDac:
        call    Snd_ParkDac             // re-park $2A on $4000 (frame/refill moved it)
        jp      SndDrv_Sample.afterPoll // rejoin the hot loop's dispatch
    }

    // --- Snd_TimerA_ProgramFixed — load + enable Timer A at the FIXED frame rate
    // (SND_TIMERA_N, build-time constant). Writes the full 10-bit N: $24 = N>>2
    // (bits 9..2), $25 = N&3 (bits 1..0), $27 = $05 (LOAD:A | ENBL:A). ENBL:A is
    // REQUIRED so the overflow raises the status flag the common-prefix poll reads.
    // ABSOLUTE addressing (preserve de = $4001); re-parks reg $2A on $4000. Clobbers af.
    pub proc Snd_TimerA_ProgramFixed () clobbers(af) preserves(bc, de, hl, ix, iy) {
        // $24 = N>>2 (MSB) — write MSB before LSB.
        ld      a, SND_REG_TIMER_A_HI   // $24
    .t24_addr:
        ld      (SND_Z80_YM_A0), a      // select $24 on $4000
        ld      a, SND_TIMERA_N>>2      // N bits 9..2 (build-time constant)
    .t24_data:
        ld      (SND_Z80_YM_A1), a      // $4001 = N>>2
        // $25 = N&3 (LSB).
        ld      a, SND_REG_TIMER_A_LO   // $25
    .t25_addr:
        ld      (SND_Z80_YM_A0), a      // select $25 on $4000
        ld      a, SND_TIMERA_N&3       // N bits 1..0
    .t25_data:
        ld      (SND_Z80_YM_A1), a      // $4001 = N&3
        // $27 = LOAD:A | ENBL:A -> start the counter, let overflow raise the flag.
        ld      a, SND_REG_TIMER_CTRL   // $27
    .t27_addr:
        ld      (SND_Z80_YM_A0), a      // select $27 on $4000
        ld      a, SND_TIMERA_CTRL_PROGRAM // $05 = LOAD:A | ENBL:A
    .t27_data:
        ld      (SND_Z80_YM_A1), a      // $4001 = program Timer A
        // re-park reg $2A on the addr port for the DAC consumer (tail-call: the
        // helper's ret is ours, and its contract is identical to this proc's).
        jp      Snd_ParkDac

        // YM address->data spacing, machine-checked (Task 9.2). This proc writes
        // the YM directly rather than through Fm_YmWrite, so it is NOT covered by
        // the funnel's ensures — each of the three register pairs is asserted here.
        ensure(cycles(.t24_addr, .t24_data) >= YM_ADDR_TO_DATA_MIN_T,
               "Timer-A $24: address->data gap is under the YM2612 floor")
        ensure(cycles(.t25_addr, .t25_data) >= YM_ADDR_TO_DATA_MIN_T,
               "Timer-A $25: address->data gap is under the YM2612 floor")
        ensure(cycles(.t27_addr, .t27_data) >= YM_ADDR_TO_DATA_MIN_T,
               "Timer-A $27: address->data gap is under the YM2612 floor")
    }

    // --- Snd_TimerA_Rearm — clear the Timer-A overflow status flag, keeping the
    // timer loaded + enabled. The 10-bit N auto-reloads and the counter keeps
    // running; a SINGLE $27 write of $15 (LOAD:A | ENBL:A | RST:A) strobes RST:A
    // (bit4), clearing the overflow flag without disturbing the count. ABSOLUTE
    // addressing (preserve de); re-parks reg $2A on $4000. Clobbers af.
    pub proc Snd_TimerA_Rearm () clobbers(af) preserves(bc, de, hl, ix, iy) {
        ld      a, SND_REG_TIMER_CTRL   // $27
        ld      (SND_Z80_YM_A0), a      // select $27 on $4000
        ld      a, SND_TIMERA_CTRL_REARM // $15 = LOAD:A | ENBL:A | RST:A (clear overflow flag)
        ld      (SND_Z80_YM_A1), a      // $4001 = re-arm Timer A
        jp      Snd_ParkDac             // re-park addr port on DAC DATA (tail-call)
    }

    // --- Snd_LoadSong — load + arm the song the 68k posted. Reached from
    // SndDrv_PollMailbox, which runs from BOTH the VBlank ISR (idle context) AND
    // the Timer-A tick mid-sample (`:959`, via Snd_PollMailbox_Banked). So a song
    // load CAN land with a DAC sample in flight: the loader does not stop the DAC,
    // the ring keeps draining, and the lead absorbs the work here. What protects
    // the in-flight FILL is the explicit .keep_sample_bank guard below, which
    // declines to reseed SND_ROM_BANK while SND_STAT_DAC_ACTIVE is set — not any
    // guarantee that streaming is stopped.
    // (This header used to claim "REACHED ONLY from ... the VBlank ISR, so the DAC
    // streaming loop is PAUSED". False since the Timer-A tick began servicing the
    // mailbox, and flatly contradicted by .keep_sample_bank's own comment further
    // down. Corrected in the Task 9.4 truth pass — no code change.)
    // EVERY song STREAMS from ROM (SH_F_STREAM is
    // always set): the sequencer reads the song's streams + patch bank DIRECTLY
    // through the banked $8000 window. Steps: (1) $2B=$00 (DAC OFF, re-park $2A) +
    // DAC_ACTIVE=0; (2) SetBank(song bank) and LEAVE it set; (3) song base + patch
    // ptr = window ptrs; (4) init channels; then parse the header + program Timer A
    // + arm. Clobbers af,bc,de,hl,ix,iy.
    pub proc Snd_LoadSong () clobbers(af, bc, de, hl, ix, iy) {
        // 0. SILENCE THE PREVIOUS SONG'S HARDWARE before clobbering its RAM state.
        // A PlayMusic-while-playing switch reaches here with FM notes keyed-on and
        // PSG tones sustaining; the .seq_clr wipe below loses every SCF_KEYED bit,
        // so without an explicit hardware silence those voices would HANG.
        // Sequencer_StopAll: key-off all 6 FM channels via $28 + Psg_SilenceAll +
        // clear SND_SEQ_ACTIVE. ABSOLUTE YM addressing (preserves de=$4001); touches
        // NO Timer-A state, so the fixed-rate program keeps owning the timer config.
        call    Sequencer_StopAll       // key-off FM + silence PSG + clear active flag

        // A PlayMusic-while-an-SFX-runs switch reaches here with an SfxChannel still
        // ACTIVE, owning a physical voice the new song will fight over. Sfx_StopAll
        // deactivates all 7 SfxChannels, drops priority, drains the queue, resets the
        // duck — cancelling any in-flight SFX. Touches only RAM (preserves de=$4001).
        call    Sfx_StopAll             // cancel in-flight SFX so the new song starts clean

        // Clear the sequencer header + channel block FIRST (before the load setup
        // below), so the SND_SEQ_PATCHTAB + base it writes are NOT zeroed by it.
        // LDIR self-propagating wipe: seed byte 0, then copy it forward over the
        // remaining N-1 bytes. Same region, same value, one byte smaller than the
        // hand-rolled `dec bc / ld a,b / or c / jr nz` loop it replaces — and about
        // HALF the cycles (~27.7k -> ~13.9k for this ~660-byte block, 21 T/byte vs
        // 42). Those cycles are not free perf: this runs inside the VBlank ISR's
        // mailbox service, and the 68k's Sound_PlayMusic spins on MUSIC_SLOT == 0
        // waiting for it, so halving the wipe directly shortens that await_slot spin.
        // de is clobbered here (it was not before) — already inside this proc's
        // declared clobbers, and de = $4001 is re-established by both return paths
        // (SndDrv_ISR pops it; SndDrv_TimerATick reloads it).
        ld      hl, SND_SEQ_BASE
        ld      de, SND_SEQ_BASE+1
        ld      bc, SND_SEQ_END-SND_SEQ_BASE-1
        ld      (hl), 0                 // seed the first byte; ldir smears it forward
        ldir

        // B1/B2 banking: record this song's bank for the per-frame bracket. Seed the
        // sample bank to it too — but ONLY when no DAC sample is in flight. A music
        // change can land mid-drum (the loader does NOT stop the DAC); clobbering
        // SND_ROM_BANK then would yank the window to the new bank while the dying
        // sample still FILLs from its own bank. Leaving it lets the in-flight sample
        // finish on its real bank; the next $E2 re-stashes it.
        ld      a, (SND_MUSIC_PARAM_BANK)
        ld      (SND_SONG_BANK), a
        ld      b, a                    // stash the song bank across the DAC-active test
        ld      a, (SND_STAT_DAC_ACTIVE)
        or      a
        jr      nz, .keep_sample_bank   // a DAC drum is mid-flight -> keep its own bank
        ld      a, b
        ld      (SND_ROM_BANK), a       // idle -> seed sample bank = song bank (B1 no-op)
    .keep_sample_bank:

        // ---------- STREAM load (the only mode — every song streams from ROM) -----
        // 1. DAC mode OFF: $2B = $00. ABSOLUTE addressing (preserve de=$4001), then
        //    re-park $2A. The idle loop's per-pass $2A writes are harmless once the
        //    DAC is disabled. (One write; no per-loop toggle.)
        ld      a, SND_REG_DAC_ENABLE   // $2B
        ld      (SND_Z80_YM_A0), a      // select $2B on $4000
        xor     a
        ld      (SND_Z80_YM_A1), a      // $4001 = $00 -> DAC mode OFF
        call    Snd_ParkDac             // re-park addr port on DAC data
        xor     a
        ld      (SND_STAT_DAC_ACTIVE), a // DAC not streaming (idle loop ticks the song)
        // SELF-HEAL (bank-latch desync insurance): SetBank's cached no-op assumes
        // SND_CUR_BANK == the physical $6000 latch. If they ever desync, a song load
        // is the natural recovery point. Poison the cache with the same impossible
        // bank id init seeds ($FF) so the SetBank below ALWAYS runs the full 9-write
        // latch program. $FF matches no real bank; nothing reads SND_CUR_BANK between
        // here and that SetBank.
        ld      a, $FF                  // sentinel: matches no real bank
        ld      (SND_CUR_BANK), a       // force the next SetBank uncached
        // 2. SetBank(song bank) and LEAVE it set — the song's bank is the playback
        //    bank now; the idle loop never re-banks, so it persists for ROM reads.
        ld      a, (SND_MUSIC_PARAM_BANK)
        call    SndDrv_SetBank          // $6000 latch only (forced physical program)
        // 3. song base = the $8000 window ptr; patch bank = its window ptr (same bank).
        ld      hl, (SND_MUSIC_PARAM_PTR)
        ld      (Snd_SongBase), hl
        ld      hl, (SND_MUSIC_PARAM_PATCHPTR)
        ld      (SND_SEQ_PATCHTAB), hl

        // ---------- parse the header + init channels (base in Snd_SongBase) --------
        // Layer 7: cache the per-song adaptive-FM6 flag + null the FM6 channel ptr
        // (set below in .chan_init when CHROUTE_FM6 is found). The DAC trigger/exhaust
        // paths branch on these to time-share ch6 between FM6 music and the drum.
        xor     a
        ld      (SND_FM6_CHAN_PTR), a
        ld      (SND_FM6_CHAN_PTR+1), a // null FIRST (set in .chan_init when CHROUTE_FM6 is found)
        ld      a, (SND_MUSIC_PARAM_FLAGS)
        and     SH_F_FM6_ADAPTIVE
        ld      (SND_FM6_ADAPTIVE), a   // THEN arm the gate (0 = dedicate/none, nonzero = time-share)
        // DEDICATE: seed FM6's $B6 = $C0 ONCE per song load (with $2B armed the DAC
        // inherits FM6's L/R). A dedicate song has no FM6 music voice to set $B6.
        // Part-II write ($4002/$4003): does not touch the part-I addr latch, so the
        // $2A park is undisturbed. ADAPTIVE skips — FM6's music patch owns $B6.
        jr      nz, .fm6_pan_owned      // adaptive -> Fm_PatchLoad sets the real $B6
        ld      a, SND_REG_LR_AMS_FMS+2 // $B6 (ch6 L/R/AMS/FMS), part II
        ld      (SND_Z80_YM_A2), a      // $4002 = reg select (part II)
        nop                             // inter-write delay (no busy-poll), as Fm_YmWrite
        ld      a, $C0                  // L+R on, AMS=FMS=0 -> centered default
        ld      (SND_Z80_YM_A3), a      // $4003 = data
    .fm6_pan_owned:
        // H-1 (sound repost gate): the 6-byte param block is FULLY CONSUMED by now
        // (SND_MUSIC_PARAM_FLAGS above was the last read). Clear the request slot
        // HERE — well before the end of the load — so the 68k's repost gate
        // (Sound_PlayMusic spins on MUSIC_SLOT==0) unblocks early. A repost landing
        // in the tail below is then KEPT (picked up by the next mailbox poll).
        xor     a
        ld      (SND_REQ_MUSIC), a

        // channel_count (SH_CHCOUNT) — read via iy = song base ($8000-window).
        ld      iy, (Snd_SongBase)
        ld      a, (iy+SH_CHCOUNT)
        cp      CHROUTE_COUNT+1         // defensive guard: a corrupt count clamps to 0
        jr      c, .cc_ok               //   (prevents the channel loop walking ix wild)
        xor     a
    .cc_ok:
        ld      (SND_SEQ_CHCOUNT), a
        ld      c, a                    // c = channel count (loop bound)

        // cache the header tempo_mod + per-song pitch-table ptr (iy still = song
        // base). tempo_mod (raw S3K TempoWait addend) seeds each channel's mod +
        // accumulator below; the pitch-table ptr (BE offset; 0 = engine default) is
        // cached for ModUpdate's pitch renderer — a 0 offset stays 0 (use default).
        ld      a, (iy+SH_TEMPO_MOD)
        ld      (SND_SEQ_TEMPO_MOD), a
        ld      h, (iy+SH_PITCHTAB_HI)  // BE: high byte first
        ld      l, (iy+SH_PITCHTAB_LO)
        ld      a, h
        or      l
        jr      z, .pitchtab_default    // offset 0 -> leave Snd_PitchTabPtr = 0 (default)
        ld      de, (Snd_SongBase)
        add     hl, de                  // absolute ptr = base + offset
    .pitchtab_default:
        ld      (Snd_PitchTabPtr), hl   // 0 (default) or base+offset
        ld      a, c                    // restore a = channel count (clobbered above)

        or      a
        jp      z, .arm                 // 0 channels -> nothing to init (still arm)

        // iterate the per-channel header records, filling each SeqChannel.
        // iy = header record ptr (SHC_LEN bytes each, from base+SH_CHANNELS);
        // ix = SeqChannel ptr.
        ld      ix, SND_SEQ_CHANNELS
        ld      bc, SH_CHANNELS
        add     iy, bc                  // iy = base + SH_CHANNELS (first record)
        ld      a, (SND_SEQ_CHCOUNT)
        ld      c, a                    // restore c = channel count (add iy clobbered bc)
    .chan_init:
        // NO push/pop bc bracket around this body: c (the channel counter) survives
        // it by CONTRACT, not by luck. The body's only call, Snd_RouteClassFlags,
        // declares preserves(bc,de,hl,ix,iy) — so the checker proves the save dead —
        // and nothing else in the body writes b or c (every scratch here goes through
        // a/de/hl/ix/iy).
        // route byte.
        ld      a, (iy+SHC_ROUTE)
        ld      (ix+sc_route), a
        // Layer 7: cache the FM6 SeqChannel ptr (channels are in DECLARATION order).
        cp      CHROUTE_FM6
        jr      nz, .not_fm6
        ld      (SND_FM6_CHAN_PTR), ix
    .not_fm6:
        // cmd_ptr (slot[0]): BIG-ENDIAN 16-bit OFFSET in the header -> add the base.
        ld      h, (iy+SHC_CMD_HI)      // high byte first (big-endian)
        ld      l, (iy+SHC_CMD_LO)
        ld      de, (Snd_SongBase)
        add     hl, de                  // hl = base + offset ($8000-window address)
        ld      (ix+sc_stream_ptr), l
        ld      (ix+(sc_stream_ptr+1)), h
        // mod_ptr (slot[1], C-ready seam): BIG-ENDIAN offset; 0 = NULL (single stream
        // A). A 0 offset stays 0 (NULL) — only a nonzero offset is rebased.
        ld      h, (iy+SHC_MOD_HI)
        ld      l, (iy+SHC_MOD_LO)
        ld      a, h
        or      l
        jr      z, .mod_null            // offset 0 -> leave sc_mod_ptr = NULL (0)
        ld      de, (Snd_SongBase)
        add     hl, de
        ld      (ix+sc_mod_ptr), l
        ld      (ix+(sc_mod_ptr+1)), h
        ld      (ix+sc_macro_active), 1 // sc_macro_active mirrors sc_mod_ptr != 0 (header-arm path)
    .mod_null:
        // flags: ACTIVE + route-class bit (FM / PSG / DAC) from the route value.
        ld      a, (iy+SHC_ROUTE)
        call    Snd_RouteClassFlags     // a = SCF_ACTIVE | class bit (for this route)
        ld      (ix+sc_flags), a
        // sensible default volume + first-tick-fetches-immediately.
        ld      (ix+sc_volume), 100
        ld      (ix+sc_dur_count), 1
        // sc_dur_default seeds to 1 (not 0): a channel that issues a note BEFORE any
        // set-default-duration opcode reloads sc_dur_count from this. At 0 the next
        // `dec (ix+sc_dur_count)` wraps 0->255 = a multi-second stuck note.
        ld      (ix+sc_dur_default), 1
        // ZERO-DEFAULT FIELDS COME FREE (pkg-1 reclaim): the .seq_clr LDIR wipe
        // above zeroed the WHOLE channel block ($1A00..SND_SEQ_END), so every
        // field whose fresh-song value is 0 — the PSG vol-env id/cursor/out
        // (disabled), sc_noise_mode (unset until MEV_PSGNOISE), sc_mod_ctrl
        // (every Mod_* path inert), sc_detune (neutral), and the portamento
        // rate/accumulator (off) — is ALREADY correct here. The ten per-field
        // `ld (ix+d), 0` stores this loop used to carry (~40 resident bytes)
        // predated that wipe; only NONZERO seeds are written below.
        // tempo gate: mod from the header (SH_TEMPO_MOD), accumulator SEEDED = mod —
        // mirroring S3K's song init EXACTLY (zTempoAccumulator = zCurrentTempo =
        // header tempo). For mod < $80 frame 0 adds mod+mod with no carry -> the
        // first event-tick lands on frame 0 (S3K-identical phase).
        ld      a, (SND_SEQ_TEMPO_MOD)  // cached header tempo_mod
        ld      (ix+sc_tempo_mod), a
        ld      (ix+sc_tempo_accum), a
        // ModUpdate held-note no-op path needs a known baseline: a single plain note
        // (pt_count=1) and a forced first patch load (last_patch=$FF != any real
        // patch index).
        ld      (ix+sc_pt_count), 1
        ld      (ix+sc_last_patch), $FF
        // sc_note force sentinel ($FF): the re-key rule gives a FRESH attack only
        // when the rendered index differs from sc_note. $FF is not a valid
        // fnum-table index (0..$83), so the FIRST MEV_PITCHENV on any channel ALWAYS
        // differs -> the first note always attacks (no silent-first-note).
        ld      (ix+sc_note), $FF
        // advance to the next header record + SeqChannel.
        ld      de, SHC_LEN
        add     iy, de
        ld      de, SeqChannel_len
        add     ix, de
        dec     c
        jp      nz, .chan_init          // jr out-ranged when loop body > 127B; jp is safe

    .arm:
        // (SND_SEQ_PATCHTAB was set above: the song's patch-bank window ptr.)
        // trace/visibility housekeeping.
        xor     a
        ld      (SND_SEQ_TRACE_WR), a
        ld      (SND_SEQ_BADOP), a
        // Timer A is the FIXED frame clock, programmed at driver init. Re-program it
        // here as belt-and-suspenders — on a running timer this reloads the same N
        // (harmless), and it revives the clock if anything ever left the timer off.
        // We still cache the legacy SH_TEMPO byte into SND_SEQ_TEMPO for visibility.
        call    Snd_TimerA_ProgramFixed
        ld      iy, (Snd_SongBase)
        ld      a, (iy+SH_TEMPO)
        ld      (SND_SEQ_TEMPO), a
        // arm the sequencer.
        ld      a, 1
        ld      (SND_SEQ_ACTIVE), a
        // reset global expression state for the new song. Fade -> full volume (else a
        // song after a fade-out would play SILENT). Tempo globals -> the song's
        // AUTHORED header mod (so a stale Sound_SetTempo ramp can't leak in and a $FF
        // "restore" request returns to THIS song's authored rate).
        // One rolled sweep zeroes the whole expression + game-feel block
        // ($1CCC-$1CD6): fade -> full volume/idle, tempo globals (re-seeded from
        // the header just below), and the pkg-1 game-feel resets — a NEW song
        // always starts RUNNING and clean. A stale armed terminal would
        // stop/pause the new song the moment the (already-at-target) ramp is
        // next polled; a stale pause would freeze it on frame one; a stale
        // jingle flag would phantom-pop over it. The comm cue byte is per-song
        // score state (separate store — it lives in the status region).
        ld      hl, SND_MASTER_FADE
        ld      b, SND_FADE_TERM - SND_MASTER_FADE + 1
        call    Snd_ZeroBlock
        xor     a
        ld      (SND_STAT_COMM), a
        // R4: keep the fade rate pattern valid (default rate) for the new song.
        ld      a, SND_FADE_PAT_DEFAULT
        ld      (SND_FADE_PATTERN), a
        ld      a, (SND_SEQ_TEMPO_MOD)  // authored header mod (cached above)
        ld      (SND_TEMPO_CUR), a
        ld      (SND_TEMPO_TARGET), a
        ld      (SND_TEMPO_BASE), a
        // H-1: the request slot was already cleared at .fm6_pan_owned; just bump the
        // ack count here (the bump-only helper entry). Clearing at THIS point would
        // wipe a repost that landed during the load tail.
        jp      Snd_AckBump             // bump ACK_COUNT (tail-call; its ret is ours)
    }

    // --- Snd_RouteClassFlags — map a route byte (in `a`) to its sc_flags init value:
    // SCF_ACTIVE | (SCF_IS_FM for FM1..FM6 / SCF_IS_PSG for PSG1..PSGN / SCF_IS_DAC
    // for the DAC route). (CHROUTE order: FM1..FM6 = 0..5, PSG1..PSGN = 6..9,
    // DAC = 10.) The comparisons use the named CHROUTE_* equates, so the boundaries
    // track the enum automatically. Clobbers f (the two `cp` comparisons); a carries
    // the class-flags result; bc, de, hl, ix, iy are untouched.
    pub proc Snd_RouteClassFlags () out(a) clobbers(f) preserves(bc, de, hl, ix, iy) {
        cp      CHROUTE_PSG1            // < PSG1 (6) -> FM route (0..5 incl. FM6)
        jr      c, .fm
        cp      CHROUTE_DAC            // < DAC (10) -> PSG route (6..9)
        jr      c, .psg
        ld      a, SCF_ACTIVE|SCF_IS_DAC
        ret
    .fm:
        ld      a, SCF_ACTIVE|SCF_IS_FM
        ret
    .psg:
        ld      a, SCF_ACTIVE|SCF_IS_PSG
        ret
    }

}
