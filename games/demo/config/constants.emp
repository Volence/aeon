// -----------------------------------------------
// games.demo.constants — the Aeon engine demo's game constants (SOLE DEFINITION)
//
// The demo is the "start here" template game: the smallest set of constants an
// engine-agnostic game must declare. Game `.emp` consumers read them via
// `use games.demo.constants`; the game manifest (game.emp's ENTRY_ID) and the
// game-AGNOSTIC engine `.emp` (rings.emp / ram.emp) read them through the
// ownership-flip export — the build harvests every `pub const` here and injects it
// as a guarded `-D` define plus a link EquSym (harvest_game_constants,
// native.rs), so the engine's `ensure(extern("X") == X)` drift guards cross-check
// their local copy against this authority.
//
// The three engine-VARYING GAME->ENGINE interface values (MAX_RING_BUFFER,
// VRAM_RING_PLACEHOLDER, COLLECTED_WINDOW_SLOTS) are NOT declared here: they are
// per-profile `-D`s (native.rs `emp_defines`, demo 16 / $3E4 / 4), the same
// `-D`-not-in-`.emp` rule the sonic4 constants module follows. Byte-identity is
// their drift net.
module games.demo.constants

use engine.types.{VramTile}
use engine.constants.{COLLECTED_MASK_BYTES}
// The generated vram-map block's authority cross-checks reference these engine
// names (gen_vram_map.py emits the ensures; the imports are hand-owned here):
use engine.constants.{POOL_TILE_CEILING, BG_TILE_CAPACITY, BG_TILE_BASE_VRAM,
                      VRAM_SPRITE_TABLE, VRAM_HSCROLL_TABLE, VRAM_WATERLINE_STRIPS,
                      VRAM_PLANE_A, VRAM_PLANE_B, VRAM_WINDOW}

// Game state id — the demo's single entry state (0/1 are the engine's
// GS_BOOT / GS_IDLE). game.emp's ENTRY_ID binds boot entry to this.
pub const GS_DEMO                 = 2

// -----------------------------------------------
// VRAM allocation — VALUES are generated from games/demo/vram.toml
// -----------------------------------------------
// Rationale is hand-owned; the constant and the engine cross-check ensures are
// emitted between the markers by tools/gen_vram_map.py. Edit the TOML, then
// regenerate. The full map: docs/generated/vram-map-demo.md.
// VRAM_DEMO_OBJ (tile 992): demo box art (4 solid tiles), with the blank ring
// slot right after it. VRAM_RING_PLACEHOLDER (= VRAM_DEMO_OBJ + 4, the engine
// ring-art slot DrawRings renders from) is the game-varying `-D` homed in
// native.rs `emp_defines` ($3E4), not declared here — recorded in the TOML as a
// sigil-D authority; T1's define emission makes the TOML feed it.
// >>> GENERATED: vram map (tools/gen_vram_map.py) — DO NOT HAND-EDIT <<<
// Emitted from games/demo/vram.toml — edit THAT, then run:
//   python3 tools/gen_vram_map.py --game demo
// The map doc: docs/generated/vram-map-demo.md
pub const VRAM_DEMO_OBJ           : VramTile = $03E0   // demo_obj: tiles 992..995 (4), boot, owner games.demo.demo_state
// Authority cross-checks — the engine constant vs the declared map:
ensure(POOL_TILE_CEILING == 768, "vram.toml fg_art_pool drifted from engine POOL_TILE_CEILING — edit games/demo/vram.toml and regenerate")
ensure(BG_TILE_CAPACITY == 400, "vram.toml bg_region drifted from engine BG_TILE_CAPACITY — edit games/demo/vram.toml and regenerate")
ensure(BG_TILE_BASE_VRAM == $8000, "vram.toml bg_region drifted from engine BG_TILE_BASE_VRAM — edit games/demo/vram.toml and regenerate")
ensure(VRAM_WATERLINE_STRIPS == $B200, "vram.toml waterline_strips drifted from engine VRAM_WATERLINE_STRIPS — edit games/demo/vram.toml and regenerate")
ensure(VRAM_SPRITE_TABLE == $B800, "vram.toml sprite_table drifted from engine VRAM_SPRITE_TABLE — edit games/demo/vram.toml and regenerate")
ensure(VRAM_HSCROLL_TABLE == $BC00, "vram.toml hscroll_table drifted from engine VRAM_HSCROLL_TABLE — edit games/demo/vram.toml and regenerate")
ensure(VRAM_PLANE_A == $C000, "vram.toml plane_a drifted from engine VRAM_PLANE_A — edit games/demo/vram.toml and regenerate")
ensure(VRAM_PLANE_B == $E000, "vram.toml plane_b drifted from engine VRAM_PLANE_B — edit games/demo/vram.toml and regenerate")
ensure(VRAM_WINDOW == $F000, "vram.toml window_plane drifted from engine VRAM_WINDOW — edit games/demo/vram.toml and regenerate")
// Walls — regeneration re-checks every adjacency:
ensure(VRAM_DEMO_OBJ + 4 <= $03E4, "demo_obj runs into ring_placeholder")
// <<< GENERATED: vram map END >>>

// -----------------------------------------------
// Engine-consumed capacity contracts
// -----------------------------------------------
// Ring collision box (ENGINE-invariant; rings.emp keeps its own copy and
// `ensure(extern(..))`-checks it against this authority).
// RING_BUFFER_ENTRY_SIZE and COLLECTED_SLOT_SIZE are NOT declared here: they are
// engine-owned buffer FORMATS no game may vary, homed in engine.constants
// (review item 30/G). Only the COUNTS are game knobs, and those are per-profile
// `-D`s (MAX_RING_BUFFER, COLLECTED_WINDOW_SLOTS).
pub const RING_WIDTH              = 16          // collision AABB pixels

// Rolling collected-window sizing (engine ram.emp cross-checks these).
pub const COLLECTED_PARK_SLOTS      = 4         // park entries (rolling overwrite)
pub const COLLECTED_PARK_ENTRY_SIZE = 1 + 2 * COLLECTED_MASK_BYTES // 33 — id byte + collected + killed masks (byte-packed)
