// Player frame skeleton — state machine, dispatch, shared services (§5)
//
// Owns the player frame: debug-fly escape → physics table (a4) →
// quadrant → jump buffer → state dispatch → history rings → display tail.
// The state bodies live in player_ground.asm / player_air.asm (reached
// only via the Player_States offset table below); characters contribute
// asset/physics data + ability states (sonic.emp) — never forks inside
// shared routines (spec §3.1 inversion of the sonic_hack split).
//
// Lives in the object code bank: Player_Main is dispatched through
// SST_code_addr via a code_addr = label − ObjCodeBase store.
//
// KEYSTONE NOTE: player_common.asm keeps an INTERNAL gate — its zero-byte
// header (the PlayerV struct, the _pl_*/PPHYS_* equates, and the four macros)
// stays ALWAYS-EMITTED so the surviving player_ground/air/spindash still resolve
// it; only the code span sits under SIGIL_EMP_PLAYER_COMMON. This module IS that
// code span; the overlay + macro templates below are its .emp-side counterparts,
// drift-locked to the surviving AS header.
module games.sonic4.player_common in player_common

use engine.objects.sst.{Sst}
use engine.structs.{Act}
use engine.coords.{pixels_to_coord}
use engine.objects.objdef.{vram_art}
use engine.constants.{RF_PRIORITY_SHIFT, ST_IN_AIR, BUTTON_LEFT, BUTTON_RIGHT, SECTION_SIZE_SHIFT, SCREEN_HEIGHT}
use engine.types.{VramTile}

// Player_AtLedgeEdge — player_sensors' idle-balance ledge probe (returns d0=0/Z
// set = supported, d0=1/Z clear = teetering). Boundary decl for the surviving-AS
// player_sensors, which ports at P4; the call resolves cross-seam today, becomes
// module-to-module once sensors port. KILL ROW: delete this decl when P4 lands.
extern proc Player_AtLedgeEdge (a0: *Sst) clobbers(d0-d5/a1-a2)

// PlayerState — the state-handler routine type the Player_States table dispatches
// (PState_Ground/Roll/Spindash/Air/Jump/RollJump/AirBall, surviving player_ground/
// air/spindash). Preserves a0 (RunObjects); clobbers d0-d7 — the handlers clobber
// d7 internally (via Player_SensorFloor), which is why Player_Main brackets the
// dispatch with a `move.w d7,-(sp)` / `move.w (sp)+,d7` word save/restore that
// preserves the RunObjects slot counter (d7 is a WORD there).
type PlayerState = proc (a0: *Sst) preserves(a0) clobbers(d0-d7, a1-a4)

// PlayerHook — the enter/exit hook routine type (PHook_*, this module). Hooks
// preserve a0/d0/d7 (their contract); the dispatch's d1/a1 + the hook's d2/a2 are
// the clobber set.
type PlayerHook = proc (a0: *Sst) preserves(a0) clobbers(d1-d2, a1-a2)

// ── game-config mirrors (config/constants.asm + config/sound_ids.asm) ────────
// The .emp const cannot be seen by the gate-off AS build (row-54 class); each
// drift guard makes an AS-side change loud.
const PSTATE_GROUND   = 0
const PSTATE_ROLL     = 2
const PSTATE_SPINDASH = 4
const PSTATE_AIR      = 6
const PSTATE_JUMP     = 8
const PSTATE_ROLLJUMP = 10
const PSTATE_AIRBALL  = 12
const PSTATE_COUNT    = 7
ensure(extern("PSTATE_GROUND")   == PSTATE_GROUND,   "config/constants.asm PSTATE_GROUND drifted")
ensure(extern("PSTATE_ROLL")     == PSTATE_ROLL,     "config/constants.asm PSTATE_ROLL drifted")
ensure(extern("PSTATE_SPINDASH") == PSTATE_SPINDASH, "config/constants.asm PSTATE_SPINDASH drifted")
ensure(extern("PSTATE_AIR")      == PSTATE_AIR,      "config/constants.asm PSTATE_AIR drifted")
ensure(extern("PSTATE_JUMP")     == PSTATE_JUMP,     "config/constants.asm PSTATE_JUMP drifted")
ensure(extern("PSTATE_ROLLJUMP") == PSTATE_ROLLJUMP, "config/constants.asm PSTATE_ROLLJUMP drifted")
ensure(extern("PSTATE_AIRBALL")  == PSTATE_AIRBALL,  "config/constants.asm PSTATE_AIRBALL drifted")
ensure(extern("PSTATE_COUNT")    == PSTATE_COUNT,    "config/constants.asm PSTATE_COUNT drifted")

