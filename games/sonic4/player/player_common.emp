// Player frame skeleton — state machine, dispatch, shared services (§5)
//
// Owns the player frame: debug-fly escape → physics table (a4) →
// quadrant → jump buffer → state dispatch → history rings → display tail.
// The state bodies live in player_ground.asm / player_air.asm (reached
// only via the Player_States offset table below); characters contribute
// asset/physics data + ability states through the roster (characters.emp,
// sonic.emp) — never forks inside shared routines (spec §3.1 inversion of
// the sonic_hack split).
//
// Lives in the object code bank: Player_Main is dispatched through
// SST_code_addr via a code_addr = label − ObjCodeBase store.
//
// This module OWNS the player frame outright — player_common.asm is deleted. The
// PlayerV overlay, the PBLK_* / BUTTON_JUMP_MASK / PLAYER_DEBUG_FLY_SPEED consts,
// the four macro→comptime-fn templates, and the code span all live here; the state
// files (player_ground/air/spindash) reach them by module `use`, and engine.camera
// late-binds the one `_pl_state` offset through the link.
module games.sonic4.player_common in player_common

use engine.objects.sst.{Sst, set_priority_band, size_wh_off}
use engine.structs.{Act, CharacterDef, cd_stand_h_off, cd_roll_h_off}
use engine.coords.{pixels_to_coord, abs_w}
use engine.objects.objdef.{vram_art}
use engine.constants.{NUM_PLAYERS,
        RF_PRIORITY_SHIFT, RF_PRIORITY_MASK, RF_XFLIP, RF_YFLIP, ST_IN_AIR, BUTTON_LEFT, BUTTON_RIGHT, SECTION_SIZE_SHIFT, SCREEN_HEIGHT,
        PHYS_SKID_MIN, PHYS_JUMP_BUFFER, PHYS_FALL_CAP, PHYS_GSP_CAP,
        ST_ROLLING, ST_PUSHING, ST_XFLIP, COLLISION_NONE, EDGE_WRAP_V, EDGE_KILL, BUTTON_A, BUTTON_B, BUTTON_C,
        BUTTON_UP_BIT, BUTTON_B_BIT, BUTTON_DOWN_BIT, BUTTON_LEFT_BIT, BUTTON_RIGHT_BIT,
        // loop crossover — the read site (Player_LoopCrossover) and its R6 guard block
        LAYER_PATH_A, LAYER_PATH_B, COLL_CELL_W, COLL_CELL_H, TILE_CACHE_COLL_PLANES}
use engine.types.{VramTile}

// PlayerBlock — the per-slot player working block this module's a4 convention
// addresses; config/ram.emp is its sole author.
use games.sonic4.ram.{PlayerBlock}

// Player_AtLedgeEdge — player_sensors' idle-balance ledge probe (returns d0=0/Z
// set = supported, d0=1/Z clear = teetering) — resolves module-to-module to
// player_sensors.emp (bare link, no extern-proc decl).

// PlayerState — the state-handler routine type the Player_States table dispatches
// (PState_Ground/Roll/Spindash/Air/Jump/RollJump/AirBall, surviving player_ground/
// air/spindash). Preserves a0 (RunObjects); clobbers d0-d7 — the handlers clobber
// d7 internally (via Player_SensorFloor), which is why Player_Main brackets the
// dispatch with a `move.w d7,-(sp)` / `move.w (sp)+,d7` word save/restore that
// preserves the RunObjects slot counter (d7 is a WORD there).
type PlayerState = proc (a0: *Sst) preserves(a0) clobbers(d0-d7, a1-a4)

// PlayerHook — the enter/exit hook routine type (PHook_*, this module). Hooks
// preserve a0/d0/d7 (their contract); the dispatch's d1/a1 + the hook's d2/a2 are
// the clobber set.
type PlayerHook = proc (a0: *Sst) preserves(a0) clobbers(d1-d2, a1-a2)

// AbilityHook (the per-character jump-press hook type), CharacterDefs (the
// roster), Ability_None and the two record readers Player_InitAssets /
// Player_LoadArt live in characters.emp — the frame does not own the cast.
// Player_Init, Player_DebugExit and Player_Display reach them as bare link refs.

// Game-config constants — the sole authority is games.sonic4.constants
// (config/constants.emp). VRAM_TEST_MARKER is the tile-1016 debug-fly marker.
use games.sonic4.constants.{
    PSTATE_GROUND, PSTATE_ROLL, PSTATE_SPINDASH, PSTATE_AIR, PSTATE_JUMP,
    PSTATE_ROLLJUMP, PSTATE_AIRBALL, PSTATE_FLY,
    PSTATE_GLIDE, PSTATE_GLIDEFALL, PSTATE_SLIDE, PSTATE_CLIMB, PSTATE_LEDGE, PSTATE_COUNT,
    ANIM_WALK, ANIM_RUN, ANIM_ROLL, ANIM_SPINDASH, ANIM_PUSH, ANIM_IDLE,
    ANIM_BALANCE, ANIM_LOOKUP, ANIM_DUCK, ANIM_SKID, ANIM_GETUP,
    ANIM_FLY, ANIM_FLY_TIRED,
    ANIM_GLIDE_0, ANIM_GLIDEFALL, ANIM_SLIDE, ANIM_CLIMB, ANIM_LEDGE,
    ANIM_RUN_THRESHOLD, VRAM_TEST_MARKER, CHEAT_DEBUG_FLY, CHAR_COUNT,
    PLAYER_PRIORITY_BAND,
    // loop crossover value encoding (docs/LOOP_CROSSOVER_ENCODING.md §3.2)
    XOVER_NONE, XOVER_TO_A, XOVER_TO_B, XOVER_LAYER_BIAS
}

// Sound id — sole authority is games.sonic4.sound_ids.
use games.sonic4.sound_ids.{SFXID_SKID}

// PHYS_* / radii / CURL / ST_* / COLLISION_NONE / EDGE_* / BUTTON_A/B/C /
// BUTTON_*_BIT are consumed from engine.constants via the
// `use engine.constants.{...}` above.

// -----------------------------------------------
// PlayerV — the SST overlay (research structure-refs §2.2 budget: 26 of 30
// usable bytes — the sst_custom window is 32 bytes at $30 and its tail word
// $4E-$4F is the engine-owned SST_interact).
// This module owns the overlay outright (player_common.asm deleted); the
// state files reach the fields through the imported PlayerV struct, so no `_pl_*`
// mirror equate survives (only the link-exported `_pl_state` offset for camera).
// The overlay's always-on window-overflow check subsumes the AS objvarsCheck /
// SST_interact collision assert.
// -----------------------------------------------
pub vars PlayerV: Sst.sst_custom {
        ground_speed:     i16,          // inertia — single source of truth on ground
        player_state:     u8,           // PSTATE_* (jump-table byte offset)
        status_secondary: u8,           // reserved condition bits (speedshoes etc.) — 0 for now
        move_lock:        u16,          // input-freeze frames (slip/spring channel)
        spindash_charge:  u16,          // spindash rev accumulator (release converts charge→gsp)
        flip_angle:       u8,           // reserved (visual rotation)
        air_left:         u8,           // reserved (no water yet)
        invuln_time:      u8,           // reserved
        stick_convex:     u8,           // flag: full terrain adherence (objects will set)
        debug_flag:       u8,           // nonzero = debug-fly (suspends state dispatch)
        skid_latch:       u8,           // nonzero = hold the skid pose (display latch)
        getup_timer:      u8,           // >0 = play ANIM_GETUP one-shot, counts down
        look_offset:      u8,           // camera look/duck pan seam — stays 0 this pass
        jump_headroom:    u8,           // press-frame ceiling clearance carried into
                                        // the same tick's air body; MUST be zero at
                                        // tick end (replay-hash discipline)
        even_pad:         u8,           // pad — keeps the overlay even

        // --- ABILITY SCRATCH: the per-character airborne-ability working set.
        // These two bytes are a UNION, not Tails' private property: exactly one
        // character is resident per slot (Player_Chardef is the single resolved
        // record), so Knuckles' glide/climb and any later ability re-use the same
        // bytes under their own names rather than each claiming fresh ones. The
        // language cannot express the union as byte-SHARING (every overlay starts at
        // $30), so the fields are declared in place and this reads as a budget
        // principle; the window has 30 game-usable bytes and PlayerV now spends 26.
        //
        // REPLAY-HASH DISCIPLINE — read this before touching them. The custom
        // window $30..$4D is hashed by engine/system/replay.emp, and the recorded
        // fixtures were captured with SONIC, for whom every byte past the old
        // 18-byte PlayerV hashed as boot-zero. So the contract on this block is
        // stronger than the window's usual "address-free": it is address-free AND
        // SONIC-UNREACHABLE. The only writers are player_fly.emp's
        // Ability_TailsFlight (seeds both) and PState_Fly (steps them), and
        // both are reachable only through CharDef_Tails.cd_ability / PSTATE_FLY.
        // Player_Init deliberately does NOT clear them — a clear is a write, and
        // the whole point is that Sonic's frame never touches these addresses.
        // Seeding is complete at the flight-entry hook instead.
        fly_fuel:         u8,           // flap fuel, ticked on alternate frames (240 at entry,
                                        // 0 = tired). player_fly owns the semantics.
        fly_thrust:       u8,           // flight mode AND the flap's ramp counter in one byte,
                                        // exactly as S3K's double_jump_flag: FLY_COAST (1) =
                                        // coasting, FLY_THRUST_FIRST (2) .. FLY_RAMP_CAP (32)
                                        // = flapping, the value being the flap's frame count.
                                        // One byte because the two facts are one fact — a flap
                                        // IS its ramp — and two would be free to disagree.

        // Knuckles' glide turn angle (S3K's double_jump_property, sonic3k.asm:31677).
        // Signed byte: 0 = facing right, -$80 = facing left; the glide turn steps it
        // ±2/frame toward the held direction (a half turn is 64 frames). x_vel is
        // rebuilt each frame as cos(glide_angle)·gsp>>8, and the glide POSE + facing
        // are derived from it in Player_Animate. Same UNION principle as the flight
        // scratch above (exactly one character is resident, so Knuckles' glide reuses
        // the ability-scratch region under its own name) and the same replay-hash
        // discipline: address-free AND Sonic-UNREACHABLE — the only writers are
        // Ability_KnuxGlide (seeds it) and the glide body (steps it), both reachable
        // only through CharDef_Knuckles.cd_ability / PSTATE_GLIDE, so Sonic's frame
        // never touches this address and Player_Init deliberately does NOT clear it.
        glide_angle:      u8,           // glide turn angle (S3K double_jump_property)

        // Knuckles' climb + ledge scratch (Task 11), same UNION principle + replay-hash
        // discipline as glide_angle above (only Knuckles' climb writes them; Sonic's
        // frame never reaches these addresses, so Player_Init does NOT clear them).
        knux_step:        u8,           // climb anim countdown (1 frame / 4) AND the ledge
                                        // cursor (S3K double_jump_property doing double duty —
                                        // the states are disjoint, so one byte is exactly right)
        knux_timer:       u8,           // ledge-step frame timer — our own, because AnimateSprite
                                        // owns Sst.anim_timer (S3K reuses anim_frame_timer)
        climb_pad:        u8,           // pad — keeps knux_latch_x word-aligned
        knux_latch_x:     i16,          // world X at the wall catch — the climb detaches if x_pos
                                        // drifts off it (something pushed Knuckles off the wall).
                                        // FLOATING-ORIGIN HAZARD: this is a WORLD coordinate. When
                                        // the floating-origin rebase lands it MUST join the
                                        // shift-list, or every rebase during a climb trips the
                                        // drift guard and drops Knuckles off the wall (same class
                                        // as the Player_Pos_Ring note in Task 8).

        // Sonic's insta-shield one-shot (games/sonic4/player/player_instashield.emp):
        // INSTASHIELD_READY / _ATTACKING / _SPENT — S3K's double_jump_flag values,
        // and the same three-value machine (config/constants.emp owns the names).
        //
        // THE ONE BYTE IN THIS BLOCK THAT IS SONIC-REACHABLE, so the replay-hash
        // paragraph above does NOT cover it. The other five are address-free AND
        // Sonic-unreachable, which is exactly what lets Player_Init skip clearing
        // them; this one is written on Sonic's own path, so it is cleared like the
        // rest of his state — at init and on every landing (PHook_GroundEnter /
        // PHook_RollEnter). Both clears write 0 over 0 on any tick where no
        // insta-shield fired, and the replay hash folds VALUES, so a recorded
        // fixture moves only where an insta-shield actually happens.
        //
        // A NEW field rather than a rename of fly_thrust (Tails' flap ramp — and
        // S3K's double_jump_flag for HIM): the union principle above says a later
        // ability re-uses these bytes, but the language cannot express the sharing
        // and all five existing ones are declared in place, so this follows the
        // precedent instead of making one name wrong for two characters. Appended
        // at the TAIL, so no existing overlay offset moves. 26 -> 27 of 30.
        instashield:      u8,           // 0 ready / 1 attacking / 2 spent (per airborne stretch)
}
// _pl_state — the player-state byte's SST-custom offset, link-exported for
// engine.camera's GAME_CAMERA_JUMP_LOCK probe (`extern("Player_1") +
// extern("_pl_state")`, the sound_api extern-equ-sum idiom: an engine module
// late-binds this game offset through the link rather than a game `use`). This
// module OWNS PlayerV now (player_common.asm deleted), so it also owns the offset
// symbol; the state files reach the fields via the imported PlayerV struct, so no
// other `_pl_*` offset needs a link symbol.
equ _pl_state = offsetof(Sst, sst_custom) + offsetof(PlayerV, player_state)

// Sub-field displacement consts — the 16.16 subpixel low words (LevelBound
// clears them). `Sst.field + N` does not compose inside a displacement, so name
// the offset (the Act_grid_w_lo precedent).
const SST_x_pos_sub = offsetof(Sst, x_pos) + 2
const SST_y_pos_sub = offsetof(Sst, y_pos) + 2

// -----------------------------------------------
// Jump press sources — the SOLE authority for both consumers (ruled 2026-08-05,
// docs/DEFERRED_WORK.md). Classic Sonic jumps on all three face buttons, so the
// default mask is A|B|C. B falls back out of it ONLY while CHEAT_DEBUG_FLY is
// armed, because there B owns the free-flight toggle instead.
//
// Two sites consume these and MUST stay in lockstep: the press latch in
// Player_Main below, and the variable-jump-height HELD check in
// player_air.PState_AirShared. A mask that latches a jump but does not sustain it
// gives B-jumps a clipped arc — hence one definition, imported by both.
// -----------------------------------------------
pub const BUTTON_JUMP_MASK      = BUTTON_A | BUTTON_B | BUTTON_C
pub const BUTTON_JUMP_MASK_NO_B = BUTTON_A | BUTTON_C   // while the cheat owns B

const PLAYER_DEBUG_FLY_SPEED = 16       // px/frame — matched to CAM_MAX_Y_STEP

// -----------------------------------------------
// GROUND-ANGLE SPRITE TILT — the frame geometry Player_ApplyTilt indexes.
//
// Every shipped character sheet carries the walk cycle FOUR times over and the
// run cycle FOUR times over, at four stored orientations 45 deg apart; the other
// four of the eight visual orientations are reached by flipping BOTH axes. This
// is S3K's layout verbatim (Animate_Sonic, sonic3k.asm:24808-24872) and it
// arrived with the donor art — the walk blocks occupy mapping frames $01-$08,
// $09-$10, $11-$18, $19-$20 and the run blocks $21-$24, $25-$28, $29-$2C,
// $2D-$30, which is exactly what our Walk/Run scripts' frame bytes (7 8 1..6 and
// $21..$24, byte-identical to S&K's AniSonic00/AniSonic01) sit at the base of.
//
// TILT_SETS is not a free parameter: it is fixed at 4 by the `andi.w #3` that
// extracts bits 5-6 of the biased angle, and the ensure below pins the block
// arithmetic those two shift counts encode.
const TILT_SETS         = 4                     // stored orientations per cycle
const TILT_WALK_BASE    = $01                   // lowest WALK frame  (block 0)
const TILT_WALK_LEN     = 8                     // frames per WALK block
const TILT_RUN_BASE     = $21                   // lowest RUN frame   (block 0)
const TILT_RUN_LEN      = 4                     // frames per RUN block
const TILT_WALK_SHIFT   = 3                     // lsl to turn block 0..3 into a WALK offset
const TILT_RUN_SHIFT    = 2                     // ... and into a RUN offset
const TILT_BIAS         = $10                   // +22.5 deg: snap to NEAREST, not floor
const TILT_FLIP_PAIR    = (1 << RF_XFLIP) | (1 << RF_YFLIP)     // 180 deg
const TILT_FLIP_CLEAR   = $FF - TILT_FLIP_PAIR

// The shift counts ARE the block lengths — spelled as shifts because the offset
// is `block << shift` and a `mulu` here would be indefensible (§2.1). Pinned so a
// re-paged sheet that changed a cycle length fails the build instead of indexing
// into an unrelated frame.
ensure(1 << TILT_WALK_SHIFT == TILT_WALK_LEN, "TILT_WALK_SHIFT no longer encodes TILT_WALK_LEN")
ensure(1 << TILT_RUN_SHIFT  == TILT_RUN_LEN,  "TILT_RUN_SHIFT no longer encodes TILT_RUN_LEN")

// The four walk blocks must tile the span that ENDS where the run blocks begin —
// this is the one structural claim about the sheet the code depends on, and it is
// checkable from the four constants alone.
ensure(TILT_WALK_BASE + TILT_SETS * TILT_WALK_LEN == TILT_RUN_BASE,
       "the WALK blocks no longer end where the RUN blocks begin — the character sheets were re-paged; re-cut TILT_*_BASE/LEN")

// Player_ApplyTilt's gate is a single `cmpi.b #ANIM_RUN / bhi`, and its
// walk-vs-run stride pick is a bare `tst.b` — both only work while WALK and RUN
// are the two lowest, adjacent anim ids. Nothing else in the tree depends on
// that, so it is pinned here rather than assumed.
ensure(ANIM_WALK == 0, "ANIM_WALK is no longer 0 — Player_ApplyTilt's `tst.b` stride pick is invalid")
ensure(ANIM_RUN == ANIM_WALK + 1, "ANIM_RUN is no longer ANIM_WALK+1 — Player_ApplyTilt's single-compare gate would admit or drop an anim")

// player-block field displacements (a4-relative). File-local hand-typed literals,
// matching the PBLK_* convention in player_ground/player_air; the ensures below
// bind THESE two to the PlayerBlock layout, so a drifted offset fails the build
// rather than surfacing as a mismatched instruction byte in the region gate.
//
// PBLK_JUMPBUF is deliberately NOT spelled PBLK_JUMP_BUFFER, breaking the
// otherwise-exact field-name mapping (PBLK_TOP_SPEED <-> PlayerBlock.top_speed).
// The engine constant PHYS_JUMP_BUFFER is one character away, and the two appear
// on the SAME LINE in the latch below (`move.b #PHYS_JUMP_BUFFER, PBLK_JUMPBUF(a4)`)
// — near-identical names sitting adjacent is a misreading waiting to happen.
// Keep the abbreviation.
const PBLK_QUADRANT  = 16
const PBLK_JUMPBUF   = 17
const PBLK_DUSTTIMER = 18
const PBLK_XOVERCELL = 20
const PBLK_XOVERCURSOR = 24
// The two halves of each packed cell id, addressed separately by the sweep's per-axis
// legs. Derived, not typed, so a re-packing that swaps the halves cannot leave one of
// four displacements pointing at the wrong word.
const PBLK_XOVERCELL_Y   = PBLK_XOVERCELL + 2
const PBLK_XOVERCURSOR_Y = PBLK_XOVERCURSOR + 2

// -----------------------------------------------
// player_block — point a register at the CALLING SLOT's PlayerBlock
// (config/ram.emp: the 8-word physics row + quadrant + jump buffer).
//
// THIS IS THE WHOLE PER-SLOT MECHANISM. Player_Main resolves the slot once per
// frame into a4 and every downstream site — the state bodies, the sensor stack,
// Player_SnapToSurface — addresses the block a4-relative. No slot index is
// carried in a register and no access site does arithmetic; making the state
// per-slot was an addressing-mode change at each site, not a logic change.
//
// WHY A COMPARE AND NOT AN INDEX: the slot index is (sst − Object_RAM) /
// sizeof(Sst), and sizeof(Sst) is $50 — not a power of two — so that division
// needs a `divu`, which the conventions forbid outright (§2.1). With two slots a
// single compare against Player_1 is both exact and cheaper. That is an
// assumption about NUM_PLAYERS, so it is asserted at build time immediately
// below rather than left to be discovered by a third slot silently reading slot
// 1's block.
//
// The stride is sizeof(PlayerBlock), so the slot arithmetic cannot disagree with
// the RAM layout — there is no separate size constant to keep in sync, and no
// adjacency to assert: `Player_Blocks` IS the contiguous run.
//
// Hygienic `.blk_resolved` label per expansion (the mask_opposing_lr / abs_w
// splice pattern), so the expansion sites don't collide. NOTE for consumers
// outside this module: the body expands in the CALLER's scope, so the caller
// must also `use games.sonic4.ram.{PlayerBlock}` — test_player does.
// In:  sst = register holding the player SST (preserved)
// Out: dst = that slot's PlayerBlock
// Clobbers: CCR — the `cmpa.w` leaves the compare's flags, not the caller's.
//      Both expansion sites are flag-independent at the splice, but this file
//      deliberately carries flags across instruction boundaries elsewhere
//      (player_ground's `btst` into a later `bpl`), so it is stated.
// -----------------------------------------------
pub comptime fn player_block(sst: Reg, dst: Reg) -> Code {
        return asm {
                lea     Player_Blocks, {dst}            // slot 0 (the leader)
                cmpa.w  #Player_1, {sst}
                beq     .blk_resolved
                lea     sizeof(PlayerBlock)({dst}), {dst}
        .blk_resolved:
        }
}
ensure(NUM_PLAYERS == 2,
       "player_block's compare-against-Player_1 slot derivation assumes exactly two player slots")
// Both `cmpa.w #Player_1` sites (the splice above and Player_Main's ring gate)
// compare a SIGN-EXTENDED word against a full address register. That is correct
// only while Player_1 lives in the w-addressable window, where bit 15 is set and
// the extension reproduces $FFFFxxxx. Move Object_RAM down into lower_ram
// ($FFFF0000..$FFFF8000, not w_addressable) and the `lea` would still lower to
// abs.l while the compare tested a sign-CLEARED value — never equal. The failure
// is silent and severe: every slot would resolve to block 1 (re-introducing the
// exact single-block bug this parcel removes) and the ring gate would never fire.
ensure((extern("Player_1") & $FFFF8000) == $FFFF8000,
       "player_block + the ring gate use cmpa.w — Player_1 must sign-extend from a word, i.e. live in the w-addressable window ($FFFF8000+)")
// The two hand-typed displacements above, bound to the type that owns the layout.
ensure(PBLK_QUADRANT == offsetof(PlayerBlock, quadrant),
       "PBLK_QUADRANT out of sync with PlayerBlock.quadrant (config/ram.emp)")
ensure(PBLK_JUMPBUF == offsetof(PlayerBlock, jump_buffer),
       "PBLK_JUMPBUF out of sync with PlayerBlock.jump_buffer (config/ram.emp)")
ensure(PBLK_DUSTTIMER == offsetof(PlayerBlock, dust_timer),
       "PBLK_DUSTTIMER out of sync with PlayerBlock.dust_timer (config/ram.emp)")
ensure(PBLK_XOVERCELL == offsetof(PlayerBlock, xover_cell),
       "PBLK_XOVERCELL out of sync with PlayerBlock.xover_cell (config/ram.emp)")
// The crossover cell id is read and written with move.l/cmp.l, so BOTH slots' copies
// must be even — the field's own offset and the array stride. sizeof(PlayerBlock)
// being even is already the `pad` byte's job; this is the half that pad cannot state,
// because a field can sit at an odd offset inside an even-sized struct.
ensure(PBLK_XOVERCURSOR == offsetof(PlayerBlock, xover_cursor),
       "PBLK_XOVERCURSOR out of sync with PlayerBlock.xover_cursor (config/ram.emp)")
ensure((PBLK_XOVERCELL & 1) == 0,
       "PlayerBlock.xover_cell is at an ODD offset — Player_LoopCrossover's move.l/cmp.l pair would ADDRESS ERROR on slot 0; re-order the byte fields above it")
ensure((PBLK_XOVERCURSOR & 1) == 0,
       "PlayerBlock.xover_cursor is at an ODD offset — the sweep's move.l/cmp.l pair would ADDRESS ERROR on slot 0; re-order the byte fields above it")
ensure((sizeof(PlayerBlock) & 1) == 0,
       "sizeof(PlayerBlock) is ODD — slot 1's xover_cell (and its whole physics row) would land on an odd address; restore the pad byte in config/ram.emp")

// -----------------------------------------------
// LOOP CROSSOVER — rule R6 of docs/LOOP_CROSSOVER_ENCODING.md §7, plus the two facts
// the edge trigger's `andi.l` depends on. This is the guard block the anchor asked for,
// and it lives HERE because §7 R6 says "at the read site" and EMP_PITFALLS §3 says a
// guard in an unreachable module is dead — player_common is on every sonic4 shape's
// link, so these evaluate.
// -----------------------------------------------
// The packed cell-id mask, derived from the collision cell footprint rather than typed:
// $10000 - W is the two's-complement "clear the low log2(W) bits" mask for a word.
const XOVER_CELL_MASK = (($10000 - COLL_CELL_W) << 16) | ($10000 - COLL_CELL_H)
// A mask can only express the quantisation if the cell is a power of two on each axis.
// It is (8 x 16), and the derivation in engine.constants folds it from the block
// collision format — but a block format that stopped dividing evenly would produce a
// non-power-of-two here and the mask would silently quantise to the wrong grid.
ensure((COLL_CELL_W & (COLL_CELL_W - 1)) == 0,
       "COLL_CELL_W is {COLL_CELL_W}, not a power of two — Player_LoopCrossover quantises the cell id with an AND mask, which cannot express a non-power-of-two cell width")
ensure((COLL_CELL_H & (COLL_CELL_H - 1)) == 0,
       "COLL_CELL_H is {COLL_CELL_H}, not a power of two — Player_LoopCrossover quantises the cell id with an AND mask, which cannot express a non-power-of-two cell height")
ensure(XOVER_CELL_MASK == $FFF8FFF0,
       "the collision cell footprint moved: the crossover edge trigger's mask derives to {XOVER_CELL_MASK} instead of $FFF8FFF0. That is not necessarily wrong, but Player_LoopCrossover's cost note and the loop_crossover_gate fixture both quote the 8x16 grid — re-check both before re-pinning this number")

// -----------------------------------------------
// THE SWEEP'S REACH — the horizontal twin of PHYS_FALL_CAP's own `ensure`.
//
// PHYS_FALL_CAP is $F00 = 15 px against a COLL_CELL_H of 16: deliberately ONE PIXEL
// under one cell, guarded in engine/system/constants.emp by an `ensure` that says
// straight out what a whole-cell fall step would do ("can begin flush on the thinnest
// floor the world can express and end below it, tunnelling through"). The X axis has
// no such cap and cannot be given one — the horizontal budget IS PHYS_GSP_CAP, 16
// px/frame, against a COLL_CELL_W of 8, and `ObjectMove` (engine/objects/core.emp) is
// a single unconditional add with no substepping anywhere. Lowering the ground-speed
// cap to 8 px/frame would close the hole by making the game slower, which is not a
// trade worth making for a collision-lookup detail.
//
// So the read site SWEEPS instead of sampling, and these are the bounds it sweeps
// between. XOVER_STEP_MAX_* is the largest displacement one frame can put on each
// axis; XOVER_SWEEP_REACH_* is that rounded up to a whole number of cells, which is
// the most the two quantised endpoints can ever be apart. Every one of them is
// DERIVED from the physics caps — nothing here is a number that can go stale silently
// while the cap it describes moves.
const XOVER_STEP_MAX_X    = PHYS_GSP_CAP >> 8           // 16 px: the ground-speed cap
                                                        // is the only bound on a
                                                        // horizontal step
const XOVER_STEP_MAX_Y    = PHYS_GSP_CAP >> 8           // 16 px: a ground step on a
                                                        // vertical wall decomposes the
                                                        // WHOLE of the ground speed
                                                        // onto Y, which is above the
                                                        // air fall cap (the ensure
                                                        // below is what states that)
const XOVER_SWEEP_CELLS_X = (XOVER_STEP_MAX_X + COLL_CELL_W - 1) / COLL_CELL_W   // 2
const XOVER_SWEEP_CELLS_Y = (XOVER_STEP_MAX_Y + COLL_CELL_H - 1) / COLL_CELL_H   // 1
const XOVER_SWEEP_REACH_X = XOVER_SWEEP_CELLS_X * COLL_CELL_W                    // 16 px
const XOVER_SWEEP_REACH_Y = XOVER_SWEEP_CELLS_Y * COLL_CELL_H                    // 16 px
// The reach test is one UNSIGNED compare per axis, not two signed ones: bias the
// signed delta by +REACH and the whole legal band becomes [0, 2*REACH], so a value
// below -REACH wraps to a large unsigned and fails the same `bhi` that catches one
// above +REACH. 8 cycles and 4 bytes an axis cheaper than the pair of signed tests,
// and it cannot disagree with itself about where the band ends.
const XOVER_SWEEP_SPAN_X  = XOVER_SWEEP_REACH_X * 2
const XOVER_SWEEP_SPAN_Y  = XOVER_SWEEP_REACH_Y * 2

// THE GUARD, in the direction that matters: the sweep must reach at least as far as a
// frame can move. A step longer than the reach is treated as a discontinuity and only
// its endpoint is read — correct for a teleport, and a silently reopened tunnelling
// hole for anything that is actually a run.
ensure(XOVER_SWEEP_REACH_X >= XOVER_STEP_MAX_X,
       "the crossover sweep reaches {XOVER_SWEEP_REACH_X} px on X but one frame can move {XOVER_STEP_MAX_X} px — a step longer than the reach snaps to its endpoint, so a one-cell mark inside the gap is stepped over and never fires. This is the horizontal twin of PHYS_FALL_CAP's ensure in engine/system/constants.emp")
ensure(XOVER_SWEEP_REACH_Y >= XOVER_STEP_MAX_Y,
       "the crossover sweep reaches {XOVER_SWEEP_REACH_Y} px on Y but one frame can move {XOVER_STEP_MAX_Y} px — see the X ensure above; the same hole, on the other axis")
ensure(XOVER_STEP_MAX_Y >= (PHYS_FALL_CAP >> 8),
       "PHYS_FALL_CAP is now {PHYS_FALL_CAP >> 8} px/frame, ABOVE the ground-speed cap XOVER_STEP_MAX_Y derives from — a falling frame can out-step the crossover sweep. Re-derive XOVER_STEP_MAX_Y from whichever cap is now the larger")
// ... and in the direction that pays for it. Every cell the walk visits costs one
// Collision_GetType, and the walk advances BOTH axes on every iteration, so the probe
// count is the LARGER of the two per-axis reaches in cells, not their sum. That is
// also why a one-cell diagonal step still costs exactly one probe — the same as the
// pre-sweep routine — and why the extra cost lands only on steps that genuinely cross
// more than one cell. Player_LoopCrossover's cost note quotes these bounds; the
// `ensure`s are what stop the note going stale without anyone re-measuring it.
ensure(XOVER_SWEEP_CELLS_X <= 2,
       "the crossover sweep can now walk {XOVER_SWEEP_CELLS_X} cells of X in one frame per player, not 2 — that is a per-frame cost change in the shared player preamble. Re-measure the cost block on Player_LoopCrossover from the listing and re-pin this bound")
ensure(XOVER_SWEEP_CELLS_Y <= 2,
       "the crossover sweep can now walk {XOVER_SWEEP_CELLS_Y} cells of Y in one frame per player, not 2 — see the X bound above; the same cost, on the other axis")

// R6 — THE ENGINE MUST NOT RE-DERIVE THE ENCODING'S MAPPING. The read site's whole
// value->layer step is one `subq.b #XOVER_LAYER_BIAS`; these bind that immediate to
// the two encodings it sits between, so changing either end fails the build here
// instead of sending a player to the wrong plane.
ensure(XOVER_NONE == 0,
       "XOVER_NONE is no longer 0 — Player_LoopCrossover's `beq` straight after the CrossoverTable fetch IS the no-crossover test, and a non-zero XOVER_NONE would make every unmarked cell fire")
ensure(XOVER_TO_A - XOVER_LAYER_BIAS == LAYER_PATH_A,
       "XOVER_TO_A - XOVER_LAYER_BIAS is {XOVER_TO_A - XOVER_LAYER_BIAS}, not LAYER_PATH_A ({LAYER_PATH_A}) — the read site's subq would put a to-path-A crossover on the wrong collision plane")
ensure(XOVER_TO_B - XOVER_LAYER_BIAS == LAYER_PATH_B,
       "XOVER_TO_B - XOVER_LAYER_BIAS is {XOVER_TO_B - XOVER_LAYER_BIAS}, not LAYER_PATH_B ({LAYER_PATH_B}) — the read site's subq would put a to-path-B crossover on the wrong collision plane")
ensure(XOVER_TO_B == XOVER_TO_A + 1,
       "the two crossover values are no longer adjacent, so ONE subtraction can no longer map the whole set — Player_LoopCrossover needs a table or a branch, not a wider bias")
// The layer byte is written unconditionally from the subtraction, so the encoding must
// not be able to produce a layer the collision lookup cannot select. Two planes exist
// (TILE_CACHE_COLL_PLANES), and Collision_GetType selects between them with `tst.b d3`.
ensure(TILE_CACHE_COLL_PLANES == 2,
       "there are no longer exactly two collision planes — Collision_GetType's tst.b/beq plane select and the crossover's two-value encoding both assume 2")

// -----------------------------------------------
// set_standing_size / set_ball_size — the two collision boxes, taken from the
// ACTIVE CHARACTER's record. cd_stand_wh / cd_roll_wh are packed W<<8|H exactly
// so a box is one aligned word store over the adjacent width_pixels/
// height_pixels pair (size_wh_off, engine.objects.sst) — a character's box is
// data, never a constant, so a second character is a record and not a branch.
// Sizes are FULL dims (2r+1); the sensors halve by lsr → Sonic stands 9/19 and
// balls 7/14 (the classic radii), Tails stands 9/15 (S3K default_y_radius $F).
// The enter hooks are the ONE writer of these fields and of the paired
// curl y-shift (spec §3.3).
// In: sst = player SST register, def = register already holding the resolved
//     CharacterDef (Player_Chardef) — loaded at the call site so the hooks share
//     the one load with their curled-test
// -----------------------------------------------
pub comptime fn set_standing_size(sst: Reg, def: Reg) -> Code {
        return asm {
                move.w  CharacterDef.cd_stand_wh({def}), size_wh_off()({sst})
        }
}

pub comptime fn set_ball_size(sst: Reg, def: Reg) -> Code {
        return asm {
                move.w  CharacterDef.cd_roll_wh({def}), size_wh_off()({sst})
        }
}

// set_ability_size — the THIRD box (Knuckles' glide/slide/climb 10x10), the exact
// peer of the two splices above. cd_ability_wh is 0 for a character with no ability
// box, but the only writer (PHook_EnsureAbility) is reachable only through
// Ability_KnuxGlide, so a 0-box character never reaches this.
pub comptime fn set_ability_size(sst: Reg, def: Reg) -> Code {
        return asm {
                move.w  CharacterDef.cd_ability_wh({def}), size_wh_off()({sst})
        }
}

// -----------------------------------------------
// curl_head_rise / curl_y_shift — the curl GEOMETRY, derived from the two boxes
// in the active character's record for the same reason the boxes themselves are:
// it is a property of the character, not of the engine. S3K computes exactly
// this pair per character (`y_radius - default_y_radius`, sonic3k.asm) rather
// than using a constant.
//
// Uncurling raises the head by the full height difference; the centre moves by
// HALF of it, which is what keeps the feet planted. Sonic 10/5 (the values the
// retired engine-wide CURL_Y_SHIFT hardcoded), Tails 2/1. curl_shift_px is also
// what Player_RefreshPhysics publishes to the camera (Camera_Curl_Offset), so
// all five consumers share one formula.
//
// The subtraction cannot borrow — no character's ball is taller than its
// standing box — so the byte result reaches the word/long users clean off the
// `moveq`.
// In:  def = register holding the resolved CharacterDef
// Out: dest.w = full height difference (the standing head rise, px)
// -----------------------------------------------
pub comptime fn curl_head_rise(def: Reg, dest: Reg) -> Code {
        return asm {
                moveq   #0, {dest}
                move.b  cd_stand_h_off()({def}), {dest}
                sub.b   cd_roll_h_off()({def}), {dest}
        }
}

// Out: dest.w = the curl y-shift in PIXELS (half the head rise) — what the
//      rolling wall probe subtracts to get back to the standing centre height
pub comptime fn curl_shift_px(def: Reg, dest: Reg) -> Code {
        return asm {
                curl_head_rise({def}, {dest})
                lsr.b   #1, {dest}
        }
}

// Out: dest.l = the curl y-shift as a 16.16 delta (shift<<16), ready to add to
//      (curl) or subtract from (uncurl) y_pos
pub comptime fn curl_y_shift(def: Reg, dest: Reg) -> Code {
        return asm {
                curl_shift_px({def}, {dest})
                swap    {dest}                  // px -> 16.16 (low word is the
                                                // moveq's zero)
        }
}

// -----------------------------------------------
// mask_opposing_lr — L+R held together = neither (bug #10). Hygienic .lr_masked
// label per expansion (the AS macro's fixed label, splice-hygienic here). The
// .emp counterpart of the maskOpposingLR AS macro; consumers are the surviving
// player_ground (×2) / player_air (×1) — this module defines it for P2/P3, does
// not expand it itself. Lockstep twin of the AS macro.
// In: held = data register holding the held-button bits (masked to LEFT|RIGHT,
//     zeroed when both are down)
// -----------------------------------------------
pub comptime fn mask_opposing_lr(held: Reg) -> Code {
        return asm {
                andi.b  #BUTTON_LEFT|BUTTON_RIGHT, {held}
                cmpi.b  #BUTTON_LEFT|BUTTON_RIGHT, {held}
                bne     .lr_masked
                moveq   #0, {held}
        .lr_masked:
        }
}

// -----------------------------------------------
// dist_to_fix — widen a signed pixel distance (.w) into a 16.16 delta (dist<<16)
// for adding to the x_pos/y_pos longwords. The .emp counterpart of the distToFix
// AS macro; a bare pixels_to_coord splice (engine.coords, kill row 49): swap moves
// the .w pixel value into the high word and clr.w zeroes the fraction. No sign
// extension is needed — the high word of v is discarded by swap+clr.w regardless
// of its contents, so the promotion is independent of v's incoming high word.
// In:  v.w = signed px distance
// Out: v.l = dist<<16
// -----------------------------------------------
pub comptime fn dist_to_fix(v: Reg) -> Code {
        return pixels_to_coord(v)
}

// -----------------------------------------------
// abs_w — the |v| in-place idiom (bpl/neg.w), a corpus-wide engine idiom
// (engine.coords), not a game one. Consumed via `use engine.coords.{abs_w}` above.
// -----------------------------------------------
// Player_Init — set up a player slot as the active CHARACTER (called from level
// state init; caller writes x_pos/y_pos first). The roster lookup happens HERE
// and only here: Character_ID selects a CharacterDef, the resolved record is
// cached in Player_Chardef, and every later dispatch site reads that cache.
//
// Boots into DEBUG-FLY when CHEAT_DEBUG_FLY is armed — the debug shape arms it
// at game init, so the streaming-test workflow
// still starts in the yellow square and B drops into physics. With the cheat
// clear (the release/lean default) the player boots as a PLAYER: this returns
// normally with the slot in PSTATE_AIR, dropping to ground on frame 1. Gating
// only the B toggle and not this tail would strand a release player in
// free-flight forever, since B would then be inert.
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d2, a1-a2 (d2 via Player_SetState's hook dispatch)
// -----------------------------------------------
pub proc Player_Init (a0: *Sst) clobbers(d0-d2/a1-a2) {
        // roster resolve — the ONE place a character id becomes a record pointer
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.w  Character_ID, d0
        assert.w d0, ls, #CHAR_COUNT-1          // id in roster range
        lsl.w   #2, d0                          // × sizeof(pointer); no scaled
                                                // indexing on the 68000
        lea     CharacterDefs, a1
        movea.l (a1,d0.w), a1
        move.l  a1, Player_Chardef
        set_standing_size(a0, a1)               // the box is part of the record —
                                                // taken here, while the resolve
                                                // still has it in hand
        jbsr    Player_InitAssets
        move.b  #ANIM_IDLE, anim(a0)            // Player_Display re-selects per frame
        move.b  #$FF, prev_anim(a0)
        move.b  #$FF, prev_frame(a0)
        set_priority_band(PLAYER_PRIORITY_BAND) // C1c idiom: clear-then-set. NAMED because the
                                                // effect dust derives its band from this one
                                                // (config/constants.emp: dust = player + 1, with
                                                // an ensure) — S3K composites the dust OVER the
                                                // character, and a bare literal here let that
                                                // relationship drift silently.
        move.b  #COLLISION_NONE, collision_resp(a0)
        clr.b   status(a0)
        clr.b   angle(a0)
        clr.b   layer(a0)
        clr.w   PlayerV.ground_speed(a0)
        clr.w   PlayerV.move_lock(a0)
        clr.w   PlayerV.spindash_charge(a0)
        clr.b   PlayerV.status_secondary(a0)
        clr.b   PlayerV.stick_convex(a0)
        clr.b   PlayerV.skid_latch(a0)
        clr.b   PlayerV.getup_timer(a0)
        clr.b   PlayerV.instashield(a0)         // Sonic-reachable ability state: cleared
                                                // here like the rest of his per-slot
                                                // state, so an act entered while a flash
                                                // was running does not start SPENT
        clr.b   PlayerV.look_offset(a0)
        clr.b   PlayerV.player_state(a0)        // defined start for SetState's exit lookup
        moveq   #PSTATE_AIR, d0                 // drop to ground on frame 1
        jbsr    Player_SetState
        player_block(a0, a2)                    // this slot's block — Refresh writes its row
        jbsr    Player_RefreshPhysics
        move.w  #Player_Main - ObjCodeBase, code_addr(a0)
        // Boot-entry into debug-fly rides the SAME runtime cheat bit as the B
        // toggle in Player_Main — one gate, one story for an auditor.
        moveq   #CHEAT_DEBUG_FLY, d0
        and.b   Cheat_Flags, d0                 // (Cheat_Flags).w — runtime cheat gate
        bne     Player_DebugEnter               // armed: tail-call, its rts returns to our caller
        rts                                     // clear: normal player (PSTATE_AIR, lands frame 1)
}

// -----------------------------------------------
// Player_RefreshPhysics — recompute ONE slot's effective physics row in RAM.
// Identity modifier today: straight copy of the active character's base row
// (CharacterDef.cd_phys). Section/water/speed-shoes modifiers compose HERE
// later — called on section change and status events, NEVER per-frame
// (spec §3.4).
//
// Takes the slot's block pointer rather than re-deriving one: the row it writes
// is per-slot (C1), and every caller already has the SST in hand, so `player_block`
// at the call site keeps the derivation in one place instead of two.
//
// ALSO the game's one write of the engine's Camera_Curl_Offset (engine/ram.emp),
// and it lives here because this is the CHOKEPOINT for a character change:
// Player_Chardef has exactly two writers — Player_Init's roster resolve and the
// debug character hotkey — and both call this immediately after, while this is
// called from nowhere else. So the cell cannot go stale behind a character swap,
// which would hand the new character the old one's compensation: the same bug
// the per-character curl derivation exists to kill. Unlike the physics row the
// value is per-CHARACTER, not per-slot, which costs nothing while Player_Chardef
// is itself one global — when characters go per-slot, the cell follows whichever
// slot Camera_Target names, and both move together.
// In:  a2 = the slot's PlayerBlock (player_block); reads Player_Chardef
// Out: none
// Clobbers: d0, a1-a2
// -----------------------------------------------
pub proc Player_RefreshPhysics (a2: *PlayerBlock) clobbers(d0/a1-a2) {
        movea.l Player_Chardef, a1
        curl_shift_px(a1, d0)                   // the camera's curl compensation:
        move.w  d0, Camera_Curl_Offset          // one formula, shared with the
                                                // hooks and the ceiling probes
        movea.l CharacterDef.cd_phys(a1), a1
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+

        // --- the per-character CRAM line 0 (cd_palette) ---
        //
        // Here for the same reason Camera_Curl_Offset is: this proc is the
        // CHOKEPOINT for a character change. Player_Chardef has exactly two
        // writers (Player_Init's roster resolve and the debug character hotkey)
        // and both call this immediately after, while nothing else calls it — so
        // the palette cannot go stale behind a swap.
        //
        // Per-CHARACTER, not per-slot: there is one CRAM line 0, so unlike the
        // physics row above this write is not indexed by a2. When a follower makes
        // characters per-slot, this follows whichever slot Camera_Target names —
        // and at that point two characters needing different line 0s is a real
        // conflict, which is the foreclosure noted at the field in structs.emp.
        //
        // Costs ~20 bytes and runs TWICE in a normal session (init + a hotkey
        // press), never per-frame. Fits the existing clobbers(d0/a1-a2) contract —
        // a1/a2/d0 are all spent by this point — so no caller changes and a0
        // survives, which ojz_scroll_test's hotkey tail call depends on.
        movea.l Player_Chardef, a1              // re-load: the phys copy consumed a1
        movea.l CharacterDef.cd_palette(a1), a1
        move.l  a1, d0
        beq     .no_pal                         // 0 = inherit the current line 0
        lea     Palette_Buffer, a2              // (Palette_Buffer).w — CRAM line 0 base
        moveq   #32/4 - 1, d0
    .pal_copy:
        move.l  (a1)+, (a2)+
        dbf     d0, .pal_copy
        ori.b   #1, Palette_Dirty               // (Palette_Dirty).w — bit 0 = line 0;
                                                // the VBlank per-line DMA in
                                                // engine/system/buffers.emp does the rest
    .no_pal:
        rts
}

// -----------------------------------------------
// Player_LoopCrossover — THE PAINTED LAYER TRANSITION.
// docs/LOOP_CROSSOVER_ENCODING.md §5 row 13 and §6 changes (2) (3) (4) (5); rule R6's
// `ensure` is the block above this one.
//
// A crossover is a mark painted into a collision cell that says "an object resolving
// onto me belongs on the OTHER path". The mark rides in the identity of the interned
// attr byte (which is why it cost no per-cell ROM), so reading it is the same one-byte
// lookup the sensors already do, followed by one indexed table read.
//
// (2) ONE LOOKUP PER FRAME, OFF THE PROBE PATH. The sensors issue many speculative
//     probes per frame — both sensors of a pair, the +/-16 extensions, ceiling checks —
//     and any of them can land on a cell the player never resolves onto. A transition
//     fired from one of those would teleport the player between planes for standing
//     near a mark. So the read is here, against x_pos/y_pos: the position the frame
//     actually resolved to, once, per player.
//
// (3) WHERE. The shared per-frame preamble, immediately after the quadrant derive and
//     under the same rule that derive states — it consumes LAST frame's resolved
//     position, and the layer it writes is in place for THIS frame's sensors. NOT in
//     Ground_PostMove, whose SEAM GUARD comment forbids inserting state-specific work
//     between the floor snap and Player_SlopeRepel.
//
// (4) THE EDGE TRIGGER, and why it cannot double-fire. The whole trigger is a compare
//     against PlayerBlock.xover_cell, which holds the world cell the read last ran in.
//     Two properties do the work, and they are different properties:
//       * it is an EQUALITY on a cell id, not a test of the mark's value, so standing
//         on a marked cell re-reads nothing: the id is unchanged and the routine leaves
//         at the first `beq`. A value-derived trigger ("fire when the mark becomes
//         non-zero") would pass that case too, which is why it looks right.
//       * the id is derived from POSITION ONLY — never from the layer, the mark, or
//         anything the fire itself writes. That is what makes the write to Sst.layer
//         unable to re-arm the trigger. The case it protects is not exotic, it is the
//         ORDINARY two-way loop of §3.3: the bottom-centre cell carries XOVER_TO_B on
//         plane A and XOVER_TO_A on plane B, so a trigger that re-armed on the layer
//         change would read the OTHER plane's word at the same cell on the very next
//         frame and flip straight back, every frame, forever.
//     The quantisation is COLL_CELL_W x COLL_CELL_H — exactly Collision_GetType's own
//     partition, derived from the block collision format (engine/system/constants.emp),
//     not a chosen granularity. Coarser would step over a marked cell; finer would
//     re-fire inside one, which for a two-way pair is the ping-pong above.
//
// (4b) AND WHY THAT WAS NOT ENOUGH — the step-over, fixed 2026-09-04. Everything in (4)
//     is about a trigger that fires TOO OFTEN. It says nothing about one that never
//     fires at all, and this one did not, above about 8 px/frame. A mark is ONE cell,
//     COLL_CELL_W is 8 px, PHYS_GSP_CAP is 16 px/frame, and `ObjectMove`
//     (engine/objects/core.emp) is a single unconditional add: horizontal movement is
//     not substepped anywhere. A read taken once against the position the frame
//     RESOLVED to therefore steps clean over a mark it passed through, and the mark
//     never fires.
//
//     Measured 2026-09-04 on the section-0 loop in s4.debug.bin, ground speed injected
//     once at the ramp foot: at $600 (TOP_SPEED, 6 px/frame) three layer flips and a
//     clean ride; at $900 (9 px/frame) the player rides the geometry, MISSES the top
//     mark, comes down the left half still on plane B, and falls through the floor a
//     screen later — the symptom displaced far enough from the cause that a bug report
//     would name the floor; at $1000 (the cap) the mark never fires at all.
//
//     ⚠ THOSE THREE FIGURES ARE OF THE PRE-CROWN-CURVE GEOMETRY AND ARE NOT A CONTROL
//     FOR THIS BUILD. The crown-curve re-bake (67042d2d / e59c5a99) landed after them
//     and moved the arc: on e59c5a99 the same $600 run flips the layer ONCE, not three
//     times (docs/witness/loop-plane-b-exit-2026-09-05.json). They are kept, dated, and
//     labelled because they are what the SWEEP was built against — the step-over
//     conclusion they support is about the READ SITE and still holds — but do not read
//     them as a description of what the current ROM does.
//
//     The vertical twin of this hole was already closed the other way: PHYS_FALL_CAP is
//     one pixel UNDER COLL_CELL_H so a falling step cannot span a cell. X cannot be
//     capped the same way without making the game slower, so the read SWEEPS: it walks
//     from the cell it last ran in to the cell it resolved to and probes each. Both
//     properties in (4) survive intact, because the walk ADVANCES BEFORE IT PROBES —
//     the cell it swept from is never re-read, so standing still is still the `beq`,
//     and a two-way pair still cannot ping-pong. The reach it walks, and the `ensure`
//     that ties it to the physics caps, are in the constant block above; the gate that
//     grades it is `sweep_step_over` / `sweep_step_over_marks` in
//     tools/loop_crossover_gate.py, which are RED on the pre-sweep routine.
//
// (5) THE WRITE. `subq.b #XOVER_LAYER_BIAS` IS the encoding — XOVER_TO_A(1) -> layer 0,
//     XOVER_TO_B(2) -> layer 1 — and the R6 guards bind that one immediate to
//     LAYER_PATH_A / LAYER_PATH_B so the engine does not re-derive the mapping.
//
// (5b) THE DIRECTION GATE — owner ruling 2026-09-05, and the whole subject of this
//     revision. Everything above decides WHICH cell and WHICH plane's word. It said
//     nothing about which WAY the player was going, and that was the defect:
//     docs/witness/loop-plane-b-exit-2026-09-05.json measured every traversal of the
//     section-0 loop toggling the layer exactly ONCE, in both directions, so the
//     player always ended on plane B — which carries only the ground and the RIGHT
//     half — and then fell through the plane-A collision that is most of the level.
//     The cause is that the mark was PLANE-keyed and nothing more. R2 forbids a
//     self-mark, so the bottom-centre cell's plane-A word can only be XOVER_TO_B, and
//     a plane-A player read it whichever way he was travelling: a LEFTWARD entrant was
//     sent onto the right arc, where the half he was about to occupy is not solid.
//
//     THE RULE. Plane B carries the RIGHT half of the arc, plane A the LEFT half, so
//     a mark leading onto B is a rightward-travel mark and one leading onto A is a
//     leftward-travel mark:
//
//         mark        leads onto     fires when x_vel is
//         XOVER_TO_B  right arc (B)  > 0   (travelling right)
//         XOVER_TO_A  left arc  (A)  < 0   (travelling left)
//         either      —              never, when x_vel == 0
//
//     After the subq, d0 IS the plane the mark leads onto, so the test is one compare
//     of d0 against LAYER_PATH_B / LAYER_PATH_A — the same two names the R6 guards
//     bind the subq's immediate to, rather than a second spelling of 0 and 1.
//
//     WHY Sst.x_vel AND NOT PlayerV.ground_speed, which is the other candidate and
//     the one that looks more physical. ground_speed is signed ALONG THE SURFACE;
//     x_vel is signed in SCREEN SPACE, and the ground path rebuilds it every frame as
//     cos(angle)*gsp>>8 (player_ground.emp, the inertia->velocity projection, with an
//     exact angle-0 fast path). Those two agree only while the surface is near flat.
//     THE CASE THAT BREAKS ground_speed IS THE TOP-CENTRE MARK ITSELF: at the top of
//     a loop the player is inverted, angle ~ $80, cos ~ -1, so a player who entered
//     rightward still carries a POSITIVE ground_speed while physically moving LEFT
//     across the apex. A ground_speed-keyed gate would read "travelling right" there
//     and refuse the XOVER_TO_A that hands him the left arc — it would break the exact
//     cell it was meant to serve. x_vel reports left, and fires. The converse case
//     costs nothing: both marked cells sit where |cos(angle)| is at its LARGEST (the
//     bottom centre at angle ~ 0 and the apex at angle ~ $80), so x_vel is at its
//     most decisive precisely where the marks are, and it is the loop's SIDES — where
//     x_vel collapses toward zero — that carry no mark. x_vel is also the only signal
//     that means anything airborne, which §6 change (1) requires ("you can enter a
//     loop's far side airborne").
//
//     AND WHY LAST FRAME'S x_vel IS THE RIGHT ONE, not a stale one. This routine runs
//     in the preamble, before the state dispatch, against the position LAST frame
//     resolved to (see (3)). x_vel at that moment is the velocity that PRODUCED the
//     step the sweep is walking. Pairing the walk with the velocity that made it is
//     exactly right; reading a velocity computed after the dispatch would describe a
//     step that has not happened yet.
//
//     WHERE THE TEST SITS, and it is deliberately NOT hoisted above the walk. x_vel
//     is frame-constant here — this routine writes only Sst.layer and the two
//     PlayerBlock cell fields, so nothing in the walk can change it — which makes a
//     per-cell re-read semantically identical to a hoist. Given that, the cheaper
//     placement wins, and it is the one BELOW the `beq .unmarked`: an unmarked cell
//     is every cell but two in the shipped table, so the walk's hot path does not
//     execute one byte of the gate and the "no mark" cost rows below are unchanged
//     from the pre-gate routine. A true hoist would have paid ~22 cycles on EVERY
//     frame that changed cell — the common case for a running player — to save ~12 on
//     the rare frame that crosses two marked cells. It would also have needed a
//     register to survive Collision_GetType, which clobbers d1-d3 and takes d3 as its
//     plane argument, so the value would have had to live on the stack across the
//     call: more cost, more code, and a stack discipline to get wrong.
//
//     WHAT THIS RULE DOES NOT FIX, stated here because the analysis is done and the
//     next reader should not have to redo it. A CENTRE-placed mark is crossed TWICE
//     by a completing circuit. Leftward from the right of the loop: bottom centre on
//     A moving left (refused, correct — he rides the left arc, which is A), apex on A
//     moving right (fires -> B, rides the right arc), bottom centre on B moving left
//     (fires -> A) — two toggles, exits on A, correct. Rightward: bottom centre on A
//     moving right (fires -> B), apex on B moving left (fires -> A, rides the left
//     arc), and then bottom centre AGAIN on A moving right, which is the same cell,
//     the same plane and the same direction as the entry crossing and therefore fires
//     a THIRD time, leaving him on B as he exits. Entry and exit need opposite answers
//     from inputs that are identical, so no rule keyed on position, plane and
//     direction alone can separate them. The fix is a PAINT change and belongs to the
//     collision lane, not here: Sonic 2's arrangement is a return-to-default swapper
//     past the exit foot. Reported to the owner 2026-09-05; see
//     docs/DEFERRED_WORK.md.
//
// Value 3 is not tested for. The bake refuses it (rule R1, tools/collision_pipeline.py
// bake_plane_cell raises), so it cannot reach CrossoverTable; adding a silent runtime
// clamp here would give the illegal value a quiet meaning, which is the exact thing
// §3.2 reserved it to prevent.
//
// COST, per player per frame. RE-DERIVED 2026-09-05 for the direction gate, and it is
// no longer a table anyone types: `tools/loop_crossover_cost.py` sums it from the
// ENCODINGS this build emitted, by executing the routine in the gate's own micro-CPU
// (capstone-decoded out of s4.debug.bin) and costing every instruction it actually ran
// against the MC68000UM tables. Re-run it after any edit here rather than adjusting a
// number by hand. Guessing is not an option: an earlier draft of this comment put
// Collision_GetType at ~150 and was wrong by a factor of two.
//
// Basis, stated so the rows stay comparable with the pre-gate ones: each figure
// includes the caller's `bsr.w` (18), and none of them model the bus contention a real
// Mega Drive imposes on the 68000 — every row is a FLOOR for the CPU's own work.
//
//   same cell (the whole steady state)                                        106
//   cell changed, position off the tile cache (GetType's air exit, 58)        580
//   cell changed, one cell of X, no mark (plane A / plane B)              794 / 800
//   cell changed, one cell DIAGONALLY, no mark (plane A)                      830
//   cell changed, one cell, FIRES rightward (TO_B on plane A)                 862
//   cell changed, one cell, FIRES leftward (TO_A on plane B)                  852
//   cell changed, one cell, REFUSED by direction (TO_A going right)           848
//   cell changed, one cell, REFUSED by direction (TO_B going left)            836
//   cell changed, one cell, REFUSED by direction (x_vel == 0)                 818
//   a discontinuity — teleport/respawn/act start — snapped to one probe       750
//   TWO cells of X in one frame (>8 px/frame: the step-over the sweep exists
//     for), no mark / marked field firing on both                     1348 / 1490
//
// HOW MUCH OF THAT IS TRUSTWORTHY, and the answer is checkable rather than asserted.
// The summer reproduces three figures the previous note derived independently and by a
// different route, EXACTLY: the steady state (106), Collision_GetType's whole body
// (292), and its early air exit (58). The composite rows differ from the previous
// note's by -16..+50 — those were scenario differences, not timing ones, and the old
// scenarios were not recorded closely enough to reconcile, so that attribution is an
// inference and is flagged as one. The three anchors are the measurement.
//
// WHAT THE DIRECTION GATE COST. Nothing at all on the two rows that matter most: the
// steady state is unchanged at 106, and a frame that changes cell WITHOUT meeting a
// mark is unchanged, because the whole gate lives below the `beq .unmarked`. The cost
// lands only where a mark is actually met — +54 cycles on a rightward fire, +46 on a
// leftward one, and +34/+36 where the gate REFUSES a mark (which also skips the
// 12-cycle layer write, so a refusal is cheaper than a fire). Two marked slots exist in
// the whole shipped table, so this is a cost on the loop and on nothing else.
//
// WHAT THE SWEEP COST AND WHAT IT DID NOT. The steady state is 106 — the same figure,
// instruction for instruction, as before the sweep: the `beq` on the cell id still
// leaves before a byte of the walk is reached, so a standing or sub-cell-moving player
// pays nothing at all. The diagonal case is why the walk advances both axes together
// rather than turning a corner: an ordinary frame on a slope moves one cell on each
// axis and still costs ONE probe (830), where an L-shaped path would have cost two.
//
// Two players at 60 Hz against a ~127,800-cycle NTSC frame: 0.17% standing still,
// 1.24% on a frame where both changed cell, 2.11% in the two-cell case that only
// happens above 8 px/frame. A player running at speed changes cell most frames, so
// 1.24% is the honest running figure. 204 bytes of code (was 182), measured from the
// listing.
//
// The cheap gate that is NOT here, named so it is a decision and not an oversight:
// a per-act "this act has crossovers" flag would collapse the whole per-frame cost to
// about 12 cycles for any act that has none — but that flag does not exist, it is a
// bake-side field, and adding one here would be a second encoding shipped ahead of its
// first user. Booked in docs/DEFERRED_WORK.md instead. NOTE that the premise this
// paragraph used to rest on has expired: the shipped CrossoverTable now holds TWO
// marked slots (the section-0 loop), so the cost is no longer buying nothing, and the
// flag is a saving for OTHER acts rather than for every act.
//
// In:  a0 = player SST, a4 = this slot's PlayerBlock
// Out: none
// Clobbers: d0-d3, a1 (d1-d3/a0 via Collision_GetType — a0 is saved across it here,
//           exactly as probe_core does). a4 and d4-d7 are untouched: Player_Main holds
//           the block in a4 and the frame's press bits in d6 across this call.
// -----------------------------------------------
pub proc Player_LoopCrossover (a0: *Sst, a4: *PlayerBlock) clobbers(d0-d3/a1) preserves(a0, a4) {
        // The cell id, in three instructions: x_pos's HIGH word is the pixel X (the low
        // word is sub-pixel), so one move.l lands X where it belongs and one move.w
        // drops pixel Y in beside it. The mask then quantises both halves at once.
        move.l  x_pos(a0), d0                   // X px in the high word, sub-px in the low
        move.w  y_pos(a0), d0                   // Y px into the low word
        andi.l  #XOVER_CELL_MASK, d0            // -> the world cell, one long
        cmp.l   PBLK_XOVERCELL(a4), d0
        beq     .done                           // same cell — THE edge trigger, and the
                                                // whole steady state: not one byte of
                                                // the sweep below is reached from here
        move.l  PBLK_XOVERCELL(a4), d1          // the cell the last sweep ENDED on
        move.l  d0, PBLK_XOVERCELL(a4)          // ... and from here on, THE DESTINATION

        // --- IS THE GAP WALKABLE? ----------------------------------------------
        // Two signed word deltas against the reaches derived above. A step inside the
        // reach is a RUN the player traversed and gets walked cell by cell; a step
        // beyond it is a discontinuity and only its endpoint is read. Word arithmetic
        // throughout, so a world coordinate that wraps $FFFF->$0000 still yields the
        // right sign and magnitude and the walk still lands on the destination exactly.
        move.w  d0, d3
        sub.w   d1, d3                          // dY = destY - prevY
        addi.w  #XOVER_SWEEP_REACH_Y, d3        // bias into [0, 2*REACH] — see the
        cmpi.w  #XOVER_SWEEP_SPAN_Y, d3         // constant block: ONE unsigned compare
        bhi     .snap                           // catches both ends of the band
        swap    d0
        swap    d1
        move.w  d0, d3
        sub.w   d1, d3                          // dX = destX - prevX
        addi.w  #XOVER_SWEEP_REACH_X, d3
        cmpi.w  #XOVER_SWEEP_SPAN_X, d3
        bhi     .snap_hi
        swap    d1
        move.l  d1, PBLK_XOVERCURSOR(a4)        // the walk starts on the cell we swept
        bra     .walk                           // FROM — and advances before it probes,
                                                // so that cell is never re-read

    .snap_hi:
        swap    d0                              // the X leg arrives here with d0 swapped
    .snap:
        // A DISCONTINUITY, not a run: a teleport, a respawn, the first frame of an act,
        // or a launcher faster than the reach the physics caps derive. There is no path
        // between the two cells for the player to have crossed, so the cursor starts AT
        // the destination and the walk below makes exactly the one lookup this routine
        // made before it swept — the right answer for a move that did not traverse the
        // space, which is why this is a snap and not a clamp.
        move.l  d0, PBLK_XOVERCURSOR(a4)

    .walk:
        // ONE CELL PER ITERATION, ON BOTH AXES AT ONCE — a diagonal walk from the cell
        // we swept from to the cell we resolved to, each axis advancing until it
        // arrives. The probe count is therefore max(|dX|,|dY|) in cells, NOT their sum,
        // and the case that matters most is the consequence: a one-cell diagonal step —
        // an ordinary frame on a slope — still costs exactly ONE probe, the same as the
        // routine cost before it swept. Only a step that genuinely crosses more than one
        // cell pays for a second.
        //
        // The path visits every column index between the endpoints and every row index
        // between them, so a mark painted as a BARRIER ACROSS THE PATH — which is what a
        // loop crossover is — cannot end up on the far side of it. It is NOT a
        // supercover: an isolated single cell that the true segment only clips the corner
        // of can still be missed, and that is stated here rather than left to be
        // discovered. `sweep_step_over` in tools/loop_crossover_gate.py grades exactly
        // the property claimed and says the same thing about what it does not prove.
        //
        // The direction is RE-DERIVED per axis per iteration instead of being carried,
        // because carrying it costs a second RAM long and the derivation is three
        // instructions. The cursor is the only state, and it is the only thing that
        // moves, so the loop cannot desynchronise from it.
        move.w  PBLK_XOVERCELL(a4), d0          // destination X
        move.w  PBLK_XOVERCURSOR(a4), d1        // cursor X
        sub.w   d1, d0                          // ... still to go on X
        beq     .x_settled
        bmi     .x_back
        addi.w  #COLL_CELL_W, d1
        bra     .x_store
    .x_back:
        subi.w  #COLL_CELL_W, d1
    .x_store:
        move.w  d1, PBLK_XOVERCURSOR(a4)
    .x_settled:
        move.w  d1, d2                          // hold this cell's X px across the Y leg
        move.w  PBLK_XOVERCELL_Y(a4), d0        // destination Y
        move.w  PBLK_XOVERCURSOR_Y(a4), d1      // cursor Y
        sub.w   d1, d0                          // ... still to go on Y
        beq     .y_settled
        bmi     .y_back
        addi.w  #COLL_CELL_H, d1
        bra     .y_store
    .y_back:
        subi.w  #COLL_CELL_H, d1
    .y_store:
        move.w  d1, PBLK_XOVERCURSOR_Y(a4)
    .y_settled:
        move.w  d2, d0                          // d0 = this cell's X px, d1 = its Y px.
                                                // Both axes settled and unmoved is THE
                                                // destination probe, which every walk
                                                // ends on and a snapped one consists of.

        // d0/d1 are the cursor's own halves, so "the cell the walk is standing on" and
        // "the cell the lookup fetches" are the same value by construction rather than
        // by two reads agreeing. The low bits being clear is provably free:
        // Collision_GetType does `lsr.w #3` on X (so bits 2:0 never survive) and
        // `lsr.w #3` then `lsr.w #1` on Y, and forcing Y's bit 3 low only selects the
        // EVEN tile row of the pair the halving folds together — which lands on the
        // same collision row, because Cache_Top_Row is even and the subtraction between
        // them preserves that.
        move.b  layer(a0), d3                   // read the mark from the plane we are ON
                                                // (§3.3: a plane's mark is only ever
                                                // read by an object already on it, which
                                                // is what makes one painted pair serve
                                                // both directions of travel). Re-read
                                                // per cell on purpose: a fire earlier in
                                                // the walk changes which plane the rest
                                                // of the walk reads, exactly as it would
                                                // have frame by frame at a lower speed.
        move.l  a0, -(sp)                       // Collision_GetType clobbers a0
        jbsr    Collision_GetType               // d0.b = attr index (0 = air / off-cache)
        movea.l (sp)+, a0
        moveq   #0, d1
        move.b  d0, d1                          // zero-extend: GetType's solid path is a
                                                // `move.b` into d0 and leaves the upper
                                                // bits dirty (only its air path moveq's)
        lea     CrossoverTable, a1
        move.b  (a1, d1.w), d0
        beq     .unmarked                       // XOVER_NONE — all but two slots of the
                                                // shipped table, today
        subq.b  #XOVER_LAYER_BIAS, d0           // d0 = the plane this mark LEADS ONTO

        // --- THE DIRECTION GATE (5b). A mark fires only when the player's
        // screen-space horizontal travel matches the arc the mark leads onto: the
        // right arc is solid on path B, the left arc on path A, so TO_B is a
        // rightward-only mark and TO_A a leftward-only one. Sst.x_vel is the signal
        // and the long comment above says why; zero means no arc is being entered
        // and nothing fires. Bound to the LAYER_PATH_* names rather than to 0/1 so
        // this reads the same encoding the R6 `ensure` pair binds the subq to.
        move.w  x_vel(a0), d1                   // last frame's velocity — the one that
                                                // produced the step this walk is
                                                // WALKING; flags set by the move
        beq     .unmarked                       // no horizontal travel, no arc entered
        bmi     .dir_left
        cmpi.b  #LAYER_PATH_B, d0               // travelling RIGHT: only a mark leading
        bne     .unmarked                       // onto the RIGHT arc may fire
        bra     .fire
    .dir_left:
        cmpi.b  #LAYER_PATH_A, d0               // travelling LEFT: only a mark leading
        bne     .unmarked                       // onto the LEFT arc may fire
    .fire:
        move.b  d0, layer(a0)
    .unmarked:
        move.l  PBLK_XOVERCURSOR(a4), d0
        cmp.l   PBLK_XOVERCELL(a4), d0
        bne     .walk
    .done:
        rts
}

// -----------------------------------------------
// Player_Main — per-frame player update (RunObjects entry)
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d6, a1-a4 (a0 preserved — RunObjects loop contract).
// Preserves: d7.w — the RunObjects slot counter is a word, and the state dispatch
//   brackets Player_SensorFloor (which clobbers the full d7) with a
//   `move.w d7,-(sp)` / `move.w (sp)+,d7` save that round-trips d7's LOW WORD.
//   The upper word is unspecified (the `.w` facet licenses clobbering it); every
//   other d7-crossing call (DebugEnter/Exit/Move, LevelBound) and the fall into
//   Player_Display preserve d7, so the low word reaches RunObjects intact.
// -----------------------------------------------
pub proc Player_Main (a0: *Sst) clobbers(d0-d6/a1-a4) preserves(d7.w) falls_into Player_Display {
        // press bits read ONCE for the frame — d6 survives the debug toggle
        // calls (DebugEnter clobbers d2/a1, DebugExit d0-d2/a1-a2) and feeds both
        // the B-toggle and the jump-buffer latch
        move.b  Ctrl_1_Press, d6
        // --- debug-fly toggle (B press), behind the CHEAT_DEBUG_FLY gate ---
        // Debug-fly is a CHEAT, not debug equipment: the payload
        // (Player_DebugEnter/Exit/Move) SHIPS in every build shape and is simply
        // UNREACHABLE until the bit is set. Equipment is gated at BUILD time and
        // absent from release; a cheat is gated at RUNTIME and present but
        // unreachable (CODING_CONVENTIONS §1.7). Cheat_Flags is boot-cleared with
        // all Work-RAM, so release/lean start with B doing nothing here; the DEBUG
        // shape arms the bit at game init, and a cheat code (button sequence, menu
        // unlock) will arm it in release with NO code change. Boot-ENTRY into
        // debug-fly (Player_Init's tail) is gated on the same bit, so a release
        // player boots as a player and B leaves them one; there is no state where
        // half the gate applies. Auditors: these bytes in a release ROM are
        // deliberate cheat payload, not a debug leak.
        btst    #BUTTON_B_BIT, d6
        beq     .no_toggle
        moveq   #CHEAT_DEBUG_FLY, d0
        and.b   Cheat_Flags, d0                 // (Cheat_Flags).w — runtime cheat gate
        beq     .no_toggle                      // cheat off: B is inert (d6 untouched)
        tst.b   PlayerV.debug_flag(a0)
        bne     .toggle_exit
        jbsr    Player_DebugEnter
        jbra    .no_toggle
.toggle_exit:
        jbsr    Player_DebugExit
.no_toggle:
        tst.b   PlayerV.debug_flag(a0)
        bne     Player_DebugMove                // obj_control escape hatch:
                                                // skips physics, dispatch and
                                                // the display tail. NOT rings:
                                                // RingCollision is a level-state
                                                // pass that reads the player
                                                // slots from outside, so this
                                                // hatch cannot reach it — the
                                                // debug-fly ring gate lives at
                                                // its CALL SITE (see
                                                // test/ojz_scroll_test.emp)

        player_block(a0, a4)                    // a4 = THIS SLOT's working block —
                                                // resolved once, held for the whole
                                                // frame (physics row + quadrant +
                                                // jump buffer all ride it)

        // quadrant = (angle+$20)>>6 — first-class derived value; computed from
        // LAST frame's angle (classic: angle updates at the floor pair)
        move.b  angle(a0), d0
        addi.b  #$20, d0
        rol.b   #2, d0
        andi.b  #3, d0
        move.b  d0, PBLK_QUADRANT(a4)

        // The painted layer transition (docs/LOOP_CROSSOVER_ENCODING.md §5 row 13),
        // here for the same reason the quadrant derive is here: it is shared per-frame
        // state derived once from the position the last frame resolved to, and it must
        // be in place before the state dispatch's sensors read Sst.layer. See
        // Player_LoopCrossover above for the edge trigger and the cost.
        // d6 (this frame's press bits, read once at the top) is not in its clobber set,
        // so the jump-buffer latch below still sees them.
        jbsr    Player_LoopCrossover

        // jump buffer: latch PHYS_JUMP_BUFFER on a press edge, else tick down.
        // Maintained here; the ground-state jump check CONSUMES it.
        //
        // B IS a jump button — except while the debug-fly cheat owns it. The
        // conflict is on EXITING free-flight, not entering: entering returns early
        // through Player_DebugMove and never reaches this latch, but DebugExit
        // clears debug_flag and falls straight through to normal physics, so the
        // same B press that left free-flight would buffer a jump on that very tick.
        // Hence B is excluded from the mask exactly while CHEAT_DEBUG_FLY is armed.
        //
        // The bit is READ HERE, never cached: a cheat code can arm it on any frame.
        // Cost is on the right side of the hot path — the A|B|C test short-circuits
        // on every frame with no face-button press edge, which is nearly all of
        // them, so the cheat probe only runs on an actual jump press. d0 is dead
        // here (the quadrant it held was stored above), so the moveq/and probe is
        // free of register pressure; it is also the one shape a port-test compile
        // can lower, since `btst #<cheat const>, Cheat_Flags` would pair two link
        // symbols.
        //
        // player_air's variable-jump-height HELD check uses the same two masks and
        // the same gate; they must not drift or a B jump latches without
        // sustaining (clipped arc).
        andi.b  #BUTTON_JUMP_MASK, d6           // A|B|C — classic three-button jump
        beq     .no_latch
        moveq   #CHEAT_DEBUG_FLY, d0
        and.b   Cheat_Flags, d0                 // (Cheat_Flags).w — runtime cheat gate
        beq     .latch                          // cheat clear: B jumps like A and C
        andi.b  #BUTTON_JUMP_MASK_NO_B, d6      // armed: B is the fly toggle, not a jump
        beq     .no_latch
.latch:
        move.b  #PHYS_JUMP_BUFFER, PBLK_JUMPBUF(a4)
        jbra    .buffer_done
.no_latch:
        tst.b   PBLK_JUMPBUF(a4)
        beq     .buffer_done
        subq.b  #1, PBLK_JUMPBUF(a4)
.buffer_done:

        // --- state dispatch. d7 saved across: Player_SensorFloor legitimately
        // clobbers it inside the handlers ---
        move.w  d7, -(sp)
        lea     Player_States(pc), a1
        moveq   #0, d0
        move.b  PlayerV.player_state(a0), d0
        // The value guards in config/constants.emp make every PSTATE_* a valid
        // row at BUILD time; this is the runtime backstop for the byte itself
        // being stomped, which no comptime check can see. Unsigned compare — the
        // moveq above zero-extends the byte.
        assert.w d0, ls, #(PSTATE_COUNT-1)*2    // state byte indexes a real row
        move.w  (a1,d0.w), d1
        jsr     (a1,d1.w) as PlayerState
        move.w  (sp)+, d7

        // --- on-object bit: 1-frame-lagged (TouchResponse runs AFTER this
        // frame; everything in the player tick reads the LIVE bit set by LAST
        // tick's TouchResponse). The per-frame CLEAR lives at the top of
        // TouchResponse's player loop (collision.asm), not here. ---

        jbsr    Player_LevelBound               // classic LevelBound, post-dispatch

        // --- position history rings — LEADER ONLY. This is the trail a follower
        // reads to lag behind the leader, so exactly one slot may write it: two
        // writers would interleave their samples at the 4-byte stride and the ring
        // would describe no player at all. The gate is the same compare the block
        // derivation makes (a4 is not a proxy for it — both slots hold a valid
        // block), and it is one compare per player per frame. Non-leader slots
        // fall straight through to the shared display tail. ---
        cmpa.w  #Player_1, a0
        bne     .rings_done
        move.w  Player_Ring_Index, d0
        lea     Player_Pos_Ring, a1
        move.w  x_pos(a0), (a1,d0.w)
        move.w  y_pos(a0), 2(a1,d0.w)
        lea     Player_Stat_Ring, a1
        move.b  Ctrl_1_Held, d1
        lsl.w   #8, d1
        move.b  Ctrl_1_Press, d1
        move.w  d1, (a1,d0.w)                   // input word (Held<<8|Press)
        move.b  status(a0), 2(a1,d0.w)          // +pad byte left untouched
        addq.b  #4, Player_Ring_Index+1         // (Player_Ring_Index+1).w — low-byte
                                                // wrap; rings are 256-aligned (ram.asm)
.rings_done:
        // fall through to the shared display tail
}

// -----------------------------------------------
// Player_Display — classify the animation, advance it, stream art, draw.
// In:  a0 = player SST
// Clobbers: d0-d6, a1-a3 (d5-d6 via Player_Animate's balance-path ledge probe)
// -----------------------------------------------
pub proc Player_Display (a0: *Sst) clobbers(d0-d6/a1-a3) {
        jbsr    Player_Animate                  // sets SST_anim + d3 (dyn hold)
        jbsr    Dust_Tick                       // AFTER Player_Animate: the
                                                // classifier is what sets and clears
                                                // skid_latch, so reading it earlier
                                                // in the frame reads LAST frame's
                                                // value. a4 is still the slot's block
                                                // (Player_Main holds it for the whole
                                                // frame) and d3 must survive for
                                                // AnimateSprite, so Dust_Tick
                                                // preserves it.
        jbsr    AnimateSprite
        jbsr    Player_ApplyTilt                // AFTER AnimateSprite (it owns
                                                // mapping_frame and the flip pair),
                                                // BEFORE Player_LoadArt (it streams
                                                // the art mapping_frame names)
        jbra    Player_LoadArt
}

// -----------------------------------------------
// Player_ApplyTilt — turn the ground angle into a sprite orientation.
//
// S3K: Animate_Sonic's walk/run branch, `loc_126A4`-`loc_12742`
// (sonic3k.asm:24808-24872), verified in the disassembly. The mechanism is
// (a) pick one of FOUR stored tilted art blocks by the angle's octant, and
// (b) set BOTH render flags for the upper half-turn, which is a 180 deg
// rotation of the block the octant picked. Eight visual orientations, 45 deg
// apart, snapped. It is NOT runtime rotation and it is NOT flips alone.
//
// The arithmetic, transcribed from that routine:
//
//   d = angle;  if (d > 0 && d < $80) d -= 1        // symmetric round bias
//   if (facing RIGHT) d = ~d                        // fold facing INTO the angle
//   d += $10                                        // snap to NEAREST, not floor
//   if (d & $80) flip both axes                     // the upper half-turn
//   block = (d >> 5) & 3                            // bits 5-6 = the octant
//   mapping_frame = script_frame + (block << shift)
//
// The facing fold is the half that is easy to get wrong and hard to see: get the
// `not` on the wrong side of the branch and the tilt is correct running one way
// and mirrored running the other, which reads as correct in half of any test.
// Derived boundary table (facing RIGHT, block/flip): $F0-$10 0/no, $11-$30 3/YES,
// $31-$50 2/YES, $51-$70 1/YES, $71-$8F 0/YES, $90-$AF 3/no, $B0-$CF 2/no,
// $D0-$EF 1/no. Facing LEFT is the mirror: 0,1,2,3 with the flip on the other
// half. tools/test_sprite_tilt.py sweeps all 512 (angle, facing) pairs against
// this and executes the built ROM's own bytes over the same sweep.
//
// FOUR DELIBERATE DEVIATIONS FROM S3K, all forced by our tree:
//
// 1. THE BASE FRAME IS RE-READ FROM THE SCRIPT, NOT ADDED TO. S3K can
//    `add.b d3,mapping_frame(a0)` (:24872) because its Animate_Sonic reaches
//    that write on EVERY frame. Ours does not: AnimateSprite early-outs at
//    `subq.b #1,anim_timer / bpl .done` and leaves mapping_frame carrying last
//    frame's block, so a plain add would compound it every frame and walk off
//    the end of the sheet — and the tilt would also lag the angle by up to the
//    animation hold (8 frames at a slow walk, since the hold is
//    ($800-|gsp|)>>8). Reading the script's own byte back gives the unbanked
//    base on every frame, advancing or not, which makes this idempotent by
//    construction. This is the SAME deviation, for the same reason, that
//    tails_appendage.emp's ball-spin bank already documents — that block is the
//    house precedent and this follows it.
//
// 2. NO TUMBLE GATE. S3K checks flip_type/flip_angle first and diverts to
//    Anim_Tumble (:24932), the somersault off springs and ramps. We have no
//    tumble mechanism, so the gate would guard nothing. The full-360 tumble art
//    IS in our sheets at frames $31/$3D/$49 (519 tiles, referenced by nothing);
//    it falls out of a DIFFERENT selection (divu #$16 on a counter, not an
//    octant of the ground angle) and is a follow-up, not part of this.
//
// 3. PUSH SUPPRESSION IS STRUCTURAL, NOT A TEST. S3K needs `btst #5,status ->
//    loc_12A72` (:24838) because its Animate_Sonic is reached with the walk/run
//    script still selected while pushing, and diverts to AniSonic04 there. Our
//    Player_Animate classifies ANIM_PUSH ahead of walk/run (see its priority
//    comment), so ANIM_WALK/ANIM_RUN are unreachable while ST_PUSHING — the
//    equivalent decision, made one layer earlier. The gate below inherits it.
//
// 4. NO WALK/RUN RE-DERIVE. S3K re-picks AniSonic00 vs AniSonic01 here from
//    |ground_vel| >= $600 and the speed-shoes doubling (:24845-24858). We read
//    the anim id instead, because Player_Animate has ALREADY made that decision
//    (ANIM_RUN_THRESHOLD) and re-deriving it would be a second, drift-prone
//    copy of one rule.
//
// Child sprites do not rotate: Tails' appendage is a separate SST animated
// through the object system on its own table, so it never reaches here. That is
// S3K's shipped look too (a shielded Sonic running a loop has an upright
// shield), not an omission.
//
// In:  a0 = player SST, AnimateSprite already run this frame
// Out: mapping_frame biased into the tilted block and the flip pair re-derived,
//      or both left exactly as AnimateSprite set them when the running anim has
//      no tilted art behind it
// Clobbers: d0-d2, a1 (d2 also via RefreshSpritePieceCount); a0 preserved for
//           Player_LoadArt
// -----------------------------------------------
pub proc Player_ApplyTilt (a0: *Sst) clobbers(d0-d2/a1) preserves(a0) {
        // Only WALK and RUN have tilted blocks behind them. Every other script —
        // skid, duck, push, the idle poses, roll — stays upright on a slope, and
        // S3K has the identical limitation. ANIM_WALK/ANIM_RUN are 0/1 (ensured
        // above), so one unsigned compare is the whole gate.
        //
        // Keying on the ANIM ID and not on the script's duration byte is
        // load-bearing. S3K routes into this path on the script header being
        // $FF and keeps $FE for its speed-picked roll; we reused the one
        // sentinel DUR_DYNAMIC ($FF) for BOTH meanings, so our Roll script heads
        // with the same byte Walk does. Testing the header here would tilt the
        // rolling ball.
        move.b  anim(a0), d0
        cmpi.b  #ANIM_RUN, d0
        bhi     .done

        // --- angle -> orientation (S3K :24811-24840) ---
        moveq   #0, d1                          // d1 = the half-turn flip delta
        move.b  angle(a0), d2
        bmi     .biased                         // upper half: no bias
        beq     .biased                         // exactly flat: no bias
        subq.b  #1, d2                          // bias so the snap rounds symmetrically
.biased:
        move.b  status(a0), d0                  // d0 = the facing bit (anim id re-read below)
        andi.b  #1 << ST_XFLIP, d0
        bne     .faced                          // facing LEFT: the angle is already
                                                // in the sense the art was drawn for
        not.b   d2                              // facing RIGHT: mirror the angle
.faced:
        addi.b  #TILT_BIAS, d2
        bpl     .flip_ready
        moveq   #TILT_FLIP_PAIR, d1             // upper half-turn -> flip BOTH axes
.flip_ready:
        // Re-derive the flip pair rather than OR into what AnimateSprite left.
        // For the tilt the horizontal flip is the facing XORed with the
        // half-turn and the vertical one is the half-turn alone, so plain facing
        // is not the answer on these two scripts. Same shape as S3K's
        // `andi.b #$FC / eor / or` at :24833-24835.
        andi.b  #TILT_FLIP_CLEAR, render_flags(a0)
        eor.b   d1, d0
        or.b    d0, render_flags(a0)

        lsr.b   #5, d2
        andi.w  #TILT_SETS - 1, d2              // d2 = orientation block 0..3
                                                // (bits 5-6 of the biased angle)

        // --- base frame: the byte the running script is on, re-read ---
        // anim_frame indexes the byte AnimateSprite last resolved to a frame (it
        // is post-incremented before the read, and both the AF_END wrap and the
        // anim-change path clear it before re-reading), and that byte already
        // passed AnimateSprite's control-code test — so it is always a real
        // frame index, never a $F7+ command.
        moveq   #0, d1
        move.b  anim(a0), d1
        movea.l anim_table(a0), a1
        add.w   d1, d1
        adda.w  (a1,d1.w), a1                   // a1 = the running script
        moveq   #0, d1
        move.b  anim_frame(a0), d1
        move.b  1(a1,d1.w), d0                  // d0 = the UNTILTED frame

        tst.b   anim(a0)                        // ANIM_WALK == 0 (ensured above)
        bne     .run_stride
        lsl.w   #TILT_WALK_SHIFT, d2            // walk blocks are 8 frames apart
        jbra    .banked
.run_stride:
        lsl.w   #TILT_RUN_SHIFT, d2             // run blocks are 4 frames apart
.banked:
        add.b   d2, d0
        move.b  d0, mapping_frame(a0)

        // mapping_frame moved, so the H1 frame-data cache and the piece count
        // must move with it (sst.emp: "MUST be refreshed on every
        // mapping_frame/mappings write"). Without this the renderer draws the
        // PRE-tilt frame's pieces from the stale offset, and the DEBUG staleness
        // assert in Render_Sprites fires. Unconditional rather than guarded on
        // "did the frame actually move": on flat ground the block is 0 and the
        // write is a no-op, and the six bytes a compare would cost buy ~60
        // cycles out of ~127,000 — the same trade tails_appendage.emp made.
        jbsr    RefreshSpritePieceCount
.done:
        rts
}

// Glide_Pose_Table8 — S3K's RawAni_Knuckles_GlideTurn (sonic3k.asm:31588) expressed
// as pose OFFSETS from ANIM_GLIDE_0 rather than as raw mapping frames ($C0..$C4),
// because our AnimateSprite owns mapping_frame and re-classifies every frame — the
// direct-write trick does not carry over. Player_Animate's glide branch reads it
// pc-relative: index = (glide_angle + $10) >> 5 & 7; the table is symmetric
// (0 1 2 3 4 3 2 1) and offset 4 is the mirror point the classifier flips facing on.
// 8 bytes (even) on an even section, so the following code stays word-aligned with no
// `align` directive — which at this mid-section position would be a provisional pad.
data Glide_Pose_Table8: [u8; 8] = [0, 1, 2, 3, 4, 3, 2, 1]

// -----------------------------------------------
// Player_Animate — read-only animation classifier. Reads state/status/input and
// (at rest) one ledge sensor; writes ONE ANIM_* id to SST_anim and the
// speed-scaled hold to d3. Mutates the display transients skid_latch and
// getup_timer (the get-up one-shot counts down here).
// Priority: spindash > ball > skid > push > (rest: getup > duck > lookup >
// balance > idle) > run/walk.
// In:  a0 = player SST
// Out: SST_anim set; d3.b = dynamic per-anim hold (for DUR_DYNAMIC scripts)
// Clobbers: d0-d6, a1-a2 (d3 is an output; d0-d2/d4 in the body). The balance
//           path additionally trashes d5-d6 via Player_AtLedgeEdge (clobbers
//           d0-d6; d6 = the SOLID_TOP class mask) — caller (Player_Display, a
//           frame-tail routine) keeps no live d5-d6 across this call.
// -----------------------------------------------
pub proc Player_Animate (a0: *Sst) clobbers(d0-d6/a1-a2) {
        // speed-scaled hold for DUR_DYNAMIC scripts (walk/run):
        // hold = max(0,($800-|gsp|)>>8). Computed up front; the ball path
        // RECOMPUTES it from $400 (S3K Animate_Sonic rolls at 4-|gsp|, twice
        // the walk flip rate — sonic3k.asm loc_12A2A `addi.w #$400`). The
        // balance path clobbers d3 (sensor) but leads to a FIXED-duration
        // anim, so it's moot.
        move.w  PlayerV.ground_speed(a0), d0
        abs_w(d0)
        move.w  #$800, d4
        sub.w   d0, d4
        bpl     .hold_ok
        moveq   #0, d4
.hold_ok:
        lsr.w   #8, d4
        move.b  d4, d3

        // SKID LATCH — ONE WRITER, and it is here. Cleared every frame before the
        // classification, re-armed only by .skid_show below.
        //
        // It used to be cleared ONLY on the grounded-uncurled `.skid_drop` path,
        // which nine state-keyed branches return before ever reaching (spindash,
        // fly, glide, glidefall, slide, climb, ledge, the ball path, and airborne-
        // uncurled). So a latch armed on the last grounded frame survived
        // indefinitely, and Dust_Tick — whose skid leg tests the latch guarded by
        // nothing but a PSTATE_SLIDE check — kept emitting ground dust every 4
        // frames through the whole jump arc. Repro was three inputs: run to
        // |gsp| >= PHYS_SKID_MIN, hold the opposing direction, jump while still
        // holding it. Reproduced on oracle (3 DustPuffs trailing a rising player)
        // before this fix.
        clr.b   PlayerV.skid_latch(a0)

        move.b  PlayerV.player_state(a0), d0
        // (1) spindash
        cmpi.b  #PSTATE_SPINDASH, d0
        bne     .not_spindash
        move.b  #ANIM_SPINDASH, anim(a0)
        rts
.not_spindash:
        // (1b) FLIGHT — the second state-keyed pose, and it needs its own branch
        // for the same reason spindash does: flight is AIRBORNE and UNCURLED, so
        // the classification below would fall through to .walk_or_run and animate
        // a flying Tails with the run cycle. Which of the two flight poses plays
        // is the fuel byte, not a separate state: `tired` is the same PSTATE_FLY
        // with the flap disabled (player_fly).
        // Unreachable for any character whose cd_ability cannot enter PSTATE_FLY,
        // which today is everyone but Tails.
        cmpi.b  #PSTATE_FLY, d0
        bne     .not_fly
        tst.b   PlayerV.fly_fuel(a0)
        beq     .fly_tired
        move.b  #ANIM_FLY, anim(a0)
        rts
.fly_tired:
        move.b  #ANIM_FLY_TIRED, anim(a0)
        rts
.not_fly:
        // (1c) KNUCKLES GLIDE / GLIDEFALL / SLIDE — the third state-keyed group,
        // and it needs its own branch for the same reason FLY does: glide is
        // AIRBORNE and UNCURLED, so the classification below would fall through to
        // .walk_or_run and animate a gliding Knuckles with the run cycle. Unreachable
        // for any character whose cd_ability cannot enter these states (everyone but
        // Knuckles). GLIDE also DERIVES FACING from the glide angle here — not from
        // x_vel — so the mirror-point pose lands correctly; nothing else steers a
        // glide (Air_XInput does not run in the glide body).
        cmpi.b  #PSTATE_GLIDE, d0
        bne     .not_glide
        // pose = Glide_Pose_Table8[(glide_angle + $10) >> 5 & 7]; index 4 flips
        // facing and uses pose 0 (S3K Knuckles_Set_Gliding_Animation, :31564-31584:
        // the $C4 table entry is replaced by $C0 + Status_Facing). Facing is cleared
        // first, set only on the mirror index — exactly S3K's bclr-then-conditional-bset.
        bclr    #ST_XFLIP, status(a0)
        move.b  PlayerV.glide_angle(a0), d1
        addi.b  #$10, d1
        lsr.b   #5, d1                          // low-byte >> 5 -> 0..7
        andi.w  #7, d1                          // index hygiene for the pc-relative load
        lea     Glide_Pose_Table8(pc), a1
        move.b  (a1,d1.w), d1                   // d1 = 0..4 (offset from ANIM_GLIDE_0)
        cmpi.b  #4, d1
        bne     .glide_face_set
        bset    #ST_XFLIP, status(a0)           // mirror index -> flip, pose 0
        moveq   #0, d1
.glide_face_set:
        addi.b  #ANIM_GLIDE_0, d1
        move.b  d1, anim(a0)
        rts
.not_glide:
        cmpi.b  #PSTATE_GLIDEFALL, d0
        bne     .not_glidefall
        move.b  #ANIM_GLIDEFALL, anim(a0)
        rts
.not_glidefall:
        cmpi.b  #PSTATE_SLIDE, d0
        bne     .not_slide
        move.b  #ANIM_SLIDE, anim(a0)
        rts
.not_slide:
        // CLIMB / LEDGE — the state body owns mapping_frame directly (it cycles the
        // climb frames $B7..$BC / runs the clamber script and pins anim_timer so
        // AnimateSprite stays on .done). The classifier just anchors `anim` to the
        // matching 1-frame script so prev_anim stabilises after the first frame — the
        // anim-changed path lands the initial frame once, then the body takes over.
        cmpi.b  #PSTATE_CLIMB, d0
        bne     .not_climb
        move.b  #ANIM_CLIMB, anim(a0)
        rts
.not_climb:
        cmpi.b  #PSTATE_LEDGE, d0
        bne     .not_ledge
        move.b  #ANIM_LEDGE, anim(a0)
        rts
.not_ledge:
        // (2) ball: ROLL + curled air (JUMP/ROLLJUMP/AIRBALL). ST_ROLLING IS
        // "in ball form", so the test is the bit, not a state range — which is
        // what retires the PSTATE_* ordering constraint (config/constants.emp).
        // The equivalence is structural, not incidental: PHook_EnsureBall/
        // EnsureStanding are the bit's ONLY writers (both set/clear it
        // UNCONDITIONALLY, outside their height-keyed guard), every state reaches
        // exactly one of them through PState_EnterHooks — Roll/Jump/RollJump/
        // AirBall → EnsureBall, Ground/Air/Spindash → EnsureStanding — and
        // Player_SetState is the only TRANSITION writer of player_state, writing
        // it and running the enter hook with nothing in between. The one other
        // writer is Player_Init's boot `clr.b` (a defined start for SetState's
        // exit lookup, which runs before any hook has), and it does not break the
        // equivalence: the same init block clears `status` a few lines earlier —
        // so ST_ROLLING is 0 — and the byte it writes is 0, which IS the uncurled
        // PSTATE_GROUND, so the pair it leaves behind is exactly the one
        // EnsureStanding would. Init then goes straight through Player_SetState
        // for the real start state. So bit and state agree
        // at every point a frame can observe them, this one included: Player_Animate
        // runs in the display tail, after the dispatch has completed its transitions.
        // (SPINDASH never reaches here — priority 1 above returns — so the fact
        // that it is standing-but-attacking costs nothing either way.)
        btst    #ST_ROLLING, status(a0)
        beq     .uncurled
        // S3K-exact roll hold: max(0,($400-|gsp|)>>8) — the prologue's $800
        // walk hold would spin the ball at HALF the classic rate (Harmony
        // study defect #1). ground_speed is the right input even airborne
        // (S3K reads ground_vel in its roll path too).
        move.w  PlayerV.ground_speed(a0), d4
        abs_w(d4)
        move.w  #$400, d3
        sub.w   d4, d3
        bpl     .roll_hold_ok
        moveq   #0, d3
.roll_hold_ok:
        lsr.w   #8, d3
        move.b  #ANIM_ROLL, anim(a0)
        rts
.uncurled:
        // GROUND or uncurled AIR. Airborne keeps the walk/run cycle; the
        // grounded-only conditions are gated below.
        btst    #ST_IN_AIR, status(a0)
        bne     .walk_or_run

        // (3) skid — grounded, opposing input held, |gsp| >= PHYS_SKID_MIN.
        // Latch holds the pose through the brake WHILE opposing input is held;
        // cleared at rest or when the opposing input is released.
        move.w  PlayerV.ground_speed(a0), d1
        beq     .skid_drop                      // stopped -> clear latch
        move.b  Ctrl_1_Held, d2
        tst.w   d1
        bmi     .skid_left
        btst    #BUTTON_LEFT_BIT, d2            // moving right: opposing = LEFT
        beq     .skid_drop
        jbra    .skid_opposing
.skid_left:
        btst    #BUTTON_RIGHT_BIT, d2           // moving left: opposing = RIGHT
        beq     .skid_drop
.skid_opposing:
        // Once-per-skid SFX edge. This used to read skid_latch, which only worked
        // while the latch survived across frames; now that the latch is cleared
        // every frame (one writer, above) the edge is keyed on the PREVIOUS
        // frame's anim instead — `anim(a0)` still holds last frame's value here,
        // since .skid_show below is what writes it. Same semantics: already
        // skidding -> no new sfx; a skid entered fresh after a jump or a landing
        // correctly re-fires, which the old latch-keyed form also did.
        cmpi.b  #ANIM_SKID, anim(a0)
        beq     .skid_show                      // already skidding -> keep (no new sfx)
        move.w  d1, d2
        abs_w(d2)
        cmpi.w  #PHYS_SKID_MIN, d2
        blo     .not_skid                       // opposing but too slow to arm
        // fresh-arm edge — fire the skid SFX once before latching
        if SOUND_DRIVER_ENABLED == 1 {
                moveq   #SFXID_SKID, d0 as SfxId
                jsr     Sound_PlaySFX           // explicit jsr (kept-width class): the input-6button
                                                // +0xB0 shift put Sound_PlaySFX (debug $81BA) right at
                                                // the bsr.w reach boundary from this bank — jbsr's
                                                // ladder is convergence-history-dependent there (the
                                                // whole-ROM build locks jsr, a standalone lower picks
                                                // bsr.w), so the encoding is PINNED placement-
                                                // independent like every cross-bank call. Byte-equal
                                                // to the converged jbsr in both shapes.
        }
.skid_show:
        st      PlayerV.skid_latch(a0)
        move.b  #ANIM_SKID, anim(a0)
        rts
.skid_drop:
        // (the clear that used to live here is now unconditional at the top of the
        // routine — reaching this label simply means the latch stays clear)
.not_skid:

        // (4) push — grounded, ST_PUSHING (facing-aware bit from ground code)
        btst    #ST_PUSHING, status(a0)
        beq     .not_push
        move.b  #ANIM_PUSH, anim(a0)
        rts
.not_push:
        // rest vs moving
        tst.w   PlayerV.ground_speed(a0)
        bne     .walk_or_run

        // --- at rest ---
        // get-up one-shot: mechanism in place; nothing arms _pl_getup in
        // gameplay this pass (in-game get-up trigger deferred).
        tst.b   PlayerV.getup_timer(a0)
        beq     .rest_input
        subq.b  #1, PlayerV.getup_timer(a0)
        move.b  #ANIM_GETUP, anim(a0)
        rts
.rest_input:
        // (5) duck
        btst    #BUTTON_DOWN_BIT, Ctrl_1_Held
        beq     .not_duck
        move.b  #ANIM_DUCK, anim(a0)
        rts
.not_duck:
        // (6) look up
        btst    #BUTTON_UP_BIT, Ctrl_1_Held
        beq     .not_lookup
        move.b  #ANIM_LOOKUP, anim(a0)
        rts
.not_lookup:
        // (9) balance at a ledge edge — (7)/(8) in the priority table are
        // run/walk, handled below in .walk_or_run (the moving branch)
        jbsr    Player_AtLedgeEdge              // beq = supported
        beq     .idle
        move.b  #ANIM_BALANCE, anim(a0)
        rts
.idle:
        move.b  #ANIM_IDLE, anim(a0)
        rts

.walk_or_run:
        move.w  PlayerV.ground_speed(a0), d1
        abs_w(d1)
        cmpi.w  #ANIM_RUN_THRESHOLD, d1
        blt     .walk
        move.b  #ANIM_RUN, anim(a0)
        rts
.walk:
        move.b  #ANIM_WALK, anim(a0)
        rts
}

// Player_States — the state-handler jump table (§4.7 `offsets`). Each word is
// `handler - Player_States`; the dispatch reads it at `player_state` (a word-
// scaled PSTATE_* byte). The handler targets are bare cross-module link refs
// (L11: bare = cross-module) — PState_* are `pub proc`s in the sibling player
// modules (player_ground/air/spindash). Declaration order is PSTATE_* order;
// `.count` replaces the hand `ensure(7 == PSTATE_COUNT)`.
pub offsets Player_States {
        Ground:   PState_Ground,        // PSTATE_GROUND (player_ground)
        Roll:     PState_Roll,          // PSTATE_ROLL (player_ground)
        Spindash: PState_Spindash,      // PSTATE_SPINDASH (player_spindash)
        Air:      PState_Air,           // PSTATE_AIR (player_air)
        Jump:     PState_Jump,          // PSTATE_JUMP (player_air)
        RollJump: PState_RollJump,      // PSTATE_ROLLJUMP (player_air)
        AirBall:  PState_AirBall,       // PSTATE_AIRBALL (player_air)
        Fly:      PState_Fly,           // PSTATE_FLY (player_fly) — Tails only
        Glide:    PState_Glide,         // PSTATE_GLIDE (player_glide) — Knuckles only
        GlideFall:PState_GlideFall,     // PSTATE_GLIDEFALL (player_glide) — Knuckles only
        Slide:    PState_Slide,         // PSTATE_SLIDE (player_glide) — Knuckles only
        Climb:    PState_Climb,         // PSTATE_CLIMB (player_climb) — Knuckles only
        Ledge:    PState_Ledge,         // PSTATE_LEDGE (player_climb) — Knuckles only
}
ensure(Player_States.count == PSTATE_COUNT, "Player_States table out of sync with PSTATE_*")

// -----------------------------------------------
// Player_SetState — THE one transition writer for player_state.
// Old state's exit hook → write state byte → new state's enter hook.
// In:  a0 = player SST, d0.w = new PSTATE_* (byte offset, word-clean)
// Out: none
// Clobbers: d1, a1 (+ hook clobbers: d2, a2)
// Hooks contract: preserve a0/d0/d7
// -----------------------------------------------
pub proc Player_SetState (a0: *Sst) clobbers(d1-d2/a1-a2) {
        lea     PState_ExitHooks(pc), a1
        moveq   #0, d1
        move.b  PlayerV.player_state(a0), d1
        move.w  (a1,d1.w), d1
        jsr     (a1,d1.w) as PlayerHook
        move.b  d0, PlayerV.player_state(a0)    // written BEFORE the enter hook
        lea     PState_EnterHooks(pc), a1
        move.w  (a1,d0.w), d1
        jmp     (a1,d1.w) as PlayerHook
}

// PState_EnterHooks — the enter-hook jump table (§4.7 `offsets`), indexed like
// Player_States. The PHook_* targets are same-module procs (defined below);
// JUMP/ROLLJUMP/AIRBALL all enter through PHook_AirBallEnter (repeated targets
// are fine — each word is that handler's self-relative offset). `.count`
// replaces the hand `ensure`.
pub offsets PState_EnterHooks {
        Ground:   PHook_GroundEnter,    // GROUND
        Roll:     PHook_RollEnter,      // ROLL
        Spindash: PHook_SpindashEnter,  // SPINDASH
        Air:      PHook_AirEnter,       // AIR (uncurled)
        Jump:     PHook_AirBallEnter,   // JUMP
        RollJump: PHook_AirBallEnter,   // ROLLJUMP
        AirBall:  PHook_AirBallEnter,   // AIRBALL
        Fly:      PHook_AirEnter,       // FLY — uncurled airborne, exactly like AIR.
                                        // The flight ENTRY gate refuses to engage while
                                        // curled, so EnsureStanding is always a no-op
                                        // here; it runs anyway because the hook's job is
                                        // to make the invariant true, not to assume it.
        Glide:    PHook_GlideEnter,     // GLIDE — install the 10x10 ability box (no y-shift),
                                        // uncurl, airborne
        GlideFall:PHook_AirEnter,       // GLIDEFALL — restore the STANDING box (S3K's fall
                                        // runs at default radii) + set airborne. The
                                        // generalised EnsureStanding lifts feet-planted.
        Slide:    PHook_SlideEnter,     // SLIDE — keep the 10x10 ability box, grounded
        Climb:    PHook_ClimbEnter,     // CLIMB — 10x10 ability box, attached to the wall (not airborne)
        Ledge:    PHook_ClimbEnter,     // LEDGE — same box, mid-clamber
}
ensure(PState_EnterHooks.count == PSTATE_COUNT, "PState_EnterHooks table out of sync with PSTATE_*")

// PState_ExitHooks — the exit-hook jump table (§4.7 `offsets`), indexed like
// Player_States. Only SPINDASH has a non-null exit hook (charge→gsp convert);
// every other state exits through PHook_Null. `.count` replaces the hand
// `ensure`.
pub offsets PState_ExitHooks {
        Ground:   PHook_Null,           // GROUND
        Roll:     PHook_Null,           // ROLL
        Spindash: PHook_SpindashExit,   // SPINDASH
        Air:      PHook_Null,           // AIR
        Jump:     PHook_Null,           // JUMP
        RollJump: PHook_Null,           // ROLLJUMP
        AirBall:  PHook_Null,           // AIRBALL
        Fly:      PHook_Null,           // FLY — the flight scratch is seeded on ENTRY
                                        // (Ability_TailsFlight), never on exit: an exit
                                        // hook that cleared it would be a write on the
                                        // path out of every state, and PHook_Null keeps
                                        // this row off Sonic's reachable set entirely.
        Glide:    PHook_Null,           // GLIDE — glide_angle seeded on ENTRY (Ability_KnuxGlide)
        GlideFall:PHook_Null,           // GLIDEFALL
        Slide:    PHook_Null,           // SLIDE
        Climb:    PHook_Null,           // CLIMB — latch/step seeded at the wall catch
        Ledge:    PHook_Null,           // LEDGE
}
ensure(PState_ExitHooks.count == PSTATE_COUNT, "PState_ExitHooks table out of sync with PSTATE_*")

// ===== Enter/exit hooks — the ONE writer for width/height, curl y-shift,
// collision-mode resets, and anim latches (spec §3.3). NOTHING outside these
// hooks may touch those fields — the sole tolerated exception is the debug-fly
// art swap, which sits outside the state machine entirely. Hooks preserve
// a0/d0/d7.
pub proc PHook_Null () clobbers() {
        rts
}

// THE INSTA-SHIELD ONE-SHOT RESETS ON LANDING, in this hook and PHook_RollEnter.
//
// S3K clears double_jump_flag in Player_TouchFloor (sonic3k.asm:24379-24390), one
// routine every landing passes through. Aeon has no such routine — Knuckles' four
// landing paths deliberately bypass the airborne helpers (see the ST_PUSHING note
// below) — but every landing enters a STATE, and for Sonic that state is GROUND or
// ROLL (a down-held landing goes straight to ROLL via Air_LandState). So the two
// enter hooks are the complete set for him, and the clear lives in them.
//
// PHook_SlideEnter and PHook_ClimbEnter are the other two grounded/attached enter
// hooks and deliberately do NOT clear it: both are Knuckles-only, and he has no
// insta-shield. Named here rather than left implicit, so a future Sonic ability that
// can reach them is a conscious change and not a silent one-shot that never resets.
//
// Writing 0 over 0 on every ordinary landing is free of consequence for the replay
// fixtures — the hash folds values, not writes.
pub proc PHook_GroundEnter (a0: *Sst) clobbers(d1-d2/a1) { // d2: EnsureStanding's y-shift calc
        clr.b   PlayerV.instashield(a0)         // landing re-arms the insta-shield
        jbsr    PHook_EnsureStanding            // uncurl (jump/ball landings;
                                                // down-held landings go straight
                                                // to ROLL via Air_LandState)
        bclr    #ST_IN_AIR, status(a0)
        // ST_PUSHING is cleared by the ground wall probe and by the airborne landing
        // helpers (Air_TouchFloor, Air_LandOnObject, Air_Collide's reattach) — but NONE
        // of the four Knuckles landing paths passes through any of them: the glide's
        // slope land, GLIDEFALL's dead stop, the slide get-up and Climb_ReachFloor all
        // jbra straight to Player_SetState. So a push bit set before a jump survived the
        // whole jump -> glide -> climb chain and showed one frame of ANIM_PUSH on
        // touchdown, until the next PState_Ground wall probe cleared it.
        //
        // Clearing it HERE closes all four at once: every one of those paths enters
        // PSTATE_GROUND, so they all reach this hook. Harmless for the paths that
        // already cleared it — the bit is simply already 0.
        bclr    #ST_PUSHING, status(a0)
        rts
}

pub proc PHook_AirEnter (a0: *Sst) clobbers(d1-d2/a1) { // uncurled airborne (d2: EnsureStanding's shift calc)
        jbsr    PHook_EnsureStanding
        bset    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_AirBallEnter (a0: *Sst) clobbers(d1-d2/a1) { // JUMP / ROLLJUMP / AIRBALL (d2: EnsureBall shift)
        jbsr    PHook_EnsureBall
        bset    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_RollEnter (a0: *Sst) clobbers(d1-d2/a1) { // grounded ball — entered from (d2: EnsureBall shift)
        clr.b   PlayerV.instashield(a0)         // the OTHER landing state — see
                                                // PHook_GroundEnter's note. Also runs
                                                // on a ground roll START, which is
                                                // already grounded, so the clear is a
                                                // no-op there.
        jbsr    PHook_EnsureBall                // GROUND (roll start), SPINDASH
        bclr    #ST_IN_AIR, status(a0)          // (release), or a curled/down-
        rts                                     // held landing (air → cleared)
}

pub proc PHook_GlideEnter (a0: *Sst) clobbers(d1/a1) { // Knuckles' glide — airborne,
        jbsr    PHook_EnsureAbility             // uncurled, 10x10 ability box
        bset    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_SlideEnter (a0: *Sst) clobbers(d1/a1) { // belly slide — grounded,
        jbsr    PHook_EnsureAbility             // keeps the 10x10 box (idempotent)
        bclr    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_ClimbEnter (a0: *Sst) clobbers(d1/a1) { // wall climb / ledge clamber —
        jbsr    PHook_EnsureAbility             // 10x10 box, attached to the wall (not falling)
        bclr    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_SpindashEnter (a0: *Sst) clobbers(d1-d2/a1) preserves(d0) { // entered only from GROUND —
                                                // preserves(d0) is DECLARED (not left
                                                // implicit) so the closure gate verifies
                                                // the stack round-trip below instead of
                                                // charging the spawn call's d0 clobber
                                                // to this hook (the TestChurnObj_Main
                                                // shape)
        jbsr    PHook_EnsureStanding            // the player is pinned charging
                                                // at STANDING size (classic S2:
                                                // curl + feet-planted shift
                                                // happen at RELEASE via ROLL's
                                                // enter hook — the donor charge
                                                // frames are drawn for the
                                                // standing origin)
        bclr    #ST_IN_AIR, status(a0)
        clr.w   PlayerV.ground_speed(a0)
        clr.w   x_vel(a0)
        clr.w   y_vel(a0)
        clr.w   PlayerV.spindash_charge(a0)     // the initiating press is rev 0

        // d0 bracketed, NOT added to the clobber set: PlayerHook preserves d0 —
        // the exit dispatch carries the new state byte there, and Player_SetState's
        // own contract (clobbers d1-d2/a1-a2) promises its callers d0 survives the
        // enter-hook tail jmp. DustSpindash_Spawn's AllocEffect owns d0 (its status
        // code lands there), so the save/restore is this hook's obligation — the
        // same caller-side bracket Player_Main uses for d7 around the state
        // dispatch.
        move.l  d0, -(sp)
        jbsr    DustSpindash_Spawn              // one follower per charge; it retires
                                                // itself on the state byte, so there is
                                                // deliberately no teardown in
                                                // PHook_SpindashExit (a cached slot
                                                // pointer there could be freed behind
                                                // the hook's back by DeleteChildren or
                                                // the death cascade)
        move.l  (sp)+, d0
        rts                                     // Rev SFX fired per-tap in player_spindash.asm
}

pub proc PHook_SpindashExit (a0: *Sst) clobbers() {
        clr.w   PlayerV.spindash_charge(a0)     // release converts charge→gsp
        rts                                     // BEFORE SetState; an aborted
                                                // charge just drops it
}

// bug #5 fix (structural): the collision box lives ONLY here — every curled
// state gets ball radii with the symmetric feet-planted shift (curl_y_shift,
// derived from the record), so the classic roll-jump 5px size mismatch cannot
// exist. Enter-hook-owns-it:
// each enter hook ENSURES its size, keyed on the current height byte —
// idempotent and correct for every transition path.
//
// ST_ROLLING is tied to the SAME pair so the "in ball form" bit can never desync
// from the radii. It is set/cleared UNCONDITIONALLY — outside the height-keyed
// guard — because the debug-fly art swap writes a third height (16) outside the
// state machine: a debug round-trip re-enters via SetState and the hook must
// repair the bit even when the height byte needs no curl work.
// The curled test is the box word against the ACTIVE CHARACTER's cd_roll_wh, not
// a constant height: the "am I curled" key has to move with the boxes it keys on,
// or a character whose ball differs from Sonic's would read as permanently
// curled/uncurled. Comparing the whole word (both dims) rather than the height
// alone is the same test — no character's standing box shares its rolling box —
// and it is one aligned read instead of two.
// GENERALISED GUARD (§0 fix): the old guard keyed on cd_roll_wh — "am I the ball
// box" — so coming from the 21x21 ability box (Knuckles' glide/slide) it missed and
// the standing box was NEVER restored. The guard is now "am I NOT the standing box",
// with the feet-planted y-shift computed from the CURRENT height rather than the
// fixed curl pair: shift = (cd_stand_h - current_h) >> 1. That is S3K's own
// `y_radius - default_y_radius` (sonic3k.asm:30978), and it reproduces the two-box
// case EXACTLY — ball->standing is (39-29)>>1 = 5 (byte-identical to the retired
// curl_y_shift), ability->standing is (39-21)>>1 = 9 (the number S3K's slide get-up
// uses). Sonic and Tails are behaviour-identical (same shift, same paths); only the
// encoding moves, so this is ROM-changing but RAM-identical and the replay fixtures
// hold. The debug-fly 16 box never reaches here — Player_DebugExit calls
// set_standing_size explicitly before any hook runs, so the box is already standing
// and the guard takes .keep.
pub proc PHook_EnsureStanding (a0: *Sst) clobbers(d1-d2/a1) {
        bclr    #ST_ROLLING, status(a0)
        movea.l Player_Chardef, a1
        move.w  size_wh_off()(a0), d1           // current box W<<8|H (low byte = height)
        cmp.w   CharacterDef.cd_stand_wh(a1), d1
        beq     .keep                           // already standing
        moveq   #0, d2
        move.b  cd_stand_h_off()(a1), d2        // standing height (2r+1)
        sub.b   d1, d2                          // stand_h - current_h (d1.b = current height)
        lsr.b   #1, d2                          // feet-planted shift px (always even: both odd)
        set_standing_size(a0, a1)               // NOW overwrite the box
        swap    d2                              // px -> 16.16 (the moveq's zero is the low word)
        sub.l   d2, y_pos(a0)                   // lift so the feet stay planted
.keep:
        rts
}

// PHook_EnsureAbility — install the 10x10 ability box (Knuckles' glide/slide/climb),
// the exact peer of the two Ensure hooks. Glide is ATTACKING but NOT curled, so
// ST_ROLLING is cleared; NO y-shift is applied — S3K writes the radii on glide entry
// and never touches y_pos (sonic3k.asm:32565-32572). Idempotent, so glide->slide is a
// no-op on the box exactly as S3K leaves it. Reachable only through Ability_KnuxGlide,
// so a character with cd_ability_wh = 0 never gets a degenerate box.
pub proc PHook_EnsureAbility (a0: *Sst) clobbers(d1/a1) {
        bclr    #ST_ROLLING, status(a0)
        movea.l Player_Chardef, a1
        move.w  size_wh_off()(a0), d1
        cmp.w   CharacterDef.cd_ability_wh(a1), d1
        beq     .keep                           // already the ability box
        set_ability_size(a0, a1)                // no y-shift (S3K applies none)
.keep:
        rts
}

// GENERALISED like EnsureStanding (§0 step 5): the feet-planted shift is computed
// from the CURRENT height, (cur_h - roll_h) >> 1 SIGNED, so the climb jump-off
// (ability box 21 -> ball box 29) shifts correctly instead of applying the
// standing-based curl. Reproduces the standing->ball case byte-for-byte —
// (39-29)>>1 = +5, identical to the retired curl_y_shift — so Sonic/Tails are
// RAM-identical; ability->ball is (21-29)>>1 = -4 (a shorter box growing taller, the
// centre rises 4px to keep the feet planted).
pub proc PHook_EnsureBall (a0: *Sst) clobbers(d1-d2/a1) {
        bset    #ST_ROLLING, status(a0)
        movea.l Player_Chardef, a1
        move.w  size_wh_off()(a0), d1
        cmp.w   CharacterDef.cd_roll_wh(a1), d1
        beq     .keep                           // already curled
        moveq   #0, d2
        move.b  d1, d2                          // current height (d1 low byte)
        sub.b   cd_roll_h_off()(a1), d2         // cur_h - roll_h (signed byte)
        ext.w   d2                              // sign-extend byte -> word
        asr.w   #1, d2                          // (cur_h - roll_h) >> 1, signed
        set_ball_size(a0, a1)
        swap    d2                              // px -> 16.16 (high word stays 0 -> new low word)
        add.l   d2, y_pos(a0)
.keep:
        rts
}

// -----------------------------------------------
// Player_SnapToSurface — move the player a signed pixel distance along the floor
// pair's PROBE axis. Mirrors Player_SensorFloor's case table EXACTLY
// (player_sensors.asm) — probe direction per quadrant:
//   quadrant 0: Collision_ProbeDown  → y_pos += dist
//   quadrant 1: Collision_ProbeLeft  → x_pos −= dist
//   quadrant 2: Collision_ProbeUp    → y_pos −= dist
//   quadrant 3: Collision_ProbeRight → x_pos += dist
// In:  a0 = player SST, a4 = the slot's player block (the quadrant it reads is
//      per-slot), d0.w = signed surface distance (px)
// Out: none
// Clobbers: d0, d2
// -----------------------------------------------
pub proc Player_SnapToSurface (a0: *Sst) clobbers(d0/d2) {
        dist_to_fix(d0)
        move.b  PBLK_QUADRANT(a4), d2
        beq     .down                           // floor mode — common case
        subq.b  #2, d2
        bmi     .left                           // quadrant 1
        beq     .up                             // quadrant 2
        add.l   d0, x_pos(a0)                   // quadrant 3
        rts
.down:
        add.l   d0, y_pos(a0)
        rts
.left:
        sub.l   d0, x_pos(a0)
        rts
.up:
        sub.l   d0, y_pos(a0)
        rts
}

// Classic Sonic_LevelBound margins: the player center may approach the left
// playable edge to 16px and the right edge to 24px (asymmetric in the originals
// — kept verbatim). Bottom margin: detection slack below the playable bottom;
// must exceed the per-frame fall cap so a single frame's fall can never
// overshoot the guard transiently. That bound is the `ensure` below, and it
// reads PHYS_FALL_CAP itself — the cap's VALUE is not restated here, because a
// sentence that names it goes stale the moment the constant moves while the
// `ensure` keeps passing. PHYS_FALL_CAP lives in engine/system/constants.emp,
// derived there from COLLISION_CELL_SHIFT.
const PBOUND_LEFT_MARGIN   = 16
const PBOUND_RIGHT_MARGIN  = 24
const PBOUND_BOTTOM_MARGIN = 48
ensure(PBOUND_BOTTOM_MARGIN > (PHYS_FALL_CAP >> 8), "PBOUND_BOTTOM_MARGIN must exceed the per-frame fall cap")

// -----------------------------------------------
// Player_BoundsInit — compute the act-invariant player clamp edges (M3).
// Call once per act init, after the act descriptor is live; Player_LevelBound
// consumes the cached words per-frame instead of re-deriving them. The
// derivations mirror Player_LevelBound's retired per-frame chains exactly
// (split 8+3 shift, word-domain subtract), so the cached words are
// bit-identical to what the per-frame code computed.
//   right  = (grid_w << SECTION_SIZE_SHIFT) − PBOUND_RIGHT_MARGIN
//   bottom = (grid_h << SECTION_SIZE_SHIFT) − SCREEN_HEIGHT
// MEGA-ACT CEILING: the word store word-wraps for level_width/height above
// $FFFF px — grid dim > 31 sections; guarded by act_descriptor's <= $8000
// ensure. That trap now lives HERE only.
//
// IT ALSO PUBLISHES THE UNSUBTRACTED EXTENTS as Level_Width / Level_Height,
// because the two intermediates it already holds ARE the act's true pixel box —
// [0, Level_Width) × [0, Level_Height) — and nothing else in the build exposes
// that box under a name. The clamp edges below them are INSET and are therefore
// the wrong answer for anyone asking "where does the act end": objects are
// deliberately unclamped, so the strip between Player_Bound_Right and
// Level_Width is legal, occupied ground. The full statement of that trap, and
// the reason the cells are u16 and must stay u16, lives at their declaration in
// games/sonic4/config/ram.emp — read it before touching either store.
// This costs two `move.w` to absolute and no extra register: the value being
// published is the one already in d1 on the way to the subtract.
// In:  a0 = act descriptor
// Out: none
// Clobbers: d1
// -----------------------------------------------
pub proc Player_BoundsInit (a0: *Act) clobbers(d1) {
        moveq   #0, d1
        move.w  Act.grid_w(a0), d1
        lsl.l   #8, d1
        lsl.l   #3, d1                          // grid_w × 2048 = level_width (px)
        move.w  d1, Level_Width                 // the TRUE extent, before the inset
        subi.w  #PBOUND_RIGHT_MARGIN, d1
        move.w  d1, Player_Bound_Right
        moveq   #0, d1
        move.w  Act.grid_h(a0), d1
        lsl.l   #8, d1
        lsl.l   #3, d1                          // grid_h × 2048 = level_height (px)
        move.w  d1, Level_Height                // the TRUE extent, before the inset
        subi.w  #SCREEN_HEIGHT, d1
        move.w  d1, Player_Bound_Bottom
        rts
}

// -----------------------------------------------
// Player_LevelBound — clamp the player to the act's playable bounds (classic
// Sonic_LevelBound, adapted to world coordinates).
//
// PLACEMENT: called once from Player_Main right after the state dispatch, before
// the history rings. A single post-dispatch call clamps the same end-of-frame
// position without per-state duplication, and the history rings then record the
// CLAMPED position. Debug-fly never reaches this — bounds are deliberately
// SKIPPED in debug-fly, which is for inspecting anywhere, including off-world.
//
// Continuous-scroll: X/Y are world coordinates spanning the whole act, so the
// bounds are the act's world extents directly:
//   left  — world origin: bound = PBOUND_LEFT_MARGIN (x ≥ 0 + margin).
//   right — level_width − PBOUND_RIGHT_MARGIN, level_width = grid_w << SECTION_SIZE_SHIFT.
//   bottom — playable bottom = (grid_h << SECTION_SIZE_SHIFT) − SCREEN_HEIGHT.
//   top   — NO clamp (classic allows above-screen travel).
// The right/bottom edges are act-invariant, so they are precomputed once by
// Player_BoundsInit (M3) and read back here as cached words per-frame.
//
// On X clamp: integer x written with subpixel zeroed, x_vel and gsp cleared.
// On bottom trip: y is clamped to the playable bottom edge and y_vel zeroed
// (a placeholder until death/respawn exists).
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d2, a1
// -----------------------------------------------
pub proc Player_LevelBound (a0: *Sst) clobbers(d0-d2/a1) {
        move.w  x_pos(a0), d0                   // integer X (16.16 high word)

        // --- left bound: world [0, level_width) ---
        move.w  #PBOUND_LEFT_MARGIN, d1
        cmp.w   d1, d0
        blt     .clamp_x
        // --- right bound: world level_width − margin ---
        //     cached by Player_BoundsInit at act init (M3) — the derivation
        //     (and the MEGA-ACT word-wrap trap note) lives there now.
        move.w  Player_Bound_Right, d1
        if DEBUG == 1 { assert.w d1, ne, #0 }   // zero = Player_BoundsInit never ran
        cmp.w   d1, d0
        ble     .x_done
.clamp_x:
        move.w  d1, x_pos(a0)
        clr.w   SST_x_pos_sub(a0)               // subpixel zeroed (classic)
        clr.w   x_vel(a0)
        clr.w   PlayerV.ground_speed(a0)
.x_done:
        // --- bottom guard (no top clamp) ---
        //     playable bottom cached by Player_BoundsInit at act init (M3).
        move.w  y_pos(a0), d0                   // integer Y
        move.w  Player_Bound_Bottom, d1         // d1 = playable bottom edge (world)
        move.w  d1, d2
        addi.w  #PBOUND_BOTTOM_MARGIN, d2
        cmp.w   d2, d0
        ble     .y_ok                           // above the bottom guard → done
        // --- player tripped the bottom edge: dispatch on the act's edge_mode ---
        //     act ptr loaded HERE (rare path): edge_mode is its only remaining
        //     consumer since M3 cached the extents.
        movea.l Current_Act_Ptr, a1
        move.b  Act.edge_mode(a1), d2
        cmpi.b  #EDGE_WRAP_V, d2
        beq     .edge_wrap
        cmpi.b  #EDGE_KILL, d2
        beq     .edge_kill
        // EDGE_CLAMP (default) — clamp to the bottom edge. With editor-authored /
        // S&K collision the player can fall through air or an erased floor by
        // design (pits, WIP), so this is expected — just clamp.
.edge_clamp:
        move.w  d1, y_pos(a0)                   // d1 still = playable bottom edge
        clr.w   SST_y_pos_sub(a0)
        clr.w   y_vel(a0)
.y_ok:
        rts
.edge_wrap:
        // EDGE_WRAP_V — vertical "fall-forever" wrap (not implemented; current
        // build uses EDGE_CLAMP). A correct wrap is an atomic live-set shift by
        // ±level_height + camera Y-clamp edge-mode awareness. Full design: spec
        // §10. Until built: clamp.
        jbra    .edge_clamp
.edge_kill:
        // EDGE_KILL — death pit. No death/respawn system exists yet, so this
        // records intent and clamps meanwhile. When the death system exists it
        // consumes Player_Death_Pending; this stays the single trigger point.
        st      Player_Death_Pending            // set the death-pending flag ($FF)
        jbra    .edge_clamp                     // clamp until the death system exists
}

// -----------------------------------------------
// Debug-fly — suspends the state machine (the obj_control escape hatch). Enter
// swaps to the yellow marker square; exit restores Sonic and drops into
// PSTATE_AIR with velocities cleared. The art/size writes here are the one
// tolerated exception to the hook one-writer rule (outside the state machine).
// -----------------------------------------------
// In:  a0 = player SST.  Clobbers: d2, a1 (RefreshSpritePieceCount)
pub proc Player_DebugEnter (a0: *Sst) clobbers(d2/a1) {
        st      PlayerV.debug_flag(a0)
        move.l  #Map_TestObj, mappings(a0)
        move.w  #vram_art(VRAM_TEST_MARKER, 1, 1), art_tile(a0) // PlayerMarkerTile
        move.b  #16, width_pixels(a0)
        move.b  #16, height_pixels(a0)
        clr.b   mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // debug path skips AnimateSprite's refresh:
                                                // re-cache piece count + frame_off here
        clr.w   x_vel(a0)
        clr.w   y_vel(a0)
        clr.w   PlayerV.ground_speed(a0)
        rts
}

// In:  a0 = player SST.  Clobbers: d0-d2, a1-a2
pub proc Player_DebugExit (a0: *Sst) clobbers(d0-d2/a1-a2) {
        sf      PlayerV.debug_flag(a0)
        jbsr    Player_InitAssets
        // standing radii until the AIR frame lands and hooks take over
        movea.l Player_Chardef, a1
        set_standing_size(a0, a1)
        clr.b   mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // prev_anim=$FF forces a refresh NEXT
                                                // frame, but a render can run before
                                                // that — re-cache now (d2/a1 in our set)
        move.b  #$FF, prev_anim(a0)
        move.b  #$FF, prev_frame(a0)
        clr.w   x_vel(a0)
        clr.w   y_vel(a0)
        clr.w   PlayerV.ground_speed(a0)
        moveq   #PSTATE_AIR, d0
        jbra    Player_SetState
}

// D-pad free flight at PLAYER_DEBUG_FLY_SPEED px/frame (camera Y clamp caps
// effective follow speed), draw only.
// In:  a0 = player SST.  Clobbers: d0-d3, a1 (a0/d7 preserved)
pub proc Player_DebugMove (a0: *Sst) clobbers(d0-d3/a1) preserves(a0) {
        move.b  Ctrl_1_Held, d0
        moveq   #PLAYER_DEBUG_FLY_SPEED, d1
        swap    d1                              // px → 16.16
        btst    #BUTTON_LEFT_BIT, d0
        beq     .check_right
        sub.l   d1, x_pos(a0)
.check_right:
        btst    #BUTTON_RIGHT_BIT, d0
        beq     .check_up
        add.l   d1, x_pos(a0)
.check_up:
        btst    #BUTTON_UP_BIT, d0
        beq     .check_down
        sub.l   d1, y_pos(a0)
.check_down:
        btst    #BUTTON_DOWN_BIT, d0
        beq     .draw
        add.l   d1, y_pos(a0)
.draw:
        jbra    Draw_Sprite
}
