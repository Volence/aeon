// Player frame skeleton — state machine, dispatch, shared services (§5)
//
// Owns the player frame: debug-fly escape → physics table (a4) →
// quadrant → jump buffer → state dispatch → history rings → display tail.
// The state bodies live in player_ground.asm / player_air.asm (reached
// only via the Player_States offset table below); characters contribute
// asset/physics data + ability states through the roster (characters.emp,
// sonic.emp) — never forks inside shared routines (spec §3.1 inversion of
// the sonic_hack split).
//
// Lives in the object code bank: Player_Main is dispatched through
// SST_code_addr via a code_addr = label − ObjCodeBase store.
//
// This module OWNS the player frame outright — player_common.asm is deleted. The
// PlayerV overlay, the PPHYS_* / BUTTON_JUMP_MASK / PLAYER_DEBUG_FLY_SPEED consts,
// the four macro→comptime-fn templates, and the code span all live here; the state
// files (player_ground/air/spindash) reach them by module `use`, and engine.camera
// late-binds the one `_pl_state` offset through the link.
module games.sonic4.player_common in player_common

use engine.objects.sst.{Sst, set_priority_band}
use engine.structs.{Act, CharacterDef}
use engine.coords.{pixels_to_coord, abs_w}
use engine.objects.objdef.{vram_art}
use engine.constants.{NUM_PLAYERS,
        RF_PRIORITY_SHIFT, RF_PRIORITY_MASK, ST_IN_AIR, BUTTON_LEFT, BUTTON_RIGHT, SECTION_SIZE_SHIFT, SCREEN_HEIGHT,
        PHYS_SKID_MIN, PHYS_JUMP_BUFFER, PHYS_FALL_CAP, PLAYER_X_RADIUS, PLAYER_Y_RADIUS, BALL_X_RADIUS, BALL_Y_RADIUS,
        CURL_Y_SHIFT, ST_ROLLING, ST_PUSHING, COLLISION_NONE, EDGE_WRAP_V, EDGE_KILL, BUTTON_A, BUTTON_B, BUTTON_C,
        BUTTON_UP_BIT, BUTTON_B_BIT, BUTTON_DOWN_BIT, BUTTON_LEFT_BIT, BUTTON_RIGHT_BIT}
use engine.types.{VramTile}

// Player_AtLedgeEdge — player_sensors' idle-balance ledge probe (returns d0=0/Z
// set = supported, d0=1/Z clear = teetering) — resolves module-to-module to
// player_sensors.emp (bare link, no extern-proc decl).

// PlayerState — the state-handler routine type the Player_States table dispatches
// (PState_Ground/Roll/Spindash/Air/Jump/RollJump/AirBall, surviving player_ground/
// air/spindash). Preserves a0 (RunObjects); clobbers d0-d7 — the handlers clobber
// d7 internally (via Player_SensorFloor), which is why Player_Main brackets the
// dispatch with a `move.w d7,-(sp)` / `move.w (sp)+,d7` word save/restore that
// preserves the RunObjects slot counter (d7 is a WORD there).
type PlayerState = proc (a0: *Sst) preserves(a0) clobbers(d0-d7, a1-a4)

// PlayerHook — the enter/exit hook routine type (PHook_*, this module). Hooks
// preserve a0/d0/d7 (their contract); the dispatch's d1/a1 + the hook's d2/a2 are
// the clobber set.
type PlayerHook = proc (a0: *Sst) preserves(a0) clobbers(d1-d2, a1-a2)

// AbilityHook (the per-character jump-press hook type), CharacterDefs (the
// roster), Ability_None and the two record readers Player_InitAssets /
// Player_LoadArt live in characters.emp — the frame does not own the cast.
// Player_Init, Player_DebugExit and Player_Display reach them as bare link refs.

// Game-config constants — the sole authority is games.sonic4.constants
// (config/constants.emp). VRAM_TEST_MARKER is the tile-1016 debug-fly marker.
use games.sonic4.constants.{
    PSTATE_GROUND, PSTATE_ROLL, PSTATE_SPINDASH, PSTATE_AIR, PSTATE_JUMP,
    PSTATE_ROLLJUMP, PSTATE_AIRBALL, PSTATE_COUNT,
    ANIM_WALK, ANIM_RUN, ANIM_ROLL, ANIM_SPINDASH, ANIM_PUSH, ANIM_IDLE,
    ANIM_BALANCE, ANIM_LOOKUP, ANIM_DUCK, ANIM_SKID, ANIM_GETUP,
    ANIM_RUN_THRESHOLD, VRAM_TEST_MARKER, CHEAT_DEBUG_FLY, CHAR_COUNT,
    PLAYER_BLOCK_SIZE
}

// Sound id — sole authority is games.sonic4.sound_ids.
use games.sonic4.sound_ids.{SFXID_SKID}

// PHYS_* / radii / CURL / ST_* / COLLISION_NONE / EDGE_* / BUTTON_A/B/C /
// BUTTON_*_BIT are consumed from engine.constants via the
// `use engine.constants.{...}` above.

// -----------------------------------------------
// PlayerV — the SST overlay (research structure-refs §2.2 budget: 18 of 30
// usable bytes — the sst_custom window is 32 bytes at $30 and its tail word
// $4E-$4F is the engine-owned SST_interact).
// This module owns the overlay outright (player_common.asm deleted); the
// state files reach the fields through the imported PlayerV struct, so no `_pl_*`
// mirror equate survives (only the link-exported `_pl_state` offset for camera).
// The overlay's always-on window-overflow check subsumes the AS objvarsCheck /
// SST_interact collision assert.
// -----------------------------------------------
pub vars PlayerV: Sst.sst_custom {
        ground_speed:     i16,          // inertia — single source of truth on ground
        player_state:     u8,           // PSTATE_* (jump-table byte offset)
        status_secondary: u8,           // reserved condition bits (speedshoes etc.) — 0 for now
        move_lock:        u16,          // input-freeze frames (slip/spring channel)
        spindash_charge:  u16,          // spindash rev accumulator (release converts charge→gsp)
        flip_angle:       u8,           // reserved (visual rotation)
        air_left:         u8,           // reserved (no water yet)
        invuln_time:      u8,           // reserved
        stick_convex:     u8,           // flag: full terrain adherence (objects will set)
        debug_flag:       u8,           // nonzero = debug-fly (suspends state dispatch)
        skid_latch:       u8,           // nonzero = hold the skid pose (display latch)
        getup_timer:      u8,           // >0 = play ANIM_GETUP one-shot, counts down
        look_offset:      u8,           // camera look/duck pan seam — stays 0 this pass
        jump_headroom:    u8,           // press-frame ceiling clearance carried into
                                        // the same tick's air body; MUST be zero at
                                        // tick end (replay-hash discipline)
        even_pad:         u8,           // pad — keeps the overlay even
}
// _pl_state — the player-state byte's SST-custom offset, link-exported for
// engine.camera's GAME_CAMERA_JUMP_LOCK probe (`extern("Player_1") +
// extern("_pl_state")`, the sound_api extern-equ-sum idiom: an engine module
// late-binds this game offset through the link rather than a game `use`). This
// module OWNS PlayerV now (player_common.asm deleted), so it also owns the offset
// symbol; the state files reach the fields via the imported PlayerV struct, so no
// other `_pl_*` offset needs a link symbol.
equ _pl_state = offsetof(Sst, sst_custom) + offsetof(PlayerV, player_state)

// Sub-field displacement consts — the 16.16 subpixel low words (LevelBound
// clears them). `Sst.field + N` does not compose inside a displacement, so name
// the offset (the Act_grid_w_lo precedent).
const SST_x_pos_sub = offsetof(Sst, x_pos) + 2
const SST_y_pos_sub = offsetof(Sst, y_pos) + 2

// -----------------------------------------------
// Jump press sources — the SOLE authority for both consumers (ruled 2026-08-05,
// docs/DEFERRED_WORK.md). Classic Sonic jumps on all three face buttons, so the
// default mask is A|B|C. B falls back out of it ONLY while CHEAT_DEBUG_FLY is
// armed, because there B owns the free-flight toggle instead.
//
// Two sites consume these and MUST stay in lockstep: the press latch in
// Player_Main below, and the variable-jump-height HELD check in
// player_air.PState_AirShared. A mask that latches a jump but does not sustain it
// gives B-jumps a clipped arc — hence one definition, imported by both.
// -----------------------------------------------
pub const BUTTON_JUMP_MASK      = BUTTON_A | BUTTON_B | BUTTON_C
pub const BUTTON_JUMP_MASK_NO_B = BUTTON_A | BUTTON_C   // while the cheat owns B

const PLAYER_DEBUG_FLY_SPEED = 16       // px/frame — matched to CAM_MAX_Y_STEP

// player-block field offsets (a4-relative; the Player_Phys block displacements
// past the 8-word physics row). File-local, like the PPHYS_* physics-row offsets
// in player_ground/player_air and for the same reason: a divergent offset shows
// up as a mismatched instruction byte in the region gate.
const PPHYS_QUADRANT = 16
const PPHYS_JUMPBUF  = 17

// -----------------------------------------------
// player_block — point a register at the CALLING SLOT's player working block
// (config/ram.emp: the 8-word physics row + quadrant + jump buffer).
//
// THIS IS THE WHOLE PER-SLOT MECHANISM. Player_Main resolves the slot once per
// frame into a4 and every downstream site — the state bodies, the sensor stack,
// Player_SnapToSurface — addresses the block a4-relative. No slot index is
// carried in a register and no access site does arithmetic; making the state
// per-slot was an addressing-mode change at each site, not a logic change.
//
// WHY A COMPARE AND NOT AN INDEX: the slot index is (sst − Object_RAM) /
// sizeof(Sst), and sizeof(Sst) is $50 — not a power of two — so that division
// needs a `divu`, which the conventions forbid outright (§2.1). With two slots a
// single compare against Player_1 is both exact and cheaper. That is an
// assumption about NUM_PLAYERS, so it is asserted at build time immediately
// below rather than left to be discovered by a third slot silently reading slot
// 1's block.
// In:  sst = register holding the player SST (preserved)
// Out: dst = that slot's block base
// Clobbers: CCR — the `cmpa.w` leaves the compare's flags, not the caller's.
//      Both expansion sites are flag-independent at the splice, but this file
//      deliberately carries flags across instruction boundaries elsewhere
//      (player_ground's `btst` into a later `bpl`), so it is stated.
// -----------------------------------------------
pub comptime fn player_block(sst: Reg, dst: Reg) -> Code {
        return asm {
                lea     Player_Phys, {dst}              // slot 0 (the leader)
                cmpa.w  #Player_1, {sst}
                beq     .blk_resolved
                lea     PLAYER_BLOCK_SIZE({dst}), {dst}
        .blk_resolved:
        }
}
ensure(NUM_PLAYERS == 2,
       "player_block's compare-against-Player_1 slot derivation assumes exactly two player slots")
// Both `cmpa.w #Player_1` sites (the splice above and Player_Main's ring gate)
// compare a SIGN-EXTENDED word against a full address register. That is correct
// only while Player_1 lives in the w-addressable window, where bit 15 is set and
// the extension reproduces $FFFFxxxx. Move Object_RAM down into lower_ram
// ($FFFF0000..$FFFF8000, not w_addressable) and the `lea` would still lower to
// abs.l while the compare tested a sign-CLEARED value — never equal. The failure
// is silent and severe: every slot would resolve to block 1 (re-introducing the
// exact single-block bug this parcel removes) and the ring gate would never fire.
ensure((extern("Player_1") & $FFFF8000) == $FFFF8000,
       "player_block + the ring gate use cmpa.w — Player_1 must sign-extend from a word, i.e. live in the w-addressable window ($FFFF8000+)")
ensure(PLAYER_BLOCK_SIZE == extern("Player_Block_End") - extern("Player_Phys"),
       "PLAYER_BLOCK_SIZE out of sync with the Player_Phys block layout (config/ram.emp)")
ensure(PPHYS_QUADRANT == extern("Player_Phys_End") - extern("Player_Phys"),
       "PPHYS_QUADRANT must be the first byte past the physics row")
ensure(PPHYS_JUMPBUF == PPHYS_QUADRANT + 1,
       "PPHYS_JUMPBUF must follow the quadrant byte (config/ram.emp field order)")
ensure(PLAYER_BLOCK_SIZE == PPHYS_JUMPBUF + 1,
       "PLAYER_BLOCK_SIZE must close the block right after the jump-buffer byte")
// Link-time drift-lock (the RunObjects_Frozen System/Effect adjacency precedent,
// engine/objects/core.emp): the sizes above are right but say nothing about
// ADJACENCY. `player_block` reaches slot N by stepping PLAYER_BLOCK_SIZE off
// Player_Phys, so the reserve run must begin exactly where slot 0's block ends —
// a field inserted between them would silently land slot 1's block on top of it.
ensure(extern("Player_Blocks_Tail") == extern("Player_Block_End"),
       "config/ram.emp: Player_Blocks_Tail must immediately follow Player_Block_End — player_block strides the slots as one contiguous run")

// -----------------------------------------------
// set_standing_size / set_ball_size — the two collision boxes (sizes are 2r+1;
// sensors halve by lsr → standing 9/19, ball 7/14 — the exact classic radii).
// The enter hooks are the ONE writer of these fields and of the paired
// ±CURL_Y_SHIFT y-shift (spec §3.3).
// In: sst = player SST register
// -----------------------------------------------
pub comptime fn set_standing_size(sst: Reg) -> Code {
        return asm {
                move.b  #PLAYER_X_RADIUS*2+1, Sst.width_pixels({sst})
                move.b  #PLAYER_Y_RADIUS*2+1, Sst.height_pixels({sst})
        }
}

pub comptime fn set_ball_size(sst: Reg) -> Code {
        return asm {
                move.b  #BALL_X_RADIUS*2+1, Sst.width_pixels({sst})
                move.b  #BALL_Y_RADIUS*2+1, Sst.height_pixels({sst})
        }
}

// -----------------------------------------------
// mask_opposing_lr — L+R held together = neither (bug #10). Hygienic .lr_masked
// label per expansion (the AS macro's fixed label, splice-hygienic here). The
// .emp counterpart of the maskOpposingLR AS macro; consumers are the surviving
// player_ground (×2) / player_air (×1) — this module defines it for P2/P3, does
// not expand it itself. Lockstep twin of the AS macro.
// In: held = data register holding the held-button bits (masked to LEFT|RIGHT,
//     zeroed when both are down)
// -----------------------------------------------
pub comptime fn mask_opposing_lr(held: Reg) -> Code {
        return asm {
                andi.b  #BUTTON_LEFT|BUTTON_RIGHT, {held}
                cmpi.b  #BUTTON_LEFT|BUTTON_RIGHT, {held}
                bne     .lr_masked
                moveq   #0, {held}
        .lr_masked:
        }
}

// -----------------------------------------------
// dist_to_fix — widen a signed pixel distance (.w) into a 16.16 delta (dist<<16)
// for adding to the x_pos/y_pos longwords. The .emp counterpart of the distToFix
// AS macro; a bare pixels_to_coord splice (engine.coords, kill row 49): swap moves
// the .w pixel value into the high word and clr.w zeroes the fraction. No sign
// extension is needed — the high word of v is discarded by swap+clr.w regardless
// of its contents, so the promotion is independent of v's incoming high word.
// In:  v.w = signed px distance
// Out: v.l = dist<<16
// -----------------------------------------------
pub comptime fn dist_to_fix(v: Reg) -> Code {
        return pixels_to_coord(v)
}

// -----------------------------------------------
// abs_w — the |v| in-place idiom (bpl/neg.w), a corpus-wide engine idiom
// (engine.coords), not a game one. Consumed via `use engine.coords.{abs_w}` above.
// -----------------------------------------------
// Player_Init — set up a player slot as the active CHARACTER (called from level
// state init; caller writes x_pos/y_pos first). The roster lookup happens HERE
// and only here: Character_ID selects a CharacterDef, the resolved record is
// cached in Player_Chardef, and every later dispatch site reads that cache.
//
// Boots into DEBUG-FLY when CHEAT_DEBUG_FLY is armed — the debug shape arms it
// at game init, so the streaming-test workflow
// still starts in the yellow square and B drops into physics. With the cheat
// clear (the release/lean default) the player boots as a PLAYER: this returns
// normally with the slot in PSTATE_AIR, dropping to ground on frame 1. Gating
// only the B toggle and not this tail would strand a release player in
// free-flight forever, since B would then be inert.
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d2, a1-a2 (d2 via Player_SetState's hook dispatch)
// -----------------------------------------------
pub proc Player_Init (a0: *Sst) clobbers(d0-d2/a1-a2) {
        // roster resolve — the ONE place a character id becomes a record pointer
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.w  Character_ID, d0
        assert.w d0, ls, #CHAR_COUNT-1          // id in roster range
        lsl.w   #2, d0                          // × sizeof(pointer); no scaled
                                                // indexing on the 68000
        lea     CharacterDefs, a1
        movea.l (a1,d0.w), a1
        move.l  a1, Player_Chardef
        jbsr    Player_InitAssets
        move.b  #ANIM_IDLE, anim(a0)            // Player_Display re-selects per frame
        move.b  #$FF, prev_anim(a0)
        move.b  #$FF, prev_frame(a0)
        set_priority_band(4)                    // C1c idiom: clear-then-set
        set_standing_size(a0)
        move.b  #COLLISION_NONE, collision_resp(a0)
        clr.b   status(a0)
        clr.b   angle(a0)
        clr.b   layer(a0)
        clr.w   PlayerV.ground_speed(a0)
        clr.w   PlayerV.move_lock(a0)
        clr.w   PlayerV.spindash_charge(a0)
        clr.b   PlayerV.status_secondary(a0)
        clr.b   PlayerV.stick_convex(a0)
        clr.b   PlayerV.skid_latch(a0)
        clr.b   PlayerV.getup_timer(a0)
        clr.b   PlayerV.look_offset(a0)
        clr.b   PlayerV.player_state(a0)        // defined start for SetState's exit lookup
        moveq   #PSTATE_AIR, d0                 // drop to ground on frame 1
        jbsr    Player_SetState
        player_block(a0, a2)                    // this slot's block — Refresh writes its row
        jbsr    Player_RefreshPhysics
        move.w  #Player_Main - ObjCodeBase, code_addr(a0)
        // Boot-entry into debug-fly rides the SAME runtime cheat bit as the B
        // toggle in Player_Main — one gate, one story for an auditor.
        moveq   #CHEAT_DEBUG_FLY, d0
        and.b   Cheat_Flags, d0                 // (Cheat_Flags).w — runtime cheat gate
        bne     Player_DebugEnter               // armed: tail-call, its rts returns to our caller
        rts                                     // clear: normal player (PSTATE_AIR, lands frame 1)
}

// -----------------------------------------------
// Player_RefreshPhysics — recompute ONE slot's effective physics row in RAM.
// Identity modifier today: straight copy of the active character's base row
// (CharacterDef.cd_phys). Section/water/speed-shoes modifiers compose HERE
// later — called on section change and status events, NEVER per-frame
// (spec §3.4).
//
// Takes the slot's block pointer rather than re-deriving one: the row it writes
// is per-slot (C1), and every caller already has the SST in hand, so `player_block`
// at the call site keeps the derivation in one place instead of two.
// In:  a2 = the slot's player block (player_block); reads Player_Chardef
// Out: none
// Clobbers: a1-a2
// -----------------------------------------------
pub proc Player_RefreshPhysics (a2: *u8) clobbers(a1-a2) {
        movea.l Player_Chardef, a1
        movea.l CharacterDef.cd_phys(a1), a1
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        move.l  (a1)+, (a2)+
        rts
}

// -----------------------------------------------
// Player_Main — per-frame player update (RunObjects entry)
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d6, a1-a4 (a0 preserved — RunObjects loop contract).
// Preserves: d7.w — the RunObjects slot counter is a word, and the state dispatch
//   brackets Player_SensorFloor (which clobbers the full d7) with a
//   `move.w d7,-(sp)` / `move.w (sp)+,d7` save that round-trips d7's LOW WORD.
//   The upper word is unspecified (the `.w` facet licenses clobbering it); every
//   other d7-crossing call (DebugEnter/Exit/Move, LevelBound) and the fall into
//   Player_Display preserve d7, so the low word reaches RunObjects intact.
// -----------------------------------------------
pub proc Player_Main (a0: *Sst) clobbers(d0-d6/a1-a4) preserves(d7.w) falls_into Player_Display {
        // press bits read ONCE for the frame — d6 survives the debug toggle
        // calls (DebugEnter clobbers d2/a1, DebugExit d0-d2/a1-a2) and feeds both
        // the B-toggle and the jump-buffer latch
        move.b  Ctrl_1_Press, d6
        // --- debug-fly toggle (B press), behind the CHEAT_DEBUG_FLY gate ---
        // Debug-fly is a CHEAT, not debug equipment: the payload
        // (Player_DebugEnter/Exit/Move) SHIPS in every build shape and is simply
        // UNREACHABLE until the bit is set. Equipment is gated at BUILD time and
        // absent from release; a cheat is gated at RUNTIME and present but
        // unreachable (CODING_CONVENTIONS §1.7). Cheat_Flags is boot-cleared with
        // all Work-RAM, so release/lean start with B doing nothing here; the DEBUG
        // shape arms the bit at game init, and a cheat code (button sequence, menu
        // unlock) will arm it in release with NO code change. Boot-ENTRY into
        // debug-fly (Player_Init's tail) is gated on the same bit, so a release
        // player boots as a player and B leaves them one; there is no state where
        // half the gate applies. Auditors: these bytes in a release ROM are
        // deliberate cheat payload, not a debug leak.
        btst    #BUTTON_B_BIT, d6
        beq     .no_toggle
        moveq   #CHEAT_DEBUG_FLY, d0
        and.b   Cheat_Flags, d0                 // (Cheat_Flags).w — runtime cheat gate
        beq     .no_toggle                      // cheat off: B is inert (d6 untouched)
        tst.b   PlayerV.debug_flag(a0)
        bne     .toggle_exit
        jbsr    Player_DebugEnter
        jbra    .no_toggle
.toggle_exit:
        jbsr    Player_DebugExit
.no_toggle:
        tst.b   PlayerV.debug_flag(a0)
        bne     Player_DebugMove                // obj_control escape hatch:
                                                // skips physics, dispatch,
                                                // rings, and display tail

        player_block(a0, a4)                    // a4 = THIS SLOT's working block —
                                                // resolved once, held for the whole
                                                // frame (physics row + quadrant +
                                                // jump buffer all ride it)

        // quadrant = (angle+$20)>>6 — first-class derived value; computed from
        // LAST frame's angle (classic: angle updates at the floor pair)
        move.b  angle(a0), d0
        addi.b  #$20, d0
        rol.b   #2, d0
        andi.b  #3, d0
        move.b  d0, PPHYS_QUADRANT(a4)

        // jump buffer: latch PHYS_JUMP_BUFFER on a press edge, else tick down.
        // Maintained here; the ground-state jump check CONSUMES it.
        //
        // B IS a jump button — except while the debug-fly cheat owns it. The
        // conflict is on EXITING free-flight, not entering: entering returns early
        // through Player_DebugMove and never reaches this latch, but DebugExit
        // clears debug_flag and falls straight through to normal physics, so the
        // same B press that left free-flight would buffer a jump on that very tick.
        // Hence B is excluded from the mask exactly while CHEAT_DEBUG_FLY is armed.
        //
        // The bit is READ HERE, never cached: a cheat code can arm it on any frame.
        // Cost is on the right side of the hot path — the A|B|C test short-circuits
        // on every frame with no face-button press edge, which is nearly all of
        // them, so the cheat probe only runs on an actual jump press. d0 is dead
        // here (the quadrant it held was stored above), so the moveq/and probe is
        // free of register pressure; it is also the one shape a port-test compile
        // can lower, since `btst #<cheat const>, Cheat_Flags` would pair two link
        // symbols.
        //
        // player_air's variable-jump-height HELD check uses the same two masks and
        // the same gate; they must not drift or a B jump latches without
        // sustaining (clipped arc).
        andi.b  #BUTTON_JUMP_MASK, d6           // A|B|C — classic three-button jump
        beq     .no_latch
        moveq   #CHEAT_DEBUG_FLY, d0
        and.b   Cheat_Flags, d0                 // (Cheat_Flags).w — runtime cheat gate
        beq     .latch                          // cheat clear: B jumps like A and C
        andi.b  #BUTTON_JUMP_MASK_NO_B, d6      // armed: B is the fly toggle, not a jump
        beq     .no_latch
.latch:
        move.b  #PHYS_JUMP_BUFFER, PPHYS_JUMPBUF(a4)
        jbra    .buffer_done
.no_latch:
        tst.b   PPHYS_JUMPBUF(a4)
        beq     .buffer_done
        subq.b  #1, PPHYS_JUMPBUF(a4)
.buffer_done:

        // --- state dispatch. d7 saved across: Player_SensorFloor legitimately
        // clobbers it inside the handlers ---
        move.w  d7, -(sp)
        lea     Player_States(pc), a1
        moveq   #0, d0
        move.b  PlayerV.player_state(a0), d0
        move.w  (a1,d0.w), d1
        jsr     (a1,d1.w) as PlayerState
        move.w  (sp)+, d7

        // --- on-object bit: 1-frame-lagged (TouchResponse runs AFTER this
        // frame; everything in the player tick reads the LIVE bit set by LAST
        // tick's TouchResponse). The per-frame CLEAR lives at the top of
        // TouchResponse's player loop (collision.asm), not here. ---

        jbsr    Player_LevelBound               // classic LevelBound, post-dispatch

        // --- position history rings — LEADER ONLY. This is the trail a follower
        // reads to lag behind the leader, so exactly one slot may write it: two
        // writers would interleave their samples at the 4-byte stride and the ring
        // would describe no player at all. The gate is the same compare the block
        // derivation makes (a4 is not a proxy for it — both slots hold a valid
        // block), and it is one compare per player per frame. Non-leader slots
        // fall straight through to the shared display tail. ---
        cmpa.w  #Player_1, a0
        bne     .rings_done
        move.w  Player_Ring_Index, d0
        lea     Player_Pos_Ring, a1
        move.w  x_pos(a0), (a1,d0.w)
        move.w  y_pos(a0), 2(a1,d0.w)
        lea     Player_Stat_Ring, a1
        move.b  Ctrl_1_Held, d1
        lsl.w   #8, d1
        move.b  Ctrl_1_Press, d1
        move.w  d1, (a1,d0.w)                   // input word (Held<<8|Press)
        move.b  status(a0), 2(a1,d0.w)          // +pad byte left untouched
        addq.b  #4, Player_Ring_Index+1         // (Player_Ring_Index+1).w — low-byte
                                                // wrap; rings are 256-aligned (ram.asm)
.rings_done:
        // fall through to the shared display tail
}

// -----------------------------------------------
// Player_Display — classify the animation, advance it, stream art, draw.
// In:  a0 = player SST
// Clobbers: d0-d6, a1-a3 (d5-d6 via Player_Animate's balance-path ledge probe)
// -----------------------------------------------
pub proc Player_Display (a0: *Sst) clobbers(d0-d6/a1-a3) {
        jbsr    Player_Animate                  // sets SST_anim + d3 (dyn hold)
        jbsr    AnimateSprite
        jbra    Player_LoadArt
}

// -----------------------------------------------
// Player_Animate — read-only animation classifier. Reads state/status/input and
// (at rest) one ledge sensor; writes ONE ANIM_* id to SST_anim and the
// speed-scaled hold to d3. Mutates the display transients skid_latch and
// getup_timer (the get-up one-shot counts down here).
// Priority: spindash > ball > skid > push > (rest: getup > duck > lookup >
// balance > idle) > run/walk.
// In:  a0 = player SST
// Out: SST_anim set; d3.b = dynamic per-anim hold (for DUR_DYNAMIC scripts)
// Clobbers: d0-d6, a1-a2 (d3 is an output; d0-d2/d4 in the body). The balance
//           path additionally trashes d5-d6 via Player_AtLedgeEdge (clobbers
//           d0-d6; d6 = the SOLID_TOP class mask) — caller (Player_Display, a
//           frame-tail routine) keeps no live d5-d6 across this call.
// -----------------------------------------------
pub proc Player_Animate (a0: *Sst) clobbers(d0-d6/a1-a2) {
        // speed-scaled hold for DUR_DYNAMIC scripts (walk/run):
        // hold = max(0,($800-|gsp|)>>8). Computed up front; the ball path
        // RECOMPUTES it from $400 (S3K Animate_Sonic rolls at 4-|gsp|, twice
        // the walk flip rate — sonic3k.asm loc_12A2A `addi.w #$400`). The
        // balance path clobbers d3 (sensor) but leads to a FIXED-duration
        // anim, so it's moot.
        move.w  PlayerV.ground_speed(a0), d0
        abs_w(d0)
        move.w  #$800, d4
        sub.w   d0, d4
        bpl     .hold_ok
        moveq   #0, d4
.hold_ok:
        lsr.w   #8, d4
        move.b  d4, d3

        move.b  PlayerV.player_state(a0), d0
        // (1) spindash
        cmpi.b  #PSTATE_SPINDASH, d0
        bne     .not_spindash
        move.b  #ANIM_SPINDASH, anim(a0)
        rts
.not_spindash:
        // (2) ball: ROLL + curled air (JUMP/ROLLJUMP/AIRBALL >= PSTATE_JUMP)
        cmpi.b  #PSTATE_JUMP, d0
        bhs     .ball
        cmpi.b  #PSTATE_ROLL, d0
        bne     .uncurled
.ball:
        // S3K-exact roll hold: max(0,($400-|gsp|)>>8) — the prologue's $800
        // walk hold would spin the ball at HALF the classic rate (Harmony
        // study defect #1). ground_speed is the right input even airborne
        // (S3K reads ground_vel in its roll path too).
        move.w  PlayerV.ground_speed(a0), d4
        abs_w(d4)
        move.w  #$400, d3
        sub.w   d4, d3
        bpl     .roll_hold_ok
        moveq   #0, d3
.roll_hold_ok:
        lsr.w   #8, d3
        move.b  #ANIM_ROLL, anim(a0)
        rts
.uncurled:
        // GROUND or uncurled AIR. Airborne keeps the walk/run cycle; the
        // grounded-only conditions are gated below.
        btst    #ST_IN_AIR, status(a0)
        bne     .walk_or_run

        // (3) skid — grounded, opposing input held, |gsp| >= PHYS_SKID_MIN.
        // Latch holds the pose through the brake WHILE opposing input is held;
        // cleared at rest or when the opposing input is released.
        move.w  PlayerV.ground_speed(a0), d1
        beq     .skid_drop                      // stopped -> clear latch
        move.b  Ctrl_1_Held, d2
        tst.w   d1
        bmi     .skid_left
        btst    #BUTTON_LEFT_BIT, d2            // moving right: opposing = LEFT
        beq     .skid_drop
        jbra    .skid_opposing
.skid_left:
        btst    #BUTTON_RIGHT_BIT, d2           // moving left: opposing = RIGHT
        beq     .skid_drop
.skid_opposing:
        tst.b   PlayerV.skid_latch(a0)
        bne     .skid_show                      // already latched -> keep (no new sfx)
        move.w  d1, d2
        abs_w(d2)
        cmpi.w  #PHYS_SKID_MIN, d2
        blo     .not_skid                       // opposing but too slow to arm
        // fresh-arm edge — fire the skid SFX once before latching
        if SOUND_DRIVER_ENABLED == 1 {
                moveq   #SFXID_SKID, d0 as SfxId
                jsr     Sound_PlaySFX           // explicit jsr (kept-width class): the input-6button
                                                // +0xB0 shift put Sound_PlaySFX (debug $81BA) right at
                                                // the bsr.w reach boundary from this bank — jbsr's
                                                // ladder is convergence-history-dependent there (the
                                                // whole-ROM build locks jsr, a standalone lower picks
                                                // bsr.w), so the encoding is PINNED placement-
                                                // independent like every cross-bank call. Byte-equal
                                                // to the converged jbsr in both shapes.
        }
.skid_show:
        st      PlayerV.skid_latch(a0)
        move.b  #ANIM_SKID, anim(a0)
        rts
.skid_drop:
        clr.b   PlayerV.skid_latch(a0)
.not_skid:

        // (4) push — grounded, ST_PUSHING (facing-aware bit from ground code)
        btst    #ST_PUSHING, status(a0)
        beq     .not_push
        move.b  #ANIM_PUSH, anim(a0)
        rts
.not_push:
        // rest vs moving
        tst.w   PlayerV.ground_speed(a0)
        bne     .walk_or_run

        // --- at rest ---
        // get-up one-shot: mechanism in place; nothing arms _pl_getup in
        // gameplay this pass (in-game get-up trigger deferred).
        tst.b   PlayerV.getup_timer(a0)
        beq     .rest_input
        subq.b  #1, PlayerV.getup_timer(a0)
        move.b  #ANIM_GETUP, anim(a0)
        rts
.rest_input:
        // (5) duck
        btst    #BUTTON_DOWN_BIT, Ctrl_1_Held
        beq     .not_duck
        move.b  #ANIM_DUCK, anim(a0)
        rts
.not_duck:
        // (6) look up
        btst    #BUTTON_UP_BIT, Ctrl_1_Held
        beq     .not_lookup
        move.b  #ANIM_LOOKUP, anim(a0)
        rts
.not_lookup:
        // (9) balance at a ledge edge — (7)/(8) in the priority table are
        // run/walk, handled below in .walk_or_run (the moving branch)
        jbsr    Player_AtLedgeEdge              // beq = supported
        beq     .idle
        move.b  #ANIM_BALANCE, anim(a0)
        rts
.idle:
        move.b  #ANIM_IDLE, anim(a0)
        rts

.walk_or_run:
        move.w  PlayerV.ground_speed(a0), d1
        abs_w(d1)
        cmpi.w  #ANIM_RUN_THRESHOLD, d1
        blt     .walk
        move.b  #ANIM_RUN, anim(a0)
        rts
.walk:
        move.b  #ANIM_WALK, anim(a0)
        rts
}

// Player_States — the state-handler jump table (§4.7 `offsets`). Each word is
// `handler - Player_States`; the dispatch reads it at `player_state` (a word-
// scaled PSTATE_* byte). The handler targets are bare cross-module link refs
// (L11: bare = cross-module) — PState_* are `pub proc`s in the sibling player
// modules (player_ground/air/spindash). Declaration order is PSTATE_* order;
// `.count` replaces the hand `ensure(7 == PSTATE_COUNT)`.
pub offsets Player_States {
        Ground:   PState_Ground,        // PSTATE_GROUND (player_ground)
        Roll:     PState_Roll,          // PSTATE_ROLL (player_ground)
        Spindash: PState_Spindash,      // PSTATE_SPINDASH (player_spindash)
        Air:      PState_Air,           // PSTATE_AIR (player_air)
        Jump:     PState_Jump,          // PSTATE_JUMP (player_air)
        RollJump: PState_RollJump,      // PSTATE_ROLLJUMP (player_air)
        AirBall:  PState_AirBall,       // PSTATE_AIRBALL (player_air)
}
ensure(Player_States.count == PSTATE_COUNT, "Player_States table out of sync with PSTATE_*")

// -----------------------------------------------
// Player_SetState — THE one transition writer for player_state.
// Old state's exit hook → write state byte → new state's enter hook.
// In:  a0 = player SST, d0.w = new PSTATE_* (byte offset, word-clean)
// Out: none
// Clobbers: d1, a1 (+ hook clobbers: d2, a2)
// Hooks contract: preserve a0/d0/d7
// -----------------------------------------------
pub proc Player_SetState (a0: *Sst) clobbers(d1-d2/a1-a2) {
        lea     PState_ExitHooks(pc), a1
        moveq   #0, d1
        move.b  PlayerV.player_state(a0), d1
        move.w  (a1,d1.w), d1
        jsr     (a1,d1.w) as PlayerHook
        move.b  d0, PlayerV.player_state(a0)    // written BEFORE the enter hook
        lea     PState_EnterHooks(pc), a1
        move.w  (a1,d0.w), d1
        jmp     (a1,d1.w) as PlayerHook
}

// PState_EnterHooks — the enter-hook jump table (§4.7 `offsets`), indexed like
// Player_States. The PHook_* targets are same-module procs (defined below);
// JUMP/ROLLJUMP/AIRBALL all enter through PHook_AirBallEnter (repeated targets
// are fine — each word is that handler's self-relative offset). `.count`
// replaces the hand `ensure`.
pub offsets PState_EnterHooks {
        Ground:   PHook_GroundEnter,    // GROUND
        Roll:     PHook_RollEnter,      // ROLL
        Spindash: PHook_SpindashEnter,  // SPINDASH
        Air:      PHook_AirEnter,       // AIR (uncurled)
        Jump:     PHook_AirBallEnter,   // JUMP
        RollJump: PHook_AirBallEnter,   // ROLLJUMP
        AirBall:  PHook_AirBallEnter,   // AIRBALL
}
ensure(PState_EnterHooks.count == PSTATE_COUNT, "PState_EnterHooks table out of sync with PSTATE_*")

// PState_ExitHooks — the exit-hook jump table (§4.7 `offsets`), indexed like
// Player_States. Only SPINDASH has a non-null exit hook (charge→gsp convert);
// every other state exits through PHook_Null. `.count` replaces the hand
// `ensure`.
pub offsets PState_ExitHooks {
        Ground:   PHook_Null,           // GROUND
        Roll:     PHook_Null,           // ROLL
        Spindash: PHook_SpindashExit,   // SPINDASH
        Air:      PHook_Null,           // AIR
        Jump:     PHook_Null,           // JUMP
        RollJump: PHook_Null,           // ROLLJUMP
        AirBall:  PHook_Null,           // AIRBALL
}
ensure(PState_ExitHooks.count == PSTATE_COUNT, "PState_ExitHooks table out of sync with PSTATE_*")

// ===== Enter/exit hooks — the ONE writer for width/height, curl y-shift,
// collision-mode resets, and anim latches (spec §3.3). NOTHING outside these
// hooks may touch those fields — the sole tolerated exception is the debug-fly
// art swap, which sits outside the state machine entirely. Hooks preserve
// a0/d0/d7.
pub proc PHook_Null () clobbers() {
        rts
}

pub proc PHook_GroundEnter (a0: *Sst) clobbers() {
        jbsr    PHook_EnsureStanding            // uncurl (jump/ball landings;
                                                // down-held landings go straight
                                                // to ROLL via Air_LandState)
        bclr    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_AirEnter (a0: *Sst) clobbers() { // uncurled airborne
        jbsr    PHook_EnsureStanding
        bset    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_AirBallEnter (a0: *Sst) clobbers() { // JUMP / ROLLJUMP / AIRBALL
        jbsr    PHook_EnsureBall
        bset    #ST_IN_AIR, status(a0)
        rts
}

pub proc PHook_RollEnter (a0: *Sst) clobbers() { // grounded ball — entered from
        jbsr    PHook_EnsureBall                // GROUND (roll start), SPINDASH
        bclr    #ST_IN_AIR, status(a0)          // (release), or a curled/down-
        rts                                     // held landing (air → cleared)
}

pub proc PHook_SpindashEnter (a0: *Sst) clobbers() { // entered only from GROUND —
        jbsr    PHook_EnsureStanding            // the player is pinned charging
                                                // at STANDING size (classic S2:
                                                // curl + feet-planted shift
                                                // happen at RELEASE via ROLL's
                                                // enter hook — the donor charge
                                                // frames are drawn for the
                                                // standing origin)
        bclr    #ST_IN_AIR, status(a0)
        clr.w   PlayerV.ground_speed(a0)
        clr.w   x_vel(a0)
        clr.w   y_vel(a0)
        clr.w   PlayerV.spindash_charge(a0)     // the initiating press is rev 0
        rts                                     // Rev SFX fired per-tap in player_spindash.asm
}

pub proc PHook_SpindashExit (a0: *Sst) clobbers() {
        clr.w   PlayerV.spindash_charge(a0)     // release converts charge→gsp
        rts                                     // BEFORE SetState; an aborted
                                                // charge just drops it
}

// bug #5 fix (structural): the collision box lives ONLY here — every curled
// state gets ball radii with the symmetric ±CURL_Y_SHIFT feet-planted shift, so
// the classic roll-jump 5px size mismatch cannot exist. Enter-hook-owns-it:
// each enter hook ENSURES its size, keyed on the current height byte —
// idempotent and correct for every transition path.
//
// ST_ROLLING is tied to the SAME pair so the "in ball form" bit can never desync
// from the radii. It is set/cleared UNCONDITIONALLY — outside the height-keyed
// guard — because the debug-fly art swap writes a third height (16) outside the
// state machine: a debug round-trip re-enters via SetState and the hook must
// repair the bit even when the height byte needs no curl work.
pub proc PHook_EnsureStanding (a0: *Sst) clobbers() {
        bclr    #ST_ROLLING, status(a0)
        cmpi.b  #BALL_Y_RADIUS*2+1, height_pixels(a0)
        bne     .keep                           // not curled (incl. debug 16)
        set_standing_size(a0)
        subi.l  #CURL_Y_SHIFT<<16, y_pos(a0)
.keep:
        rts
}

pub proc PHook_EnsureBall (a0: *Sst) clobbers() {
        bset    #ST_ROLLING, status(a0)
        cmpi.b  #BALL_Y_RADIUS*2+1, height_pixels(a0)
        beq     .keep                           // already curled
        set_ball_size(a0)
        addi.l  #CURL_Y_SHIFT<<16, y_pos(a0)
.keep:
        rts
}

// -----------------------------------------------
// Player_SnapToSurface — move the player a signed pixel distance along the floor
// pair's PROBE axis. Mirrors Player_SensorFloor's case table EXACTLY
// (player_sensors.asm) — probe direction per quadrant:
//   quadrant 0: Collision_ProbeDown  → y_pos += dist
//   quadrant 1: Collision_ProbeLeft  → x_pos −= dist
//   quadrant 2: Collision_ProbeUp    → y_pos −= dist
//   quadrant 3: Collision_ProbeRight → x_pos += dist
// In:  a0 = player SST, a4 = the slot's player block (the quadrant it reads is
//      per-slot), d0.w = signed surface distance (px)
// Out: none
// Clobbers: d0, d2
// -----------------------------------------------
pub proc Player_SnapToSurface (a0: *Sst) clobbers(d0/d2) {
        dist_to_fix(d0)
        move.b  PPHYS_QUADRANT(a4), d2
        beq     .down                           // floor mode — common case
        subq.b  #2, d2
        bmi     .left                           // quadrant 1
        beq     .up                             // quadrant 2
        add.l   d0, x_pos(a0)                   // quadrant 3
        rts
.down:
        add.l   d0, y_pos(a0)
        rts
.left:
        sub.l   d0, x_pos(a0)
        rts
.up:
        sub.l   d0, y_pos(a0)
        rts
}

// Classic Sonic_LevelBound margins: the player center may approach the left
// playable edge to 16px and the right edge to 24px (asymmetric in the originals
// — kept verbatim). Bottom margin: detection slack below the playable bottom;
// must exceed the per-frame fall cap (PHYS_FALL_CAP = 16px) so a single frame's
// fall can never overshoot the guard transiently.
const PBOUND_LEFT_MARGIN   = 16
const PBOUND_RIGHT_MARGIN  = 24
const PBOUND_BOTTOM_MARGIN = 48
ensure(PBOUND_BOTTOM_MARGIN > (PHYS_FALL_CAP >> 8), "PBOUND_BOTTOM_MARGIN must exceed the per-frame fall cap")

// -----------------------------------------------
// Player_BoundsInit — compute the act-invariant player clamp edges (M3).
// Call once per act init, after the act descriptor is live; Player_LevelBound
// consumes the cached words per-frame instead of re-deriving them. The
// derivations mirror Player_LevelBound's retired per-frame chains exactly
// (split 8+3 shift, word-domain subtract), so the cached words are
// bit-identical to what the per-frame code computed.
//   right  = (grid_w << SECTION_SIZE_SHIFT) − PBOUND_RIGHT_MARGIN
//   bottom = (grid_h << SECTION_SIZE_SHIFT) − SCREEN_HEIGHT
// MEGA-ACT CEILING: the word store word-wraps for level_width/height above
// $FFFF px — grid dim > 31 sections; guarded by act_descriptor's <= $8000
// ensure. That trap now lives HERE only.
// In:  a0 = act descriptor
// Out: none
// Clobbers: d1
// -----------------------------------------------
pub proc Player_BoundsInit (a0: *Act) clobbers(d1) {
        moveq   #0, d1
        move.w  Act.grid_w(a0), d1
        lsl.l   #8, d1
        lsl.l   #3, d1                          // grid_w × 2048 = level_width (px)
        subi.w  #PBOUND_RIGHT_MARGIN, d1
        move.w  d1, Player_Bound_Right
        moveq   #0, d1
        move.w  Act.grid_h(a0), d1
        lsl.l   #8, d1
        lsl.l   #3, d1                          // grid_h × 2048 = level_height (px)
        subi.w  #SCREEN_HEIGHT, d1
        move.w  d1, Player_Bound_Bottom
        rts
}

// -----------------------------------------------
// Player_LevelBound — clamp the player to the act's playable bounds (classic
// Sonic_LevelBound, adapted to world coordinates).
//
// PLACEMENT: called once from Player_Main right after the state dispatch, before
// the history rings. A single post-dispatch call clamps the same end-of-frame
// position without per-state duplication, and the history rings then record the
// CLAMPED position. Debug-fly never reaches this — bounds are deliberately
// SKIPPED in debug-fly, which is for inspecting anywhere, including off-world.
//
// Continuous-scroll: X/Y are world coordinates spanning the whole act, so the
// bounds are the act's world extents directly:
//   left  — world origin: bound = PBOUND_LEFT_MARGIN (x ≥ 0 + margin).
//   right — level_width − PBOUND_RIGHT_MARGIN, level_width = grid_w << SECTION_SIZE_SHIFT.
//   bottom — playable bottom = (grid_h << SECTION_SIZE_SHIFT) − SCREEN_HEIGHT.
//   top   — NO clamp (classic allows above-screen travel).
// The right/bottom edges are act-invariant, so they are precomputed once by
// Player_BoundsInit (M3) and read back here as cached words per-frame.
//
// On X clamp: integer x written with subpixel zeroed, x_vel and gsp cleared.
// On bottom trip: y is clamped to the playable bottom edge and y_vel zeroed
// (a placeholder until death/respawn exists).
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d2, a1
// -----------------------------------------------
pub proc Player_LevelBound (a0: *Sst) clobbers(d0-d2/a1) {
        move.w  x_pos(a0), d0                   // integer X (16.16 high word)

        // --- left bound: world [0, level_width) ---
        move.w  #PBOUND_LEFT_MARGIN, d1
        cmp.w   d1, d0
        blt     .clamp_x
        // --- right bound: world level_width − margin ---
        //     cached by Player_BoundsInit at act init (M3) — the derivation
        //     (and the MEGA-ACT word-wrap trap note) lives there now.
        move.w  Player_Bound_Right, d1
        if DEBUG == 1 { assert.w d1, ne, #0 }   // zero = Player_BoundsInit never ran
        cmp.w   d1, d0
        ble     .x_done
.clamp_x:
        move.w  d1, x_pos(a0)
        clr.w   SST_x_pos_sub(a0)               // subpixel zeroed (classic)
        clr.w   x_vel(a0)
        clr.w   PlayerV.ground_speed(a0)
.x_done:
        // --- bottom guard (no top clamp) ---
        //     playable bottom cached by Player_BoundsInit at act init (M3).
        move.w  y_pos(a0), d0                   // integer Y
        move.w  Player_Bound_Bottom, d1         // d1 = playable bottom edge (world)
        move.w  d1, d2
        addi.w  #PBOUND_BOTTOM_MARGIN, d2
        cmp.w   d2, d0
        ble     .y_ok                           // above the bottom guard → done
        // --- player tripped the bottom edge: dispatch on the act's edge_mode ---
        //     act ptr loaded HERE (rare path): edge_mode is its only remaining
        //     consumer since M3 cached the extents.
        movea.l Current_Act_Ptr, a1
        move.b  Act.edge_mode(a1), d2
        cmpi.b  #EDGE_WRAP_V, d2
        beq     .edge_wrap
        cmpi.b  #EDGE_KILL, d2
        beq     .edge_kill
        // EDGE_CLAMP (default) — clamp to the bottom edge. With editor-authored /
        // S&K collision the player can fall through air or an erased floor by
        // design (pits, WIP), so this is expected — just clamp.
.edge_clamp:
        move.w  d1, y_pos(a0)                   // d1 still = playable bottom edge
        clr.w   SST_y_pos_sub(a0)
        clr.w   y_vel(a0)
.y_ok:
        rts
.edge_wrap:
        // EDGE_WRAP_V — vertical "fall-forever" wrap (not implemented; current
        // build uses EDGE_CLAMP). A correct wrap is an atomic live-set shift by
        // ±level_height + camera Y-clamp edge-mode awareness. Full design: spec
        // §10. Until built: clamp.
        jbra    .edge_clamp
.edge_kill:
        // EDGE_KILL — death pit. No death/respawn system exists yet, so this
        // records intent and clamps meanwhile. When the death system exists it
        // consumes Player_Death_Pending; this stays the single trigger point.
        st      Player_Death_Pending            // set the death-pending flag ($FF)
        jbra    .edge_clamp                     // clamp until the death system exists
}

// -----------------------------------------------
// Debug-fly — suspends the state machine (the obj_control escape hatch). Enter
// swaps to the yellow marker square; exit restores Sonic and drops into
// PSTATE_AIR with velocities cleared. The art/size writes here are the one
// tolerated exception to the hook one-writer rule (outside the state machine).
// -----------------------------------------------
// In:  a0 = player SST.  Clobbers: d2, a1 (RefreshSpritePieceCount)
pub proc Player_DebugEnter (a0: *Sst) clobbers(d2/a1) {
        st      PlayerV.debug_flag(a0)
        move.l  #Map_TestObj, mappings(a0)
        move.w  #vram_art(VRAM_TEST_MARKER, 1, 1), art_tile(a0) // PlayerMarkerTile
        move.b  #16, width_pixels(a0)
        move.b  #16, height_pixels(a0)
        clr.b   mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // debug path skips AnimateSprite's refresh:
                                                // re-cache piece count + frame_off here
        clr.w   x_vel(a0)
        clr.w   y_vel(a0)
        clr.w   PlayerV.ground_speed(a0)
        rts
}

// In:  a0 = player SST.  Clobbers: d0-d2, a1-a2
pub proc Player_DebugExit (a0: *Sst) clobbers(d0-d2/a1-a2) {
        sf      PlayerV.debug_flag(a0)
        jbsr    Player_InitAssets
        // standing radii until the AIR frame lands and hooks take over
        set_standing_size(a0)
        clr.b   mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // prev_anim=$FF forces a refresh NEXT
                                                // frame, but a render can run before
                                                // that — re-cache now (d2/a1 in our set)
        move.b  #$FF, prev_anim(a0)
        move.b  #$FF, prev_frame(a0)
        clr.w   x_vel(a0)
        clr.w   y_vel(a0)
        clr.w   PlayerV.ground_speed(a0)
        moveq   #PSTATE_AIR, d0
        jbra    Player_SetState
}

// D-pad free flight at PLAYER_DEBUG_FLY_SPEED px/frame (camera Y clamp caps
// effective follow speed), draw only.
// In:  a0 = player SST.  Clobbers: d0-d3, a1 (a0/d7 preserved)
pub proc Player_DebugMove (a0: *Sst) clobbers(d0-d3/a1) preserves(a0) {
        move.b  Ctrl_1_Held, d0
        moveq   #PLAYER_DEBUG_FLY_SPEED, d1
        swap    d1                              // px → 16.16
        btst    #BUTTON_LEFT_BIT, d0
        beq     .check_right
        sub.l   d1, x_pos(a0)
.check_right:
        btst    #BUTTON_RIGHT_BIT, d0
        beq     .check_up
        add.l   d1, x_pos(a0)
.check_up:
        btst    #BUTTON_UP_BIT, d0
        beq     .check_down
        sub.l   d1, y_pos(a0)
.check_down:
        btst    #BUTTON_DOWN_BIT, d0
        beq     .draw
        add.l   d1, y_pos(a0)
.draw:
        jbra    Draw_Sprite
}
