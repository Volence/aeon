// Sonic — the character RECORD (§5). Pure data: the CharacterDef the shared
// player frame dispatches through, plus the physics base row it points at.
//
// There is no Sonic CODE any more. Asset wiring (mappings / art word / anim
// table), the DPLC + art immediates, and the physics source were the four places
// the player frame named "Sonic"; all four now read this record through
// Player_Chardef, so Tails and Knuckles are a second and third record here — not
// a second and third branch in player_common.
module games.sonic4.sonic in sonic

use engine.structs.{CharacterDef}
use games.sonic4.ram.{PlayerBlock}
use engine.constants.{PHYS_ACCEL, PHYS_DECEL, PHYS_FRICTION, PHYS_TOP_SPEED, PHYS_GRAVITY, PHYS_JUMP_FORCE, PHYS_AIR_ACCEL, PHYS_JUMP_RELEASE_CAP}
use engine.constants.{PLAYER_X_RADIUS, PLAYER_Y_RADIUS, BALL_X_RADIUS, BALL_Y_RADIUS}

// VRAM_TEST_SONIC — tile 960, the character DPLC window: 32 tiles, 960 up to
// the VRAM_TEST_OBJ wall at 992 (Sonic's own art peaks at 29). A game-config
// value, imported from games.sonic4.constants below.
use games.sonic4.constants.{VRAM_TEST_SONIC}

// PHYS_* — Sonic's 8 section-modifiable physics base values (the PhysTable_Sonic
// row below), consumed from engine.constants via `use engine.constants.{...}`
// above.

// -----------------------------------------------
// CharDef_Sonic — the record the roster (CharacterDefs, characters.emp)
// points at for CHAR_SONIC.
//
// cd_stand_wh / cd_roll_wh are the character's collision boxes as the packed
// W<<8|H word the enter hooks store into the SST (2r+1 full dims, derived from
// the shared engine radii rather than restated as numbers). The hooks remain the
// one writer of the live SST fields — they just read the box from here, so a
// character whose boxes differ declares them instead of forking the hooks.
// -----------------------------------------------
pub data CharDef_Sonic: CharacterDef = CharacterDef{
    cd_phys:      PhysTable_Sonic,
    cd_mappings:  extern("Map_Sonic"),
    cd_dplc:      extern("DPLC_Sonic"),
    cd_artbase:   extern("Art_Sonic"),
    cd_animtable: extern("Ani_Sonic"),
    cd_ability:   extern("Ability_None"),   // no double jump / glide / flight
    cd_vrambase:  VRAM_TEST_SONIC,
    cd_stand_wh:  ((PLAYER_X_RADIUS * 2 + 1) << 8) | (PLAYER_Y_RADIUS * 2 + 1),
    cd_roll_wh:   ((BALL_X_RADIUS * 2 + 1) << 8) | (BALL_Y_RADIUS * 2 + 1),
    cd_flags:     0,
    // The palette Sonic has always rendered against — the same 32 bytes the act
    // init already copies into line 0, so this is behaviour-neutral on a cold boot.
    // It is NOT 0 ("leave line 0 alone") on purpose: the debug hotkey cycles
    // Sonic -> Tails -> Knuckles -> Sonic, and a 0 here would leave Knuckles'
    // palette in line 0 on the way back and render Sonic in his colours.
    cd_palette:   extern("Pal_SonicTails"),
}
// curl_head_rise derives the curl geometry with a `sub.b` of the two box heights
// and relies on it not borrowing. Nothing makes a character taller by curling,
// but the derivation reads DATA, so the record states the invariant.
ensure(PLAYER_Y_RADIUS >= BALL_Y_RADIUS,
       "CharDef_Sonic's ball is taller than its standing box — curl_head_rise's sub.b would borrow")

// -----------------------------------------------
// Sonic's physics base table — block-copied into the calling slot's
// PlayerBlock by Player_RefreshPhysics (the per-CHARACTER base row; section
// modifiers compose there later, NEVER per-frame). Field order is bound to the
// PlayerBlock physics row (config/ram.emp) — the ensure below enforces size.
// SCOPE NOTE: ONLY these 8 fields are section-modifiable. The other
// physics values (GSp/fall caps, slope factors, roll friction/decel,
// slip params, spindash + roll thresholds) are direct PHYS_*/SPINDASH_*
// immediates in the state code — S3K invariants, intentionally NOT in
// this table; a future per-section modifier would not touch them.
// -----------------------------------------------
pub data PhysTable_Sonic: [i16; 8] = [
        PHYS_ACCEL,
        PHYS_DECEL,
        PHYS_FRICTION,
        PHYS_TOP_SPEED,
        PHYS_GRAVITY,
        PHYS_JUMP_FORCE,
        PHYS_AIR_ACCEL,
        PHYS_JUMP_RELEASE_CAP,
]
// The physics row is the head of PlayerBlock, so its length is the offset of the
// first non-physics field. Guards the same fact the retired mark-difference did:
// this 8-word ROM row and the RAM row Player_RefreshPhysics block-copies it into
// must be the same size.
ensure(8 * 2 == offsetof(PlayerBlock, quadrant), "PhysTable_Sonic out of sync with the PlayerBlock physics row")
