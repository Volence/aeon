// Player airborne states — AIR/JUMP/ROLLJUMP/AIRBALL share one body
// (§5); tiny preambles set the two behavior bits. Reached only
// through the Player_States offset table in player_common.asm; shares
// its overlay equates, macros, and the (a4) physics-table convention.
//
// Lives in the object code bank, included from main.asm immediately
// after player_ground.asm.
//
// Gate SIGIL_EMP_PLAYER_AIR (main.asm arms a plain ifndef — pure code).
module games.sonic4.player_air in player_air

use engine.objects.sst.{Sst}
use games.sonic4.player_common.{PlayerV, mask_opposing_lr, dist_to_fix}

// Boundary decls to the surviving-AS player_sensors (ports at P4). Cross-seam
// today, module-to-module once sensors port. KILL ROW: delete when P4 lands.
extern proc Player_SensorFloor (a0: *Sst) clobbers(d0-d7/a1-a2)
extern proc Player_SensorCeiling (a0: *Sst) clobbers(d0-d7/a1-a2)
extern proc Player_SensorWallAt (a0: *Sst) clobbers(d0-d6/a1)

// ── game-config mirrors (config/constants.asm) ───────────────────────────────
const PSTATE_GROUND = 0
ensure(extern("PSTATE_GROUND") == PSTATE_GROUND, "config/constants.asm PSTATE_GROUND drifted")

// ── engine-constant mirrors (engine/constants.asm; file-local, hoist ledgered) ─
const PHYS_FALL_CAP      = $1000
const PHYS_ROLL_START_MIN = $100
const PUSH_RADIUS        = 10
const ST_XFLIP           = 1
const ST_ON_OBJECT       = 5
const ST_PUSHING         = 6
const BUTTON_LEFT        = 4
const BUTTON_RIGHT       = 8
const BUTTON_A           = $40
const BUTTON_C           = $20
ensure(extern("PHYS_FALL_CAP")       == PHYS_FALL_CAP,       "engine/constants.asm PHYS_FALL_CAP drifted")
ensure(extern("PHYS_ROLL_START_MIN") == PHYS_ROLL_START_MIN, "engine/constants.asm PHYS_ROLL_START_MIN drifted")
ensure(extern("PUSH_RADIUS")         == PUSH_RADIUS,         "engine/constants.asm PUSH_RADIUS drifted")
ensure(extern("ST_XFLIP")            == ST_XFLIP,            "engine/constants.asm ST_XFLIP drifted")
ensure(extern("ST_ON_OBJECT")        == ST_ON_OBJECT,        "engine/constants.asm ST_ON_OBJECT drifted")
ensure(extern("ST_PUSHING")          == ST_PUSHING,          "engine/constants.asm ST_PUSHING drifted")
ensure(extern("BUTTON_LEFT")         == BUTTON_LEFT,         "engine/constants.asm BUTTON_LEFT drifted")
ensure(extern("BUTTON_RIGHT")        == BUTTON_RIGHT,        "engine/constants.asm BUTTON_RIGHT drifted")
ensure(extern("BUTTON_A")            == BUTTON_A,            "engine/constants.asm BUTTON_A drifted")
ensure(extern("BUTTON_C")            == BUTTON_C,            "engine/constants.asm BUTTON_C drifted")

// Jump press sources: A and C only — B is the debug-fly toggle (player_common.asm).
const BUTTON_JUMP_MASK = BUTTON_A | BUTTON_C
ensure(extern("BUTTON_JUMP_MASK") == BUTTON_JUMP_MASK, "player_common.asm BUTTON_JUMP_MASK drifted")

// physics-table field offsets (a4-relative displacements; mirror
// player_common.asm's PPHYS_* = Phys_field − Player_Phys).
const PPHYS_TOP_SPEED  = 6
const PPHYS_GRAVITY    = 8
const PPHYS_AIR_ACCEL  = 12
const PPHYS_RELEASE_CAP = 14
ensure(extern("PPHYS_TOP_SPEED")  == PPHYS_TOP_SPEED,  "player_common.asm PPHYS_TOP_SPEED drifted")
ensure(extern("PPHYS_GRAVITY")    == PPHYS_GRAVITY,    "player_common.asm PPHYS_GRAVITY drifted")
ensure(extern("PPHYS_AIR_ACCEL")  == PPHYS_AIR_ACCEL,  "player_common.asm PPHYS_AIR_ACCEL drifted")
ensure(extern("PPHYS_RELEASE_CAP") == PPHYS_RELEASE_CAP, "player_common.asm PPHYS_RELEASE_CAP drifted")

// Air behavior flag bits, carried in d6.b through body steps 1-2 only —
// the sensor layer clobbers d6, but nothing after the input block reads
// the flags
const AIRF_RELEASE_CAP = 0     // variable jump height (JUMP/ROLLJUMP)
const AIRF_INPUT_LOCK  = 1     // air-input block skipped (ROLLJUMP)

// -----------------------------------------------
// PState_Air / PState_Jump / PState_RollJump / PState_AirBall —
// per-state preambles → shared air body.
//   AIR      uncurled fall (ledge walk-off, springs): no cap, no lock
//   JUMP     curled from a jump: release cap
//   ROLLJUMP as JUMP + the classic air-control lockout (research §5:
//            the WHOLE input block is skipped — drag still runs)
//   AIRBALL  curled, not from a jump (rolled off a ledge): no cap
// In:  a0 = player SST, a4 = Player_Phys
// Out: none (may transition to PSTATE_GROUND)
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
pub proc PState_Air (a0: *Sst) clobbers(d0-d7/a1-a2) falls_into PState_AirBall {}
pub proc PState_AirBall (a0: *Sst) clobbers(d0-d7/a1-a2) { // same flags as AIR today;
                                                // restack if they ever diverge
        moveq   #0, d6
        jbra    PState_AirShared
}
pub proc PState_RollJump (a0: *Sst) clobbers(d0-d7/a1-a2) {
        moveq   #(1<<AIRF_RELEASE_CAP)|(1<<AIRF_INPUT_LOCK), d6
        jbra    PState_AirShared
}
pub proc PState_Jump (a0: *Sst) clobbers(d0-d7/a1-a2) falls_into PState_AirShared {
        moveq   #1<<AIRF_RELEASE_CAP, d6
        // fall through
}

// NOT a dispatch target — enter ONLY via a preamble above that sets the
// AIRF_* flags in d6. Pointing a state table row here directly would run
// with whatever d6 holds at dispatch time.
proc PState_AirShared (a0: *Sst) clobbers(d0-d7/a1-a2) {
        // --- 0. on-object landing: a solid object caught us LAST tick
        // (Touch_Solid .solid_top snapped Y, zeroed y_vel, cleared
        // ST_IN_AIR, set ST_ON_OBJECT). Treat as a FLAT landing on the
        // object top — no slope, no position snap (the object already
        // positioned us). Convert by the flat rule (gsp = x_vel), then the
        // shared GROUND-vs-ROLL pick. Skips ALL air physics this frame
        // (gravity/input/sensors would re-detach us from the object). ---
        btst    #ST_ON_OBJECT, status(a0)
        beq     .not_on_obj
        clr.b   angle(a0)                       // flat object top
        move.w  x_vel(a0), PlayerV.ground_speed(a0) // flat conversion (gsp = x_vel)
        bclr    #ST_PUSHING, status(a0)
        jbsr    Air_LandState                   // d0 = GROUND/ROLL (curled
                                                // states uncurl in the enter
                                                // hook; down-held → ROLL)
        jbra    Player_SetState                 // tail — does NOT fall into
                                                // air physics below
.not_on_obj:
        // --- 1. variable jump height: while rising faster than the
        // release cap with no jump button held, cut to the cap ---
        btst    #AIRF_RELEASE_CAP, d6
        beq     .no_cap
        move.w  y_vel(a0), d0
        cmp.w   PPHYS_RELEASE_CAP(a4), d0
        bge     .no_cap                         // not rising past the cap
        move.b  Ctrl_1_Held, d1
        andi.b  #BUTTON_JUMP_MASK, d1
        bne     .no_cap                         // still held → full arc
        move.w  PPHYS_RELEASE_CAP(a4), y_vel(a0)
.no_cap:

        // --- 2. air input: x_vel directly — gsp is NOT authoritative
        // airborne. ROLLJUMP lockout skips the whole block (no accel,
        // no facing change) ---
        btst    #AIRF_INPUT_LOCK, d6
        bne     .input_done
        move.b  Ctrl_1_Held, d2
        mask_opposing_lr(d2)
        move.w  x_vel(a0), d0
        btst    #2, d2                          // LEFT
        bne     .air_left
        btst    #3, d2                          // RIGHT
        beq     .input_done
        bclr    #ST_XFLIP, status(a0)
        move.w  PPHYS_TOP_SPEED(a4), d1
        cmp.w   d1, d0
        bge     .input_done                     // S3K back-out: speed already
                                                // at/above top is preserved —
                                                // input never curtails it
        add.w   PPHYS_AIR_ACCEL(a4), d0
        cmp.w   d1, d0
        ble     .air_store
        move.w  d1, d0                          // crossed top this frame → clamp
        jbra    .air_store
.air_left:
        bset    #ST_XFLIP, status(a0)
        move.w  PPHYS_TOP_SPEED(a4), d1
        neg.w   d1
        cmp.w   d1, d0
        ble     .input_done                     // S3K back-out (mirror)
        sub.w   PPHYS_AIR_ACCEL(a4), d0
        cmp.w   d1, d0
        bge     .air_store
        move.w  d1, d0
.air_store:
        move.w  d0, x_vel(a0)
.input_done:

        // --- 3. air drag — ALL air states, lockout included. Exact
        // classic band: −$400 ≤ y_vel ≤ −1 (apex, rising slowly). The
        // asr supplies the sign work: x_vel in −$1F..−$1 still drags −1
        // toward zero while +0..+$1F drags 0; subtraction direction is
        // automatic for both signs and can't cross zero (|x>>5| ≤ |x|) ---
        move.w  y_vel(a0), d0
        bpl     .no_drag                        // falling/level → no drag
        cmpi.w  #-$400, d0
        blt     .no_drag                        // rising faster than $400
        move.w  x_vel(a0), d0
        move.w  d0, d1
        asr.w   #5, d1
        beq     .no_drag
        sub.w   d1, d0
        move.w  d0, x_vel(a0)
.no_drag:

        // --- 4. integrate, THEN gravity (classic order, research §4:
        // old y_vel moves you this frame, gravity sets up the next) ---
        jbsr    ObjectMove
        move.w  y_vel(a0), d0
        add.w   PPHYS_GRAVITY(a4), d0
        cmpi.w  #PHYS_FALL_CAP, d0
        ble     .fall_capped
        move.w  #PHYS_FALL_CAP, d0
.fall_capped:
        // FEEL DEVIATION (spec §2.1): classic non-jump up-velocity cap
        // (y_vel clamped to -$FC0) deliberately REMOVED — PHYS_GSP_CAP
        // ($1000) already bounds launches; if launches ever feel
        // truncated, the knob is PHYS_GSP_CAP, coupled to CAM_MAX_Y_STEP,
        // VFILL_ROWS_PER_FRAME, and the 32px sensor reach. Do not
        // re-add silently.
        move.w  d0, y_vel(a0)

        // --- 5. airborne angle decay: 2/frame toward 0, both directions
        // (research §3 end). Angles here are always even (the odd-flag
        // sensors substitute cardinals), so ±2 lands exactly on 0 ---
        move.b  angle(a0), d0
        beq     .angle_done
        bpl     .angle_pos
        addq.b  #2, d0
        jbra    .angle_set
.angle_pos:
        subq.b  #2, d0
.angle_set:
        move.b  d0, angle(a0)
.angle_done:

        // --- 6. collision by motion class. Air sensors NEVER rotate
        // with angle (research feel-modern §2) — force quadrant 0 for
        // the whole air sensor block: slip-detach goes airborne
        // carrying a wall-band angle that decays only 2/frame, and
        // without this the floor pair (and the landing snap axis in
        // Air_TouchFloor) would probe sideways during those frames.
        // Grounded frames recompute the quadrant in Player_Main ---
        clr.b   Player_Quadrant
        // |x_vel| vs |y_vel| compare + signs ≡ the classic
        // CalcAngle(x_vel,y_vel)−$20 & $C0 quadrant for non-boundary
        // vectors (each class spans the ±45° cone around its axis). On
        // the exact 45° diagonals (|x| == |y|) the classic's octant
        // boundaries split asymmetrically per CalcAngle rounding; our
        // tie rule: ties go to the VERTICAL class, so the down class
        // keeps landing authority on perfect diagonal launches.
        // Signed copies live in d3/d4 — no velocity re-reads below
        move.w  x_vel(a0), d3
        move.w  d3, d1
        bpl     .ax_pos
        neg.w   d1
.ax_pos:
        move.w  y_vel(a0), d4
        move.w  d4, d2
        bpl     .ay_pos
        neg.w   d2
.ay_pos:
        cmp.w   d2, d1                          // |x_vel| − |y_vel|
        bls     .vertical
        tst.w   d3
        bmi     .mostly_left

        // --- mostly RIGHT: right wall → ceiling bump → flat-rule floor ---
        jbsr    Air_WallProbeRight
        tst.w   d4
        beq     .right_no_wall
        // wall-run engage (classic HitRightWall): gsp picks up the fall
        // speed so a wall-quadrant attach can continue the motion
        move.w  y_vel(a0), PlayerV.ground_speed(a0)
.right_no_wall:
        jbsr    Air_CeilingBump
        jbra    Air_FloorLandFlat

.mostly_left:
        jbsr    Air_WallProbeLeft
        tst.w   d4
        beq     .left_no_wall
        move.w  y_vel(a0), PlayerV.ground_speed(a0)
.left_no_wall:
        jbsr    Air_CeilingBump
        jbra    Air_FloorLandFlat

.vertical:
        tst.w   d4                              // signed y_vel copy
        bmi     .mostly_up
        // --- mostly DOWN: both walls, then banded floor landing ---
        jbsr    Air_WallProbeLeft
        jbsr    Air_WallProbeRight
        jbra    Air_FloorLandBanded

.mostly_up:
        // --- mostly UP: both walls, then ceiling — bump or reattach ---
        jbsr    Air_WallProbeLeft
        jbsr    Air_WallProbeRight
        jbsr    Player_SensorCeiling            // d0 dist, d1 angle (slanted
                                                // ceiling angles pass through
                                                // — the wrapper substitutes a
                                                // cardinal only on odd flags)
        tst.w   d0
        bpl     .up_done                        // clear of the ceiling
        move.b  d1, d3                          // ceiling angle
        dist_to_fix(d0)
        sub.l   d0, y_pos(a0)                   // up-probe dist < 0 = head
                                                // embedded → snap DOWN (the
                                                // opposite of the floor snap)
        // flat-ceiling band → head bump; steeper ceiling slope while
        // moving mostly up → reattach grounded. Band test is the classic
        // (angle+$20)&$40: zero for angles $60-$9F — the flat-ceiling
        // range of the feel-modern §1 landing table (135°-225°, hex
        // $60-$A0); nonzero = steep ceiling slope ($20-$5F / $A0-$DF)
        move.b  d3, d0
        addi.b  #$20, d0
        andi.b  #$40, d0
        bne     .reattach
        clr.w   y_vel(a0)                       // bump (y_vel < 0 in this class)
.up_done:
        rts
.reattach:
        // research §2 "Ceiling contact": gsp = ±y_vel by the angle's
        // sign bit, angle = ceiling angle, grounded. y_vel survives —
        // the next ground frame's projection rebuilds both velocities
        // from gsp, preserving the upward motion along the surface
        move.b  d3, angle(a0)
        bclr    #ST_PUSHING, status(a0)
        jbsr    Air_GspFromYvel
        moveq   #PSTATE_GROUND, d0
        jbra    Player_SetState
}

// -----------------------------------------------
// Air_FloorLandBanded — down-class floor landing with the classic angle
// banding (research physics-classics §2 "Landing", S2 s2.asm:37570-37613;
// S3K is byte-identical — axis-select, NOT vector projection)
// In:  a0 = player SST
// Out: none (transitions to PSTATE_GROUND on landing)
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
proc Air_FloorLandBanded (a0: *Sst) clobbers(d0-d7/a1-a2) {
        jbsr    Player_SensorFloor              // d0 dist, d1 resolved angle
        tst.w   d0
        bpl     .no_land                        // must be embedded to land
        // eligibility: dist ≥ −(y_vel>>8) − 8 — embed tolerance scales
        // with fall speed; prevents snagging walls as floors (spec §6)
        move.w  y_vel(a0), d2
        lsr.w   #8, d2
        addq.w  #8, d2
        neg.w   d2
        cmp.w   d2, d0
        blt     .no_land                        // too deep — keep falling
        move.b  d1, d3                          // floor angle for the bands
        jbsr    Air_TouchFloor
        // band select on d3 (classic mask tests):
        //   steep ±$20-$3F: (d3+$20)&$40 ≠ 0
        //   mid   ±$10-$1F: (d3+$10)&$20 ≠ 0
        //   flat  ±$00-$0F: neither
        move.b  d3, d0
        addi.b  #$20, d0
        andi.b  #$40, d0
        bne     .steep
        move.b  d3, d0
        addi.b  #$10, d0
        andi.b  #$20, d0
        bne     .mid
        // flat: full conversion to the ground axis
        move.w  x_vel(a0), PlayerV.ground_speed(a0)
        clr.w   y_vel(a0)
        jbra    .grounded
.mid:
        // halve the fall speed, convert by angle sign. x_vel and the
        // halved y_vel are left as-is — the next ground frame's
        // projection overwrites both from gsp (classic)
        asr.w   y_vel(a0)
        jbsr    Air_GspFromYvel
        jbra    .grounded
.steep:
        clr.w   x_vel(a0)
        // landing-conversion fall cap $FC0 — part of the classic steep
        // conversion, NOT the removed airborne up-cap (that one is the
        // FEEL DEVIATION note in PState_AirShared)
        cmpi.w  #$FC0, y_vel(a0)
        ble     .steep_capped
        move.w  #$FC0, y_vel(a0)
.steep_capped:
        jbsr    Air_GspFromYvel
.grounded:
        jbsr    Air_LandState                   // GROUND (curled states
                                                // uncurl in its enter hook)
                                                // or straight to ROLL on a
                                                // down-held landing — no
                                                // uncurl flicker
        jbra    Player_SetState
.no_land:
        rts
}

// -----------------------------------------------
// Air_FloorLandFlat — horizontal-class floor landing: gsp = x_vel
// regardless of slope (classic Sonic_HitFloor, s2.asm:37641-37654);
// requires falling (y_vel ≥ 0) and an embedded floor hit
// In:  a0 = player SST
// Out: none (transitions to PSTATE_GROUND on landing)
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
proc Air_FloorLandFlat (a0: *Sst) clobbers(d0-d7/a1-a2) {
        tst.w   y_vel(a0)
        bmi     .no_land                        // rising — can't land
        jbsr    Player_SensorFloor
        tst.w   d0
        bpl     .no_land
        jbsr    Air_TouchFloor
        move.w  x_vel(a0), PlayerV.ground_speed(a0)
        clr.w   y_vel(a0)
        jbsr    Air_LandState                   // shared GROUND-vs-ROLL pick
        jbra    Player_SetState
.no_land:
        rts
}

// -----------------------------------------------
// Air_TouchFloor — snap onto the floor surface + landing housekeeping
// In:  a0 = player SST, d0.w = floor dist (< 0), d1.b = resolved angle
// Out: none
// Clobbers: d0, d2
// -----------------------------------------------
proc Air_TouchFloor (a0: *Sst) clobbers(d0/d2) {
        // quadrant invariant (no runtime branch needed): the air body
        // forces Player_Quadrant = 0 before its sensor block (air
        // sensors never rotate), so the helper's quadrant dispatch is
        // always the +Y snap here — classic landings snap on Y
        jbsr    Player_SnapToSurface
        move.b  d1, angle(a0)
        bclr    #ST_PUSHING, status(a0)
        rts
}

// -----------------------------------------------
// Air_GspFromYvel — gsp = ±y_vel by the surface angle's sign bit
// (classic shared landing/reattach rule, s2.asm:37608-37612). Direction
// check under our angle convention (positive angle = surface descending
// rightward): falling (+y_vel) onto steep +$30 → gsp = +y_vel =
// rightward = downhill; onto −$30 (bit7 set) → gsp = −y_vel = leftward
// = downhill. Rising (−y_vel) into ceiling slope $40 → gsp = y_vel
// (negative), projection sin($40)·gsp re-yields the upward motion.
// In:  a0 = player SST, d3.b = surface angle
// Out: none
// Clobbers: d0
// -----------------------------------------------
proc Air_GspFromYvel (a0: *Sst) clobbers(d0) {
        move.w  y_vel(a0), d0
        tst.b   d3
        bpl     .store
        neg.w   d0
.store:
        move.w  d0, PlayerV.ground_speed(a0)
        rts
}

// -----------------------------------------------
// Air_LandState — pick the landing state (the ONE decision for both
// landing helpers): down held + L/R clear + |gsp| ≥ PHYS_ROLL_START_MIN
// → PSTATE_ROLL, else PSTATE_GROUND. Same gate as the grounded roll
// start (research §5 preconditions), applied to the post-conversion gsp
// — so a curled landing stays curled (RollEnter's EnsureBall is a no-op)
// and an uncurled AIR landing curls; the carried-Task-6 uncurl-flicker
// class is gone.
// In:  a0 = player SST (_pl_gsp already converted by the caller)
// Out: d0.w = PSTATE_ROLL / PSTATE_GROUND (feed to Player_SetState)
// Clobbers: d1
// -----------------------------------------------
proc Air_LandState (a0: *Sst) clobbers(d1) out(d0) {
        moveq   #PSTATE_GROUND, d0
        move.b  Ctrl_1_Held, d1
        btst    #1, d1                          // DOWN
        beq     .done
        andi.b  #BUTTON_LEFT|BUTTON_RIGHT, d1
        bne     .done                           // sideways intent vetoes
        move.w  PlayerV.ground_speed(a0), d1
        bpl     .abs
        neg.w   d1
.abs:
        cmpi.w  #PHYS_ROLL_START_MIN, d1
        blt     .done
        moveq   #PSTATE_ROLL, d0
.done:
        rts
}

// -----------------------------------------------
// Air_WallProbeRight / Air_WallProbeLeft — post-move airborne push-out
// at (x ± PUSH_RADIUS, y). On a hit (dist < 0): snap |dist| back out of
// the wall and kill x_vel (classic: every airborne class zeroes x_vel
// on a wall hit, regardless of motion direction)
// In:  a0 = player SST
// Out: d4.w = 0 no hit / −1 hit (the horizontal classes use it to
//      engage the wall-run gsp)
// Clobbers: d0-d6, a1
// -----------------------------------------------
proc Air_WallProbeRight (a0: *Sst) clobbers(d0-d6/a1) {
        move.w  x_pos(a0), d0
        addi.w  #PUSH_RADIUS, d0
        move.w  y_pos(a0), d1
        moveq   #1, d4                          // probe rightward
        jbsr    Player_SensorWallAt
        tst.w   d0
        bpl     .no_hit
        dist_to_fix(d0)
        add.l   d0, x_pos(a0)                   // dist < 0 → pushes left
        clr.w   x_vel(a0)
        moveq   #-1, d4
        rts
.no_hit:
        moveq   #0, d4
        rts
}

proc Air_WallProbeLeft (a0: *Sst) clobbers(d0-d6/a1) {
        move.w  x_pos(a0), d0
        subi.w  #PUSH_RADIUS, d0
        move.w  y_pos(a0), d1
        moveq   #-1, d4                         // probe leftward
        jbsr    Player_SensorWallAt
        tst.w   d0
        bpl     .no_hit
        dist_to_fix(d0)                         // (along −X)
        sub.l   d0, x_pos(a0)                   // dist < 0 → pushes right
        clr.w   x_vel(a0)
        moveq   #-1, d4
        rts
.no_hit:
        moveq   #0, d4
        rts
}

// -----------------------------------------------
// Air_CeilingBump — horizontal-class ceiling check: snap out + kill
// upward velocity. No reattach outside the mostly-up class (classic)
// In:  a0 = player SST
// Out: none
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
proc Air_CeilingBump (a0: *Sst) clobbers(d0-d7/a1-a2) {
        jbsr    Player_SensorCeiling
        tst.w   d0
        bpl     .clear
        dist_to_fix(d0)
        sub.l   d0, y_pos(a0)                   // embedded → snap DOWN
        tst.w   y_vel(a0)
        bpl     .clear
        clr.w   y_vel(a0)
.clear:
        rts
}
