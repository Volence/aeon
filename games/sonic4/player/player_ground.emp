// Player grounded states — PState_Ground (slope factor, quadrant-rotated
// floor adherence, S3K slip), PState_Roll (rolling physics; shares the
// cap/projection/probe via Ground_Move_Cap and the movement tail via
// Ground_PostMove), + Player_Jump. PState_Spindash lives in player_spindash.emp
// (shared ability). Player_Jump lives in this file because it is
// invoked only from grounded states (its tail jumps into the air body in
// player_air.emp — the press-frame movement fix). Reached only through the
// Player_States offset table in player_common.asm; shares its overlay
// equates, macros, and the (a4) physics-table convention.
//
// Placed in the object code bank by the sigil registry/map, right after
// player_common. Gate SIGIL_EMP_PLAYER_GROUND — pure code.
module games.sonic4.player_ground in player_ground

use engine.objects.sst.{Sst}
use engine.types.{Angle}
use engine.coords.{abs_w}
use engine.constants.{PHYS_SLOPE_WALK, PHYS_SLOPE_ROLL_DOWN, PHYS_SLOPE_ROLL_UP, PHYS_SLOPE_STAND_MIN,
        PHYS_ROLL_START_MIN, PHYS_JUMP_HEADROOM, PHYS_GSP_CAP, PHYS_ROLL_DECEL, PHYS_UNROLL_MAX, PHYS_KEEP_ROLL_MIN,
        PHYS_SLIP_SPEED, PHYS_SLIP_ANGLE, PHYS_FALL_ANGLE, PHYS_SLIP_NUDGE, PHYS_MOVE_LOCK_TIME,
        PUSH_RADIUS, BUTTON_LEFT, BUTTON_RIGHT,
        BUTTON_DOWN_BIT, BUTTON_LEFT_BIT, BUTTON_RIGHT_BIT, ST_XFLIP, ST_ON_OBJECT, ST_PUSHING}
use games.sonic4.player_common.{PlayerV, mask_opposing_lr, curl_head_rise, curl_shift_px}
use games.sonic4.ram.{PlayerBlock}

// Player_SensorFloor/Ceiling/WallDir resolve module-to-module to player_sensors.emp
// (bare link) — the P4 close retired their extern-proc boundary decls (kill row 80).

// Game-config constants — sole authority is games.sonic4.constants.
use games.sonic4.constants.{
    PSTATE_ROLL, PSTATE_SPINDASH, PSTATE_AIR, PSTATE_JUMP, PSTATE_ROLLJUMP, PSTATE_AIRBALL
}

// Sound ids — sole authority is games.sonic4.sound_ids.
use games.sonic4.sound_ids.{SFXID_ROLL, SFXID_JUMP, SFXID_SPINDASH}

// PHYS_* / radii / CURL / PUSH / BUTTON_LEFT/RIGHT / ST_* are consumed from
// engine.constants via `use engine.constants.{...}` above. The shift-form
// assumption ensures below stay (they guard THIS file's asr-shift slope math).

// player-block field offsets (a4-relative; the PlayerBlock displacements).
// a4 holds the CALLING SLOT's block, so these reach that slot's state and no
// other — the quadrant and jump buffer are per-slot working state, not globals.
// File-local; a divergent offset shows up as a mismatched instruction byte in the
// region gate (player_common.asm's mirror equates + their drift guards are gone).
const PBLK_ACCEL      = 0
const PBLK_DECEL      = 2
const PBLK_FRICTION   = 4
const PBLK_TOP_SPEED  = 6
const PBLK_JUMP_FORCE = 10
const PBLK_QUADRANT   = 16
const PBLK_JUMPBUF    = 17

// Bound to the type that OWNS the layout. These file-local displacements used to
// carry no guard at all: the header justified it as "a divergent offset shows up as a
// mismatched instruction byte in the region gate", which only catches a change to an
// already-pinned build, never a newly-introduced wrong value — and it contradicted the
// rule player_common.emp and dust_spindash.emp both state, that both sides `ensure`
// against config/ram.emp. 16 of the 21 PBLK_* consts across 8 files were unguarded.
// PlayerBlock's own doc says declaring it a TYPE is what makes the layout invariants
// structural rather than merely checked; these restore the "checked" half at least.
ensure(PBLK_ACCEL == offsetof(PlayerBlock, accel),
       "PBLK_ACCEL diverged from PlayerBlock.accel (games/sonic4/config/ram.emp)")
ensure(PBLK_DECEL == offsetof(PlayerBlock, decel),
       "PBLK_DECEL diverged from PlayerBlock.decel (games/sonic4/config/ram.emp)")
ensure(PBLK_FRICTION == offsetof(PlayerBlock, friction),
       "PBLK_FRICTION diverged from PlayerBlock.friction (games/sonic4/config/ram.emp)")
ensure(PBLK_TOP_SPEED == offsetof(PlayerBlock, top_speed),
       "PBLK_TOP_SPEED diverged from PlayerBlock.top_speed (games/sonic4/config/ram.emp)")
ensure(PBLK_JUMP_FORCE == offsetof(PlayerBlock, jump_force),
       "PBLK_JUMP_FORCE diverged from PlayerBlock.jump_force (games/sonic4/config/ram.emp)")
ensure(PBLK_QUADRANT == offsetof(PlayerBlock, quadrant),
       "PBLK_QUADRANT diverged from PlayerBlock.quadrant (games/sonic4/config/ram.emp)")
ensure(PBLK_JUMPBUF == offsetof(PlayerBlock, jump_buffer),
       "PBLK_JUMPBUF diverged from PlayerBlock.jump_buffer (games/sonic4/config/ram.emp)")


// Shift-form assumptions on the slope-factor constants (the slope math uses
// asr shifts, not muls — see PState_Ground/.slope and PState_Roll/.slope).
ensure(PHYS_SLOPE_WALK == $20, "slope-factor shift form (sin asr 3) assumes PHYS_SLOPE_WALK = $20")
ensure(PHYS_SLOPE_ROLL_DOWN == $50, "roll slope-factor shift form (5·sin asr 4) assumes PHYS_SLOPE_ROLL_DOWN = $50")
ensure(PHYS_SLOPE_ROLL_UP == $14, "roll uphill factor (downhill asr 2) assumes PHYS_SLOPE_ROLL_UP = $14")

// =====================================================================
// SLOPE STANDSTILL MIRROR-SYMMETRY GATE — owner ruling 2026-08-27
// ("mirrored slopes must behave the same"). Zero ROM bytes, build-fatal.
//
// WHAT IT PROVES. PState_Ground's standing gate decides "does a player at
// rest on a surface of angle A start sliding?" from the MAGNITUDE of the
// walking slope factor. Mirroring a slope left-to-right negates the angle,
// so a symmetric engine must return the SAME decision for A and (−A)&$FF.
// The walk below covers all 256 angles and fails naming the first angle
// whose mirror disagrees. Every input is re-derived here — the table bytes,
// PHYS_SLOPE_STAND_MIN, and the block's own two skips — so a change to any
// of them is caught rather than a copied number going stale.
//
// WHAT IT DOES NOT PROVE, and where the other half lives. Comptime cannot
// read the instructions it guards, so this cannot by itself catch someone
// reverting the abs/shift ORDER in the code below. That half is
// `tools/test_slope_symmetry.py`, which reads this file's instruction text
// and re-derives the same predicate independently. Neither gate is a
// superset of the other; both run build-fatally (`pytest tools` in build.sh).
//
// SLOPE_ASYM_S3K IS THE DIVERGENCE RECEIPT. The same walk under S3K's own
// |sin asr 3| magnitude must still FIND an asymmetry. If that ever stops
// being true, the divergence has become moot and the code should return to
// the reference form rather than carry an unexplained departure.
//
// THE CEILING BAND IS CLOSED — THE SECOND DIVERGENCE, owner ruling d-34
// 2026-08-30 ("d-34 I think we fix"). S3K's band test is `addi.b #$60 /
// cmpi.b #$C0 / bhs`, which skips the HALF-OPEN interval [$60,$A0). The
// mirror of a half-open interval is the other half-open interval ($60,$A0],
// so its two endpoints $60 and $A0 (135° and 225° — past-vertical
// overhangs) landed on opposite sides of the skip from their mirrors. Our
// compare is `cmpi.b #$C1`: the skip is the CLOSED interval [$61,$9F],
// which is its own mirror ($61 <-> $9F), and $60/$A0 both now receive the
// slope factor, like each other. One immediate byte, zero length change.
// The band is pinned SYMMETRIC below: SLOPE_BAND_EDGE_N counts the angles
// the modelled skip treats differently from their mirrors and must be 0 —
// derived from SLOPE_REACHES_GATE, never a written pair. Proven red-first
// both ways on 2026-08-30 (the old `== 2` pin against the closed model;
// the pytest's endpoint pin against the real `cmpi.b`). The same skip is
// spelt again in PState_Roll (rolling slope factor); the comptime model
// cannot see either literal (see SLOPE_REACHES_GATE), so
// tools/test_slope_symmetry.py parses BOTH blocks and pins them equal.
//
// ONE AUTHENTIC S3K ASYMMETRY IS OUT OF SCOPE AND PINNED BY COUNT rather
// than fixed. The ruling was about the ROUNDING artifact; this is not it,
// and it cannot flip a standstill decision on its own:
//
//   * THE SHIPPED SINE TABLE IS NOT EXACTLY ANTISYMMETRIC. Four rows have
//     |sin| = 115 in the first half and 117 at the mirror index. This is
//     authentic: engine/data/sine.bin is byte-identical to skdisasm's
//     Levels/Misc/sine.bin (verified 2026-08-27), and GetSineCosine serves
//     every projection in the engine, so re-deriving it is far out of
//     scope. All four land on the same side of PHYS_SLOPE_STAND_MIN
//     ($73/$75 both >= $D), so the decision walk stays clean — but the
//     count is pinned (SLOPE_TABLE_ASYM_N) so a re-derived table that
//     moved one across the threshold shows up as a changed count as well
//     as a red walk.
// =====================================================================
const _sine_bin = embed("engine/data/sine.bin")
ensure(_sine_bin.len == $280,
       "slope symmetry gate: sine.bin is {_sine_bin.len} bytes, not $280 — engine/system/math.emp's Sine_Table shape moved")

// sin(a)·$100 as a signed big-endian word, straight out of the blob
// GetSineCosine indexes.
comptime fn SLOPE_SIN(tbl: array, a: int) -> int {
    let raw = (tbl[a * 2] & $FF) * 256 + (tbl[a * 2 + 1] & $FF)
    if raw >= $8000 { return raw - $10000 }
    return raw
}

// How many table rows fail sin(−a) == −sin(a). Counted, not asserted away:
// see the header's second bullet.
comptime fn SLOPE_TABLE_ASYM_COUNT(tbl: array) -> int {
    comptime var n = 0
    for a in 0..256 {
        if SLOPE_SIN(tbl, a) != 0 - SLOPE_SIN(tbl, (256 - a) & $FF) { n = n + 1 }
    }
    return n
}

// Does the walking slope block below even reach its standing gate at this
// angle? Its two skips, in its own order: the flat fast path, then the
// ceiling band.
//
// THE BAND BOUNDS ARE SPELT AS LITERALS HERE and there is no constant to pin
// them against — the block spells them inline in its own `addi.b`/`cmpi.b`,
// so a comptime pin has nothing to compare to (EMP_PITFALLS §2's rule leads
// to the same place). That means moving the band in the code would leave this
// fn behind, silently. `tools/test_slope_symmetry.py` closes exactly that
// hole: it PARSES the two operands out of the block and re-derives from them.
// Proven red against a one-nibble widening of the real `cmpi.b` (2026-08-27)
// and again against d-34's `#$C0` -> `#$C1` narrowing (2026-08-30), which
// this fn — as predicted — did NOT see until its own literal was moved.
comptime fn SLOPE_REACHES_GATE(a: int) -> int {
    if a == 0 { return 0 }                          // `beq .no_slope`
    if ((a + $60) & $FF) >= $C1 { return 0 }        // ceiling band $61-$9F (closed; d-34)
    return 1
}

// An angle the ceiling-band skip treats differently from its mirror. Since
// d-34 closed the band there must be NONE; counted rather than assumed, and
// DERIVED from SLOPE_REACHES_GATE, never a written-down pair, so reshaping
// the modelled band moves this with it.
comptime fn SLOPE_IS_BAND_EDGE(a: int) -> int {
    if SLOPE_REACHES_GATE(a) != SLOPE_REACHES_GATE((256 - a) & $FF) { return 1 }
    return 0
}

comptime fn SLOPE_BAND_EDGE_COUNT() -> int {
    comptime var n = 0
    for a in 0..256 {
        if SLOPE_IS_BAND_EDGE(a) == 1 { n = n + 1 }
    }
    return n
}

// The SHIPPED gate magnitude: (|sin|)>>3 — abs before the shift.
comptime fn SLOPE_MAG_SHIPPED(tbl: array, a: int) -> int {
    let s = SLOPE_SIN(tbl, a)
    if s < 0 { return (0 - s) >> 3 }
    return s >> 3
}

// S3K's gate magnitude: |sin asr 3| — shift before the abs. `asr` floors
// toward −∞, so for a negative sine the magnitude is ceil(|s|/8), which is
// (|s| + 7) >> 3. Derived from the rounding rule, not fitted to a case.
comptime fn SLOPE_MAG_S3K(tbl: array, a: int) -> int {
    let s = SLOPE_SIN(tbl, a)
    if s < 0 { return ((0 - s) + 7) >> 3 }
    return s >> 3
}

// 1 = a player standing on this angle starts sliding, 0 = holds still.
// `s3k` selects which magnitude rule to ask under.
comptime fn SLOPE_SLIDES(tbl: array, a: int, min: int, s3k: int) -> int {
    if SLOPE_REACHES_GATE(a) == 0 { return 0 }
    if s3k == 1 {
        if SLOPE_MAG_S3K(tbl, a) >= min { return 1 }
        return 0
    }
    if SLOPE_MAG_SHIPPED(tbl, a) >= min { return 1 }
    return 0
}

// First angle whose standstill decision disagrees with its mirror's, or -1
// when the whole circle agrees. All 256 angles, nothing excluded: the band
// endpoints used to be skipped here while the band was half-open (d-34).
comptime fn SLOPE_FIRST_ASYM(tbl: array, min: int, s3k: int) -> int {
    for a in 0..256 {
        if SLOPE_SLIDES(tbl, a, min, s3k) != SLOPE_SLIDES(tbl, (256 - a) & $FF, min, s3k) { return a }
    }
    return -1
}

const SLOPE_TABLE_ASYM_N = SLOPE_TABLE_ASYM_COUNT(_sine_bin)
const SLOPE_BAND_EDGE_N  = SLOPE_BAND_EDGE_COUNT()
const SLOPE_ASYM_SHIPPED = SLOPE_FIRST_ASYM(_sine_bin, PHYS_SLOPE_STAND_MIN, 0)
const SLOPE_ASYM_S3K     = SLOPE_FIRST_ASYM(_sine_bin, PHYS_SLOPE_STAND_MIN, 1)

ensure(SLOPE_BAND_EDGE_N == 0,
       "slope symmetry gate: the ceiling-band skip treats {SLOPE_BAND_EDGE_N} angles differently from their mirrors. The owner ruled the band symmetric (d-34, 2026-08-30) and it is closed to [$61,$9F] by `cmpi.b #$C1`; SLOPE_REACHES_GATE's modelled band has been reshaped into something that is not its own mirror — re-read the header before excluding anything from the walk")
ensure(SLOPE_TABLE_ASYM_N == 4,
       "slope symmetry gate: engine/data/sine.bin now has {SLOPE_TABLE_ASYM_N} rows where sin(-a) != -sin(a), not the 4 S3K ships. The table was re-derived or replaced — re-verify it against skdisasm's Levels/Misc/sine.bin and re-check that no row crossed PHYS_SLOPE_STAND_MIN")
ensure(SLOPE_ASYM_SHIPPED == -1,
       "slope symmetry gate: a player standing on angle {SLOPE_ASYM_SHIPPED} behaves differently from one on its mirror — magnitudes {SLOPE_MAG_SHIPPED(_sine_bin, SLOPE_ASYM_SHIPPED)} vs {SLOPE_MAG_SHIPPED(_sine_bin, (256 - SLOPE_ASYM_SHIPPED) & $FF)} against PHYS_SLOPE_STAND_MIN. The owner ruled mirrored slopes behave alike (2026-08-27); something moved the table, the threshold, or the ceiling band")
ensure(SLOPE_ASYM_S3K != -1,
       "slope symmetry gate: S3K's own |sin asr 3| magnitude is now symmetric too, so PState_Ground's abs-before-shift is an S3K DIVERGENCE THAT BUYS NOTHING. Drop it, restore the reference form, and retire the register entry in docs/ENGINE_ARCHITECTURE.md")

// -----------------------------------------------
// PState_Ground — standing/running. Classic frame order (research
// physics-classics §1): spindash check → jump check → slope factor →
// input/projection/wall probe (Ground_Move) → roll start check →
// integrate → floor pair snap → slip check (fall-through into
// Player_SlopeRepel).
// In:  a0 = player SST, a4 = the slot's player block
// Out: none (may transition to PSTATE_AIR/ROLL/SPINDASH or jump)
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
pub proc PState_Ground (a0: *Sst) clobbers(d0-d7/a1-a2) falls_into Ground_PostMove {
        // --- spindash trigger (classic order: FIRST — a down+jump press
        // while near-stationary charges instead of jumping). S2's gate is
        // "ducking" (down held at ~rest); we have no duck state, so the
        // gate is down held + |gsp| < PHYS_ROLL_START_MIN — the same
        // threshold that separates duck from roll in S3K. At rolling
        // speed the press falls through to the jump check instead. ---
        // NOTE: deliberately not move_lock-gated — the trigger needs a
        // down-hold + jump press; the lock freezes directional response,
        // not this (review S4, self-resolving).
        btst    #BUTTON_DOWN_BIT, Ctrl_1_Held
        beq     .no_spindash
        tst.b   PBLK_JUMPBUF(a4)
        beq     .no_spindash
        move.w  PlayerV.ground_speed(a0), d0
        abs_w(d0)
        cmpi.w  #PHYS_ROLL_START_MIN, d0
        bge     .no_spindash
        clr.b   PBLK_JUMPBUF(a4)               // consume — this press is rev 0
        if SOUND_DRIVER_ENABLED == 1 {
                // The initiating press IS a rev (rev 0) and must play the rev SFX — classic
                // spindash makes the sound on the FIRST press. Since we consumed the jump
                // buffer above, PState_Spindash's .rev sees it empty and won't fire for this
                // press, so play it here. (Subsequent taps fire .rev in player_spindash.asm.)
                // Sound_PlaySFX preserves a0/a4; only d0 is clobbered (reloaded below).
                move.b  #SFXID_SPINDASH, d0 as SfxId
                jbsr    Sound_PlaySFX
        }
        moveq   #PSTATE_SPINDASH, d0
        jbsr    Player_SetState                 // hook curls + zeroes motion/charge
        jbra    PState_Spindash                 // run the charge frame now —
                                                // the floor pair keeps running
                                                // (player_spindash). Subsequent rev SFX per-tap in player_spindash.emp
.no_spindash:
        // --- jump check (classic order: after spindash, before slope/
        // input). the jump buffer covers fresh press AND buffered —
        // latched on the press edge in Player_Main; consumed only on a
        // successful launch, so a headroom rejection leaves it live and
        // the classic retry happens next frame while the buffer lasts ---
        tst.b   PBLK_JUMPBUF(a4)
        beq     .no_jump
        jbsr    Player_SensorCeiling            // headroom: d0 = clearance
                                                // (≥16 sentinel = open sky)
        cmpi.w  #PHYS_JUMP_HEADROOM, d0
        bge     Player_Jump                     // classic CalcRoomOverHead
                                                // ≥6px rule; does not return
.no_jump:
        // --- slope factor on gsp — BEFORE input, with LAST frame's angle
        // (classic Sonic_SlopeResist, research physics-classics §2).
        // Applied on floor and both wall quadrants; skipped in the
        // ceiling band: apply only when (angle+$60)&$FF < $C1 unsigned
        // (band $61-$9F skips — CLOSED and its own mirror. S3K's `#$C0`
        // skipped the half-open [$60,$A0) and broke the mirror at $60/$A0;
        // owner ruling d-34 2026-08-30, see the gate header at file top).
        // Ground_Move's ±PHYS_GSP_CAP runs after
        // this AND after input, so the cap bounds the post-slope sum.
        // (ROLL applies its own $50/$14 asymmetric factor — PState_Roll.) ---
        move.b  angle(a0), d0 as Angle          // GetSineCosine takes d0: Angle
        beq     .no_slope                       // flat: factor 0 (fast path)
        move.b  d0, d1
        addi.b  #$60, d1
        cmpi.b  #$C1, d1                        // S3K: #$C0 (d-34)
        bhs     .no_slope                       // ceiling band $61-$9F
        jbsr    GetSineCosine                   // d0.w = sin(angle)·$100
        tst.w   PlayerV.ground_speed(a0)
        bne     .slope_factor
        // S3K standing gate: from rest, only slopes steep enough to beat
        // the minimum start a slide (magnitude ≥ $D ≈ asin(13/32) ≈ 24°);
        // shallower slopes hold the player still — no micro-creep.
        //
        // DELIBERATE S3K DIVERGENCE — owner ruling 2026-08-27 ("mirrored
        // slopes must behave the same"); registered in ENGINE_ARCHITECTURE
        // §"Deliberate departures from S3K feel". The gate magnitude here is
        // (|sin|)>>3, NOT S3K's |sin asr 3|. `asr` floors toward −∞, so for a
        // negative sine it returns one MORE magnitude than its mirror: at
        // angle $EF sin = −103 → asr 3 = −13 (gate passes, the player creeps)
        // while its mirror $11 has sin = +103 → asr 3 = +12 (gate fails, the
        // player holds) — the same slope, opposite orientations, different
        // behaviour. Same story for $F0/$10 (sin ∓97). Taking the magnitude
        // BEFORE the shift makes the pair agree, and both hold.
        //
        // It moves EXACTLY those two reachable angles. Two more table rows
        // round the same way ($90/$91) but the ceiling-band skip above
        // already discards them AND their mirrors ($70/$6F), so they were
        // never asymmetric in this code. Every other angle is bit-identical,
        // and the APPLIED factor below is still S3K's signed `sin asr 3` —
        // only the standstill decision moves, never the value.
        // Pinned by the comptime symmetry gate at the top of this file.
        move.w  d0, d1
        abs_w(d1)                               // magnitude FIRST...
        asr.w   #3, d1                          // ...THEN the shift
        cmpi.w  #PHYS_SLOPE_STAND_MIN, d1
        blt     .no_slope
.slope_factor:
        asr.w   #3, d0                          // factor = ($20·sin)>>8 ≡
                                                // sin asr 3 — exact, no muls
                                                // (PHYS_SLOPE_WALK = 2^5,
                                                // asserted at file top)
        add.w   d0, PlayerV.ground_speed(a0)
.no_slope:
        jbsr    Ground_Move
        // --- roll start (the classic Sonic_Roll slot: after Move, before
        // integration — this frame already moved with standing semantics,
        // exactly like the classics): down held, L/R NOT held (raw bits —
        // any sideways intent vetoes the curl), |gsp| ≥ $100 (S3K
        // threshold). Forced rolls (S-tunnel objects) are a future object
        // contract: they bypass this gate and use PHYS_ROLL_FORCE_MIN
        // ($200) when curling at rest — see PState_Roll's keep-roll note.
        move.b  Ctrl_1_Held, d0
        btst    #BUTTON_DOWN_BIT, d0
        beq     Ground_PostMove
        andi.b  #BUTTON_LEFT|BUTTON_RIGHT, d0
        bne     Ground_PostMove
        move.w  PlayerV.ground_speed(a0), d0
        abs_w(d0)
        cmpi.w  #PHYS_ROLL_START_MIN, d0
        blt     Ground_PostMove
        moveq   #PSTATE_ROLL, d0
        jbsr    Player_SetState                 // hook curls (+5px y-shift)
        if SOUND_DRIVER_ENABLED == 1 {
                moveq   #SFXID_ROLL, d0 as SfxId
                jbsr    Sound_PlaySFX
        }
        // fall through — the frame completes below as a roll
}

// -----------------------------------------------
// Ground_PostMove — shared grounded movement tail: integrate → floor
// pair snap → slip check (falls through into Player_SlopeRepel).
// Entered by falling through from PState_Ground and by PState_Roll's
// tail branch (and via it the unroll/keep-rolling paths). NOT a
// subroutine — control returns to Player_Main's dispatch.
// In:  a0 = player SST (x_vel/y_vel projected by Ground_Move)
// Out: none (may transition to PSTATE_AIR/AIRBALL via Ground_DetachState)
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
proc Ground_PostMove (a0: *Sst) clobbers(d0-d7/a1-a2) falls_into Player_SlopeRepel {
        jbsr    ObjectMove

        // --- on-object: the player is grounded on a solid object (set by
        // LAST tick's TouchResponse, still live this frame — Player_Main
        // clears it AFTER dispatch). The object holds our Y/position, so
        // skip BOTH the terrain floor pair AND SlopeRepel: a floor pair
        // here finds no terrain under us and detaches to AIR (the bug).
        // Force angle 0 (flat object top) and return to the dispatch — the
        // same exit point SlopeRepel's rts reaches. GROUND and ROLL share
        // this tail; ROLL's unroll check runs in PState_Roll BEFORE here,
        // so rolling-to-stop on the object still uncurls. ---
        btst    #ST_ON_OBJECT, status(a0)
        beq     .terrain
        clr.b   angle(a0)
        // G10: Player_SlopeRepel (the normal lock decrementer) is bypassed on
        // this exit — without a tick here, a slip-locked player landing on a
        // solid object keeps frozen input forever (only jump escapes).
        // Grounded-frame tick ONLY — airborne must stay frozen (do not hoist
        // to Player_Main). Memory-direct form on purpose: the register form
        // trips a sigil relaxation oscillation at this section boundary (G10).
        tst.w   PlayerV.move_lock(a0)
        beq     .lock_done
        subq.w  #1, PlayerV.move_lock(a0)
.lock_done:
        rts
.terrain:

        // --- floor pair: quadrant-rotated probe, snap along the probe
        // axis, angle update, ledge detach. Angle continuity: the pair
        // wrapper already substitutes the quadrant cardinal on the odd
        // flag OR |Δangle| ≥ $20 — that IS the "reject angle jumps > $20
        // between frames" loop fall-through guard; nothing more needed
        // at this site. ---
        jbsr    Player_SensorFloor              // d0 dist, d1 resolved angle
        // adaptive snap-down window: min(|speed along probe axis|>>8 + 4,
        // 14) — S2+ rule (research feel-modern §2): Y-probe modes
        // (quadrant 0/2) use x_vel, X-probe wall modes (1/3) use y_vel
        move.w  x_vel(a0), d2
        btst    #0, PBLK_QUADRANT(a4)          // sets Z only — N at
        beq     .axis_sel                       // .axis_sel is still the
        move.w  y_vel(a0), d2                   // loaded value's sign on
.axis_sel:                                      // both paths
        abs_w(d2)
        lsr.w   #8, d2
        addq.w  #4, d2
        cmpi.w  #14, d2
        bls     .window_ok
        moveq   #14, d2
.window_ok:
        cmpi.w  #-14, d0
        blt     .no_snap                        // embedded past the fixed
                                                // snap-up — classic ignores
        tst.b   PlayerV.stick_convex(a0)
        bne     .snap                           // full adherence: snap-down
                                                // window bypassed (research
                                                // physics-classics §7)
        cmp.w   d2, d0
        ble     .snap
        // surface beyond snap reach — covers both-sensors-nothing (≥16
        // sentinel) and a ledge run-off. Velocities kept — gravity takes
        // over next frame. Roll-aware: a roll-off stays curled (AIRBALL),
        // spec §3.3 / verification matrix item 7
        jbra    Ground_DetachState              // does not return
.snap:
        jbsr    Player_SnapToSurface            // probe-axis snap per
                                                // quadrant (helper mirrors
                                                // the sensor case table;
                                                // clobbers d0/d2 — d1 angle
                                                // survives)
        move.b  d1, angle(a0)
.no_snap:
        // fall through — classic order step 9. SEAM GUARD: this
        // fall-through is shared by GROUND and ROLL (both reach it via
        // Ground_PostMove — roll uses the same slip rules, classic).
        // Player_SlopeRepel must stay IMMEDIATELY below, and nothing
        // state-specific may be inserted here. SPINDASH deliberately
        // never reaches this seam (its floor maintenance lives in
        // PState_Spindash — the classics skip SlopeRepel while charging).
}

// -----------------------------------------------
// Player_SlopeRepel — S3K slip/detach (research physics-classics §7
// "S3K slip rework", feel-modern §1 Slopes). Runs ONLY via the grounded
// fall-through above. move_lock semantics: the lock ticks down HERE (and on
// Ground_PostMove's on-object exit, which bypasses this proc — G10) —
// grounded frames only, frozen while airborne; while nonzero the slip
// check is skipped entirely this frame (Ground_Move separately skips
// INPUT — friction and slope factor still run).
//   band:   slip when angle is ≥ $18 from flat either way —
//           (angle+$18)&$FF ≥ $30 — AND |gsp| < $280
//   slip:   gsp ±= $80 shoved downhill, move_lock = 30 (gsp NOT zeroed)
//   detach: additionally when (angle+$30)&$FF ≥ $60 (≈ |angle| ≥ $30)
//           → Ground_DetachState (AIR, or AIRBALL from a roll) with gsp
//           kept (S3K "slide, don't fall")
// In:  a0 = player SST
// Out: none (may transition to PSTATE_AIR/AIRBALL)
// Clobbers: d0-d1 (+ Player_SetState tail clobbers on detach)
// -----------------------------------------------
proc Player_SlopeRepel (a0: *Sst) clobbers(d0-d2/a1-a2) {
        move.w  PlayerV.move_lock(a0), d0
        beq     .lock_idle
        subq.w  #1, d0
        move.w  d0, PlayerV.move_lock(a0)
        rts
.lock_idle:
        tst.b   PlayerV.stick_convex(a0)
        bne     .done                           // loop adherence: no slip
        move.b  angle(a0), d0
        addi.b  #PHYS_SLIP_ANGLE, d0
        cmpi.b  #PHYS_SLIP_ANGLE*2, d0
        blo     .done                           // inside the flat band ±$17
        move.w  PlayerV.ground_speed(a0), d1
        abs_w(d1)
        cmpi.w  #PHYS_SLIP_SPEED, d1
        bge     .done                           // fast enough to hold on
        // downhill nudge: sign = sign of sin(angle). Under our convention
        // positive sin (angle bit 7 clear) = right-descending surface →
        // downhill is +gsp; bit 7 set mirrors. sin ≥ 0 exactly on 0-$80,
        // and the flat band already excluded |angle| < $18, so bit 7 is
        // a faithful sign proxy across the whole slip band
        move.w  #PHYS_SLIP_NUDGE, d1
        tst.b   angle(a0)
        bpl     .nudge
        neg.w   d1
.nudge:
        add.w   d1, PlayerV.ground_speed(a0)
        move.w  #PHYS_MOVE_LOCK_TIME, PlayerV.move_lock(a0)
        // moderate band ($18-$2F from flat) slides grounded; detach only
        // when steeper
        move.b  angle(a0), d0
        addi.b  #PHYS_FALL_ANGLE, d0
        cmpi.b  #PHYS_FALL_ANGLE*2, d0
        blo     .done
        jbra    Ground_DetachState              // roll-aware (gsp kept — S3K
                                                // "slide, don't fall")
.done:
        rts
}

// -----------------------------------------------
// Ground_DetachState — the ONE decision for leaving the ground without
// a jump (mirrors Air_LandState's one-decision pattern, from the other
// side of the seam): detaching from ROLL stays curled → PSTATE_AIRBALL
// (spec §3.3 state table — rolled off a ledge keeps ST_ROLLING and the
// ball box; the path swap reads ST_ROLLING for curled detection,
// and uncurling here would skip the clearance check — the wall-clip
// hazard class); detaching from GROUND → PSTATE_AIR. Keyed on
// _pl_state, the transition authority, rather than ST_ROLLING — same
// cost (one byte compare), and it names the exact state this seam can
// carry. SPINDASH never reaches either call site (its body skips
// Ground_PostMove/SlopeRepel entirely — see the seam guard above), so
// GROUND/ROLL is the complete case split. The AIRBALL enter hook
// (PHook_EnsureBall) is idempotent — curled→curled is a no-op.
// Called from: Ground_PostMove (run-off / both-sensors-nothing) and
// Player_SlopeRepel (steep-slope detach).
// In:  a0 = player SST (_pl_state = PSTATE_GROUND or PSTATE_ROLL)
// Out: DOES NOT return — tail-jumps Player_SetState with d0 = the
//      detach state; control returns to Player_Main's dispatch
// Clobbers: d0 (+ Player_SetState tail clobbers)
// -----------------------------------------------
proc Ground_DetachState (a0: *Sst) clobbers(d0-d2/a1-a2) {
        moveq   #PSTATE_AIR, d0
        cmpi.b  #PSTATE_ROLL, PlayerV.player_state(a0)
        bne     .set
        moveq   #PSTATE_AIRBALL, d0
.set:
        jbra    Player_SetState
}

// -----------------------------------------------
// PState_Roll — grounded, curled. Classic Obj01_MdRoll order (research
// physics-classics §1): jump check (→ ROLLJUMP via Player_Jump) → roll
// slope factor ($50 downhill / $14 uphill) → roll speed (friction
// always, $20 fixed brake, NO input accel) → unroll check → shared
// cap/projection/wall probe (Ground_Move_Cap) → shared movement tail
// (Ground_PostMove: integrate → floor pair → SlopeRepel fall-through —
// rolling slips and detaches by the same rules as walking).
// In:  a0 = player SST, a4 = the slot's player block
// Out: none (may transition to GROUND/ROLLJUMP/AIRBALL — a roll-off or
//      steep detach stays curled via Ground_DetachState)
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
pub proc PState_Roll (a0: *Sst) clobbers(d0-d7/a1-a2) {
        // --- jump check — same gate as PState_Ground. Player_Jump reads
        // _pl_state and launches into ROLLJUMP from here (air-control
        // lockout); ball radii are KEPT by the hooks — structural,
        // no size pop on a roll-jump ---
        tst.b   PBLK_JUMPBUF(a4)
        beq     .no_jump
        jbsr    Player_SensorCeiling            // d0 = headroom
        cmpi.w  #PHYS_JUMP_HEADROOM, d0
        bge     Player_Jump                     // does not return
.no_jump:
        // --- roll slope factor (classic Sonic_RollRepel): $50·sin>>8,
        // quartered to $14·sin>>8 when the factor's sign opposes gsp
        // (rolling uphill). NEVER gsp==0-gated (research §2) — gsp == 0
        // counts as positive, the exact classic sign test. Same ceiling-
        // band skip as walking — the CLOSED [$61,$9F] (d-34), pinned equal
        // to the walk block's by tools/test_slope_symmetry.py. Shift forms
        // (no muls): 5·sin asr 4 ≡
        // ($50·sin)>>8 exactly, one more asr 2 ≡ ($14·sin)>>8 exactly —
        // consecutive arithmetic shifts compose; constants asserted at
        // file top ---
        move.b  angle(a0), d0 as Angle          // GetSineCosine takes d0: Angle
        beq     .no_slope                       // flat: factor 0 (fast path)
        move.b  d0, d1
        addi.b  #$60, d1
        cmpi.b  #$C1, d1                        // S3K: #$C0 (d-34, roll)
        bhs     .no_slope                       // ceiling band $61-$9F
        jbsr    GetSineCosine                   // d0.w = sin(angle)·$100
        move.w  d0, d1
        asl.w   #2, d0
        add.w   d1, d0                          // 5·sin (≤ ±$500 — no overflow)
        asr.w   #4, d0                          // downhill factor ($50 form)
        tst.w   PlayerV.ground_speed(a0)
        bmi     .gsp_neg
        tst.w   d0
        bpl     .slope_apply
        jbra    .uphill
.gsp_neg:
        tst.w   d0
        bmi     .slope_apply
.uphill:
        asr.w   #2, d0                          // quartered ($14 form)
.slope_apply:
        add.w   d0, PlayerV.ground_speed(a0)
.no_slope:
        // --- roll speed: NO input accel ever. Opposing direction = $20
        // FIXED brake (PHYS_ROLL_DECEL — the classic uses the constant,
        // NOT decel/4 of the live stat; research §5), crossing zero under
        // the brake kicks ∓$80 like walking. Friction = walk friction/2
        // ($6) ALWAYS, even holding forward — read through the phys table
        // so future water/shoes modifiers compose ($3 underwater, the
        // classic value). Brake + friction stack: $26/frame opposing.
        // move_lock freezes the input (brake/facing) only — friction and
        // the slope factor still run (S3K, same as walking) ---
        move.w  PlayerV.ground_speed(a0), d0
        tst.w   PlayerV.move_lock(a0)
        bne     .friction
        move.b  Ctrl_1_Held, d2
        mask_opposing_lr(d2)
        tst.w   d0
        beq     .friction                       // no motion — nothing to brake
        bmi     .moving_left
        btst    #BUTTON_LEFT_BIT, d2            // opposes rightward roll
        bne     .brake_left
        btst    #BUTTON_RIGHT_BIT, d2           // with the motion:
        beq     .friction                       // facing only (classic
        bclr    #ST_XFLIP, status(a0)           // Obj01_RollRight)
        jbra    .friction
.brake_left:
        subi.w  #PHYS_ROLL_DECEL, d0
        bcc     .friction                       // borrow = crossed zero
        moveq   #-$80, d0                       // turnaround kick
        jbra    .friction
.moving_left:
        btst    #BUTTON_RIGHT_BIT, d2           // opposes leftward roll
        bne     .brake_right
        btst    #BUTTON_LEFT_BIT, d2
        beq     .friction
        bset    #ST_XFLIP, status(a0)           // facing only (classic)
        jbra    .friction
.brake_right:
        addi.w  #PHYS_ROLL_DECEL, d0
        bcc     .friction                       // carry = crossed zero
        move.w  #$80, d0                        // (+$80 exceeds moveq range)
.friction:
        move.w  PBLK_FRICTION(a4), d1
        asr.w   #1, d1                          // roll friction = friction/2
        tst.w   d0
        beq     .unroll_check
        bmi     .fric_neg
        sub.w   d1, d0
        bcc     .unroll_check
        moveq   #0, d0                          // crossed zero → stop
        jbra    .unroll_check
.fric_neg:
        add.w   d1, d0
        bcc     .unroll_check
        moveq   #0, d0

.unroll_check:
        // --- unroll below |gsp| < $80 (S3K). Uncurling lifts the head by
        // the full standing-minus-ball height difference (curl_head_rise,
        // read from the active character's record — 10px for Sonic, 2 for
        // Tails) — unrolling under a low ceiling would clip into it (spec §5
        // wall-clip class). Verify clearance first; blocked → KEEP
        // ROLLING at ±PHYS_KEEP_ROLL_MIN (classic Sonic_KeepRolling's
        // forced inertia = ±$400, the roll-tunnel rule reused for the
        // blocked-unroll case; sign of gsp, rest counts positive) ---
        move.w  d0, PlayerV.ground_speed(a0)    // bank gsp — the ceiling
                                                // sensor below clobbers d0
        move.w  d0, d1
        abs_w(d1)
        cmpi.w  #PHYS_UNROLL_MAX, d1
        bge     .shared_move                    // d0 = gsp, still rolling
        jbsr    Player_SensorCeiling            // d0 = head clearance (ball box)
        movea.l Player_Chardef, a1
        curl_head_rise(a1, d1)                  // d1.w = this character's rise
        cmp.w   d1, d0
        blt     .keep_rolling
        moveq   #PSTATE_GROUND, d0              // unroll — the hook restores
        jbsr    Player_SetState                 // standing radii, uncurl y-shift
        move.w  PlayerV.ground_speed(a0), d0
        jbra    .shared_move                    // frame completes as GROUND
                                                // from the cap (wall probe
                                                // picks standing offsets off
                                                // the new state)
.keep_rolling:
        move.w  #PHYS_KEEP_ROLL_MIN, d0
        tst.w   PlayerV.ground_speed(a0)
        bpl     .shared_move
        neg.w   d0
.shared_move:
        jbsr    Ground_Move_Cap                 // shared cap → projection →
                                                // wall probe (see the entry-
                                                // point note at Ground_Move_Cap; the
                                                // probe undoes the curl
                                                // shift while _pl_state == ROLL)
        jbra    Ground_PostMove                 // integrate → floor pair →
                                                // SlopeRepel fall-through
}

// -----------------------------------------------
// Ground_Move — input → ground_speed, projection, ground wall probe
// Classic accel/decel/friction semantics with the S3K back-out top-speed
// rule and the turnaround kick (research physics-classics §1).
// In:  a0 = player SST, a4 = the slot's player block
// Out: none
// Clobbers: d0-d7, a1
// -----------------------------------------------
proc Ground_Move (a0: *Sst) clobbers(d0-d7/a1) falls_into Ground_Move_Cap {
        move.w  PlayerV.ground_speed(a0), d0
        tst.w   PlayerV.move_lock(a0)
        bne     .friction                       // slip/spring input freeze:
                                                // friction still runs (S3K);
                                                // the decrement lives in
                                                // Player_SlopeRepel
        move.b  Ctrl_1_Held, d2
        mask_opposing_lr(d2)
        btst    #BUTTON_LEFT_BIT, d2
        bne     .move_left
        btst    #BUTTON_RIGHT_BIT, d2
        bne     .move_right
.friction:
        move.w  PBLK_FRICTION(a4), d1
        tst.w   d0
        beq     Ground_Move_Cap
        bmi     .friction_neg
        sub.w   d1, d0
        bcc     Ground_Move_Cap                 // borrow = crossed zero
        moveq   #0, d0
        jbra    Ground_Move_Cap
.friction_neg:
        add.w   d1, d0
        bcc     Ground_Move_Cap                 // carry = crossed zero
        moveq   #0, d0
        jbra    Ground_Move_Cap

.move_left:
        tst.w   d0
        ble     .accel_left
        // decelerating against rightward motion
        sub.w   PBLK_DECEL(a4), d0
        bcc     Ground_Move_Cap
        moveq   #-$80, d0                       // turnaround kick (.w use only)
        jbra    Ground_Move_Cap
.accel_left:
        bset    #ST_XFLIP, status(a0)
        move.w  PBLK_TOP_SPEED(a4), d1
        neg.w   d1
        cmp.w   d1, d0
        ble     Ground_Move_Cap                 // at/beyond −top already:
                                                // preserve (S3K back-out —
                                                // input never curtails
                                                // earned overspeed)
        sub.w   PBLK_ACCEL(a4), d0
        cmp.w   d1, d0
        bge     Ground_Move_Cap
        move.w  d1, d0                          // crossed top this frame → clamp
        jbra    Ground_Move_Cap

.move_right:
        tst.w   d0
        bge     .accel_right
        add.w   PBLK_DECEL(a4), d0
        bcc     Ground_Move_Cap
        move.w  #$80, d0                        // turnaround kick (+$80 exceeds
                                                // moveq's signed-byte range)
        jbra    Ground_Move_Cap
.accel_right:
        bclr    #ST_XFLIP, status(a0)
        move.w  PBLK_TOP_SPEED(a4), d1
        cmp.w   d1, d0
        bge     Ground_Move_Cap                 // S3K back-out (see .accel_left)
        add.w   PBLK_ACCEL(a4), d0
        cmp.w   d1, d0
        ble     Ground_Move_Cap
        move.w  d1, d0
}

// -----------------------------------------------
// Ground_Move_Cap — the shared cap → inertia projection → ground wall
// probe (the classic `.cap` entry). PState_Roll bsr's here directly with
// d0 = its post-friction gsp (also after its unroll/keep-rolling paths);
// Ground_Move falls into it. Everything from the cap through the wall
// probe is shared between walking and rolling; do not reorder, and any
// walk-only addition below must be gated on _pl_state.
// In:  a0 = player SST, a4 = the slot's player block, d0.w = pre-cap gsp
// Out: none
// Clobbers: d0-d7, a1
// -----------------------------------------------
proc Ground_Move_Cap (a0: *Sst) clobbers(d0-d7/a1) {
        // GSp tunneling guard ±$1000, applied after slope factor (added
        // to gsp in PState_Ground/PState_Roll before this point) AND
        // after input.
        // FEEL DEVIATION coupling (spec §2.1): raising it requires
        // CAM_MAX_Y_STEP, VFILL_ROWS_PER_FRAME, and sensor reach to rise
        // together.
        cmpi.w  #PHYS_GSP_CAP, d0
        ble     .cap_pos_ok
        move.w  #PHYS_GSP_CAP, d0
.cap_pos_ok:
        cmpi.w  #-PHYS_GSP_CAP, d0
        bge     .cap_neg_ok
        move.w  #-PHYS_GSP_CAP, d0
.cap_neg_ok:
        move.w  d0, PlayerV.ground_speed(a0)
        move.w  d0, d4                          // capped gsp rides to the wall
                                                // probe in d4 — survives both
                                                // projection paths (GetSineCosine
                                                // clobbers d0/d1 only)

        // --- inertia → velocity projection ---
        // angle 0 fast path: x_vel = gsp exactly, y_vel = 0 (skips two
        // muls — the flat common case)
        tst.b   angle(a0)
        bne     .project_slope
        move.w  d0, x_vel(a0)
        clr.w   y_vel(a0)
        jbra    .wall_probe
.project_slope:
        // classic Traction: x_vel = cos·gsp>>8, y_vel = sin·gsp>>8 — NO
        // negation: the angle convention (down-right slope = +$10) and the
        // sine table (sin($10) = +$61) already agree with screen-down-
        // positive Y. Verified against data/misc/sine.bin + the sensor
        // self-check slope (attr $04, angle $10, heights falling rightward).
        move.w  d0, d2                          // capped gsp — survives
                                                // GetSineCosine (d0/d1 only)
        moveq   #0, d0
        move.b  angle(a0), d0 as Angle          // GetSineCosine takes d0: Angle
        jbsr    GetSineCosine                   // d0 = sin·$100, d1 = cos·$100
        // variable×variable product — no table/shift form exists; one
        // player, slope frames only (flat fast path above), classic does
        // exactly this in Traction
        muls.w  d2, d1                          // lint: disable=E002
        asr.l   #8, d1
        move.w  d1, x_vel(a0)
        muls.w  d2, d0                          // lint: disable=E002
        asr.l   #8, d0
        move.w  d0, y_vel(a0)

.wall_probe:
        // --- ground wall probe at the next-frame position, in the
        // quadrant-relative "ahead" direction (the quadrant form of the
        // classic angle±$40 CalcRoomInFront probe). S3K gates (research
        // physics-classics §1): skip when the angle is a NON-cardinal in
        // the upper half $41-$BF — no false wall hits on steep curved
        // terrain / no pushing on loop tops; exact cardinals stay
        // enabled (feel-modern §2 "disabled outside −90°..90°,
        // re-enabled at exact multiples of 90°") ---
        tst.w   d4                              // capped gsp from .cap —
        beq     .clear_push                     // probe direction sign
        move.b  angle(a0), d1
        move.b  d1, d2
        andi.b  #$3F, d2
        beq     .gate_ok                        // exact cardinal: always probe
        addi.b  #$40, d1
        bmi     .clear_push                     // non-cardinal upper half
.gate_ok:
        // "ahead" per quadrant — derived from the projection at the
        // cardinals (x_vel = cos·gsp, y_vel = sin·gsp): gsp>0 moves
        // right/down/left/up in quadrants 0/1/2/3; gsp<0 mirrors
        moveq   #0, d2
        move.b  PBLK_QUADRANT(a4), d2
        tst.w   d4
        bpl     .dir_fwd
        addq.w  #4, d2
.dir_fwd:
        lea     .dir_table(pc), a1              // (beyond d8(pc,Xn) reach)
        moveq   #0, d7                          // clear the high word: the probe
                                                // code loads as a BYTE but is
                                                // consumed as a word below
                                                // (.off_*/.cancel_* move.w/tst.w)
        move.b  (a1,d2.w), d7                   // probe-core direction code
                                                // (0/1/2/3 = down/up/right/
                                                // left) — d7 survives the
                                                // sensor call
        move.w  x_vel(a0), d0
        asr.w   #8, d0
        add.w   x_pos(a0), d0                   // projected engine X
        move.w  y_vel(a0), d1
        asr.w   #8, d1
        add.w   y_pos(a0), d1                   // projected engine Y
        cmpi.b  #PSTATE_ROLL, PlayerV.player_state(a0)
        bne     .not_rolling
        movea.l Player_Chardef, a1              // (dir_table read is done with a1)
        curl_shift_px(a1, d2)                   // d2 dead here until .probe_y_set
        sub.w   d2, d1                          // rolling: the curl shifted y_pos
                                                // down by this character's shift
                                                // (5px Sonic, 1px Tails), so undo
                                                // it to probe at the STANDING
                                                // center height (SPG/spec §5;
                                                // applies at every angle)
        jbra    .probe_y_set
.not_rolling:
        tst.b   angle(a0)
        bne     .probe_y_set
        addq.w  #8, d1                          // foot-level probe ONLY at
                                                // angle == 0 exactly (SPG:
                                                // low steps push instead of
                                                // snap-up; slopes/walls use
                                                // center height)
.probe_y_set:
        move.w  d7, d2                          // offset PUSH_RADIUS along
        subq.w  #2, d2                          // the probe direction
        bmi     .off_vert                       // 0/1 = probe along Y
        beq     .off_right
        subi.w  #PUSH_RADIUS, d0                // 3: left
        jbra    .probe_go
.off_right:
        addi.w  #PUSH_RADIUS, d0                // 2: right
        jbra    .probe_go
.off_vert:
        tst.w   d7
        bne     .off_up
        addi.w  #PUSH_RADIUS, d1                // 0: down
        jbra    .probe_go
.off_up:
        subi.w  #PUSH_RADIUS, d1                // 1: up
.probe_go:
        move.w  d7, d2
        jbsr    Player_SensorWallDir            // d0 dist (d7 preserved)
        tst.w   d0
        ble     .wall_hit                       // dist<=0: overlap OR flush (dist==0) both count
                                                // as contact — flush must stay ST_PUSHING (else the
                                                // classifier flickers push↔walk as gsp re-accelerates
                                                // against the wall). dist==0 through .wall_hit is inert:
                                                // asl of 0 backs out 0 velocity, gsp is killed (stops
                                                // the subpixel creep), facing-aware push logic still runs.
.clear_push:
        bclr    #ST_PUSHING, status(a0)
        rts
.wall_hit:
        // back the blocked distance into the velocity along the probe
        // axis — the player advances exactly to the wall face this
        // frame; inertia dies
        asl.w   #8, d0                          // dist → 8.8
        move.w  d7, d2
        subq.w  #2, d2
        bmi     .cancel_vert
        beq     .cancel_right
        sub.w   d0, x_vel(a0)                   // 3 left: dist<0 → vel rises
        jbra    .gsp_kill                       // toward zero
.cancel_right:
        add.w   d0, x_vel(a0)
        jbra    .gsp_kill
.cancel_vert:
        tst.w   d7
        bne     .cancel_up
        add.w   d0, y_vel(a0)                   // 0 down
        jbra    .gsp_kill
.cancel_up:
        sub.w   d0, y_vel(a0)                   // 1 up
.gsp_kill:
        move.w  PlayerV.ground_speed(a0), d1    // sign needed below — nonzero
                                                // (gated at .wall_probe)
        clr.w   PlayerV.ground_speed(a0)
        // facing-aware push bit (S3K): only when facing the wall. Track-
        // space rule, quadrant-independent: input→gsp mapping never
        // rotates, so gsp>0 is always the "facing right" travel direction
        tst.w   d1
        bmi     .hit_back
        btst    #ST_XFLIP, status(a0)
        bne     .clear_push                     // moving fwd, facing away
        jbra    .set_push
.hit_back:
        btst    #ST_XFLIP, status(a0)
        beq     .clear_push
.set_push:
        bset    #ST_PUSHING, status(a0)
        rts
.dir_table:
        dc.b    2, 0, 3, 1                      // gsp>0: right/down/left/up
        dc.b    3, 1, 2, 0                      // gsp<0: mirrored
        // (the 8-byte table is already word-aligned — no trailing pad needed)
}

// -----------------------------------------------
// Player_Jump — launch from a grounded state (headroom already verified
// by the caller, buffer consumed here). Perpendicular ADD along the
// surface normal, angle − $40 (research §3): running speed is preserved
// — gsp is NOT zeroed, it's already projected into x_vel/y_vel.
// In:  a0 = player SST, a4 = the slot's player block
// Out: DOES NOT return to the ground flow — transitions to PSTATE_JUMP
//      (PSTATE_ROLLJUMP from a roll) and runs the air body THIS frame,
//      returning to Player_Main's dispatch.
//      press-frame movement: the classic aborts the press frame with
//      `addq.l #4,sp` (no movement until the next frame); we complete
//      the frame airborne so movement happens on the press frame.
// Clobbers: d0-d7, a1-a2
// -----------------------------------------------
pub proc Player_Jump (a0: *Sst) clobbers(d0-d7/a1-a2) {
        // G1: carry the press-frame clearance (d0 from the caller's
        // Player_SensorCeiling gate, 6..32 — fits a byte) into the same-tick
        // air body; consumed/cleared by every PState_AirShared class head.
        // flat REST jumps only — slope projection can exceed the 7px rise
        // bound and wall quadrants probe horizontally (review (b)); the extra
        // y_vel==0 gate closes the slope->flat transition frame, where angle
        // reads 0 but y_vel still carries LAST frame's slope projection
        // (review re-check (2)). angle==0 AND y_vel==0 => press-frame
        // y_vel = -jump_force exactly, so the 7px bound is unconditional.
        // The byte stays 0 on every gated-off jump by invariant.
        tst.b   angle(a0)
        bne     .no_carry
        tst.w   y_vel(a0)
        bne     .no_carry
        move.b  d0, PlayerV.jump_headroom(a0)
.no_carry:
        clr.b   PBLK_JUMPBUF(a4)               // consume the buffered press
        if SOUND_DRIVER_ENABLED == 1 {
                moveq   #SFXID_JUMP, d0 as SfxId
                jbsr    Sound_PlaySFX
        }
        move.w  PBLK_JUMP_FORCE(a4), d2
        move.b  angle(a0), d0
        beq     .flat
        subi.b  #$40, d0 as Angle               // surface normal (GetSineCosine takes d0: Angle)
        jbsr    GetSineCosine                   // d0 sin·$100, d1 cos·$100
                                                // (d2 survives — clobbers
                                                // nothing else)
        // variable×variable product — one-shot event, classic Sonic_Jump
        // does exactly this
        muls.w  d2, d1                          // lint: disable=E002
        asr.l   #8, d1
        add.w   d1, x_vel(a0)
        muls.w  d2, d0                          // lint: disable=E002
        asr.l   #8, d0
        add.w   d0, y_vel(a0)
        jbra    .launched
.flat:
        // angle 0 fast path: cos(−$40) = 0, sin(−$40) = −$100 →
        // x_vel += 0, y_vel −= jump_force (from rest: exactly −$680).
        // Same algebra as the muls path under the engine's UNNEGATED
        // y_vel = +sin convention (see Ground_Move_Cap .project_slope)
        sub.w   d2, y_vel(a0)
.launched:
        clr.b   PlayerV.stick_convex(a0)
        // leaving the object: clear on_object NOW so the same-frame air
        // body (jmp PState_Jump below) does not see it still set and
        // immediately "land" again, cancelling the jump. Touch_Solid won't
        // re-set it while rising (.solid_top requires y_vel >= 0).
        bclr    #ST_ON_OBJECT, status(a0)
        // from a roll → ROLLJUMP (classic lockout: no air control; ball
        // radii simply KEPT by the hooks — structural).
        // SPINDASH never calls here (its body has no jump check).
        moveq   #PSTATE_JUMP, d0
        cmpi.b  #PSTATE_ROLL, PlayerV.player_state(a0)
        bne     .from_stand
        moveq   #PSTATE_ROLLJUMP, d0
.from_stand:
        jbsr    Player_SetState                 // preserves d0 (hook contract)
        // press-frame movement: run the full air body on the press frame — through
        // the state's own preamble so ROLLJUMP locks input on this frame
        // too
        cmpi.w  #PSTATE_ROLLJUMP, d0
        beq     PState_RollJump
        jbra    PState_Jump
}
