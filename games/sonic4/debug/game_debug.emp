// games/sonic4/debug/game_debug.emp — game-side debug/test-harness code the game
// binds to the engine's Game.debug_tick / Game.boot_hook hooks (the manifest
// games/sonic4/config/game.emp, module games.sonic4.game). Sonic 4's sound
// test-harness hotkeys, not engine code; the engine only invokes the hooks, which
// stay `= empty` for games that bind none. Debug_MusicToggle is the per-frame
// debug_tick impl; SoundTest_BootPing is the boot_hook impl.
//
// SHAPE: this file is whole-file gated on `SOUND_DEBUG_HOTKEYS` /
// `SOUND_DRIVER_ENABLED` — it emits ZERO bytes in both canonical shapes
// (SOUND_DEBUG_HOTKEYS is a dev opt-in, OFF in every shipped build) and is
// compiled/placed ONLY at the Config-A hotkeys shape (the compression_selftest
// external-gate model — a module-level comptime `if` wrapping items is not
// expressible, and the whole file is the gated unit). At that shape the config_a
// whole-ROM native golden is the byte oracle for its emission; game_debug_port.rs
// keeps the `.emp`-side proofs (compile, drift guards fire, module-to-module link).

module games.sonic4.game_debug in game_debug

// SongId / SfxId — the sound_api.emp d0 slot types. The song/sfx ids this
// harness feeds Sound_PlayMusic/PlaySFX are born as those newtypes at their
// construction sites (the moveq/move.b degrades the type, the `as` bless
// re-types — sound_api.emp:389 precedent), so the slot-type check sees a typed
// value flowing into each typed slot.
use engine.types.{SongId, SfxId}

// The controller button masks are engine constants — imported from their sole
// author, engine.constants (the ownership flip; BUTTON_B/START joined at the
// conv-b constants-tail flip). BUTTON_EXT_MODE is the 6-button extension bit the
// character-cycle hotkey rides (Debug_CycleCharacter, below).
use engine.constants.{BUTTON_UP, BUTTON_C, BUTTON_A, BUTTON_B, BUTTON_START, BUTTON_EXT_MODE}

// Sst — the character-cycle hotkey re-points the live player slot at the new
// record, so it touches the SST's asset/animation fields by name.
use engine.objects.sst.{Sst}

// CHAR_COUNT — the roster length the cycle wraps at. Sole authority is
// games.sonic4.constants.
use games.sonic4.constants.{CHAR_COUNT}

// PlayerBlock — the player_block splice's stride is sizeof(PlayerBlock) and the
// splice expands in THIS module's scope, so the type has to resolve here.
use games.sonic4.ram.{PlayerBlock}

// player_block — the per-slot PlayerBlock derivation splice; PlayerV — the
// player's SST overlay (the cycle reads debug_flag off it). Both are
// player_common's, imported the same way the player state files import them.
use games.sonic4.player_common.{PlayerV, player_block}

// Song + SFX ids — sole authority is games.sonic4.sound_ids. The DEBUG song
// selector and the DEBUG SFX-trigger cycle read these; the typed slots (`as
// SongId`/`as SfxId`) bless the untyped value at each use.
use games.sonic4.sound_ids.{
    SONG_MOVINGTRUCKS, SONG_DRUMTEST, SONG_HCZ2,
    SFXID_RING_RIGHT, SFXID_DEATH, SFXID_SKID, SFXID_ROLL, SFXID_JUMP,
    SFXID_SPINDASH, SFXID_DASH, SFXID_RINGLOSS
}

// The four Sound_* callees are .emp-owned (sound_api.emp) — they resolve
// module-to-module, so NO `extern proc` decl here (a decl of a .emp-owned proc
// is a §11-Q4 extern/proc collision).
//
// -----------------------------------------------
// Debug_MusicToggle — the game's per-frame debug hook (Game.debug_tick): the
// sound test-harness hotkeys (edge-detected on Ctrl_1_Press) plus the
// character-cycle hotkey (edge-detected on Ctrl_1_Ext_Press). Key map:
//   MODE  = cycle the active character (Sonic → Tails → Knuckles → Sonic)
//   A     = restart Moving Trucks from pattern 0 (logger-safe re-trigger)
//   B     = fire the next test SFX in the cycle (Dbg_Sfx_Sel)
//   UP    = play HCZ2 (S3K Hydrocity Zone Act 2 import, id 3)
//   C     = play the DAC-drum-test song (id 2)
//   START = toggle Moving Trucks play/stop
// PRIORITY CHAIN, not six independent keys: the checks fall through in the
// listed order (MODE → A → B → UP → C → START), each `beq.s .next` else `rts`,
// so the FIRST matching button this frame wins and the rest are skipped (a
// same-frame A+START restarts the song and never reaches the toggle). The button
// masks are distinct single bits, so simultaneous presses are resolved by this
// order. Also exercises Sound_StopMusic and the song-switch silence path (a
// fresh PlayMusic).
//
// CLOBBERS = the honest transitive closure d0-d4/a0-a2: the body writes
// d0-d2/a1 directly, Sound_PlayMusic (sound_api.emp) clobbers d0-d4/a0-a1 — so
// d3/d4/a0 leak in through that call — and Debug_CycleCharacter adds a2 (its
// Player_RefreshPhysics call). The contract closure verifies against the real
// callees. The harness relies on nothing across the calls (each is immediately
// followed by an rts or a Dbg_Music_On store), so the wider closure is latent —
// but the contract must be honest.
// -----------------------------------------------
pub proc Debug_MusicToggle () clobbers(d0-d4/a0-a2) {
        // STRUCTURAL WIDTH PIN (step-2 exception class — the trailing-`align`
        // dependency): the branches stay explicit `.s`/`bsr.w` and the RAM
        // operands stay explicit `(X).w` rather than going bare / `jbsr`. The
        // `align 2` after Dbg_SfxIdTable (below) needs every preceding
        // instruction size FIXED; a bare Bcc (relaxable `.s`/`.w`), a `jbsr` to a
        // cross-seam link target (unknown reach → bsr.s/bsr.w undecided), or a
        // bare abs symbol (abs.w/.l by resolved value) all leave the align at a
        // provisional position → `[align.provisional]`. Byte-identical to the AS
        // twin regardless (it spells the same explicit widths).
        // MODE = cycle the active character. FIRST in the chain, and on a DIFFERENT
        // latch than every other hotkey here: this reads Ctrl_1_Ext_Press (the
        // 6-button extension byte, 0000MXYZ), not Ctrl_1_Press. See
        // Debug_CycleCharacter below for why that byte and not a main button.
        move.b  (Ctrl_1_Ext_Press).w, d0
        andi.b  #BUTTON_EXT_MODE, d0
        beq.s   .check_music
        bsr.w   Debug_CycleCharacter
        rts
    .check_music:
        // A button = RESTART the song from pattern 0 (re-trigger Sound_PlayMusic; NO
        // reboot, NO toggle). For clean from-the-very-top VGM capture during sound
        // debugging: the emulator's reset/reload either kills the VGM logger or doesn't
        // restart the Z80 sequencer, so this gives a logger-safe pattern-0 restart on
        // demand (press A while logging -> capture begins exactly at the song's start).
        move.b  (Ctrl_1_Press).w, d0
        andi.b  #BUTTON_A, d0
        beq.s   .check_sfx
        moveq   #SONG_MOVINGTRUCKS, d0 as SongId   // re-trigger from the top (load silences first)
        bsr.w   Sound_PlayMusic
        move.b  #1, (Dbg_Music_On).w
        rts
    .check_sfx:
        // B button = fire the NEXT test SFX in the cycle (DEBUG SFX-trigger hotkey).
        // Edge-detected on Ctrl_1_Press (one fire per fresh press). Dbg_Sfx_Sel cycles
        // 0..7 over Dbg_SfxIdTable so every core SFX is drivable for VGM capture +
        // the acceptance matrix. B ($10) does not collide with A($40)/START($80).
        // RING_RIGHT is fired via Sound_PlayRing so the L/R stereo-alternation path is
        // exercised too; all others go straight through Sound_PlaySFX. (Both preserve
        // a0 + clobber only d0/SR — safe inside this handler's d0-d4/a0-a1 budget.)
        move.b  (Ctrl_1_Press).w, d0
        andi.b  #BUTTON_B, d0
        beq.s   .check_hcz2
        move.w  (Dbg_Sfx_Sel).w, d1          // current cycle index (0..7)
        move.w  d1, d2
        addq.w  #1, d2
        andi.w  #7, d2                    // wrap 0..7 (8 ids)
        move.w  d2, (Dbg_Sfx_Sel).w          // advance for the next press
        andi.w  #7, d1                    // clamp (defensive)
        cmpi.w  #1, d1                    // index 1 = RING_RIGHT -> use the ring path
        beq.s   .sfx_ring
        moveq   #0, d0
        lea     Dbg_SfxIdTable(pc), a1
        move.b  (a1,d1.w), d0 as SfxId            // d0.b = id from the cycle table (born SfxId for Sound_PlaySFX)
        bsr.w   Sound_PlaySFX
        rts
    .sfx_ring:
        bsr.w   Sound_PlayRing          // L/R-alternating ring SFX ($33/$34)
        rts
    .check_hcz2:
        // UP = play the HCZ2 (S3K Hydrocity Zone Act 2) import song (id 3) on a fresh
        // press. The plan/design proposed B for this, but B ($10) is already the SFX-
        // cycle hotkey (above), so the dedicated HCZ2 trigger uses UP — a free D-pad
        // bit unused by the debug harness and by the idle game state. Edge-detected on
        // Ctrl_1_Press; UP ($01) does not collide with A($40)/B($10)/C($20)/START($80).
        move.b  (Ctrl_1_Press).w, d0
        andi.b  #BUTTON_UP, d0
        beq.s   .check_sample
        moveq   #SONG_HCZ2, d0 as SongId           // S3K Hydrocity Zone Act 2 import (Phase 7)
        bsr.w   Sound_PlayMusic
        move.b  #1, (Dbg_Music_On).w         // keep START's play/stop toggle coherent
        rts
    .check_sample:
        // C button = play the DEBUG STREAM DAC-on drum-test song (id 2) on a fresh
        // press. Exercises the DAC-drum phase end-to-end: $E2 kick/snare from the
        // shared DAC bank with the per-frame song<->sample bank swap (B1), the Layer-4
        // FM6 key-on gate, and FM/PSG music streaming alongside. (Supersedes the old
        // one-shot blip hotkey — the song fires real kick/snare via $E2.) Edge-detected
        // on Ctrl_1_Press; C ($20) does not collide with A($40)/B($10)/START($80).
        move.b  (Ctrl_1_Press).w, d0
        andi.b  #BUTTON_C, d0
        beq.s   .check_start
        moveq   #SONG_DRUMTEST, d0 as SongId       // DEBUG STREAM DAC-on drum-test song
        bsr.w   Sound_PlayMusic
        move.b  #1, (Dbg_Music_On).w         // keep START's play/stop toggle coherent
        rts
    .check_start:
        move.b  (Ctrl_1_Press).w, d0
        andi.b  #BUTTON_START, d0
        beq.s   .done                   // START not pressed this frame
        tst.b   (Dbg_Music_On).w
        bne.s   .stop
        moveq   #SONG_MOVINGTRUCKS, d0 as SongId  // was stopped -> play (Phase 3 native Moving Trucks)
        bsr.w   Sound_PlayMusic
        move.b  #1, (Dbg_Music_On).w
        rts
    .stop:
        bsr.w   Sound_StopMusic         // was playing -> stop
        clr.b   (Dbg_Music_On).w
    .done:
        rts
}

// -----------------------------------------------
// SoundTest_BootPing — the sound test-harness boot hook (Game.boot_hook). Engine
// boot invokes this once, after Sound_Init and before the game-state handoff:
// ping the driver with a recognizable value, autoplay the test song, and seed the
// Start-toggle play state. Bound only in the hotkeys build shape.
//
// CLOBBERS = d0-d4/a0-a1: the body writes d0 and Dbg_Music_On directly, Sound_Ping
// clobbers a0, and Sound_PlayMusic (sound_api.emp) clobbers d0-d4/a0-a1 — so d1-d4
// leak in through that call. Boot-time, every register is free; the declared hook
// bound (Game.boot_hook) covers this exactly.
// -----------------------------------------------
pub proc SoundTest_BootPing () clobbers(d0-d4/a0-a1) {
        moveq   #$3C, d0                     // ping with a recognizable value
        bsr.w   Sound_Ping
        moveq   #SONG_MOVINGTRUCKS, d0 as SongId  // autoplay the test song (typed slot)
        bsr.w   Sound_PlayMusic
        move.b  #1, (Dbg_Music_On).w         // track play state for the Start-toggle
        rts
}

// DEBUG SFX-trigger cycle (indexed by Dbg_Sfx_Sel, 0..7). Index 1 (RING_RIGHT) is
// special-cased to Sound_PlayRing in .check_sfx; the byte here is the fallback id.
// Order: JUMP / RING_RIGHT / SPINDASH / DASH / ROLL / SKID / DEATH / RINGLOSS.
data Dbg_SfxIdTable: [u8; 8] = [
    SFXID_JUMP,              // 0
    SFXID_RING_RIGHT,        // 1 (fired via Sound_PlayRing for L/R alt)
    SFXID_SPINDASH,          // 2
    SFXID_DASH,              // 3
    SFXID_ROLL,              // 4
    SFXID_SKID,              // 5
    SFXID_DEATH,             // 6
    SFXID_RINGLOSS,          // 7
]
align 2

// -----------------------------------------------
// Debug_CycleCharacter — advance Character_ID to the next CHAR_* id and make the
// live player wear that character IMMEDIATELY, mid-level.
//
// WHY THE MODE BUTTON, AND WHY IT CANNOT COLLIDE
// ----------------------------------------------
// Pad 1's main byte is fully spoken for in the DEBUG shape: A/B/C are the jump
// mask (player_common BUTTON_JUMP_MASK), B doubles as the debug-fly toggle, the
// whole D-pad is movement + duck/lookup/spindash, and this harness already owns
// A/B/UP/C/START on Ctrl_1_Press. There is no free main bit and no free main
// COMBO — every pair of face buttons is a legal thing to be holding while
// playing.
//
// The 6-button extension byte has four bits (MODE/X/Y/Z, engine.controllers
// decodes them into Ctrl_1_Ext_Held / Ctrl_1_Ext_Press) and, verified by grep
// across engine/ and games/, NOTHING in either the engine or the game reads
// Ctrl_1_Ext_Press or Ctrl_1_Ext_Held today. MODE is the first of them to get a
// consumer.
//
// THE REPLAY NET IS WHY THIS MATTERS. engine/system/replay.emp's INPUT_PLAYBACK
// arm overwrites exactly two cells — Ctrl_1_Held and Ctrl_1_Press — from the
// recorded stream, and the recorded fixtures are raw Ctrl_1_Held bytes
// (Replay_Record_Buf). The extension byte is neither written by playback nor
// present in a fixture, so a replayed stream CANNOT synthesize this press, no
// matter what it contains. Any main-button choice would only be
// "improbable"; this one is structurally impossible.
//
// One honest limitation: on a 3-button pad `.read_pad_6` forces the extension
// nibble to 0, so the hotkey is inert there. That is a property of the pad, not
// a bug — set the emulator's pad 1 to 6-button.
//
// WHY A NARROW REFRESH AND NOT Player_Init
// ----------------------------------------
// Player_Init would be one `jbsr`, but it is the LEVEL-ENTRY initializer: it
// forces PSTATE_AIR, clears ground speed / move lock / spindash charge / the
// whole status set, and — decisively for this shape — tail-calls
// Player_DebugEnter whenever CHEAT_DEBUG_FLY is armed, which the DEBUG shape
// arms at game init. Cycling characters would therefore yank the player back
// into the yellow free-flight marker every press, i.e. the one thing that makes
// the swap invisible. A debug tool you cannot see the result of is not a tool.
//
// So this refreshes exactly what VARIES PER CHARACTER and nothing else, leaving
// position, velocity, angle, state and the state machine alone:
//   * Player_Chardef      — the resolved record every dispatch site reads
//   * Player_RefreshPhysics — the slot's 8-word physics row (cd_phys)
//   * Player_InitAssets   — mappings / art word / animation table
//   * mapping_frame + RefreshSpritePieceCount — the new mappings' frame 0 and
//     its cached piece count, re-derived before any render can run
//   * prev_anim / prev_frame = $FF — forces Player_Display's next pass to
//     re-select the animation and re-run Player_LoadArt, which is what actually
//     re-DMAs the new character's tiles into the shared VRAM window (cd_dplc /
//     cd_artbase / cd_vrambase all come off the record, so the DPLC stream
//     follows the swap with no further work here)
// cd_ability needs no refresh: player_air reads it off Player_Chardef at the
// moment it fires.
//
// While debug-fly is ACTIVE the SST carries the marker square's art, and
// Player_DebugExit re-runs Player_InitAssets on the way out — so the asset half
// is skipped there and picked up on exit, exactly like a character chosen before
// the flight started. The record and the physics row still update immediately.
//
// In:  none (reads/writes Character_ID)
// Out: Character_ID advanced, Player_1 re-dressed
// Clobbers: d0, d2, a0-a2 — d2/a1 via RefreshSpritePieceCount, a1-a2 via
//           Player_RefreshPhysics, a1 via Player_InitAssets.
// -----------------------------------------------
proc Debug_CycleCharacter () clobbers(d0/d2/a0-a2) {
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.w  Character_ID, d0
        addq.w  #1, d0
        cmpi.w  #CHAR_COUNT, d0                 // the id only ever steps by one, so
        bne     .no_wrap                        // equality is the whole wrap condition
        moveq   #0, d0
    .no_wrap:
        assert.w d0, ls, #CHAR_COUNT-1          // id in roster range — Player_Init's guard,
                                                // checked BEFORE the store so a bad value
                                                // never reaches RAM
        move.w  d0, Character_ID

        // roster resolve — the same derivation Player_Init runs. Repeated rather
        // than reached through Player_Init because calling Player_Init is the
        // thing this routine exists to avoid (see the header); the roster row
        // for CHAR_KNUCKLES is still the Sonic record, so every id in
        // 0..CHAR_COUNT-1 lands on a complete CharacterDef and cycling past
        // Tails is safe.
        lsl.w   #2, d0                          // × sizeof(pointer); no scaled
                                                // indexing on the 68000
        lea     CharacterDefs, a1
        movea.l (a1,d0.w), a1
        move.l  a1, Player_Chardef

        lea     Player_1, a0                    // the leader slot — the only one the
                                                // level test states spawn
        player_block(a0, a2)                    // this slot's block — Refresh writes its row
        jbsr    Player_RefreshPhysics

        tst.b   PlayerV.debug_flag(a0)
        bne     .done                           // in debug-fly: the marker art stays,
                                                // Player_DebugExit picks the new record up
        jbsr    Player_InitAssets
        // Qualified `Sst.field(a0)` rather than the bare spelling the player code
        // uses: bare field displacements resolve off a proc PARAM typed `*Sst`,
        // and this routine takes none — a0 is loaded here, not passed in.
        clr.b   Sst.mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // re-cache piece count + frame_off NOW; a
                                                // render can run before the next display pass
        move.b  #$FF, Sst.prev_anim(a0)
        move.b  #$FF, Sst.prev_frame(a0)
    .done:
        rts
}
