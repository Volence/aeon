// Dust sprite data — S3K Obj_DashDust's charge cycle + skid/slide puff block.
//
// ONE art blob, two consumers with different loading strategies:
//   tiles  0-71  charge frames, STREAMED by DPLC_Dust into VRAM_DUST_SPINDASH
//   tiles 72-87  the puff block, DMA'd RESIDENT once into VRAM_DUST_PUFF
// The split is a byte offset into this blob, asserted below.
//
// Generated by games/sonic4/data/dust_staging/gen_dust.py (deterministic; see
// its README for donor provenance and the palette re-index). Do not hand-edit.
module games.sonic4.dust_data in dust_data

use engine.constants.{TILE_SIZE, DMA_IMPORTANT_SLOTS}
// The two VRAM windows this blob's halves land in, by their DECLARED extents.
// Sole authority is games.sonic4.constants, whose vram-map block emits each
// region's `_TILES` from games/sonic4/vram.toml beside its base.
use games.sonic4.constants.{VRAM_DUST_PUFF_TILES, VRAM_DUST_SPINDASH_TILES}
use engine.objects.dplc.{dplc_peak_tiles, dplc_peak_entries, DPLC_ENTRY_RESERVE,
                         DPLC_ADDRESSABLE_TILES, offset_table_frames,
                         empty_frame_mismatches}

const _map_spindash = embed("games/sonic4/data/generated/dust/map_dust_spindash.bin")
const _map_puff     = embed("games/sonic4/data/generated/dust/map_dust_puff.bin")
const _dplc_dust    = embed("games/sonic4/data/generated/dust/dplc_dust.bin")
const _art_dust     = embed("games/sonic4/data/generated/dust/art_dust.bin")

// The puff block's byte offset into Art_Dust, and its length — the resident
// DMA's source and size. Named here (the format owner) rather than at the load
// site, so a re-export that moved the split is one edit.
pub const DUST_PUFF_ART_OFF = 72 * TILE_SIZE    // 2304
pub const DUST_PUFF_ART_LEN = 16 * TILE_SIZE    // 512

ensure(_art_dust.len == 88 * TILE_SIZE, "Art_Dust must be 88 tiles — 72 charge + 16 puff")
ensure(DUST_PUFF_ART_OFF + DUST_PUFF_ART_LEN == _art_dust.len,
       "the puff block must be the TAIL of Art_Dust")
// …and the length of that DMA must be the length of the region it lands in.
// Without this the triangle blob-length / OFF / LEN is self-consistent and tied
// to NOTHING in the map: a re-export with a bigger puff block fires the two
// ensures above, the obvious repair is to raise the 16 here, and the build goes
// green while the DMA writes past `dust_puff` into `dust_spindash`'s charge
// tiles. That is the C2a-H1c shape; this line is what refuses it. DOES NOT
// COVER: the puff MAPPINGS, which could address tiles this DMA never wrote, nor
// the DMA's destination (vram_bytes(VRAM_DUST_PUFF), at the load site in
// games/sonic4/test/ojz_scroll_test.emp).
ensure(DUST_PUFF_ART_LEN == VRAM_DUST_PUFF_TILES * TILE_SIZE,
       "the resident puff DMA is {DUST_PUFF_ART_LEN} bytes but `dust_puff` is declared {VRAM_DUST_PUFF_TILES} tiles ({VRAM_DUST_PUFF_TILES * TILE_SIZE} bytes) in games/sonic4/vram.toml — the DMA would run past the region into its neighbour. Resize the REGION and regenerate, or re-page the art; do not just raise the length here")
// -----------------------------------------------
// MAP <-> DPLC FRAME-COUNT BINDING (LS-9, 2026-09-07), and the one place in the
// tree where the pairing is NOT one-to-one.
//
// THE DPLC BELONGS TO THE CHARGE HALF ONLY. `Map_DustSpindash` is streamed by
// `DPLC_Dust` (DustSpindash_Main calls Perform_DPLC_Deferrable); `Map_DustPuff`
// is drawn from art DMA'd RESIDENT once and its object calls no DPLC at all
// (games/sonic4/objects/dust_puff.emp says so at its head). So the binding below
// names the charge map, and the puff map deliberately has no partner — pairing it
// with DPLC_Dust would be a guard that compares two unrelated tables and passes
// or fails for no reason connected to either. The puff's own protection is the
// DUST_PUFF_ART_LEN ensure above.
// -----------------------------------------------
ensure(offset_table_frames(_map_spindash) == offset_table_frames(_dplc_dust),
       "Map_DustSpindash declares {offset_table_frames(_map_spindash)} frames and DPLC_Dust {offset_table_frames(_dplc_dust)} — one mapping_frame byte indexes BOTH, so the shorter table is read past its end and a byte of the blob after it is followed as a frame offset. Both are emitted by games/sonic4/data/dust_staging/gen_dust.py; re-run it rather than editing one blob. DOES NOT COVER: Map_DustPuff, which has no DPLC by design and is guarded by DUST_PUFF_ART_LEN instead; nor whether either count matches what Ani_DustSpindash's frame bytes reach (AnimateSprite bounds no frame byte — LS-9a)")
ensure(empty_frame_mismatches(_map_spindash, _dplc_dust,
                              offset_table_frames(_map_spindash)) == 0,
       "{empty_frame_mismatches(_map_spindash, _dplc_dust, offset_table_frames(_map_spindash))} dust charge frame(s) disagree about being empty — a drawn frame whose DPLC loads nothing renders whatever `dust_spindash` last held. DOES NOT COVER: whether a NON-empty pair agrees on how MUCH (both counts are compared only against zero), the puff half (no DPLC), nor the frame count (the guard above)")

// Entries are Important queue slots; the dust's tables are single-entry.
ensure(dplc_peak_entries(_dplc_dust) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS,
       "the dust DPLC's peak frame costs more Important queue slots than the budget leaves — re-page the dust art")

// The charge half streams into `dust_spindash`. The ceiling used to be the bare
// literal 12 — a hand-typed restatement of that region's extent, with nothing
// tying it to the map (LS-4 / C2a-H1, fixed 2026-09-07). It is now the map's own
// declaration, so shrinking the region in vram.toml lands here red.
ensure(dplc_peak_tiles(_dplc_dust) <= VRAM_DUST_SPINDASH_TILES,
       "the charge DPLC's peak frame is {dplc_peak_tiles(_dplc_dust)} tiles and exceeds its {VRAM_DUST_SPINDASH_TILES}-tile window `dust_spindash` — re-page the art, or grow the region in games/sonic4/vram.toml and regenerate. DOES NOT COVER: the queue-slot cost of that frame (the entries guard above), nor the RESIDENT puff half, which is not DPLC-streamed and is guarded by the DUST_PUFF_ART_LEN ensure instead")

// THE 12-BIT tile_start CEILING. Vacuously true for an 88-tile sheet (4,008 of
// headroom) and stated anyway: the property is "every DPLC-fed art sheet carries
// this", and tools/test_dplc_tile_start.py refuses a module that skips it. Stated
// against the WHOLE blob, not the 72-tile charge block — the puff tail is DMA'd
// resident today, but a re-export that folded it into the DPLC would still be
// indexing off Art_Dust's base. See engine/objects/dplc.emp.
ensure(_art_dust.len / TILE_SIZE <= DPLC_ADDRESSABLE_TILES,
       "Art_Dust is {_art_dust.len / TILE_SIZE} tiles; a DPLC entry's tile_start can only name 0..{DPLC_ADDRESSABLE_TILES - 1}, so the tiles above that would be addressed by a WRAPPED index and load early-frame art — re-page or shrink the sheet, do not raise the field")

pub data Map_DustSpindash = _map_spindash
pub data Map_DustPuff     = _map_puff
pub data DPLC_Dust        = _dplc_dust
pub data Art_Dust         = _art_dust
