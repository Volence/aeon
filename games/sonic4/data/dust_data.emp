// Dust sprite data — S3K Obj_DashDust's charge cycle + skid/slide puff block.
//
// ONE art blob, two consumers with different loading strategies:
//   tiles  0-71  charge frames, STREAMED by DPLC_Dust into VRAM_DUST_SPINDASH
//   tiles 72-87  the puff block, DMA'd RESIDENT once into VRAM_DUST_PUFF
// The split is a byte offset into this blob, asserted below.
//
// Generated by games/sonic4/data/dust_staging/gen_dust.py (deterministic; see
// its README for donor provenance and the palette re-index). Do not hand-edit.
module games.sonic4.dust_data in dust_data

use engine.constants.{TILE_SIZE, DMA_IMPORTANT_SLOTS}
use engine.objects.dplc.{dplc_peak_tiles, dplc_peak_entries, DPLC_ENTRY_RESERVE,
                         DPLC_ADDRESSABLE_TILES}

const _map_spindash = embed("games/sonic4/data/generated/dust/map_dust_spindash.bin")
const _map_puff     = embed("games/sonic4/data/generated/dust/map_dust_puff.bin")
const _dplc_dust    = embed("games/sonic4/data/generated/dust/dplc_dust.bin")
const _art_dust     = embed("games/sonic4/data/generated/dust/art_dust.bin")

// The puff block's byte offset into Art_Dust, and its length — the resident
// DMA's source and size. Named here (the format owner) rather than at the load
// site, so a re-export that moved the split is one edit.
pub const DUST_PUFF_ART_OFF = 72 * TILE_SIZE    // 2304
pub const DUST_PUFF_ART_LEN = 16 * TILE_SIZE    // 512

ensure(_art_dust.len == 88 * TILE_SIZE, "Art_Dust must be 88 tiles — 72 charge + 16 puff")
ensure(DUST_PUFF_ART_OFF + DUST_PUFF_ART_LEN == _art_dust.len,
       "the puff block must be the TAIL of Art_Dust")
// Entries are Important queue slots; the dust's tables are single-entry.
ensure(dplc_peak_entries(_dplc_dust) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS,
       "the dust DPLC's peak frame costs more Important queue slots than the budget leaves — re-page the dust art")

ensure(dplc_peak_tiles(_dplc_dust) <= 12,
       "the charge DPLC's peak frame exceeds its 12-tile window (VRAM_DUST_SPINDASH)")

// THE 12-BIT tile_start CEILING. Vacuously true for an 88-tile sheet (4,008 of
// headroom) and stated anyway: the property is "every DPLC-fed art sheet carries
// this", and tools/test_dplc_tile_start.py refuses a module that skips it. Stated
// against the WHOLE blob, not the 72-tile charge block — the puff tail is DMA'd
// resident today, but a re-export that folded it into the DPLC would still be
// indexing off Art_Dust's base. See engine/objects/dplc.emp.
ensure(_art_dust.len / TILE_SIZE <= DPLC_ADDRESSABLE_TILES,
       "Art_Dust is {_art_dust.len / TILE_SIZE} tiles; a DPLC entry's tile_start can only name 0..{DPLC_ADDRESSABLE_TILES - 1}, so the tiles above that would be addressed by a WRAPPED index and load early-frame art — re-page or shrink the sheet, do not raise the field")

pub data Map_DustSpindash = _map_spindash
pub data Map_DustPuff     = _map_puff
pub data DPLC_Dust        = _dplc_dust
pub data Art_Dust         = _art_dust
