// Test sprite mappings — a 16x16 colored square (two color variants) + an 8x8
// particle, in the engine's VDP-order mapping format.
//
// Shape: `Map_TestObj` is the frame INDEX (a word-offset table, §4.7 `offsets`);
// each entry points at its frame record. A frame record is the 4-byte signed
// bounding box (far edges: x_max = x_off + width_px), the piece count word, then
// that many 8-byte pieces (VDP order: Y offset, size|link, tile attrs, X offset).
// The bbox extents are FLIP-INVARIANT (the union of the flipped/unflipped
// extents — see tools/convert_s2_mappings.py); every test frame here is symmetric
// so symmetrization leaves the values unchanged.
//
// The word offsets replace the old `dc.w Frame - Map_TestObj` hand-arithmetic:
// the construct emits the same table and range-checks every entry at link.
module games.sonic4.test_mappings in test_mappings

use engine.objects.mapping_dsl.{MapPiece, MapFrame1, centered}

pub offsets Map_TestObj {
    F0: MapFrame1 = centered(half: 8, w: 2, h: 2, tile: 0),   // 16x16, color index 1
    F1: MapFrame1 = centered(half: 8, w: 2, h: 2, tile: 4),   // 16x16, second color
    F2: MapFrame1 = centered(half: 4, w: 1, h: 1, tile: 0),   // 8x8 particle
}
