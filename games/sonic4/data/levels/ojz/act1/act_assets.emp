// OJZ Act 1 palette + background assets: four blobs in the natively-placed
// `ojz_act_assets` section. Even-length blobs — no inter-blob alignment padding.
//
//   OJZ_Palette         — act CRAM palette (line 1..), consumed by act_descriptor.emp
//   BGND_Palette        — shared/HUD palette (CRAM line 0), consumed by ojz_scroll_test.emp
//   OJZ_Act1_BG_Layout  — zone-wide Plane B nametable (§2 A.5 T1), act_descriptor.emp
//   OJZ_Act1_BG_Tiles   — shared BG tile blob, act_descriptor.emp
module games.sonic4.ojz_act_assets_act1 in ojz_act_assets

use engine.bg.{BG_LAYOUT_SIZE}

pub data OJZ_Palette        = embed("games/sonic4/data/generated/ojz/act1/ojz_palette.bin")
pub data BGND_Palette       = embed("art/palettes/SonicAndTails.bin")

// TYPED on purpose — the length IS the guard (tools lens sweep D6). BG_Init blits
// exactly BG_LAYOUT_SIZE bytes from here, and TWO generators write this file with
// INCOMPATIBLE geometry: ojz_strip_gen emits PLANE_B_H=32 -> 4096 bytes row-major,
// tools/inject_editor_bg.py emits 64x64 -> 8192 bytes column-major. The committed
// blob is correct only because the injector runs SECOND, and it is conditional on
// editor_bg_override.json existing (regenerate-level.sh). Rename that file, add a
// second act, or bake any act with no editor BG, and the engine blits 8192 bytes
// out of a 4096-byte blob: a transposed background over the first half and
// whatever the linker placed next over the second.
//
// bg.emp said "No length guard needed" — the guarantee it rested on was a shell
// script `if`. This annotation is the guard: a wrong-sized blob is now an
// `array length mismatch` at build time instead of garbage on screen.
pub data OJZ_Act1_BG_Layout: [u8; BG_LAYOUT_SIZE] = embed("games/sonic4/data/generated/ojz/act1/zone_bg.bin")
pub data OJZ_Act1_BG_Tiles  = embed("games/sonic4/data/generated/ojz/act1/bg_tiles.bin")

// ---- THE TALL TEST MAP (regions part 2 step 5; spec step-table row 5) ----
// DEBUG ONLY, and the `if` is what makes that true rather than a comment: in the
// release shape this is a zero-length array and the 12 KB never reaches the ROM.
// The same gating shape OJZ_Preset_NightSnap uses (games/sonic4/data/effects/
// ojz_effects.emp), for the same reason.
//
// WHY A SECOND LAYOUT EXISTS. Until a background map is a DIFFERENT HEIGHT from the
// plane, two landed steps are indistinguishable from the code they replaced:
// Draw_BG_TileRow (step 2) has no row to stream, and the region-derived position
// clamp (step 4) can only ever compute PLANE_B_SPAN - SCREEN_HEIGHT = 288, which is
// the VSCROLL_BG_MAX it replaced. 96 rows makes the span 768 and the ceiling 544 —
// a value the pre-step-4 code could not produce on any authored input. This map is
// the discriminator for both.
//
// TYPED, like its sibling above and for the same reason: the length IS the guard.
// tools/gen_tall_bg_test.py writes the blob and asserts its 96 rows are pairwise
// distinct (the BG-TALL gate reads plane row m mod 64 and asks which MAP row it
// holds — a question with no answer if two rows are equal); this annotation is what
// stops a stale or half-written blob from becoming a wrong picture instead of a
// build error.
pub const BG_LAYOUT_TALL_ROWS = 96
pub const BG_LAYOUT_TALL_SPAN = BG_LAYOUT_TALL_ROWS * 8      // px — the authored rg_bg_span
pub const BG_LAYOUT_TALL_SIZE = if DEBUG == 1 { BG_LAYOUT_TALL_ROWS * 64 * 2 } else { 0 }
ensure(BG_LAYOUT_TALL_ROWS * 64 * 2 > BG_LAYOUT_SIZE,
       "games/sonic4/data/levels/ojz/act1/act_assets.emp: the step-5 test map is {BG_LAYOUT_TALL_ROWS} rows = {BG_LAYOUT_TALL_ROWS * 64 * 2} bytes, which is NOT taller than a full plane ({BG_LAYOUT_SIZE} bytes). Its entire purpose is to be taller than the plane: at or below that height rg_bg_span's ceiling collapses back onto VSCROLL_BG_MAX, BG_Stream_Update's max_top is 0, and every step-5 gate goes green while measuring nothing")
pub data OJZ_Act1_BG_Layout_Tall: [u8; BG_LAYOUT_TALL_SIZE] = if DEBUG == 1 { embed("games/sonic4/data/generated/ojz/act1/zone_bg_tall_debug.bin") } else { [] }

// ---- THE REGION BG SWITCH SHOWCASE (region bg switch, task 2; DEBUG ONLY) ----
// A second background with its OWN TILES, so a crossing that overwrites the BG tile arena
// and then repaints Plane B can be seen and gated. An instrument, not content: the picture
// is Aurora's library entry `deep-forest-v15-marching-colonnade`, chosen because it is one of
// the three entries whose tiles fit the static budget; the look is the owner's call.
// tools/gen_region_bg_showcase.py writes both blobs and refuses anything that would make
// the gates vacuous (tiles equal to the act's, or a layout naming a tile the blob lacks).
//
// TYPED, like the two layouts above, and the tile blob is typed too: both lengths are the
// guard. The tile count is mirrored here as a literal (a comptime length of an embed is
// not readable) and tools/test_gen_region_bg_showcase.py holds it to the blob, and the
// static budget to vram.toml, so neither literal can drift silently.
//
// EVEN-LENGTH, so both land at even addresses after the even-length blobs before them:
// the tile blob is a DMA SOURCE (engine/level/bg.emp's overwrite), and an odd source makes
// the queue's `lsr.l #1` read one byte early. The overwrite also raise_errors on an odd
// source in DEBUG.
pub const BG_REGION_STATIC_TILE_BUDGET = 320                  // vram.toml bg_region tiles - band_reserve
pub const BG_SHOWCASE_TILE_COUNT = 216
pub const BG_SHOWCASE_TILES_SIZE = if DEBUG == 1 { 2 + BG_SHOWCASE_TILE_COUNT * 32 } else { 0 }
pub const BG_SHOWCASE_LAYOUT_SIZE = if DEBUG == 1 { BG_LAYOUT_SIZE } else { 0 }
ensure(BG_SHOWCASE_TILE_COUNT <= BG_REGION_STATIC_TILE_BUDGET,
       "games/sonic4/data/levels/ojz/act1/act_assets.emp: the region showcase blob holds {BG_SHOWCASE_TILE_COUNT} tiles and a region's background may use at most the static budget, {BG_REGION_STATIC_TILE_BUDGET} (vram.toml bg_region tiles - band_reserve). The overwrite clamps at BG_TILE_CAPACITY at run time, but past the static budget the blob would eat the reserve the band importer keeps")
pub data OJZ_Act1_BG_Showcase_Layout: [u8; BG_SHOWCASE_LAYOUT_SIZE] = if DEBUG == 1 { embed("games/sonic4/data/generated/ojz/act1/zone_bg_showcase_debug.bin") } else { [] }
pub data OJZ_Act1_BG_Showcase_Tiles: [u8; BG_SHOWCASE_TILES_SIZE] = if DEBUG == 1 { embed("games/sonic4/data/generated/ojz/act1/bg_tiles_showcase_debug.bin") } else { [] }
