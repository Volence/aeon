// OJZ Act 1 — level descriptor and section tables (§4 Phase 1, §2 A.3).
//
// The Tier-1+2 act shape (docs/superpowers/notes/2026-07-10-act-descriptor-
// design.md): the descriptor is a TYPED Act literal (field-order drift
// cannot compile; the type IS the old `* == Act_len` size guard), the nine
// sections flow through one validating constructor, and the engine
// invariants are written ONCE as comptime checks instead of per-act
// if/error blocks. Generated data (pool pages, block blobs, palettes, BG) lives
// in separate natively-placed `.emp` sections; act_descriptor reads their
// symbols cross-module.
module games.sonic4.act_descriptor_ojz_act1 in act_descriptor

// ---- The Sec/Act ROM-descriptor structs live in the shared engine.structs
// module: it carries the layout + the per-field drift wall; act keeps the
// validating constructor + field defaults below.
use engine.structs.{Act, Sec}

// Effects P1 gate fixtures live in the game-side effects library beside the
// parallax configs (games/sonic4/data/parallax/configs.emp).
use games.sonic4.parallax_configs.{OJZ_TestRaster, OJZ_TestPal}

// SECTION_SIZE_SHIFT + EDGE_CLAMP are engine constants — imported from their sole
// author now that engine.constants is the definition (the P5 ownership flip).
// The imported consts are plain comptime ints, so EDGE_CLAMP range-proves into
// the u8 field directly (a link-folded extern could not — the old mirror note).
use engine.constants.{SECTION_SIZE_SHIFT, EDGE_CLAMP, MAX_ACT_SECTIONS, PAGE_TABLE_MAX, ART_POOL_PAGE_BYTES}

// Generated interior-island manifests: the art-pool page count/tile
// total and the per-section block-dict lengths are `.emp` const modules the
// generators emit (tools/ojz_strip_gen.py / ojz_block_gen.py) — comptime ints
// consumed directly (they range-prove into the u16 fields; a link-folded extern
// could not, and the pool-tile ceiling proof below now fails at COMPTIME).
use games.sonic4.ojz_act_pool_manifest_act1.{OJZ_ACT_POOL_PAGES}
use games.sonic4.ojz_block_dicts_act1.{
    OJZ_SEC0_BLOCK_DICT_LEN,
    OJZ_SEC1_BLOCK_DICT_LEN,
    OJZ_SEC2_BLOCK_DICT_LEN,
    OJZ_SEC3_BLOCK_DICT_LEN,
    OJZ_SEC4_BLOCK_DICT_LEN,
    OJZ_SEC5_BLOCK_DICT_LEN,
    OJZ_SEC6_BLOCK_DICT_LEN,
    OJZ_SEC7_BLOCK_DICT_LEN,
    OJZ_SEC8_BLOCK_DICT_LEN,
}

// P2b residency cutover (plan Task 5 §2e): the pool is no longer VRAM-tile-bounded.
// The residency cache streams pages through PAGE_FRAMES fixed 64-tile frames and
// page-in DMAs to an ALLOCATED frame (frame*64*32), never to tile page_id*64 — so
// the resident VRAM footprint is bounded to the FG art window by the frame
// allocator REGARDLESS of pool size. The real ceiling is therefore the residency
// page table's capacity, not POOL_TILE_CEILING. (The old
// `OJZ_ACT_POOL_TILES <= POOL_TILE_CEILING` identity-residency guard — "would DMA
// over the character region at tile 960" — is obsolete under frame allocation; it
// mirrors the generator's `pages <= PAGE_TABLE_MAX` assert, which the Task-5
// cutover already switched to.)
ensure(OJZ_ACT_POOL_PAGES <= PAGE_TABLE_MAX,
       "OJZ act 1 art pool {OJZ_ACT_POOL_PAGES} pages exceeds PAGE_TABLE_MAX residency page-table capacity")

// ---- the act's shape, written once ----
const GRID_W = 3
const GRID_H = 3

// The old per-act if/error blocks, as comptime facts (they fail the build
// HERE, not at link): grid capacity, and the <= $8000 axis-extent ceiling that
// guards BOTH boundary-clamp hazards (grid dim <= 16 sections, tighter than
// either): (a) the signed-word MIN clamp — an axis extent at or past $8000 reads
// negative and min-clamps to 0; (b) the word-truncated MAX clamp in camera.asm
// AND player_common.asm (subi.w/cmp.w) that wraps above $FFFF px = grid dim > 31.
// Floating-origin Phase 4 lifts both.
ensure(GRID_W * GRID_H <= MAX_ACT_SECTIONS,
       "act grid {GRID_W}x{GRID_H} exceeds MAX_ACT_SECTIONS")
ensure(GRID_W >= 1 && GRID_H >= 1,
       "act grid {GRID_W}x{GRID_H}: a zero axis makes the camera clamp bound negative (extent < screen)")
ensure((GRID_W << SECTION_SIZE_SHIFT) <= $8000,
       "grid_w axis extent breaks the signed-word camera clamp")
ensure((GRID_H << SECTION_SIZE_SHIFT) <= $8000,
       "grid_h axis extent breaks the signed-word camera clamp")
// Section_GetSecPtrXY (engine/level/section.emp) indexes the Sec grid with
// `adda.w d0, a0`, d0 = flat_id × sizeof(Sec)=66; adda.w SIGN-EXTENDS the word, so
// an act above $7FFF / 66 = 496 flat sections wraps the pointer. MAX_ACT_SECTIONS
// is the flat-section ceiling. The stride derives from the struct, so the
// ceiling moves with Sec instead of staying pinned to whatever it is today, and
// the message reports both operands rather than a baked-in limit. Note the
// consumers still spell the stride as a literal under section.emp's
// `ensure(sizeof(Sec) == 66)`, so a Sec change trips THAT first — this guard is
// the ceiling's own net, not the stride's.
ensure(MAX_ACT_SECTIONS * sizeof(Sec) <= $7FFF,
       "MAX_ACT_SECTIONS ({MAX_ACT_SECTIONS}) x sizeof(Sec) ({sizeof(Sec)}) exceeds $7FFF: Section_GetSecPtrXY adda.w sign-extends and wraps — widen the adda or pre-multiply flat_id as a long")

// P2c Task 10 RIDER — sub-page-budget init deadlock guard. Level init bulk-loads
// the pool at <=1 page/frame while page_in charges each landing against this
// per-act byte budget; a budget below one page (ART_POOL_PAGE_BYTES) can never
// admit even a single page, so the display-off load loop would defer forever and
// never reach gameplay. Written once as a comptime fact so a mis-set descriptor
// fails HERE, not as a silent boot hang. (2 pages/frame ceiling = 2×2048.)
const ACT_ART_BUDGET = 4096
ensure(ACT_ART_BUDGET >= ART_POOL_PAGE_BYTES,
       "OJZ act 1 art budget {ACT_ART_BUDGET} < one page ({ART_POOL_PAGE_BYTES}) — init page-load would defer forever (deadlock)")

pub data OJZ_Act1_Descriptor: Act = Act{
    sec_grid_ptr:        OJZ_Act1_Sections,
    grid_w:              GRID_W,
    grid_h:              GRID_H,
    start_local_x:       $0100,                          // 256px into section 0
    start_local_y:       $0100,                          // ground level
    start_sec_x:         0,
    start_sec_y:         0,
    act_bg_layout:       OJZ_Act1_BG_Layout,             // §2 A.5 T1 zone-wide BG
    act_bg_tiles:        OJZ_Act1_BG_Tiles,
    act_parallax_config: ParallaxConfig_OJZ_Default,     // fallback for NULL sections
    act_art_pool_table:  OJZ_Act_Pool_PageTable,         // manifest v2 table [PageManifest;N] (generated)
    act_art_pool_pages:  OJZ_ACT_POOL_PAGES,             // generated manifest const
    edge_mode:           EDGE_CLAMP,                     // §10; OJZ ships CLAMP
    pad_21:              default,
    act_sec_local_maps:  OJZ_Sec_LocalMaps,              // P2b per-section local->global tables (generated)
    act_art_budget:      ACT_ART_BUDGET,                  // P2c Task 9: 2 pages/frame (2×2048) steady-state ceiling; guarded above
}

// -----------------------------------------------
// Section definition table — 9 entries × sizeof(Sec)
// Grid layout (3×3):  Row 0 = Sec0,Sec1,Sec2 (unique art)
//                     Row 1 = Sec3,Sec4,Sec5 (clone Sec0 art, distinct sky tint)
//                     Row 2 = Sec6,Sec7,Sec8 (clone Sec0 art, distinct sky tint)
// -----------------------------------------------
// The standard OJZ section, built through ONE constructor: the varying
// facts are the four per-section pointers and the dict pair; everything
// else is the declared Sec default. (Tier 3 — deriving the stems from the
// section NUMBER — waits on computed-name extern(); see the design note.)
// `pal` is an explicit required argument rather than a defaulted one: OJZ_Palette
// is a cross-module `pub data` resolving as a link-time extern, so it can be a
// field VALUE but not a comptime default. Each section naming its palette is the
// clearer contract anyway. `raster` defaults to 0 = no raster program.
//
// A section palette is 96 bytes = CRAM lines 1-3. Line 0 is the CHARACTER line
// (CharacterDef.cd_palette) and the level must never write it — see
// Palette_LoadSection in engine/system/buffers.emp.
comptime fn ojz_sec(blocks: Label, objects: Label, rings: Label, type_table: Label, dict: int, dict_len: int, pal: Label, raster: Label = 0) -> Sec {
    return Sec{
        sec_block_index:      blocks,
        sec_objects:          objects,
        sec_rings:            rings,
        sec_plc:              default,
        sec_pal:              pal,        
        sec_parallax_config:  default,      // act default parallax
        sec_raster_table:     raster, 
        sec_bg_layout:        default,      // NULL = zone-wide T1 BG
        sec_type_table:       type_table,
        sec_pal_cycle:        default,
        sec_sound_bank:       default,
        sec_block_dict:       dict,
        sec_anim_blocks:      default,
        sec_collision_s4lz:   default,
        sec_flags:            default,
        sec_music:            default,
        sec_pcfg_pad_3C:      default,
        sec_camera_lookahead: default,
        sec_pcfg_pad_3E:      default,
        sec_pcfg_pad_3F:      default,
        sec_block_dict_len:   dict_len,
    }
}

pub data OJZ_Act1_Sections: [Sec; 9] = [
    ojz_sec(blocks: OJZ_Sec0_Blocks,
            objects: OJZ_Sec0_Objects, rings: OJZ_Sec0_Rings,
            type_table: OJZ_Sec0_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec0_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC0_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec1_Blocks,
            objects: OJZ_Sec1_Objects, rings: OJZ_Sec1_Rings,
            type_table: OJZ_Sec1_TypeTable,
            pal: OJZ_Palette,
            // Effects P1 gate: section 1 carries the raster program (S/H + backdrop
            // split below screen line 120). Scroll right from spawn to reach it.
            raster: OJZ_TestRaster,
            dict: extern("OJZ_Sec1_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC1_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec2_Blocks,
            objects: OJZ_Sec2_Objects, rings: OJZ_Sec2_Rings,
            type_table: OJZ_Sec2_TypeTable,
            // Effects P1 gate: section 2 proves sec_pal on its own — crossing in must
            // snap the palette, crossing back out must restore it.
            pal: OJZ_TestPal,
            dict: extern("OJZ_Sec2_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC2_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec3_Blocks,
            objects: OJZ_Sec3_Objects, rings: OJZ_Sec3_Rings,
            type_table: OJZ_Sec3_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec3_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC3_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec4_Blocks,
            objects: OJZ_Sec4_Objects, rings: OJZ_Sec4_Rings,
            type_table: OJZ_Sec4_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec4_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC4_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec5_Blocks,
            objects: OJZ_Sec5_Objects, rings: OJZ_Sec5_Rings,
            type_table: OJZ_Sec5_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec5_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC5_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec6_Blocks,
            objects: OJZ_Sec6_Objects, rings: OJZ_Sec6_Rings,
            type_table: OJZ_Sec6_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec6_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC6_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec7_Blocks,
            objects: OJZ_Sec7_Objects, rings: OJZ_Sec7_Rings,
            type_table: OJZ_Sec7_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec7_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC7_BLOCK_DICT_LEN),
    ojz_sec(blocks: OJZ_Sec8_Blocks,
            objects: OJZ_Sec8_Objects, rings: OJZ_Sec8_Rings,
            type_table: OJZ_Sec8_TypeTable,
            pal: OJZ_Palette,
            dict: extern("OJZ_Sec8_Blocks") + extern("BLOCK_INDEX_SIZE"),
            dict_len: OJZ_SEC8_BLOCK_DICT_LEN),
]
// the [Sec; 9] length IS the table-size check; tie the literal to the grid
ensure(GRID_W * GRID_H == 9, "the [Sec; 9] table must match grid_w*grid_h")
