// Tails character data — the sprite trio the shared player frame reads out of a
// CharacterDef, mirroring the Sonic trio in collision_data.emp: mappings +
// optimized DPLC + contiguous art, per set.
//
// TWO sets, because Tails is TWO simultaneously-resident sprites: the BODY
// (`Map_Tails` / `DPLC_Tails` / `Art_Tails`) and the twin-tail APPENDAGE
// (`Map_TailsAppendage` / …), which S3K renders as its own object with its own
// DPLC stream. They stay separate tables rather than one merged set because each
// is animated and DMA'd independently — the appendage's script runs at its own
// rate and it lands in its own VRAM window (VRAM_TAILS_APPENDAGE).
//
// PROVENANCE: stock Sonic 3 & Knuckles, extracted and converted to Aeon's sprite
// formats by games/sonic4/data/characters_staging/gen_characters.py (that
// directory's README carries the exact skdisasm sources). The two BUILD-CONSUMED
// derived blobs per set (contiguous art + one-entry-per-frame DPLC split to <=16
// tiles) are reproducible from the raw pair by the repo's own
// tools/dplc_layout.py — verified byte-identical, so the staging generator is a
// convenience, not a second source of truth.
//
// NOTHING CONSUMES THIS YET. Tails becomes playable when the roster row
// (CharacterDefs, player/characters.emp) stops pointing CHAR_TAILS at the Sonic
// record; this lands the data half only, so the ROM still runs as Sonic.
module games.sonic4.tails_data in tails_data

// The two VRAM windows this file's art lands in, each with its DECLARED extent —
// the budget the peak guards below are stated against. Sole authority is
// games.sonic4.constants, whose vram-map block emits both halves of each pair
// (base + _TILES) from games/sonic4/vram.toml.
use games.sonic4.constants.{VRAM_TEST_SONIC, VRAM_TEST_SONIC_TILES,
                            VRAM_TAILS_APPENDAGE, VRAM_TAILS_APPENDAGE_TILES}
use engine.constants.{TILE_SIZE, DMA_IMPORTANT_SLOTS}
use engine.objects.dplc.{dplc_peak_tiles, dplc_peak_entries, DPLC_ENTRY_RESERVE,
                         DPLC_ADDRESSABLE_TILES}

// ---- body ----
const _map_tails  = embed("games/sonic4/data/mappings/tails.bin")
const _dplc_tails = embed("games/sonic4/data/dplc/optimized/tails.bin")
const _art_tails  = embed("art/optimized/characters/tails.bin")

// ---- twin-tail appendage ----
const _map_tail   = embed("games/sonic4/data/mappings/tails_tail.bin")
const _dplc_tail  = embed("games/sonic4/data/dplc/optimized/tails_tail.bin")
const _art_tail   = embed("art/optimized/characters/tails_tail.bin")

// The Map_/DPLC_ frame indices are signed word-offset tables (AnimateSprite and
// Perform_DPLC both index them as `frame*2` into a word table of offsets FROM the
// table head), so each blob must fit the signed range — the same comptime wall
// collision_data.emp puts on the Sonic pair.
ensure(_map_tails.len <= $7FFF, "Map_Tails exceeds signed word-offset range")
ensure(_dplc_tails.len <= $7FFF, "DPLC_Tails exceeds signed word-offset range")
ensure(_map_tail.len <= $7FFF, "Map_TailsAppendage exceeds signed word-offset range")
ensure(_dplc_tail.len <= $7FFF, "DPLC_TailsAppendage exceeds signed word-offset range")

// Every blob is even-length, so the labels stay word-aligned with no inter-blob
// padding — the property collision_data.emp states in its header, stated as a
// checked fact here because six blobs is enough for one odd length to hide in.
ensure((_map_tails.len & 1) == 0 && (_dplc_tails.len & 1) == 0 && (_art_tails.len & 1) == 0,
       "a Tails body blob is odd-length — the label after it would land on an odd address")
ensure((_map_tail.len & 1) == 0 && (_dplc_tail.len & 1) == 0 && (_art_tail.len & 1) == 0,
       "a Tails appendage blob is odd-length — the label after it would land on an odd address")

// Art is whole 32-byte tiles by construction (uncompressed 4bpp); a truncated
// embed would otherwise surface only as garbage in a frame's last DMA.
ensure((_art_tails.len % TILE_SIZE) == 0, "Art_Tails is not a whole number of tiles")
ensure((_art_tail.len % TILE_SIZE) == 0, "Art_TailsAppendage is not a whole number of tiles")

// THE 12-BIT tile_start CEILING, one per sheet. A DPLC entry names a tile by INDEX
// into its sheet in a 12-bit field, so a sheet above DPLC_ADDRESSABLE_TILES has
// tiles no entry can reach and the generator wraps into the low indices SILENTLY.
// The shipped table cannot testify to that (its stored field is 12 bits wide and
// therefore always in range) — the sheet size is the checkable precondition. See
// the constants block in engine/objects/dplc.emp.
// Measured: body 3,635 tiles (461 of headroom), appendage 278 (3,818). The body is
// the second-tightest sheet in the tree after Knuckles — Sonic sits at 3,046.
ensure(_art_tails.len / TILE_SIZE <= DPLC_ADDRESSABLE_TILES,
       "Art_Tails is {_art_tails.len / TILE_SIZE} tiles; a DPLC entry's tile_start can only name 0..{DPLC_ADDRESSABLE_TILES - 1}, so the tiles above that would be addressed by a WRAPPED index and load early-frame art — re-page or shrink the sheet, do not raise the field")
ensure(_art_tail.len / TILE_SIZE <= DPLC_ADDRESSABLE_TILES,
       "Art_TailsAppendage is {_art_tail.len / TILE_SIZE} tiles; a DPLC entry's tile_start can only name 0..{DPLC_ADDRESSABLE_TILES - 1}, so the tiles above that would be addressed by a WRAPPED index and load early-frame art — re-page or shrink the sheet, do not raise the field")

// -----------------------------------------------
// THE VRAM WALLS — the peak comes from the DATA, the ceiling from the MAP.
//
// Body: Tails shares the character DPLC window with Sonic (only one character is
// resident at a time), so his file-wide peak has to clear the same wall Sonic's
// does. Measured 24 tiles into a 32-tile window — the slack is real, but the
// point of the guard is that a re-exported sheet which grew past it fails the
// build instead of DMA'ing over whatever follows the window.
//
// Appendage: its own window, VRAM_TAILS_APPENDAGE.
//
// ⚠ WHAT THESE GUARDS USED TO SAY, AND WHY IT WAS WRONG (LS-4, fixed 2026-09-07).
// They read a NEIGHBOUR's base as the ceiling — VRAM_TEST_OBJ for the body,
// VRAM_HSCROLL_TABLE / TILE_SIZE for the appendage — under a comment claiming
// "both bounds are read from their owners … so moving either neighbour re-checks
// these automatically". That was false in the direction that matters. The
// appendage's ceiling was 1504 (the HScroll table) while its declared window ends
// at 1501, because `debug_bganim_tag` had since been allocated into 1501..1503:
// three tiles of PERMITTED overrun, latent only because the appendage is not yet
// live. The neighbour was not even in this module's import closure, which is
// precisely why the guard reached for a name that WAS.
//
// The ceiling is now the region's OWN declared extent. Adjacency between regions
// is not this file's problem — gen_vram_map.py enforces overlap and full 0..2047
// coverage, so a neighbour cannot take tiles from these windows without
// vram.toml's `tiles` for THIS region dropping, which lands here as a red build
// with nobody editing this file.
//
// THESE TWO GUARDS DO NOT COVER: the DMA queue-slot cost of a peak frame (the
// entries guard between them measures that, and neither sees the straddle split
// tools/dplc_straddle.py checks); the appendage being a SECOND resident consumer
// alongside the body in the same frame (only the entries guard spans both); nor
// whether the declared window is itself correctly placed (vram.toml's own
// checks). The body guard covers ONE of the three characters sharing
// VRAM_TEST_SONIC — collision_data.emp and knuckles_data.emp carry the others.
// -----------------------------------------------
ensure(dplc_peak_tiles(_dplc_tails) <= VRAM_TEST_SONIC_TILES,
       "Tails' peak DPLC frame is {dplc_peak_tiles(_dplc_tails)} tiles and overruns the {VRAM_TEST_SONIC_TILES}-tile character VRAM window — re-page the art, or grow `character_window` in games/sonic4/vram.toml (raise `tiles`, hold `base`) and regenerate. DOES NOT COVER: the queue-slot cost of that frame (the entries guard below), the straddle split neither ensure can see, nor Sonic and Knuckles, who share this window and carry their own copies in collision_data.emp and knuckles_data.emp — a fix here fixes ONE of three")
// Entries are Important queue SLOTS (one enqueue each) — the budget
// dplc_peak_tiles does NOT measure. Tails' body peaks at 2 and the appendage at
// 1, both far inside the bound, so these are true guards. Note the appendage is
// a SECOND simultaneously-resident DPLC consumer, so its cost adds to the body's
// in the same frame.
ensure(dplc_peak_entries(_dplc_tails) + dplc_peak_entries(_dplc_tail) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS,
       "Tails' body + appendage peak DPLC frames together cost more Important queue slots than the budget leaves — re-page the art or raise DMA_IMPORTANT_SLOTS")

ensure(dplc_peak_tiles(_dplc_tail) <= VRAM_TAILS_APPENDAGE_TILES,
       "the Tails appendage's peak DPLC frame is {dplc_peak_tiles(_dplc_tail)} tiles and overruns its {VRAM_TAILS_APPENDAGE_TILES}-tile window — re-page the art, or grow `tails_appendage` in games/sonic4/vram.toml and regenerate (the tiles above it belong to `debug_bganim_tag`, so growing needs a placement decision, not just a bigger number). DOES NOT COVER: the queue-slot cost of that frame (the entries guard above, which is the only one spanning body + appendage together), nor whether the window is correctly placed")

pub data Map_Tails             = _map_tails
pub data DPLC_Tails            = _dplc_tails
pub data Art_Tails             = _art_tails
pub data Map_TailsAppendage    = _map_tail
pub data DPLC_TailsAppendage   = _dplc_tail
pub data Art_TailsAppendage    = _art_tail
