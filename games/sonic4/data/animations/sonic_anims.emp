// Sonic animation scripts — the offsets table IS the animation index,
// ordered by the shared ANIM_* ids (games/sonic4/config/constants.emp).
// Walk/Run/Roll use DUR_DYNAMIC: AnimateSprite takes the hold from d3,
// which Player_Animate computes from ground speed (speed-scaled timing).
//
// The ordinals ARE the ids: Ani_Sonic.Walk == ANIM_WALK by declaration
// position, and the drift guards below prove the hand-synced pairing
// stays synced — the `.count` guard checks the entry count, and the span
// guard is subsumed by the construct's link-time range check on every
// table word.
module games.sonic4.sonic_anims in sonic_anims

// Animation command bytes + DUR_DYNAMIC come from engine.constants (via the
// `use` below).
use engine.constants.{AF_END, AF_BACK, DUR_DYNAMIC}

// rep(frame, n) — n copies of `frame`, for splicing HELD POSES into a
// script while keeping the per-animation duration format:
//
//     Attack: [u8; 9] = [5, 1] ++ rep(2, 4) ++ [3, 4, AF_END]
//                        └ frame 2 held 4× as long as the others ┘
//
// A held pose is its frame repeated — `duration = 1` plus repeats gives
// exact per-tick control when needed. If repetition byte-costs ever bite,
// the answer is an AF_DURATION control code (change the hold mid-script),
// not a second interpreter. Unused today (every current script is
// uniform-timed); probe-tested in sonic_anims_port.rs so the idiom stays
// one grep away.
comptime fn rep(frame: int, n: int) {
    return 0..n |> map(|_i| frame)
}

offsets Ani_Sonic {
    // Declaration position IS the ANIM_* id (guards below), and each body rides
    // INLINE with no inter-body `align 2` pads (AnimateSprite reads scripts
    // BYTE-wise; only the table needs evenness), so the bodies pack.
    Walk:     [u8; 10] = [DUR_DYNAMIC, 7, 8, 1, 2, 3, 4, 5, 6, AF_END],
    Run:      [u8; 6]  = [DUR_DYNAMIC, $21, $22, $23, $24, AF_END],
    Roll:     [u8; 10] = [DUR_DYNAMIC, $96, $97, $96, $98, $96, $99, $96, $9A, AF_END],
    Spindash: [u8; 12] = [0, $86, $87, $86, $88, $86, $89, $86, $8A, $86, $8B, AF_END],
                                            // duration 0: advance every frame (fast rev)
    Push:     [u8; 6]  = [6, $B6, $B7, $B8, $B9, AF_END],
    Wait:     [u8; 19] = [7,                // neutral stand
        $BA, $BA, $BA, $BA, $BA, $BA, $BA, $BA,
        $BB, $BC, $BD,                      // lean into foot-tap
        $BE, $BF, $C0, $BF, $BE,            // tap loop body
        AF_BACK, 5],                        // loop the tap (5 frames back)
    Balance:  [u8; 5]  = [9, $A4, $A5, $A6, AF_END],
    LookUp:   [u8; 5]  = [5, $C3, $C4, AF_BACK, 1],   // hold last frame
    Duck:     [u8; 5]  = [5, $9B, $9C, AF_BACK, 1],   // hold last frame
    Skid:     [u8; 7]  = [3, $9D, $9E, $9F, $A0, AF_BACK, 1],  // hold the braced pose
    GetUp:    [u8; 3]  = [8, $8F, AF_END],

    // ANIM_FLY / ANIM_FLY_TIRED — Sonic cannot fly. The ANIM contract is "every
    // character's table has a row for every id", not "every character can reach
    // every id", so these rows exist to keep the table total and are UNREACHABLE
    // for him: Player_Animate only writes them from its PSTATE_FLY branch, and
    // only Tails' cd_ability can enter that state.
    //
    // The fallback is his WALK cycle, byte-for-byte. That is the deliberate
    // choice over a cheaper one-frame hold: if a future bug ever did land Sonic
    // on one of these ids, walk/run is exactly what the classifier picks for an
    // uncurled airborne Sonic today, so the pose would be indistinguishable from
    // correct rather than a frozen frame that reads as a crash. Repeated rather
    // than aliased — the `offsets` construct has no alias form, and the
    // Ani_TailsAppendage rows already set the precedent of repeating a shared
    // body at 3-10 bytes rather than adding an indirection.
    Fly:      [u8; 10] = [DUR_DYNAMIC, 7, 8, 1, 2, 3, 4, 5, 6, AF_END],
    FlyTired: [u8; 10] = [DUR_DYNAMIC, 7, 8, 1, 2, 3, 4, 5, 6, AF_END],
}
// keeps the NEXT table (Ani_Particle, word-read) even — inert today
// (the packed total is even) but guards body edits.
align 2

// The ordinal pairing as checked facts, not comments.
ensure(Ani_Sonic.Walk == extern("ANIM_WALK"), "Walk ordinal drifted from ANIM_WALK")
ensure(Ani_Sonic.Run == extern("ANIM_RUN"), "Run ordinal drifted from ANIM_RUN")
ensure(Ani_Sonic.Roll == extern("ANIM_ROLL"), "Roll ordinal drifted from ANIM_ROLL")
ensure(Ani_Sonic.Spindash == extern("ANIM_SPINDASH"), "Spindash ordinal drifted from ANIM_SPINDASH")
ensure(Ani_Sonic.Push == extern("ANIM_PUSH"), "Push ordinal drifted from ANIM_PUSH")
ensure(Ani_Sonic.Wait == extern("ANIM_IDLE"), "Wait ordinal drifted from ANIM_IDLE")
ensure(Ani_Sonic.Balance == extern("ANIM_BALANCE"), "Balance ordinal drifted from ANIM_BALANCE")
ensure(Ani_Sonic.LookUp == extern("ANIM_LOOKUP"), "LookUp ordinal drifted from ANIM_LOOKUP")
ensure(Ani_Sonic.Duck == extern("ANIM_DUCK"), "Duck ordinal drifted from ANIM_DUCK")
ensure(Ani_Sonic.Skid == extern("ANIM_SKID"), "Skid ordinal drifted from ANIM_SKID")
ensure(Ani_Sonic.GetUp == extern("ANIM_GETUP"), "GetUp ordinal drifted from ANIM_GETUP")
ensure(Ani_Sonic.Fly == extern("ANIM_FLY"), "Fly ordinal drifted from ANIM_FLY")
ensure(Ani_Sonic.FlyTired == extern("ANIM_FLY_TIRED"), "FlyTired ordinal drifted from ANIM_FLY_TIRED")
ensure(Ani_Sonic.count == extern("ANIM_COUNT"), "Ani_Sonic entry count drifted from ANIM_COUNT")
