// OJZ / global collision + Sonic character data (§4.7 — shared across all zones),
// natively placed at the `collision_data` section. Every blob is even-length, so
// the labels stay word-aligned with no inter-blob padding. Boundary key HeightMaps.
module games.sonic4.collision_data in collision_data

// The character DPLC window + its hard wall (games.sonic4.constants) and the
// comptime DPLC parser that measures a table's worst frame (engine.objects.dplc).
use games.sonic4.constants.{VRAM_TEST_SONIC, VRAM_TEST_OBJ}
use engine.constants.{TILE_SIZE, DMA_IMPORTANT_SLOTS}
use engine.objects.dplc.{dplc_peak_tiles, dplc_peak_entries, DPLC_ADDRESSABLE_TILES,
                         DPLC_ENTRY_RESERVE}

const _heightmaps     = embed("games/sonic4/data/collision/heightmaps.bin")
const _heightmaps_rot = embed("games/sonic4/data/collision/heightmaps_rot.bin")
const _angles         = embed("games/sonic4/data/collision/angles.bin")
const _solidity       = embed("games/sonic4/data/collision/solidity.bin")
const _map_sonic      = embed("games/sonic4/data/mappings/sonic.bin")
const _dplc_sonic     = embed("games/sonic4/data/dplc/optimized/sonic.bin")
const _art_sonic      = embed("art/optimized/characters/sonic.bin")

// The Map_Sonic / DPLC_Sonic frame indices are signed word-offset tables — the
// blob must fit the signed range (was the AS `if (*-Map_Sonic) > $7FFF / error`
// walls; now comptime facts).
ensure(_map_sonic.len <= $7FFF, "Map_Sonic exceeds signed word-offset range")
ensure(_dplc_sonic.len <= $7FFF, "DPLC_Sonic exceeds signed word-offset range")

// THE 12-BIT tile_start CEILING. A DPLC entry names a tile by INDEX into the sheet
// below, in a 12-bit field, so a sheet with more than DPLC_ADDRESSABLE_TILES tiles
// has tiles no entry can reach — and the generator that tries wraps into the low
// indices SILENTLY (see the long note at the constants in engine/objects/dplc.emp
// for why the shipped table cannot testify to this and the art sheet has to).
// Measured after the d-47 entry re-cut: 3,158 tiles, 938 (30,016 B) of headroom
// (it was 3,046 / 1,050 before the re-cut appended 112 tiles) — still the roomiest
// of the three characters by two orders of magnitude, and Knuckles at 4 tiles is
// the one that actually binds.
ensure(_art_sonic.len / TILE_SIZE <= DPLC_ADDRESSABLE_TILES,
       "Art_Sonic is {_art_sonic.len / TILE_SIZE} tiles; a DPLC entry's tile_start can only name 0..{DPLC_ADDRESSABLE_TILES - 1}, so the tiles above that would be addressed by a WRAPPED index and load early-frame art — re-page or shrink the sheet, do not raise the field")

// Sonic's worst frame must fit the character VRAM window (960 up to the
// VRAM_TEST_OBJ wall at 992). Measured 29 tiles, ending 989 — three to spare.
// This used to be the comment "up to 25 tiles" in four files, which was both
// wrong and unchecked; the number now comes from the blob and the wall from its
// owner, so an art re-export that grew fails the build instead of DMA'ing over
// the test-object art.
ensure(VRAM_TEST_SONIC + dplc_peak_tiles(_dplc_sonic) <= VRAM_TEST_OBJ,
       "Sonic's peak DPLC frame overruns the character VRAM window into VRAM_TEST_OBJ — widen the window or re-page the art")

// -----------------------------------------------
// THE ENTRY-COUNT BUDGET — the real assert, no longer a ratchet (d-47 `targeted`,
// closed by parcel/dplc-entry-recut).
//
// Entries are queue slots (one QueueDMA_Important enqueue each), a different
// quantity from the tiles guarded above. The bound is the one the sibling
// characters have always asserted (tails_data.emp, knuckles_data.emp):
//
//     dplc_peak_entries(_dplc_sonic) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS
//         i.e.  10 + 2 <= 12                                       -- TRUE, exactly
//
// This used to be a RATCHET pinned at 13 because the shipped sheet was OVER the
// budget and asserting the truth would have failed the build. What that debt was,
// so the shape of the fix is legible:
//   - frames $C1 and $C8 carried 13 entries. At 13 the drop is PERMANENT, not
//     one frame: perform_dplc enqueues 12, the 13th returns carry-set, and the
//     `bcs .done` bails BEFORE committing prev_frame, so every later frame
//     re-enqueues all 12 and drops the 13th forever. Neither was script-reachable,
//     which is the only reason it never shipped as a visible bug.
//   - $C4 (LookUp, held for as long as UP is held) and $0E (the second frame of
//     WALK TILT BLOCK 1, reachable during ordinary running since Player_ApplyTilt
//     shipped) both sat at 12 — the WHOLE queue. On either, the Important queue is
//     100% player and PageIn_EnqueueLanding is deterministically dropped: a
//     streaming stall, on $0E while the level is streaming.
//
// HOW IT WAS CLOSED, because the method is the reusable part. Dedup
// (tools/dedup_art.py, which IS the producer of the two blobs above — proven by
// byte-identical regeneration) trades ENTRIES for BYTES: a frame assembled from
// many scattered pool runs is cheap in ROM and expensive in the queue. The re-cut
// gives that trade back on the SIX frames over the wall and on no others
// ($0E, $BE, $BF, $C1, $C4, $C8), appending each one's tiles to the pool as a
// fresh contiguous run so it becomes ceil(tiles/16) entries. Because the run is
// APPENDED, no pool index moves and no other frame can change; because the tiles
// are byte-copies, every frame still loads identical bytes into VRAM (the tool
// proves that per frame, and it is why the mappings needed no change).
//
// Price, re-derived from the shipped blobs: 112 tiles, art 97,472 -> 101,056 B
// (+3,584), DPLC 2,368 -> 2,244 B (-124), +3,460 B net. Peak entries 13 -> 10,
// peak SLOTS 13 -> 10.
//
// ⚠ ENTRIES ARE NOT SLOTS, AND THIS ensure CANNOT SEE THE DIFFERENCE. QueueDMA
// splits any transfer whose ROM source straddles a $20000 boundary into TWO queue
// entries, so a frame's true cost is `entries + straddles` — a LINK-TIME fact that
// depends on where Art_Sonic lands, which a comptime parser of the blob can never
// learn. tools/dplc_straddle.py --gate is what measures SLOTS; it runs on both
// sonic4 shapes in build.sh. Do not read a green build here as a slot guarantee.
// -----------------------------------------------
ensure(dplc_peak_entries(_dplc_sonic) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS,
       "DPLC_Sonic's peak DPLC frame costs more Important queue slots than the budget leaves — re-cut the art (tools/dedup_art.py --entry-cap), do not raise DMA_IMPORTANT_SLOTS")

pub data HeightMaps    = _heightmaps
pub data HeightMapsRot = _heightmaps_rot
pub data AngleTable    = _angles
pub data SolidityTable = _solidity
pub data Map_Sonic     = _map_sonic
pub data DPLC_Sonic    = _dplc_sonic
pub data Art_Sonic     = _art_sonic
