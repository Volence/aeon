// OJZ / global collision + Sonic character data (§4.7 — shared across all zones),
// natively placed at the `collision_data` section. Every blob is even-length, so
// the labels stay word-aligned with no inter-blob padding. Boundary key HeightMaps.
module games.sonic4.collision_data in collision_data

// The character DPLC window + its hard wall (games.sonic4.constants) and the
// comptime DPLC parser that measures a table's worst frame (engine.objects.dplc).
use games.sonic4.constants.{VRAM_TEST_SONIC, VRAM_TEST_OBJ}
use engine.objects.dplc.{dplc_peak_tiles, dplc_peak_entries}

const _heightmaps     = embed("games/sonic4/data/collision/heightmaps.bin")
const _heightmaps_rot = embed("games/sonic4/data/collision/heightmaps_rot.bin")
const _angles         = embed("games/sonic4/data/collision/angles.bin")
const _solidity       = embed("games/sonic4/data/collision/solidity.bin")
const _map_sonic      = embed("games/sonic4/data/mappings/sonic.bin")
const _dplc_sonic     = embed("games/sonic4/data/dplc/optimized/sonic.bin")
const _art_sonic      = embed("art/optimized/characters/sonic.bin")

// The Map_Sonic / DPLC_Sonic frame indices are signed word-offset tables — the
// blob must fit the signed range (was the AS `if (*-Map_Sonic) > $7FFF / error`
// walls; now comptime facts).
ensure(_map_sonic.len <= $7FFF, "Map_Sonic exceeds signed word-offset range")
ensure(_dplc_sonic.len <= $7FFF, "DPLC_Sonic exceeds signed word-offset range")

// Sonic's worst frame must fit the character VRAM window (960 up to the
// VRAM_TEST_OBJ wall at 992). Measured 29 tiles, ending 989 — three to spare.
// This used to be the comment "up to 25 tiles" in four files, which was both
// wrong and unchecked; the number now comes from the blob and the wall from its
// owner, so an art re-export that grew fails the build instead of DMA'ing over
// the test-object art.
ensure(VRAM_TEST_SONIC + dplc_peak_tiles(_dplc_sonic) <= VRAM_TEST_OBJ,
       "Sonic's peak DPLC frame overruns the character VRAM window into VRAM_TEST_OBJ — widen the window or re-page the art")

// -----------------------------------------------
// ENTRY-COUNT RATCHET — Sonic is over the Important-queue budget TODAY.
//
// Entries are queue slots (one QueueDMA_Important enqueue each), a different
// quantity from the tiles guarded above. The real bound is
//
//     dplc_peak_entries(_dplc_sonic) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS
//         i.e.  13 + 2 <= 12                                      -- FALSE
//
// so asserting it would fail the build. This is a RATCHET at the measured value
// instead: it pins the debt in source, keeps it from growing, and fails loudly
// the moment a re-export or a newly-scripted frame makes it worse.
//
// The debt, precisely:
//   - frames 193 ($C1) and 200 ($C8) carry 13 entries. Neither is referenced by
//     any Ani_Sonic script today, so neither is reachable — the only thing
//     keeping the permanent-drop failure off the table.
//   - TWO frames reach 12 entries — exactly DMA_IMPORTANT_SLOTS, zero margin. On
//     either, the Important queue is 100% player and the art-page landing is
//     dropped for that frame.
//       · 196 ($C4), held by LookUp (`[5, $C3, $C4, AF_BACK, 1]`) for as long as
//         UP is held. Reachable since the anim scripts landed.
//       · 14 ($0E), the second frame of WALK TILT BLOCK 1. Reachable since the
//         ground-angle tilt shipped (Player_ApplyTilt, player_common.emp) made
//         mapping frames $09-$20 and $25-$30 selectable during ordinary running.
//         It is also the sheet's TILE peak (29, tied with $1E) — the same frame
//         the VRAM guard above already measured, which is why that wall needed
//         no change.
//     The tilt is what makes this reachable WHILE THE LEVEL IS STREAMING rather
//     than only while the camera pans up, which is the part that got worse. It is
//     exactly one animation frame wide: measured over all 36 newly-reachable
//     frames the next-worst is 10, so nothing sits between 10 and the cap.
//     Measured, and re-measured on every build, by tools/test_sprite_tilt.py
//     (test_the_tilt_does_not_worsen_sonics_important_queue_peak), which pins the
//     set of tilted frames at the cap to exactly {$0E} so it cannot grow quietly.
//
// CLOSING IT means re-paging sonic.bin so no frame exceeds
// DMA_IMPORTANT_SLOTS - DPLC_ENTRY_RESERVE (10), then replacing this ratchet
// with the real assert above. Note the UNOPTIMIZED source is worse still (16),
// so the re-page has to be done on the optimizer's output.
// -----------------------------------------------
ensure(dplc_peak_entries(_dplc_sonic) <= 13,
       "DPLC_Sonic's peak entry count grew past the known 13 — it is ALREADY over the Important-queue budget (12 slots); re-page the art, do not raise this ratchet")

pub data HeightMaps    = _heightmaps
pub data HeightMapsRot = _heightmaps_rot
pub data AngleTable    = _angles
pub data SolidityTable = _solidity
pub data Map_Sonic     = _map_sonic
pub data DPLC_Sonic    = _dplc_sonic
pub data Art_Sonic     = _art_sonic
