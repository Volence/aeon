// OJZ / global collision + Sonic character data (§4.7 — shared across all zones),
// natively placed at the `collision_data` section. Every blob is even-length, so
// the labels stay word-aligned with no inter-blob padding — CHECKED for the three
// character blobs (the guard below), still only MEASURED for the five collision
// blobs (4096/4096/256/256/256 B, 2026-09-06), which nothing binds. Boundary key
// HeightMaps.
module games.sonic4.collision_data in collision_data

// The character DPLC window's DECLARED EXTENT (games.sonic4.constants, emitted
// from games/sonic4/vram.toml beside the base it belongs to) and the comptime
// DPLC parser that measures a table's worst frame (engine.objects.dplc).
use games.sonic4.constants.{VRAM_TEST_SONIC_TILES}
use engine.constants.{TILE_SIZE, DMA_IMPORTANT_SLOTS}
use engine.objects.dplc.{dplc_peak_tiles, dplc_peak_entries, DPLC_ADDRESSABLE_TILES,
                         DPLC_ENTRY_RESERVE, offset_table_frames,
                         empty_frame_mismatches}

const _heightmaps     = embed("games/sonic4/data/collision/heightmaps.bin")
const _heightmaps_rot = embed("games/sonic4/data/collision/heightmaps_rot.bin")
const _angles         = embed("games/sonic4/data/collision/angles.bin")
const _solidity       = embed("games/sonic4/data/collision/solidity.bin")
const _crossover      = embed("games/sonic4/data/collision/crossover.bin")
const _map_sonic      = embed("games/sonic4/data/mappings/sonic.bin")
const _dplc_sonic     = embed("games/sonic4/data/dplc/optimized/sonic.bin")
const _art_sonic      = embed("art/optimized/characters/sonic.bin")

// The Map_Sonic / DPLC_Sonic frame indices are signed word-offset tables — the
// blob must fit the signed range (was the AS `if (*-Map_Sonic) > $7FFF / error`
// walls; now comptime facts).
ensure(_map_sonic.len <= $7FFF, "Map_Sonic exceeds signed word-offset range")
ensure(_dplc_sonic.len <= $7FFF, "DPLC_Sonic exceeds signed word-offset range")

// -----------------------------------------------
// MAP <-> DPLC FRAME-COUNT BINDING (LS-9, 2026-09-07).
//
// ONE `mapping_frame` byte indexes both tables — Render_Sprites walks Map_Sonic
// with it and Perform_DPLC walks DPLC_Sonic with it — so the two must declare the
// same number of frames or the shorter one is read PAST ITS END: the "offset
// word" comes out of the next blob's bytes and is followed as a frame pointer.
// Until this parcel the insta-shield was the only asset in the tree with any of
// this, and Sonic — the default character, 224 frames, the largest pair — had
// none. The parsers are engine.objects.dplc's; nothing here is hand-typed.
// -----------------------------------------------
ensure(offset_table_frames(_map_sonic) == offset_table_frames(_dplc_sonic),
       "Map_Sonic declares {offset_table_frames(_map_sonic)} frames and DPLC_Sonic {offset_table_frames(_dplc_sonic)} — one mapping_frame byte indexes BOTH, so the shorter table is read past its end and a byte of the blob placed after it is taken as a frame offset. Re-export the PAIR (tools/dedup_art.py), never one half. DOES NOT COVER: whether either count matches what Ani_Sonic's frame bytes reach — AnimateSprite bounds no frame byte at all (engine/objects/animate.emp, LS-9a) — nor whether corresponding frames describe the same art")
ensure(empty_frame_mismatches(_map_sonic, _dplc_sonic,
                              offset_table_frames(_map_sonic)) == 0,
       "{empty_frame_mismatches(_map_sonic, _dplc_sonic, offset_table_frames(_map_sonic))} Sonic frame(s) disagree about being empty — a drawn frame whose DPLC loads nothing renders whatever the character window last held (the previous frame's art, so it reads as a stutter rather than as corruption), and a loaded frame that draws nothing spends Important queue slots on tiles no piece references. DOES NOT COVER: whether a NON-empty pair agrees on how MUCH (piece and entry counts are compared only against zero), nor the frame count (the guard above)")

// Every blob even-length, so the labels after them stay word-aligned with no
// inter-blob padding. This module's HEADER states that property as prose for all
// eight blobs it places, and tails_data.emp's own even-length guard cites THIS
// FILE as where it is stated — while nothing here checked it. Both siblings
// (tails_data.emp, knuckles_data.emp) have carried the checked form since their
// data landed; the default character was the one holding a comment.
//
// ⚠ WHAT THIS DOES NOT COVER: the three CHARACTER blobs only. The five collision
// blobs above (_heightmaps, _heightmaps_rot, _angles, _solidity, _crossover) sit
// in the same section and the same header sentence, and are NOT checked here —
// _solidity and _crossover are pinned to each other by the equal-length guard
// further down, which says nothing about parity, and the other three are pinned
// by nothing. Nor does it cover ALIGNMENT of the labels themselves: it checks that
// each blob preserves the parity it was handed, not that the first one starts even
// (that is the section's placement, a link-time fact this cannot see).
ensure((_map_sonic.len & 1) == 0 && (_dplc_sonic.len & 1) == 0 && (_art_sonic.len & 1) == 0,
       "a Sonic blob is odd-length — the label after it would land on an odd address")

// Art is whole 32-byte tiles by construction (uncompressed 4bpp); a truncated
// embed would otherwise surface only as garbage in a frame's last DMA. The
// sibling of the same guard on Art_Tails / Art_TailsAppendage / Art_Knuckles.
//
// ⚠ WHAT THIS DOES NOT COVER: that the tiles are the RIGHT ones, or that the
// sheet is as long as the DPLC's furthest reach. A sheet truncated by a whole
// multiple of TILE_SIZE passes this and every other guard in this file, and the
// frames whose runs fell off the end DMA whatever the link put after Art_Sonic.
ensure((_art_sonic.len % TILE_SIZE) == 0, "Art_Sonic is not a whole number of tiles")

// THE 12-BIT tile_start CEILING. A DPLC entry names a tile by INDEX into the sheet
// below, in a 12-bit field, so a sheet with more than DPLC_ADDRESSABLE_TILES tiles
// has tiles no entry can reach — and the generator that tries wraps into the low
// indices SILENTLY (see the long note at the constants in engine/objects/dplc.emp
// for why the shipped table cannot testify to this and the art sheet has to).
// Measured after the d-47 entry re-cut: 3,158 tiles, 938 (30,016 B) of headroom
// (it was 3,046 / 1,050 before the re-cut appended 112 tiles) — still the roomiest
// of the three characters by two orders of magnitude, and Knuckles at 4 tiles is
// the one that actually binds.
ensure(_art_sonic.len / TILE_SIZE <= DPLC_ADDRESSABLE_TILES,
       "Art_Sonic is {_art_sonic.len / TILE_SIZE} tiles; a DPLC entry's tile_start can only name 0..{DPLC_ADDRESSABLE_TILES - 1}, so the tiles above that would be addressed by a WRAPPED index and load early-frame art — re-page or shrink the sheet, do not raise the field")

// Sonic's worst frame must fit the character VRAM window's DECLARED extent
// (`character_window`, 32 tiles from 960). Measured 29 tiles — three to spare.
// This used to be the comment "up to 25 tiles" in four files, which was both
// wrong and unchecked; the number now comes from the blob and the ceiling from
// the declared map, so an art re-export that grew fails the build instead of
// DMA'ing over whatever follows the window.
//
// ⚠ THE CEILING USED TO BE TODAY'S NEIGHBOUR, NOT THE DECLARED WINDOW (LS-4,
// fixed 2026-09-07). This guard read VRAM_TEST_OBJ — the same number only because
// `test_obj` happens to be the region that follows. gen_vram_map.py now emits
// VRAM_TEST_SONIC_TILES beside VRAM_TEST_SONIC, so the ceiling is the window's own
// declaration and this guard names no other region at all. That also makes the
// 2026-09-06 sweep's C5-F6 3-tile reclaim CHECKED rather than silent: shrinking
// `character_window` to 29 lands here as a red build, in all three character
// modules, with nobody editing a guard.
ensure(dplc_peak_tiles(_dplc_sonic) <= VRAM_TEST_SONIC_TILES,
       "Sonic's peak DPLC frame is {dplc_peak_tiles(_dplc_sonic)} tiles and overruns the {VRAM_TEST_SONIC_TILES}-tile character VRAM window — re-page the art, or grow `character_window` in games/sonic4/vram.toml (raise `tiles`, hold `base`) and regenerate. THIS GUARD DOES NOT COVER: the queue-slot cost of that frame (entries, not tiles — the dplc_peak_entries guard below, and tools/dplc_straddle.py for the straddle split neither ensure can see); whether the window is correctly PLACED, which is vram.toml's own coverage/overlap checks; nor the sibling characters, who share this one window and carry their own copies of this guard in tails_data.emp and knuckles_data.emp — a fix here fixes ONE of three")

// -----------------------------------------------
// THE ENTRY-COUNT BUDGET — the real assert, no longer a ratchet (d-47 `targeted`,
// closed by parcel/dplc-entry-recut).
//
// Entries are queue slots (one QueueDMA_Important enqueue each), a different
// quantity from the tiles guarded above. The bound is the one the sibling
// characters have always asserted (tails_data.emp, knuckles_data.emp):
//
//     dplc_peak_entries(_dplc_sonic) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS
//         i.e.  10 + 2 <= 12                                       -- TRUE, exactly
//
// This used to be a RATCHET pinned at 13 because the shipped sheet was OVER the
// budget and asserting the truth would have failed the build. What that debt was,
// so the shape of the fix is legible:
//   - frames $C1 and $C8 carried 13 entries. At 13 the drop is PERMANENT, not
//     one frame: perform_dplc enqueues 12, the 13th returns carry-set, and the
//     `bcs .done` bails BEFORE committing prev_frame, so every later frame
//     re-enqueues all 12 and drops the 13th forever. Neither was script-reachable,
//     which is the only reason it never shipped as a visible bug.
//   - $C4 (LookUp, held for as long as UP is held) and $0E (the second frame of
//     WALK TILT BLOCK 1, reachable during ordinary running since Player_ApplyTilt
//     shipped) both sat at 12 — the WHOLE queue. On either, the Important queue is
//     100% player and PageIn_EnqueueLanding is deterministically dropped: a
//     streaming stall, on $0E while the level is streaming.
//
// HOW IT WAS CLOSED, because the method is the reusable part. Dedup
// (tools/dedup_art.py, which IS the producer of the two blobs above — proven by
// byte-identical regeneration) trades ENTRIES for BYTES: a frame assembled from
// many scattered pool runs is cheap in ROM and expensive in the queue. The re-cut
// gives that trade back on the SIX frames over the wall and on no others
// ($0E, $BE, $BF, $C1, $C4, $C8), appending each one's tiles to the pool as a
// fresh contiguous run so it becomes ceil(tiles/16) entries. Because the run is
// APPENDED, no pool index moves and no other frame can change; because the tiles
// are byte-copies, every frame still loads identical bytes into VRAM (the tool
// proves that per frame, and it is why the mappings needed no change).
//
// Price, re-derived from the shipped blobs: 112 tiles, art 97,472 -> 101,056 B
// (+3,584), DPLC 2,368 -> 2,244 B (-124), +3,460 B net. Peak entries 13 -> 10,
// peak SLOTS 13 -> 10.
//
// ⚠ ENTRIES ARE NOT SLOTS, AND THIS ensure CANNOT SEE THE DIFFERENCE. QueueDMA
// splits any transfer whose ROM source straddles a $20000 boundary into TWO queue
// entries, so a frame's true cost is `entries + straddles` — a LINK-TIME fact that
// depends on where Art_Sonic lands, which a comptime parser of the blob can never
// learn. tools/dplc_straddle.py --gate is what measures SLOTS; it runs on both
// sonic4 shapes in build.sh. Do not read a green build here as a slot guarantee.
// -----------------------------------------------
ensure(dplc_peak_entries(_dplc_sonic) + DPLC_ENTRY_RESERVE <= DMA_IMPORTANT_SLOTS,
       "DPLC_Sonic's peak DPLC frame costs more Important queue slots than the budget leaves — re-cut the art (tools/dedup_art.py --entry-cap), do not raise DMA_IMPORTANT_SLOTS")

// -----------------------------------------------
// THE LOOP CROSSOVER TABLE — docs/LOOP_CROSSOVER_ENCODING.md §5 rows 7/11.
//
// One byte per attr-set index: 0 XOVER_NONE, 1 XOVER_TO_A, 2 XOVER_TO_B. 3 is
// reserved and the BAKE refuses it (rule R1, tools/collision_pipeline.py
// bake_plane_cell), so it can never appear here.
//
// It is addressed by the SAME attr byte as SolidityTable — the crossover rides in
// the IDENTITY of the interned index rather than beside it, which is why adding
// the field cost no per-cell ROM and did not change the collision strip format.
// The two tables are therefore parallel by construction, and the guard below is
// the only thing that says so at build time: they are written by one loop in
// collision_pipeline.emit_tables, and a change that resized one and not the other
// would silently mis-address every marked cell.
//
// ⚠ NOTHING IN THE ENGINE READS THIS TABLE YET (§5 row 13 / §6 changes 2-5: the
// per-frame read site, the edge-trigger, and the write to Sst.layer). It is in
// the ROM so that an authored crossover is CARRIED rather than dropped — the
// defect this parcel closed was that painting one changed no byte anywhere, so
// every CRC gate downstream correctly reported that nothing had happened and
// could not tell "authored" from "never authored". A crossover now moves bytes.
// It does not yet move a player.
// -----------------------------------------------
ensure(_crossover.len == _solidity.len,
       "crossover.bin is {_crossover.len} B and solidity.bin is {_solidity.len} B — both are indexed by the SAME one-byte attr-set index, so a length that disagrees means one table is addressable where the other is not; fix tools/collision_pipeline.py emit_tables, do not pad the blob")

pub data HeightMaps    = _heightmaps
pub data HeightMapsRot = _heightmaps_rot
pub data AngleTable    = _angles
pub data SolidityTable = _solidity
pub data CrossoverTable = _crossover
pub data Map_Sonic     = _map_sonic
pub data DPLC_Sonic    = _dplc_sonic
pub data Art_Sonic     = _art_sonic
