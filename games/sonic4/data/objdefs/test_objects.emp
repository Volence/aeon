// Object definitions for test objects — v2 archetype templates.
// Ported from games/sonic4/data/objdefs/test_objects.asm (the AS `objdef`
// macro); the objdef() emitter (engine/objects/objdef.emp) builds each
// 26-byte record. Byte-identical to the macro (objdef_port byte gate).
//
// VRAM_TEST_OBJ / COLLISION_* below still carry ensure(extern) drift guards (D11):
// their real home is a DIFFERENT .asm that outlives the test_objects.asm byte-gate
// twin (config/constants.asm, engine/constants.asm).
module games.sonic4.data.objdefs.test_objects

use engine.objects.sst.{ObjDef}
use engine.objects.objdef.{objdef, vram_art}
use engine.types.{VramTile}
use engine.constants.{COLLISION_SOLID}

use games.sonic4.constants.{VRAM_TEST_OBJ}

// ObjDef_Enemy / ObjDef_Parent (and ENEMY_PATROL_SPEED) moved to
// object_test_state.emp at the objtest-gate parcel (2026-08-05): the DEBUG-only
// scene is their sole consumer. Static/Solid stay — the shipped OJZ entity data
// places both, so they are live PLAIN level content.

pub data ObjDef_Static: ObjDef = objdef(
    code: "TestStatic_Main", map: "Map_TestObj", art: vram_art(VRAM_TEST_OBJ))

pub data ObjDef_Solid: ObjDef = objdef(
    code: "TestSolid_Init", map: "Map_TestObj", art: vram_art(VRAM_TEST_OBJ),
    priority: 3, width: 16, height: 16, collision: COLLISION_SOLID)

