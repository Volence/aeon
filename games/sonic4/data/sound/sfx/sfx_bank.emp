// ===========================================================================
// data/sound/sfx/sfx_bank.emp — the SFX block DATA
// ===========================================================================
// The SFX block from `Sfx_33` through the id->blob table: the 15 core SFX blobs,
// their 15 FM-patch banks (four zero-length, PSG-only), and the sparse id->blob
// `SfxTable`, as ONE `table` construct. The block CONTENT is byte-identical in
// BOTH build shapes (no DEBUG members — the SFX set is the same plain and debug);
// only the block's BASE address shifts, because it sits AFTER the shape-dependent
// song tables (plain $5BB10 / debug $5D560). So this module needs NO `-D` define
// — see the harness PROVENANCE on any re-baseline for the per-shape map base.
//
// The win-tab (`sfx_blob_win_tab.emp`, the Z80 `phase 08000h` head BINCLUDE'd by
// `soundBankHead`) references the `SFX_WIN_*` equ layer below cross-module — one
// window pointer per blob, folded at the co-link from the `Sfx_NN` PART labels
// the `table` defines. The equ layer lives here, at the producer that owns the
// blob placement (the DAC `SND_*_PTR` mechanism).
//
// Placed at $5BB10 (plain) / $5D560 (debug): the sound_bank anchor + contiguous
// pack after the MT bank region, whose tail is 8-aligned by construction
// (dac_sample_tab.emp + mt_bank.emp comptime pads — the base MUST be ≡ 0 mod 8,
// see sfx_bank_blob.emp's wall). Re-pin via the harness PROVENANCE flow on any
// re-baseline.
//
// The `table` construct:
//   * one `table` row per SFX id (ascending, contiguous). Adding an SFX = one row.
//   * `item_align: 2` is a self-adjusting pad after every emitted part. The ODD
//     blobs (Sfx_3C 267 B, Sfx_B6 71 B, Sfx_42 25 B, Sfx_7E 25 B, Sfx_4C 53 B)
//     each fire one $00; every patch bank is
//     32/0 B (even) so its pad folds to nothing. Regen-safe: a future odd-length
//     blob re-pads automatically.
//   * `cell: *u8, key: $33..=$BB, hole: 0` is the sparse id->blob table,
//     SfxTable[id - $33] over [$33..$BB], 0 = unused id. `SfxTable` anchors to the
//     FIRST CELL (no header), so `Table[id - SFX_ID_BASE]` indexed reads are correct.
//   * `body: before` places the blob payload BEFORE the cell table (blobs then the
//     id->blob table) — written explicitly so the one byte-layout fact correctness
//     hangs on stays on the page.
//
// The load-bearing guards:
//   * no-straddle: the section's `bank: $8000` property (an always-on link assert).
//   * co-residency: the single `ensure(...)` below (spelled against the LABEL
//     `MovingTrucks_Bank_Start`, the bankid-label idiom — bare cross-seam equ reads
//     don't exist).
//   * table length: STRUCTURAL — the cell count derives from `key: $33..=$BB`
//     ($BB-$33+1 = 137 cells), and a key outside that range is a comptime error.
//     `SfxTable.len` is the derived cell-count fact.
//
// No `_End` labels: every cross-seam consumer reads a `Sfx_NN` label or a blob's
// `.len` (comptime), never an end-minus-start. The patch files' interior Count/len
// invariants are covered by the `.bin` twin verifier + ROM byte-identity.
// ===========================================================================

module data.sfx_bank

// The id contract — the SOLE AUTHORITY. DERIVED from the table rows: zero bytes,
// drift-proof from the SFX SET (a renumber that changes the row set changes these
// automatically). This module owns the SFX bank, so it owns the counts that index
// it. Exported (`pub`) so the build harvests them for the seam authority-eval (the
// resident SFX reader's SFX_ID_BASE / SFX_TABLE_LEN -D; the head co-link's
// SFX_TABLE_LEN carrier). No self-referential
// ensure(extern("SFX_*") == …): the derivation IS the truth, nothing external to
// cross-check. The one surviving guard that reads this contract is a CONSUMER's —
// sfx_blob_win_tab.emp's span guard (its 137-cell hand body vs SFX_TABLE_LEN).
pub const SFX_ID_BASE   = SfxTable.min_key   // $33
pub const SFX_COUNT     = SfxTable.count     // 15
pub const SFX_TABLE_LEN = SfxTable.len       // 137  (max_id - min_id + 1)

// ONE `bank: $8000` section — the bank alignment + the always-on no-straddle
// link assert.
section sfx_bank (cpu: m68000, bank: $8000) {
    // 15 SFX: one row per id. Payload (blob, pad, patches, pad) emits first
    // (body: before), then the sparse id->blob cell table (137 cells, holes 0).
    // Blob order == id order == ascending key order (the ascending-key rule), so
    // the payload stream is deterministic.
    table SfxTable (cell: *u8, key: $33..=$BB, hole: 0, item_align: 2, body: before) {
        $33: Sfx_33 = embed("sfx_33.bin"), Sfx_33_Patches = embed("sfx_33_patches.bin"),
        $34: Sfx_34 = embed("sfx_34.bin"), Sfx_34_Patches = embed("sfx_34_patches.bin"),
        $35: Sfx_35 = embed("sfx_35.bin"), Sfx_35_Patches = embed("sfx_35_patches.bin"),
        $36: Sfx_36 = embed("sfx_36.bin"), Sfx_36_Patches = embed("sfx_36_patches.bin"),
        $3C: Sfx_3C = embed("sfx_3C.bin"), Sfx_3C_Patches = embed("sfx_3C_patches.bin"),
        // $42/$4A/$4C/$7E — the Knuckles ability + insta-shield set (2026-08-26).
        // All four fall INSIDE the existing $33..$BB key range, so they fill holes
        // rather than extending it: SfxTable.len (and therefore SFX_TABLE_LEN and
        // SfxBlobWinTab's span) is unchanged at 137. $42 and $7E are PSG-only, so
        // their patch banks are zero-length like $33's.
        $42: Sfx_42 = embed("sfx_42.bin"), Sfx_42_Patches = embed("sfx_42_patches.bin"),
        $4A: Sfx_4A = embed("sfx_4A.bin"), Sfx_4A_Patches = embed("sfx_4A_patches.bin"),
        $4C: Sfx_4C = embed("sfx_4C.bin"), Sfx_4C_Patches = embed("sfx_4C_patches.bin"),
        $62: Sfx_62 = embed("sfx_62.bin"), Sfx_62_Patches = embed("sfx_62_patches.bin"),
        $7E: Sfx_7E = embed("sfx_7E.bin"), Sfx_7E_Patches = embed("sfx_7E_patches.bin"),
        $AB: Sfx_AB = embed("sfx_AB.bin"), Sfx_AB_Patches = embed("sfx_AB_patches.bin"),
        $B6: Sfx_B6 = embed("sfx_B6.bin"), Sfx_B6_Patches = embed("sfx_B6_patches.bin"),
        $B9: Sfx_B9 = embed("sfx_B9.bin"), Sfx_B9_Patches = embed("sfx_B9_patches.bin"),
        // $BA/$BB extend the key range past its previous $B9 ceiling — the first
        // time the SFX set has grown at its top end rather than filled a hole.
        // They are kept at their S3K ids rather than moved down into the 126 free
        // slots below because the id IS the S3K source filename (see the note at
        // the head of sound_ids.emp); relocating them would buy two spare cells
        // and plant a collision for whenever the real $37/$38 are imported.
        // $BB carries no voice bank of its own in S3K — it names Sound_BA_BB_Voices,
        // which lives in $BA's file — so the transcoder appends $BA's data section
        // when packing it. Each still gets its own 32-byte patch bank here.
        $BA: Sfx_BA = embed("sfx_BA.bin"), Sfx_BA_Patches = embed("sfx_BA_patches.bin"),
        $BB: Sfx_BB = embed("sfx_BB.bin"), Sfx_BB_Patches = embed("sfx_BB_patches.bin"),
    }
}

// The id->blob window-pointer layer the banked head table (sfx_blob_win_tab.emp)
// consumes cross-module — one SFX_WIN_NN per blob, each the $8000-window pointer
// of its Sfx_NN part label (winptr(L) = (L & $7FFF) | $8000, the old
// boot_data.asm sfx_winptr() function folded at LINK from the placed address).
// The head references these equs by name (the DAC SND_*_PTR mechanism); the
// values live ONCE here, at the producer that owns the blob placement, so a
// re-base of the SFX block re-folds every window pointer automatically.
equ SFX_WIN_33 = winptr(Sfx_33)
equ SFX_WIN_34 = winptr(Sfx_34)
equ SFX_WIN_35 = winptr(Sfx_35)
equ SFX_WIN_36 = winptr(Sfx_36)
equ SFX_WIN_3C = winptr(Sfx_3C)
equ SFX_WIN_42 = winptr(Sfx_42)
equ SFX_WIN_4A = winptr(Sfx_4A)
equ SFX_WIN_4C = winptr(Sfx_4C)
equ SFX_WIN_62 = winptr(Sfx_62)
equ SFX_WIN_7E = winptr(Sfx_7E)
equ SFX_WIN_AB = winptr(Sfx_AB)
equ SFX_WIN_B6 = winptr(Sfx_B6)
equ SFX_WIN_B9 = winptr(Sfx_B9)
equ SFX_WIN_BA = winptr(Sfx_BA)
equ SFX_WIN_BB = winptr(Sfx_BB)

// The engine-table-head co-residency rule — Sfx_Frame reads the FM-patch/pitch/
// opcode tables window-relative from the bank head, so the SFX blobs MUST share
// it. Spelled as `bankid(X) == bankid("MovingTrucks_Bank_Start")`
// rather than the equ name directly (bare cross-seam equ reads don't exist).
// `Sfx_33` is this module's own data label (a table part label), so it rides the
// bareword form; the cross-seam bank-start symbol keeps the string spelling.
ensure(bankid(Sfx_33) == bankid("MovingTrucks_Bank_Start"),
    "SFX blobs not co-located with the engine-table bank — Sfx_Frame's dispatch/table reads would see the wrong bank")
