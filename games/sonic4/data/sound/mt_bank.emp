// ===========================================================================
// data/sound/mt_bank.emp — the MT streaming-bank DATA (sound-migration T2)
// ===========================================================================
// This module carries the MT streaming-bank DATA: from `Song_MovingTrucks`
// ($58628) through `SongPatchTable_End`. The engine-table head (`soundBankHead`,
// the Z80 phase-0 blob at $58000..$58628, incl. `MovingTrucks_Bank_Start` and the
// `SND_ENGINE_TABLE_BANK` equ) precedes it; this module picks up right after it,
// in the SAME bank-aligned 32KB window.
//
// Shape input: `-D DEBUG=0|1`. Plain shape (DEBUG=0) carries only Moving Trucks
// (song id 1); DEBUG shape (DEBUG=1) additionally carries the DrumTest (id 2)
// and HCZ2 (id 3) DEBUG songs — both shapes emit the SAME data items, with the
// DEBUG-only ones' value
// folding to `Data.empty` (zero bytes, label still defined) when DEBUG=0.
//
// Placed at $58628: the map's sound_bank anchor ($58000) + contiguous pack
// after the soundBankHead. Re-pin via the harness PROVENANCE flow on any
// re-baseline.
//
// The invariants this bank enforces:
//   * No-straddle: the section's `bank: $8000` property is an always-on
//     no-straddle link assert (no hand `if`/`fatal` needed).
//   * Co-residency: every stream/patch bank must share the engine-table head's
//     bank, since the sequencer reads FM pitch/log-volume/opcode tables
//     window-relative from the bank head. The five
//     `ensure(bankid(...) == bankid("MovingTrucks_Bank_Start"), …)` asserts
//     below enforce it. They assert against the LABEL `MovingTrucks_Bank_Start`,
//     not the `SND_ENGINE_TABLE_BANK` equ: that equ is not a data/proc label and
//     is invisible outside a call argument (only a bareword used AS a call
//     argument becomes a deferred link symbol; a bare name as a plain `==`
//     operand hard-errors "unknown name" at comptime). Since
//     `SND_ENGINE_TABLE_BANK = MovingTrucks_Bank_Start >> 15` and
//     `MovingTrucks_Bank_Start` is bank-aligned, `bankid(MovingTrucks_Bank_Start)`
//     folds to EXACTLY the equ's value — `(L & $7F8000) >> 15 == L >> 15`
//     whenever L's low 15 bits are zero — so the label read is the proven
//     cross-seam idiom. COUPLING LOSS: if the equ is ever redefined to something
//     other than `MovingTrucks_Bank_Start >> 15`, the ensures keep asserting
//     against the label, not the equ's new intent (update them alongside any
//     such change).
//   * Pitch-contiguity: contiguous BY CONSTRUCTION (items in a section always
//     emit back-to-back, no auto-pad, §4.3) + `ensure(SongBlob.len ==
//     MT_PITCHTAB_OFFSET, …)` with the pinned const below.
//   * Table length: comptime `ensure`s (SONG_COUNT is itself a comptime
//     if-expression, so the check is structural: the array TYPE literally IS
//     `[*u8; SONG_COUNT]`, and a mismatched literal-element count is a clean
//     comptime error).
//   * Trailing pads: EXPLICIT self-adjusting pad items (`.emp` sections never
//     auto-pad, §4.3) — see the comments at each pad below for why they're
//     needed (or not).
//
// DELIBERATELY NOT PORTED: the `_End` labels (`Song_MovingTrucks_End`, etc.)
// and `MovingTrucks_Patches_End` / `Song_DrumTest_End` / `Song_HCZ2_End` /
// `HCZ2_Patches_End` / `SongTable_End` / `SongPatchTable_End` — every
// consumer here reads a blob's `.len` (comptime) or a table's element type
// width, never an end-minus-start; and `movingtrucks_pitchtable.emp` (the
// engine-DEFAULT pitch table, the banked head sigil lowers to
// movingtrucks_pitchtable.bin) — a separate module, not this module's concern.
//
// Re-pin note (PROVENANCE): all six blob lengths and the `$30B1` pitch-table
// offset are pinned against the aeon `e5b256c` + bg-restore re-baseline (the
// same pins T1's `dac_samples.emp` cites). A song regeneration must re-verify
// every `embed(...)` length here (the `MT_PITCHTAB_OFFSET` ensure below is the
// one CI-visible tripwire; the others are sanity-known but not individually
// pinned — see the length-guard note below).
// ===========================================================================

module data.mt_bank

use engine.types.{SongId}

// --- the six stream blobs (generated .bin). Bound to `const` first
// so each `.len` is a readable comptime int (the `data K = embed(...)`
// readability gate — the const both emits AND measures, dac_samples.emp
// precedent). ---
const SongBlob      = embed("song_movingtrucks.bin")              // 12465 B ($30B1)
const PitchBlob     = embed("movingtrucks_pitchtable_stream.bin") // 264 B ($108)
const PatchesBlob   = embed("movingtrucks_patches.bin")           // 800 B ($320)
const DrumTestBlob  = embed("song_drumtest.bin")                  // 82 B ($52)  (DEBUG member)
const Hcz2Blob      = embed("song_hcz2.bin")                      // 6511 B ($196F) (DEBUG member)
const Hcz2PatchBlob = embed("hcz2_patches.bin")                   // 128 B ($80)  (DEBUG member)

// Length-guard note: only the song's length is CI-pinned (via the
// MT_PITCHTAB_OFFSET ensure below, which is load-bearing — a wrong song
// length detunes the whole song). The other five blob lengths are NOT
// individually `ensure`d here: they're sanity-known (see the comments above)
// but pinning every one would just add regen churn with no guard they don't
// already get for free — the section's `bank: $8000` no-straddle assert
// catches any gross length blowup, and the byte-identity harness (Task 6)
// catches anything subtler.

// song ids — the TABLE ORDER below must keep entry[id-1] = that song
// (SongTable[id-1]/SongPatchTable[id-1], id 0 reserved = stop).
//
// Mirrors of the song ids (they document the id contract for
// readers of this file — only SONG_COUNT is actually consumed, in the
// SongTable/SongPatchTable declarations below; the byte-bearing coupling that
// matters is the TABLE ORDER at SongTable/SongPatchTable).
//
// The song-id authority is games.sonic4.sound_ids. These stay as
// LOCAL mirrors, drift-guarded against that authority via ensure(extern(...)):
// the focused seam-2 MT-bank emit lowers this module without a game module in
// scope, so SONG_COUNT must resolve comptime-locally here (it sizes SongTable/
// SongPatchTable below), and the SONG_* ids keep their TYPED SongId enforcement
// (the newtype can't ride a bare use yet — language-round deferral). Both resolve
// at link against the authority's harvested EquSym. SONG_DRUMTEST/SONG_HCZ2 stay
// documentation-only (never consumed here; a renumber is caught by the TABLE
// ORDER either way).
const SONG_MOVINGTRUCKS: SongId = 1
const SONG_DRUMTEST: SongId     = 2   // documentation const (typed mirror)
const SONG_HCZ2: SongId         = 3   // documentation const (typed mirror)
const SONG_COUNT = if DEBUG == 1 { 3 } else { 1 }   // a bound, not a song id — stays a raw count
ensure(extern("SONG_MOVINGTRUCKS") == SONG_MOVINGTRUCKS, "SONG_MOVINGTRUCKS drifted from games.sonic4.sound_ids: {SONG_MOVINGTRUCKS}")
ensure(extern("SONG_COUNT") == SONG_COUNT, "SONG_COUNT drifted from games.sonic4.sound_ids: {SONG_COUNT}")
ensure(SONG_COUNT < $FF, "SONG_COUNT must be < $FF ($FF is the stop sentinel)")

// The generator-baked header offset (song_movingtrucks header pitchtable_ptr
// = packed song length). Re-pin on song regeneration; this ensure is the detune
// guard — a mismatch means the header disagrees with the layout below (a pad byte
// between the song and the pitch table would shift every pitch lookup one byte
// early = the whole song plays a semitone flat).
const MT_PITCHTAB_OFFSET = $30B1
ensure(SongBlob.len == MT_PITCHTAB_OFFSET,
    "MT pitch table not contiguous with the song: song len != header's pitchtable_ptr — a pad byte would detune the whole song")

// --- SFX-base 8-alignment pad size (package 3 fix — see the _sfx_align_* items
// in the section below for the full story). The running length of everything
// this section emits BEFORE the two pointer tables, mirrored comptime: the
// three always-on blobs + the DEBUG members + their two self-adjusting odd-length
// align-2 pads ((len % 2) is exactly that conditional pad's size). The pad
// rounds it to ≡ 0 (mod 8); with the section base ≡ 0 (mod 8) (head padded to 8
// in dac_sample_tab.emp + the 8-aligned $58000 anchor) and the pointer tables
// 8*SONG_COUNT B (≡ 0 mod 8), the section END — the SFX block's base — is then
// ≡ 0 (mod 8) by construction, for any song regen or shape.
const _MT_DEBUG_EXTRA = if DEBUG == 1 { DrumTestBlob.len + (DrumTestBlob.len % 2) + Hcz2Blob.len + (Hcz2Blob.len % 2) + Hcz2PatchBlob.len } else { 0 }
const _MT_PRETABLE_LEN = SongBlob.len + PitchBlob.len + PatchesBlob.len + _MT_DEBUG_EXTRA
const MT_TAIL_PAD = (8 - (_MT_PRETABLE_LEN % 8)) % 8

// ONE bank: $8000 section = the .asm's `align $8000` (main.asm:129) + all
// four straddle/window-top fatals (song_table.asm:91/99/110/128). Items emit
// contiguously (§4.3 no-auto-pad) = the .asm's hand-maintained contiguity
// comments made structural — no pad exists between items unless written
// explicitly (the two HCZ2/DrumTest pads below are the ONLY such pads; every
// other adjacency in this section is genuinely zero-gap by construction,
// verified against the .asm: no OTHER member has a trailing `align`.
// song_table.asm's own trailing `align 2` — AFTER SongPatchTable_End — is
// deliberately dropped: a no-op at the current pins (both shapes' tails end
// even) and absorbed by main.asm's org-resume re-pin contract, which pins
// the post-bank resume address per shape anyway).
section mt_bank (cpu: m68000, bank: $8000) {
    data Song_MovingTrucks             = SongBlob
    data MovingTrucks_PitchTable_Stream = PitchBlob
    data MovingTrucks_Patches          = PatchesBlob

    data Song_DrumTest = if DEBUG == 1 { DrumTestBlob } else { Data.empty }

    // song_drumtest.asm's trailing `align 2` mirrored explicitly (.emp never
    // auto-pads, §4.3): DrumTestBlob is 82 bytes (EVEN) at the current
    // pins, so this is a NO-OP today — folds to `Data.empty` — but it's
    // written as a SELF-ADJUSTING conditional (not simply omitted) so a
    // future DrumTest regeneration that lands on an ODD length stays
    // regen-safe without a human having to notice and add a pad by hand.
    // Only fires (emits one $00) when DEBUG == 1 AND the blob is odd-length.
    data _drumtest_align = if DEBUG == 1 && DrumTestBlob.len % 2 == 1 { byte(0) } else { Data.empty }

    data Song_HCZ2     = if DEBUG == 1 { Hcz2Blob }     else { Data.empty }

    // song_hcz2.asm's trailing `align 2` mirrored explicitly — CRITICAL for
    // byte-identity here (unlike the DrumTest pad above): Hcz2Blob is 6511
    // bytes (ODD) at the current pins, so asl's `align 2` inserts ONE real
    // $00 pad byte before `HCZ2_Patches` (reference ROM byte at $5D4A1 is
    // $00 — verified against the fact base). `.emp` sections never
    // auto-pad (§4.3), so this pad must be emitted EXPLICITLY, spelled as
    // a self-adjusting conditional (not a bare `byte(0)`) so a future HCZ2
    // regeneration that lands on an EVEN length correctly emits ZERO pad
    // bytes instead of silently drifting one byte off from the reference.
    // Only fires (emits one $00) when DEBUG == 1 AND the blob is odd-length
    // — today that's true, so this DOES emit the pin-critical byte.
    data _hcz2_align = if DEBUG == 1 && Hcz2Blob.len % 2 == 1 { byte(0) } else { Data.empty }

    data HCZ2_Patches  = if DEBUG == 1 { Hcz2PatchBlob } else { Data.empty }

    // --- SFX-base 8-alignment (package 3 fix, 2026-08-10) ---
    // The NEXT region in the sound bank (the SFX block, sfx_bank_blob.emp) must
    // start ≡ 0 (mod 8): the placement chainer 8-aligns that section's base,
    // while seam-2's sound_layout fold packs contiguously WITHOUT that align —
    // at a misaligned tail the two models diverge and every SfxTable pointer
    // cell + SfxBlobWinTab window pointer comes out short of the placed blobs
    // (observed: -2 after the 12-byte DacSample head growth made the tail
    // ≡ 2 mod 4 and plain SFX went silent; a mod-4-only pad still came out -4,
    // pinning the chainer's quantum at EIGHT — old working bases $5BAE8/$5D558
    // ≡ 0 mod 8 exclude 16). This pad closes the gap STRUCTURALLY: it is
    // emitted bytes inside the seam-2-lowered module, so the fold and the
    // chainer both count it, and the COMPTIME size (0-7 B, from this module's
    // own blob lengths) self-adjusts under song regen or shape change. NOT a
    // source `align`: seam-2 lowers this module at a baseline-0 section base,
    // so `align`'s pad count is computed against the wrong address whenever
    // the placed base is misaligned — its D2.29 congruence assert catches
    // that loudly (how this was learned). Instead the base IS forced ≡ 0
    // (mod 8) upstream (the dac_sample_tab.emp head-tail pad rounds the
    // engine-table head to 8, and the sound_bank map anchor $58000 is
    // 8-aligned), which ALSO makes the baseline-0 comptime arithmetic here
    // exact. The pad sits BEFORE the two pointer tables so it lands in the
    // BODY split-bin (the SONG_COUNT*4 table-size walls stay exact); the
    // tables are 8*SONG_COUNT bytes (always ≡ 0 mod 8), so padding here
    // 8-aligns the section END too. Today: plain pads 7 ($34D9 -> $34E0),
    // debug pads 5 ($4F1B -> $4F20). Sigil-side fold/ensure fix tracked in
    // DEFERRED_WORK ("table-fold vs placement divergence at unaligned
    // bank-section base").
    data _sfx_align_a = if MT_TAIL_PAD >= 1 { byte(0) } else { Data.empty }
    data _sfx_align_b = if MT_TAIL_PAD >= 2 { byte(0) } else { Data.empty }
    data _sfx_align_c = if MT_TAIL_PAD >= 3 { byte(0) } else { Data.empty }
    data _sfx_align_d = if MT_TAIL_PAD >= 4 { byte(0) } else { Data.empty }
    data _sfx_align_e = if MT_TAIL_PAD >= 5 { byte(0) } else { Data.empty }
    data _sfx_align_f = if MT_TAIL_PAD >= 6 { byte(0) } else { Data.empty }
    data _sfx_align_g = if MT_TAIL_PAD >= 7 { byte(0) } else { Data.empty }

    // song id -> SongHeader ptr, indexed SongTable[id-1]; id 0 reserved = stop.
    data SongTable: [*u8; SONG_COUNT] = if DEBUG == 1 {
        ["Song_MovingTrucks", "Song_DrumTest", "Song_HCZ2"]
    } else {
        ["Song_MovingTrucks"]
    }
    // parallel per-song FM-patch-bank ptr (DrumTest reuses MT's bank)
    data SongPatchTable: [*u8; SONG_COUNT] = if DEBUG == 1 {
        ["MovingTrucks_Patches", "MovingTrucks_Patches", "HCZ2_Patches"]
    } else {
        ["MovingTrucks_Patches"]
    }
}

// The engine-table-head rule (the sequencer reads FM pitch/log-volume/opcode
// tables window-relative from the bank head): every stream/patch bank must
// share the head's bank. Spelled as `bankid(X) == bankid("MovingTrucks_Bank_Start")`
// rather than the .asm equ name directly — see the header comment's
// deviation note. UNCONDITIONAL (in the plain shape the DEBUG labels are
// zero-length but still placed in-bank, so `bankid()` folds identically —
// R4).
ensure(bankid(Song_MovingTrucks) == bankid("MovingTrucks_Bank_Start"),
    "Moving Trucks stream not co-located with the engine-table bank — window-relative table reads would see the wrong bank")
ensure(bankid(MovingTrucks_Patches) == bankid("MovingTrucks_Bank_Start"),
    "MT patch bank not co-located with the engine-table bank")
ensure(bankid(Song_DrumTest) == bankid("MovingTrucks_Bank_Start"),
    "Song_DrumTest (DEBUG) left Moving Trucks' bank — its stream/table reads need the engine-table head's bank")
ensure(bankid(Song_HCZ2) == bankid("MovingTrucks_Bank_Start"),
    "Song_HCZ2 (DEBUG) left Moving Trucks' bank — one SetBank must cover its stream + the engine-table head")
ensure(bankid(HCZ2_Patches) == bankid("MovingTrucks_Bank_Start"),
    "HCZ2 patch bank (DEBUG) left Moving Trucks' bank")
