// ===========================================================================
// data/sound/dac_samples.emp — ROM-resident DAC sample data (Phase 1B)
// ===========================================================================
// The canonical ROM-resident DAC sample data — the exemplar the sound migration
// copies. Raw 8-bit unsigned PCM (centered $80): the Z80 streams each
// blob through its $8000-$FFFF window, selected by the 9-bit bank latch at $6000.
//
// In the deleted .asm the Z80-window banking invariant was hand-maintained with three
// pieces of ceremony; here each collapses into the language:
//
//   1. `align $8000` before each bank — replaced by the section `bank: $8000`
//      property: the linker's placement pass bumps a bank-constrained section to
//      the next 32KB boundary IFF its content would straddle one, and an
//      always-on post-placement check re-verifies no `bank:` section crosses a
//      boundary. No `align`, no wasted-space directive.
//   2. the hand-written `if (start >> 15) <> ((end-1) >> 15) / fatal` straddle
//      guards — subsumed by that same always-on `bank: $8000` no-straddle assert.
//   3. per-sample `= (addr & $7F8000) >> 15` / `= (addr & $7FFF) | $8000` /
//      `= end - start` constants, hand-spelled with the raw mask/shift magic —
//      replaced by `bankid(L)` / `winptr(L)` (which fold to that same arithmetic
//      at LINK, once the placed address is known — the magic lives ONCE, in the
//      builtin) and the blob's comptime `.len`.
//
// Placement is HONEST: neither `bank:` section carries a `vma:` (a `bank:`
// section WITH `vma:` is now a compile error), so labels follow the PLACED LMA —
// VMA == LMA. `bankid()` folds to the real bank id because the bytes are GENUINELY
// in that bank, not because a `vma:` phase decoupled the label address from the
// physical placement.
//
// ⚠ NO ADDRESSES OR BANK IDS ARE WRITTEN HERE, DELIBERATELY (2026-08-29) — and note
// that the mechanism, not just the numbers, is what went stale. This header used to
// say the map REGIONS pinned `dac_blip_bank`/`dac_shared_bank` at fixed addresses.
// Both halves are dead: 4bc2d62f (2026-08-01) deleted those regions when the DAC
// banks went native — map.toml has named neither section since — and the 2026-08-26
// re-layout then moved the addresses too. Today these two sections are lowered by
// seam-2 to `dac_blip_bank.bin` / `dac_shared_bank.bin`, and
// `games/sonic4/data/sound/dac_banks.emp` embeds those blobs at the `dac_banks` map
// anchor. That anchor is DERIVED, not fixed: `games/sonic4/map.toml` (search
// `dac_banks  = align_up`) carries the rule and the measured result, and the build's
// `.lst` is the instrument for where the bytes actually landed. Re-typing today's
// values here would go stale on the identical clock that produced this note.
//
// The blobs bind to `const` first because a blob's `.len` is only a readable
// comptime int off a const binding (the `data K = embed(...)` readability gate);
// the const both emits AND measures.
//
// DELIBERATELY NOT PORTED (all had zero external consumers):
//   * the `Dac_*_End` labels and `Dac_SharedBank_Start` — every external ref is
//     an `SND_*` equ; lengths now come from `.len`, not an end-minus-start.
//   * the hand-written straddle `fatal`s — subsumed by `bank: $8000`'s
//     always-on no-straddle link assert.
//   * the `align $8000`s — subsumed by the pinned map regions + `bank: $8000`.
//
// CONSUMER: engine/sound/dac_sample_tab.emp reads the SND_* equs below at LINK
// (cross-module, co-linked) into its DacSample descriptors — the head is native
// too; build.sh BINCLUDEs the co-linked dac_sample_tab.bin. No AS reader remains.
// ===========================================================================

module data.dac_samples


// --- the eight sample blobs, bound to consts so each `.len` is a readable
// comptime int. `temp_blip.bin` lives in THIS module's directory; the seven
// drums under `dac/`. ---
//
// ⚠ EIGHT BLOBS, TEN SAMPLE IDS — the shared bank stores SEVEN distinct drums,
// not nine (LS-7, 2026-09-06). `dac/s3k_kick.pcm` was byte-identical to
// `dac/kick.pcm` (1406 B) and `dac/s3k_snare.pcm` byte-identical to
// `dac/snare.pcm` (3748 B) — the S3K DAC import (tools/import_s3k_dac.py) resamples
// $86/$81 to the same fixed engine rate at pitch_ratio 1.0 that produced the
// original two, so the two pairs come out the same bytes. Both duplicate .pcm
// files are DELETED and ids 5/6 now alias ids 2/3 through the SND_S3K_KICK_* /
// SND_S3K_SNARE_* triples below: no id churn, no Z80 change, no descriptor field
// changes except ds_ptr. That reclaimed 5154 B of the no-straddle 32768 B bank
// (30908 -> 25754 emitted; free tail 1860 -> 7014).
//
// If a FUTURE re-import ever makes an S3K kick or snare genuinely differ from
// the original (a different pitch_ratio, a different source WAV, a different
// engine rate), give it its own blob const + `data` line in the shared bank
// again and repoint its SND_S3K_* triple back. The alias below is a statement
// about TODAY'S BYTES, verified by `cmp`, not a claim that the two drums are
// conceptually the same instrument.
const BlipBlob      = embed("temp_blip.bin")     // 2880 B — 1B bring-up placeholder
const KickBlob      = embed("dac/kick.pcm")      // 1406 — also serves DAC id 5 (s3k_kick)
const SnareBlob     = embed("dac/snare.pcm")     // 3748 — also serves DAC id 6 (s3k_snare)
const HatBlob       = embed("dac/hat.pcm")       // 240
const S3kHiTomBlob  = embed("dac/s3k_hitom.pcm") // 3724
const S3kMidTomBlob = embed("dac/s3k_midtom.pcm")// 4656
const S3kLowTomBlob = embed("dac/s3k_lowtom.pcm")// 5558
const S3kFloorTomBlob = embed("dac/s3k_floortom.pcm") // 6422


// --- length guards (the deleted .asm's `0 < len < $8000` invariant, one per blob, as
// first-class comptime `ensure`s: the lengths are comptime ints, so these check
// at COMPILE time — exactly as the `fatal`s did, without the hand-rolled `if`).
// The 1:1 FILL reads ONE byte/pass and exhausts at len==0 for ANY length (odd or
// even), so there is no even-length requirement — just 0 < len < $8000. ---
ensure(0 < BlipBlob.len      && BlipBlob.len      < $8000, "DAC sample length must be > 0 and < $8000")
ensure(0 < KickBlob.len      && KickBlob.len      < $8000, "raw DAC drum length must be > 0 and < $8000")
ensure(0 < SnareBlob.len     && SnareBlob.len     < $8000, "raw DAC drum length must be > 0 and < $8000")
ensure(0 < HatBlob.len       && HatBlob.len       < $8000, "raw DAC drum length must be > 0 and < $8000")
ensure(0 < S3kHiTomBlob.len  && S3kHiTomBlob.len  < $8000, "S3K DAC drum length must be > 0 and < $8000")
ensure(0 < S3kMidTomBlob.len && S3kMidTomBlob.len < $8000, "S3K DAC drum length must be > 0 and < $8000")
ensure(0 < S3kLowTomBlob.len && S3kLowTomBlob.len < $8000, "S3K DAC drum length must be > 0 and < $8000")
ensure(0 < S3kFloorTomBlob.len && S3kFloorTomBlob.len < $8000, "S3K DAC drum length must be > 0 and < $8000")


// ===========================================================================
// The blip bank — the single 1B bring-up sample, alone in a $8000 window so one
// bank id covers it and the Z80 never re-banks mid-sample. Placed at the `dac_banks`
// map anchor (see the ⚠ note in the header for where that address is derived).
// ===========================================================================
section dac_blip_bank (cpu: m68000, bank: $8000) {
    data Dac_Temp_Blip = BlipBlob
}


// ===========================================================================
// The shared RAW 8-bit PCM drum bank — SEVEN distinct drums (the 3 original
// kick/snare/hat + the 4 S3K HCZ2 toms) packed contiguously into one $8000
// window so a single bank id covers the whole region and FILL never re-banks
// mid-sample. Placed one 0x8000 window above the blip bank, on its own bank
// id (see the ⚠ note in the header for the derivation). Drums are raw 8-bit
// PCM, not DPCM: the shared bank makes compression moot, and raw is
// higher-rate and cleaner.
//
// It stored NINE data lines until LS-7 (2026-09-06): `Dac_S3K_Kick` and
// `Dac_S3K_Snare` held bytes `cmp`-identical to `Dac_Kick` / `Dac_Snare`, so
// DAC ids 5 and 6 now point at the originals (see the ⚠ note at the blob
// consts). The order is otherwise unchanged; the two deleted lines were the
// mid-list s3k_snare and the tail s3k_kick, so the four toms shifted down.
// Nothing reads these labels at runtime — they are placement heads whose
// addresses reach the Z80 only through the bankid()/winptr() equs below.
//
// ⚠ THE CEILING IS 32768 B AND IT IS LINK-ENFORCED, NOT ENFORCED HERE. `bank:
// $8000` means sigil's placer refuses a section whose content exceeds the bank:
// `bank_diag` in sigil-link/src/relax.rs reports "section `dac_shared_bank`
// (0xNNNN bytes) cannot fit a 0x8000 bank, over by K bytes", by name and by
// amount, so the next person to add a drum is TOLD rather than shipping a bank
// that re-banks mid-sample. MEASURED 2026-09-06 by padding this section to
// 0x832E and building: exit 1 at the seam-1 emit_sound_blob stage, "over by 814
// bytes". See the LS-7 closure note in docs/DEFERRED_WORK.md.
//
// ⚠ AND READ THIS IF YOU ARE STARING AT A DIFFERENT ERROR. Overflow this bank by
// more than ~1.4 KB and you do NOT get that message — you get the OVERLAP check
// first: "sections `dac_shared_bank` [...] and `dac_sample_tab` [...] overlap in
// the image (colliding pins)". That is still this bank being too big. It is not
// a map bug and there is nothing wrong with `dac_sample_tab`; it is pinned
// 1457 B past this bank's ceiling, so a large overflow reaches it before the
// budget check reports. Shrink this section — the two errors have one cause.
// No comptime `ensure` duplicates it here ON PURPOSE — a hand-summed byte total
// beside a `data` list goes stale the moment someone adds a line and forgets the
// sum, and a ceiling guard that silently under-counts is worse than none.
// What the placer's check does NOT cover: it bounds the BYTES, nothing else. It
// says nothing about whether a drum is duplicated (LS-7's actual finding — the
// bank was legal at 30908 B while 5154 B of it was a copy), nothing about
// DAC_SAMPLE_COUNT or the descriptor table, and nothing about whether any
// sample still SOUNDS right. Those need eyes, `cmp`, and an emulator.
// ===========================================================================
section dac_shared_bank (cpu: m68000, bank: $8000) {
    data Dac_Kick        = KickBlob
    data Dac_Snare       = SnareBlob
    data Dac_Hat         = HatBlob
    data Dac_S3K_HiTom   = S3kHiTomBlob
    data Dac_S3K_MidTom  = S3kMidTomBlob
    data Dac_S3K_LowTom  = S3kLowTomBlob
    data Dac_S3K_FloorTom = S3kFloorTomBlob
}


// ===========================================================================
// The build-time SND_* constants the DAC descriptor table (dac_sample_tab.emp)
// reads cross-module at link — the per-sample {bank, ptr, len} triple, one per
// blob, spelled EXACTLY as the co-linked head names them (the consumer folds
// these SND_* by name at link):
//   bank = bankid(L) → (L & $7F8000) >> 15   (link-folded from the placed addr)
//   ptr  = winptr(L) → (L & $7FFF) | $8000    (link-folded)
//   len  = Blob.len                            (comptime)
// ===========================================================================
equ SND_BLIP_BANK = bankid(Dac_Temp_Blip)
equ SND_BLIP_PTR  = winptr(Dac_Temp_Blip)
equ SND_BLIP_LEN  = BlipBlob.len

equ SND_KICK_BANK = bankid(Dac_Kick)
equ SND_KICK_PTR  = winptr(Dac_Kick)
equ SND_KICK_LEN  = KickBlob.len

equ SND_SNARE_BANK = bankid(Dac_Snare)
equ SND_SNARE_PTR  = winptr(Dac_Snare)
equ SND_SNARE_LEN  = SnareBlob.len

equ SND_HAT_BANK = bankid(Dac_Hat)
equ SND_HAT_PTR  = winptr(Dac_Hat)
equ SND_HAT_LEN  = HatBlob.len

// DAC id 6 (s3k_snare) ALIASES id 3 (snare) — the two .pcm were byte-identical
// (LS-7). Only ds_ptr ever distinguished the two descriptors; now not even that.
equ SND_S3K_SNARE_BANK = bankid(Dac_Snare)
equ SND_S3K_SNARE_PTR  = winptr(Dac_Snare)
equ SND_S3K_SNARE_LEN  = SnareBlob.len

equ SND_S3K_HITOM_BANK = bankid(Dac_S3K_HiTom)
equ SND_S3K_HITOM_PTR  = winptr(Dac_S3K_HiTom)
equ SND_S3K_HITOM_LEN  = S3kHiTomBlob.len

equ SND_S3K_MIDTOM_BANK = bankid(Dac_S3K_MidTom)
equ SND_S3K_MIDTOM_PTR  = winptr(Dac_S3K_MidTom)
equ SND_S3K_MIDTOM_LEN  = S3kMidTomBlob.len

equ SND_S3K_LOWTOM_BANK = bankid(Dac_S3K_LowTom)
equ SND_S3K_LOWTOM_PTR  = winptr(Dac_S3K_LowTom)
equ SND_S3K_LOWTOM_LEN  = S3kLowTomBlob.len

equ SND_S3K_FLOORTOM_BANK = bankid(Dac_S3K_FloorTom)
equ SND_S3K_FLOORTOM_PTR  = winptr(Dac_S3K_FloorTom)
equ SND_S3K_FLOORTOM_LEN  = S3kFloorTomBlob.len

// DAC id 5 (s3k_kick) ALIASES id 2 (kick) — same LS-7 finding, same reasoning.
equ SND_S3K_KICK_BANK = bankid(Dac_Kick)
equ SND_S3K_KICK_PTR  = winptr(Dac_Kick)
equ SND_S3K_KICK_LEN  = KickBlob.len
