// ===========================================================================
// games/sonic4/data/sound/sfx_bank_blob.emp — the SFX block, native (K4 inc-5
// Stage 4, the P2 SFX probe)
// ===========================================================================
// The SFX block (the 9 FM/PSG SFX blobs, their patch banks, and the sparse
// id->blob SfxTable) was the BINCLUDE at $5BAE8/$5D53A in the since-deleted main.asm's
// gameSoundDataIncludes (after the native MT body). This module places it
// NATIVELY by EMBEDDING the seam-2-emitted sfx_bank{,_debug}.bin — the P2 path
// (spec §6): the emit-tool architecture is untouched; this module just places
// those bytes natively instead of via AS BINCLUDE.
//
// SHAPE-INVARIANT SIZE (shape-DEPENDENT start): the block is 0x748 B both shapes,
// but the MT body before it differs, so it starts at $5BB10 plain / $5D560 debug
// (shifted when the head's DacSampleTable grew 9->12 B per descriptor; the
// head-tail + MT-tail comptime pads keep this base ≡ 0 mod 8 — see the wall
// below).
// The embed content also differs per shape (the SfxTable pointer cells hold the
// per-shape absolute Sfx_NN addresses), so the embed selects on DEBUG.
//
// NON-PHASED: the block is plain LMA. No code reads SfxTable (sound_sfx.emp's
// SfxBlobWinTab reads are native, in the head), so the SFX bytes carry only the head
// label Sfx_33 (placement head / map-order / fold-gate key; no runtime consumer).
//
// THE SONG TABLES RIDE THIS SECTION'S TAIL (song bank 2, step 1, 2026-09-28).
// `SongTable` / `SongPatchTable` (song id -> song / patch-bank ROM address) are read by
// ONE reader, the 68k `Sound_PlayMusic` (engine/sound/sound_api.emp), which turns each
// entry into a bank id + $8000-window pointers and posts those to the Z80; the Z80 never
// reads the tables. So they need no particular bank. They sit here, after the SFX block,
// because (a) they must name songs in ANY song bank, which only the ROM build's link can
// resolve (seam-2 lowers mt_bank.emp alone), and (b) a new section would need its own
// sigil `section_align` row, while this one is declared (`Sfx_33`, 8). They came out of
// the MT bank's tail, so the SFX block starts 8*SONG_COUNT B lower than before.
//
// STRUCTURAL EXCLUSIVITY (spec §6, inherited): the native section is the SOLE SFX
// placement — the AS BINCLUDE is DELETED (can't-both), the section is unconditional
// in the sound-on registry (can't-neither). Placement is map-driven (the
// sound_bank anchor + contiguous pack after the MT body).
// ===========================================================================

module games.sonic4.sfx_bank_blob in sfx_bank_blob

use engine.types.{SongId}

const _sfx       = embed("engine/sound/generated/sfx_bank.bin")
const _sfx_debug = embed("engine/sound/generated/sfx_bank_debug.bin")
const _sfx_active = if DEBUG == 1 { _sfx_debug } else { _sfx }

// The whole SFX block (9 blobs + patch banks + the sparse SfxTable) — the head is
// Sfx_33 (the first SFX, id $33).
pub data Sfx_33 = _sfx_active

// Base-alignment wall (package 3 fix, 2026-08-10): the embedded SfxTable pointer
// cells + the head's SfxBlobWinTab window pointers were folded by seam-2 under a
// CONTIGUOUS-pack model, while the chainer 8-aligns this section's base — at a
// fold-base ≢ 0 (mod 8) the two diverge and every pointer lands short of the
// placed blobs (plain SFX went silent at -2; a mod-4-only fix still placed -4,
// pinning the quantum at 8). The structural fix is the comptime pad pair
// (dac_sample_tab.emp head tail + mt_bank.emp MT tail). NOTE this wall checks
// the PLACED base only (the fold's base is not expressible repo-side — the
// fold-vs-placement equality gate is the sigil ask in DEFERRED_WORK); it still
// catches any upstream size change that lands the chain on a misaligned base.
// (Spelled through `winptr(...)` — a bare label as an `==`/`&` operand is
// "unknown name" at comptime, the same bankid-label idiom mt_bank.emp uses;
// winptr passes the low 15 address bits through, so the mod-8 parity is exact.)
ensure((winptr(Sfx_33) & 7) == 0,
       "SFX block base must be 8-aligned — seam-2's pointer folds pack contiguously, a misaligned base desyncs them from the chainer's 8-aligned placement (see the dac_sample_tab.emp/mt_bank.emp pads)")

// ---------------------------------------------------------------------------
// The song tables (see the header). Song ids are games.sonic4.sound_ids'; these typed
// local mirrors document the TABLE ORDER (entry[id-1] = that song; id 0 = stop) and are
// drift-guarded against that authority at link. SONG_COUNT sizes both arrays, so a
// mismatched element count is a comptime error. The plain table is a PREFIX of the
// debug one (the ids every shape carries come first).
// ---------------------------------------------------------------------------
const SONG_MOVINGTRUCKS: SongId = 1
const SONG_S2_EHZ: SongId       = 2
const SONG_S2_CPZ: SongId       = 3
const SONG_S2_MTZ: SongId       = 4   // song bank 2
const SONG_S2_WFZ: SongId       = 5   // song bank 2
const SONG_S2_OOZ: SongId       = 6   // song bank 2
const SONG_DRUMTEST: SongId     = 7   // DEBUG shape only
const SONG_HCZ2: SongId         = 8   // DEBUG shape only
const SONG_COUNT = if DEBUG == 1 { 8 } else { 6 }   // a bound, not a song id
ensure(extern("SONG_MOVINGTRUCKS") == SONG_MOVINGTRUCKS, "SONG_MOVINGTRUCKS drifted from games.sonic4.sound_ids: {SONG_MOVINGTRUCKS}")
ensure(extern("SONG_S2_EHZ") == SONG_S2_EHZ, "SONG_S2_EHZ drifted from games.sonic4.sound_ids: {SONG_S2_EHZ}")
ensure(extern("SONG_S2_CPZ") == SONG_S2_CPZ, "SONG_S2_CPZ drifted from games.sonic4.sound_ids: {SONG_S2_CPZ}")
ensure(extern("SONG_S2_MTZ") == SONG_S2_MTZ, "SONG_S2_MTZ drifted from games.sonic4.sound_ids: {SONG_S2_MTZ}")
ensure(extern("SONG_S2_WFZ") == SONG_S2_WFZ, "SONG_S2_WFZ drifted from games.sonic4.sound_ids: {SONG_S2_WFZ}")
ensure(extern("SONG_S2_OOZ") == SONG_S2_OOZ, "SONG_S2_OOZ drifted from games.sonic4.sound_ids: {SONG_S2_OOZ}")
ensure(extern("SONG_DRUMTEST") == SONG_DRUMTEST, "SONG_DRUMTEST drifted from games.sonic4.sound_ids: {SONG_DRUMTEST}")
ensure(extern("SONG_HCZ2") == SONG_HCZ2, "SONG_HCZ2 drifted from games.sonic4.sound_ids: {SONG_HCZ2}")
ensure(extern("SONG_COUNT") == SONG_COUNT, "SONG_COUNT drifted from games.sonic4.sound_ids: {SONG_COUNT}")
ensure(SONG_COUNT < $FF, "SONG_COUNT must be < $FF ($FF is the stop sentinel)")

// The 68k reads the entries with `movea.l (a0), a1`: an odd table address is an address
// error. The SFX block is odd-length today (1,603 B), so a self-adjusting pad byte.
data _song_tables_align = if _sfx_active.len % 2 == 1 { byte(0) } else { Data.empty }

// song id -> SongHeader ROM address, indexed SongTable[id-1].
pub data SongTable: [*u8; SONG_COUNT] = if DEBUG == 1 {
    ["Song_MovingTrucks", "Song_S2_EHZ", "Song_S2_CPZ", "Song_S2_MTZ", "Song_S2_WFZ", "Song_S2_OOZ",
     "Song_DrumTest", "Song_HCZ2"]
} else {
    ["Song_MovingTrucks", "Song_S2_EHZ", "Song_S2_CPZ", "Song_S2_MTZ", "Song_S2_WFZ", "Song_S2_OOZ"]
}
// The parallel per-song FM patch bank, which must share its song's bank (the Z80 reads
// both through one window). DrumTest reuses Moving Trucks' bank.
pub data SongPatchTable: [*u8; SONG_COUNT] = if DEBUG == 1 {
    ["MovingTrucks_Patches", "S2_EHZ_Patches", "S2_CPZ_Patches", "S2_MTZ_Patches", "S2_WFZ_Patches",
     "S2_OOZ_Patches", "MovingTrucks_Patches", "HCZ2_Patches"]
} else {
    ["MovingTrucks_Patches", "S2_EHZ_Patches", "S2_CPZ_Patches", "S2_MTZ_Patches", "S2_WFZ_Patches",
     "S2_OOZ_Patches"]
}
