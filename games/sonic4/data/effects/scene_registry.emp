// games/sonic4/data/effects/scene_registry.emp — the game's scene registry.
// THE ONLY module that lowers scenes to ROM records. A scene value not listed in
// SCENES emits nothing — its section reference fails at link with a missing symbol.
// Cross-scene checks and the capability fold live here (they need VALUES, not Labels).
//
// ---------------------------------------------------------------------------
// STATUS (Task 9): LIVE AND SOLE. `SCENES` holds THE TWENTY SHIPPED SCENES, authored in
// games/sonic4/data/effects/ojz_scenes.emp, and this module emits all twenty lowered
// records under their SHIPPED names plus the six deform tables they attach.
// games/sonic4/data/parallax/configs.emp — the hdr()/cfg_band() authoring surface these
// records replace — is DELETED; its two constructors survive only as the test-only oracle
// in games/sonic4/test/scene_equiv_proof.emp, where no game data module can reach them.
//
// AND THIS MODULE IS PLACED AND REACHED — which is what makes every guard below REAL. The
// reach is now the real consumers, not Task 5's backwards probe edge out of configs.emp:
//   1. `use games.sonic4.scene_registry` (WHOLE-PATH, no name list) from
//      data/effects/ojz_effects.emp, which binds ParallaxConfig_OJZ_Underwater through a
//      preset. The name-list form alone is a trap for the CLOSURE: a selective
//      `use ...{SceneRegistry_CapsFolded}` injects a CLONE of the const whose initializer
//      re-evaluates in the CONSUMER's scope, so it reports `unknown function fold_caps`
//      at a span inside THIS file while never elaborating this module at all. Keep the
//      whole-path edge even though the name lists beside it read as sufficient.
//   2. `games/sonic4/map.toml` `order` entry for this module's section head label
//      (`DeformTable_Zero`, inherited from the deleted configs.emp section, which is what
//      keeps the object-bank budget `cursor` resolving) — without it a reachable module
//      fails `[map.order-undeclared]`.
//
// WHY THAT MATTERS: an unreached .emp module gets parse + scan coverage and ZERO body
// elaboration (measured from both sides in Task 3; see the banner in
// engine/level/scene_dsl.emp). A module-level `ensure(1 == 0)` in an unreached module
// builds GREEN with an identical CRC. Until Task 6 this file, and every guard in
// scene_dsl.emp behind it, was in exactly that state. It no longer is: the twenty scenes
// drive `layer()`, `scene()`, `derived_mask()`, `scene_caps()`, `fold_caps()`,
// `scene_hdr()`, `scene_band()` and the four `lowerN` their counts select (1/2/4/5) on
// every build. lower3/6/7/8 exist for the counts an EDITOR author can reach; their
// instantiating consumer is the generated editor-scene module, not this list.
//
// THE EMISSION ORDER AT THE BOTTOM OF THIS FILE IS LOAD-BEARING. It reproduces the shipped
// ROM block byte for byte — tables interleaved with the records that attach them — and the
// P1 image-identity gate is decided by it. Read that block's banner before reordering
// anything, including "tidying" the six tables into one run.
// ---------------------------------------------------------------------------
module games.sonic4.scene_registry in scene_registry

// The two ROM record types the lowering targets. `parallax_config` is the 28-byte
// header; `band_record` is the band — the 10-byte legacy `band_entry`, plus a per-layer
// deform extension in a game that declares CAP_MULTI_DEFORM_TABLE (P3 Task 8, design 3.1).
// This game does not, so every array below is the size it has always been.
//
// ALL FOUR NAMES ARE IMPORTED AND ALL FOUR ARE LOAD-BEARING. `band_record`'s declaration is
// re-elaborated in THIS module's name environment, so `band_entry`, `band_ext` and
// BAND_EXT_N have to resolve here even though nothing in this file spells them: drop one
// and the build fails pointing at engine/level/parallax.emp, naming a type that file
// plainly declares (measured 2026-08-20 — 40 diagnostics at a declaration site that was
// correct).
use engine.structs.{parallax_config}
use engine.parallax.{band_entry, band_record, band_ext, BAND_EXT_N, band_curve, BAND_CURVE_N}
// GLOB IMPORTS, BOTH MANDATORY, AND NOT A STYLE CHOICE. A comptime fn's free names
// resolve at the CALL SITE, so scene()/scene_caps()/scene_hdr() bodies reach their
// helpers through whatever is in scope HERE. A selective `use ...{scene, layer}` is
// LOUD on the function axis (one `unknown function` per call) but SILENT on the
// constant axis — a constant that resolves to nothing degrades instead of erroring.
// See the pin block at the top of engine/level/scene_dsl.emp for the full rule.
use engine.level.scene_dsl.*
use engine.level.parallax_dsl.*

// =====================================================================
// Record shapes — a header followed by N band entries.
//
// The runtime never reads these wrapper types; it walks bytes off the header pointer
// and takes the band count from the header. One shape per band count is all the layout
// needs, and per-count typed `data` bindings are the ONLY enforcement that a lowering
// produced the right number of bands (Task-1 probe B: a comptime fn's return annotation
// is documentation; the typed `data` binding is what raises `array length mismatch`).
//
// EIGHT SHAPES BECAUSE THE ENGINE ADMITS EIGHT BAND COUNTS. `scene()` caps `count` at
// MAX_PARALLAX_BANDS (engine/system/constants.emp = 8, pinned by the `ensure` at
// engine/level/scene_dsl.emp:54), Empyrean's writer schema mirrors it as
// `layers minItems 1 / maxItems 8`, and Aurora computes its Add-layer cap from that
// schema at load — so an author can produce ANY count in 1..8 and every one of them
// must lower. The shape set is therefore a property of MAX_PARALLAX_BANDS, not of what
// the hand-authored scenes happened to need.
//
// It used to be four (1, 2, 4, 5 — the counts the twenty shipped configs use), which was
// never a decision: 3, 6, 7 and 8 were exactly as reachable, they were just not on the
// path the hand authors took. That gap was found the expensive way — Aurora's first
// writer-originated scene, authored through their real UI, has EIGHT layers, and
// tools/effects_gen.py refused it naming this file. Closing 3/6/7/8 together (rather than
// only the 8 that unblocked the fixture) is what keeps the next writer-originated count
// from re-arming the identical defect with the discovering artifact already spent.
//
// tools/test_scene_band_shape_coverage.py DERIVES the required set from
// MAX_PARALLAX_BANDS and fails naming any count whose pair is missing, so if the constant
// ever moves the coverage claim moves with it instead of going quietly stale.
//
// NOT A DEFECT, AND NOT TO BE "FIXED" WITH A NINTH SHAPE: an ANCHORED scene splits a
// layer at runtime and so needs count+1 shadow entries (scene_dsl.emp:1062), which means
// an anchored 8-band scene is still correctly refused. That is a real engine limit — the
// shadow view is sized for eight entries — not a missing SceneCfg9.
// =====================================================================
// `pub` (P5 slice 5) so the GENERATED editor-scene module
// (games/sonic4/data/generated/ojz/act1/effects_scenes.emp) emits its records
// through these shapes and these lowerings instead of declaring a second, drifting
// copy. This module stays the single AUTHORITY for what a lowered record looks
// like; what it stopped being is the single emission SITE — editor-authored scenes
// are emitted by their own generated module, in their own section, with their own
// budget fold (wave-1 design §3). A band count with no shape here is a generator
// REFUSAL naming this file, never a locally-invented lowerN.
pub struct SceneCfg1 { hdr: parallax_config, bands: [band_record; 1] }
pub struct SceneCfg2 { hdr: parallax_config, bands: [band_record; 2] }
pub struct SceneCfg3 { hdr: parallax_config, bands: [band_record; 3] }
pub struct SceneCfg4 { hdr: parallax_config, bands: [band_record; 4] }
pub struct SceneCfg5 { hdr: parallax_config, bands: [band_record; 5] }
pub struct SceneCfg6 { hdr: parallax_config, bands: [band_record; 6] }
pub struct SceneCfg7 { hdr: parallax_config, bands: [band_record; 7] }
pub struct SceneCfg8 { hdr: parallax_config, bands: [band_record; 8] }

// ---------------------------------------------------------------------
// lowerN — the emission fold for a scene with exactly N real layers.
//
// THE COUNT GUARD IS THE POINT OF THESE FUNCTIONS, not the array literal. The
// typed `data` binding catches a lowerN whose band array is the wrong length, but it
// canNOT catch `lower4(a_five_layer_scene)`: that emits a 4-band record whose HEADER
// still says band_count 5, and the runtime — which indexes bands at
// `sizeof(parallax_config)(a0)` and trusts the header count — then reads its fifth band
// out of whatever record the packer put next. Silent, shipped, and a wrong picture
// rather than a fault. Task 6 hand-picks a lowerN for each of twenty configs, which is
// exactly where that slip happens, so each function asserts its own arity.
//
// scene_band() carries the mirror-image guard (`i < sc_count`), so the OTHER slip —
// lower5 on a four-layer scene — fails there. Both directions are covered; only this
// direction needed a new guard.
//
// PROVEN RED (Task 5): the four then-existing lowerings were rotated one place around
// SCENES in a single probe build, which reported all four — `[Error] lower1(): scene has
// 2 real layers, not 1 — …` through `lower5(): scene has 1 real layers, not 5 — …` —
// plus four `scene_band(): layer index N is outside the scene's 1 real layers` from the
// mirror guard. Eight diagnostics from one build, which re-confirms `ensure` is
// non-aborting: an early guard does not mask a later one.
//
// lower3/6/7/8 are the same fold at a different arity and carry the same guard. Nothing
// in THIS game instantiates them — no shipped config uses those counts — so they are
// comptime-inert here and their guards are unexercised until a scene of that count is
// lowered. That is not a coverage claim being made and then quietly missed: the
// instantiating consumer is the GENERATED editor-scene module, which imports these by
// name (tools/effects_gen.py), and an editor scene of count N drives lowerN on every
// build from then on. What IS checked unconditionally is that the pair EXISTS for every
// count the engine admits — tools/test_scene_band_shape_coverage.py, derived from
// MAX_PARALLAX_BANDS.
// ---------------------------------------------------------------------
pub comptime fn lower1(s: Scene) -> SceneCfg1 {
    ensure(s.sc_count == 1, "lower1(): scene has {s.sc_count} real layers, not 1 — the header would declare its own count while the record carries one band, and the runtime indexes bands off the header count")
    return SceneCfg1{ hdr: scene_hdr(s), bands: [ scene_band(s, 0) ] }
}
pub comptime fn lower2(s: Scene) -> SceneCfg2 {
    ensure(s.sc_count == 2, "lower2(): scene has {s.sc_count} real layers, not 2 — the header would declare its own count while the record carries two bands, and the runtime indexes bands off the header count")
    return SceneCfg2{ hdr: scene_hdr(s), bands: [ scene_band(s, 0), scene_band(s, 1) ] }
}
pub comptime fn lower3(s: Scene) -> SceneCfg3 {
    ensure(s.sc_count == 3, "lower3(): scene has {s.sc_count} real layers, not 3 — the header would declare its own count while the record carries three bands, and the runtime indexes bands off the header count")
    return SceneCfg3{ hdr: scene_hdr(s),
                      bands: [ scene_band(s, 0), scene_band(s, 1), scene_band(s, 2) ] }
}
pub comptime fn lower4(s: Scene) -> SceneCfg4 {
    ensure(s.sc_count == 4, "lower4(): scene has {s.sc_count} real layers, not 4 — the header would declare its own count while the record carries four bands, and the runtime indexes bands off the header count")
    return SceneCfg4{ hdr: scene_hdr(s),
                      bands: [ scene_band(s, 0), scene_band(s, 1), scene_band(s, 2),
                               scene_band(s, 3) ] }
}
pub comptime fn lower5(s: Scene) -> SceneCfg5 {
    ensure(s.sc_count == 5, "lower5(): scene has {s.sc_count} real layers, not 5 — the header would declare its own count while the record carries five bands, and the runtime indexes bands off the header count")
    return SceneCfg5{ hdr: scene_hdr(s),
                      bands: [ scene_band(s, 0), scene_band(s, 1), scene_band(s, 2),
                               scene_band(s, 3), scene_band(s, 4) ] }
}
pub comptime fn lower6(s: Scene) -> SceneCfg6 {
    ensure(s.sc_count == 6, "lower6(): scene has {s.sc_count} real layers, not 6 — the header would declare its own count while the record carries six bands, and the runtime indexes bands off the header count")
    return SceneCfg6{ hdr: scene_hdr(s),
                      bands: [ scene_band(s, 0), scene_band(s, 1), scene_band(s, 2),
                               scene_band(s, 3), scene_band(s, 4), scene_band(s, 5) ] }
}
pub comptime fn lower7(s: Scene) -> SceneCfg7 {
    ensure(s.sc_count == 7, "lower7(): scene has {s.sc_count} real layers, not 7 — the header would declare its own count while the record carries seven bands, and the runtime indexes bands off the header count")
    return SceneCfg7{ hdr: scene_hdr(s),
                      bands: [ scene_band(s, 0), scene_band(s, 1), scene_band(s, 2),
                               scene_band(s, 3), scene_band(s, 4), scene_band(s, 5),
                               scene_band(s, 6) ] }
}
pub comptime fn lower8(s: Scene) -> SceneCfg8 {
    ensure(s.sc_count == 8, "lower8(): scene has {s.sc_count} real layers, not 8 — the header would declare its own count while the record carries eight bands, and the runtime indexes bands off the header count")
    return SceneCfg8{ hdr: scene_hdr(s),
                      bands: [ scene_band(s, 0), scene_band(s, 1), scene_band(s, 2),
                               scene_band(s, 3), scene_band(s, 4), scene_band(s, 5),
                               scene_band(s, 6), scene_band(s, 7) ] }
}

// =====================================================================
// THE TWENTY SCENES (Task 6 — the placeholders are gone).
//
// The scene VALUES are authored in games/sonic4/data/effects/ojz_scenes.emp; this module
// owns the LIST and nothing else. The import is a glob for the reason in the header note
// above — and note that a `use` edge RE-EVALUATES an imported const's initializer in this
// module's scope (Task 5's probe finding), so ojz_scenes' four family helpers
// (shimmer_scene / haze_scene / rocking_scene / perspective_scene) are `pub` and arrive
// through the same glob. A private helper there would report `unknown function` here.
// =====================================================================
use games.sonic4.ojz_scenes.*

// ---------------------------------------------------------------------
// SCENES — THE REGISTRY. Every scene this game ships, and the sole input to the
// capability fold.
//
// THE ORDER IS THE EMISSION ORDER (the packer's order inside a section), and it is
// data/parallax/configs.emp's declaration order transcribed, so the Task-7 equivalence
// proof and the Task-9 swap both read straight down. The index beside each name is the
// `SCENES[i]` the emission block below indexes — a record can only exist for a scene the
// fold has already seen.
// ---------------------------------------------------------------------
pub const SCENES: [Scene; 20] = [
    Scene_OJZ_Default,             //  0  lower4
    Scene_OJZ_Underwater,          //  1  lower4
    Scene_OJZ_Windy,               //  2  lower1
    Scene_Shimmer_Slow,            //  3  lower1
    Scene_Shimmer,                 //  4  lower1
    Scene_Shimmer_Fast,            //  5  lower1
    Scene_Haze_Slow,               //  6  lower5
    Scene_Haze,                    //  7  lower5
    Scene_Haze_Fast,               //  8  lower5
    Scene_Haze_Uniform,            //  9  lower5
    Scene_Rocking_Slow,            // 10  lower1
    Scene_Rocking,                 // 11  lower1
    Scene_Rocking_Fast,            // 12  lower1
    Scene_Perspective_Subtle,      // 13  lower5
    Scene_Perspective,             // 14  lower5
    Scene_Perspective_Dramatic,    // 15  lower5
    Scene_WindyHaze,               // 16  lower5
    Scene_SkyHaze,                 // 17  lower2
    Scene_OJZ_Caves,               // 18  lower5
    Scene_OJZ_LockedClouds,        // 19  lower5
]

// =====================================================================
// The capability fold and its verify.
//
// fold_caps() lives in engine/level/scene_dsl.emp beside scene_caps() (the rule for
// turning a list into a mask is model); the LIST is the registry's, so the fold is
// evaluated here. It ORs every scene's demands and adds CAP_TRANSITIONS ($0010) when
// the registry holds more than one scene — the one bit no single scene can raise,
// because a transition is a property of the EDGE between two scenes.
//
// THE EXPECTATION, DERIVED BY HAND OVER THE TWENTY (Task 6), bit by bit. Each bit is
// listed with the scenes that raise it, so a future edit that drops the last raiser of a
// bit is visible here rather than only in a changed number:
//
//   $0001 CAP_PER_LINE       ALL TWENTY. Every shipped config attaches a BG or FG deform
//                            table (the flat-pathed DeformTable_Zero counts — a non-NULL
//                            pointer is what selects the per-line pipeline), and
//                            OJZ_Underwater would raise it again through its anchor.
//   $0002 CAP_PER_COL_VSRAM  Rocking_Slow/Rocking/Rocking_Fast (SceneVDeform.Columns on
//                            DeformTable_Rocking) + Perspective_Subtle/Perspective/
//                            Perspective_Dramatic (on DeformTable_Perspective). SIX.
//                            Rocking_Slow counts: v_speed 0 is a STATIC tilt with the
//                            table attached, not an absent attachment.
//   $0004 CAP_DEFORM         Table AND a live amplitude somewhere. Fourteen: Windy,
//                            Shimmer x3, Haze x4, Rocking x3, Perspective x3 — plus
//                            SkyHaze and WindyHaze, and OJZ_Underwater via its ANCHOR
//                            dsb 2 (every one of its four authored layers is at 15, so
//                            the anchor shifts are the only live amplitude it has; this
//                            is exactly why scene_caps() scans them).
//                            CLEAR on OJZ_Default, OJZ_Caves, OJZ_LockedClouds — all
//                            three are flat-pathed zero tables with every shift at 15.
//   $0008 CAP_ANCHORS        OJZ_Underwater ALONE — the only world-anchored config in
//                            the tree (SceneAnchor.At(0, 15, 2)).
//   $0010 CAP_TRANSITIONS    fold_caps() adds it because SCENES.len (20) > 1. No single
//                            scene can raise it; the sc_transition byte on OJZ_Caves and
//                            OJZ_LockedClouds is lowered but does not fold.
//
// $0001|$0002|$0004|$0008|$0010 = $001F, which is EXACTLY the declared
// Game.SCANLINE_CAPS — the subset test below passes with zero slack. The slack the
// one-sided test was built for was consumed as the twenty landed; it stays one-sided
// because a declared subset would be a wrong picture on hardware and a declared superset
// only forgoes a P2 specialisation.
// =====================================================================
// ---------------------------------------------------------------------
// THE RECORD-SHAPE PIN (P3 Task 8) — the capability is the authority, this holds the
// engine's mirror to it.
//
// engine/level/parallax.emp's BAND_EXT_N decides whether a lowered band carries the
// per-layer deform extension, and it CANNOT read Game.SCANLINE_CAPS: the context that lays
// out an emitted record's type does not bind contract members (`unknown name
// Game.SCANLINE_CAPS`, twenty of them, measured 2026-08-20 — the full evidence and the
// sigil-side fix are in docs/benchmarks/scanline-p3/EXTENDED-RECORD.md and
// docs/DEFERRED_WORK.md). This module is where both numbers ARE visible, so this is where
// they are pinned together.
//
// TWO ENSURES, NOT ONE, BECAUSE BOTH DIRECTIONS ARE REAL FAULTS — the same reasoning the
// VDP_Shadow_len equality above it uses, and the opposite of the capability SUBSET test
// below, which is one-sided on purpose. A game that raises the bit while the engine record
// stays legacy gets a lowering that silently drops the per-layer refs the scenes demand. A
// game that leaves the bit clear while the record carries the extension pays 10 bytes per
// band of ROM and RAM for a field nothing reads, and breaks design 8.1's byte-identity
// claim with no other symptom.
//
// PROVEN RED, both arms (2026-08-20): flipping BAND_EXT_N to 1 against this game's $001F
// fails with the second message; narrowing the test's bit to one the game DOES declare
// (CAP_DEFORM, $0004) fails with the first.
ensure((Game.SCANLINE_CAPS & CAP_MULTI_DEFORM_TABLE) == 0 || BAND_EXT_N == 1,
       "this game declares CAP_MULTI_DEFORM_TABLE in Game.SCANLINE_CAPS ({Game.SCANLINE_CAPS}) but engine/level/parallax.emp's BAND_EXT_N is {BAND_EXT_N} — the lowered band record would carry no per-layer deform extension while the scenes demand one. Set BAND_EXT_N to 1 and set BAND_EXT_BYTES in engine/ram.emp to sizeof(band_ext)")
ensure((Game.SCANLINE_CAPS & CAP_MULTI_DEFORM_TABLE) != 0 || BAND_EXT_N == 0,
       "engine/level/parallax.emp's BAND_EXT_N is {BAND_EXT_N} but this game does NOT declare CAP_MULTI_DEFORM_TABLE (Game.SCANLINE_CAPS = {Game.SCANLINE_CAPS}) — every band would carry sizeof(band_ext) bytes of ROM and shadow RAM that nothing reads, and the zero-capability lowering would stop being byte-identical to the legacy one")

// THE SAME PIN FOR THE CURVE TAIL (P3 Task 10). A separate PAIR rather than a widened one,
// because the two tails answer to different capability bits and a game may declare either,
// both or neither — folding them into one test would let a curve game with no deform silence
// the deform arm and vice versa.
ensure((Game.SCANLINE_CAPS & CAP_FACTOR_CURVE) == 0 || BAND_CURVE_N == 1,
       "this game declares CAP_FACTOR_CURVE in Game.SCANLINE_CAPS ({Game.SCANLINE_CAPS}) but engine/level/parallax.emp's BAND_CURVE_N is {BAND_CURVE_N} — the lowered band record would carry no curve tail while the scenes demand one, so every ramp would lower to a flat band with no diagnostic. Set BAND_CURVE_N to 1 and set BAND_CURVE_BYTES in engine/ram.emp to sizeof(band_curve)")
ensure((Game.SCANLINE_CAPS & CAP_FACTOR_CURVE) != 0 || BAND_CURVE_N == 0,
       "engine/level/parallax.emp's BAND_CURVE_N is {BAND_CURVE_N} but this game does NOT declare CAP_FACTOR_CURVE (Game.SCANLINE_CAPS = {Game.SCANLINE_CAPS}) — every band would carry sizeof(band_curve) bytes of ROM and shadow RAM that nothing reads, and the zero-capability lowering would stop being byte-identical to the legacy one")

pub const SceneRegistry_CapsFolded = fold_caps(SCENES)

// THE VERIFY. `folded ⊆ declared`, never equality.
//
// DIRECTION IS THE SAFETY PROPERTY. A declared SUPERSET only forgoes a P2
// specialisation the game could have had; a declared SUBSET would omit machinery a
// scene still demands, which is a wrong picture on hardware. So the test is one-sided
// on purpose, and the slack it leaves is deliberate twice over: it also lets Task 6
// migrate the twenty configs ONE AT A TIME without an intermediate red build, since a
// partially-populated registry folds to a subset of the finished mask.
//
// AND IT IS THE ONLY REAL CHECK ON THAT WORD. `const SCANLINE_CAPS: u16` on the Game
// interface enforces NOTHING beyond int-ish-ness — sigil's contract checker range-checks
// no const member, so the `u16` is documentary. Nothing else in the tree reads
// Game.SCANLINE_CAPS (the comptime arms that consume it arrive in P2), so if this ensure
// is removed or goes dead, that word is unverified.
//
// THE MESSAGE NAMES BOTH NUMBERS AND BOTH FIXES because the reader has a real choice:
// widen games/sonic4/config/game.emp's declaration if the new capability is wanted, or
// stop authoring it if it is not. Which one is right is not a fact the build can know.
// It also names the UNDECLARED BITS — the difference, not just the two operands — since
// that is the number the reader actually has to act on. Interpolation renders DECIMAL
// (`25`, `16`, `9`), which is a wart: read them as $0019 / $0010 / $0009 against the
// CAP_* block. There is no comptime hex formatter to reach for.
//
// PROVEN RED (Task 5): narrowing the declaration to $0010 under the probe reported
// `[Error] scene registry: the folded capability mask 25 is NOT a subset of
// Game.SCANLINE_CAPS 16; the UNDECLARED bits are 9 — …`. 25 is $0019, matching the
// derivation above exactly, and 9 is $0009 = CAP_PER_LINE|CAP_ANCHORS, which is PH4's
// contribution and nothing else. `~` is a real comptime operator on ints (sigil
// eval/expr.rs, `UnOp::BitNot => Value::Int(!n)`); the alternative spelling
// `folded & declared == folded` is equivalent and unused.
// ---------------------------------------------------------------------
// THE OTHER DIRECTION (P3 Task 9) — `folded == the hand-derived word`.
//
// THE SUBSET TEST ABOVE CANNOT SEE A SCENE THAT STOPS RAISING A BIT. `folded & ~declared`
// is 0 both when the registry demands exactly what the game declares and when it demands
// LESS, so an edit that silently dropped a capability off every scene would leave that
// test green while the twenty configs quietly changed shape. Task 9's whole byte-identity
// claim is a statement about this fold in BOTH directions — no scene starts raising
// CAP_MULTI_DEFORM_TABLE, and none stops raising what it raises today — so it needs a
// pin the subset test structurally cannot be.
//
// THE EXPECTED WORD IS DERIVED, NOT COPIED FROM THE FOLD. It is the per-scene roster
// stated in the banner above this block, re-added: $0001 CAP_PER_LINE (all twenty),
// $0002 CAP_PER_COL_VSRAM (the four v-deform scenes), $0004 CAP_DEFORM (every scene with
// a live amplitude), $0008 CAP_ANCHORS (OJZ_Underwater alone), $0010 CAP_TRANSITIONS
// (fold_caps() adds it because SCENES.len is 20 > 1). Writing it as `fold_caps(SCENES)`
// would make the test `x == x`, which is the vacuity poison_scene_mask.emp's header
// warns about in the same words.
//
// THIS PIN IS MEANT TO GO RED WHEN A CAPABILITY LANDS. Task 10's curve layers raise
// $0040 on the scenes that adopt one; the correct response is to re-derive this word
// from the roster and edit it, in the same commit as the adoption, never to widen the
// test. A pin nobody has to touch is a pin nobody is checking.
pub const SceneRegistry_CapsExpected = $001F
ensure(SceneRegistry_CapsFolded == SceneRegistry_CapsExpected,
       "scene registry: the twenty scenes fold to capability mask {SceneRegistry_CapsFolded}, not the hand-derived {SceneRegistry_CapsExpected}. This pin is two-sided ON PURPOSE — the subset test below cannot see a scene that STOPS raising a bit. If a scene gained a capability, re-derive this word from the per-scene roster in this file's banner and edit it in the same commit; if a scene LOST one, that is a lowering regression and the fold is telling you which way")

// THE RECORD-SHAPE HALF OF THE SAME FACT (P3 Task 9), named separately because the
// reader who trips it needs a different sentence. The equality above catches this too;
// what it cannot say is WHAT ELSE has to move. CAP_MULTI_DEFORM_TABLE is the one bit
// whose folding changes the LOWERED RECORD SHAPE — engine/level/parallax.emp's
// BAND_EXT_N and engine/ram.emp's BAND_ENTRY_LEN both have to move with it, and the
// two-directional pin above this block is what refuses the half-edit. Adoption of
// `deform: Own(..)` by a shipped scene is PARK-1, owner-gated, and is NOT what P3 Task 9
// landed: Task 9 built the mechanism and left every shipped scene on Shared/None.
ensure((SceneRegistry_CapsFolded & CAP_MULTI_DEFORM_TABLE) == 0,
       "scene registry: a shipped scene now folds CAP_MULTI_DEFORM_TABLE — some layer authored `deform: SceneDeform.Own(..)`. Adopting a per-layer deform table is PARK-1 (owner-gated) and it is not a scene-local edit: it flips the lowered band record to the extended shape, so engine/level/parallax.emp's BAND_EXT_N must become 1 and engine/ram.emp's BAND_EXT_BYTES must become sizeof(band_ext) in the SAME commit, and every ROM image in the tree moves")
// THE SECOND RECORD-SHAPE BIT (P3 Task 10). Same shape, same reason, different tail:
// CAP_FACTOR_CURVE moves BAND_CURVE_N and BAND_CURVE_BYTES. Adopting a curve on a shipped
// scene is the curve half of PARK-1 and is likewise NOT what Task 10 landed — it built the
// mechanism and left all twenty scenes flat.
ensure((SceneRegistry_CapsFolded & CAP_FACTOR_CURVE) == 0,
       "scene registry: a shipped scene now folds CAP_FACTOR_CURVE — some layer authored `curve: SceneCurve.To(..)`. Adopting a ramping BG factor is owner-gated and is not a scene-local edit: it flips the lowered band record to carry the curve tail, so engine/level/parallax.emp's BAND_CURVE_N must become 1 and engine/ram.emp's BAND_CURVE_BYTES must become sizeof(band_curve) in the SAME commit, and every ROM image in the tree moves")
// ---------------------------------------------------------------------
ensure((SceneRegistry_CapsFolded & ~Game.SCANLINE_CAPS) == 0, "scene registry: the folded capability mask {SceneRegistry_CapsFolded} is NOT a subset of Game.SCANLINE_CAPS {Game.SCANLINE_CAPS}; the UNDECLARED bits are {SceneRegistry_CapsFolded & ~Game.SCANLINE_CAPS} — a scene demands a scanline service the game does not declare, so the P2 lowering would omit machinery the scene still needs. Either widen SCANLINE_CAPS in games/sonic4/config/game.emp to cover the folded mask, or stop authoring the capability in the scene that raises it (engine/level/scene_dsl.emp's CAP_* block names each bit)")

// =====================================================================
// THE REBASE STRUCTURAL CHECK (design §6, P2 Task 9b) — scoped explicitly to STRUCTURE.
//
// The fold lives in engine/level/scene_dsl.emp beside the model it classifies; the LIST
// is the registry's, so it is evaluated here. It walks every scene's world-Y layer tops
// and its anchor-bank reference and proves each sits in a rebase-CLASSIFIED coordinate
// space — ACT-RELATIVE for tops since P3 Task 7 (they were plane-relative before it),
// act-relative-by-indirection for the anchor bank.
//
// IT DOES NOT VERIFY A REBASE, and the ensure messages say so themselves rather than
// leaving it to this comment: §4.11 is FUTURE/Phase-4 and there is no rebase mechanism
// to test against. Design §6 asked for the limitation to be stated plainly "so it cannot
// be mistaken for runtime rebase verification"; it is stated in the failing text, where a
// reader who trips it will actually see it.
//
// THE REFERENCE BELOW IS LOAD-BEARING. An unreferenced top-level `const X = f(...)` is
// comptime-INERT (docs/EMP_PITFALLS.md §3) — the fold would never run and the guard would
// be another entry in this tree's vacuous-gate history. The ensure is what evaluates it,
// exactly as the capability fold above is evaluated by its subset test.
//
// PROVEN RED: replacing OJZ_Default's first `layer(world_y: 512, ...)` with a hand-built
// `SceneLayer{ ly_world_y: 5, .. }` — the documented back door, which bypasses layer()'s
// own guards and is precisely what this registry-level fold exists to close — fails the
// build. Since P3 Task 7 the failing guard is scene_plane_line()'s ("world_y 5 is above
// this scene's v_center 512"), reached through the LOWERING (lowerN -> scene_band ->
// scene_plane_line) rather than through this fold: 5 is inside the act span, so the fold's
// own ensure passes and the plane-image ensure is what catches it. Both are real, and the
// re-verification after the guard changed is recorded in
// docs/benchmarks/scanline-p3/REGLUE.md.
//
// ---- THE ACT SPAN IS DERIVED, NOT TYPED (P3 Task 7 Step 1) ----
//
// `layer()` can only apply the engine-wide $8000 act-axis ceiling — it sees one layer and
// knows nothing about the act. The TIGHT bound is this act's own vertical extent, and the
// authority for that is the act descriptor's `GRID_H << SECTION_SIZE_SHIFT`.
//
// It arrives as a MIRROR WITH A PIN rather than a direct import, and the direction is
// forced: games/sonic4/data/levels/ojz/act1/act_descriptor.emp already imports THIS
// module (for ParallaxConfig_OJZ_Default), so a `use` back the other way would be a
// cycle. The mirror is declared here and act_descriptor.emp — where GRID_H and
// SECTION_SIZE_SHIFT both live — carries the ensure that holds it to the descriptor's own
// grid. Same two-species-of-pin discipline as PARALLAX_STATE_LONGS and BAND_ENTRY_LEN:
// the number is written once and checked where its authority is in scope.
pub const SCENE_ACT_SPAN_Y = 6144
pub const SceneRegistry_RebaseTagged = assert_act_relative_tagged(SCENES, SCENE_ACT_SPAN_Y)
ensure(SceneRegistry_RebaseTagged > 0, "scene registry: the rebase structural check classified nothing — assert_act_relative_tagged() returned {SceneRegistry_RebaseTagged}, so no world-Y top and no anchor bank was examined and the §6 declarative gate is vacuous")

// =====================================================================
// THE BUDGET LEDGER (P2 Tasks 10 + 11 — design §5).
//
// The model, the pools and the reservations live in engine/level/scene_dsl.emp beside the
// scene model they measure; the LIST is the registry's, so the fold is evaluated here — the
// same split as the capability fold and the rebase check above.
//
// ENFORCEMENT IS THE `ensure`s INSIDE scene_budget_enforce(), not anything in this file and
// not anything in the toml. design §5's ownership rule: the comptime DSL is the single
// authority because it alone sees every scene through the registry; tools/effects_budget_model.toml's
// `[symbols]` rows pin PROVENANCE (they detect drift between the file and the code) and must
// never be doing enforcement. If a row there is deciding whether a build passes, it is in the
// wrong place.
//
// THE REFERENCE BELOW IS LOAD-BEARING, for the third time in this file: an unreferenced
// top-level `const X = f(...)` is comptime-INERT (docs/EMP_PITFALLS.md §3), so the ensure is
// what actually evaluates the fold.
//
// PROVEN RED: four poison fixtures under games/sonic4/test/poison/, one per shipped axis,
// each exceeding its budget by exactly ONE unit — poison_budget_axis1/2/3.emp here and
// poison_budget_axis4b.emp against raster_program(). Registered in tools/emp_expect_fail.py.
// AXIS 5 (P3 Task 14) carries NO poison, deliberately: its charge is two-valued and both
// values fit every sub-ceiling always, so no authored input can cross it — booked with its
// unlock conditions in [scene_budget]'s falsifiability section rather than given a faked
// poison (the same treatment as axes 2/3). Its enforce-path red-first evidence is the
// perturbation record in the P3 plan's Task 14 DONE block.
// =====================================================================
pub const SceneRegistry_BudgetChecked = scene_budget_enforce(SCENES)
ensure(SceneRegistry_BudgetChecked == 20, "scene registry: the budget fold checked {SceneRegistry_BudgetChecked} scenes, not the 20 in SCENES — a fold that examines fewer scenes than the registry holds is gating a subset, and the axis ensures inside it would be silently unasked for the remainder")

// ---- THE LEDGER ROWS (Task 10) ----
//
// `pub equ` and NOT `pub const`, and the distinction is the whole parcel: an equ mints a
// link-level symbol that reaches the build's listing (sigil 0df77f83, the equate table), so
// tools/scene_budget_report.py can render the ledger from the ARTIFACT rather than from a
// second transcription of the model. A `pub const` is a name-resolution-only item — no bytes,
// no label, no deferred symbol — and is invisible to every tool. Both are zero-ROM; only one
// is readable. (Task 10's spike proved exactly this, twice: before the sigil parcel neither
// spelling reached the listing, and after it only the equ does. A `pub const` in a HARVESTED
// constants module reaches the listing as a side effect of harvesting — that is
// module-location-dependent and must not be relied on for ledger rows.)
//
// VALUES RENDER UNSIGNED 32-BIT in the listing, so a negative row would appear in two's
// complement. Every row below is a non-negative cost or count by construction, and the
// formatter does not assume signedness either.
//
// The AXIS-1 row is in HUNDREDTHS of a cycle (the walker's fitted constants are fractional
// to two places); the formatter divides. Rows 2 and 3 are whole bytes and whole cycles;
// the axis-5 rows are whole sprite/pixel/slot counts.
pub equ SceneBudget_Axis1_MaxCycles_X100 = scene_budget_max_axis1_x100(SCENES)
pub equ SceneBudget_Axis1_Reservation    = SB_AXIS1_RESERVATION
pub equ SceneBudget_Axis1_Pool           = SB_FRAME_CYCLES
pub equ SceneBudget_Axis2_MaxBytes       = scene_budget_max_axis2(SCENES)
pub equ SceneBudget_Axis2_Reservation    = SB_AXIS2_RESERVATION
pub equ SceneBudget_Axis2_Pool           = SB_DMA_POOL_BYTES
pub equ SceneBudget_Axis3_MaxCycles      = scene_budget_max_axis3(SCENES)
pub equ SceneBudget_Axis3_Reservation    = SB_AXIS3_RESERVATION
pub equ SceneBudget_Axis3_Pool           = SB_VBLANK_WINDOW_CYCLES
// AXIS 5 (P3 Task 14) — three sub-ceiling triples, because the axis is a SAT occupancy
// with three hardware ceilings rather than one pool. The per-line SPRITE triple is the
// BINDING ceiling (axis5_binding_ceiling in the toml); the table triple is where the
// accepted-7 ruling would show the day an adopter exists. All maxes are 0 today —
// SpriteMask has zero adopters and scene() refuses it until its emission lands — and 0 is
// the true worst charge, not a placeholder.
pub equ SceneBudget_Axis5_MaxLineSprites        = scene_budget_max_axis5_line_sprites(SCENES)
pub equ SceneBudget_Axis5_LineSpriteReservation = SB_AXIS5_LINE_SPRITE_RESERVATION
pub equ SceneBudget_Axis5_LineSpritePool        = SB_AXIS5_LINE_SPRITE_POOL
pub equ SceneBudget_Axis5_MaxLinePixels         = scene_budget_max_axis5_line_pixels(SCENES)
pub equ SceneBudget_Axis5_LinePixelReservation  = SB_AXIS5_LINE_PIXEL_RESERVATION
pub equ SceneBudget_Axis5_LinePixelPool         = SB_AXIS5_LINE_PIXEL_POOL
pub equ SceneBudget_Axis5_MaxTableSlots         = scene_budget_max_axis5_table_slots(SCENES)
pub equ SceneBudget_Axis5_TableSlotReservation  = SB_AXIS5_TABLE_RESERVATION
pub equ SceneBudget_Axis5_TableSlotPool         = SB_AXIS5_TABLE_POOL
pub equ SceneBudget_PerLineScenes        = scene_budget_per_line_count(SCENES)
pub equ SceneBudget_SceneCount           = SceneRegistry_BudgetChecked
pub equ SceneBudget_CapsFolded           = SceneRegistry_CapsFolded

// NO OTHER CROSS-SCENE CHECK IS WRITTEN HERE, and the absence is a ruling.
//
// The fold is the only cross-scene FACT P1 has. Three candidates were considered and
// each was dropped for want of a failure mode it could actually catch:
//   - a SCENES.len == (number of `pub data` lines) coupling pin: the uncovered
//     direction is a scene folded but never emitted, which only INFLATES the cap mask —
//     i.e. lands on the safe side of the subset test — while the unsafe direction (a
//     record emitted whose caps were never folded) is impossible by construction, since
//     every `pub data` below initialises from `SCENES[i]` and nothing else. The pin
//     would guard nothing and would cost Task 6 an edit per config.
//   - a duplicate-scene check: two identical scenes are legal (the shipped set has
//     near-twins by design, e.g. the three Shimmer speeds) and cost only bytes.
//   - a transition-compatibility check between adjacent scenes: P1 does not know which
//     sections are adjacent. fold_caps()'s own note records that a later phase which
//     learns adjacency tightens CAP_TRANSITIONS, and that tightening is a strict subset.
// An unfalsifiable guard reads as coverage and is worse than none.

// =====================================================================
// EMISSION — the lowered ROM records.
//
// EVERY RECORD INITIALISES FROM `SCENES[i]`, never from a scene const directly, and
// that is what makes the module header's claim structural instead of aspirational: a
// record can only exist for a scene the fold has already seen. A scene authored but
// left out of SCENES emits nothing and any section that references it fails at link
// with a missing symbol.
//
// THE SIX DEFORM TABLES ARE EMITTED HERE TOO, AND THE DECLARATION ORDER BELOW IS THE
// SHIPPED ROM ORDER — table, then the records that attach it, exactly as the deleted
// data/parallax/configs.emp authored them. Neither half of that is cosmetic:
//
//   * A SECTION IS CONTIGUOUS PER MODULE. The shipped block interleaves tables and records
//     ($121C8 DeformTable_Zero, $122C8 OJZ_Default, $1230C OJZ_Underwater, $12350
//     DeformTable_OJZ_Calm, ...). Tables emitted from ojz_scenes.emp would form one
//     1536-byte run ahead of the records, which moves every table address, which changes
//     the `pcfg_deform_table_fg/bg` and `pcfg_v_deform_table_bg` words INSIDE every record.
//     Measured on the Task-6 both-sets ROM: each duplicate record differed from its shipped
//     twin in exactly the table-pointer bytes and nowhere else. So the P1 image-identity
//     gate (spec §8.1) is decided by this ordering and nothing else.
//   * THE TABLE VALUES STILL BELONG TO THE SCENES. Each `data` initialises from
//     ojz_scenes' `SceneSrc_DeformTable_*` const — the named generator call that lives
//     beside the scenes attaching it — so this module holds placement, not authorship, and
//     the witness can still compare the array VALUE (a Label's bytes are not comptime
//     readable). ojz_scenes imports the six Labels back for its attachments.
//
// The record shape is hand-picked per config and each lowerN asserts its own arity — see
// their banner. Counts used HERE: seven 1-band, one 2-band, two 4-band, ten 5-band. No
// SHIPPED config needs a 3/6/7/8-band shape — those four pairs exist because an editor
// author can reach those counts, and are instantiated by the generated editor module.
// =====================================================================
pub data DeformTable_Zero:                    [i8; 256] = SceneSrc_DeformTable_Zero
pub data ParallaxConfig_OJZ_Default:          SceneCfg4 = lower4(SCENES[0])
pub data ParallaxConfig_OJZ_Underwater:       SceneCfg4 = lower4(SCENES[1])

pub data DeformTable_OJZ_Calm:                [i8; 256] = SceneSrc_DeformTable_OJZ_Calm
pub data ParallaxConfig_OJZ_Windy:            SceneCfg1 = lower1(SCENES[2])

pub data DeformTable_Shimmer:                 [i8; 256] = SceneSrc_DeformTable_Shimmer
pub data ParallaxConfig_Shimmer_Slow:         SceneCfg1 = lower1(SCENES[3])
pub data ParallaxConfig_Shimmer:              SceneCfg1 = lower1(SCENES[4])
pub data ParallaxConfig_Shimmer_Fast:         SceneCfg1 = lower1(SCENES[5])

pub data DeformTable_Haze:                    [i8; 256] = SceneSrc_DeformTable_Haze
pub data ParallaxConfig_Haze_Slow:            SceneCfg5 = lower5(SCENES[6])
pub data ParallaxConfig_Haze:                 SceneCfg5 = lower5(SCENES[7])
pub data ParallaxConfig_Haze_Fast:            SceneCfg5 = lower5(SCENES[8])
pub data ParallaxConfig_Haze_Uniform:         SceneCfg5 = lower5(SCENES[9])

pub data DeformTable_Rocking:                 [i8; 256] = SceneSrc_DeformTable_Rocking
pub data ParallaxConfig_Rocking_Slow:         SceneCfg1 = lower1(SCENES[10])
pub data ParallaxConfig_Rocking:              SceneCfg1 = lower1(SCENES[11])
pub data ParallaxConfig_Rocking_Fast:         SceneCfg1 = lower1(SCENES[12])

pub data DeformTable_Perspective:             [i8; 256] = SceneSrc_DeformTable_Perspective
pub data ParallaxConfig_Perspective_Subtle:   SceneCfg5 = lower5(SCENES[13])
pub data ParallaxConfig_Perspective:          SceneCfg5 = lower5(SCENES[14])
pub data ParallaxConfig_Perspective_Dramatic: SceneCfg5 = lower5(SCENES[15])

pub data ParallaxConfig_WindyHaze:            SceneCfg5 = lower5(SCENES[16])
pub data ParallaxConfig_SkyHaze:              SceneCfg2 = lower2(SCENES[17])
pub data ParallaxConfig_OJZ_Caves:            SceneCfg5 = lower5(SCENES[18])
pub data ParallaxConfig_OJZ_LockedClouds:     SceneCfg5 = lower5(SCENES[19])
