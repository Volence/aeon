// games/sonic4/data/effects/ojz_effects.emp — OJZ effects library.
//
// The raster/palette/stream_vsram/ramp gate fixtures for OJZ, split out of
// data/parallax/configs.emp (which had grown into two unrelated halves: the
// parallax config records and this effects library). This file IS the
// game-side effects library (design suite §6): the Phase-3 preset format and
// the `raster_dsl` general constructors supersede the hand-laid programs
// below, but the fixtures stay as the gate.
module games.sonic4.ojz_effects in ojz_effects

// The effects gate fixtures (below) are pinned against engine.vdp's comptime CRAM
// command builder.
// `vdp_base_reg` / `VdpBase` join them for EFFECTS-W1 item 11a: OJZ_BaseSwap folds its
// mid-frame reg $02 word through the SAME helper engine/system/boot_data.emp folds the
// boot register table through, so the two cannot disagree about where a plane lives.
use engine.vdp.{VdpTarget, VdpOp, vdp_comm, VdpBase, vdp_base_reg}
// The two plane bases item 11a's word is folded FROM. Named here rather than spelled as
// literals so a re-layout moves the op instead of stranding it: engine.constants is the
// engine-side truth and games/sonic4/config/constants.emp pins vram.toml against it.
use engine.constants.{VRAM_PLANE_A, VRAM_PLANE_B}
// EFFECTS-W1 item 10a (OJZ_Reels, below): VSCROLL_COL_PAIRS is the per-column VSRAM
// buffer's own column-pair count (engine/level/parallax.emp), and the two REEL_* geometry
// constants are the game's own (games/sonic4/config/constants.emp) — both are needed by
// the ensure that ties the reel-band split to the buffer it actually writes.
use engine.parallax.{VSCROLL_COL_PAIRS}
use games.sonic4.constants.{REEL_BAND_COUNT, REEL_COLS_PER_BAND, reel_rates_ok}
// The sparse fixtures are authored through engine.effects.raster_dsl, which is a
// COMPTIME_HELPERS member and therefore ambient. What remains is the DENSE tier's
// import surface: raster_gradient_program's BODY names these, and a comptime fn's
// free names resolve at the EMISSION site's scope, so they must be visible HERE or
// they degrade to unresolved label refs.
// RASTER_MAX_FIRE_LINE joined for EFFECTS-W1 T3: OJZ_BaseSwap's BOTTOM band is the TOP
// band's two edge lines reflected through the display's horizontal midline, and the
// reflection is written against this name rather than a typed 223 so a display-height
// change moves the second band with it instead of stranding it three lines from a bottom
// that has moved.
use engine.effects.raster.{RASTER_ARM_PARK, RASTER_OPS_END, raster_arm, RASTER_MAX_FIRE_LINE}
// NOTE — no `use` of pal_stage_off is needed here, and briefly one was. fx_tint_band's body
// called it, and a comptime fn's free names resolve at the CALL SITE, so constructing a tint
// band from this file failed with four copies of "unknown function `pal_stage_off`" for a
// helper this file never names. OJZ_TwoChannel below was the FIRST fx_tint_band call site in
// the tree, which is why the preset had shipped broken since Parcel C1 unnoticed. Fixed at
// the source: fx_tint_band now inlines the staging arithmetic, pinned to pal_stage_off by a
// module-level ensure in raster_dsl — so no author has to import a helper they never wrote.
// RASTER_ARM_EVERY_LINE + OP_RUN_GRADIENT are imported even though nothing in THIS
// file names them: a comptime fn's struct-literal field values are resolved at the
// EMISSION site's scope, not the definition site (the same late-binding rule the
// `asm {}` splice helpers document), so raster_gradient_program's own constants must
// be visible HERE or they degrade to unresolved label refs.
//
// WHICH ERROR YOU GET DEPENDS ON THE DESTINATION FIELD'S TYPE. Measured 2026-08-13 by
// deleting RASTER_ARM_PARK + RASTER_OPS_END from the import above: the names DID degrade
// to label references, and the build failed as `[emit.type] expected an integer for u16,
// got label` — named and phase-early, because rgp_end_arm/rgp_end_ops are u16. Into a
// POINTER-typed field a label reference is well-typed, so emit accepts it and the catch
// DEFERS to link, arriving positionally instead: `unresolved symbol ... for fixup in
// section ... at offset ...` (sigil-link/src/lib.rs:432; comptime constants lower to zero
// link symbols, so a degraded constant has no definition to find). Not silent — deferred
// and de-named. The one genuinely silent case is a degraded name that collides with a
// real label or `equ`.
use engine.effects.raster.{RasterGradientProgram, RASTER_DENSE_WORDS_PER_LINE, raster_gradient_program, RASTER_ARM_EVERY_LINE, OP_RUN_GRADIENT, OP_RUN_RAMP, RasterRampProgram, raster_ramp_program, fp16}
// Raster_Program_None — the "raster OFF" sentinel, needed by the Parcel C2 Task 12
// presets below (total binding: a preset that means "no raster" must say so
// explicitly rather than leaving ep_raster at 0/"keep").
use engine.effects.raster.{Raster_Program_None}
use engine.effects.palette.{pal_cycle_channel, PalCycleScript1, pal_variant}
// Pal_Cycle_None — the "cycling OFF" sentinel, same total-binding reasoning as
// Raster_Program_None above.
use engine.effects.palette.{Pal_Cycle_None}
use engine.effects.palette_dsl.{cycle_channel, cycle_script1, variant}
// EffectsPreset / preset() — the Phase-3 total-binding format Task 12 switches
// OJZ act 1's sections onto (engine/effects/preset.emp).
use engine.effects.preset.{EffectsPreset, preset}
// THE RASTER CHOOSER — the generated seam this file calls (EFFECTS-W1 item 1 step 5).
// `ojz_act1_sec_raster(sec:, hand:)` is a `pub comptime fn` emitted for every act by
// tools/effects_gen.py; it returns the `EditorRaster_*` program a section's sidecar
// `rasterRef` names, or the caller's `hand:` when no sidecar names one. Today no sidecar
// in this tree carries the key, so every call returns `hand` and the chooser is zero ROM
// bytes — see the RASTER BINDING banner in the generated module.
//
// SELECTIVE IMPORT ONLY, mirroring act_descriptor.emp:55 — that is the shipped spelling for
// this module's other two choosers and it is what places its bytes. The whole-path closure
// edge (`use games.sonic4.scene_registry` below) is NOT needed here, and the reason is
// LOCAL TO THIS FILE rather than routed through another's closure: line 104 below already
// selectively imports `Scene_Editor_ojz_act1_depth` from this same module, so the line above
// adds a NAME to an edge this file already has rather than creating one.
//
// The earlier wording said the module was "already in the closure through act_descriptor".
// Same conclusion, worse ground: it made this edge's safety contingent on act_descriptor
// continuing to import that module, so it would have gone stale silently the day that
// changed. Corrected on the sigil lane's reading (2026-08-30) — they refused to take the
// justification and re-derived it from this file.
// THE OTHER TWO CHANNELS' CHOOSERS join it for EFFECTS-W1 item 5, from the same generated
// module and through the same selective edge. There is no second sidecar key: ONE
// `rasterRef` binds the WHOLE preset document, every channel it carries (empyrean
// docs/AURORA_EFFECTS_SCHEMA.md §7.2, ruling Q1), because the engine binds one preset
// RECORD per section and `ep_cycle` / `ep_variants` are fields of it. The variant chooser
// is PER SLOT because ruling Q5's three states are per index.
//
// SECTION 3 IS WHERE THEY ARE THREADED, and it costs nothing today: no sidecar names a
// document, so both choosers return `hand:` and OJZ_Preset_Sec3 is byte-identical to what
// it was. That is the whole point of threading them now — the call site is what makes the
// choosers ELABORATED (an uncalled `pub comptime fn` asserts nothing), and item 1 paid the
// same price on the raster channel for the same reason.
//
// THE PATCH CHANNELS' CHOOSERS join for EFFECTS-W1 item 4 (2026-09-03), from the same
// module and on the same rule — `ep_patch_world_ys` and `ep_patch_motion` are fields of the
// same record, so the same `rasterRef` binds them. They are PER (sec, ch) for the variant
// chooser's per-slot reason, and they return `int` rather than `Label` because a world Y and
// a packed sweep word are values, not addresses.
use games.sonic4.ojz_effects_editor_act1.{ojz_act1_sec_raster, ojz_act1_sec_cycle, ojz_act1_sec_variant, ojz_act1_sec_patch_world_y, ojz_act1_sec_patch_motion}
// THE REELS ASSOCIATION TABLE (EFFECTS-W1 item 10 step 4), from the same generated
// module. A DATA import and not a chooser, unlike its five neighbours above, because
// OJZ_Reels_Fill selects at RUNTIME rather than at comptime — the active scene is not
// known until the section is entered. It is therefore ALWAYS EMITTED by the generator
// (one terminator long with no authored reels, zero bytes in release), which is what
// lets the `lea` below be unconditional.
use games.sonic4.ojz_effects_editor_act1.{EditorReelBindings_OJZ_Act1}
// Parcel W: section 0 binds its parallax config through the PRESET (ep_parallax) rather
// than inheriting the act default, because the overlay's anchor channel has to be the same
// channel the patched palette boundary rides. This is also the first ep_parallax binding in
// the tree — the field existed since C2 and was 0 in every preset, i.e. an authoring surface
// that had never once executed.
// TWO LINES, AND BOTH ARE LOAD-BEARING (scanline-P1 Task 9). The name list is the symbol;
// the WHOLE-PATH line is the CLOSURE EDGE. games.sonic4.scene_registry is not in sigil's
// module registry (crates/sigil-harness/src/native.rs) — it is placed by being reached —
// and a selective import alone injects a clone of the imported name into THIS scope without
// elaborating the callee (Task 5's probe). Cut the whole-path line and the registry's
// capability-subset ensure, every guard in engine/level/scene_dsl.emp behind it, and the
// twenty records themselves go dark: an unreached module gets parse + scan coverage and
// ZERO body elaboration. This edge replaces the temporary one that lived in the now-deleted
// data/parallax/configs.emp.
use games.sonic4.scene_registry
use games.sonic4.scene_registry.{ParallaxConfig_OJZ_Underwater}
// P3 TASK 11 — the scene-lowering equivalence proof below needs TWO things, and they are two
// different axes of the same rule. The WITNESS SCENE is a const, and an imported const's
// initializer re-evaluates in THIS module's scope (Task 5's probe finding), so every name
// `scene(layer(..), no_layer())` spells has to resolve here; the LOWERING is a function, and a
// comptime fn's free names resolve at the CALL SITE. engine.level.scene_dsl is NOT a sigil
// COMPTIME_HELPERS member, so neither travels on its own — hence the glob, which is mandatory
// for scene_dsl and is documented as such at the top of that file. (parallax_dsl IS a helper
// member, so FACTOR_* is already ambient and needs no line here.)
use games.sonic4.ojz_scenes.{Scene_VSplitWitness}
// THE AURORA-AUTHORED SHOWCASE SCENE (owner decision d-15). Imported for its `vsplit`
// attachments only — the scene's parallax half reaches the ROM through the generated
// module's own `lower5()` binding and never through this file. A CONST import, so its
// `scene(..)` initializer re-evaluates HERE: legal and cheap because a Scene is a pure
// comptime value and this one attaches no deform-table Label (EMP_PITFALLS §2/§8's
// clone-injection trap is about tables, and this scene has none).
//
// THE NAME IS GENERATED. `Scene_Editor_<id>` where <id> is the editor JSON's filename stem
// (tools/effects_gen.py's render_scene), so renaming games/sonic4/data/editor/effects/
// ojz_act1_depth.json breaks this line at link with a name, which is the failure you want.
use games.sonic4.ojz_effects_editor_act1.{Scene_Editor_ojz_act1_depth}
use engine.level.scene_dsl.*
// STRICTLY REDUNDANT, KEPT AS DOCUMENTATION — and the redundancy is measured, not
// assumed: deleting this line leaves both shapes byte-identical. engine.effects.raster_dsl
// is a COMPTIME_HELPERS member, and the native harness DROPS every source `use` whose base
// is a helper module, then prepends one glob per helper to every module
// (`normalize_helper_imports`, sigil crates/sigil-harness/src/native.rs:1077-1126). So this
// exact line is deleted and regenerated on every build; it cannot be load-bearing.
// It stays because the fixtures below call raster_dsl's constructors (`fire`, `stream_cram`,
// `reg_sh_on`, `region_boundary`, `raster_program`, `raster_words`, `first_mismatch`) as bare
// names, and this is the only place in the file that says where they come from. If
// raster_dsl ever leaves the helper set, this line is what keeps the file building —
// and what keeps the module's own `ensure`s evaluated, since an unimported comptime
// module's module-level `ensure`s do not fail, they simply never run.
use engine.effects.raster_dsl.*

// ===========================================================================
// EFFECTS P1 GATE FIXTURES — the first raster program and the first per-section
// palette. These live beside the parallax configs because this file IS the
// game-side effects library (design suite §6); the Phase-3 preset format and the
// `raster_dsl` general constructors supersede the hand-laid words below.
// ===========================================================================

// The CRAM-write command longword for colour 0, split into the two words the
// program format carries. Pinned against the comptime builder so a change in
// engine.vdp's command encoding fails the build instead of writing to VRAM.
// The gate writes CRAM entry $4A = palette line 2, entry 5 — measured to be OJZ's
// single most-used ground colour (~54% of the lower-screen pixels). Colour 0 (the
// backdrop) was the obvious first choice and is the WRONG one: OJZ's art covers the
// backdrop everywhere, so the effect was invisible and the gate unfalsifiable.
// Pinned against the comptime builder so an encoding change fails the build rather
// than quietly writing somewhere else.
const OJZ_TEST_CRAM_ADDR = $4A
ensure(vdp_comm(OJZ_TEST_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C04A0000,
       "vdp_comm's CRAM encoding changed — the raster DSL now derives OJZ_TestRaster's command words, so a drift here moves the emitted program")

// OJZ_TestRaster — the P1 acceptance program: below screen line 120, turn
// Shadow/Highlight ON and repaint OJZ's dominant ground colour bright red. Two
// different mechanisms (a mode-register write and a CRAM write) firing at the same
// line, so the gate exercises the multi-op path rather than a single write — and
// the CRAM half is chosen to be objectively measurable from a screenshot.
//
// The fire schedule below is now DERIVED. Kept as prose because it is what the arm
// words mean, and the walk-through is the thing a reader needs:
//   fire 0 @ line 0    priming, arm = $8A00 | (120 - 3) = $8A75 (117)
//   fire 1 @ line 1    priming, arm = park (nothing scheduled after the event)
//   fire 2 @ line 119  the event; its writes land on line 120
// VBlank leaves reg $0A = 0 -> fire 0 at line 0, reload 0 -> fire 1 at line 1,
// reload 117 -> fire 2 at 1 + 117 + 1 = 119. Effect on 120.
//
// pal_dirty_mask is DERIVED from the CRAM address ($4A >> 5 = line 2), so the mask
// can no longer name the wrong line — the observed P1 bug, where a mask of %0001
// against an op writing line 2 left the red latched over the whole ground instead of
// only below the split.
const OJZ_TEST_PROG = [
    fire(120, [ reg_sh_on(),                       // S/H ON below the line
                stream_cram($4A, [$000E]) ]),      // bright red at line 2 entry 5
]

// THE PIN (design spec 8.1). The hand-authored words are the ones measured on
// hardware during P1; the DSL must reproduce them exactly. Retained deliberately
// rather than deleted: a `const` emits nothing, and it turns a Parcel-C/D regression
// from "golden ROM differs" into a named index — the negative control that proved this
// pin bites flipped the colour word and got "diverges ... at index 15". It retires in
// Parcel D together with the fixture it pins (design spec 8.2).
// Literals on purpose: a pin sharing symbols with the encoder it pins is weaker.
// raster_dsl's module-level ensures hold these against engine.effects.raster.
const OJZ_TEST_HAND = [
    %0100,                      // pal_dirty_mask — the WHOLE header, one word
    $8A75, 0,                   // fire 0 — priming; arm = $8A00 | (120 - 3)
    $8AFF, 0,                   // fire 1 — priming; nothing after the event, so park
    $8AFF, 2,                   // fire 2 — the event, two ops
      0, $8C89,                 // OP_SET_REG
      2, $C04A, $0000,          // OP_CRAM, command longword split
                 18,            // spin — SOLVED, not authored (substrate item 1c): the
                                //   blanking spin is per-op program data whose value the
                                //   lowering derives from the op's POSITION. Hand-derived
                                //   here by the solver's own arithmetic, since this pin
                                //   would be worthless if it shared a symbol with the
                                //   encoder: a 1-word cram sitting SECOND after a reg_set
                                //   reaches its delay site at p = 40 (the SetReg) + 8
                                //   (fetch) + 8 (the not-taken zero pre-test) + 18
                                //   (dispatch hit at depth 0) + 36 (pre-burst arm) = 110
                                //   cycles, its burst spans 0 (one word), and
                                //   round((366 - 110 - 14 - 122.9/2) / 10) = round(18.055)
                                //   = 18. Sits between command and count-1. (17 at END
                                //   351; 19 at item 6's 371, whose SR removal put the
                                //   op-walk origin earlier; 18 since this parcel re-derived
                                //   the anchor to 366 with a fixed least-squares fold.)
                                //
                                //   WAS 10 UNTIL TIER-3 ITEM 2, and the +7 is the whole
                                //   parcel arriving in shipped content: the SetReg ahead
                                //   of this cram went 110 cycles -> 40 (its dispatch is
                                //   now one taken beq.s instead of five failed rungs), so
                                //   the burst reaches the window 70 cycles early and the
                                //   solver spends 62 of them waiting instead. The FIRE
                                //   still costs 8 cycles less than it did; what changed is
                                //   where inside the fire the time is spent, which is
                                //   exactly what a position-aware solver is for.
                 0, $000E,      // count-1, the colour
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_TEST_PROG) == OJZ_TEST_HAND.len,
       "OJZ_TestRaster: DSL counts {raster_words(OJZ_TEST_PROG)} words, the hand program is {OJZ_TEST_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_TEST_PROG), OJZ_TEST_HAND) == -1,
       "OJZ_TestRaster: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_TEST_PROG), OJZ_TEST_HAND)}")

pub data OJZ_TestRaster: [u16; raster_words(OJZ_TEST_PROG)] = raster_program(OJZ_TEST_PROG)

// ===========================================================================
// OJZ_BandDemo — THE FIRST PALETTE BAND IN THIS TREE.
// ===========================================================================
//
// The band-ownership design (docs/superpowers/specs/2026-08-28-raster-band-ownership-
// design.md) §14.5 and §15.7 both say it out loud: `band()` and `pal_restore` appear
// ONLY in poison fixtures and in raster_dsl.emp's own pins, so every ownership walk in
// the engine has, until this data statement, run exclusively over test material. §15.7's
// closing bullet is the standing instruction this module is answering:
//
//     "The first real band anyone authors is still the first time these walks run on
//      something a player sees. Do not describe N bands as exercised — it is admitted,
//      which is a different claim."
//
// This is that first band, and it is THREE of them, because "more than one restore per
// program" is the capability parcel P2a unlocked and a single band would exercise only
// what P1 already had.
//
// ---- WHAT IT LOOKS LIKE, AND WHY IT IS SHAPED THIS WAY ----------------------
// Three broad horizontal bands across the lower screen, each repainting OJZ's dominant
// ground colour to a different step of the act's OWN ground ramp, with the base colour
// showing through in the seams between them. Read top to bottom the ground goes
// shade -> base -> lit -> base -> full sun: a staged light wash, not a stripe test.
//
// THE COLOURS ARE THE ACT'S, NOT INVENTED. games/sonic4/data/generated/ojz/act1/
// ojz_palette.bin's CRAM line 2 carries a five-step ground ramp at entries 3..7 —
// $0224, $0248, $026A, $048C, $06AE — and entry 5 ($026A) is its midpoint AND the
// address OJZ_TestRaster already measured as OJZ's single most-used ground colour
// (~54% of the lower-screen pixels; see OJZ_TEST_CRAM_ADDR's note above). Banding the
// midpoint entry to the ramp's other steps is therefore both the most VISIBLE possible
// choice and a palette-native one, which is what keeps it reading as art direction
// rather than as a diagnostic. A band of $000E-style pure red would be easier to
// measure and would look like exactly what §15.7 warns against.
//
// ---- THE ADDRESS IS SHARED, NOT TRANSCRIBED --------------------------------
// OJZ_TEST_CRAM_ADDR is reused rather than respelled: there is one fact ("OJZ's
// dominant ground colour lives at CRAM byte $4A") and it has one source in this file.
// It is already pinned against vdp_comm's encoding above, so this program inherits that
// pin for free. $4A >> 5 = palette line 2, which is what makes these bands legal at all
// — stream_cram and pal_restore both refuse line 0, the character's line.
//
// ---- WHY THE SEAMS ARE NOT OPTIONAL ----------------------------------------
// The bands do NOT touch. Contiguous bands (band N's `bot` == band N+1's `top`) put a
// restore and an ON op on the SAME fire line, and raster_dsl's per-fire stream ceiling
// of 2 is documented as unreachable in practice: "two bursts in one fire span at least
// 116 cycles against a 122.9-cycle window, and the two margins want 30 more, so a
// second stream op cannot be placed at all — check_landings will refuse it by name."
// So the eight-line seams below are a hardware fact wearing a visual justification, and
// they earn their keep twice: they are also the NEGATIVE CONTROL that lives inside the
// effect, where a witness can sample base colour between two bands rather than only
// outside all of them.
//
// ---- THE CAP IS THREE, AND IT IS DERIVED -----------------------------------
// Not quoted from §7.1's table — §7.1 itself forbids that ("anyone re-deriving this
// after a wire-format change must go back to op_size, never to this table"). The
// arithmetic is re-stated in the word-count ensure below and is held every build by
// raster_dsl.emp's own zz_band_ownership_fixtures in BOTH directions (three must
// build, four must overflow). This program is exactly at the ceiling.
//
// ---- WHAT THIS PROGRAM DELIBERATELY IS NOT ---------------------------------
//   * NOT S/H (`sh: 0` on all three). A Shadow/Highlight band emits a third fire and
//     costs a de-mix write; it is a separate capability and mixing it in would make a
//     failure ambiguous between the band machinery and the S/H machinery.
//   * NOT patchable. Design rule 6, both halves, is still in force (P2b is unbuilt):
//     neither a band's ON fire nor its restore fire may be patchable. These are static.
//   * NOT carrying an `offscreen_ship` fire. CLAIM 6 refuses a band in any program that
//     has one, which is what excludes section 0's OJZ_TwoChannel from bands entirely.
//   * NOT hand-pinned word-for-word, and that is a decision rather than an omission.
//     OJZ_TestRaster carries an OJZ_TEST_HAND twin, but every stream op in a program
//     also carries a SOLVED spin word that the lowering derives from the op's position
//     in its fire (raster_dsl.emp's window-anchor solver). A hand twin for this program
//     would mean me transcribing six solved spins, which is not an independent check of
//     the encoder — it is a copy of it — and a hand-adjusted spin is wrong by
//     definition. The pins below check STRUCTURE (fire count, word count from op_size,
//     dirty mask) and leave the spins to the solver that owns them.
//
// ---- IT EMITS IN BOTH SHAPES, ON PURPOSE -----------------------------------
// Only the DEBUG hotkey that INSTALLS it is shape-gated (games/sonic4/test/
// ojz_scroll_test.emp, Debug_BandDemoHotkey). The program itself is content and is
// emitted unconditionally, exactly like every other program in this file. Gating the
// data too would mean the release shape compiled a different set of band guards from
// the one the DEBUG shape ships, which is the opposite of what a first consumer is for.
// Cost: raster_words(...) words = 110 bytes in each of s4.bin and s4.debug.bin.
// ---------------------------------------------------------------------------

// The three ramp steps, named for what they do to the ground rather than for their
// index in the palette file. Base (the colour the seams show) is $026A and is NOT
// spelled here: it is whatever the act palette holds at OJZ_TEST_CRAM_ADDR, and the
// restore streams it back from Palette_Ship_Snap rather than from a literal — which is
// precisely the property that makes a band a band and not a pair of pokes.
const OJZ_BAND_SHADE = $0224        // line 2 entry 3 — two ramp steps below base
const OJZ_BAND_LIT   = $048C        // line 2 entry 6 — one ramp step above base
const OJZ_BAND_SUN   = $06AE        // line 2 entry 7 — the ramp's bright end

// The six authored screen lines. A band covers `top` .. `bot - 1` inclusive: the ON
// op's writes land ON line `top` and the restore's land ON line `bot`, so the height
// band() charges (`bot - top`) and the number of banded rows are the same number.
// All six sit inside fire()'s 3..223 and all three bands clear the height minimum by
// an order of magnitude (28 rows against the 2 a one-word cram band needs).
const OJZ_BAND_1_TOP = 120
const OJZ_BAND_1_BOT = 148
const OJZ_BAND_2_TOP = 156
const OJZ_BAND_2_BOT = 184
const OJZ_BAND_3_TOP = 192
const OJZ_BAND_3_BOT = 220

// Seam width is stated once and checked, so "the bands do not touch" is a build-time
// fact rather than something a reader has to subtract by hand. A seam of 0 is the
// contiguous case check_landings refuses, and it would refuse it with a message about
// stream ops rather than about bands — this ensure is the earlier, clearer diagnosis.
const OJZ_BAND_SEAM = 8
ensure(OJZ_BAND_2_TOP - OJZ_BAND_1_BOT == OJZ_BAND_SEAM && OJZ_BAND_3_TOP - OJZ_BAND_2_BOT == OJZ_BAND_SEAM,
       "OJZ_BandDemo: the two seams are {OJZ_BAND_2_TOP - OJZ_BAND_1_BOT} and {OJZ_BAND_3_TOP - OJZ_BAND_2_BOT} lines, not the {OJZ_BAND_SEAM} this program is documented and witnessed at. A seam of 0 puts a restore and an ON op on one fire line, which check_landings refuses for a per-fire reason that never mentions bands.")

const OJZ_BAND_DEMO_PROG = compose([
    band(OJZ_BAND_1_TOP, OJZ_BAND_1_BOT, stream_cram(OJZ_TEST_CRAM_ADDR, [OJZ_BAND_SHADE]), 0),
    band(OJZ_BAND_2_TOP, OJZ_BAND_2_BOT, stream_cram(OJZ_TEST_CRAM_ADDR, [OJZ_BAND_LIT]),   0),
    band(OJZ_BAND_3_TOP, OJZ_BAND_3_BOT, stream_cram(OJZ_TEST_CRAM_ADDR, [OJZ_BAND_SUN]),   0),
])

// PIN 1 — SIX FIRES. band(sh: 0) emits TWO fires (the ON and its restore) and compose
// merges nothing here because all six lines are distinct, so three bands must arrive as
// six records. This is the pin that notices a band() that silently dropped a restore:
// the program would still build, still fit the buffer, and still look right at the top
// edge of each band while never putting the colour back.
ensure(OJZ_BAND_DEMO_PROG.len == 6,
       "OJZ_BandDemo: composed to {OJZ_BAND_DEMO_PROG.len} fires, not the 6 that three sh:0 bands must emit (one ON + one restore each, on six distinct lines so compose merges none of them).")

// PIN 2 — THE WORD COUNT, DERIVED FROM op_size AND NOTHING ELSE.
// A band over a 1-word stream_cram is two records: the ON record is 2 + op_size(Cram,1)
// = 2 + 6 = 8 words, and the restore record is 2 + op_size(PalRestore) = 2 + 6 = 8, so
// 16 words per band. raster_words adds 7 fixed words (the pal_dirty_mask header, the two
// priming records, and the terminator). Three bands: 7 + 3*16 = 55, against the 64-word
// RASTER_BUF_WORDS buffer — nine words of headroom, and a fourth band would need
// sixteen. This program therefore sits EXACTLY at the shipped cap, which is the whole
// reason it is three bands and not two.
ensure(raster_words(OJZ_BAND_DEMO_PROG) == 7 + 3 * 16,
       "OJZ_BandDemo: raster_words says {raster_words(OJZ_BAND_DEMO_PROG)} words where op_size gives 7 fixed + 3 bands x (2+6 ON, 2+6 restore) = 55. If this moved, the wire format moved and the three-band cap must be re-derived from op_size before this number is touched.")

// PIN 3 — THE ENCODER AGREES WITH THE SIZER. raster_program re-derives the total through
// a second path and holds itself to raster_words; pinning the emitted length here makes
// that agreement visible at the call site too, and makes a buffer overflow show up as a
// named number rather than as raster_program's generic ceiling message.
ensure(raster_program(OJZ_BAND_DEMO_PROG).len == raster_words(OJZ_BAND_DEMO_PROG),
       "OJZ_BandDemo: raster_program emitted {raster_program(OJZ_BAND_DEMO_PROG).len} words where raster_words counted {raster_words(OJZ_BAND_DEMO_PROG)}.")

// PIN 4 — THE DIRTY MASK NAMES LINE 2, AND ONLY LINE 2. Raster_VBlank ORs this into
// Palette_Dirty every frame so the base palette is re-asserted under the bands; a mask
// naming the WRONG line is the observed P1 bug (a mask of %0001 against ops writing line
// 2 left the tint latched over the whole ground instead of only inside the band). All
// three bands write OJZ_TEST_CRAM_ADDR, so the mask is one bit and the bit is derived
// from the address rather than spelled: $4A >> 5 = 2.
ensure(raster_program(OJZ_BAND_DEMO_PROG)[0] == 1 << (OJZ_TEST_CRAM_ADDR >> 5),
       "OJZ_BandDemo: pal_dirty_mask is {raster_program(OJZ_BAND_DEMO_PROG)[0]}, not the {1 << (OJZ_TEST_CRAM_ADDR >> 5)} that CRAM byte {OJZ_TEST_CRAM_ADDR} (palette line {OJZ_TEST_CRAM_ADDR >> 5}) requires. A wrong line here leaves a band's colour latched past its restore.")

// PIN 5 — THE EMITTED SCHEDULE LANDS ON THE AUTHORED LINES.
//
// This is the pin that matters, and it is the only one here that checks the property
// the owner will actually be looking at: not "a band program was built" but "the bands
// arrive at lines 120/148/156/184/192/220". Pins 1-4 all measure SIZE and SHAPE, and a
// program can be exactly 55 words with a correct dirty mask and six fires while its
// HInt schedule walks the beam to the wrong six rows.
//
// It is a DECODE of the emitted words, not a restatement of the authored ones. The
// runtime never reads a screen line: `Raster_HInt` publishes each record's arm word into
// VDP reg $0A and the NEXT interrupt arrives that many lines later, so the schedule is a
// chain of relative gaps and the absolute rows are an emergent property of the whole
// chain. Reconstructing them here from the emitted arm bytes is therefore an independent
// path to the same fact — a lowering that mis-encoded one gap would still satisfy every
// other pin in this file.
//
// THE CONVENTION, spelled out because it is off-by-one in two places at once and
// OJZ_TestRaster's header is the only other statement of it in the tree: VBlank leaves
// reg $0A = 0, so priming records 0 and 1 fire on lines 0 and 1; record i's arm word
// schedules the gap from fire i+1 to fire i+2 (Raster_HInt publishes FIRST, then runs
// its ops); a reload of N lands the next fire N+1 lines later; and a fire's writes land
// on the line AFTER the one it fires on. Hence `+ 1` twice, in different places.
//
// THE WORD INDICES ARE DERIVED FROM THE RECORD STRIDE, not counted off a hexdump. Every
// real record here is one 1-word `stream_cram` or one `pal_restore`, both of which are
// 2 + 6 = 8 words; the two priming records are 2 words each and carry no ops. So the arm
// words sit at 1, 3, then 5 + 8k. If a band ever gains an op this stride is wrong — and
// PIN 2's word count is what goes red first, naming op_size.
const OJZ_BAND_REC_WORDS = 8
ensure(raster_words(OJZ_BAND_DEMO_PROG) == 7 + 6 * OJZ_BAND_REC_WORDS,
       "OJZ_BandDemo: the {OJZ_BAND_REC_WORDS}-word record stride PIN 5 decodes with does not reconstruct the {raster_words(OJZ_BAND_DEMO_PROG)}-word program (7 fixed + 6 records). PIN 5's arm-word indices are derived from this stride, so a record that grew an op would make it decode the wrong words and compare them confidently.")

comptime fn ojz_band_demo_effect_lines() -> array {
    let p = raster_program(OJZ_BAND_DEMO_PROG)
    // The arm byte is the low 8 bits of $8Axx — the reg $0A write the record publishes.
    let s = OJZ_BAND_REC_WORDS
    let f2 = 1  + (p[1]             & $FF) + 1   // first real fire: from the line-1 priming record
    let f3 = f2 + (p[3]             & $FF) + 1
    let f4 = f3 + (p[5]             & $FF) + 1
    let f5 = f4 + (p[5 + s]         & $FF) + 1
    let f6 = f5 + (p[5 + s * 2]     & $FF) + 1
    let f7 = f6 + (p[5 + s * 3]     & $FF) + 1
    // A fire's writes land on the line after it fires on.
    return [f2 + 1, f3 + 1, f4 + 1, f5 + 1, f6 + 1, f7 + 1]
}

ensure(ojz_band_demo_effect_lines()[0] == OJZ_BAND_1_TOP, "OJZ_BandDemo: band 1 turns ON at emitted screen line {ojz_band_demo_effect_lines()[0]}, not the authored {OJZ_BAND_1_TOP}.")
ensure(ojz_band_demo_effect_lines()[1] == OJZ_BAND_1_BOT, "OJZ_BandDemo: band 1 restores at emitted screen line {ojz_band_demo_effect_lines()[1]}, not the authored {OJZ_BAND_1_BOT}.")
ensure(ojz_band_demo_effect_lines()[2] == OJZ_BAND_2_TOP, "OJZ_BandDemo: band 2 turns ON at emitted screen line {ojz_band_demo_effect_lines()[2]}, not the authored {OJZ_BAND_2_TOP}.")
ensure(ojz_band_demo_effect_lines()[3] == OJZ_BAND_2_BOT, "OJZ_BandDemo: band 2 restores at emitted screen line {ojz_band_demo_effect_lines()[3]}, not the authored {OJZ_BAND_2_BOT}.")
ensure(ojz_band_demo_effect_lines()[4] == OJZ_BAND_3_TOP, "OJZ_BandDemo: band 3 turns ON at emitted screen line {ojz_band_demo_effect_lines()[4]}, not the authored {OJZ_BAND_3_TOP}.")
ensure(ojz_band_demo_effect_lines()[5] == OJZ_BAND_3_BOT, "OJZ_BandDemo: band 3 restores at emitted screen line {ojz_band_demo_effect_lines()[5]}, not the authored {OJZ_BAND_3_BOT}.")

// ---- THE EMISSION IS DEBUG-GATED; EVERY PIN ABOVE IS NOT --------------------
//
// CORRECTED 2026-08-28, and the first version of this parcel had it wrong. The program
// was emitted unconditionally on the argument that "the band program is content, only
// the installer is equipment". That argument does not survive its own consequence: the
// installer emits ZERO bytes in the release shape (`Debug_BandDemoHotkey` collapses onto
// the shared zero-byte address in `s4.lst`), so an unconditional emission puts a 110-byte
// raster program in the ROM the owner ships that **nothing in that shape can install**.
// That is a dormant scaffold, and this tree deletes those — the same ruling that kept
// `LO_SUPPRESS` unbuilt rather than built "for later".
//
// THIS FILE ALREADY RECORDS THE PRECEDENT, thirty lines below at OJZ_Preset_Sec0: "No
// patched program had RENDERED since Parcel C2 ... Every P-a guard was therefore proving
// properties of a program nothing could display." Unreachable effect data is a defect
// here, with a name, in this module. Emitting a second one would have been incoherent.
//
// WHAT IS **NOT** GATED, AND THIS IS THE WHOLE POINT OF SPELLING IT THIS WAY: the program
// CONSTANT and all seven `ensure`s above it are untouched by this gate. `ensure` is
// comptime and emits nothing, so `raster_program(OJZ_BAND_DEMO_PROG)` — and through it
// `check_band_pairing`, `check_band_ownership`, `check_landings`, `check_density` and the
// whole guard stack — still runs on this three-band program in **every shape, on every
// build**, release included. PIN 5's arm-chain decode is likewise unconditional.
//
// So the trade the gate would otherwise force is NOT taken: nothing here becomes a
// DEBUG-only gate. What changes is only which shapes carry the BYTES. The ownership
// walks stop being vacuous in the release shape too, which is the claim §14.5 asked for
// and which a `pub data` gate alone would have quietly narrowed to one shape.
//
// THE LENGTH IS SHAPE-DEPENDENT, the `SongTable` / `SONG_COUNT` spelling from
// games/sonic4/data/sound/mt_bank.emp. A bare `Data.empty` else-arm was tried first and
// sigil refuses it here — "data `OJZ_BandDemo` needs a type annotation (its initializer
// does not name a type)" — because `raster_program` returns an untyped comptime array and
// the `[u16; N]` annotation is what makes these words rather than bytes. So the WIDTH
// stays declared in both shapes and only the COUNT collapses to zero. The symbol still
// exists in release, emits no bytes, and its label collapses onto its neighbour's address
// exactly as the four zero-byte debug procs do.
const OJZ_BAND_DEMO_EMIT_WORDS = if DEBUG == 1 { raster_words(OJZ_BAND_DEMO_PROG) } else { 0 }
pub data OJZ_BandDemo: [u16; OJZ_BAND_DEMO_EMIT_WORDS] = if DEBUG == 1 { raster_program(OJZ_BAND_DEMO_PROG) } else { [] }

// ===========================================================================
// OJZ_BaseSwap — EFFECTS-W1 DoD ITEM 11a: THE MID-FRAME NAMETABLE-BASE CHANGE.
//
// Batman & Robin's trick, on this engine, with ZERO new VRAM and ZERO new engine code:
// partway down the frame, re-point a plane's base register at an address that ALREADY
// holds a valid nametable — the OTHER plane's — so a band of the screen draws the wrong
// map in that layer. Design:
// docs/superpowers/designs/2026-09-03-vram-replan-item0-design.md §2 row 11a and §4
// step 1, which sequences this BEFORE the Option-P VRAM purchase precisely because it
// costs no tiles.
//
// ---- TWO BANDS, ROLES INVERTED BETWEEN THEM (EFFECTS-W1 T3, 2026-09-04) ----
// ⚠ THIS PROGRAM GREW ITS SECOND BAND ON 2026-09-04 AND THE SECOND BAND WRITES A
// DIFFERENT REGISTER. Owner ask, verbatim: "it should be the foreground in the background
// layer at the top and the background in the foreground layer at the bottom of screen".
// Plane A ($C000) is the foreground layer and Plane B ($E000) the background layer
// (engine/system/constants.emp), so the two halves of that sentence are two DIFFERENT
// registers, not one register at two lines:
//
//   TOP band     the BACKGROUND LAYER draws the FOREGROUND's map.
//                Plane B's base register — reg $04, NOT $02 — points at VRAM_PLANE_A.
//   BOTTOM band  the FOREGROUND LAYER draws the BACKGROUND's map.
//                Plane A's base register — reg $02 — points at VRAM_PLANE_B.
//                This is exactly what F2 shipped, moved from the top of the screen to
//                the bottom, where the owner asked for it.
//
// THE TWO REGISTERS ARE INDEPENDENT AND BOTH ARE SHADOWED. engine/structs.emp's
// `VdpShadow` carries `vdp_plane_a` (reg $02) and `vdp_plane_b` (reg $04) as separate
// bytes, and engine/system/vdp_init.emp's Flush_VDP_Shadow walks the WHOLE table with no
// register filter at the top of every VBlank — VERIFIED at the flush, not taken from a
// comment. So neither band can leak into the next frame, and neither needs a frame-top
// reset word in an `init[]` header (engine/effects/raster.emp's "a program carries NO
// frame-top register words" ruling; see the next block for what that ruling does NOT say).
//
// WHY THE TWO BANDS DO NOT INTERFERE. They name disjoint registers, so nothing about the
// top band's excursion constrains the bottom band's, and each closes on its OWN home word
// — the very byte boot_data.emp's VDP_REG_PLANE_A / VDP_REG_PLANE_B fold through the same
// `vdp_base_reg` helper. The four words below are FOUR SEPARATE FOLDS, never a hex
// literal, so a VRAM re-layout moves all four together or fails the build by name.
//
// ---- WHY THERE IS NO FRAME-TOP OFF WORD, AND WHY THAT IS NOT THE SAME AS "ONE OP" ----
// ⚠ CORRECTED 2026-09-04 (EFFECTS-W1 F2). This banner used to open "WHY THIS IS ONE OP
// AND NOT TWO — there is no paired OFF edge and there must not be one", and that sentence
// over-read its own ruling by exactly one scope. The ruling in `engine/effects/raster.emp`
// is about a FRAME-TOP reset word in an `init[]` header the VBlank would replay; the flush
// makes that word unnecessary. THAT RULING SAYS NOTHING ABOUT A SECOND MID-FRAME FIRE, and
// reading it as "one op" cost a whole review cycle. The frame-top restore is what makes an
// effect not leak into the NEXT frame; it is not what bounds it WITHIN a frame. A single
// ON edge therefore paints from its line to the BOTTOM OF THE DISPLAY, which is not a band
// — it is the rest of the screen. So each band here is TWO fires, ON and OFF, and the OFF
// edge writes the very HOME word the flush would have written at the next frame top.
//
// A change meant to SURVIVE the frame would be `Set_VDP_Reg` instead (it writes the
// shadow and the flush delivers it). This is the MID-FRAME door, so it is the raster op.
// A change meant to hold for the WHOLE frame on BOTH registers already exists and is not
// this: `engine.parallax.Parallax_Set_Roles_Swapped` (item 10b).
//
// ---- THE WORDS ARE FOLDED, NEVER TRANSCRIBED -------------------------------
// `vdp_base_reg` is the same comptime fold engine/system/boot_data.emp derives the boot
// register table from, and it carries the residue `ensure` that refuses a base outside the
// register's own granule — $2000 for reg $02 (shift 10) and $2000 for reg $04 (shift 13),
// engine/vdp.emp's `vdp_base_granule`/`vdp_base_shift` match arms. So moving either plane
// moves the ops with it, and a base a register cannot encode fails the build by name
// instead of pointing the VDP at `base - dropped` while every consumer writes `base`.
//
// THE $8400 PREFIX IS THE OTHER HALF OF THE FOLD AND IT IS NOT COSMETIC. `vdp_base_reg`
// returns the register's BYTE; the caller supplies the register selector. Reg $04's
// selector is $8400 and reg $02's is $8200 — pairing PlaneB's byte with $8200 would write
// Plane A's register with a value shifted by 13 instead of 10, which is a legal-looking
// word pointing at a base three bits away from anything. The guards below are what stop
// that pairing from being expressible silently.
const OJZ_BASE_SWAP_TOP_WORD = $8400 | vdp_base_reg(VdpBase.PlaneB, VRAM_PLANE_A)
// The word reg $04 carries at frame top, by the SAME fold from the SAME helper — the one
// the VBlank flush restores, and the one boot_data.emp's VDP_REG_PLANE_B folds. It is the
// TOP band's OFF-edge argument as well as the guard's other operand.
const OJZ_BASE_SWAP_TOP_HOME = $8400 | vdp_base_reg(VdpBase.PlaneB, VRAM_PLANE_B)
// The BOTTOM band: reg $02 borrows Plane B's nametable. F2's word, unchanged.
const OJZ_BASE_SWAP_BOT_WORD = $8200 | vdp_base_reg(VdpBase.PlaneA, VRAM_PLANE_B)
// The word Plane A carries at frame top, same fold, same helper — the BOTTOM band's OFF
// edge, i.e. writing the flush's own word mid-frame is what closes the band.
const OJZ_BASE_SWAP_BOT_HOME = $8200 | vdp_base_reg(VdpBase.PlaneA, VRAM_PLANE_A)
// The guards that make each band a DEMONSTRATION rather than a no-op. If a plane's borrowed
// base and its own base ever fold to the same register byte — because a re-layout moved one
// of them, or because a shift changed — the ON op would write the base that register already
// has and the band would be invisible while every other check here stayed green. That is the
// exact shape of failure this fixture exists to rule out, so it is refused by name rather
// than left to a screenshot. TWO ensures, one per band, because the two bands name DIFFERENT
// registers and a single check over one of them would leave the other's no-op unsaid.
ensure(OJZ_BASE_SWAP_TOP_WORD != OJZ_BASE_SWAP_TOP_HOME,
       "OJZ_BaseSwap TOP band: the mid-frame word ({OJZ_BASE_SWAP_TOP_WORD}) is the SAME word reg $04 already carries at frame top ({OJZ_BASE_SWAP_TOP_HOME}), so the op re-points Plane B at the base it is already using and the top band draws nothing different. VRAM_PLANE_A ({VRAM_PLANE_A}) and VRAM_PLANE_B ({VRAM_PLANE_B}) must fold to DIFFERENT reg $04 bytes for the top band to be demonstrable at all — either the two planes now share a base, or vdp_base_reg's PlaneB shift changed.")
ensure(OJZ_BASE_SWAP_BOT_WORD != OJZ_BASE_SWAP_BOT_HOME,
       "OJZ_BaseSwap BOTTOM band: the mid-frame word ({OJZ_BASE_SWAP_BOT_WORD}) is the SAME word reg $02 already carries at frame top ({OJZ_BASE_SWAP_BOT_HOME}), so the op re-points Plane A at the base it is already using and the bottom band draws nothing different. VRAM_PLANE_A ({VRAM_PLANE_A}) and VRAM_PLANE_B ({VRAM_PLANE_B}) must fold to DIFFERENT reg $02 bytes for the bottom band to be demonstrable at all.")
// THE TWO BANDS MUST NAME DIFFERENT REGISTERS, and this is the T3 inversion stated as a
// refusal rather than as prose. If both bands ever folded onto one register the program
// would still assemble, still show two bands, and no longer be the thing the owner asked
// for — the foreground and the background would be borrowing in the SAME direction twice.
ensure((OJZ_BASE_SWAP_TOP_WORD >> 8) != (OJZ_BASE_SWAP_BOT_WORD >> 8),
       "OJZ_BaseSwap: both bands write VDP register selector {OJZ_BASE_SWAP_TOP_WORD >> 8}. T3 is the ROLE INVERSION — the top band re-points the BACKGROUND layer (reg $04, Plane B) at the foreground's map and the bottom band re-points the FOREGROUND layer (reg $02, Plane A) at the background's. Two bands on one register are two of the same effect, not an inversion.")

// ---- THE FOUR EDGE LINES, DERIVED ------------------------------------------
// The display is 224 lines, 0..223. `RASTER_MAX_FIRE_LINE` (engine/effects/raster.emp) is
// the last of them AND the last screen line `fire()` will schedule, which is why the
// reflection below can be written against one name instead of a typed 223.
//
// TOP BAND ON EDGE. 3 — THE LOWEST SCREEN LINE THE SPARSE TIER CAN SCHEDULE AT ALL, and it
// is derived rather than picked (owner ask 2026-09-03: "I would like to see in the plane
// swap the fg go to the bg at the top"). The floor is structural and comes from three
// places that all agree:
//   * `fire()` (engine/effects/raster_dsl.emp) refuses any screen line outside 3..223 —
//     "lines 0-2 belong to the priming records".
//   * `fire_lines` puts the two priming fires on fire lines 0 and 1 and the event at
//     screen_line - 1 (Ruling 1a), then ensures STRICT ascent — so screen line 3 is the
//     first event fire line (2) that clears priming record 1 at fire line 1. Screen line
//     2 would want fire line 1, which is already taken.
//   * `arm_at` encodes record 0's arm as $8A00 | (L[2] - L[1] - 1) = $8A00 | (LINE - 3),
//     so LINE = 3 is exactly the value that makes the gap byte 0 — a legal reload
//     meaning "fire every line" (engine/effects/raster.emp's dense-tier note). LINE = 2
//     would make the gap byte -1 = $FF, which IS the PARK word: the schedule would die
//     silently instead of failing. That is why the floor is a refusal and not a clamp.
// tools/test_plane_base_swap_gate.py's own mutation ledger records the same number from
// the other side: mutating this constant to 2 turns the gate red.
const OJZ_BASE_SWAP_TOP_LINE = 3

// TOP BAND OFF EDGE. 64 — F2's value, retained unchanged, and its derivation with it:
//   * FLOOR: `fire_lines` ensures STRICT ascent of fire lines, so the OFF fire line
//     (END - 1) must exceed the ON fire line (LINE - 1): any END > 3 assembles. That is
//     the mechanical floor and it is far below anything useful.
//   * FLOOR THAT MATTERS: a band must be big enough not to read as a one-line artifact.
//     The retired line-160 single-band value left 64 lines under it and that was judged
//     enough, so ~64 lines is a size this file has already accepted as "a band". ON at 3
//     and END = 64 gives lines 3..63 plus part of 64 — 61 lines, within one line of it.
//   * CEILING: OJZ_WATER_LINE = 120 (this file, below). The lab's raster cycle steps
//     through these programs one after another; an edge near 120 would put two different
//     effects' boundaries within a few lines of each other and a reviewer could not tell
//     which one he was looking at. 64 sits 56 lines clear of it.
//   * TIEBREAK inside 56..72, and it is a tiebreak and not a mechanism: 64 = 8 tile rows
//     exactly, so the closing edge falls on an 8-pixel boundary rather than partway through
//     a row of the borrowed map.
const OJZ_BASE_SWAP_TOP_END_LINE = 64

// ---- THE BOTTOM BAND'S TWO LINES ARE NOT CHOSEN AT ALL: THEY ARE THE TOP BAND'S,
// ---- REFLECTED THROUGH THE DISPLAY'S HORIZONTAL MIDLINE.
// The reflection on a 224-line display maps screen line L to RASTER_MAX_FIRE_LINE - L,
// i.e. line 0 to line 223. Applied to the top band's edge pair {3, 64} it exchanges the two
// edges' roles as well as their positions: the top band's OFF edge reflects to the bottom
// band's ON edge and vice versa. That is one decision — "put the second band where the
// first one would be if the screen were upside down" — instead of two more taste numbers,
// and it is the decision the owner's sentence already contains ("at the top ... at the
// bottom of screen").
//
// FIVE FACTS FALL OUT OF IT, and each one is checkable rather than asserted:
//   1. the two bands are the SAME WIDTH — 64 - 3 = 61 = 220 - 159 — so the encoder emits
//      the SAME arm word ($8A3C) for record 1 and record 3. That equality is visible in the
//      hand pin below and is the cheapest way to see the reflection is intact.
//   2. the two must-not-move margins are EQUAL: 3 rows above the top band (0..2, the
//      priming lines, which no fire can reach anyway) and 3 rows below the bottom band
//      (221..223). tools/base_swap_witness.py asserts both.
//   3. the unswapped MIDDLE region (65..158, 94 rows) is centred on the display: its
//      midpoint is 111.5, and the display's is 223/2 = 111.5.
//   4. both bands stay clear of OJZ_WATER_LINE = 120 — the top band's OFF edge by 56 lines
//      above it, the bottom band's ON edge by 39 below — so the cycle-stepping argument the
//      top band's ceiling makes survives the reflection instead of being re-argued.
//   5. every edge is inside `fire()`'s 3..223, the bottom band's OFF edge with 3 to spare.
//
// WHY THE BOTTOM BAND CLOSES AT ALL, rather than running off the bottom of the display and
// letting the frame-top flush end it: a band that reaches the last line has no BELOW region,
// and the below region is what distinguishes a bounded band from a swap with no OFF edge —
// the exact program that shipped at 8bf6df74 and that the owner reported he could not see.
// Closing at 220 costs three rows of picture and buys back the only assertion that can tell
// those two apart at the bottom of the screen.
const OJZ_BASE_SWAP_BOT_LINE     = RASTER_MAX_FIRE_LINE - OJZ_BASE_SWAP_TOP_END_LINE
const OJZ_BASE_SWAP_BOT_END_LINE = RASTER_MAX_FIRE_LINE - OJZ_BASE_SWAP_TOP_LINE

// THE GUARD F2 EXISTS TO ENCODE, now applied to BOTH bands. It is NOT a restatement of
// `fire_lines`' strict-ascent ensure. That one refuses END <= LINE — a program whose records
// are out of order. This one refuses a program that is ORDERED and still shows no band,
// which is the failure that actually shipped. Each edge is a PARTIAL row (raster.emp's
// row-119 measurement: a bare OP_SET_REG switches its register ~45% across the fire+1 line),
// so an interval of 1 line is two partial rows and no complete row of borrowed map anywhere
// on screen. Two lines is the smallest interval that contains one fully-swapped row.
ensure(OJZ_BASE_SWAP_TOP_END_LINE - OJZ_BASE_SWAP_TOP_LINE >= 2,
       "OJZ_BaseSwap TOP band: the band spans {OJZ_BASE_SWAP_TOP_END_LINE - OJZ_BASE_SWAP_TOP_LINE} line(s) (screen line {OJZ_BASE_SWAP_TOP_LINE} to {OJZ_BASE_SWAP_TOP_END_LINE}). Both edges are partial rows — engine/effects/raster.emp's row-119 note measured a bare OP_SET_REG switching its register ~45% across the fire+1 line — so an interval under 2 contains no COMPLETE swapped row and the band is indistinguishable from the artifact its own edges make. This is not fire_lines' ordering guard: that one refuses END <= LINE, and a program can satisfy it and still show nothing, which is exactly what shipped at 8bf6df74.")
ensure(OJZ_BASE_SWAP_BOT_END_LINE - OJZ_BASE_SWAP_BOT_LINE >= 2,
       "OJZ_BaseSwap BOTTOM band: the band spans {OJZ_BASE_SWAP_BOT_END_LINE - OJZ_BASE_SWAP_BOT_LINE} line(s) (screen line {OJZ_BASE_SWAP_BOT_LINE} to {OJZ_BASE_SWAP_BOT_END_LINE}), which contains no COMPLETE swapped row. The bottom band is the top band reflected through RASTER_MAX_FIRE_LINE, so this can only fire if the top band's width already did.")
// THE TWO BANDS MUST NOT TOUCH, and this is the middle region asserted at build time rather
// than only on screen. tools/base_swap_witness.py's load-bearing assertion is that the rows
// BETWEEN the bands do not move; if the bands met, that region would be empty and the
// witness's middle arm would be vacuously green — a gate measuring nothing. Two lines is
// the same floor and the same reason as the per-band widths above: below it there is no
// complete UNswapped row between the two bands either.
ensure(OJZ_BASE_SWAP_BOT_LINE - OJZ_BASE_SWAP_TOP_END_LINE >= 2,
       "OJZ_BaseSwap: only {OJZ_BASE_SWAP_BOT_LINE - OJZ_BASE_SWAP_TOP_END_LINE} line(s) separate the top band's OFF edge (screen line {OJZ_BASE_SWAP_TOP_END_LINE}) from the bottom band's ON edge (screen line {OJZ_BASE_SWAP_BOT_LINE}). Both are partial rows, so under 2 lines there is no COMPLETE unswapped row between the bands — the two would read as one long swap, and tools/base_swap_witness.py's middle-region assertion (the one thing that tells two bounded bands from one) would be measuring an empty range.")
// THE REFLECTION ITSELF, asserted so that editing one band's line and not the other's is a
// build failure rather than a silently lopsided scene. Stated as the equal-width identity
// the reflection implies, because that is the property the picture actually has.
ensure(OJZ_BASE_SWAP_TOP_END_LINE - OJZ_BASE_SWAP_TOP_LINE == OJZ_BASE_SWAP_BOT_END_LINE - OJZ_BASE_SWAP_BOT_LINE,
       "OJZ_BaseSwap: the top band is {OJZ_BASE_SWAP_TOP_END_LINE - OJZ_BASE_SWAP_TOP_LINE} lines and the bottom {OJZ_BASE_SWAP_BOT_END_LINE - OJZ_BASE_SWAP_BOT_LINE}. The bottom band's two lines are DERIVED as the top band's reflected through RASTER_MAX_FIRE_LINE, so unequal widths mean one of the four constants has been overridden by hand — and the equal arm words the hand pin below relies on would no longer be equal.")

// FOUR FIRES: each band's ON edge and its OFF edge, in ascending screen-line order (which
// is `fire_lines`' requirement over the WHOLE program, not per band). Each OFF edge writes
// its own register's HOME word — the same word Flush_VDP_Shadow puts back at the next frame
// top — so the two mechanisms agree by construction instead of by a second authored value.
const OJZ_BASE_SWAP_PROG = [
    fire(OJZ_BASE_SWAP_TOP_LINE,     [ reg_set(OJZ_BASE_SWAP_TOP_WORD) ]),
    fire(OJZ_BASE_SWAP_TOP_END_LINE, [ reg_set(OJZ_BASE_SWAP_TOP_HOME) ]),
    fire(OJZ_BASE_SWAP_BOT_LINE,     [ reg_set(OJZ_BASE_SWAP_BOT_WORD) ]),
    fire(OJZ_BASE_SWAP_BOT_END_LINE, [ reg_set(OJZ_BASE_SWAP_BOT_HOME) ]),
]

// THE PIN, the same shape (and the same reasoning) as OJZ_TEST_HAND above: literals on
// purpose, because a pin sharing symbols with the encoder it pins is weaker. The values
// that are not framing were DERIVED here from source, not copied from any design document:
//   $8A00  = $8A00 | (TOP_LINE - 3) = $8A00 | 0 — the two-priming-record schedule spelled
//            out at OJZ_TestRaster above, at its floor. A gap byte of 0 is the legal "fire
//            every line" reload, not a missing arm; one line below this the byte would be
//            $FF, the PARK word.
//   $8A3C  = $8A00 | (TOP_END_LINE - TOP_LINE - 1) = $8A00 | (64 - 3 - 1) = $8A00 | 60.
//            `arm_at(L, i)` writes $8A00 | (L[i+2] - L[i+1] - 1) and the fire lines are
//            L = [0, 1, 2, 63, 158, 219], so record 1's arm schedules the gap from the top
//            band's ON fire line (2) to its OFF one (63).
//   $8A5E  = $8A00 | (BOT_LINE - TOP_END_LINE - 1) = $8A00 | (159 - 64 - 1) = $8A00 | 94 —
//            the MIDDLE, i.e. the unswapped gap between the two bands, as one byte.
//   $8A3C  AGAIN at record 3 = $8A00 | (BOT_END_LINE - BOT_LINE - 1) = $8A00 | (220 - 159
//            - 1) = $8A00 | 60. IT IS THE SAME WORD AS RECORD 1 BY CONSTRUCTION: the bottom
//            band is the top band reflected, so the two bands are the same width and their
//            arm words are equal. If these two ever differ, the reflection has been broken.
//   $8406  = $8400 | (VRAM_PLANE_A >> vdp_base_shift(PlaneB)) = $8400 | ($C000 >> 13) —
//            engine/vdp.emp's match arm gives PlaneB => 13, engine/system/constants.emp
//            gives VRAM_PLANE_A = $C000. Reg $04 <- the FOREGROUND's nametable: the top
//            band's ON edge.
//   $8407  = $8400 | ($E000 >> 13) — reg $04 back to Plane B's own map. The word
//            boot_data.emp's VDP_REG_PLANE_B folds and the flush rewrites at frame top.
//   $8238  = $8200 | (VRAM_PLANE_B >> vdp_base_shift(PlaneA)) = $8200 | ($E000 >> 10) —
//            PlaneA => 10. Reg $02 <- the BACKGROUND's nametable: the bottom band's ON edge.
//   $8230  = $8200 | ($C000 >> 10) — reg $02 back to Plane A's own base.
const OJZ_BASE_SWAP_HAND = [
    0,                          // pal_dirty_mask — a register op writes no CRAM, so no
                                //   palette line is re-asserted at frame top
    $8A00, 0,                   // fire 0 — priming; arm = $8A00 | (3 - 3) = the floor,
                                //   a gap byte of 0 ("fire every line"), not a missing arm
    $8A3C, 0,                   // fire 1 — priming; arm = the TOP band's width, 60 lines
    $8A5E, 1,                   // fire 2 — TOP band ON, ONE op; its arm schedules the
                                //   MIDDLE, 94 lines to the bottom band's ON edge
      0, $8406,                 // OP_SET_REG, then reg $04 <- Plane A's nametable:
                                //   the FOREGROUND's map drawn in the BACKGROUND layer
    $8A3C, 1,                   // fire 3 — TOP band OFF; arm = the BOTTOM band's width,
                                //   60 lines — the SAME word as record 1, by reflection
      0, $8407,                 // OP_SET_REG, then reg $04 <- Plane B's own base again
    $8AFF, 1,                   // fire 4 — BOTTOM band ON; nothing beyond the next record
                                //   needs scheduling from here, so this arm parks
      0, $8238,                 // OP_SET_REG, then reg $02 <- Plane B's nametable:
                                //   the BACKGROUND's map drawn in the FOREGROUND layer
    $8AFF, 1,                   // fire 5 — BOTTOM band OFF; past the end, so park
      0, $8230,                 // OP_SET_REG, then reg $02 <- Plane A's own base again
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_BASE_SWAP_PROG) == OJZ_BASE_SWAP_HAND.len,
       "OJZ_BaseSwap: DSL counts {raster_words(OJZ_BASE_SWAP_PROG)} words, the hand program is {OJZ_BASE_SWAP_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_BASE_SWAP_PROG), OJZ_BASE_SWAP_HAND) == -1,
       "OJZ_BaseSwap: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_BASE_SWAP_PROG), OJZ_BASE_SWAP_HAND)}")
ensure(raster_program(OJZ_BASE_SWAP_PROG)[0] == 0,
       "OJZ_BaseSwap: pal_dirty_mask is {raster_program(OJZ_BASE_SWAP_PROG)[0]}, not 0 — this program's only ops are VDP register writes, which touch no CRAM line, so a nonzero mask would make Raster_VBlank re-assert a palette line every frame on a program that writes no colours")

// ---- THE EMISSION IS DEBUG-GATED, FOR OJZ_BandDemo'S REASON EXACTLY ---------
// The only installer is `Debug_BandDemoHotkey`, whose whole body sits inside
// `if DEBUG == 1 {}` and emits zero bytes in the release shape. An unconditional
// emission would therefore put a raster program in the shipped ROM that nothing in that
// shape can install — the dormant scaffold this tree deletes rather than keeps "for
// later" (see the gate note at OJZ_BandDemo above, which records the same correction
// being made the wrong way round first).
//
// EVERY `ensure` ABOVE IS UNGATED and that is the point of spelling it this way: they are
// comptime and emit nothing, so the folds, the two HOME-vs-SWAP guards, the register
// inversion guard, the reflection identity, the arm chain and the whole `raster_program`
// guard stack run on this program in EVERY shape, on EVERY build.
// Only the BYTES are shape-dependent, and `tools/plane_base_swap_gate.py` asserts BOTH
// directions — the words in the DEBUG ROM, and their ABSENCE from the release one.
const OJZ_BASE_SWAP_EMIT_WORDS = if DEBUG == 1 { raster_words(OJZ_BASE_SWAP_PROG) } else { 0 }
pub data OJZ_BaseSwap: [u16; OJZ_BASE_SWAP_EMIT_WORDS] = if DEBUG == 1 { raster_program(OJZ_BASE_SWAP_PROG) } else { [] }

// OJZ_TestPal — a deliberately unmistakable palette for the adjacent section, so
// "did sec_pal load on the crossing?" is answerable from one CRAM read or
// screenshot. Not a tinted copy of the real palette: a subtle shift would make a
// NEGATIVE result (consumer never ran) look like a positive one.
//
// 48 words = 96 bytes = CRAM lines 1-3, matching the sec_pal contract. It must NOT
// cover line 0: that is the character's line (CharacterDef.cd_palette), and a
// section palette that overwrote it would repaint the active character on every
// boundary crossing.
comptime fn test_palette() -> [u16; 48] {
    return comptime for i in 0..48 {
        (((i * 14) / 47) << 9) | (((i & 3) * 2) << 4)
    }
}

pub data OJZ_TestPal: [u16; 48] = test_palette()

// ===========================================================================
// EFFECTS P2 GATE FIXTURES — the palette-cycling band (Task 8) and the OJZ water
// cluster (Task 7). Authored here, the game-side effects library.
// ===========================================================================

// OJZ_ShimmerCycle — a per-section cycling band: rotate line-2 entries 8..11 on a
// NINE-frame cadence. `sec_pal_cycle` finally gets a consumer; the controller reads CRAM
// per frame to confirm the rotation period. Line 2 (not 0 — the character's).
//
// `period: 8` yields 9 frames, not 8, and this comment used to say 8. The runtime
// (Palette_RunCycles) rotates, THEN reloads the timer with `period`, then spends one
// frame per decrement down to zero before the next rotation — so the cadence is
// period + 1. The field comment calls it "frames between rotations", which is literally
// true (there are 8 non-rotating frames between two rotations) and reads as the cadence,
// which it is not. Nothing measured this in either direction: there is no cycling row in
// the budget model and no GATE-EVIDENCE cycling capture. Corrected as documentation only
// — making `period: N` mean N frames is a runtime change that moves bytes, and it is
// booked rather than smuggled into a zero-byte parcel.
pub data OJZ_ShimmerCycle: PalCycleScript1 = cycle_script1(
    [ cycle_channel(line: 2, first: 8, count: 4, period: 8) ])

// OJZ_WaterRaster — the water-cluster raster TEMPLATE (Task 7). At the water line it
// (1) turns Shadow/Highlight ON ($8C89 — bit 3 set, resolution bits unchanged per the survey V28/V30
// ruling) and (2) swaps line-2 entries 4-6 to the deep-water variant's derived bytes
// via OP_PAL_REGION streaming from Pal_Variant_Stage slot 0. The priming arm word
// (arm0) is what the template ships with (water line 120), and it is now a STATIC line:
// the single-channel water patcher that used to overwrite it is deleted (P-b), and a
// boundary that moves is authored as a `patchable` record instead — see OJZ_TwoChannel.
//
// pal_dirty_mask %0100 re-asserts CRAM line 2 every frame, so the mid-frame region
// swap is transient (base restored at frame top -> above the line = base palette, below
// = deep-water). The CRAM command is pinned to the comptime builder.
//
// S/H CONTENT FINDING (plan Task 7 Step 3 — stated, not silently dropped). The
// $8C89 write turns Shadow/Highlight ON below the water line, but S/H only dims
// LOW-priority pixels and OJZ's plane art is HIGH-priority (the P1 residual). Making
// the tiles below the water line low-priority is a CONTENT change: the priority bit is
// baked into the generated OJZ block/nametable data, and the tile-cache stream writes
// those words verbatim — there is no priority-clearing hook in the engine. Regenerating
// that data runs through tools/ojz_strip_gen.py + games/sonic4/data/editor/ojz, which
// this parcel is forbidden to touch (auto-commit daemon). So S/H transparency CANNOT be
// visually demonstrated on OJZ's current art; the op provably EXECUTES (it precedes the
// region op in the same fire, and a mis-parse would desync the CRAM command into
// garbage) but has nothing to dim. Proving S/H needs low-priority water content, which
// is out of this parcel's scope — flagged for the controller/user.
const OJZ_WATER_CRAM_ADDR = $48                 // CRAM line 2, entry 4
ensure(vdp_comm(OJZ_WATER_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C0480000,
       "vdp_comm's CRAM encoding changed — the raster DSL now derives OJZ_WaterRaster's command words, so a drift here moves the emitted program")

// The water line. Static since P-b deleted the single-channel patcher; a moving boundary
// is a `patchable` record with a world anchor now, not a runtime write to this program.
const OJZ_WATER_LINE = 120

const OJZ_WATER_PROG = [
    region_boundary(line: OJZ_WATER_LINE,
                    addr: OJZ_WATER_CRAM_ADDR,   // $48 — CRAM line 2, entry 4
                    slot: 0, pal_line: 2, entry: 4, count: 3,
                    sh:   1),
]

// THE PATCH-OFFSET INVARIANT IS DELETED HERE, and this note is what replaces it.
//
// It asserted that the word at WATER_TEMPLATE_ARM0_OFF (a fixed byte offset 2) was the
// priming arm word for OJZ_WATER_LINE, because Raster_PatchWaterLine wrote that byte
// offset on all three of its exit paths, unconditionally and sight-unseen. Both the
// constant and that proc are gone in P-b: there is no longer a runtime write to a fixed
// offset in this program for anything to be wrong about.
//
// IT IS SUPERSEDED, NOT MERELY OBSOLETE, and that distinction is the only thing that
// makes deleting it safe. P-a's guard 6 (check_arm_layout, raster_dsl.emp) asserts the
// identical property for EVERY record of EVERY patched template, and asserts it twice
// over: that the word each patch-table offset points at is a VDP reg $0A write, and that
// its VALUE equals the arm the schedule independently derives. That is strictly stronger
// than one hand-written check on one program's word 1 — it scales with the content
// instead of being re-written per fixture, and it is the guard that actually stands
// between the runtime patcher and decrementing a record's op_count until `dbf` walks ROM
// as opcodes inside a raw interrupt handler.
//
// This program is no longer patched at all, so guard 6 does not cover it — and does not
// need to, because nothing writes it at runtime. OJZ_WATER_HAND below still pins every
// word of it. The predecessor guard was kept through two parcels on the reasoning that
// OJZ_WATER_HAND retires in Parcel D and this would then be the only build-time check on
// a word the runtime overwrote; that reasoning expires with the overwrite itself.

// THE PIN (design spec 8.1) — the words measured on hardware during P2. Retires in
// Parcel D with the fixture.
// Literals on purpose: a pin sharing symbols with the encoder it pins is weaker.
// raster_dsl's module-level ensures hold these against engine.effects.raster.
// 72 is pal_stage_off(0, 2, 4) = 0*128 + 2*32 + 4*2.
const OJZ_WATER_HAND = [
    %0100,                      // pal_dirty_mask — the WHOLE header, one word
    $8A75, 0,                   // fire 0 — priming; arm0, the word the runtime patches
    $8AFF, 0,                   // fire 1 — priming
    $8AFF, 2,                   // fire 2 — the event, two ops
      0, $8C89,                 // OP_SET_REG
      4, $C048, $0000,          // OP_PAL_REGION, command longword split
                 11,            // spin — SOLVED (substrate item 1c). A 3-word pal_region
                                //   sitting SECOND reaches p = 40 (the SetReg) + 8
                                //   (fetch) + 42 (the not-taken zero pre-test 8, plus the
                                //   depth-1 dispatch 34) + 56 (pre-burst arm, the deeper
                                //   lea/adda shape) = 146, spans 60, and
                                //   round((366 - 146 - 14 - (122.9 + 60)/2) / 10) =
                                //   round((366 - 146 - 14 - 91.45) / 10) = round(11.455)
                                //   = 11. (10 at END 351; 12 at item 6's 371; 11 since this
                                //   parcel re-derived the anchor to 366 with a fixed fold.)
                                //
                                //   WAS 4 UNTIL TIER-3 ITEM 2 — where it had coincided
                                //   with the retired per-class constant, this being the
                                //   shape that constant was fitted to. The coincidence is
                                //   over: the SetReg ahead of it dropped 110 -> 40, the
                                //   region arrives 70 cycles early, and the solver waits
                                //   6 more iterations. The retired constant could not have
                                //   followed it; that is the defect item 1c removed,
                                //   demonstrated on the one program in the tree that used
                                //   to hide it.
                 2,             // count-1
                 72,            // Pal_Variant_Stage offset
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_WATER_PROG) == OJZ_WATER_HAND.len,
       "OJZ_WaterRaster: DSL counts {raster_words(OJZ_WATER_PROG)} words, the hand program is {OJZ_WATER_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_WATER_PROG), OJZ_WATER_HAND) == -1,
       "OJZ_WaterRaster: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_WATER_PROG), OJZ_WATER_HAND)}")

pub data OJZ_WaterRaster: [u16; raster_words(OJZ_WATER_PROG)] = raster_program(OJZ_WATER_PROG)

// ---------------------------------------------------------------------------
// OJZ_TestGradient — the DENSE-tier gate (Task 5 Step 4). A 96-line ramp across
// screen lines 96..191, rewriting CRAM line 2 entries 4-6 on EVERY line.
//
// MEASUREMENT — corrected 2026-08-14, after the prescription below was tried and
// found to be the wrong instrument.
//
// This used to read: "measurement is by per-scanline CRAM read (oracle
// run_to_scanline + read_cram), NOT by counting screenshot pixels". **That does not
// work for this fixture.** `emulator_read_cram` cannot see a mid-scanline CRAM write
// during active display, and this program's whole point is that its writes are
// TRANSIENT — the header's pal_dirty_mask re-asserts CRAM line 2 every frame, so by
// the time any post-frame read happens the base palette is back. Sampling CRAM at
// VBlank returns the BASE values and reads as "the gradient did nothing".
// (`run_to_scanline` is also frame-granular in practice — polling lands a whole frame
// past the target, not a scanline.)
//
// The FRAMEBUFFER is the correct instrument, because it records what each scanline
// was rendered with. Measured that way on 2026-08-14, against a control with the
// program uninstalled: 8 distinct monotonic levels, band boundaries landing exactly
// on 96+12k, first differing row exactly 96, and all three channel mixes present on
// every row.
//
// The art-swamping worry that motivated the CRAM prescription is real but does not
// apply here: it bites a PIXEL-COUNT signal, and this is not one. Each row is
// classified by the ramp LEVEL recovered from the changed pixels' colour, so art
// coverage changes how many pixels carry the signal without changing what the signal
// says. (`read_cram` remains valid for a whole-frame `sec_pal` base palette DMA'd at
// VBlank — the correction is specific to mid-frame writes.)
//
// The three entries carry DELIBERATELY DIFFERENT words at the same ramp level —
// blue, blue+green, blue+red. A stream desync of one word (the classic off-by-one in
// a dense run) therefore shows up as the wrong CHANNEL MIX at the right level, which
// is distinguishable from a run that is merely shifted by a line. Three words is
// RASTER_DENSE_WORDS_PER_LINE exactly, so this also pins the dense body's stride.
// It is NOT the sparse per-fire ceiling and never was, though it wore that constant's name
// until the ceilings split per class: the dense body writes three words with three inlined
// `move.w`, solves no spin and is checked against no window, so a sparse ceiling moving
// must not resize this ROM stream.
const OJZ_GRAD_TOP   = 96
const OJZ_GRAD_LINES = 96
ensure(RASTER_DENSE_WORDS_PER_LINE == 3,
       "OJZ_TestGradient's 3-words-per-line stream assumes RASTER_DENSE_WORDS_PER_LINE == 3")

// CRAM line 2, entry 4 — the same base as the water region, so the ramp lands on
// OJZ's dominant ground colours (entry 5 is ~54% of lower-screen pixels; see the
// OJZ_TestRaster note) and the effect is visible as well as measurable.
const OJZ_GRAD_CRAM_ADDR = $48
ensure(vdp_comm(OJZ_GRAD_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C0480000,
       "vdp_comm's CRAM encoding changed — raster_gradient_program is handed this very call's result as rgp_cmd, so a drift here moves the emitted program")

// Genesis CRAM is 3 bits per channel, so 8 levels is the hardware's whole range: the
// ramp steps every 12 lines and a "monotonic ramp" claim means non-decreasing with
// exactly 8 distinct levels, not 96. Channel positions are R<<1, G<<5, B<<9.
comptime fn grad_word(i: int) -> int {
    let level = ((i / RASTER_DENSE_WORDS_PER_LINE) * 8) / OJZ_GRAD_LINES   // 0..7 over the run
    let ch    = i % RASTER_DENSE_WORDS_PER_LINE
    if ch == 0 { return level << 9 }                    // entry 4 — blue
    if ch == 1 { return (level << 9) | (level << 5) }   // entry 5 — blue + green
    return (level << 9) | (level << 1)                  // entry 6 — blue + red
}

pub data OJZ_GradientStream: [u16; 288] = comptime for i in 0..288 { grad_word(i) }
ensure(288 == OJZ_GRAD_LINES * RASTER_DENSE_WORDS_PER_LINE,
       "OJZ_GradientStream length must be lines * words-per-line")

// The mask is no longer passed: raster_gradient_program DERIVES it from cmd's CRAM
// address ($48 >> 5 = line 2), so "re-assert CRAM line 2 each frame -> the ramp is
// transient" is now a property of the address rather than a claim this call site makes
// and the engine trusts. stream_words is the array's real length, checked there against
// lines * RASTER_DENSE_WORDS_PER_LINE — the ensure that used to sit beside the stream below.
pub data OJZ_TestGradient: RasterGradientProgram = raster_gradient_program(
    top:          OJZ_GRAD_TOP,
    lines:        OJZ_GRAD_LINES,
    cmd:          vdp_comm(OJZ_GRAD_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write),
    stream:       OJZ_GradientStream,
    stream_words: 288)

// ===========================================================================
// EFFECTS P3 GATE FIXTURE — the first VSRAM raster program in this engine.
//
// WHAT IT PROVES. Raster_HInt's CRAM op was never CRAM-specific: it writes
// whatever VDP command longword the program carries (`move.l (a1)+, (a2)`) and
// then streams words to VDP_DATA. Only the CONSTRUCTORS were locked to
// VdpTarget.Cram. `stream_vsram()` (2026-08-14) removes that lock, and this fixture is
// the first program to exercise it — no runtime change was needed for any of it.
//
// WHAT IT LOOKS LIKE. Below screen line OJZ_VSRAM_LINE, plane B's vertical
// scroll snaps to a fixed offset, so the background jumps 67 px at that line and
// stops tracking the camera vertically below it. A hard horizontal seam across
// the BG, which is what makes the boundary line measurable from a screenshot.
//
// WHY ONE ENTRY AND NOT A COLUMN. Reg $0B bit 2 is 0 here (measured on oracle:
// the VDP shadow reads $03, so HScroll mode %11 = per-line and vscroll mode = 0 =
// FULL-SCREEN), so the VDP reads only VSRAM entry 0 (plane A) and entry 1 (plane
// B) — byte addresses 0 and 2 — for every column. Writing byte 2 mid-frame
// therefore re-scrolls the whole of plane B for every line rendered after the
// write. This is Thunder Force IV's shape.
//
// WHY PLANE B AND NOT PLANE A. Mid-frame vertical scroll of plane A is UNSAFE in
// this engine: TILE_CACHE_ROWS = 60 means the rows around the camera window are
// the streamer's WORKING MARGIN, not display-ready content, and a large shift
// points the VDP straight at that scratch space — stale/half-written tiles on
// screen (observed on the first cut of this fixture, which targeted byte 0).
// This is why the reference corpus banks VSRAM banding on plane B.
//
// MEASURED ON ORACLE 2026-08-14 — the two things this fixture exists to settle:
//
//   1. IT WORKS, AND IT LANDS ON N+1. Against a control build identical but for
//      the offset ($0043 vs $0000), the first differing pixel row is EXACTLY
//      y=112, the authored line; rows 108-111 are pixel-identical and every row
//      from 112 to 223 differs — measured with plane A composited ON and again
//      with it OFF (16,630 differing pixels both ways, so occlusion is a
//      non-factor). A VSRAM write from HInt takes effect on the line after the
//      fire, and the DSL's existing `-1` fire-line arithmetic is CORRECT for
//      VSRAM — no separate rule is needed. Same y=112 result as the earlier
//      plane A (byte 0) measurement. This closes the N+1-vs-N+2 question
//      DEFERRED_WORK booked when stream_vsram() was added.
//
//   2. EMULATOR CAVEAT, recorded rather than glossed. Emulators disagree about
//      mid-frame VSRAM: GensKMod latches at HBlank start, Exodus/BizHawk consult
//      continuously. Oracle is Exodus-derived, so this measurement reflects the
//      continuous reading. This project verifies on oracle by policy and has no
//      real hardware, so N+1 is the standard of evidence available — but a
//      latching implementation could differ, and that is a known unknown.
//
// WHY THE OFFSET IS 67 AND NOT 64 — the resolved plane B "mystery". A $0040
// write to this plane produced ZERO differing pixels against control (plane A
// on or off) while $0043 produced 16,630 from y=112 down. The OJZ BG nametable
// is vertically PERIODIC: the trunk band cycles every 8 tile rows (exactly
// 64 px), the canopy every 4 rows (32 px), and every row repeats every 16 tiles
// horizontally (read off $E000 on oracle) — so a 64 px scroll maps plane B onto
// itself pixel-for-pixel. The write worked all along; the art hid it. Read the
// period off the nametable before choosing a banding offset here.
//
// WHY IT IS TRANSIENT. Vscroll_Write rewrites VSRAM[0]/[1] every VBlank, so the
// base is restored at frame top exactly the way pal_dirty_mask restores a palette
// line. Inferred from the image being stable frame to frame rather than drifting;
// not separately instrumented.
//
// NOTE arm0 sits at word 1, as it does in every program — the header is a single
// word. It used to depend on whether the program carried a frame-top init word
// (this one carries none, having no reg_set), which is why it once had to be kept
// away from the water patch slot; that coupling is gone.
const OJZ_VSRAM_LINE = 112              // split the 224-line display in half
const OJZ_VSRAM_OFFSET = $0043          // 67 px — NOT 64: the BG art is 64 px-periodic (see above)

const OJZ_VSRAM_PROG = [
    fire(OJZ_VSRAM_LINE, [ stream_vsram(2, [OJZ_VSRAM_OFFSET]) ]),   // byte 2 = VSRAM entry 1 = plane B
]

// THE PIN. Hand-derived from the wire format, and read as the twin the DSL must
// reproduce. 15 words: 1 header + 4 priming + 8 event + 2 terminator — the event body
// grew a word when the blanking spin moved into the program (substrate item 1).
//   arm0 = $8A00 | (112 - 3) = $8A00 | 109 = $8A6D
//   cmd  = vdp_comm(2, Vsram, Write) — VSRAM write at byte 2 = entry 1 = plane B
// Literals on purpose: a pin sharing symbols with the encoder it pins is weaker.
const OJZ_VSRAM_HAND = [
    0,                                  // pal_dirty_mask — 0: a VSRAM op dirties no palette line
    $8A6D, 0,                           // fire 0 — priming; arms the gap that lands fire 2 on 111
    $8AFF, 0,                           // fire 1 — priming; nothing after the event, so park
    $8AFF, 1,                           // fire 2 — the event, one op
      2, $4002, $0010,                  //   OP_CRAM opcode, VSRAM write cmd @ byte 2 = $40020010
                                        //   (type&rwd = VSRAM&WRITE = %000101: bits 1-0 -> $40000000,
                                        //    addr -> high word, bits 7-2 -> $10 in the low word)
                 22,                    //   spin — SOLVED (substrate item 1c). A VSRAM op
                                        //   emits OP_CRAM and dispatches at the cram rung,
                                        //   so it solves exactly like one: LEADING, 1 word,
                                        //   p = 8 + 8 (the not-taken zero pre-test) + 18
                                        //   + 36 = 70, span 0,
                                        //   round((366 - 70 - 14 - 61.45) / 10) = 22
                                        //   (21 at END 351; 23 at item 6's 371; 22 since
                                        //   this parcel re-derived the anchor to 366.)
                                        //   UNMOVED BY TIER-3 ITEM 2, and it is the only
                                        //   shipped spin that is: item 2 puts this op 8
                                        //   cycles further from the origin, which is 0.8
                                        //   of an iteration and not enough to change where
                                        //   21.055 rounds (it was 21.855 before). Compare
                                        //   the OJZ_TestRaster pin's 17 for the same
                                        //   one-word burst sitting after a reg_set — 4
                                        //   iterations of difference, which is the 40-cycle
                                        //   SetReg the solver accounts for (it was 11
                                        //   iterations while a SetReg cost 110)
                 0, OJZ_VSRAM_OFFSET,   //   count-1 = 0, one scroll word
    $8AFF, $FFFF,                       // terminator
]
ensure(raster_words(OJZ_VSRAM_PROG) == OJZ_VSRAM_HAND.len,
       "OJZ_TestVsram: DSL counts {raster_words(OJZ_VSRAM_PROG)} words, the hand program is {OJZ_VSRAM_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_VSRAM_PROG), OJZ_VSRAM_HAND) == -1,
       "OJZ_TestVsram: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_VSRAM_PROG), OJZ_VSRAM_HAND)}")
// The derived mask MUST be 0. A CRAM-style mask from a VSRAM address would be
// 1 << (2 >> 5) = 1 = CRAM line 0, the CHARACTER's line — re-asserted every frame
// for no reason. This ensure is the guard on op_mask's VSRAM arm.
ensure(raster_program(OJZ_VSRAM_PROG)[0] == 0,
       "OJZ_TestVsram: pal_dirty_mask is {raster_program(OJZ_VSRAM_PROG)[0]}, not 0 — a VSRAM op must dirty no palette line")

pub data OJZ_TestVsram: [u16; raster_words(OJZ_VSRAM_PROG)] = raster_program(OJZ_VSRAM_PROG)

// COMPOSITION EQUIVALENCE PROOF (Parcel C1). The preset path must reproduce the
// hand-authored program EXACTLY before anything is built on top of it — the same
// re-express-then-extend standard the DSL itself was held to in Parcel A.
//
// Paired with a length check ON PURPOSE: first_mismatch walks only its first argument's
// indices, so it returns -1 whenever that argument is a PREFIX of the second. A preset
// path short by a trailing record would compare EQUAL without this.
//
// This is a `const`, so it emits nothing — the proof costs zero ROM bytes.
const OJZ_VSRAM_VIA_PRESET = compose([ fx_vscroll_split(OJZ_VSRAM_LINE, OJZ_VSRAM_OFFSET) ])
ensure(raster_words(OJZ_VSRAM_VIA_PRESET) == raster_words(OJZ_VSRAM_PROG),
       "preset path emits {raster_words(OJZ_VSRAM_VIA_PRESET)} words, hand-authored is {raster_words(OJZ_VSRAM_PROG)}")
ensure(first_mismatch(raster_program(OJZ_VSRAM_VIA_PRESET), raster_program(OJZ_VSRAM_PROG)) == -1,
       "preset path diverges from the hand-authored program at word {first_mismatch(raster_program(OJZ_VSRAM_VIA_PRESET), raster_program(OJZ_VSRAM_PROG))}")

// SCENE-LOWERING EQUIVALENCE PROOF (P3 Task 11) — the same standard, one layer up.
//
// Parcel C1 proved the PRESET path reproduces the hand-authored words. This proves the SCENE
// path does: `layer(vsplit: SceneVSplit.At(..))` on a locked scene, lowered by
// scene_vsplit_fires(), must emit the identical program. That is the acceptance criterion for
// Task 11's central claim — the lowering adds NO second mechanism — and it is checkable only
// as byte identity: a lowering that had grown its own encoder, its own line arithmetic or its
// own spin could still produce a plausible VSRAM program, and only a word-for-word comparison
// against the twin says it did not.
//
// AGAINST THE HAND WORDS, NOT AGAINST THE PRESET. `OJZ_VSRAM_HAND` is derived from the wire
// format by hand and shares no symbol with the encoder, so comparing against it tests the
// whole chain (scene attachment -> screen line -> fx_vscroll_split -> fire -> program words).
// Comparing against `raster_program(OJZ_VSRAM_PROG)` would test one link fewer.
//
// THE LENGTH CHECK IS REQUIRED, NOT BELT-AND-BRACES: first_mismatch walks only its FIRST
// argument's indices and returns -1 whenever that argument is a PREFIX of the second (the same
// note the preset proof above carries).
//
// This is a `const`, so it emits nothing — the proof costs zero ROM bytes, in all four shapes.
const OJZ_VSRAM_VIA_SCENE = scene_vsplit_fires(Scene_VSplitWitness)
ensure(raster_words(OJZ_VSRAM_VIA_SCENE) == OJZ_VSRAM_HAND.len,
       "scene lowering emits {raster_words(OJZ_VSRAM_VIA_SCENE)} words, the hand-authored program is {OJZ_VSRAM_HAND.len} — Scene_VSplitWitness (games/sonic4/data/effects/ojz_scenes.emp) is supposed to re-express OJZ_TestVsram exactly")
ensure(first_mismatch(raster_program(OJZ_VSRAM_VIA_SCENE), OJZ_VSRAM_HAND) == -1,
       "scene lowering diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_VSRAM_VIA_SCENE), OJZ_VSRAM_HAND)} — the per-layer vsplit attachment must lower THROUGH fx_vscroll_split, not beside it. Either Scene_VSplitWitness no longer names OJZ_VSRAM_LINE ({OJZ_VSRAM_LINE}) / OJZ_VSRAM_OFFSET ({OJZ_VSRAM_OFFSET}), or the lowering grew an encoder of its own")
// AND THE MASK, for the reason the hand fixture's own mask ensure gives: a VSRAM op must
// dirty no palette line. Asserted on the LOWERED program because op_mask is reached through
// a different path here (the fold's fires rather than a literal list), and a mask of 1 would
// re-assert CRAM line 0 — the character's — every frame.
ensure(raster_program(OJZ_VSRAM_VIA_SCENE)[0] == 0,
       "scene lowering: pal_dirty_mask is {raster_program(OJZ_VSRAM_VIA_SCENE)[0]}, not 0 — a VSRAM op must dirty no palette line")

// ===========================================================================
// RAMP GATE FIXTURE — the first COMPUTED per-line raster values in this engine.
//
// A dense run pointed at plane B's VSRAM entry, whose per-line value comes from a
// 16.16 accumulator rather than a baked ROM stream. Each scanline scrolls plane B
// by a different amount, so the background is progressively stretched down the
// run — the vertical-scale family (squash, stretch, perspective floor).
//
// STEP IS 0.5 px/line ON PURPOSE. A whole-pixel step would pass even if the
// fractional half of the accumulator were dropped entirely; at 0.5 the integer
// output only advances every OTHER line, so the fixture fails loudly if the 16.16
// arithmetic is wrong. That is the property worth pinning — the fixed point IS
// the feature, since it is what lets a rate be authored finer than a pixel.
const OJZ_RAMP_TOP   = 112
const OJZ_RAMP_LINES = 96
const OJZ_RAMP_STEP  = fp16(0, 128)     // +0.5 px per line

// The run WRITES the VSRAM entry rather than adding to it, so the control must be a
// ramp too — same program, step 0 — or the comparison would confound "the ramp" with
// "the ramp replaced the parallax system's base scroll".
pub data OJZ_TestRamp: RasterRampProgram = raster_ramp_program(
    top:   OJZ_RAMP_TOP,
    lines: OJZ_RAMP_LINES,
    cmd:   vdp_comm(2, VdpTarget.Vsram, VdpOp.Write),   // byte 2 = entry 1 = plane B
    start: 0,
    step:  OJZ_RAMP_STEP)

// EFFECTS-W1 item 6 — CAP_DENSE_TIER IS THE AUTHORING GATE, NOT AN INTERPRETER GATE.
//
// WHY THE CHECK LIVES HERE AND NOT INSIDE raster_ramp_program's OWN BODY (engine/effects/
// raster.emp), which is where every one of its OTHER validation `ensure`s lives. MEASURED,
// not assumed: a first attempt put `ensure((Game.SCANLINE_CAPS & CAP_DENSE_TIER) != 0, ..)`
// inside the comptime fn itself and the build failed `[Error] unknown name Game.SCANLINE_CAPS`
// at exactly this call site — a comptime fn's free names resolve at the CALL SITE (this
// module's own opening note, three paragraphs up, about `pal_stage_off`), and `Game` does
// not travel through that inlining the way it does into a module's own top-level `ensure`s
// or its engine-module PROC bodies (raster.emp's Effects_LatchWorldLines reads
// `Game.SCANLINE_CAPS` directly, at its own definition site, with no import). Every existing
// "this game must declare CAP_X" check in the tree already lives this way — see
// games/sonic4/data/effects/scene_registry.emp's CAP_MULTI_DEFORM_TABLE / CAP_FACTOR_CURVE /
// CAP_BAND_DRIFT ensures, all module-level, all in a GAME file, none inside an engine
// constructor. This follows the same precedent rather than fighting it.
//
// WHY THIS ENSURE AND NOT A BRACKETED SPAN IN Raster_HInt, which is the §8.2 norm every
// other promoted bit follows. Raster_HInt's opcode dispatch is a compare CHAIN whose whole
// cost model (raster_dsl.emp) prices every op's DISPATCH DEPTH as a function of its opcode
// value alone, unconditionally, for every game — "an op's depth is derivable from its
// opcode" is stated there as a universal fact, not a per-game one. Eliding `.op_run_ramp`'s
// dispatch pair for a game that declares no dense-VSRAM content would shrink
// OP_PAL_RESTORE's dispatch depth for that SAME game — silently invalidating the model for
// any future pal_restore program built under it, whether or not one exists today. That risk
// is not this item's to take against code this fragile (raster_dsl.emp's own solved-spin
// warnings are explicit that a moved rung re-prices fixtures that were never touched). So
// the interpreter (`.op_run_ramp`, `.ramp_body`, the dispatch pair) stays UNCONDITIONAL —
// byte-identical in every game, exactly as it shipped 2026-08-14 — and the capability
// instead gates the one place a change costs nothing and risks nothing: the comptime call
// that BUILDS the program. A game that has not declared CAP_DENSE_TIER cannot construct a
// RasterRampProgram at all, in either target — this covers a future CRAM ramp too, on
// purpose: the bit names the MECHANISM (OP_RUN_RAMP, "the dense tier"), not one of its two
// targets, and a CRAM ramp would be exactly as much a new axis for a game as a VSRAM one.
//
// OJZ_TestRamp ITSELF NEVER RENDERS (see the "SECTION 0 SURRENDERS OJZ_TestRamp" banner
// below) — it is a build-time proof of wire-format correctness, same as every other GATE
// FIXTURE in this file. That does not exempt it: constructing the wire form is still
// constructing the program, so this game must still declare the bit to build it, exactly
// as it would for a live scene. sonic4 does (games/sonic4/config/game.emp); demo does not
// and constructs no ramp program, so the check never runs there.
ensure((Game.SCANLINE_CAPS & CAP_DENSE_TIER) != 0,
       "OJZ_TestRamp: this game's Game.SCANLINE_CAPS ({Game.SCANLINE_CAPS}) does not declare CAP_DENSE_TIER — EFFECTS-W1 item 6 gates construction of a dense-tier RAMP program on that bit (engine/level/scene_dsl.emp), so a game must declare intent to spend the dense tier's ramp axis before it may author one. Add CAP_DENSE_TIER to this game's SCANLINE_CAPS in its config/game.emp")

// ===========================================================================
// STARTER PALETTE VARIANTS — moved here from engine/effects/palette.emp in
// Parcel C2 Task 11.
//
// WHY GAME-SIDE. These are emitted `pub data`, and an engine module has no
// business emitting a game's data. The split that matters is constructor vs
// instance: the ENGINE keeps `variant()` (comptime, zero bytes, exactly the shape
// raster_dsl's `fx_*` presets already have) and each game emits its own instances
// from it. Nothing in engine/ referenced any of these — checked before the move.
//
// FOUR OF THE FIVE ARE UNREFERENCED, and that is recorded rather than quietly
// tidied away. Only Variant_Water_Deep has a consumer (games/sonic4/test/
// ojz_scroll_test.emp:277); Murky, Poison, CaveDark and Dusk cost 32 emitted bytes
// between them and are read by nothing. They are deliberate "give people ideas"
// seeds, so they survive the move intact — but a later parcel deciding whether to
// keep them now has the usage data instead of having to re-derive it.
//
// Variant_Water_Murky and Variant_Dusk are BYTE-IDENTICAL (both shift_b:1,
// bias_r:1) — two names for the same 8 bytes. Kept as distinct names on purpose:
// they document two different intents, and deduping them would save 8 bytes while
// making the seed list read as if murk and dusk were the same idea.
// ===========================================================================
pub data Variant_Water_Deep:  pal_variant = variant(shift_r: 1, shift_g: 1)                 // halve R+G, keep B
pub data Variant_Water_Murky: pal_variant = variant(shift_b: 1, bias_r: 1)                  // halve B, warm bias
pub data Variant_Poison:      pal_variant = variant(shift_r: 1, shift_b: 1, bias_g: 1)      // halve R+B, green push
pub data Variant_CaveDark:    pal_variant = variant(shift_r: 1, shift_g: 1, shift_b: 1)     // halve all
pub data Variant_Dusk:        pal_variant = variant(shift_b: 1, bias_r: 1)                  // halve B, small R bias

// ===========================================================================
// THE SHOWCASE VERTICAL SPLIT (owner decision d-15, 2026-08-26) — P3 Task 11's
// per-layer vertical depth, ADOPTED, on the section-4 Aurora scene.
//
// EVERYTHING ELSE IN THIS FILE ABOVE IS A GATE FIXTURE. This is not: it is content, and it
// is the first place in the tree where `layer(vsplit: SceneVSplit.At(..))` reaches a screen
// rather than a comparison. The scene is `Scene_Editor_ojz_act1_depth`, authored in
// games/sonic4/data/editor/effects/ojz_act1_depth.json and lowered by tools/effects_gen.py.
//
// WHY THE INSTALL IS HAND-SIDE AND NOT GENERATED, which is the one thing to know before
// moving it. A vsplit lowers to a RASTER PROGRAM, not to a band record (see SceneVSplit's
// banner in engine/level/scene_dsl.emp) — so unlike the scene's curves, which ride the
// lowered `SceneCfg5` the generator already emits, the split needs a program installed on
// the section's preset. Raster preset composition from the editor is WAVE 2 and has not
// landed (tools/EFFECTS_CONSUMER_CONTRACT.md's own note: "Wave 2 (raster preset
// composition) will add its own consumer rows here when its schema lands"). Until it does,
// the generated module emits the attachment and this file fires it. When wave 2 lands, this
// block and OJZ_Preset_Depth are what it replaces.
//
// THE SCENE CONST IS IMPORTED, NOT RE-AUTHORED, and that is the point: authoring the two
// split lines a second time here would be two sources for one screen, and they would drift
// the first time the editor moved a band. `scene_vsplit_fires()` derives both fire lines
// from the scene's OWN layer tops (112 and 160), so the JSON stays the single authority.
//
// NO SECOND ENCODER. The fold calls `fx_vscroll_split`, the same preset OJZ_TestVsram's
// equivalence proof above pins word-for-word against hand-derived wire format — so the
// words, the blanking spin, the landing model and the axis-4b HInt total are all the raster
// DSL's, unchanged. Nothing new is asserted here that that proof does not already cover.
const OJZ_DEPTH_VSPLIT_PROG = scene_vsplit_fires(Scene_Editor_ojz_act1_depth)
// The mask must be 0 for the reason every VSRAM fixture above states: a CRAM-style mask
// derived from a VSRAM address would re-assert palette line 0 — the CHARACTER's — every
// frame. Asserted on the LOWERED program because op_mask is reached through the fold's
// fires here rather than through a literal op list.
ensure(raster_program(OJZ_DEPTH_VSPLIT_PROG)[0] == 0,
       "OJZ_DepthVSplit: pal_dirty_mask is {raster_program(OJZ_DEPTH_VSPLIT_PROG)[0]}, not 0 — a VSRAM op must dirty no palette line, and this program is two vscroll splits and nothing else")
// ONE FIRE PER AUTHORING LAYER — NOW ACTUALLY DERIVED. This assertion used to read
// `== 2` while its own comment claimed to be "a count over the SCENE's own layers".
// It was a literal, and on 2026-08-27 it stopped the OWNER mid-authoring: he toggled
// vsplit on a third layer in Aurora, the editor allowed it (correctly — no engine rule
// forbids three), and this line refused the build.
//
// The two halves it was written to catch are not the same thing. A fold returning FEWER
// fires than its layers author is a LOST ATTACHMENT — a real defect, and the reason this
// assertion exists. A fold returning MORE is a person adding a split on purpose, which is
// authoring, and this file has no standing to refuse it: `scene_vsplit_fires()` already
// enforces the invariants that actually matter (at least one layer carries a split, and
// the splits are strictly ordered down the screen), and there is NO cap on how many —
// `raster_words()` sizes the array from the program.
//
// So it is derived now, and the comment is true. Adding a fourth needs no edit here.
ensure(OJZ_DEPTH_VSPLIT_PROG.len == scene_vsplit_count(Scene_Editor_ojz_act1_depth),
       "OJZ_DepthVSplit: scene_vsplit_fires() built {OJZ_DEPTH_VSPLIT_PROG.len} fire(s) from Scene_Editor_ojz_act1_depth, but {scene_vsplit_count(Scene_Editor_ojz_act1_depth)} of its layers author a `vsplit: At(..)` — a fire was lost between the scene and the fold, which is the attachment bug this line exists to catch")
pub data OJZ_DepthVSplit: [u16; raster_words(OJZ_DEPTH_VSPLIT_PROG)] = raster_program(OJZ_DEPTH_VSPLIT_PROG)

// ===========================================================================
// PARCEL C2 TASK 12 — OJZ act 1 total-binding presets.
//
// The nine act_descriptor.emp sections today bind sec_pal/sec_raster_table/
// sec_pal_cycle separately, each with "NULL means keep whatever the previous
// section had" semantics. These five presets are the total-binding replacement:
// ojz_sec() feeds each one into sec_effects, and Effects_InstallPreset writes
// every channel on section entry, using the explicit _None sentinels for "off"
// rather than leaving a field at 0/"keep".
//
// EVERY preset here carries `variants: [Variant_Water_Deep, 0]`, and that is
// NOT incidental. games/sonic4/test/ojz_scroll_test.emp binds Variant_Water_Deep
// to variant slot 0 once at GameState_OJZScroll_Init and nothing ever clears
// it — so today that variant is live across all nine sections (it is why
// Pal_Active reads $10, variant-only, everywhere; see engine/effects/
// palette.emp's own comment on Pal_Active). A preset with an empty variants
// array would CLEAR the slot under total binding, silently dropping the water
// tint act-wide the moment a section crossing installs it — a real regression
// dressed up as "the preset said nothing". Carrying the variant in every
// preset instead reproduces today's live state exactly. Whether the variant
// should be section-scoped is a content question for a later parcel, not
// something to change while converting the binding mechanism.
//
// Sections 6-8 are identical (OJZ_Palette, no raster, no cycle), so they share
// ONE preset instance (OJZ_Preset_Plain) instead of three copies. This line said
// "sections 4-8 / five copies" and had been stale twice over: section 4 took
// OJZ_Preset_Depth at owner decision d-15, and section 5 took OJZ_Preset_Sec5 at
// EFFECTS-W1 item 1 step 5. Sharing is still the DEFAULT — a section leaves the
// shared instance only when it needs a channel of its own, and each departure is
// priced at one 38-byte record below.
//
// NOT NAMED Preset_None: a preset always carries a palette (EffectsPreset.ep_pal
// is a required, non-defaulted field — see preset()'s signature), and a palette
// is game content. There is no game-agnostic "none" preset, so the "everything
// else off" instance is named for what it actually is — OJZ's plain section —
// rather than implying a universal empty preset that cannot exist.
// SECTION 0 IS THE PATCHED SECTION (P-b Task 7), and this is what closes EFX-8.
//
// No patched program had RENDERED since Parcel C2: total binding drove ep_patched past
// "off" into unreachable, because the only installer of a Buf_B program in the tree was a
// hand install in the scroll test's Init, and C2 made the preset path the sole authority
// over the raster channel. Every P-a guard was therefore proving properties of a program
// nothing could display. Binding OJZ_TwoChannel here is what makes P-b's gate — and P-a's
// thirteen guards — measure something.
//
// SECTION 0 SURRENDERS OJZ_TestRamp, and that is a DECLARED DELTA rather than a regression:
// preset()'s exclusivity ensure makes ep_raster and ep_patched mutually exclusive, so the
// OP_RUN_RAMP fixture cannot share a section with a patched template. Section 0 is the one
// the scroll test spawns into, which is the whole reason it is the right section to convert —
// the gate needs the boundaries on screen with no navigation. OJZ_TestRamp keeps its
// build-time pins; what it loses is a live render, and it can be re-bound to any other
// section the moment someone wants to look at it again.
//
// THE ANCHORS ARE MEASURED, NOT GUESSED. Camera_Y reads $0090 (144) at spawn on oracle, and
// screen_line = world_y - Camera_Y, so:
//   channel 0: 224 - 144 =  80  (band 3..220 — mid-band)
//   channel 1: 314 - 144 = 170  (band 222..223 — BELOW the band, so it clamps UP to 222)
//
// (Those two band ranges read "40..120" and "130..200" until 2026-09-03, and both were stale:
// channel 0's `lo` went 40 -> 3 when Parcel W shipped — the note above OJZ_TC_PROG describes
// exactly that edit and why — and channel 1 has been the two-line 222..223 vscroll split since
// the 2026-08-18 re-band. The bands are read from the `patchable(..., lo:, hi:)` calls, which
// is also where tools/effects_gates.py reads them from rather than from prose.)
// Both boundaries are on screen at spawn, and both clamp edges are reachable by scrolling,
// which is what lets the gate assert absolute predicted rows AND both clamp directions
// without a debug hook. Channels 2 and 3 are unused; their anchors are PATCH_ANCHOR_NONE
// ($7FFF), NOT 0 — this line said 0 until 2026-08-18 while the call below has always passed
// the sentinel. The difference is the whole reason the sentinel exists: the parallax overlay
// derives a screen line as `anchor - Camera_Y`, so a 0 anchor reads as ABOVE the screen top,
// i.e. "fully submerged", the most invasive possible default for a channel nobody asked for
// (see PATCH_ANCHOR_NONE in raster_dsl.emp).
//
// CHANNEL 0 SWEEPS (EFFECTS-W1 DoD item 4, 2026-09-03) — the act's first moving edge, and the
// reason it is THIS channel is that channel 0 is the only one in the tree with two consumers.
// ParallaxConfig_OJZ_Underwater anchors its band split on channel 0 and OJZ_TwoChannel's
// patchable fire 0 is the palette boundary, so one swept anchor moves the parallax split and
// the tint line TOGETHER, on the same frame, off the one derivation — which is simultaneously
// the content and the witness for the single-derivation ruling the mover was placed under.
//
// CHANNEL 1 DELIBERATELY DOES NOT SWEEP, and the reason is arithmetic rather than taste: its
// patchable band is lines 222..223 (the plane-B vertical scroll split at the screen bottom),
// two lines wide. At the spawn camera its line is 314 - 144 = 170, below the floor, so
// Raster_BuildSchedule clamps it UP to 222; the only camera Ys that put it INSIDE the band are
// the two-line window 91..92. A sweep there is invisible almost everywhere and a two-line
// stutter in the window, which is not motion.
// Two channels sweeping on different phases is what the phase byte is FOR — Ristar's
// correction — and this act has nowhere to spend it; the field is exercised by
// tools/test_anchor_sweep_band.py and by anchor_sweep()'s own guards, not by content.
//
// THE TWO VALUES, DERIVED. `anchor_sweep(4, 1)` = amplitude shift 4, period shift 1, phase 0.
//
//   AMPLITUDE — shift 4 is a peak of 256 >> 4 = 16 px, so 32 px peak-to-peak. The bound that
//   actually binds is the channel's own patchable band (§9.3 of the design): leaving it
//   upward does not stop the edge, Raster_BuildSchedule DELETES the record and the band
//   vanishes for that frame. Channel 0's band is 3..220 = 218 lines and its seeded line at
//   spawn is 224 - 144 = 80, which is 77 lines above `lo` and 140 below `hi`. A +/-16 px
//   excursion spends 21% of the tighter side, leaving 61 lines of camera travel before the
//   sweep's own peak reaches a clamp. The next rung up (shift 3, +/-32) would spend 42% of it
//   and start clamping while the player is still on screen 0.
//
//   PERIOD — shift 1 is 256 << 1 = 512 ticks, 8.53 s on a 60 Hz frame. The peak vertical speed
//   of a sine of amplitude A and period T is A * 2*pi / T = 16 * 6.283 / 512 = 0.196 px/frame,
//   about 11.8 px/s. That is the number the rung was chosen ON: at the next rung (shift 2,
//   17 s — Ristar's own boundary-swell cycle) the peak is 0.098 px/frame, so the INTEGER
//   screen line only advances once per ~10 frames and the edge reads as stepping rather than
//   moving, which is the exact failure this item exists to avoid. At shift 0 (4.3 s) it is
//   0.39 px/frame, which on a waterline reads as chop rather than swell.
//
//   AGAINST THE CORPUS: Ristar's shipped boundary swell (its 32-entry wave table, one step per
//   32 frames) covers -12..+28 px over 1024 frames, a peak segment rate of 4 px / 32 frames =
//   0.125 px/frame. S.C.E.'s water ripple is a 0..8 px one-sided term off the mean
//   (Oscillatory Routines.asm slot F, amplitude $10, halved by `lsr.w #1` at Water
//   Effects.asm:20). Ours is 32 px peak-to-peak at 0.196 px/frame: between the two, closer to
//   Ristar's swell in travel and to nobody's in rate, because nothing in the corpus is
//   TIME-driven — S.C.E.'s and S2's only moving boundary is triggered by camera X.
//
//   PHASE — 0, because there is one sweeping channel and a phase is a relationship between
//   two of them.
pub data OJZ_Preset_Sec0:  EffectsPreset = preset(pal: OJZ_Palette, patched: OJZ_TwoChannel,   cycle: Pal_Cycle_None,     variants: [Variant_Water_Deep, 0],
                                                  parallax: ParallaxConfig_OJZ_Underwater,
                                                  patch_world_ys: [224, 314, PATCH_ANCHOR_NONE, PATCH_ANCHOR_NONE],
                                                  patch_motion:   [anchor_sweep(amp_shift: 4, period_shift: 1),
                                                                   ANCHOR_MOTION_NONE,
                                                                   ANCHOR_MOTION_NONE,
                                                                   ANCHOR_MOTION_NONE])
pub data OJZ_Preset_Sec1:  EffectsPreset = preset(pal: OJZ_Palette, raster: OJZ_TestRaster,     cycle: Pal_Cycle_None,     variants: [Variant_Water_Deep, 0])
// SECTION 2 NO LONGER CARRIES OJZ_TestPal, and the reason is measured rather than
// aesthetic (owner ruling 2026-09-03: "For 2 just get rid of the blue hiding the effect").
// This preset installed a 96-line CRAM ramp AND a synthetic palette that floods the screen
// blue, so the ramp had nothing to be seen against.
//
// THE RAMP WAS ALWAYS FIRING — measured on the running DEBUG ROM BEFORE the cut, with an
// UNMASKED per-scanline framebuffer capture (`emulator/scanlines`, source == "raster"
// asserted; a VBlank `read_cram` cannot see it, the writes are transient and re-asserted
// every frame). With `Raster_Program` confirmed == OJZ_TestGradient, the ramp colours the
// DSL predicts for line-2 entries 4/5/6 appear on screen in 12-line steps, rising from 0
// pixels of 320 at screen line 96 to 200+ at line 191, and never outside 96..191. So the
// owner's "I don't think there's a gradient ramp" was a report about VISIBILITY, not about
// the mechanism, and swapping the palette is the right fix rather than a workaround.
//
// IT IS ONLY HALF THE VISIBILITY PROBLEM, and the other half is not fixed here. The ramp's
// own three entries differ by ONE 3-bit intensity step (~36/255) — `test_palette()` folds a
// near-monochrome blue ramp — so even against the real palette this is a subtle effect. If
// section 2 is meant to SHOW the dense tier, the ramp's colour spread is what to widen next.
//
// WHAT THE CUT COSTS, stated because it is a real loss and no gate reports it: section 2 was
// the ONLY section in OJZ act 1 with a palette differing from OJZ_Palette, so the act no
// longer demonstrates sec_pal snapping on a crossing and restoring on the way out. Nothing
// went red — no pytest and no effects-gates lane ever tested it; the only evidence that ever
// existed is a manual oracle session in docs/benchmarks/effects-p1/GATE-EVIDENCE.md. The
// choice of where that proof should live now is booked in docs/DEFERRED_WORK.md.
//
// `OJZ_TestPal` ITSELF IS UNTOUCHED and must stay where it is: tools/plane_base_swap_gate.py
// derives OJZ_BaseSwap's emitted size from the gap to `NEXT_SYM = "OJZ_TestPal"`, so the
// SYMBOL's position immediately after it is load-bearing even though this binding was not.
pub data OJZ_Preset_Sec2:  EffectsPreset = preset(pal: OJZ_Palette, raster: OJZ_TestGradient,   cycle: Pal_Cycle_None,     variants: [Variant_Water_Deep, 0])
// SECTION 3 THREADS THE PALETTE CHOOSERS (EFFECTS-W1 item 5). `hand:` is what this section
// carries today — `OJZ_ShimmerCycle` on the cycle channel, `Variant_Water_Deep` in variant
// slot 0 and nothing in slot 1 — so with no sidecar naming a document both choosers return
// `hand` and this record is byte-identical to the literal it replaced.
//
// `hand:` FOR `cycle:` IS THE SENTINEL OR A REAL SCRIPT, NEVER 0. A NULL `ep_cycle` cannot
// mean "off" while it also means "keep"; every other section here passes `Pal_Cycle_None`.
// `hand:` FOR THE VARIANT SLOTS IS LOAD-BEARING: a document that said nothing and cleared
// them would drop the act-wide water tint at the first crossing (the block above
// OJZ_Preset_Sec0's group says why).
//
// SLOT 1 PASSES NO `hand:` AT ALL, AND THAT IS NOT THE RASTER CHANNEL'S SLOPPINESS — it is
// what sigil permits. A bare `0` in a `Label` argument position is REFUSED
// (`expected a label (a Label argument), got int`, measured 2026-09-02 on this exact line),
// and there is no Label-typed spelling of "no variant": unlike `ep_raster`, whose off state
// is the parked `Raster_Program_None` program, `ep_variants`' off state IS zero — the
// engine's own "unused slots 0 = clear" (preset.emp). So the chooser's declared
// `hand: Label = 0` default is the only way to spell it, and it is also the RIGHT value:
// 0 means CLEAR here, where in ep_raster it would mean "keep". The raster channel's
// "always pass `hand:` explicitly" rule does not transfer, for exactly that reason.
pub data OJZ_Preset_Sec3:  EffectsPreset = preset(pal: OJZ_Palette, raster: Raster_Program_None,
                                                  cycle: ojz_act1_sec_cycle(sec: 3, hand: OJZ_ShimmerCycle),
                                                  variants: [ ojz_act1_sec_variant(sec: 3, slot: 0, hand: Variant_Water_Deep),
                                                              ojz_act1_sec_variant(sec: 3, slot: 1) ])
pub data OJZ_Preset_Plain: EffectsPreset = preset(pal: OJZ_Palette, raster: Raster_Program_None, cycle: Pal_Cycle_None,    variants: [Variant_Water_Deep, 0])
// SECTION 4 IS THE SHOWCASE DEPTH SECTION (owner decision d-15, 2026-08-26). It is
// OJZ_Preset_Plain in every other respect — same palette, same variant, no cycle — and
// differs only by carrying the vertical-split program above. Sections 5-8 keep Plain, so
// the split is a property of ONE section and crossing out of it removes it, which is what
// makes the effect legible as a section-scoped scene rather than an act-wide setting.
//
// WHY SECTION 4 AND NOT AN EARLIER ONE: sections 0-3 each bind a gate FIXTURE on the raster
// / patched channel (OJZ_TwoChannel, OJZ_TestRaster, OJZ_TestGradient, OJZ_ShimmerCycle),
// and preset() makes ep_raster and ep_patched mutually exclusive — so adopting the split on
// any of them would evict an instrument the effects gate lane measures. Section 4 is the
// first section whose raster channel was Raster_Program_None, i.e. the first one where the
// showcase can take the channel without taking it from something.
pub data OJZ_Preset_Depth: EffectsPreset = preset(pal: OJZ_Palette, raster: OJZ_DepthVSplit,     cycle: Pal_Cycle_None,    variants: [Variant_Water_Deep, 0])
// SECTION 5 IS THE SPLIT (EFFECTS-W1 item 1 step 5). It is OJZ_Preset_Plain in every
// respect that a byte can see today — same palette, same variant, no cycle, and a raster
// channel that resolves to Raster_Program_None — and it exists ONLY so that section 5 has a
// preset of its own to bind a `rasterRef` through.
//
// WHY A SPLIT IS NEEDED AT ALL: `Sec.sec_effects` is a per-section POINTER to a shared
// record, and sections 5-8 all pointed at OJZ_Preset_Plain. The chooser is keyed on a
// SECTION INDEX, so threading `ojz_act1_sec_raster(sec: 5, ...)` into the shared record
// would have given sections 6, 7 and 8 the same band. The friction is `sec_effects`'s, not
// this mechanism's — any per-section binding inherits it. Paid once, here: from now on a
// band on section 5 is a JSON-only change.
//
// WHY SECTION 5 AND NOT SECTION 4: section 4 already owns its preset and would need no
// split, but its raster channel carries the d-15 showcase (OJZ_DepthVSplit) and preset()'s
// exclusivity ensure makes ep_raster/ep_patched a hard either/or — binding a rasterRef there
// would EVICT the showcase. Section 5 is the first Plain section whose raster channel is
// Raster_Program_None, so it takes a band without taking one from anything, and it sits one
// section past the showcase so the two are comparable by scrolling.
//
// THE `hand:` IS Raster_Program_None AND NOT 0. `ep_raster`'s "off" is the parked program,
// never NULL — a NULL cannot mean "off" while it also means "keep" (ARCH §7.12). 0 is the
// correct `hand:` only for a section that binds `patched:` (section 0), where a non-zero
// hand would fire preset()'s exclusivity ensure for a section that bound nothing at all.
//
// TODAY THIS COSTS 38 BYTES AND CHANGES NOTHING ELSE. No sidecar in this tree carries a
// `rasterRef`, so the chooser's body is `return hand` and this record is byte-identical to
// OJZ_Preset_Plain — deliberately, because it makes the step's whole ROM delta one
// EffectsPreset (`struct EffectsPreset (size: 38)`) and nothing else.
// (STALE AS OF 2026-08-30: section_5.meta.json DOES carry a `rasterRef` now, and as of
// 2026-09-03 that document also carries the two patch keys. The record is no longer
// byte-identical to OJZ_Preset_Plain, and `struct EffectsPreset` is 46 bytes since item 4
// added ep_patch_motion. Kept, corrected in place, because the ARGUMENT above is still the
// live reason section 5 owns a preset at all.)
//
// ---- THE PATCH CHANNELS ARE THREADED HERE (EFFECTS-W1 item 4 step 4, 2026-09-03) ----
//
// All eight positions are written LITERALLY through the choosers, and that is the shape the
// key-shape artifact §5.1 ruled rather than an emitted array: `preset()` ensures
// `patch_world_ys.len == RASTER_MAX_PATCH` and `patch_motion.len == RASTER_MAX_PATCH`, and a
// call site that spells all four keeps that true by construction whatever the document says.
// A generator that emitted the ARRAY would have to PAD a short document, and padding is
// where a document that said nothing silently becomes an anchor nobody authored.
//
// `hand:` IS THE SENTINEL ON EVERY POSITION, not 0. This section authored no patch channel
// by hand, and "no channel" is PATCH_ANCHOR_NONE / ANCHOR_MOTION_NONE — 0 is a real world Y
// and the worst one (`anchor - Camera_Y` at 0 reads as above the screen top, i.e. fully
// submerged, for a channel nobody asked for).
//
// ⚠ WHAT SECTION 5's SWEEP DOES AND DOES NOT DO TODAY, said here rather than discovered.
// The document authors channel 0 at world Y 2272 (section 5 is grid row 1, so 2048 + 224 —
// section 0's own channel-0 anchor one section row down) sweeping at the shipped rung
// `anchor_sweep(4, 1)`. The seed and the packed word DO reach this record and DO get seeded
// into `Effects_Motion[]` on the crossing. But NOTHING AT SECTION 5 CONSUMES CHANNEL 0: this
// preset binds `raster:` (a static editor program with no `patchable()` record) and defers
// its parallax to the act default `ParallaxConfig_OJZ_Default`, which carries no
// `SceneAnchor.At(0, ..)`. So the line is derived every frame and read by no one.
//
// THAT IS A STRUCTURAL GAP AND NOT A CHOICE, and it is worth stating because the obvious
// fix is the wrong one. Section 0 is the only section in the tree with live patch channels
// (OJZ_TwoChannel's two `patchable()` records plus ParallaxConfig_OJZ_Underwater's anchor),
// and section 0 CANNOT bind an editor preset document: a document must carry `bands` (hub
// ruling Q1a), `bands` lowers to a raster program, `tools/effects_seam_gate.py` requires
// every sidecar `rasterRef` to be threaded through `ojz_act1_sec_raster(sec: N)`, and
// `preset()` makes `ep_raster` and `ep_patched` mutually exclusive. The three rules close
// the door together. Section 5 was the only section a document could bind to at all — the
// authoring path was proved end to end there — and giving it a raster CONSUMER (as
// opposed to a raster BINDING) is a content decision left to the owner.
//
// (STALE AS OF 2026-09-03: "the only section" stopped being true the moment `base_swap`
// gave item 11a a second one — section 6, below. Both sections were Plain and neither
// binds `patched:`, so opening a second document-bindable section cost nothing: it is the
// same one-time split OJZ_Preset_Sec5's own paragraph above describes, paid again.)
pub data OJZ_Preset_Sec5:  EffectsPreset = preset(pal: OJZ_Palette,
                                                  raster: ojz_act1_sec_raster(sec: 5, hand: Raster_Program_None),
                                                  // d-53, owner 2026-09-03 ("Sure let's do it to see it?"): the one
                                                  // reversible word that gives channel 0 a CONSUMER. The gap named in
                                                  // the block above is structural, not a choice — section 5 is the only
                                                  // section a document can bind to, and its parallax defaulted to
                                                  // ParallaxConfig_OJZ_Default, which carries no SceneAnchor.At(0, ..).
                                                  // Underwater does, so the document's patch_motion[0] sweep finally
                                                  // moves something. This LOANS section 5 a look it does not otherwise
                                                  // have; deleting this line puts the picture back exactly. The end
                                                  // state is d-53 option open_the_door, which needs no loan at all.
                                                  parallax: ParallaxConfig_OJZ_Underwater,
                                                  cycle: Pal_Cycle_None,    variants: [Variant_Water_Deep, 0],
                                                  patch_world_ys: [ojz_act1_sec_patch_world_y(sec: 5, ch: 0, hand: PATCH_ANCHOR_NONE),
                                                                   ojz_act1_sec_patch_world_y(sec: 5, ch: 1, hand: PATCH_ANCHOR_NONE),
                                                                   ojz_act1_sec_patch_world_y(sec: 5, ch: 2, hand: PATCH_ANCHOR_NONE),
                                                                   ojz_act1_sec_patch_world_y(sec: 5, ch: 3, hand: PATCH_ANCHOR_NONE)],
                                                  patch_motion:   [ojz_act1_sec_patch_motion(sec: 5, ch: 0, hand: ANCHOR_MOTION_NONE),
                                                                   ojz_act1_sec_patch_motion(sec: 5, ch: 1, hand: ANCHOR_MOTION_NONE),
                                                                   ojz_act1_sec_patch_motion(sec: 5, ch: 2, hand: ANCHOR_MOTION_NONE),
                                                                   ojz_act1_sec_patch_motion(sec: 5, ch: 3, hand: ANCHOR_MOTION_NONE)])
// SECTION 6 IS THE MID-FRAME BASE-SWAP'S REAL BINDING (EFFECTS-W1 item 11a's authorable
// half, 2026-09-03). It is `OJZ_Preset_Plain` in every respect but one — same palette, same
// variant, no cycle, no parallax/patch channels — and exists ONLY so that section 6 has a
// preset of its own to thread a `rasterRef` through, the exact reason `OJZ_Preset_Sec5`
// exists one section up.
//
// WHY SECTION 6 AND NOT SECTION 5: section 5 already carries `ojz_sec5_showcase`'s `bands`
// program (plus the two patch channels), and `base_swap` occupies the SAME `ep_raster`
// slot `bands` does — binding it there would EVICT the showcase. Section 6 (like 7 and 8)
// pointed at the shared `OJZ_Preset_Plain` record before this parcel, so it takes a
// document binding without taking one from anything and without disturbing 7 or 8, which
// still share `OJZ_Preset_Plain`.
//
// THE DOCUMENT: `games/sonic4/data/editor/effects/presets/ojz_sec6_baseswap.json` carries
// `base_swap: {line: 3, target: 57344, restore_line: 64}` — the SAME two lines and the
// SAME target (`VRAM_PLANE_B` = `$E000` = 57344) this file's own hand-authored
// `OJZ_BaseSwap` fixture above uses, so the generator's output is checkable against a
// program already proved word-for-word against a hand encoding.
// (⚠ THIS SENTENCE SAID `{line: 160, target: 57344}` UNTIL 2026-09-04 and had been wrong
// since `8bf6df74` moved the document to 3; `restore_line` joined it with F2, which is what
// makes the pair a BAND rather than a swap that runs to the bottom of the display. The
// fixture and the document are held in lockstep on purpose — a change to one alone is the
// defect — so this paragraph is part of that lockstep and not decoration.)
// `games/sonic4/data/editor/ojz/act1/section_6.meta.json` binds it via `rasterRef`.
// `tools/effects_gen.py`'s `render_base_swap_preset` lowers it to
// `raster_program([fire(3, [reg_set($8200 | vdp_base_reg(VdpBase.PlaneA, 57344))]),
//                  fire(64, [reg_set($8200 | vdp_base_reg(VdpBase.PlaneA, VRAM_PLANE_A))])])`
// — the SAME three calls (`fire`/`reg_set`/`raster_program`) `OJZ_BASE_SWAP_PROG` above
// makes, not a second constructor. The OFF edge's target is DERIVED, never authored: it is
// `VRAM_PLANE_A` folded through the same helper, i.e. the word the VBlank flush restores.
//
// UNLIKE OJZ_BaseSwap, THIS EMISSION IS NOT DEBUG-GATED. A preset document's raster
// program is real section content — every section's `EffectsPreset` is `pub data`,
// unconditional in every shape — so `EditorRaster_OJZ_Act1_ojz_sec6_baseswap` reaches
// `s4.bin` too, not only `s4.debug.bin`. That is the whole point of this parcel: the
// mid-frame door stops being a DEBUG-only demo the moment a document, rather than a hotkey,
// asks for it.
pub data OJZ_Preset_Sec6:  EffectsPreset = preset(pal: OJZ_Palette,
                                                  raster: ojz_act1_sec_raster(sec: 6, hand: Raster_Program_None),
                                                  cycle: Pal_Cycle_None,    variants: [Variant_Water_Deep, 0])

// ===========================================================================
// OJZ_TwoChannel — the Parcel P-a gate. TWO independently patchable boundaries in ONE
// program, which is exactly what the Phase-3 design declared out of scope for Parcel C
// ("two independently patched effects in one section — Raster_Buf_B is single").
//
// It has NO runtime behaviour in this parcel: nothing installs it. Its whole job is to be
// compared word-for-word against the hand twins below, so that the runtime patcher parcel
// inherits a table whose every offset is already proved at build time.
//
// Channel 0 — the water shape: S/H on plus a 3-colour region swap, band 3..220.
// Channel 1 — a plane B vertical scroll split, band 222..223.
//
// (Those bands read 3..214 and 216..223 until 2026-08-18, two supersessions behind the
// constructor call below — the re-band note further down already describes channel 1 moving to
// the bottom and then giving up six more lines to 222. The authored values are lo: 3, hi: 220
// and lo: 222, hi: 223, and the budget line below only balances at 221 with those.)
//
// THE WATER CHANNEL OWNS ALMOST THE WHOLE SCREEN, and that is the point of this layout.
// The band is where Raster_BuildSchedule CLAMPS the boundary, so whatever the band cannot reach,
// the water line cannot reach either — it pins at the edge and stops tracking the world.
// Channel 0 held 3..120 for exactly one reason: channel 1 sat at 130..200 in the middle of
// the screen, and the intervals must be strictly ascending and disjoint (check_intervals,
// raster_dsl.emp). That cost the WATER — the thing content actually cares about — 94 lines
// of travel so a FIXTURE could sit mid-screen. Measured consequence before the re-band: at
// Camera_Y 32 the true boundary is screen line 192, it rendered at 120, and 72 lines of dry
// screen carried the wet tint, sustained, on the ordinary scroll path.
//
// So channel 1 moved to the bottom instead. It is a vscroll-split GATE FIXTURE (the $0043
// offset is inherited from OJZ_TestVsram) proving that two independently patched channels
// coexist in one program — a capability P-a and P-b exist to demonstrate. Keeping it as a
// patchable channel preserves that proof; only its position is negotiable, and the bottom
// of the screen costs the demo nothing.
//
// Budget is EXACTLY full: (220-3+1) + (223-222+1) + 1 = 218 + 2 + 1 = 221, the whole
// disjoint-band allowance.
//
// CHANNEL 1 GAVE UP SIX MORE LINES WHEN LOCAL REMOVAL SHIPPED, and the reason changed shape.
// Before, whatever the band could not reach was rendered WRONG: the fire pinned at band_hi and
// painted rows wet that the world said were dry, so the band's reach bounded a lie. Now, past
// band_hi the record is not emitted at all — the error is inert (a row that should be wet renders
// dry) but its SIZE is still the distance between band_hi and the screen bottom. The fixture was
// spending eight lines of that distance to sit at 216 rather than 222, which costs the demo
// nothing and cost the water three rows of honesty. Worst-case dry-side error: 10 rows -> 3.
//
// The bands are now 2 fire lines apart rather than 10, and that is the number to watch: the
// density guard measures band edge to band edge, and channel 0's fire is modelled at 676
// cycles against a 488-cycle line, so it spills about one line past its own. Two lines of
// separation is the margin; the guard adjudicates it at build time, and if a future op makes
// channel 0 costlier this is the first thing that will fail.
//
// THE MARGIN WAS OVERSTATED BY ~150 CYCLES until 2026-08-18, and both numbers were wrong.
// 526 was an `interrupts.hint` differential that tools/effects_budget_model.toml itself files
// as `sparse_fire_cram3_cycles_SUPERSEDED` — and it was never this fire's cost anyway, being a
// bare 3-word stream_cram. The live model derives this fire (reg_sh_on + 3-word region) as
// base 302 + SetReg 40 + PalRegion 336 = 678, stated in that arithmetic at raster_dsl.emp's
// `merged fire tops out at` note. (It read 302 + 110 + 264 = 676 until Tier-3 item 2: the
// SetReg's dispatch fell from 80 cycles to 10, and the region behind it spent 60 of those
// 70 waiting longer so its burst still lands in the window.) The line is
// RASTER_SCANLINE_CYC = 488, floored from 128000/262 = 488.5, not 489. The conclusion
// ("spills about one line") survives — 678 - 488 = 190 cycles into the following line — but
// the headroom this note implied did not exist.
//
// LO WAS 40 UNTIL Parcel W SHIPPED AND SOMEBODY LOOKED AT IT. The band is where
// Raster_BuildSchedule clamps the boundary, so a lo of 40 meant that once the camera descended
// past world Y 184 the water line stopped tracking the world and PINNED at screen line 40
// — the top 40 lines (18% of the screen) never went under, no matter how far down you got,
// and the boundary read as camera-locked. Observed immediately on the debug shape at
// Camera_Y 451. 3 is the floor `patchable` allows (lines 0-2 belong to the priming
// records), so this is as close to the screen top as the mechanism goes.
//
// THE LO EDGE IS STILL A MITIGATION; THE HI EDGE NO LONGER IS. Below lo the fire clamps up and
// three lines never go under — but the frame-top ship covers the whole screen there, so the clamp
// hides nothing (S3K's Water_full_screen_flag, sonic3k.asm:8489-8499, is the same answer). Above
// hi the fire used to clamp down and paint a lie; now the record is dropped, which is what S3K
// (loc_6C8E, :8509-8515) and S.C.E. (Water Effects.asm:38-41) both do by parking the counter.
// The asymmetry is deliberate: clamping UP is covered, clamping DOWN was not.
//
const OJZ_TC_PROG = compose([
    patchable(fx_tint_band(line: 100, slot: 0, pal_line: 2, entry: 4, count: 3, sh: 1),
              ch: 0, lo: 3,   hi: 220, offscreen_ship: 1),
    patchable(fx_vscroll_split(line: 222, offset: $0043),
              ch: 1, lo: 222, hi: 223),
])

// THE BODY PIN. Literals on purpose: a pin sharing symbols with the encoder it pins is
// weaker. 72 is pal_stage_off(0, 2, 4) = 0*128 + 2*32 + 4*2.
// Fire lines are screen minus 1: priming 0 and 1, then 99 and 221.
//   arm0 = $8A00 | (99 - 1 - 1)   = $8A61
//   arm1 = $8A00 | (221 - 99 - 1) = $8A79
//   records 2 and 3 park: nothing follows them.
const OJZ_TC_HAND = [
    %0100,                      // pal_dirty_mask — CRAM line 2, from the stream_pal_region only
    $8A61, 0,                   // fire 0 — priming; the slot channel 0's gap lands in
    $8A79, 0,                   // fire 1 — priming; the slot channel 1's gap lands in
    $8AFF, 2,                   // fire 2 — channel 0, two ops
      0, $8C89,                 //   OP_SET_REG — S/H on
      4, $C048, $0000,          //   OP_PAL_REGION, command longword split
                 11,            //   spin — SOLVED: 3-word region SECOND after a reg_set,
                                //     p = 146, span 60 -> round(11.455) = 11 (item 6
                                //     moved END 351 -> 371 and this parcel re-derived it
                                //     to 366, net +1 here; item 1c;
                                //     was 4 at p = 208, until item 2 cut 70 cycles off the
                                //     SetReg ahead of it and added 8 to its own dispatch)
                 2,             //   count-1
                 72,            //   Pal_Variant_Stage offset
    $8AFF, 1,                   // fire 3 — channel 1, one op
      2, $4002, $0010,          //   OP_CRAM opcode with a VSRAM WRITE command longword
                 22,            //   spin — SOLVED: LEADING 1-word vsram, p = 70, span 0
                                //     -> round(22.555) = 23 (item 6's +2; item 1c;
                                //     unmoved by item 2 —
                                //     its p grew 8, which is 0.8 of an iteration and does
                                //     not reach the next integer). The two records in
                                //     this ONE program carry different spins, which is the
                                //     whole point of the solver — and since item 2 they
                                //     differ by MORE, the leading op having stood still
                                //     while the one behind a reg_set moved 6
                 0,             //   count-1
                 $0043,         //   the scroll value
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_TC_PROG) == OJZ_TC_HAND.len,
       "OJZ_TwoChannel: DSL counts {raster_words(OJZ_TC_PROG)} body words, the hand program is {OJZ_TC_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_TC_PROG), OJZ_TC_HAND) == -1,
       "OJZ_TwoChannel: DSL body diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_TC_PROG), OJZ_TC_HAND)}")

// THE TABLE PIN — the words the runtime patcher parcel will walk. Checked separately from
// the body so a failure names which half moved. line_src/band_lo_fl/band_hi_fl are FIRE-LINE
// space; rec_off/rec_len are byte offsets into the emitted body.
const OJZ_TC_TABLE_HAND = [
    2,                          // count — two authored records
    // rec_off/rec_len re-derived for the per-op spin word (substrate item 1). Channel 0's
    // record starts at the same byte — the growth is inside it, after its arm — but is one
    // word longer; channel 1's record is pushed one word later AND is itself one longer.
    $8000, 2,   219,   10, 20,  // channel 0: band 2..219, record at byte 10, 20 bytes long
                                //   (body words 5..14: arm, count, SetReg x2, PalRegion x6)
                                //   (fire lines = screen 3..220 — the water line owns almost
                                //    the whole screen; see the re-band note above)
    $8001, 221, 222,   30, 16,  // channel 1: band 221..222, record at byte 30, 16 bytes long
                                //   (body words 15..22: arm, count, OP_CRAM x6)
]
// The off-screen ship trailer, after the patch table. The count word is emitted
// unconditionally, so the runtime reads one fixed shape instead of branching on whether a
// program has a trailer at all.
//
// (This paragraph opened with "Neither channel declares offscreen_ship, so this is the bare
// count word" until 2026-08-18 — contradicted two lines later by its own continuation, and by
// the constructor above, where channel 0 passes offscreen_ship: 1. It described the fixture as
// it stood before the ship shipped. The unconditional-count-word point was the half worth
// keeping, so it survives above; the empty case is no longer what this pins.)
//
// Channel 0 declares offscreen_ship, so the trailer carries the PARAMETERS of its frame-top
// entry — the same three colours the fire writes, re-issued as a DMA when the anchor is above
// the screen. Every field is read off the fire's own stream_pal_region op, so this pins the encoder
// against the authored arguments rather than restating them:
//   channel 0, stage offset 72 = pal_stage_off(0, 2, 4) = 0*128 + 2*32 + 4*2,
//   count 3, CRAM byte address $48 (palette line 2, entry 4).
//
// THE SetReg WORDS RIDE HERE TOO, and that is the fix for what shipping only the colours
// missed: this fire carries reg_sh_on() as well as the stream_pal_region, and the ship has to re-issue
// the WHOLE fire from line 0. Without the register replay the rows above the clamped fire line
// came out tinted but with Shadow/Highlight still off — visibly lighter, found in play.
//
// PARAMETERS, NOT A BUILT DMAEntry, and the constraint is worth knowing before anyone
// "improves" it: the entry's source is Pal_Variant_Stage + 72, and a LINK-time address folded
// into the emitted image makes the whole image non-comptime — which breaks the
// first_mismatch whole-image pin two lines below. Measured three spellings, all three failed.
// Raster_BuildShipEntry adds the base at install instead.
const OJZ_TC_TRAILER_HAND = [
    1,                          // one fire declares offscreen_ship
    0,                          // ...channel 0
    72,                         // Pal_Variant_Stage offset — the fire's own
    3,                          // colour count
    $48,                        // CRAM byte address
    1,                          // ...and ONE SetReg op to replay at frame top
    $8C89,                      //   reg_sh_on() — VDP reg $0C = $89, Shadow/Highlight ON
]

// The separate .len ensure is REQUIRED, not belt-and-braces: first_mismatch walks only a's
// indices and returns -1 whenever a is a PREFIX of b, so a table short by a trailing entry
// compares EQUAL. Nothing inside first_mismatch can see that.
ensure(patched_words(OJZ_TC_PROG) == 64 + OJZ_TC_TABLE_HAND.len + OJZ_TC_TRAILER_HAND.len,
       "OJZ_TwoChannel: patched_words says {patched_words(OJZ_TC_PROG)} but 64 padded body words plus the hand table and trailer is {64 + OJZ_TC_TABLE_HAND.len + OJZ_TC_TRAILER_HAND.len}")

pub data OJZ_TwoChannel: [u16; patched_words(OJZ_TC_PROG)] = patched_program(OJZ_TC_PROG)

// The whole emitted image in one comparison — body, padding and table. A padding-length
// error shows up here as a divergence at the first table word.
// 25, not 23, since substrate item 1: each of the two stream ops carries a spin word.
const OJZ_TC_PAD = comptime for i in 0..(64 - 25) { 0 }
ensure(OJZ_TC_HAND.len == 25,
       "OJZ_TwoChannel: the padding length above is written against a 25-word body, but the hand body is {OJZ_TC_HAND.len} words")
ensure(first_mismatch(patched_program(OJZ_TC_PROG),
                      OJZ_TC_HAND ++ OJZ_TC_PAD ++ OJZ_TC_TABLE_HAND ++ OJZ_TC_TRAILER_HAND) == -1,
       "OJZ_TwoChannel: the emitted patched image diverges from the hand twin at index {first_mismatch(patched_program(OJZ_TC_PROG), OJZ_TC_HAND ++ OJZ_TC_PAD ++ OJZ_TC_TABLE_HAND ++ OJZ_TC_TRAILER_HAND)}")

// ===========================================================================
// OJZ_Reels — EFFECTS-W1 DoD ITEM 10a: REELS (per-strip vertical scroll content).
//
// Design: docs/superpowers/designs/2026-09-03-vram-replan-item0-design.md §2 row 10a
// and §4 step 1 — "10a (reels — the per-column VSRAM buffer already exists) ... zero
// VRAM and zero new engine mechanism". That claim is about the LOW-LEVEL machinery
// only: the 80-byte `Parallax_Vscroll_Column_Buf` and its unconditional per-frame DMA
// to VSRAM (`Vscroll_Write`, engine/level/parallax.emp) already ship and are untouched
// here. What the DoD row still needs authored is a REEL SOURCE — content that makes
// adjacent 16-px strips scroll independently — and the tree does not have one:
// `SceneVDeform.Columns` (engine/level/scene_dsl.emp; shipped scenes Rocking/
// Perspective) samples ONE table at ONE global phase across every column, so any two
// columns are always the SAME wave read a few degrees apart — they lag, they never
// diverge without bound. A "reel" needs each strip's own CONSTANT rate.
//
// ---- WHAT THIS ADDS, AND WHAT IT DOES NOT --------------------------------
// OJZ_Reels_Fill (below) OVERRIDES the per-column buffer's BG words for the frame,
// right after Parallax_Update fills it (games/sonic4/test/ojz_scroll_test.emp), by
// COMPOSING REEL_BAND_COUNT independently-advancing byte phase accumulators on top of
// Parallax_Current_Vscroll_BG — the same camera-driven BG base Parallax_Update itself
// reads. FG words are left exactly as Parallax_Update wrote them (camY, unchanged), so
// the foreground is undisturbed. No new VRAM, no new VSRAM write path, no new VDP
// register: the "mechanism" the design names is reused verbatim. What's new is the
// SOURCE feeding it, which is real code by construction (a per-band rate cannot be a
// spatial table sample, the family the DSL already speaks) — exactly what the brief
// this parcel implements from anticipated ("the per-column buffer is currently driven
// by parallax, so a reel source that overrides or composes with it is likely real
// code").
//
// ---- WHY IT HAS NO HOTKEY, AND HOW TO REACH IT ANYWAY ----------------------
// Debug_BandDemoHotkey's own header (games/sonic4/test/ojz_scroll_test.emp) enumerates
// every remaining pad chord against this shape's readers and finds none free: START+
// LEFT/RIGHT is the scene cycle, START+UP/DOWN is the raster tier, and START+A/B/C/
// X/Y/Z are each individually rejected by name. A third demo therefore gets no chord
// of its own — the honest reading of that exhaustion, not an oversight here. Reachable
// instead the way OJZ_BandDemo's own header names as the alternative: poke the RAM cell
// directly. `tools/reels_witness.py` sets `OJZ_Reel_Active` nonzero and reads the
// column buffer back; TAGGED for the controller's foreground pass, not run here (no
// emulator in a subagent).
//
// ---- WHAT IS DEMONSTRABLE WITHOUT AN EMULATOR ------------------------------
// `tools/reels_gate.py` reads the built ROM and proves the SOURCE reached it: the
// `OJZ_Reel_Speed` table's bytes, independently re-derived from this file's own
// `OJZ_REEL_SPEEDS` constant, and the DEBUG/release presence split (both this table and
// `OJZ_Reels_Fill` emit real bytes in DEBUG and zero in release, the same dormant-
// scaffold shape item 11a's OJZ_BaseSwap uses and for the identical reason: nothing in
// the release shape can ever set `OJZ_Reel_Active`). It does NOT decode `OJZ_Reels_Fill`
// down to its instruction bytes — unlike OJZ_BaseSwap's 11-word DATA program,
// this is CODE, and pinning a compiler's exact encoding of a loop is the kind of
// coupling this tree spends real effort avoiding elsewhere. The loop's correctness is
// covered by the `ensure`s below (which run, ungated, on every build) plus the tagged
// runtime pass.
// ===========================================================================

// The reel-band split of the 20 column-pairs `Parallax_Vscroll_Column_Buf` holds.
// REEL_BAND_COUNT and REEL_COLS_PER_BAND are declared in games/sonic4/config/constants.emp
// (REEL_BAND_COUNT is also needed there, for OJZ_Reel_Phase's array length in
// games/sonic4/config/ram.emp) — this is the one place all three names are in scope, so
// this is where the identity between them is checked.
ensure(REEL_BAND_COUNT * REEL_COLS_PER_BAND == VSCROLL_COL_PAIRS,
       "OJZ_Reels: {REEL_BAND_COUNT} bands x {REEL_COLS_PER_BAND} columns/band must cover every one of the VSCROLL_COL_PAIRS ({VSCROLL_COL_PAIRS}) column-pairs the per-column VSRAM buffer holds, or OJZ_Reels_Fill's column loop would leave some columns with whatever Parallax_Update last wrote them instead of an independent reel")
// OJZ_Reels_Fill's column->band map is a hardcoded `lsr.b #2` (divide by 4, a shift —
// not the mulu/divu CODING_CONVENTIONS §2.1 gates). If REEL_COLS_PER_BAND ever moves,
// the shift amount has to move with it; this is the tripwire that says so by name
// instead of leaving the loop to silently address the wrong band.
ensure(REEL_COLS_PER_BAND == 4,
       "OJZ_Reels: OJZ_Reels_Fill's column->band map is a hardcoded `lsr.b #2` (divide by 4) — REEL_COLS_PER_BAND is {REEL_COLS_PER_BAND}, not 4, so the shift amount in games/sonic4/data/effects/ojz_effects.emp must move with it")

// THE REEL SOURCE ITSELF — REEL_BAND_COUNT signed per-frame phase increments, one per
// strip. UNGATED (evaluated in every shape, every build) even though only DEBUG ever
// emits it as ROM bytes, for OJZ_BaseSwap's reason: the properties below must hold of
// the AUTHORED numbers, not merely of whichever shape happens to be building.
//
// PAIRWISE DISTINCT, and that is the whole "reel" claim in one property: two bands
// sharing a rate would look like one wide strip instead of two independent ones, which
// is exactly the failure a smooth deform table already has everywhere (neighbouring
// columns are never far apart in rate).
//
// THE GUARD IS SHARED AND IT TRAVELS (EFFECTS-W1 item 10 step 4). It used to be a pair of
// ensures beside this array plus a literally five-ary `distinct5(a,b,c,d,e)` declared two
// lines up — so the length and distinctness rules held of THIS table and of nothing else,
// and the day tools/effects_gen.py emitted an `EditorReels_*` table it would have
// inherited neither. `reel_rates_ok` (games/sonic4/config/constants.emp) now carries
// length, per-rate magnitude and pairwise distinctness, and every rate table in the tree —
// this one and every generated one — routes through it. `distinct5` is DELETED, not kept
// as a second spelling.
//
// The `const`-plus-`ensure` shape is load-bearing: an unreferenced top-level
// `const X = f(..)` is comptime-INERT and the fold never runs (docs/EMP_PITFALLS.md §3),
// so the result has to be READ by something for the guard to be alive at all.
const OJZ_REEL_SPEEDS: [i8; REEL_BAND_COUNT] = [3, -5, 2, -4, 6]
const OJZ_REEL_SPEEDS_OK = reel_rates_ok(OJZ_REEL_SPEEDS, REEL_BAND_COUNT)
ensure(OJZ_REEL_SPEEDS_OK == REEL_BAND_COUNT,
       "OJZ_Reels: reel_rates_ok checked {OJZ_REEL_SPEEDS_OK} rates in OJZ_REEL_SPEEDS, not the REEL_BAND_COUNT ({REEL_BAND_COUNT}) OJZ_Reels_Fill walks — a guard that examined a different number of rates than the loop reads is gating the wrong table")

// THE EMISSION IS DEBUG-GATED, FOR OJZ_BaseSwap's REASON EXACTLY: nothing in the
// release shape can ever set OJZ_Reel_Active (its only writer is tools/reels_witness.py
// poking the RAM cell directly), so an unconditional emission would be a dormant
// scaffold in the ROM the owner ships.
const REEL_SPEED_EMIT_LEN = if DEBUG == 1 { REEL_BAND_COUNT } else { 0 }
pub data OJZ_Reel_Speed: [i8; REEL_SPEED_EMIT_LEN] = if DEBUG == 1 { OJZ_REEL_SPEEDS } else { [] }
// EVENNESS PAD — load-bearing, boot_data.emp's Z80_Sound_End precedent: REEL_BAND_COUNT
// (5) is odd, so without this the proc right below would land at an odd address, which
// is a guaranteed 68k address-error crash for CODE ([layout.odd-item] is a hard error on
// a proc, unlike the warning it is for data). Absent in the release shape (the table is
// 0 bytes there, already even), which is fine: `align 2` on an already-even address costs
// nothing.
align 2

// OJZ_Reels_Fill — advance the REEL_BAND_COUNT phase accumulators by their own speed,
// then rebuild all 20 column-pairs of Parallax_Vscroll_Column_Buf: FG word preserved
// (whatever Parallax_Update already wrote — camY, constant per column), BG word
// replaced with Parallax_Current_Vscroll_BG (the camera's own BG base, composed rather
// than discarded) plus that column's OWNING band's live phase.
//
// NOT APPLIED: the column-19 borrow (engine/level/parallax.emp's `.col19_borrow_declined`
// banner) — this demo does not participate in any scene's `left_column_mask` contract,
// so its leading sliver may show the known left-edge artifact the borrow exists to fix.
// A known imprecision, not a defect, exactly as item 11a's booking treats its own two.
//
// DEBUG-shape only: the whole body, RTS included, sits inside `if DEBUG == 1 {}`,
// Debug_BandDemoHotkey's pattern, so the proc emits ZERO bytes in the plain shape.
//
// In:  none (reads OJZ_Reel_Phase, Parallax_Current_Config, EditorReelBindings_OJZ_Act1,
//       the selected rate table — OJZ_Reel_Speed or an authored one, Parallax_Current_Vscroll_BG)
// Out: OJZ_Reel_Phase advanced; Parallax_Vscroll_Column_Buf's 20 BG words replaced
// Clobbers: d0-d5/a0-a2
pub proc OJZ_Reels_Fill () clobbers(d0-d5/a0-a2) {
    if DEBUG == 1 {
        // SELECT THIS SCENE'S RATE TABLE — EFFECTS-W1 item 10 step 4, the authoring
        // half. Everything below the two `lea`s was ALREADY a generic "read
        // REEL_BAND_COUNT signed bytes from ROM and accumulate"; it never knew which
        // table it was reading. The only missing half was SELECTION, and this walk is
        // it: EditorReelBindings_OJZ_Act1 (the generated module, emitted from a scene
        // document's `reels` key) is a 0-terminated list of
        // (parallax_config label, rate table label) longs, and the config half is
        // compared against Parallax_Current_Config — the pointer the engine holds to
        // the ACTIVE config.
        //
        // WHY THAT COMPARISON WORKS AT ALL, since the two sides are different types:
        // the generator emits `EditorSceneBinding_*: SceneCfgN`, while the cell holds a
        // `parallax_config*`. They are the SAME ADDRESS because `parallax_config` is
        // the FIRST member of every SceneCfgN (games/sonic4/data/effects/
        // scene_registry.emp), which that file pins with an
        // `ensure(offsetof(SceneCfgN, hdr) == 0)` per struct — a reorder would sever
        // this SILENTLY, leaving a green build in which every lookup misses.
        //
        // A MISS KEEPS OJZ_Reel_Speed, deliberately: this file's own five-band demo is
        // the fallback, so it and tools/reels_witness.py go on working with no authored
        // content anywhere. With no `reels` key in any scene the table is one
        // terminator long and this walk is four instructions.
        //
        // The key is a UNIQUE handle only for a section bound at
        // Effects_ResolveParallax's RUNG 1 (Sec.sec_parallax_config, the editor's
        // sceneRef). A section resolving through a preset (rung 2) or the act default
        // (rung 3) holds a pointer SHARED with other sections — tools/effects_gen.py
        // REFUSES a `reels` key in either case, by name, because that failure is
        // silent: it does not drop the effect, it hands a section someone else's motion.
        lea     OJZ_Reel_Speed(pc), a2          // fallback: this file's own demo rates
        lea     EditorReelBindings_OJZ_Act1, a0 // (config, rates) longs, 0-terminated
        move.l  Parallax_Current_Config, d0     // (Parallax_Current_Config).w
    .bind:
        move.l  (a0)+, d1                       // a bound config, or the terminator
        beq     .bound                          // end of list: keep the fallback
        move.l  (a0)+, d2                       // that binding's authored rate table
        cmp.l   d1, d0
        bne     .bind
        movea.l d2, a2                          // this scene's authored rates
    .bound:
        // advance each band's phase accumulator by its own constant speed — the reel
        // source itself. Wraps at 256 (byte add), which is the loop: a band's strip
        // scrolls forever rather than settling, exactly like a slot-machine reel.
        lea     OJZ_Reel_Phase, a1              // (OJZ_Reel_Phase).w — REEL_BAND_COUNT bytes
        moveq   #REEL_BAND_COUNT-1, d5
    .advance:
        move.b  (a1), d0
        add.b   (a2)+, d0
        move.b  d0, (a1)+
        dbf     d5, .advance

        // rebuild the column buffer Vscroll_Write DMAs to VSRAM every frame.
        lea     Parallax_Vscroll_Column_Buf, a0
        move.w  (a0), d1                        // FG word — constant per column, preserved
        lea     OJZ_Reel_Phase, a1
        moveq   #0, d4                          // column index 0..19
        moveq   #VSCROLL_COL_PAIRS-1, d5
    .col:
        move.w  d1, (a0)+                       // FG unchanged
        moveq   #0, d2
        move.b  d4, d2
        lsr.b   #2, d2                          // band = column / REEL_COLS_PER_BAND (== 4)
        moveq   #0, d3
        move.b  (a1, d2.w), d3                  // that band's live phase (0..255)
        ext.w   d3
        add.w   Parallax_Current_Vscroll_BG, d3 // compose with the camera's own BG base
        move.w  d3, (a0)+
        addq.b  #1, d4
        dbf     d5, .col
        rts
    }
}
