// games/sonic4/data/effects/ojz_effects.emp — OJZ effects library.
//
// The raster/palette/stream_vsram/ramp gate fixtures for OJZ, split out of
// data/parallax/configs.emp (which had grown into two unrelated halves: the
// parallax config records and this effects library). This file IS the
// game-side effects library (design suite §6): the Phase-3 preset format and
// the `raster_dsl` general constructors supersede the hand-laid programs
// below, but the fixtures stay as the gate.
module games.sonic4.ojz_effects in ojz_effects

// The effects gate fixtures (below) are pinned against engine.vdp's comptime CRAM
// command builder.
use engine.vdp.{VdpTarget, VdpOp, vdp_comm}
// The sparse fixtures are authored through engine.effects.raster_dsl, which is a
// COMPTIME_HELPERS member and therefore ambient. What remains is the DENSE tier's
// import surface: raster_gradient_program's BODY names these, and a comptime fn's
// free names resolve at the EMISSION site's scope, so they must be visible HERE or
// they degrade to unresolved label refs.
use engine.effects.raster.{RASTER_ARM_PARK, RASTER_OPS_END, raster_arm}
// NOTE — no `use` of pal_stage_off is needed here, and briefly one was. fx_tint_band's body
// called it, and a comptime fn's free names resolve at the CALL SITE, so constructing a tint
// band from this file failed with four copies of "unknown function `pal_stage_off`" for a
// helper this file never names. OJZ_TwoChannel below was the FIRST fx_tint_band call site in
// the tree, which is why the preset had shipped broken since Parcel C1 unnoticed. Fixed at
// the source: fx_tint_band now inlines the staging arithmetic, pinned to pal_stage_off by a
// module-level ensure in raster_dsl — so no author has to import a helper they never wrote.
// RASTER_ARM_EVERY_LINE + OP_RUN_GRADIENT are imported even though nothing in THIS
// file names them: a comptime fn's struct-literal field values are resolved at the
// EMISSION site's scope, not the definition site (the same late-binding rule the
// `asm {}` splice helpers document), so raster_gradient_program's own constants must
// be visible HERE or they degrade to unresolved label refs.
//
// WHICH ERROR YOU GET DEPENDS ON THE DESTINATION FIELD'S TYPE. Measured 2026-08-13 by
// deleting RASTER_ARM_PARK + RASTER_OPS_END from the import above: the names DID degrade
// to label references, and the build failed as `[emit.type] expected an integer for u16,
// got label` — named and phase-early, because rgp_end_arm/rgp_end_ops are u16. Into a
// POINTER-typed field a label reference is well-typed, so emit accepts it and the catch
// DEFERS to link, arriving positionally instead: `unresolved symbol ... for fixup in
// section ... at offset ...` (sigil-link/src/lib.rs:432; comptime constants lower to zero
// link symbols, so a degraded constant has no definition to find). Not silent — deferred
// and de-named. The one genuinely silent case is a degraded name that collides with a
// real label or `equ`.
use engine.effects.raster.{RasterGradientProgram, RASTER_CRAM_MAX, raster_gradient_program, RASTER_ARM_EVERY_LINE, OP_RUN_GRADIENT, OP_RUN_RAMP, RasterRampProgram, raster_ramp_program, fp16}
// Raster_Program_None — the "raster OFF" sentinel, needed by the Parcel C2 Task 12
// presets below (total binding: a preset that means "no raster" must say so
// explicitly rather than leaving ep_raster at 0/"keep").
use engine.effects.raster.{Raster_Program_None}
use engine.effects.palette.{pal_cycle_channel, PalCycleScript1, pal_variant}
// Pal_Cycle_None — the "cycling OFF" sentinel, same total-binding reasoning as
// Raster_Program_None above.
use engine.effects.palette.{Pal_Cycle_None}
use engine.effects.palette_dsl.{cycle_channel, cycle_script1, variant}
// EffectsPreset / preset() — the Phase-3 total-binding format Task 12 switches
// OJZ act 1's sections onto (engine/effects/preset.emp).
use engine.effects.preset.{EffectsPreset, preset}
// Parcel W: section 0 binds its parallax config through the PRESET (ep_parallax) rather
// than inheriting the act default, because the overlay's anchor channel has to be the same
// channel the patched palette boundary rides. This is also the first ep_parallax binding in
// the tree — the field existed since C2 and was 0 in every preset, i.e. an authoring surface
// that had never once executed.
// TWO LINES, AND BOTH ARE LOAD-BEARING (scanline-P1 Task 9). The name list is the symbol;
// the WHOLE-PATH line is the CLOSURE EDGE. games.sonic4.scene_registry is not in sigil's
// module registry (crates/sigil-harness/src/native.rs) — it is placed by being reached —
// and a selective import alone injects a clone of the imported name into THIS scope without
// elaborating the callee (Task 5's probe). Cut the whole-path line and the registry's
// capability-subset ensure, every guard in engine/level/scene_dsl.emp behind it, and the
// twenty records themselves go dark: an unreached module gets parse + scan coverage and
// ZERO body elaboration. This edge replaces the temporary one that lived in the now-deleted
// data/parallax/configs.emp.
use games.sonic4.scene_registry
use games.sonic4.scene_registry.{ParallaxConfig_OJZ_Underwater}
// STRICTLY REDUNDANT, KEPT AS DOCUMENTATION — and the redundancy is measured, not
// assumed: deleting this line leaves both shapes byte-identical. engine.effects.raster_dsl
// is a COMPTIME_HELPERS member, and the native harness DROPS every source `use` whose base
// is a helper module, then prepends one glob per helper to every module
// (`normalize_helper_imports`, sigil crates/sigil-harness/src/native.rs:1077-1126). So this
// exact line is deleted and regenerated on every build; it cannot be load-bearing.
// It stays because the fixtures below call raster_dsl's constructors (`fire`, `stream_cram`,
// `reg_sh_on`, `region_boundary`, `raster_program`, `raster_words`, `first_mismatch`) as bare
// names, and this is the only place in the file that says where they come from. If
// raster_dsl ever leaves the helper set, this line is what keeps the file building —
// and what keeps the module's own `ensure`s evaluated, since an unimported comptime
// module's module-level `ensure`s do not fail, they simply never run.
use engine.effects.raster_dsl.*

// ===========================================================================
// EFFECTS P1 GATE FIXTURES — the first raster program and the first per-section
// palette. These live beside the parallax configs because this file IS the
// game-side effects library (design suite §6); the Phase-3 preset format and the
// `raster_dsl` general constructors supersede the hand-laid words below.
// ===========================================================================

// The CRAM-write command longword for colour 0, split into the two words the
// program format carries. Pinned against the comptime builder so a change in
// engine.vdp's command encoding fails the build instead of writing to VRAM.
// The gate writes CRAM entry $4A = palette line 2, entry 5 — measured to be OJZ's
// single most-used ground colour (~54% of the lower-screen pixels). Colour 0 (the
// backdrop) was the obvious first choice and is the WRONG one: OJZ's art covers the
// backdrop everywhere, so the effect was invisible and the gate unfalsifiable.
// Pinned against the comptime builder so an encoding change fails the build rather
// than quietly writing somewhere else.
const OJZ_TEST_CRAM_ADDR = $4A
ensure(vdp_comm(OJZ_TEST_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C04A0000,
       "vdp_comm's CRAM encoding changed — the raster DSL now derives OJZ_TestRaster's command words, so a drift here moves the emitted program")

// OJZ_TestRaster — the P1 acceptance program: below screen line 120, turn
// Shadow/Highlight ON and repaint OJZ's dominant ground colour bright red. Two
// different mechanisms (a mode-register write and a CRAM write) firing at the same
// line, so the gate exercises the multi-op path rather than a single write — and
// the CRAM half is chosen to be objectively measurable from a screenshot.
//
// The fire schedule below is now DERIVED. Kept as prose because it is what the arm
// words mean, and the walk-through is the thing a reader needs:
//   fire 0 @ line 0    priming, arm = $8A00 | (120 - 3) = $8A75 (117)
//   fire 1 @ line 1    priming, arm = park (nothing scheduled after the event)
//   fire 2 @ line 119  the event; its writes land on line 120
// VBlank leaves reg $0A = 0 -> fire 0 at line 0, reload 0 -> fire 1 at line 1,
// reload 117 -> fire 2 at 1 + 117 + 1 = 119. Effect on 120.
//
// pal_dirty_mask is DERIVED from the CRAM address ($4A >> 5 = line 2), so the mask
// can no longer name the wrong line — the observed P1 bug, where a mask of %0001
// against an op writing line 2 left the red latched over the whole ground instead of
// only below the split.
const OJZ_TEST_PROG = [
    fire(120, [ reg_sh_on(),                       // S/H ON below the line
                stream_cram($4A, [$000E]) ]),      // bright red at line 2 entry 5
]

// THE PIN (design spec 8.1). The hand-authored words are the ones measured on
// hardware during P1; the DSL must reproduce them exactly. Retained deliberately
// rather than deleted: a `const` emits nothing, and it turns a Parcel-C/D regression
// from "golden ROM differs" into a named index — the negative control that proved this
// pin bites flipped the colour word and got "diverges ... at index 15". It retires in
// Parcel D together with the fixture it pins (design spec 8.2).
// Literals on purpose: a pin sharing symbols with the encoder it pins is weaker.
// raster_dsl's module-level ensures hold these against engine.effects.raster.
const OJZ_TEST_HAND = [
    %0100,                      // pal_dirty_mask — the WHOLE header, one word
    $8A75, 0,                   // fire 0 — priming; arm = $8A00 | (120 - 3)
    $8AFF, 0,                   // fire 1 — priming; nothing after the event, so park
    $8AFF, 2,                   // fire 2 — the event, two ops
      0, $8C89,                 // OP_SET_REG
      2, $C04A, $0000,          // OP_CRAM, command longword split
                 0, $000E,      // count-1, the colour
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_TEST_PROG) == OJZ_TEST_HAND.len,
       "OJZ_TestRaster: DSL counts {raster_words(OJZ_TEST_PROG)} words, the hand program is {OJZ_TEST_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_TEST_PROG), OJZ_TEST_HAND) == -1,
       "OJZ_TestRaster: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_TEST_PROG), OJZ_TEST_HAND)}")

pub data OJZ_TestRaster: [u16; raster_words(OJZ_TEST_PROG)] = raster_program(OJZ_TEST_PROG)

// OJZ_TestPal — a deliberately unmistakable palette for the adjacent section, so
// "did sec_pal load on the crossing?" is answerable from one CRAM read or
// screenshot. Not a tinted copy of the real palette: a subtle shift would make a
// NEGATIVE result (consumer never ran) look like a positive one.
//
// 48 words = 96 bytes = CRAM lines 1-3, matching the sec_pal contract. It must NOT
// cover line 0: that is the character's line (CharacterDef.cd_palette), and a
// section palette that overwrote it would repaint the active character on every
// boundary crossing.
comptime fn test_palette() -> [u16; 48] {
    return comptime for i in 0..48 {
        (((i * 14) / 47) << 9) | (((i & 3) * 2) << 4)
    }
}

pub data OJZ_TestPal: [u16; 48] = test_palette()

// ===========================================================================
// EFFECTS P2 GATE FIXTURES — the palette-cycling band (Task 8) and the OJZ water
// cluster (Task 7). Authored here, the game-side effects library.
// ===========================================================================

// OJZ_ShimmerCycle — a per-section cycling band: rotate line-2 entries 8..11 on a
// NINE-frame cadence. `sec_pal_cycle` finally gets a consumer; the controller reads CRAM
// per frame to confirm the rotation period. Line 2 (not 0 — the character's).
//
// `period: 8` yields 9 frames, not 8, and this comment used to say 8. The runtime
// (Palette_RunCycles) rotates, THEN reloads the timer with `period`, then spends one
// frame per decrement down to zero before the next rotation — so the cadence is
// period + 1. The field comment calls it "frames between rotations", which is literally
// true (there are 8 non-rotating frames between two rotations) and reads as the cadence,
// which it is not. Nothing measured this in either direction: there is no cycling row in
// the budget model and no GATE-EVIDENCE cycling capture. Corrected as documentation only
// — making `period: N` mean N frames is a runtime change that moves bytes, and it is
// booked rather than smuggled into a zero-byte parcel.
pub data OJZ_ShimmerCycle: PalCycleScript1 = cycle_script1(
    [ cycle_channel(line: 2, first: 8, count: 4, period: 8) ])

// OJZ_WaterRaster — the water-cluster raster TEMPLATE (Task 7). At the water line it
// (1) turns Shadow/Highlight ON ($8C89 — bit 3 set, resolution bits unchanged per the survey V28/V30
// ruling) and (2) swaps line-2 entries 4-6 to the deep-water variant's derived bytes
// via OP_PAL_REGION streaming from Pal_Variant_Stage slot 0. The priming arm word
// (arm0) is what the template ships with (water line 120), and it is now a STATIC line:
// the single-channel water patcher that used to overwrite it is deleted (P-b), and a
// boundary that moves is authored as a `patchable` record instead — see OJZ_TwoChannel.
//
// pal_dirty_mask %0100 re-asserts CRAM line 2 every frame, so the mid-frame region
// swap is transient (base restored at frame top -> above the line = base palette, below
// = deep-water). The CRAM command is pinned to the comptime builder.
//
// S/H CONTENT FINDING (plan Task 7 Step 3 — stated, not silently dropped). The
// $8C89 write turns Shadow/Highlight ON below the water line, but S/H only dims
// LOW-priority pixels and OJZ's plane art is HIGH-priority (the P1 residual). Making
// the tiles below the water line low-priority is a CONTENT change: the priority bit is
// baked into the generated OJZ block/nametable data, and the tile-cache stream writes
// those words verbatim — there is no priority-clearing hook in the engine. Regenerating
// that data runs through tools/ojz_strip_gen.py + games/sonic4/data/editor/ojz, which
// this parcel is forbidden to touch (auto-commit daemon). So S/H transparency CANNOT be
// visually demonstrated on OJZ's current art; the op provably EXECUTES (it precedes the
// region op in the same fire, and a mis-parse would desync the CRAM command into
// garbage) but has nothing to dim. Proving S/H needs low-priority water content, which
// is out of this parcel's scope — flagged for the controller/user.
const OJZ_WATER_CRAM_ADDR = $48                 // CRAM line 2, entry 4
ensure(vdp_comm(OJZ_WATER_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C0480000,
       "vdp_comm's CRAM encoding changed — the raster DSL now derives OJZ_WaterRaster's command words, so a drift here moves the emitted program")

// The water line. Static since P-b deleted the single-channel patcher; a moving boundary
// is a `patchable` record with a world anchor now, not a runtime write to this program.
const OJZ_WATER_LINE = 120

const OJZ_WATER_PROG = [
    region_boundary(line: OJZ_WATER_LINE,
                    addr: OJZ_WATER_CRAM_ADDR,   // $48 — CRAM line 2, entry 4
                    slot: 0, pal_line: 2, entry: 4, count: 3,
                    sh:   1),
]

// THE PATCH-OFFSET INVARIANT IS DELETED HERE, and this note is what replaces it.
//
// It asserted that the word at WATER_TEMPLATE_ARM0_OFF (a fixed byte offset 2) was the
// priming arm word for OJZ_WATER_LINE, because Raster_PatchWaterLine wrote that byte
// offset on all three of its exit paths, unconditionally and sight-unseen. Both the
// constant and that proc are gone in P-b: there is no longer a runtime write to a fixed
// offset in this program for anything to be wrong about.
//
// IT IS SUPERSEDED, NOT MERELY OBSOLETE, and that distinction is the only thing that
// makes deleting it safe. P-a's guard 6 (check_arm_layout, raster_dsl.emp) asserts the
// identical property for EVERY record of EVERY patched template, and asserts it twice
// over: that the word each patch-table offset points at is a VDP reg $0A write, and that
// its VALUE equals the arm the schedule independently derives. That is strictly stronger
// than one hand-written check on one program's word 1 — it scales with the content
// instead of being re-written per fixture, and it is the guard that actually stands
// between the runtime patcher and decrementing a record's op_count until `dbf` walks ROM
// as opcodes inside a raw interrupt handler.
//
// This program is no longer patched at all, so guard 6 does not cover it — and does not
// need to, because nothing writes it at runtime. OJZ_WATER_HAND below still pins every
// word of it. The predecessor guard was kept through two parcels on the reasoning that
// OJZ_WATER_HAND retires in Parcel D and this would then be the only build-time check on
// a word the runtime overwrote; that reasoning expires with the overwrite itself.

// THE PIN (design spec 8.1) — the words measured on hardware during P2. Retires in
// Parcel D with the fixture.
// Literals on purpose: a pin sharing symbols with the encoder it pins is weaker.
// raster_dsl's module-level ensures hold these against engine.effects.raster.
// 72 is pal_stage_off(0, 2, 4) = 0*128 + 2*32 + 4*2.
const OJZ_WATER_HAND = [
    %0100,                      // pal_dirty_mask — the WHOLE header, one word
    $8A75, 0,                   // fire 0 — priming; arm0, the word the runtime patches
    $8AFF, 0,                   // fire 1 — priming
    $8AFF, 2,                   // fire 2 — the event, two ops
      0, $8C89,                 // OP_SET_REG
      4, $C048, $0000,          // OP_PAL_REGION, command longword split
                 2,             // count-1
                 72,            // Pal_Variant_Stage offset
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_WATER_PROG) == OJZ_WATER_HAND.len,
       "OJZ_WaterRaster: DSL counts {raster_words(OJZ_WATER_PROG)} words, the hand program is {OJZ_WATER_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_WATER_PROG), OJZ_WATER_HAND) == -1,
       "OJZ_WaterRaster: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_WATER_PROG), OJZ_WATER_HAND)}")

pub data OJZ_WaterRaster: [u16; raster_words(OJZ_WATER_PROG)] = raster_program(OJZ_WATER_PROG)

// ---------------------------------------------------------------------------
// OJZ_TestGradient — the DENSE-tier gate (Task 5 Step 4). A 96-line ramp across
// screen lines 96..191, rewriting CRAM line 2 entries 4-6 on EVERY line.
//
// MEASUREMENT — corrected 2026-08-14, after the prescription below was tried and
// found to be the wrong instrument.
//
// This used to read: "measurement is by per-scanline CRAM read (oracle
// run_to_scanline + read_cram), NOT by counting screenshot pixels". **That does not
// work for this fixture.** `emulator_read_cram` cannot see a mid-scanline CRAM write
// during active display, and this program's whole point is that its writes are
// TRANSIENT — the header's pal_dirty_mask re-asserts CRAM line 2 every frame, so by
// the time any post-frame read happens the base palette is back. Sampling CRAM at
// VBlank returns the BASE values and reads as "the gradient did nothing".
// (`run_to_scanline` is also frame-granular in practice — polling lands a whole frame
// past the target, not a scanline.)
//
// The FRAMEBUFFER is the correct instrument, because it records what each scanline
// was rendered with. Measured that way on 2026-08-14, against a control with the
// program uninstalled: 8 distinct monotonic levels, band boundaries landing exactly
// on 96+12k, first differing row exactly 96, and all three channel mixes present on
// every row.
//
// The art-swamping worry that motivated the CRAM prescription is real but does not
// apply here: it bites a PIXEL-COUNT signal, and this is not one. Each row is
// classified by the ramp LEVEL recovered from the changed pixels' colour, so art
// coverage changes how many pixels carry the signal without changing what the signal
// says. (`read_cram` remains valid for a whole-frame `sec_pal` base palette DMA'd at
// VBlank — the correction is specific to mid-frame writes.)
//
// The three entries carry DELIBERATELY DIFFERENT words at the same ramp level —
// blue, blue+green, blue+red. A stream desync of one word (the classic off-by-one in
// a dense run) therefore shows up as the wrong CHANNEL MIX at the right level, which
// is distinguishable from a run that is merely shifted by a line. Three words is
// RASTER_CRAM_MAX exactly, so this also pins the per-fire ceiling.
const OJZ_GRAD_TOP   = 96
const OJZ_GRAD_LINES = 96
ensure(RASTER_CRAM_MAX == 3,
       "OJZ_TestGradient's 3-words-per-line stream assumes RASTER_CRAM_MAX == 3")

// CRAM line 2, entry 4 — the same base as the water region, so the ramp lands on
// OJZ's dominant ground colours (entry 5 is ~54% of lower-screen pixels; see the
// OJZ_TestRaster note) and the effect is visible as well as measurable.
const OJZ_GRAD_CRAM_ADDR = $48
ensure(vdp_comm(OJZ_GRAD_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C0480000,
       "vdp_comm's CRAM encoding changed — raster_gradient_program is handed this very call's result as rgp_cmd, so a drift here moves the emitted program")

// Genesis CRAM is 3 bits per channel, so 8 levels is the hardware's whole range: the
// ramp steps every 12 lines and a "monotonic ramp" claim means non-decreasing with
// exactly 8 distinct levels, not 96. Channel positions are R<<1, G<<5, B<<9.
comptime fn grad_word(i: int) -> int {
    let level = ((i / RASTER_CRAM_MAX) * 8) / OJZ_GRAD_LINES   // 0..7 over the run
    let ch    = i % RASTER_CRAM_MAX
    if ch == 0 { return level << 9 }                    // entry 4 — blue
    if ch == 1 { return (level << 9) | (level << 5) }   // entry 5 — blue + green
    return (level << 9) | (level << 1)                  // entry 6 — blue + red
}

pub data OJZ_GradientStream: [u16; 288] = comptime for i in 0..288 { grad_word(i) }
ensure(288 == OJZ_GRAD_LINES * RASTER_CRAM_MAX,
       "OJZ_GradientStream length must be lines * words-per-line")

// The mask is no longer passed: raster_gradient_program DERIVES it from cmd's CRAM
// address ($48 >> 5 = line 2), so "re-assert CRAM line 2 each frame -> the ramp is
// transient" is now a property of the address rather than a claim this call site makes
// and the engine trusts. stream_words is the array's real length, checked there against
// lines * RASTER_CRAM_MAX — the ensure that used to sit beside the stream below.
pub data OJZ_TestGradient: RasterGradientProgram = raster_gradient_program(
    top:          OJZ_GRAD_TOP,
    lines:        OJZ_GRAD_LINES,
    cmd:          vdp_comm(OJZ_GRAD_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write),
    stream:       OJZ_GradientStream,
    stream_words: 288)

// ===========================================================================
// EFFECTS P3 GATE FIXTURE — the first VSRAM raster program in this engine.
//
// WHAT IT PROVES. Raster_HInt's CRAM op was never CRAM-specific: it writes
// whatever VDP command longword the program carries (`move.l (a1)+, (a2)`) and
// then streams words to VDP_DATA. Only the CONSTRUCTORS were locked to
// VdpTarget.Cram. `stream_vsram()` (2026-08-14) removes that lock, and this fixture is
// the first program to exercise it — no runtime change was needed for any of it.
//
// WHAT IT LOOKS LIKE. Below screen line OJZ_VSRAM_LINE, plane B's vertical
// scroll snaps to a fixed offset, so the background jumps 67 px at that line and
// stops tracking the camera vertically below it. A hard horizontal seam across
// the BG, which is what makes the boundary line measurable from a screenshot.
//
// WHY ONE ENTRY AND NOT A COLUMN. Reg $0B bit 2 is 0 here (measured on oracle:
// the VDP shadow reads $03, so HScroll mode %11 = per-line and vscroll mode = 0 =
// FULL-SCREEN), so the VDP reads only VSRAM entry 0 (plane A) and entry 1 (plane
// B) — byte addresses 0 and 2 — for every column. Writing byte 2 mid-frame
// therefore re-scrolls the whole of plane B for every line rendered after the
// write. This is Thunder Force IV's shape.
//
// WHY PLANE B AND NOT PLANE A. Mid-frame vertical scroll of plane A is UNSAFE in
// this engine: TILE_CACHE_ROWS = 60 means the rows around the camera window are
// the streamer's WORKING MARGIN, not display-ready content, and a large shift
// points the VDP straight at that scratch space — stale/half-written tiles on
// screen (observed on the first cut of this fixture, which targeted byte 0).
// This is why the reference corpus banks VSRAM banding on plane B.
//
// MEASURED ON ORACLE 2026-08-14 — the two things this fixture exists to settle:
//
//   1. IT WORKS, AND IT LANDS ON N+1. Against a control build identical but for
//      the offset ($0043 vs $0000), the first differing pixel row is EXACTLY
//      y=112, the authored line; rows 108-111 are pixel-identical and every row
//      from 112 to 223 differs — measured with plane A composited ON and again
//      with it OFF (16,630 differing pixels both ways, so occlusion is a
//      non-factor). A VSRAM write from HInt takes effect on the line after the
//      fire, and the DSL's existing `-1` fire-line arithmetic is CORRECT for
//      VSRAM — no separate rule is needed. Same y=112 result as the earlier
//      plane A (byte 0) measurement. This closes the N+1-vs-N+2 question
//      DEFERRED_WORK booked when stream_vsram() was added.
//
//   2. EMULATOR CAVEAT, recorded rather than glossed. Emulators disagree about
//      mid-frame VSRAM: GensKMod latches at HBlank start, Exodus/BizHawk consult
//      continuously. Oracle is Exodus-derived, so this measurement reflects the
//      continuous reading. This project verifies on oracle by policy and has no
//      real hardware, so N+1 is the standard of evidence available — but a
//      latching implementation could differ, and that is a known unknown.
//
// WHY THE OFFSET IS 67 AND NOT 64 — the resolved plane B "mystery". A $0040
// write to this plane produced ZERO differing pixels against control (plane A
// on or off) while $0043 produced 16,630 from y=112 down. The OJZ BG nametable
// is vertically PERIODIC: the trunk band cycles every 8 tile rows (exactly
// 64 px), the canopy every 4 rows (32 px), and every row repeats every 16 tiles
// horizontally (read off $E000 on oracle) — so a 64 px scroll maps plane B onto
// itself pixel-for-pixel. The write worked all along; the art hid it. Read the
// period off the nametable before choosing a banding offset here.
//
// WHY IT IS TRANSIENT. Vscroll_Write rewrites VSRAM[0]/[1] every VBlank, so the
// base is restored at frame top exactly the way pal_dirty_mask restores a palette
// line. Inferred from the image being stable frame to frame rather than drifting;
// not separately instrumented.
//
// NOTE arm0 sits at word 1, as it does in every program — the header is a single
// word. It used to depend on whether the program carried a frame-top init word
// (this one carries none, having no reg_set), which is why it once had to be kept
// away from the water patch slot; that coupling is gone.
const OJZ_VSRAM_LINE = 112              // split the 224-line display in half
const OJZ_VSRAM_OFFSET = $0043          // 67 px — NOT 64: the BG art is 64 px-periodic (see above)

const OJZ_VSRAM_PROG = [
    fire(OJZ_VSRAM_LINE, [ stream_vsram(2, [OJZ_VSRAM_OFFSET]) ]),   // byte 2 = VSRAM entry 1 = plane B
]

// THE PIN. Hand-derived from the wire format, and read as the twin the DSL must
// reproduce. 14 words: 1 header + 4 priming + 7 event + 2 terminator.
//   arm0 = $8A00 | (112 - 3) = $8A00 | 109 = $8A6D
//   cmd  = vdp_comm(2, Vsram, Write) — VSRAM write at byte 2 = entry 1 = plane B
// Literals on purpose: a pin sharing symbols with the encoder it pins is weaker.
const OJZ_VSRAM_HAND = [
    0,                                  // pal_dirty_mask — 0: a VSRAM op dirties no palette line
    $8A6D, 0,                           // fire 0 — priming; arms the gap that lands fire 2 on 111
    $8AFF, 0,                           // fire 1 — priming; nothing after the event, so park
    $8AFF, 1,                           // fire 2 — the event, one op
      2, $4002, $0010,                  //   OP_CRAM opcode, VSRAM write cmd @ byte 2 = $40020010
                                        //   (type&rwd = VSRAM&WRITE = %000101: bits 1-0 -> $40000000,
                                        //    addr -> high word, bits 7-2 -> $10 in the low word)
                 0, OJZ_VSRAM_OFFSET,   //   count-1 = 0, one scroll word
    $8AFF, $FFFF,                       // terminator
]
ensure(raster_words(OJZ_VSRAM_PROG) == OJZ_VSRAM_HAND.len,
       "OJZ_TestVsram: DSL counts {raster_words(OJZ_VSRAM_PROG)} words, the hand program is {OJZ_VSRAM_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_VSRAM_PROG), OJZ_VSRAM_HAND) == -1,
       "OJZ_TestVsram: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_VSRAM_PROG), OJZ_VSRAM_HAND)}")
// The derived mask MUST be 0. A CRAM-style mask from a VSRAM address would be
// 1 << (2 >> 5) = 1 = CRAM line 0, the CHARACTER's line — re-asserted every frame
// for no reason. This ensure is the guard on op_mask's VSRAM arm.
ensure(raster_program(OJZ_VSRAM_PROG)[0] == 0,
       "OJZ_TestVsram: pal_dirty_mask is {raster_program(OJZ_VSRAM_PROG)[0]}, not 0 — a VSRAM op must dirty no palette line")

pub data OJZ_TestVsram: [u16; raster_words(OJZ_VSRAM_PROG)] = raster_program(OJZ_VSRAM_PROG)

// COMPOSITION EQUIVALENCE PROOF (Parcel C1). The preset path must reproduce the
// hand-authored program EXACTLY before anything is built on top of it — the same
// re-express-then-extend standard the DSL itself was held to in Parcel A.
//
// Paired with a length check ON PURPOSE: first_mismatch walks only its first argument's
// indices, so it returns -1 whenever that argument is a PREFIX of the second. A preset
// path short by a trailing record would compare EQUAL without this.
//
// This is a `const`, so it emits nothing — the proof costs zero ROM bytes.
const OJZ_VSRAM_VIA_PRESET = compose([ fx_vscroll_split(OJZ_VSRAM_LINE, OJZ_VSRAM_OFFSET) ])
ensure(raster_words(OJZ_VSRAM_VIA_PRESET) == raster_words(OJZ_VSRAM_PROG),
       "preset path emits {raster_words(OJZ_VSRAM_VIA_PRESET)} words, hand-authored is {raster_words(OJZ_VSRAM_PROG)}")
ensure(first_mismatch(raster_program(OJZ_VSRAM_VIA_PRESET), raster_program(OJZ_VSRAM_PROG)) == -1,
       "preset path diverges from the hand-authored program at word {first_mismatch(raster_program(OJZ_VSRAM_VIA_PRESET), raster_program(OJZ_VSRAM_PROG))}")

// ===========================================================================
// RAMP GATE FIXTURE — the first COMPUTED per-line raster values in this engine.
//
// A dense run pointed at plane B's VSRAM entry, whose per-line value comes from a
// 16.16 accumulator rather than a baked ROM stream. Each scanline scrolls plane B
// by a different amount, so the background is progressively stretched down the
// run — the vertical-scale family (squash, stretch, perspective floor).
//
// STEP IS 0.5 px/line ON PURPOSE. A whole-pixel step would pass even if the
// fractional half of the accumulator were dropped entirely; at 0.5 the integer
// output only advances every OTHER line, so the fixture fails loudly if the 16.16
// arithmetic is wrong. That is the property worth pinning — the fixed point IS
// the feature, since it is what lets a rate be authored finer than a pixel.
const OJZ_RAMP_TOP   = 112
const OJZ_RAMP_LINES = 96
const OJZ_RAMP_STEP  = fp16(0, 128)     // +0.5 px per line

// The run WRITES the VSRAM entry rather than adding to it, so the control must be a
// ramp too — same program, step 0 — or the comparison would confound "the ramp" with
// "the ramp replaced the parallax system's base scroll".
pub data OJZ_TestRamp: RasterRampProgram = raster_ramp_program(
    top:   OJZ_RAMP_TOP,
    lines: OJZ_RAMP_LINES,
    cmd:   vdp_comm(2, VdpTarget.Vsram, VdpOp.Write),   // byte 2 = entry 1 = plane B
    start: 0,
    step:  OJZ_RAMP_STEP)

// ===========================================================================
// STARTER PALETTE VARIANTS — moved here from engine/effects/palette.emp in
// Parcel C2 Task 11.
//
// WHY GAME-SIDE. These are emitted `pub data`, and an engine module has no
// business emitting a game's data. The split that matters is constructor vs
// instance: the ENGINE keeps `variant()` (comptime, zero bytes, exactly the shape
// raster_dsl's `fx_*` presets already have) and each game emits its own instances
// from it. Nothing in engine/ referenced any of these — checked before the move.
//
// FOUR OF THE FIVE ARE UNREFERENCED, and that is recorded rather than quietly
// tidied away. Only Variant_Water_Deep has a consumer (games/sonic4/test/
// ojz_scroll_test.emp:277); Murky, Poison, CaveDark and Dusk cost 32 emitted bytes
// between them and are read by nothing. They are deliberate "give people ideas"
// seeds, so they survive the move intact — but a later parcel deciding whether to
// keep them now has the usage data instead of having to re-derive it.
//
// Variant_Water_Murky and Variant_Dusk are BYTE-IDENTICAL (both shift_b:1,
// bias_r:1) — two names for the same 8 bytes. Kept as distinct names on purpose:
// they document two different intents, and deduping them would save 8 bytes while
// making the seed list read as if murk and dusk were the same idea.
// ===========================================================================
pub data Variant_Water_Deep:  pal_variant = variant(shift_r: 1, shift_g: 1)                 // halve R+G, keep B
pub data Variant_Water_Murky: pal_variant = variant(shift_b: 1, bias_r: 1)                  // halve B, warm bias
pub data Variant_Poison:      pal_variant = variant(shift_r: 1, shift_b: 1, bias_g: 1)      // halve R+B, green push
pub data Variant_CaveDark:    pal_variant = variant(shift_r: 1, shift_g: 1, shift_b: 1)     // halve all
pub data Variant_Dusk:        pal_variant = variant(shift_b: 1, bias_r: 1)                  // halve B, small R bias

// ===========================================================================
// PARCEL C2 TASK 12 — OJZ act 1 total-binding presets.
//
// The nine act_descriptor.emp sections today bind sec_pal/sec_raster_table/
// sec_pal_cycle separately, each with "NULL means keep whatever the previous
// section had" semantics. These five presets are the total-binding replacement:
// ojz_sec() feeds each one into sec_effects, and Effects_InstallPreset writes
// every channel on section entry, using the explicit _None sentinels for "off"
// rather than leaving a field at 0/"keep".
//
// EVERY preset here carries `variants: [Variant_Water_Deep, 0]`, and that is
// NOT incidental. games/sonic4/test/ojz_scroll_test.emp binds Variant_Water_Deep
// to variant slot 0 once at GameState_OJZScroll_Init and nothing ever clears
// it — so today that variant is live across all nine sections (it is why
// Pal_Active reads $10, variant-only, everywhere; see engine/effects/
// palette.emp's own comment on Pal_Active). A preset with an empty variants
// array would CLEAR the slot under total binding, silently dropping the water
// tint act-wide the moment a section crossing installs it — a real regression
// dressed up as "the preset said nothing". Carrying the variant in every
// preset instead reproduces today's live state exactly. Whether the variant
// should be section-scoped is a content question for a later parcel, not
// something to change while converting the binding mechanism.
//
// Sections 4-8 are identical (OJZ_Palette, no raster, no cycle), so they share
// ONE preset instance (OJZ_Preset_Plain) instead of five copies.
//
// NOT NAMED Preset_None: a preset always carries a palette (EffectsPreset.ep_pal
// is a required, non-defaulted field — see preset()'s signature), and a palette
// is game content. There is no game-agnostic "none" preset, so the "everything
// else off" instance is named for what it actually is — OJZ's plain section —
// rather than implying a universal empty preset that cannot exist.
// SECTION 0 IS THE PATCHED SECTION (P-b Task 7), and this is what closes EFX-8.
//
// No patched program had RENDERED since Parcel C2: total binding drove ep_patched past
// "off" into unreachable, because the only installer of a Buf_B program in the tree was a
// hand install in the scroll test's Init, and C2 made the preset path the sole authority
// over the raster channel. Every P-a guard was therefore proving properties of a program
// nothing could display. Binding OJZ_TwoChannel here is what makes P-b's gate — and P-a's
// thirteen guards — measure something.
//
// SECTION 0 SURRENDERS OJZ_TestRamp, and that is a DECLARED DELTA rather than a regression:
// preset()'s exclusivity ensure makes ep_raster and ep_patched mutually exclusive, so the
// OP_RUN_RAMP fixture cannot share a section with a patched template. Section 0 is the one
// the scroll test spawns into, which is the whole reason it is the right section to convert —
// the gate needs the boundaries on screen with no navigation. OJZ_TestRamp keeps its
// build-time pins; what it loses is a live render, and it can be re-bound to any other
// section the moment someone wants to look at it again.
//
// THE ANCHORS ARE MEASURED, NOT GUESSED. Camera_Y reads $0090 (144) at spawn on oracle, and
// screen_line = world_y - Camera_Y, so:
//   channel 0: 224 - 144 =  80  (band 40..120  — mid-band, and it clamps to lo once the
//                                camera descends past world Y 184)
//   channel 1: 314 - 144 = 170  (band 130..200 — mid-band)
// Both boundaries are on screen at spawn, and both clamp edges are reachable by scrolling,
// which is what lets the gate assert absolute predicted rows AND both clamp directions
// without a debug hook. Channels 2 and 3 are unused; their anchors are PATCH_ANCHOR_NONE
// ($7FFF), NOT 0 — this line said 0 until 2026-08-18 while the call below has always passed
// the sentinel. The difference is the whole reason the sentinel exists: the parallax overlay
// derives a screen line as `anchor - Camera_Y`, so a 0 anchor reads as ABOVE the screen top,
// i.e. "fully submerged", the most invasive possible default for a channel nobody asked for
// (see PATCH_ANCHOR_NONE in raster_dsl.emp).
pub data OJZ_Preset_Sec0:  EffectsPreset = preset(pal: OJZ_Palette, patched: OJZ_TwoChannel,   cycle: Pal_Cycle_None,     variants: [Variant_Water_Deep, 0],
                                                  parallax: ParallaxConfig_OJZ_Underwater,
                                                  patch_world_ys: [224, 314, PATCH_ANCHOR_NONE, PATCH_ANCHOR_NONE])
pub data OJZ_Preset_Sec1:  EffectsPreset = preset(pal: OJZ_Palette, raster: OJZ_TestRaster,     cycle: Pal_Cycle_None,     variants: [Variant_Water_Deep, 0])
pub data OJZ_Preset_Sec2:  EffectsPreset = preset(pal: OJZ_TestPal, raster: OJZ_TestGradient,   cycle: Pal_Cycle_None,     variants: [Variant_Water_Deep, 0])
pub data OJZ_Preset_Sec3:  EffectsPreset = preset(pal: OJZ_Palette, raster: Raster_Program_None, cycle: OJZ_ShimmerCycle,  variants: [Variant_Water_Deep, 0])
pub data OJZ_Preset_Plain: EffectsPreset = preset(pal: OJZ_Palette, raster: Raster_Program_None, cycle: Pal_Cycle_None,    variants: [Variant_Water_Deep, 0])

// ===========================================================================
// OJZ_TwoChannel — the Parcel P-a gate. TWO independently patchable boundaries in ONE
// program, which is exactly what the Phase-3 design declared out of scope for Parcel C
// ("two independently patched effects in one section — Raster_Buf_B is single").
//
// It has NO runtime behaviour in this parcel: nothing installs it. Its whole job is to be
// compared word-for-word against the hand twins below, so that the runtime patcher parcel
// inherits a table whose every offset is already proved at build time.
//
// Channel 0 — the water shape: S/H on plus a 3-colour region swap, band 3..220.
// Channel 1 — a plane B vertical scroll split, band 222..223.
//
// (Those bands read 3..214 and 216..223 until 2026-08-18, two supersessions behind the
// constructor call below — the re-band note further down already describes channel 1 moving to
// the bottom and then giving up six more lines to 222. The authored values are lo: 3, hi: 220
// and lo: 222, hi: 223, and the budget line below only balances at 221 with those.)
//
// THE WATER CHANNEL OWNS ALMOST THE WHOLE SCREEN, and that is the point of this layout.
// The band is where Raster_BuildSchedule CLAMPS the boundary, so whatever the band cannot reach,
// the water line cannot reach either — it pins at the edge and stops tracking the world.
// Channel 0 held 3..120 for exactly one reason: channel 1 sat at 130..200 in the middle of
// the screen, and the intervals must be strictly ascending and disjoint (check_intervals,
// raster_dsl.emp). That cost the WATER — the thing content actually cares about — 94 lines
// of travel so a FIXTURE could sit mid-screen. Measured consequence before the re-band: at
// Camera_Y 32 the true boundary is screen line 192, it rendered at 120, and 72 lines of dry
// screen carried the wet tint, sustained, on the ordinary scroll path.
//
// So channel 1 moved to the bottom instead. It is a vscroll-split GATE FIXTURE (the $0043
// offset is inherited from OJZ_TestVsram) proving that two independently patched channels
// coexist in one program — a capability P-a and P-b exist to demonstrate. Keeping it as a
// patchable channel preserves that proof; only its position is negotiable, and the bottom
// of the screen costs the demo nothing.
//
// Budget is EXACTLY full: (220-3+1) + (223-222+1) + 1 = 218 + 2 + 1 = 221, the whole
// disjoint-band allowance.
//
// CHANNEL 1 GAVE UP SIX MORE LINES WHEN LOCAL REMOVAL SHIPPED, and the reason changed shape.
// Before, whatever the band could not reach was rendered WRONG: the fire pinned at band_hi and
// painted rows wet that the world said were dry, so the band's reach bounded a lie. Now, past
// band_hi the record is not emitted at all — the error is inert (a row that should be wet renders
// dry) but its SIZE is still the distance between band_hi and the screen bottom. The fixture was
// spending eight lines of that distance to sit at 216 rather than 222, which costs the demo
// nothing and cost the water three rows of honesty. Worst-case dry-side error: 10 rows -> 3.
//
// The bands are now 2 fire lines apart rather than 10, and that is the number to watch: the
// density guard measures band edge to band edge, and channel 0's fire is modelled at 676
// cycles against a 488-cycle line, so it spills about one line past its own. Two lines of
// separation is the margin; the guard adjudicates it at build time, and if a future op makes
// channel 0 costlier this is the first thing that will fail.
//
// THE MARGIN WAS OVERSTATED BY ~150 CYCLES until 2026-08-18, and both numbers were wrong.
// 526 was an `interrupts.hint` differential that tools/effects_budget_model.toml itself files
// as `sparse_fire_cram3_cycles_SUPERSEDED` — and it was never this fire's cost anyway, being a
// bare 3-word stream_cram. The live model derives this fire (reg_sh_on + 3-word region) as
// base 302 + SetReg 110 + PalRegion 264 = 676, stated in that arithmetic at raster_dsl.emp's
// `merged fire tops out at` note. The line is RASTER_SCANLINE_CYC = 488, floored from
// 128000/262 = 488.5, not 489. The conclusion ("spills about one line") survives — 676 - 488 =
// 188 cycles into the following line — but the headroom this note implied did not exist.
//
// LO WAS 40 UNTIL Parcel W SHIPPED AND SOMEBODY LOOKED AT IT. The band is where
// Raster_BuildSchedule clamps the boundary, so a lo of 40 meant that once the camera descended
// past world Y 184 the water line stopped tracking the world and PINNED at screen line 40
// — the top 40 lines (18% of the screen) never went under, no matter how far down you got,
// and the boundary read as camera-locked. Observed immediately on the debug shape at
// Camera_Y 451. 3 is the floor `patchable` allows (lines 0-2 belong to the priming
// records), so this is as close to the screen top as the mechanism goes.
//
// THE LO EDGE IS STILL A MITIGATION; THE HI EDGE NO LONGER IS. Below lo the fire clamps up and
// three lines never go under — but the frame-top ship covers the whole screen there, so the clamp
// hides nothing (S3K's Water_full_screen_flag, sonic3k.asm:8489-8499, is the same answer). Above
// hi the fire used to clamp down and paint a lie; now the record is dropped, which is what S3K
// (loc_6C8E, :8509-8515) and S.C.E. (Water Effects.asm:38-41) both do by parking the counter.
// The asymmetry is deliberate: clamping UP is covered, clamping DOWN was not.
//
const OJZ_TC_PROG = compose([
    patchable(fx_tint_band(line: 100, slot: 0, pal_line: 2, entry: 4, count: 3, sh: 1),
              ch: 0, lo: 3,   hi: 220, offscreen_ship: 1),
    patchable(fx_vscroll_split(line: 222, offset: $0043),
              ch: 1, lo: 222, hi: 223),
])

// THE BODY PIN. Literals on purpose: a pin sharing symbols with the encoder it pins is
// weaker. 72 is pal_stage_off(0, 2, 4) = 0*128 + 2*32 + 4*2.
// Fire lines are screen minus 1: priming 0 and 1, then 99 and 221.
//   arm0 = $8A00 | (99 - 1 - 1)   = $8A61
//   arm1 = $8A00 | (221 - 99 - 1) = $8A79
//   records 2 and 3 park: nothing follows them.
const OJZ_TC_HAND = [
    %0100,                      // pal_dirty_mask — CRAM line 2, from the stream_pal_region only
    $8A61, 0,                   // fire 0 — priming; the slot channel 0's gap lands in
    $8A79, 0,                   // fire 1 — priming; the slot channel 1's gap lands in
    $8AFF, 2,                   // fire 2 — channel 0, two ops
      0, $8C89,                 //   OP_SET_REG — S/H on
      4, $C048, $0000,          //   OP_PAL_REGION, command longword split
                 2,             //   count-1
                 72,            //   Pal_Variant_Stage offset
    $8AFF, 1,                   // fire 3 — channel 1, one op
      2, $4002, $0010,          //   OP_CRAM opcode with a VSRAM WRITE command longword
                 0,             //   count-1
                 $0043,         //   the scroll value
    $8AFF, $FFFF,               // park + RASTER_OPS_END
]
ensure(raster_words(OJZ_TC_PROG) == OJZ_TC_HAND.len,
       "OJZ_TwoChannel: DSL counts {raster_words(OJZ_TC_PROG)} body words, the hand program is {OJZ_TC_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_TC_PROG), OJZ_TC_HAND) == -1,
       "OJZ_TwoChannel: DSL body diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_TC_PROG), OJZ_TC_HAND)}")

// THE TABLE PIN — the words the runtime patcher parcel will walk. Checked separately from
// the body so a failure names which half moved. line_src/band_lo_fl/band_hi_fl are FIRE-LINE
// space; rec_off/rec_len are byte offsets into the emitted body.
const OJZ_TC_TABLE_HAND = [
    2,                          // count — two authored records
    $8000, 2,   219,   10, 18,  // channel 0: band 2..219, record at byte 10, 18 bytes long
                                //   (fire lines = screen 3..220 — the water line owns almost
                                //    the whole screen; see the re-band note above)
    $8001, 221, 222,   28, 14,  // channel 1: band 221..222, record at byte 28, 14 bytes long
]
// The off-screen ship trailer, after the patch table. The count word is emitted
// unconditionally, so the runtime reads one fixed shape instead of branching on whether a
// program has a trailer at all.
//
// (This paragraph opened with "Neither channel declares offscreen_ship, so this is the bare
// count word" until 2026-08-18 — contradicted two lines later by its own continuation, and by
// the constructor above, where channel 0 passes offscreen_ship: 1. It described the fixture as
// it stood before the ship shipped. The unconditional-count-word point was the half worth
// keeping, so it survives above; the empty case is no longer what this pins.)
//
// Channel 0 declares offscreen_ship, so the trailer carries the PARAMETERS of its frame-top
// entry — the same three colours the fire writes, re-issued as a DMA when the anchor is above
// the screen. Every field is read off the fire's own stream_pal_region op, so this pins the encoder
// against the authored arguments rather than restating them:
//   channel 0, stage offset 72 = pal_stage_off(0, 2, 4) = 0*128 + 2*32 + 4*2,
//   count 3, CRAM byte address $48 (palette line 2, entry 4).
//
// THE SetReg WORDS RIDE HERE TOO, and that is the fix for what shipping only the colours
// missed: this fire carries reg_sh_on() as well as the stream_pal_region, and the ship has to re-issue
// the WHOLE fire from line 0. Without the register replay the rows above the clamped fire line
// came out tinted but with Shadow/Highlight still off — visibly lighter, found in play.
//
// PARAMETERS, NOT A BUILT DMAEntry, and the constraint is worth knowing before anyone
// "improves" it: the entry's source is Pal_Variant_Stage + 72, and a LINK-time address folded
// into the emitted image makes the whole image non-comptime — which breaks the
// first_mismatch whole-image pin two lines below. Measured three spellings, all three failed.
// Raster_BuildShipEntry adds the base at install instead.
const OJZ_TC_TRAILER_HAND = [
    1,                          // one fire declares offscreen_ship
    0,                          // ...channel 0
    72,                         // Pal_Variant_Stage offset — the fire's own
    3,                          // colour count
    $48,                        // CRAM byte address
    1,                          // ...and ONE SetReg op to replay at frame top
    $8C89,                      //   reg_sh_on() — VDP reg $0C = $89, Shadow/Highlight ON
]

// The separate .len ensure is REQUIRED, not belt-and-braces: first_mismatch walks only a's
// indices and returns -1 whenever a is a PREFIX of b, so a table short by a trailing entry
// compares EQUAL. Nothing inside first_mismatch can see that.
ensure(patched_words(OJZ_TC_PROG) == 64 + OJZ_TC_TABLE_HAND.len + OJZ_TC_TRAILER_HAND.len,
       "OJZ_TwoChannel: patched_words says {patched_words(OJZ_TC_PROG)} but 64 padded body words plus the hand table and trailer is {64 + OJZ_TC_TABLE_HAND.len + OJZ_TC_TRAILER_HAND.len}")

pub data OJZ_TwoChannel: [u16; patched_words(OJZ_TC_PROG)] = patched_program(OJZ_TC_PROG)

// The whole emitted image in one comparison — body, padding and table. A padding-length
// error shows up here as a divergence at the first table word.
const OJZ_TC_PAD = comptime for i in 0..(64 - 23) { 0 }
ensure(OJZ_TC_HAND.len == 23,
       "OJZ_TwoChannel: the padding length above is written against a 23-word body, but the hand body is {OJZ_TC_HAND.len} words")
ensure(first_mismatch(patched_program(OJZ_TC_PROG),
                      OJZ_TC_HAND ++ OJZ_TC_PAD ++ OJZ_TC_TABLE_HAND ++ OJZ_TC_TRAILER_HAND) == -1,
       "OJZ_TwoChannel: the emitted patched image diverges from the hand twin at index {first_mismatch(patched_program(OJZ_TC_PROG), OJZ_TC_HAND ++ OJZ_TC_PAD ++ OJZ_TC_TABLE_HAND ++ OJZ_TC_TRAILER_HAND)}")
