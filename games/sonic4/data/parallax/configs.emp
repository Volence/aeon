// games/sonic4/data/parallax/configs.emp — OJZ parallax configuration data.
//
// The §4.6 parallax ROM records for OJZ: six deformation tables and the
// twenty `parallax_config` records (five OJZ layouts, plus the reusable
// shimmer / haze / rocking / perspective effect variants). Each record is a
// 28-byte header immediately followed by its `band_count` 10-byte band
// entries — the runtime reads the count from the header and indexes the bands
// at `sizeof(parallax_config)(a0)`.
//
// The old data/parallax/*.asm files (ojz_default, ojz_windy, the effects/ and
// scenes/ libraries) expanded the `parallax_section`/`band` macros from
// engine/parallax_macros.inc. That macro layer is now split: the generic
// factor encoding + deform-table generators live in engine.level.parallax_dsl
// (imported below); this module holds the per-band-count record shapes, the
// section/band constructors, the per-effect builders, and the data itself.
module games.sonic4.parallax_configs in parallax_configs

// parallax_config (the 28-byte header) is the shared ROM struct; band_entry
// (10 bytes) is authored by engine.parallax. The FACTOR_* set + the deform
// generators come from the parallax DSL.
use engine.structs.{parallax_config}
use engine.parallax.{band_entry}
use engine.level.parallax_dsl.*
// Effects P1 gate fixtures (below) need the raster program vocabulary + the CRAM
// command builder they are pinned against.
use engine.vdp.{VdpTarget, VdpOp, vdp_comm}
use engine.effects.raster.{OP_SET_REG, OP_CRAM, OP_PAL_REGION, RASTER_OPS_END, RASTER_ARM_PARK, raster_arm, pal_stage_off, water_arm0}
// RASTER_ARM_EVERY_LINE + OP_RUN_GRADIENT are imported even though nothing in THIS
// file names them: a comptime fn's struct-literal field values are resolved at the
// EMISSION site's scope, not the definition site (the same late-binding rule the
// `asm {}` splice helpers document), so raster_gradient_program's own constants must
// be visible HERE or they degrade to unresolved label refs.
use engine.effects.raster.{RasterGradientProgram, RASTER_CRAM_MAX, raster_gradient_program, RASTER_ARM_EVERY_LINE, OP_RUN_GRADIENT}
use engine.effects.palette.{pal_cycle_channel, PalCycleScript1}
use engine.effects.palette_dsl.{cycle_channel, cycle_script1}
// raster_dsl is pure comptime and nothing HERE names it — this glob is the only
// thing that makes the module reachable, and an unimported comptime module's
// module-level `ensure`s are never evaluated at all (they do not fail; they do
// not run). Do not prune. Task 6 fills the module; if it joins COMPTIME_HELPERS
// this line's job changes and should be re-justified or removed deliberately.
use engine.effects.raster_dsl.*

// ---- record shapes: a header followed by N band entries ----
// The runtime never reads these wrapper types — it walks bytes off the header
// pointer — so one shape per band count is all the layout needs. The nested
// `parallax_config` keeps the header layout authored in exactly one place.
struct ParallaxCfg1 { hdr: parallax_config, bands: [band_entry; 1] }
struct ParallaxCfg2 { hdr: parallax_config, bands: [band_entry; 2] }
struct ParallaxCfg4 { hdr: parallax_config, bands: [band_entry; 4] }
struct ParallaxCfg5 { hdr: parallax_config, bands: [band_entry; 5] }

// band — one band entry. Splits the packed FACTOR_* values (parallax_dsl) into
// the three per-plane bytes the runtime reconstructs the scroll factor from.
// dsa/dsb are the per-band deform-amplitude shifts (15 = no deform on that
// plane); phase desyncs the deform sample index.
comptime fn band(cell: int, fa: int, fb: int, dsa: int, dsb: int, phase: int = 0) -> band_entry {
    return band_entry{
        band_top_cell:       cell,
        band_factor_a_s1:    fa & 15,
        band_factor_a_s2:    (fa >> 4) & 15,
        band_factor_a_op:    (fa >> 8) & 1,
        band_factor_b_s1:    fb & 15,
        band_factor_b_s2:    (fb >> 4) & 15,
        band_factor_b_op:    (fb >> 8) & 1,
        band_deform_shift_a: dsa,
        band_deform_shift_b: dsb,
        band_phase_offset:   phase,
    }
}

// hdr — the 28-byte section header. The four required fields (band_count,
// layer_mask, v_factor_bg, v_center/v_offset) plus the optional deform + tuning
// fields, defaulted exactly as the AS `parallax_section` macro did. Table
// pointers are `Label` (0 = no table).
comptime fn hdr(band_count: int, layer_mask: int, v_factor_bg: int, v_center: int, v_offset: int,
                v_factor_fg: int = 0, transition: int = 0,
                deform_fg: Label = 0, deform_bg: Label = 0,
                deform_speed_fg: int = 1, deform_speed_bg: int = 1,
                v_deform_bg: Label = 0, v_deform_speed_bg: int = 0, v_deform_shift_bg: int = 4) -> parallax_config {
    return parallax_config{
        pcfg_band_count:        band_count,
        pcfg_v_factor_bg:       v_factor_bg,
        pcfg_v_factor_fg:       v_factor_fg,
        pcfg_layer_mask:        layer_mask,
        pcfg_v_center_y:        v_center,
        pcfg_v_offset:          v_offset,
        pcfg_transition:        transition,
        pcfg_deform_speed_fg:   deform_speed_fg,
        pcfg_deform_speed_bg:   deform_speed_bg,
        pcfg_pad:               0,
        pcfg_deform_table_fg:   deform_fg,
        pcfg_deform_table_bg:   deform_bg,
        pcfg_v_deform_table_bg: v_deform_bg,
        pcfg_v_deform_speed_bg: v_deform_speed_bg,
        pcfg_v_deform_shift_bg: v_deform_shift_bg,
        pcfg_pad2:              [0, 0],
    }
}

// =====================================================================
// OJZ default — 5-band forest BG, all-zero H-deform (per-line pipeline).
// Whole-plane V-scroll (v_factor_bg=3), uniform BG 1/2 depth. The deform
// shift 15 on every band flat-paths the zero table; the non-NULL pointer
// still selects per-line HScroll (byte-identical output, no sample math).
// =====================================================================

pub data DeformTable_Zero: [i8; 256] = deform_zero()

pub data ParallaxConfig_OJZ_Default: ParallaxCfg4 = ParallaxCfg4{
    hdr: hdr(band_count: 4, layer_mask: $1F, v_factor_bg: 3, v_center: 512, v_offset: 0,
             deform_bg: DeformTable_Zero),
    bands: [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             band(cell: 8,  fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             band(cell: 40, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             band(cell: 48, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15) ],
}

// =====================================================================
// OJZ windy — whole plane B waves at full sine amplitude (+/-96 px). Single
// band, BG factor 1/4 matching SkyHaze so a Sec0<->Sec1 transition lerps only
// the deform amplitude, not the BG scroll.
// =====================================================================

pub data DeformTable_OJZ_Calm: [i8; 256] = deform_sine(amplitude: 96, period: 64)

pub data ParallaxConfig_OJZ_Windy: ParallaxCfg1 = ParallaxCfg1{
    hdr: hdr(band_count: 1, layer_mask: $01, v_factor_bg: 15, v_center: 0, v_offset: 0,
             deform_bg: DeformTable_OJZ_Calm, deform_speed_bg: 1),
    bands: [ band(cell: 0, fa: FACTOR_1, fb: FACTOR_1_4, dsa: 4, dsb: 0) ],
}

// =====================================================================
// Shimmer — heat-haze wobble (small amplitude, tight wavelength, animated
// phase) on plane B. Pre-named speed variants; shift 2 => +/-2 px.
// =====================================================================

pub data DeformTable_Shimmer: [i8; 256] = deform_sine(amplitude: 8, period: 32)

comptime fn shimmer_bg(speed: int, shift: int = 2, fg: int = FACTOR_1, bg: int = FACTOR_1_4) -> ParallaxCfg1 {
    return ParallaxCfg1{
        hdr: hdr(band_count: 1, layer_mask: $01, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_bg: DeformTable_Shimmer, deform_speed_bg: speed),
        bands: [ band(cell: 0, fa: fg, fb: bg, dsa: shift, dsb: shift) ],
    }
}
pub data ParallaxConfig_Shimmer_Slow: ParallaxCfg1 = shimmer_bg(speed: 1)
pub data ParallaxConfig_Shimmer:      ParallaxCfg1 = shimmer_bg(speed: 3)   // default (medium)
pub data ParallaxConfig_Shimmer_Fast: ParallaxCfg1 = shimmer_bg(speed: 6)

// =====================================================================
// Haze — FG heat wobble. Graduated mode: sky/mountains skip (shift 15), hills
// faint (4), ground full (3). Uniform mode: every band shift 3.
// =====================================================================

pub data DeformTable_Haze: [i8; 256] = deform_sine(amplitude: 16, period: 64)

comptime fn haze_fg(speed: int, gradient: int = 1) -> ParallaxCfg5 {
    return ParallaxCfg5{
        hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_fg: DeformTable_Haze, deform_speed_fg: speed),
        bands: if gradient == 1 {
            [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 15, dsb: 4),   // clouds
              band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 15, dsb: 4),   // far mtns
              band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 15, dsb: 4),   // mid mtns
              band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 4,  dsb: 4),   // hills (+/-1 px)
              band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 3,  dsb: 4) ]  // ground (+/-2 px)
        } else {
            [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 3, dsb: 4),
              band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 3, dsb: 4),
              band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 3, dsb: 4),
              band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 3, dsb: 4),
              band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 3, dsb: 4) ]
        },
    }
}
pub data ParallaxConfig_Haze_Slow:    ParallaxCfg5 = haze_fg(speed: 1)
pub data ParallaxConfig_Haze:         ParallaxCfg5 = haze_fg(speed: 2)
pub data ParallaxConfig_Haze_Fast:    ParallaxCfg5 = haze_fg(speed: 4)
pub data ParallaxConfig_Haze_Uniform: ParallaxCfg5 = haze_fg(speed: 2, gradient: 0)

// =====================================================================
// Rocking — plane B rocks via per-column V-scroll sampling a sine table. BG
// H-scroll locked (FACTOR_0) to avoid the leftmost-partial-column VDP artifact;
// the zero H-deform table forces the per-line pipeline.
// =====================================================================

pub data DeformTable_Rocking: [i8; 256] = deform_sine(amplitude: 20, period: 64)

comptime fn rocking(speed: int, shift: int = 0) -> ParallaxCfg1 {
    return ParallaxCfg1{
        hdr: hdr(band_count: 1, layer_mask: $01, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_bg: DeformTable_Zero, v_deform_bg: DeformTable_Rocking,
                 v_deform_speed_bg: speed, v_deform_shift_bg: shift),
        bands: [ band(cell: 0, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 4) ],
    }
}
pub data ParallaxConfig_Rocking_Slow: ParallaxCfg1 = rocking(speed: 0)   // static tilt
pub data ParallaxConfig_Rocking:      ParallaxCfg1 = rocking(speed: 1)
pub data ParallaxConfig_Rocking_Fast: ParallaxCfg1 = rocking(speed: 3)   // stormy

// =====================================================================
// Perspective — V-column floor curve + per-band BG H-shimmer (sky/mtns skip,
// hills faint, ground strong). BG H-locked (FACTOR_0) for the same VDP quirk.
// =====================================================================

pub data DeformTable_Perspective: [i8; 256] = v_column_floor(center: 20, max_offset: 24)

comptime fn perspective(v_shift: int, h_speed: int, v_speed: int) -> ParallaxCfg5 {
    return ParallaxCfg5{
        hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_bg: DeformTable_Shimmer, deform_speed_bg: h_speed,
                 v_deform_bg: DeformTable_Perspective, v_deform_speed_bg: v_speed, v_deform_shift_bg: v_shift),
        bands: [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 15),
                 band(cell: 4,  fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 15),
                 band(cell: 10, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 15),
                 band(cell: 14, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 4),
                 band(cell: 20, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 2) ],
    }
}
pub data ParallaxConfig_Perspective_Subtle:   ParallaxCfg5 = perspective(v_shift: 2, h_speed: 1, v_speed: 0)
pub data ParallaxConfig_Perspective:          ParallaxCfg5 = perspective(v_shift: 0, h_speed: 2, v_speed: 1)
pub data ParallaxConfig_Perspective_Dramatic: ParallaxCfg5 = perspective(v_shift: 0, h_speed: 3, v_speed: 2)

// =====================================================================
// WindyHaze — composite: windy multi-band BG gradient (clouds full wave down
// to ground none, per-band phase desync) + uniform FG haze (+/-2 px).
// =====================================================================

pub data ParallaxConfig_WindyHaze: ParallaxCfg5 = ParallaxCfg5{
    hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
             deform_fg: DeformTable_Haze, deform_speed_fg: 2,
             deform_bg: DeformTable_OJZ_Calm, deform_speed_bg: 1),
    bands: [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 3, dsb: 0,  phase: 0),
             band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 3, dsb: 1,  phase: 64),
             band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 3, dsb: 2,  phase: 128),
             band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 3, dsb: 3,  phase: 192),
             band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 3, dsb: 15, phase: 0) ],
}

// =====================================================================
// SkyHaze — composite: top band (rows 0-13) windy BG, FG steady; bottom band
// (rows 14-27) FG haze, BG steady. A regional split at row 14, not a gradient.
// =====================================================================

pub data ParallaxConfig_SkyHaze: ParallaxCfg2 = ParallaxCfg2{
    hdr: hdr(band_count: 2, layer_mask: $03, v_factor_bg: 15, v_center: 0, v_offset: 0,
             deform_fg: DeformTable_Haze, deform_speed_fg: 2,
             deform_bg: DeformTable_OJZ_Calm, deform_speed_bg: 1, v_deform_shift_bg: 0),
    bands: [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 15, dsb: 2),
             band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_4, dsa: 2,  dsb: 15) ],
}

// =====================================================================
// Caves — slow BG parallax (far bands barely move, FACTOR_1_16) with a
// section transition flag. Same 5-band shape as OJZ_Default; only H-factors
// differ. All-zero H-deform (flat-pathed) for the per-line pipeline.
// =====================================================================

pub data ParallaxConfig_OJZ_Caves: ParallaxCfg5 = ParallaxCfg5{
    hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
             transition: 1, deform_bg: DeformTable_Zero),
    bands: [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_16, dsa: 15, dsb: 15),
             band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_16, dsa: 15, dsb: 15),
             band(cell: 10, fa: FACTOR_1, fb: FACTOR_1_8,  dsa: 15, dsb: 15),
             band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_4,  dsa: 15, dsb: 15),
             band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,    dsa: 15, dsb: 15) ],
}

// =====================================================================
// LockedClouds — layer_mask $1E disables band 0 (bit 0 clear): the cloud band
// falls through the band-inheritance path to scroll 0 (locked), while the rest
// of plane B parallaxes. Verifies the disabled-band inheritance path.
// =====================================================================

pub data ParallaxConfig_OJZ_LockedClouds: ParallaxCfg5 = ParallaxCfg5{
    hdr: hdr(band_count: 5, layer_mask: $1E, v_factor_bg: 15, v_center: 0, v_offset: 0,
             transition: 1, deform_bg: DeformTable_Zero),
    bands: [ band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 15, dsb: 15),
             band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 15, dsb: 15),
             band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 15, dsb: 15),
             band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 15, dsb: 15) ],
}

// ===========================================================================
// EFFECTS P1 GATE FIXTURES — the first raster program and the first per-section
// palette. These live beside the parallax configs because this file IS the
// game-side effects library (design suite §6); the Phase-3 preset format and the
// `raster_dsl` general constructors supersede the hand-laid words below.
// ===========================================================================

// The CRAM-write command longword for colour 0, split into the two words the
// program format carries. Pinned against the comptime builder so a change in
// engine.vdp's command encoding fails the build instead of writing to VRAM.
// The gate writes CRAM entry $4A = palette line 2, entry 5 — measured to be OJZ's
// single most-used ground colour (~54% of the lower-screen pixels). Colour 0 (the
// backdrop) was the obvious first choice and is the WRONG one: OJZ's art covers the
// backdrop everywhere, so the effect was invisible and the gate unfalsifiable.
// Pinned against the comptime builder so an encoding change fails the build rather
// than quietly writing somewhere else.
const OJZ_TEST_CRAM_ADDR = $4A
ensure(vdp_comm(OJZ_TEST_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C04A0000,
       "CRAM write command encoding drifted — OJZ_TestRaster's split words are stale")

// OJZ_TestRaster — the P1 acceptance program: below screen line 120, turn
// Shadow/Highlight ON and repaint OJZ's dominant ground colour bright red. Two
// different mechanisms (a mode-register write and a CRAM write) firing at the same
// line, so the gate exercises the multi-op path rather than a single write — and
// the CRAM half is chosen to be objectively measurable from a screenshot.
//
// The fire schedule below is now DERIVED. Kept as prose because it is what the arm
// words mean, and the walk-through is the thing a reader needs:
//   fire 0 @ line 0    priming, arm = $8A00 | (120 - 3) = $8A75 (117)
//   fire 1 @ line 1    priming, arm = park (nothing scheduled after the event)
//   fire 2 @ line 119  the event; its writes land on line 120
// VBlank leaves reg $0A = 0 -> fire 0 at line 0, reload 0 -> fire 1 at line 1,
// reload 117 -> fire 2 at 1 + 117 + 1 = 119. Effect on 120.
//
// pal_dirty_mask is DERIVED from the CRAM address ($4A >> 5 = line 2), so the mask
// can no longer name the wrong line — the observed P1 bug, where a mask of %0001
// against an op writing line 2 left the red latched over the whole ground instead of
// only below the split.
const OJZ_TEST_PROG = [
    fire(120, [ sh_on(),                            // S/H ON below the line
                cram($4A, [$000E]) ]),              // bright red at line 2 entry 5
]

// THE PIN (design spec 8.1). The hand-authored words are the ones measured on
// hardware during P1; the DSL must reproduce them exactly. Retained deliberately
// rather than deleted: a `const` emits nothing, and it turns a Parcel-C/D regression
// from "golden ROM differs" into a named index — the negative control that proved this
// pin bites flipped the colour word and got "diverges ... at index 15". It retires in
// Parcel D together with the fixture it pins (design spec 8.2).
const OJZ_TEST_HAND = [
    %0100,
    1, $8C81,
    $8A75, 0,
    $8AFF, 0,
    $8AFF, 2,
      OP_SET_REG, $8C89,
      OP_CRAM, $C04A, $0000,
                 0, $000E,
    $8AFF, RASTER_OPS_END,
]
ensure(raster_words(OJZ_TEST_PROG) == OJZ_TEST_HAND.len,
       "OJZ_TestRaster: DSL counts {raster_words(OJZ_TEST_PROG)} words, the hand program is {OJZ_TEST_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_TEST_PROG), OJZ_TEST_HAND) == -1,
       "OJZ_TestRaster: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_TEST_PROG), OJZ_TEST_HAND)}")

pub data OJZ_TestRaster: [u16; raster_words(OJZ_TEST_PROG)] = raster_program(OJZ_TEST_PROG)

// OJZ_TestPal — a deliberately unmistakable palette for the adjacent section, so
// "did sec_pal load on the crossing?" is answerable from one CRAM read or
// screenshot. Not a tinted copy of the real palette: a subtle shift would make a
// NEGATIVE result (consumer never ran) look like a positive one.
//
// 48 words = 96 bytes = CRAM lines 1-3, matching the sec_pal contract. It must NOT
// cover line 0: that is the character's line (CharacterDef.cd_palette), and a
// section palette that overwrote it would repaint the active character on every
// boundary crossing.
comptime fn test_palette() -> [u16; 48] {
    return comptime for i in 0..48 {
        (((i * 14) / 47) << 9) | (((i & 3) * 2) << 4)
    }
}

pub data OJZ_TestPal: [u16; 48] = test_palette()

// ===========================================================================
// EFFECTS P2 GATE FIXTURES — the palette-cycling band (Task 8) and the OJZ water
// cluster (Task 7). Authored here, the game-side effects library.
// ===========================================================================

// OJZ_ShimmerCycle — a per-section cycling band: rotate line-2 entries 8..11 every 8
// frames. `sec_pal_cycle` finally gets a consumer; the controller reads CRAM per
// frame to confirm the rotation period. Line 2 (not 0 — the character's).
pub data OJZ_ShimmerCycle: PalCycleScript1 = cycle_script1(
    [ cycle_channel(line: 2, first: 8, count: 4, period: 8) ])

// OJZ_WaterRaster — the water-cluster raster TEMPLATE (Task 7). init_count == 1
// (WATER_TEMPLATE_ARM0_OFF depends on it). At the water line it (1) turns Shadow/
// Highlight ON ($8C89 — bit 3 set, resolution bits unchanged per the survey V28/V30
// ruling) and (2) swaps line-2 entries 4-6 to the deep-water variant's derived bytes
// via OP_PAL_REGION streaming from Pal_Variant_Stage slot 0. The priming arm word
// (arm0) is a DEFAULT here (water line 120); Raster_InstallWater/Raster_PatchWaterLine
// overwrite it at runtime from Raster_Water_Line, so the boundary MOVES live.
//
// pal_dirty_mask %0100 re-asserts CRAM line 2 every frame, so the mid-frame region
// swap is transient (base restored at frame top -> above the line = base palette, below
// = deep-water). The CRAM command is pinned to the comptime builder.
//
// S/H CONTENT FINDING (plan Task 7 Step 3 — stated, not silently dropped). The
// $8C89 write turns Shadow/Highlight ON below the water line, but S/H only dims
// LOW-priority pixels and OJZ's plane art is HIGH-priority (the P1 residual). Making
// the tiles below the water line low-priority is a CONTENT change: the priority bit is
// baked into the generated OJZ block/nametable data, and the tile-cache stream writes
// those words verbatim — there is no priority-clearing hook in the engine. Regenerating
// that data runs through tools/ojz_strip_gen.py + games/sonic4/data/editor/ojz, which
// this parcel is forbidden to touch (auto-commit daemon). So S/H transparency CANNOT be
// visually demonstrated on OJZ's current art; the op provably EXECUTES (it precedes the
// region op in the same fire, and a mis-parse would desync the CRAM command into
// garbage) but has nothing to dim. Proving S/H needs low-priority water content, which
// is out of this parcel's scope — flagged for the controller/user.
const OJZ_WATER_CRAM_ADDR = $48                 // CRAM line 2, entry 4
ensure(vdp_comm(OJZ_WATER_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C0480000,
       "CRAM write command encoding drifted — OJZ_WaterRaster's split words are stale")

// The default water line. Raster_InstallWater / Raster_PatchWaterLine overwrite the
// priming arm word at runtime from Raster_Water_Line, so the boundary MOVES live; this
// value is only what the template ships with.
const OJZ_WATER_LINE = 120

const OJZ_WATER_PROG = [
    region_boundary(line: OJZ_WATER_LINE,
                    addr: OJZ_WATER_CRAM_ADDR,   // $48 — CRAM line 2, entry 4
                    slot: 0, pal_line: 2, entry: 4, count: 3,
                    sh:   1),
]

// THE PATCH-OFFSET INVARIANT, previously carried only by prose. Raster_PatchWaterLine
// writes the priming arm word at a FIXED byte offset into Buf_B
// (WATER_TEMPLATE_ARM0_OFF = 6), which is word index 3 — and word 3 is arm0 only when
// init_count is exactly 1. Any second init word would silently shift arm0 to index 4,
// and the patch would then rewrite an init word every frame instead of the boundary.
ensure(raster_program(OJZ_WATER_PROG)[3] == $8A00 | (OJZ_WATER_LINE - 3),
       "OJZ_WaterRaster: word 3 is not the priming arm word — Raster_PatchWaterLine patches byte offset 6 (WATER_TEMPLATE_ARM0_OFF) unconditionally, which is word 3 only when init_count == 1")

// THE PIN (design spec 8.1) — the words measured on hardware during P2. Retires in
// Parcel D with the fixture.
const OJZ_WATER_HAND = [
    %0100,
    1, $8C81,
    $8A75, 0,
    $8AFF, 0,
    $8AFF, 2,
      OP_SET_REG, $8C89,
      OP_PAL_REGION, $C048, $0000,
                 2,
                 pal_stage_off(0, 2, 4),
    $8AFF, RASTER_OPS_END,
]
ensure(raster_words(OJZ_WATER_PROG) == OJZ_WATER_HAND.len,
       "OJZ_WaterRaster: DSL counts {raster_words(OJZ_WATER_PROG)} words, the hand program is {OJZ_WATER_HAND.len}")
ensure(first_mismatch(raster_program(OJZ_WATER_PROG), OJZ_WATER_HAND) == -1,
       "OJZ_WaterRaster: DSL output diverges from the hand-authored words at index {first_mismatch(raster_program(OJZ_WATER_PROG), OJZ_WATER_HAND)}")

pub data OJZ_WaterRaster: [u16; raster_words(OJZ_WATER_PROG)] = raster_program(OJZ_WATER_PROG)

// ---------------------------------------------------------------------------
// OJZ_TestGradient — the DENSE-tier gate (Task 5 Step 4). A 96-line ramp across
// screen lines 96..191, rewriting CRAM line 2 entries 4-6 on EVERY line.
//
// Measurement is by per-scanline CRAM read (oracle run_to_scanline + read_cram),
// NOT by counting screenshot pixels. The P1 gate had to count pixels because it was
// proving an effect reached the screen; here the claim is "the handler writes the
// authored stream value on every one of 96 consecutive lines", which CRAM answers
// directly and which art coverage cannot confound (the GATE-EVIDENCE.md CORRECTION
// is entirely about art swamping a pixel-count signal).
//
// The three entries carry DELIBERATELY DIFFERENT words at the same ramp level —
// blue, blue+green, blue+red. A stream desync of one word (the classic off-by-one in
// a dense run) therefore shows up as the wrong CHANNEL MIX at the right level, which
// is distinguishable from a run that is merely shifted by a line. Three words is
// RASTER_CRAM_MAX exactly, so this also pins the per-fire ceiling.
const OJZ_GRAD_TOP   = 96
const OJZ_GRAD_LINES = 96
ensure(RASTER_CRAM_MAX == 3,
       "OJZ_TestGradient's 3-words-per-line stream assumes RASTER_CRAM_MAX == 3")

// CRAM line 2, entry 4 — the same base as the water region, so the ramp lands on
// OJZ's dominant ground colours (entry 5 is ~54% of lower-screen pixels; see the
// OJZ_TestRaster note) and the effect is visible as well as measurable.
const OJZ_GRAD_CRAM_ADDR = $48
ensure(vdp_comm(OJZ_GRAD_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write) == $C0480000,
       "CRAM write command encoding drifted — OJZ_TestGradient's command is stale")

// Genesis CRAM is 3 bits per channel, so 8 levels is the hardware's whole range: the
// ramp steps every 12 lines and a "monotonic ramp" claim means non-decreasing with
// exactly 8 distinct levels, not 96. Channel positions are R<<1, G<<5, B<<9.
comptime fn grad_word(i: int) -> int {
    let level = ((i / RASTER_CRAM_MAX) * 8) / OJZ_GRAD_LINES   // 0..7 over the run
    let ch    = i % RASTER_CRAM_MAX
    if ch == 0 { return level << 9 }                    // entry 4 — blue
    if ch == 1 { return (level << 9) | (level << 5) }   // entry 5 — blue + green
    return (level << 9) | (level << 1)                  // entry 6 — blue + red
}

pub data OJZ_GradientStream: [u16; 288] = comptime for i in 0..288 { grad_word(i) }
ensure(288 == OJZ_GRAD_LINES * RASTER_CRAM_MAX,
       "OJZ_GradientStream length must be lines * words-per-line")

pub data OJZ_TestGradient: RasterGradientProgram = raster_gradient_program(
    top:    OJZ_GRAD_TOP,
    lines:  OJZ_GRAD_LINES,
    mask:   %0100,          // re-assert CRAM line 2 each frame -> the ramp is transient
    cmd:    vdp_comm(OJZ_GRAD_CRAM_ADDR, VdpTarget.Cram, VdpOp.Write),
    stream: OJZ_GradientStream)
