// games/sonic4/data/parallax/configs.emp — OJZ parallax configuration data.
//
// The §4.6 parallax ROM records for OJZ: six deformation tables and the
// twenty `parallax_config` records (five OJZ layouts, plus the reusable
// shimmer / haze / rocking / perspective effect variants). Each record is a
// 28-byte header immediately followed by its `band_count` 10-byte band
// entries — the runtime reads the count from the header and indexes the bands
// at `sizeof(parallax_config)(a0)`.
//
// The old data/parallax/*.asm files (ojz_default, ojz_windy, the effects/ and
// scenes/ libraries) expanded the `parallax_section`/`band` macros from
// engine/parallax_macros.inc. That macro layer is now split: the generic
// factor encoding + deform-table generators live in engine.level.parallax_dsl
// (imported below); this module holds the per-band-count record shapes, the
// section/band constructors, the per-effect builders, and the data itself.
module games.sonic4.parallax_configs in parallax_configs

// parallax_config (the 28-byte header) is the shared ROM struct; band_entry
// (10 bytes) is authored by engine.parallax. The FACTOR_* set + the deform
// generators come from the parallax DSL.
use engine.structs.{parallax_config}
use engine.parallax.{band_entry}
use engine.level.parallax_dsl.*
// For hdr()'s anchored-overlay guards (Parcel W): the shadow-view capacity the split
// consumes an entry of, the "no overlay" sentinel, and the anchor-bank width.
use engine.constants.{MAX_PARALLAX_BANDS, PARALLAX_ANCHOR_NONE}
use engine.effects.raster_dsl.{RASTER_MAX_PATCH}
// TEMPORARY, TASKS 6-8 ONLY — DELETED WITH THIS WHOLE FILE AT TASK 9.
//
// The scene registry has no consumer yet (act_descriptor / ojz_effects / ojz_scroll_test
// still bind the ParallaxConfig_* symbols below; they move at Task 9), and an .emp module
// nothing `use`s is NOT REACHED: it gets parse + scan coverage and ZERO body elaboration,
// so every ensure in the registry and in engine/level/scene_dsl.emp would be dead and the
// twenty lowered records would not be emitted at all. This edge is what makes the Task-6
// gate real — it is why both record sets link and why the ROM grows on this branch.
//
// WHOLE-PATH ON PURPOSE, no name list. A selective `use ...{SceneRegistry_CapsFolded}`
// injects a CLONE of the const whose initializer re-evaluates in THIS module's scope, which
// reports `unknown function fold_caps` at a span inside the registry while never elaborating
// it (Task 5's probe). The edge, not the name, is what pulls the module into placement.
//
// It reads backwards — the file being replaced importing its replacement — and that is
// exactly why it is safe: the edge cannot outlive the migration, because Task 9 deletes
// data/parallax/ in the same commit that gives the registry its real consumers.
use games.sonic4.scene_registry

// ---- record shapes: a header followed by N band entries ----
// The runtime never reads these wrapper types — it walks bytes off the header
// pointer — so one shape per band count is all the layout needs. The nested
// `parallax_config` keeps the header layout authored in exactly one place.
struct ParallaxCfg1 { hdr: parallax_config, bands: [band_entry; 1] }
struct ParallaxCfg2 { hdr: parallax_config, bands: [band_entry; 2] }
struct ParallaxCfg4 { hdr: parallax_config, bands: [band_entry; 4] }
struct ParallaxCfg5 { hdr: parallax_config, bands: [band_entry; 5] }

// cfg_band — one band entry. Splits the packed FACTOR_* values (parallax_dsl) into
// the three per-plane bytes the runtime reconstructs the scroll factor from.
// dsa/dsb are the per-band deform-amplitude shifts (15 = no deform on that
// plane); phase desyncs the deform sample index.
//
// NAMED `cfg_band`, NOT `band`, AND BOTH CONSTRUCTORS ARE `pub` (Task 7). The
// equivalence witness (games/sonic4/test/scene_equiv_proof.emp) IMPORTS these two as its
// oracle — one definition, two consumers, so the proof cannot compare the lowering
// against a stale copy. `pub` is what an import needs; the rename is what an import
// SURVIVES: `engine.effects.raster_dsl` is a sigil COMPTIME_HELPER and is glob-injected
// into every module, so a plain `band` here is fine at its own call sites (a local
// definition wins over the injected glob) but `use ...{band}` in the witness fails with
// "collides with engine.effects.raster_dsl.band". There is no `as` alias in .emp — the
// parser's use_decl takes a path, a glob or a name list and nothing else — so the
// disambiguation has to be the definition's name. Task 9 moves both fns into the witness,
// where a local `band` would be legal again; keeping `cfg_band` there costs nothing and
// keeps the two vocabularies (record constructor vs raster band) visibly apart.
pub comptime fn cfg_band(cell: int, fa: int, fb: int, dsa: int, dsb: int, phase: int = 0) -> band_entry {
    return band_entry{
        band_top_cell:       cell,
        band_factor_a_s1:    fa & 15,
        band_factor_a_s2:    (fa >> 4) & 15,
        band_factor_a_op:    (fa >> 8) & 1,
        band_factor_b_s1:    fb & 15,
        band_factor_b_s2:    (fb >> 4) & 15,
        band_factor_b_op:    (fb >> 8) & 1,
        band_deform_shift_a: dsa,
        band_deform_shift_b: dsb,
        band_phase_offset:   phase,
    }
}

// hdr — the 28-byte section header. The four required fields (band_count,
// layer_mask, v_factor_bg, v_center/v_offset) plus the optional deform + tuning
// fields, defaulted exactly as the AS `parallax_section` macro did. Table
// pointers are `Label` (0 = no table).
pub comptime fn hdr(band_count: int, layer_mask: int, v_factor_bg: int, v_center: int, v_offset: int,
                v_factor_fg: int = 0, transition: int = 0,
                deform_fg: Label = 0, deform_bg: Label = 0,
                deform_speed_fg: int = 1, deform_speed_bg: int = 1,
                v_deform_bg: Label = 0, v_deform_speed_bg: int = 0, v_deform_shift_bg: int = 4,
                anchor_ch: int = PARALLAX_ANCHOR_NONE,
                anchor_dsa: int = 15, anchor_dsb: int = 15) -> parallax_config {
    // Both guards compare INTS inside a comptime fn CALLED from this file, so both actually
    // evaluate. The rejected alternative — "an anchored config must declare a deform table" —
    // would have compared a `Label` to an integer, which preset.emp:105-111 proves is
    // unevaluable and silently always-passes. That requirement is enforced structurally
    // instead: the per-line mode key tests anchor_ch directly (parallax.emp Step 4).
    ensure(anchor_ch == PARALLAX_ANCHOR_NONE || band_count + 1 <= MAX_PARALLAX_BANDS,
           "parallax hdr(): an anchored config SPLITS a band at runtime, so the shadow view needs band_count+1 entries — {band_count}+1 exceeds MAX_PARALLAX_BANDS ({MAX_PARALLAX_BANDS}) and the split would write past Parallax_Shadow_Bands")
    ensure(anchor_ch == PARALLAX_ANCHOR_NONE || anchor_ch < RASTER_MAX_PATCH,
           "parallax hdr(): anchor_ch {anchor_ch} is not a patch channel — the overlay indexes Effects_World_Y[RASTER_MAX_PATCH], so a wider index reads past the anchor bank")
    return parallax_config{
        pcfg_band_count:        band_count,
        pcfg_v_factor_bg:       v_factor_bg,
        pcfg_v_factor_fg:       v_factor_fg,
        pcfg_layer_mask:        layer_mask,
        pcfg_v_center_y:        v_center,
        pcfg_v_offset:          v_offset,
        pcfg_transition:        transition,
        pcfg_deform_speed_fg:   deform_speed_fg,
        pcfg_deform_speed_bg:   deform_speed_bg,
        pcfg_anchor_ch:         anchor_ch,
        pcfg_deform_table_fg:   deform_fg,
        pcfg_deform_table_bg:   deform_bg,
        pcfg_v_deform_table_bg: v_deform_bg,
        pcfg_v_deform_speed_bg: v_deform_speed_bg,
        pcfg_v_deform_shift_bg: v_deform_shift_bg,
        pcfg_anchor_dsa:        anchor_dsa,
        pcfg_anchor_dsb:        anchor_dsb,
    }
}

// =====================================================================
// OJZ default — 5-band forest BG, all-zero H-deform (per-line pipeline).
// Whole-plane V-scroll (v_factor_bg=3), uniform BG 1/2 depth. The deform
// shift 15 on every band flat-paths the zero table; the non-NULL pointer
// still selects per-line HScroll (byte-identical output, no sample math).
// =====================================================================

pub data DeformTable_Zero: [i8; 256] = deform_zero()

pub data ParallaxConfig_OJZ_Default: ParallaxCfg4 = ParallaxCfg4{
    hdr: hdr(band_count: 4, layer_mask: $1F, v_factor_bg: 3, v_center: 512, v_offset: 0,
             deform_bg: DeformTable_Zero),
    bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 8,  fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 40, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 48, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15) ],
}

// =====================================================================
// OJZ underwater — THE Parcel W fixture, and the first config in the tree with a
// world-anchored deform overlay.
//
// Same four bands as OJZ_Default and the same factors, so anything that changes between
// the two is the overlay and nothing else. Every authored band carries dsa/dsb = 15 (no
// deform), so ABOVE the anchored line the screen is exactly OJZ_Default. At the line, the
// overlay splits whichever band contains it and forces dsb = 2 from there down — a +/-2 px
// plane-B wobble against DeformTable_Shimmer.
//
// anchor_ch 0 is the SAME channel OJZ_TwoChannel's palette boundary rides (band 40..120),
// so one anchor — and one Effects_SetWorldY(0, y) — moves the tint and the shimmer together.
// That is the whole claim of this parcel, and it is only testable because this config is
// bound through a preset's ep_parallax rather than the act default.
// =====================================================================

pub data ParallaxConfig_OJZ_Underwater: ParallaxCfg4 = ParallaxCfg4{
    hdr: hdr(band_count: 4, layer_mask: $1F, v_factor_bg: 3, v_center: 512, v_offset: 0,
             deform_bg: DeformTable_Shimmer, deform_speed_bg: 3,
             anchor_ch: 0, anchor_dsa: 15, anchor_dsb: 2),
    bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 8,  fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 40, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 48, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15) ],
}

// =====================================================================
// OJZ windy — whole plane B waves at full sine amplitude (+/-96 px). Single
// band, BG factor 1/4 matching SkyHaze so a Sec0<->Sec1 transition lerps only
// the deform amplitude, not the BG scroll.
// =====================================================================

pub data DeformTable_OJZ_Calm: [i8; 256] = deform_sine(amplitude: 96, period: 64)

pub data ParallaxConfig_OJZ_Windy: ParallaxCfg1 = ParallaxCfg1{
    hdr: hdr(band_count: 1, layer_mask: $01, v_factor_bg: 15, v_center: 0, v_offset: 0,
             deform_bg: DeformTable_OJZ_Calm, deform_speed_bg: 1),
    bands: [ cfg_band(cell: 0, fa: FACTOR_1, fb: FACTOR_1_4, dsa: 4, dsb: 0) ],
}

// =====================================================================
// Shimmer — heat-haze wobble (small amplitude, tight wavelength, animated
// phase) on plane B. Pre-named speed variants; shift 2 => +/-2 px.
// =====================================================================

pub data DeformTable_Shimmer: [i8; 256] = deform_sine(amplitude: 8, period: 32)

comptime fn shimmer_bg(speed: int, shift: int = 2, fg: int = FACTOR_1, bg: int = FACTOR_1_4) -> ParallaxCfg1 {
    return ParallaxCfg1{
        hdr: hdr(band_count: 1, layer_mask: $01, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_bg: DeformTable_Shimmer, deform_speed_bg: speed),
        bands: [ cfg_band(cell: 0, fa: fg, fb: bg, dsa: shift, dsb: shift) ],
    }
}
pub data ParallaxConfig_Shimmer_Slow: ParallaxCfg1 = shimmer_bg(speed: 1)
pub data ParallaxConfig_Shimmer:      ParallaxCfg1 = shimmer_bg(speed: 3)   // default (medium)
pub data ParallaxConfig_Shimmer_Fast: ParallaxCfg1 = shimmer_bg(speed: 6)

// =====================================================================
// Haze — FG heat wobble. Graduated mode: sky/mountains skip (shift 15), hills
// faint (4), ground full (3). Uniform mode: every band shift 3.
// =====================================================================

pub data DeformTable_Haze: [i8; 256] = deform_sine(amplitude: 16, period: 64)

comptime fn haze_fg(speed: int, gradient: int = 1) -> ParallaxCfg5 {
    return ParallaxCfg5{
        hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_fg: DeformTable_Haze, deform_speed_fg: speed),
        bands: if gradient == 1 {
            [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 15, dsb: 4),   // clouds
              cfg_band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 15, dsb: 4),   // far mtns
              cfg_band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 15, dsb: 4),   // mid mtns
              cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 4,  dsb: 4),   // hills (+/-1 px)
              cfg_band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 3,  dsb: 4) ]  // ground (+/-2 px)
        } else {
            [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 3, dsb: 4),
              cfg_band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 3, dsb: 4),
              cfg_band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 3, dsb: 4),
              cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 3, dsb: 4),
              cfg_band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 3, dsb: 4) ]
        },
    }
}
pub data ParallaxConfig_Haze_Slow:    ParallaxCfg5 = haze_fg(speed: 1)
pub data ParallaxConfig_Haze:         ParallaxCfg5 = haze_fg(speed: 2)
pub data ParallaxConfig_Haze_Fast:    ParallaxCfg5 = haze_fg(speed: 4)
pub data ParallaxConfig_Haze_Uniform: ParallaxCfg5 = haze_fg(speed: 2, gradient: 0)

// =====================================================================
// Rocking — plane B rocks via per-column V-scroll sampling a sine table. BG
// H-scroll locked (FACTOR_0) to avoid the leftmost-partial-column VDP artifact;
// the zero H-deform table forces the per-line pipeline.
// =====================================================================

pub data DeformTable_Rocking: [i8; 256] = deform_sine(amplitude: 20, period: 64)

comptime fn rocking(speed: int, shift: int = 0) -> ParallaxCfg1 {
    return ParallaxCfg1{
        hdr: hdr(band_count: 1, layer_mask: $01, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_bg: DeformTable_Zero, v_deform_bg: DeformTable_Rocking,
                 v_deform_speed_bg: speed, v_deform_shift_bg: shift),
        bands: [ cfg_band(cell: 0, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 4) ],
    }
}
pub data ParallaxConfig_Rocking_Slow: ParallaxCfg1 = rocking(speed: 0)   // static tilt
pub data ParallaxConfig_Rocking:      ParallaxCfg1 = rocking(speed: 1)
pub data ParallaxConfig_Rocking_Fast: ParallaxCfg1 = rocking(speed: 3)   // stormy

// =====================================================================
// Perspective — V-column floor curve + per-band BG H-shimmer (sky/mtns skip,
// hills faint, ground strong). BG H-locked (FACTOR_0) for the same VDP quirk.
// =====================================================================

pub data DeformTable_Perspective: [i8; 256] = v_column_floor(center: 20, max_offset: 24)

comptime fn perspective(v_shift: int, h_speed: int, v_speed: int) -> ParallaxCfg5 {
    return ParallaxCfg5{
        hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
                 deform_bg: DeformTable_Shimmer, deform_speed_bg: h_speed,
                 v_deform_bg: DeformTable_Perspective, v_deform_speed_bg: v_speed, v_deform_shift_bg: v_shift),
        bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 15),
                 cfg_band(cell: 4,  fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 15),
                 cfg_band(cell: 10, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 15),
                 cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 4),
                 cfg_band(cell: 20, fa: FACTOR_1, fb: FACTOR_0, dsa: 4, dsb: 2) ],
    }
}
pub data ParallaxConfig_Perspective_Subtle:   ParallaxCfg5 = perspective(v_shift: 2, h_speed: 1, v_speed: 0)
pub data ParallaxConfig_Perspective:          ParallaxCfg5 = perspective(v_shift: 0, h_speed: 2, v_speed: 1)
pub data ParallaxConfig_Perspective_Dramatic: ParallaxCfg5 = perspective(v_shift: 0, h_speed: 3, v_speed: 2)

// =====================================================================
// WindyHaze — composite: windy multi-band BG gradient (clouds full wave down
// to ground none, per-band phase desync) + uniform FG haze (+/-2 px).
// =====================================================================

pub data ParallaxConfig_WindyHaze: ParallaxCfg5 = ParallaxCfg5{
    hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
             deform_fg: DeformTable_Haze, deform_speed_fg: 2,
             deform_bg: DeformTable_OJZ_Calm, deform_speed_bg: 1),
    bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 3, dsb: 0,  phase: 0),
             cfg_band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 3, dsb: 1,  phase: 64),
             cfg_band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 3, dsb: 2,  phase: 128),
             cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 3, dsb: 3,  phase: 192),
             cfg_band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 3, dsb: 15, phase: 0) ],
}

// =====================================================================
// SkyHaze — composite: top band (rows 0-13) windy BG, FG steady; bottom band
// (rows 14-27) FG haze, BG steady. A regional split at row 14, not a gradient.
// =====================================================================

pub data ParallaxConfig_SkyHaze: ParallaxCfg2 = ParallaxCfg2{
    hdr: hdr(band_count: 2, layer_mask: $03, v_factor_bg: 15, v_center: 0, v_offset: 0,
             deform_fg: DeformTable_Haze, deform_speed_fg: 2,
             deform_bg: DeformTable_OJZ_Calm, deform_speed_bg: 1, v_deform_shift_bg: 0),
    bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 15, dsb: 2),
             cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_4, dsa: 2,  dsb: 15) ],
}

// =====================================================================
// Caves — slow BG parallax (far bands barely move, FACTOR_1_16) with a
// section transition flag. Same 5-band shape as OJZ_Default; only H-factors
// differ. All-zero H-deform (flat-pathed) for the per-line pipeline.
// =====================================================================

pub data ParallaxConfig_OJZ_Caves: ParallaxCfg5 = ParallaxCfg5{
    hdr: hdr(band_count: 5, layer_mask: $1F, v_factor_bg: 15, v_center: 0, v_offset: 0,
             transition: 1, deform_bg: DeformTable_Zero),
    bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_16, dsa: 15, dsb: 15),
             cfg_band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_16, dsa: 15, dsb: 15),
             cfg_band(cell: 10, fa: FACTOR_1, fb: FACTOR_1_8,  dsa: 15, dsb: 15),
             cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_4,  dsa: 15, dsb: 15),
             cfg_band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,    dsa: 15, dsb: 15) ],
}

// =====================================================================
// LockedClouds — layer_mask $1E disables band 0 (bit 0 clear): the cloud band
// falls through the band-inheritance path to scroll 0 (locked), while the rest
// of plane B parallaxes. Verifies the disabled-band inheritance path.
// =====================================================================

pub data ParallaxConfig_OJZ_LockedClouds: ParallaxCfg5 = ParallaxCfg5{
    hdr: hdr(band_count: 5, layer_mask: $1E, v_factor_bg: 15, v_center: 0, v_offset: 0,
             transition: 1, deform_bg: DeformTable_Zero),
    bands: [ cfg_band(cell: 0,  fa: FACTOR_1, fb: FACTOR_1_8, dsa: 15, dsb: 15),
             cfg_band(cell: 4,  fa: FACTOR_1, fb: FACTOR_1_4, dsa: 15, dsb: 15),
             cfg_band(cell: 10, fa: FACTOR_1, fb: FACTOR_3_8, dsa: 15, dsb: 15),
             cfg_band(cell: 14, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15),
             cfg_band(cell: 20, fa: FACTOR_1, fb: FACTOR_1,   dsa: 15, dsb: 15) ],
}

