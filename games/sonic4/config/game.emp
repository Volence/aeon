// Sonic 4 — the game manifest: the one `implement` of the engine's Game contract
// (engine/system/game_contract.emp). The bind pass resolves it against the
// interface before lowering, so the engine's `Game.MEMBER` / `invoke Game.hook`
// sites fold and lower against these bindings. This module emits nothing.
module games.sonic4.game

// ENTRY_ID's value is the game-state id from the sole constants author.
use games.sonic4.constants.{GS_OJZ_SCROLL_TEST}

// The sound test harness is DEBUG-shape equipment: its hooks pull in
// games.sonic4.game_debug (mirror buffers, hotkey polling) and its ping fires
// unbidden at boot. A release build must never carry it, so the invariant is a
// comptime ensure here rather than a build.sh guard — build.sh is one build
// path among several (the sigil profiles drive their own defines).
ensure(SOUND_DEBUG_HOTKEYS == 0 || DEBUG == 1, "SOUND_DEBUG_HOTKEYS requires DEBUG=1")

pub implement Game {
    // The camera landing-lock system is present (requires the game-defined
    // _pl_state / PSTATE_JUMP / PSTATE_ROLLJUMP the camera's =1 arm reads).
    const CAMERA_JUMP_LOCK = true

    // The parallax capability mask — every scanline service any of the twenty shipped
    // parallax configs demands. DECLARED as a literal rather than computed because the
    // registry it would fold (SceneRegistry_CapsFolded) does not exist until Task 5,
    // while adding the interface member obliges BOTH games to bind it immediately or
    // contract closure fails. Derived by hand from
    // games/sonic4/data/parallax/configs.emp against scene_caps()/fold_caps()
    // (engine/level/scene_dsl.emp):
    //
    //   $0001                    RETIRED 2026-08-26 (d-29-corrected): was CAP_PER_LINE,
    //                            raised by every scene. The per-line HScroll fill is the
    //                            only fill now, so there is nothing for a bit to elide.
    //   $0002 CAP_PER_COL_VSRAM  v_deform_bg on Rocking (configs.emp:216, three variants)
    //                            and Perspective (:236, three variants). SkyHaze's
    //                            `v_deform_shift_bg: 0` (:272) attaches NO table — it is
    //                            the shift bridge, and it does NOT raise this bit.
    //   $0004 CAP_DEFORM         a table AND a live (non-15) amplitude somewhere:
    //                            OJZ_Windy's `dsa: 4, dsb: 0` (:153), and OJZ_Underwater
    //                            reaches it through `anchor_dsb: 2` (:135) alone, since
    //                            all four of its authored bands sit at 15.
    //   $0008 CAP_ANCHORS        `anchor_ch: 0` on OJZ_Underwater (:135) — the only
    //                            anchored config in the tree.
    //   $0010 CAP_TRANSITIONS    no single scene can raise it; fold_caps() adds it when
    //                            the registry holds more than one scene, and this one
    //                            holds twenty.
    //
    // NOTHING CHECKS THIS WORD YET. Task 5 adds the verifying ensure beside the
    // registry's own fold_caps() call — folded ⊆ declared, spelled as an OR-identity
    // over ints — and until that lands this literal is PENDING VERIFICATION. Task 5
    // must not be skipped or reordered past this task. A partial registry en route stays
    // legal: a subset folds clean against a superset declaration. Once the registry
    // exists the binding MAY flip to `= SceneRegistry_CapsFolded` (Task 1's spike proved
    // computed consts bind here); that is a readability preference, not a correctness
    // fix — the ensure is what makes either spelling honest.
    //   $0040 CAP_FACTOR_CURVE   ADDED 2026-08-26 by the d-15 showcase parcel — the owner's
    //                            answer to PARK-1. It is NOT raised by any of the twenty
    //                            shipped hand scenes (scene_registry.emp's two-sided pin
    //                            still reads $001E and its CAP_FACTOR_CURVE == 0 assertion
    //                            still holds); it is raised by the AURORA-AUTHORED scene
    //                            `ojz_act1_depth`, whose two lower layers carry
    //                            `curve: SceneCurve.To(..)`. Because the editor fold is
    //                            checked against THIS word, the declaration lives here.
    //                            Raising it also flips the record shape — see
    //                            engine/level/parallax.emp's BAND_CURVE_N and
    //                            engine/ram.emp's BAND_CURVE_BYTES, moved in the same
    //                            commit, which is what that pin's message demands.
    //
    // The editor fold ALSO raises $0010 CAP_TRANSITIONS (two editor scenes) and $0008
    // from the start scene's anchor — both already declared above. Bit 0 stays the
    // retired hole (d-29-corrected): $005E, not $005F.
    //   $0080 CAP_BAND_DRIFT     ADDED 2026-09-02 by the drift ADOPTION parcel (EFFECTS-W1
    //                            item 3). Unlike CAP_FACTOR_CURVE above, this one IS raised
    //                            by a shipped HAND scene: Scene_OJZ_Default's four bands
    //                            carry `drift: SceneDrift.Rate(-32)`, so
    //                            scene_registry.emp's two-sided pin moved $001E -> $009E in
    //                            the same commit. Raising it also flips the record shape —
    //                            engine/level/parallax.emp's BAND_DRIFT_N and
    //                            engine/ram.emp's BAND_DRIFT_BYTES moved with it, and
    //                            Parallax_State grew 128 B (the shadow tail plus the
    //                            per-band accumulator array). The picture is the OJZ act-1
    //                            canopy drifting on its own; the look call is in
    //                            games/sonic4/data/effects/ojz_scenes.emp's banner.
    //   $0100 CAP_ANCHOR_MOTION  ADDED 2026-09-03 by the anchor-mover parcel (EFFECTS-W1
    //                            item 4). IT IS RAISED BY NO SCENE AT ALL, and that is not
    //                            an omission — anchor motion is a PRESET channel, not a
    //                            parallax_config field, so scene_registry.emp's fold cannot
    //                            see it and SceneRegistry_CapsExpected stays $009E. The
    //                            subset test is one-sided precisely for this case: a
    //                            declared superset only forgoes a specialisation. What
    //                            raises it in practice is
    //                            games/sonic4/data/effects/ojz_effects.emp's
    //                            OJZ_Preset_Sec0, whose channel 0 carries
    //                            `anchor_sweep(4, 1)`. The bit gates two spans in
    //                            engine/effects/raster.emp (the mover inside
    //                            Effects_LatchWorldLines and Effects_SetTargetY's body);
    //                            demo declares 0 and elides both.
    //   $0200 CAP_DENSE_TIER     ADDED 2026-09-03 by the item-6 parcel (EFFECTS-W1 item 6,
    //                            dense per-line VSRAM). Unlike every bit above, THIS ONE
    //                            GATES NO ENGINE SPAN — Raster_HInt's `.op_run_ramp` /
    //                            `.ramp_body` (OP_RUN_RAMP, shipped 2026-08-14) stay
    //                            unconditional in every game, because their dispatch sits
    //                            in a compare CHAIN whose cost model prices every later
    //                            op's dispatch depth as a fixed function of opcode value —
    //                            eliding a mid-chain compare per-game would silently move
    //                            OP_PAL_RESTORE's depth for that game (see the ensure's own
    //                            comment in games/sonic4/data/effects/ojz_effects.emp, next
    //                            to OJZ_TestRamp). Instead the bit gates CONSTRUCTION: a
    //                            game may not build a RasterRampProgram at all — CRAM or
    //                            VSRAM — without declaring this first. sonic4 declares it
    //                            because OJZ_TestRamp constructs one (a gate fixture that
    //                            never renders — see "SECTION 0 SURRENDERS OJZ_TestRamp"
    //                            in ojz_effects.emp — but construction still requires the
    //                            bit); demo constructs no ramp program and declares 0.
    //   $0400 CAP_ROLE_SWAP      ADDED 2026-09-03 by the item-10b parcel (EFFECTS-W1 item
    //                            10b, the plane-role swap), on a separate branch from
    //                            item 6 above — both independently derived $0200 as "the
    //                            next bit" and collided; ruled to $0400 since item 6
    //                            landed first. Gates five sites in
    //                            engine/level/parallax.emp (Parallax_Init, Parallax_
    //                            Update's register reassert, the whole body of
    //                            Parallax_Set_Roles_Swapped, and the two HScroll/VSRAM
    //                            pack-order swaps). sonic4 raises it because it is the
    //                            only game with a scene worth demonstrating the swap on;
    //                            demo declares 0 and every gated site — including the
    //                            new proc itself — compiles to zero bytes.
    const SCANLINE_CAPS = $0FDE

    // Boot enters ojz_scroll_test's GameState_OJZScroll_Init.
    const ENTRY_ID = GS_OJZ_SCROLL_TEST
    proc entry = GameState_OJZScroll_Init

    // The collect visual: RingCollision hands the ring's centre to the sparkle
    // spawner (games/sonic4/objects/ring_sparkle.emp).
    hook ring_collected = RingSparkle_Spawn

    // The sound test-harness hooks — bound only in the hotkeys build shape; in
    // every canonical shape both stay `= empty` (zero bytes, as today). The
    // bound procs live in games.sonic4.game_debug.
    if SOUND_DEBUG_HOTKEYS == 1 && SOUND_DRIVER_ENABLED == 1 {
        hook boot_hook = SoundTest_BootPing
        hook debug_tick = Debug_MusicToggle
    }
}
