// Sonic 4 — the game manifest: the one `implement` of the engine's Game contract
// (engine/system/game_contract.emp). The bind pass resolves it against the
// interface before lowering, so the engine's `Game.MEMBER` / `invoke Game.hook`
// sites fold and lower against these bindings. This module emits nothing.
module games.sonic4.game

// ENTRY_ID's value is the game-state id from the sole constants author.
use games.sonic4.constants.{GS_OJZ_SCROLL_TEST}

// The sound test harness is DEBUG-shape equipment: its hooks pull in
// games.sonic4.game_debug (mirror buffers, hotkey polling) and its ping fires
// unbidden at boot. A release build must never carry it, so the invariant is a
// comptime ensure here rather than a build.sh guard — build.sh is one build
// path among several (the sigil profiles drive their own defines).
ensure(SOUND_DEBUG_HOTKEYS == 0 || DEBUG == 1, "SOUND_DEBUG_HOTKEYS requires DEBUG=1")

pub implement Game {
    // The camera landing-lock system is present (requires the game-defined
    // _pl_state / PSTATE_JUMP / PSTATE_ROLLJUMP the camera's =1 arm reads).
    const CAMERA_JUMP_LOCK = true

    // The parallax capability mask — every scanline service any of the twenty shipped
    // parallax configs demands. DECLARED as a literal rather than computed because the
    // registry it would fold (SceneRegistry_CapsFolded) does not exist until Task 5,
    // while adding the interface member obliges BOTH games to bind it immediately or
    // contract closure fails. Derived by hand from
    // games/sonic4/data/parallax/configs.emp against scene_caps()/fold_caps()
    // (engine/level/scene_dsl.emp):
    //
    //   $0001                    RETIRED 2026-08-26 (d-29-corrected): was CAP_PER_LINE,
    //                            raised by every scene. The per-line HScroll fill is the
    //                            only fill now, so there is nothing for a bit to elide.
    //   $0002 CAP_PER_COL_VSRAM  v_deform_bg on Rocking (configs.emp:216, three variants)
    //                            and Perspective (:236, three variants). SkyHaze's
    //                            `v_deform_shift_bg: 0` (:272) attaches NO table — it is
    //                            the shift bridge, and it does NOT raise this bit.
    //   $0004 CAP_DEFORM         a table AND a live (non-15) amplitude somewhere:
    //                            OJZ_Windy's `dsa: 4, dsb: 0` (:153), and OJZ_Underwater
    //                            reaches it through `anchor_dsb: 2` (:135) alone, since
    //                            all four of its authored bands sit at 15.
    //   $0008 CAP_ANCHORS        `anchor_ch: 0` on OJZ_Underwater (:135) — the only
    //                            anchored config in the tree.
    //   $0010 CAP_TRANSITIONS    no single scene can raise it; fold_caps() adds it when
    //                            the registry holds more than one scene, and this one
    //                            holds twenty.
    //
    // NOTHING CHECKS THIS WORD YET. Task 5 adds the verifying ensure beside the
    // registry's own fold_caps() call — folded ⊆ declared, spelled as an OR-identity
    // over ints — and until that lands this literal is PENDING VERIFICATION. Task 5
    // must not be skipped or reordered past this task. A partial registry en route stays
    // legal: a subset folds clean against a superset declaration. Once the registry
    // exists the binding MAY flip to `= SceneRegistry_CapsFolded` (Task 1's spike proved
    // computed consts bind here); that is a readability preference, not a correctness
    // fix — the ensure is what makes either spelling honest.
    const SCANLINE_CAPS = $001E

    // Boot enters ojz_scroll_test's GameState_OJZScroll_Init.
    const ENTRY_ID = GS_OJZ_SCROLL_TEST
    proc entry = GameState_OJZScroll_Init

    // The collect visual: RingCollision hands the ring's centre to the sparkle
    // spawner (games/sonic4/objects/ring_sparkle.emp).
    hook ring_collected = RingSparkle_Spawn

    // The sound test-harness hooks — bound only in the hotkeys build shape; in
    // every canonical shape both stay `= empty` (zero bytes, as today). The
    // bound procs live in games.sonic4.game_debug.
    if SOUND_DEBUG_HOTKEYS == 1 && SOUND_DRIVER_ENABLED == 1 {
        hook boot_hook = SoundTest_BootPing
        hook debug_tick = Debug_MusicToggle
    }
}
