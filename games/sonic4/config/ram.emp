// Sonic 4 game RAM — the `.emp` region form (item #7c).
//
// A single region chained onto the engine RAM: `game_ram @ after(upper_ram)`
// continues from Engine_RAM_End (the E5 engine/game split), exactly as the
// retired `phase Engine_RAM_End` did. This module is the SOLE author of the game
// RAM layout — its `pub` labels are the joint-link authority every game consumer
// (`.emp` player code + the residual AS test harness) resolves against.
//
// The `Game_RAM_End >= SYSTEM_STACK` overflow guard becomes the region `limit`;
// the `Player_Pos_Ring & $FF` 256-alignment guard becomes `@align(256)` (aligned
// by construction, so the check is unnecessary); the `ifdef __DEBUG__` counters
// become an `if DEBUG == 1 @shape_divergent` group. `w_addressable` asserts the
// whole window is `.w`-reachable — the hot player data is `.w`-addressed (an added
// invariant the retired `.asm` did not state; it holds because game RAM sits above
// $FFFF8000 and below SYSTEM_STACK, bit 15 set throughout).

module games.sonic4.ram

use engine.constants.{SYSTEM_STACK, NUM_PLAYERS}
use games.sonic4.constants.{REEL_BAND_COUNT}

// -----------------------------------------------
// PlayerBlock — one player slot's mutable per-frame working state
// -----------------------------------------------
// The 8-word physics row (recomputed by Player_RefreshPhysics on section change /
// status events, NEVER per-frame; field order must match the first eight PHYS_*
// constants, engine/system/constants.emp) plus the two bytes the frame derives
// each tick. a4 points at the CALLING SLOT's block for the whole player frame,
// established once in Player_Main by the `player_block` splice (player_common),
// and every consumer addresses this state a4-relative — that is the entire
// per-slot mechanism: no slot index in a register, no arithmetic at the access
// sites.
//
// Declaring it as a TYPE rather than a hand-sized run is what makes the layout
// invariants structural instead of merely checked: the stride is sizeof(PlayerBlock),
// slot N's base is the array's own indexing, and there is no separate size
// constant, evenness assertion, or block/tail adjacency to keep in sync.
// The physics row's length in WORDS — the single authority shared by the
// PlayerBlock head below and every PhysTable_* ROM row the roster can point at.
// Player_RefreshPhysics block-copies one into the other, so they must agree.
//
// It exists because the guard on each row could not be bound to the row itself:
// `sizeof()` takes types and `.len` does not apply to a typed `data` symbol, so
// the three guards used to spell a bare `8 * 2` while their MESSAGES named
// PhysTable_Sonic/Tails/Knuckles — conditions that referenced only PlayerBlock and
// would not have noticed a 9th row. Routing both sides through this name makes the
// declared array size and the guard move together.
pub const PHYS_ROW_WORDS = 8

pub struct PlayerBlock {
    accel:          u16,
    decel:          u16,
    friction:       u16,
    top_speed:      u16,
    gravity:        u16,
    jump_force:     u16,
    air_accel:      u16,
    release_cap:    u16,
    quadrant:       u8,     // (angle+$20)>>6 — derived once per frame
    jump_buffer:    u8,     // frames remaining on buffered jump press
    dust_timer:     u8,     // frames until the next dust puff (4-frame cadence);
                            // 0 while not emitting so the first puff of a skid
                            // lands on the arming frame, as in S3K
    pad:            u8,     // KEEPS sizeof(PlayerBlock) EVEN. The struct is the
                            // per-slot ARRAY STRIDE (`lea sizeof(PlayerBlock)(dst),
                            // dst`), and every field from accel down is a u16 at
                            // even offset 0..15 — an odd stride would put slot 1's
                            // accel on an odd address and `move.w` would ADDRESS
                            // ERROR. 8 words + quadrant + jump_buffer was exactly
                            // 18; dust_timer makes 19, so this pads back to 20.
    xover_cell:     u32,    // THE LOOP CROSSOVER EDGE TRIGGER's whole state: the world
                            // collision cell this slot was in when the crossover read
                            // last ran, packed (x & ~(COLL_CELL_W-1)) << 16 |
                            // (y & ~(COLL_CELL_H-1)). Player_LoopCrossover
                            // (player_common.emp) fires only when it CHANGES, which is
                            // what stops a marked cell re-firing every frame you stand
                            // on it — and, because the value is derived from POSITION
                            // ONLY, what stops the write to Sst.layer from re-arming
                            // the trigger it just fired (a plane-A cell saying TO_B and
                            // the plane-B cell under it saying TO_A is the ORDINARY
                            // two-way loop pair, docs/LOOP_CROSSOVER_ENCODING.md §3.3,
                            // and a value-derived trigger would ping-pong on it every
                            // frame). Boot-cleared with all Work-RAM; cell (0,0) is
                            // therefore the initial value and a player spawning
                            // anywhere else fires on their first frame, reading
                            // XOVER_NONE like every other unmarked cell.
                            // Even offset (20), so the `move.l`/`cmp.l` pair below is
                            // aligned in BOTH slots at the 24-byte stride.
    xover_cursor:   u32,    // THE SWEEP's walking cursor, same packing as xover_cell.
                            // A frame can move 16 px (PHYS_GSP_CAP) against an 8 px
                            // collision cell and nothing substeps horizontal movement,
                            // so the crossover read WALKS from the cell it last ran in
                            // to the cell it resolved to, probing each — otherwise a
                            // mark one cell wide is stepped clean over above ~8 px/frame
                            // and never fires. This is that walk's only state.
                            //
                            // TRANSIENT, not persistent: it is initialised and consumed
                            // inside one Player_LoopCrossover call and means nothing
                            // between frames. It lives HERE, per slot, rather than on
                            // the stack because sigil's contract closure only recognises
                            // a `move.l a0,-(sp)` / `movea.l (sp)+,a0` save across a
                            // call while the stack is otherwise balanced at that point
                            // — a sweep frame underneath it makes the analysis report
                            // Player_LoopCrossover as clobbering a0, which is a
                            // `preserves(a0)` violation at Player_Main's call site
                            // (measured 2026-09-04; both a stack frame and a
                            // register-to-register save reproduce it on their own).
                            // Per SLOT rather than one global for the same reason
                            // xover_cell is: the two are read and written together and
                            // a follower running two preambles must not share either.
                            // Even offset (24) — read and written with move.l/cmp.l.
}

pub region game_ram @ after(upper_ram) .. SYSTEM_STACK, w_addressable

pub vars game_ram {
    // DEBUG counters (size-varying → the fields below shift +4 in the debug shape,
    // exactly as the retired `ifdef __DEBUG__` block did — declared divergent).
    if DEBUG == 1 @shape_divergent {
        Dbg_Music_On:   u16,    // 1 = test song playing (Start toggles; low byte only)
        Dbg_Sfx_Sel:    u16,    // B-button SFX-trigger cycle index (low byte; 0..7)
    }

    // -----------------------------------------------
    // Cheats
    // -----------------------------------------------
    // The runtime cheat gate — a bitfield of the CHEAT_* masks (config/constants.emp).
    // Cheat PAYLOAD ships in every build shape; this byte is the only thing that
    // makes a cheat reachable, so authoring a cheat code (button sequence, menu
    // unlock) later needs no engine or player change — it just sets a bit here.
    // Boot-cleared with all Work-RAM, so the release/lean default (every cheat off)
    // costs ZERO bytes; only the DEBUG shape writes it (ojz_scroll_test's init).
    Cheat_Flags:            u8,
    pad(1),                         // keep the following words even-aligned

    // -----------------------------------------------
    // Player (§5)
    // -----------------------------------------------
    // The active character (a CHAR_* id, config/constants.emp). Boot-cleared with
    // all Work-RAM, so the default is CHAR_SONIC with no init write.
    Character_ID:           u16,

    // The RESOLVED CharacterDef pointer for the active character —
    // `CharacterDefs[Character_ID]`, cached once by Player_Init so the per-frame
    // dispatch sites cost one indirection instead of an index + table read.
    //
    // WHY IT LIVES IN GAME RAM AND NOT IN THE SST OVERLAY: engine/system/replay.emp
    // hashes the whole PlayerV window ($30..$4D) as part of the recorded-input
    // regression net, and its contract is that every field inside a hashed span is
    // ADDRESS-FREE — the hash must be identical across two builds that differ only
    // in where things landed. A ROM pointer in that window would make every
    // recorded fixture build-address-dependent (and a DEBUG mismatch is a hard
    // `raise_exception "REPLAY DESYNC"`, not a warning). Character state therefore
    // stays outside the SST entirely.
    Player_Chardef:         u32,

    // Per-slot player working state — one PlayerBlock per slot, so both slots
    // can move independently (C1). See the PlayerBlock declaration above for the
    // a4 convention this array exists to serve.
    Player_Blocks:      [PlayerBlock; NUM_PLAYERS],

    // Death is a whole-run event, not per-slot working state — one flag.
    Player_Death_Pending:   u8,     // EDGE_KILL hook: set when the player crosses a
                                    // kill-edge; the death system consumes it.
                                    // Boot-cleared with all Work-RAM.
    pad(1),                         // keep the following words even-aligned

    // Act-invariant player clamp edges — computed once per act by
    // Player_BoundsInit (player_common), consumed per-frame by
    // Player_LevelBound. Boot-cleared with all Work-RAM (zero until init;
    // Player_LevelBound carries a DEBUG assert against the stale-zero case).
    Player_Bound_Right:     u16,    // act right clamp edge (px): level_width − PBOUND_RIGHT_MARGIN
    Player_Bound_Bottom:    u16,    // act playable bottom edge (px): level_height − SCREEN_HEIGHT

    // The act's TRUE pixel extent — the valid world box is [0, Level_Width) ×
    // [0, Level_Height). Published by the SAME Player_BoundsInit pass that writes
    // the two clamp edges above, from the values it already holds BEFORE it
    // subtracts its margins (grid_w/grid_h << SECTION_SIZE_SHIFT off the act
    // descriptor). Boot-cleared with all Work RAM, so both read 0 until an act
    // init has run.
    //
    // THESE EXIST BECAUSE THE TWO SYMBOLS ABOVE ARE THE WRONG ANSWER TO THIS
    // QUESTION, IN THE DIRECTION THAT LOOKS RIGHT. Player_Bound_Right/Bottom are
    // the PLAYER's clamp edges, INSET by PBOUND_RIGHT_MARGIN and SCREEN_HEIGHT
    // respectively — they are not the act extent. Objects are deliberately
    // unclamped (see the Obj_Req_X/Y block below), so an object placed between
    // Player_Bound_Right and Level_Width is LEGAL and renders. A tool that read
    // the bound symbols as the extent would refuse legitimate placements in that
    // strip — and a refusal near an edge is half-expected, so the bug would look
    // like correct behaviour and survive review. Note also there is NO
    // Player_Bound_Left / Player_Bound_Top: the low edge is a literal 0 in
    // clamp_and_publish (games/sonic4/test/ojz_scroll_test.emp).
    //
    // BOTH SHAPES, ON PURPOSE. External tools resolve these BY NAME out of the
    // build's listing, per call and never cached, exactly as they do Camera_X /
    // Camera_Y — so they must NOT be moved inside an `if DEBUG == 1` group, and
    // must not be renamed without telling the consumers. (Their ADDRESSES are
    // free to move between shapes and between builds; that is precisely what
    // per-call name resolution buys.)
    //
    // MEGA-ACT CEILING — INHERITED, NOT WIDENED. These are u16 and word-wrap
    // above $FFFF px, i.e. a grid dimension > 31 sections, which is exactly the
    // ceiling Player_BoundsInit's own word stores already carry. It is held today
    // by the act descriptor's `(GRID_W << SECTION_SIZE_SHIFT) <= $8000` /
    // `(GRID_H << SECTION_SIZE_SHIFT) <= $8000` ensures
    // (games/sonic4/data/levels/ojz/act1/act_descriptor.emp), which bound both
    // quantities to $8000 — half the word. DO NOT widen these to u32 to "fix"
    // that: the constraint is documented, shared with the clamp edges beside
    // them, and a downstream consumer has recorded the dependency in the
    // direction that OUR word stores break before its own arithmetic does.
    // Relaxing the ceiling is a change to Player_BoundsInit and to these cells
    // together, never to these cells alone.
    Level_Width:            u16,    // act extent X (px) = grid_w << SECTION_SIZE_SHIFT
    Level_Height:           u16,    // act extent Y (px) = grid_h << SECTION_SIZE_SHIFT

    // -----------------------------------------------
    // Player history rings (§5)
    // -----------------------------------------------
    // Position/stat history rings (future Tails follow + trails; recorded from day
    // one). 256-aligned: index wraps via low-byte increment.
    //
    // LEADER-ONLY BY CONTRACT: this is the LEADER's position history, the trail a
    // follower reads to lag behind. Player_Main records it for slot 0 and no other
    // — if every slot wrote here, the samples would interleave at the 4-byte
    // stride and the ring would describe no player at all.
    Player_Pos_Ring:    [u8; 256] @align(256),  // 64 × (x.w, y.w)
    Player_Stat_Ring:   [u8; 256],              // 64 × (input.w, status.b, pad.b)
    Player_Ring_Index:  u16,                    // byte offset into both rings — word-sized for (an,dn.w) index

    // -----------------------------------------------
    // Warp mailbox (DEBUG shapes only) — the supported EXTERNAL warp interface
    // -----------------------------------------------
    // Aurora's "play from cursor" writes a destination here and the level state's
    // frame-top consumer (Debug_Warp_Consume, games/sonic4/test/ojz_scroll_test.emp)
    // performs a coherent warp inside the frame boundary. Full protocol +
    // rationale: docs/ENGINE_ARCHITECTURE.md, "§4.12 External Warp Mailbox".
    //
    // THE WRITE ORDER IS THE PROTOCOL: the external writer stores X, then Y, then
    // the FLAG. The consumer only ever reads X/Y on a frame where the flag is
    // already nonzero, so a write that is interrupted between the three stores is
    // read on a later frame, never half-applied — there is no lock and none is
    // needed. The cleared flag is the ACK the client polls; the consumer writes the
    // CLAMPED destination back into X/Y before clearing it, so a client that read
    // the pair after the ack learns where the engine actually put the player.
    //
    // RAM TAIL + @shape_divergent, deliberately: placed after every existing game
    // var so the DEBUG-shape addition ripples ZERO addresses — engine RAM does not
    // move at all (this is game RAM, chained after Engine_RAM_End) and no game
    // symbol below it exists. Release carries none of it, which is the whole
    // zero-release-bytes property restated in RAM terms.
    if DEBUG == 1 @shape_divergent {
        Warp_Req_X:         u16,    // destination PLAYER world X (px, flat world space)
        Warp_Req_Y:         u16,    // destination PLAYER world Y (px, flat world space)
        Warp_Req_Flag:      u8,     // 0 = idle / consumed (the ack); nonzero = pending
        pad(1),                     // keep the following words even-aligned

        // -----------------------------------------------
        // Boot-position override mailbox (DEBUG shapes only)
        // -----------------------------------------------
        // The mailbox the level INIT consumes, as against the warp mailbox above
        // which the level UPDATE consumes. Aurora's "Build & Run at cursor" writes
        // it so the very first displayed frame is already at the cursor — no
        // boot-at-start-then-warp, so neither the authored start's ~1.5 s of play
        // nor the visible draw-then-jump ever happens. Full protocol + the RAM-clear
        // timing truth: docs/ENGINE_ARCHITECTURE.md, "§4.12" (boot-override half).
        //
        // SAME COORDINATE SYSTEM AS THE WARP, deliberately: flat world pixels, the
        // player's own position, not sec+local. The init natively consumes sec+local
        // (Camera_Init reads Act.start_sec_*/start_local_*), but the override
        // substitutes AFTER that read, so the conversion cost is zero on the boot
        // path and the client gets ONE coordinate convention across both mailboxes.
        //
        // SAME WRITE ORDER IS THE PROTOCOL: X, then Y, then the FLAG last. Same ack:
        // the engine publishes the CLAMPED pair back and clears the flag.
        //
        // THE ONE THING THAT DIFFERS FROM THE WARP, and it is a hard requirement on
        // the client: boot clears ALL 64KB of Work RAM (engine/system/boot.emp
        // `.clear_ram`, a ruling — there is no preserved region and none may be
        // proposed), so these cells CANNOT be written at the reset-paused machine.
        // They must be written AFTER the clear and BEFORE the level init reads them.
        // The supported window is a breakpoint on the game's entry state
        // (GameState_OJZScroll_Init): break, write X/Y/flag, resume. Nothing has been
        // displayed at that point — the init enables the display on its way out — so
        // the first visible frame is the override's.
        Boot_At_X:          u16,    // boot PLAYER world X (px, flat world space)
        Boot_At_Y:          u16,    // boot PLAYER world Y (px, flat world space)
        Boot_At_Flag:       u8,     // 0 = idle / consumed (the ack); nonzero = pending

        // -----------------------------------------------
        // Effects-lab scene cursor (DEBUG shapes only)
        // -----------------------------------------------
        // The index into games/sonic4/data/effects/scene_registry.emp's `SCENES[]`
        // that Debug_SceneCycleHotkey (games/sonic4/test/ojz_scroll_test.emp) last
        // installed. Range 0..SCENE_CYCLE_COUNT-1; the hotkey asserts that before
        // every table read.
        //
        // THE BOOT VALUE 0 IS MEANINGFUL, not just the RAM clear showing through.
        // Boot clears all of Work RAM (engine/system/boot.emp `.clear_ram`), so this
        // reads 0 on the first frame — and SCENES[0] is Scene_OJZ_Default, which is
        // also `Act.act_parallax_config` for OJZ act 1 (act_descriptor.emp:159). So
        // on the ordinary boot the cursor already names the scene on screen, and the
        // first forward press steps to 1 as a reader would expect. A boot into a
        // section whose preset binds something else (OJZ_Preset_Depth binds
        // ParallaxConfig_OJZ_Underwater) starts the cursor one entry off the visible
        // scene for exactly one press; it is a cursor, not a mirror of the engine's
        // live config, and nothing reads it back.
        //
        // IT CONSUMED THE PAD BYTE THAT WAS ALREADY HERE — when this field landed the
        // DEBUG block grew by ZERO bytes. The pad existed only to keep Game_RAM_End
        // even; a u8 in the same slot did the same job and carried a value. That is
        // why this one sits at an ODD address ($FFFFE60D, measured in s4.debug.lst)
        // and the raster cursor below sits at the even one, needing its own pad —
        // "add another u8 and it is free" was never the rule; the rule is that
        // Game_RAM_End stays even.
        Debug_Scene_Index:  u8,     // effects-lab cursor: index into SCENES[]

        // -----------------------------------------------
        // Effects-lab RASTER cursor (DEBUG shapes only)
        // -----------------------------------------------
        // The row of Debug_BandDemoHotkey's `.raster_table` that the NEXT START+UP
        // press will install (games/sonic4/test/ojz_scroll_test.emp). Range
        // 0..RASTER_CYCLE_COUNT-1; the hotkey asserts that before every table read,
        // and tools/test_raster_cycle_table_lint.py holds the count to the rows.
        //
        // THE BOOT VALUE 0 IS MEANINGFUL, exactly as the scene cursor's is, and for a
        // sharper reason: boot clears all of Work RAM (engine/system/boot.emp
        // `.clear_ram`), so row 0 is what the FIRST press from a cold boot installs —
        // and row 0 is OJZ_BandDemo, the hand-authored control. That is what keeps
        // "START held + UP installs OJZ_BandDemo", the documented behaviour this
        // cursor generalises, true for the press a reader actually makes first.
        //
        // IT IS A CURSOR, NOT A MIRROR of the live raster channel: a section crossing
        // re-installs that section's own program through Effects_InstallPreset and
        // never touches this byte, and START+DOWN (bands OFF) deliberately leaves it
        // alone so OFF-then-ON resumes the cycle rather than restarting it. Nothing
        // reads it back.
        //
        // THIS FIELD GROWS THE DEBUG BLOCK BY 2 BYTES (itself, plus the pad that puts
        // Game_RAM_End back on an even address) and the RELEASE block by NONE: the
        // whole group is `if DEBUG == 1 @shape_divergent` and sits at the RAM tail, so
        // no address below it moves in either shape.
        //
        // MEASURED rather than argued, 2026-08-29: DEBUG Game_RAM_End $FFFFE60E ->
        // $FFFFE610 with this field at $FFFFE60E, and the release shape built with and
        // without this whole block is BYTE-IDENTICAL (crc c9255279, 719235 B both ways,
        // release Game_RAM_End $FFFFBD02 both ways).
        Debug_Raster_Index: u8,     // effects-lab cursor: row in .raster_table

        // -----------------------------------------------
        // Effects-lab PRESET cursor (DEBUG shapes only)
        // -----------------------------------------------
        // The SECTION whose EffectsPreset Debug_PresetCycleHotkey
        // (games/sonic4/test/ojz_scroll_test.emp) last installed onto the section the
        // camera is actually standing in. Range 0..PRESET_CYCLE_COUNT-1, where the count
        // is read from the LIVE act (grid_w x grid_h, bounded by the readout's single
        // digit); the hotkey asserts that before every use.
        //
        // THE BOOT VALUE 0 IS MEANINGFUL, and it means something different from the two
        // cursors above. This hotkey ADVANCES BEFORE IT INSTALLS, so a cold boot's first
        // press installs section 1's preset, not section 0's — and that is deliberate,
        // because a boot lands the camera IN section 0 (Act.start_sec_x/y), where
        // installing section 0's preset would change nothing on screen. The first press
        // a reviewer makes has to change the picture or the tool has failed at its one
        // job. The raster cursor beside this one installs BEFORE it advances for the
        // opposite and equally deliberate reason, stated in its own block: there row 0 is
        // a documented control that must be what the first press shows.
        //
        // IT IS A CURSOR, NOT A MIRROR of the live section: crossing a section boundary
        // re-installs that section's own preset through Effects_InstallPreset and never
        // touches this byte. Nothing reads it back except the hotkey and its readout.
        //
        // IT CONSUMED THE PAD BYTE THAT WAS ALREADY HERE, exactly as Debug_Scene_Index
        // did: the pad existed only to keep Game_RAM_End even, and a u8 in the same slot
        // does that job while carrying a value. So this field grows the DEBUG block by
        // ZERO bytes and the release block by none.
        Debug_Preset_Index: u8,     // effects-lab cursor: section whose preset is installed

        // The effects lab's BG-ANIMATION tier (owner ask 2026-09-03: "can we please just
        // get rid of the animated tiles for now, they're so distracting? Maybe have one
        // view for horizontal and one for vertical?"). 0 = OFF, 1 = the Camera_X view,
        // 2 = the Camera_Y view; the cursor indexes Debug_BgAnimViewHotkey's `.view_table`.
        //
        // OFF IS THE BOOT STATE AND IT IS NOT THIS BYTE'S DOING. Boot clears Work RAM so
        // the cursor reads 0, but what actually makes the act boot silent is that
        // tools/inject_editor_bg.py emits `BgAnim_Table: u16 = 0` for a `default_off`
        // band — in EVERY shape, release included. This byte only exists so the DEBUG
        // shape can put a view back.
        //
        // UNLIKE its three neighbours this one could NOT consume a pre-existing pad: the
        // pad Debug_Scene_Index and Debug_Preset_Index each took is spent. So it brings
        // its own, which is what keeps Game_RAM_End even.
        Debug_BgAnim_View:  u8,     // effects-lab cursor: 0 = off, 1 = Camera_X, 2 = Camera_Y
        Debug_BgAnim_Pad:   u8,     // even-alignment pad for the byte above

        // -----------------------------------------------
        // Live-object mailbox (DEBUG shapes only) — the supported EXTERNAL
        // spawn / move / delete interface
        // -----------------------------------------------
        // The third external mailbox, and deliberately the SAME SHAPE as the warp
        // and boot-override pair above: an external tool writes a request here, the
        // level state's frame-top consumer applies it inside the frame boundary, and
        // the cleared flag is the ack. Full protocol + rationale:
        // docs/ENGINE_ARCHITECTURE.md, "§4.12c The live-object mailbox".
        //
        // THE WRITE ORDER IS THE PROTOCOL, exactly as it is for the other two: the
        // external writer stores the PAYLOAD (Def, X, Y, Slot, Place, Op) and then
        // Obj_Req_Flag LAST. The consumer only reads the payload on a frame where
        // the flag is already nonzero, so a write interrupted part-way is read on a
        // later frame, never half-applied — there is no lock and none is needed.
        //
        // ONE REQUEST PER FRAME, BY CONSTRUCTION. The consumer applies at most one
        // request per frame and clears the flag; a client that wants to place ten
        // objects issues ten request/ack round trips. That is what makes the whole
        // thing lock-free with a single flag.
        //
        // Obj_Req_Status IS NOT THE ACK — the flag is. Status is written on every
        // path BEFORE the flag clears, so it is valid exactly when the flag reads 0,
        // and it distinguishes "applied" from the five refusals. A client that only
        // polls the flag learns that the engine LOOKED at the request, not that it
        // did anything; the refusals are silent otherwise, on purpose (a refused
        // request must never fall back to guessing).
        //
        // RAM TAIL + @shape_divergent, for the same reason the warp cells are: this
        // sits after every existing game var, so the DEBUG-shape addition ripples
        // ZERO addresses (engine RAM does not move at all — this is game RAM chained
        // after Engine_RAM_End) and release carries none of it.
        Obj_Req_Def:    u32,    // SPAWN: ObjDef archetype record (absolute ROM address,
                                //   e.g. the deb2 value of `ObjDef_Solid`). Ignored by
                                //   MOVE/DELETE. Validated even + nonzero + inside the
                                //   cart window + nonzero ObjDef.code_addr.
        // SAME COORDINATE SPACE AS Warp_Req_X/Y, OPPOSITE OUT-OF-RANGE TREATMENT —
        // and the second half is the part a client has to know. The space is
        // identical: integer, flat world PIXELS (SPAWN hands these to Load_Object as
        // its "X/Y position (integer, engine coords)"; MOVE runs them through
        // pixels_to_coord into the 16.16 Sst.x_pos/y_pos). But the WARP path CLAMPS
        // — Warp_Req_X/Y go through clamp_and_publish against Player_Bound_Right /
        // Player_Bound_Bottom and are rewritten in place with where the engine
        // actually put the player — whereas THIS path deliberately does not clamp,
        // does not refuse, and does not publish anything back into X/Y. An
        // out-of-act OBJECT is simply skipped by RunObjects' camera-distance cull
        // (CULL_DISTANCE_X/Y) and does nothing; an out-of-act PLAYER would reach
        // SEC_VOID, which is the whole reason the warp clamps and this does not.
        // CONSEQUENCE FOR A PLACEMENT TOOL: a request outside the act is ACCEPTED,
        // acked with Obj_Req_Status = OBJREQ_OK, and then silently culled — "OK"
        // here means the request was applied, NOT that anything will appear. A tool
        // that wants to refuse such a placement must bound-check it itself, against
        // Level_Width / Level_Height (declared above — NOT against Player_Bound_*,
        // which are inset and would reject legal placements near the right edge).
        Obj_Req_X:      u16,    // SPAWN/MOVE: world X in flat world PIXELS. Ignored by DELETE.
        Obj_Req_Y:      u16,    // SPAWN/MOVE: world Y in flat world PIXELS. Ignored by DELETE.
        Obj_Req_Slot:   u16,    // MOVE/DELETE (in): the target slot handle = low 16 bits
                                //   of its SST address, i.e. exactly what Dynamic_Live
                                //   stores and what oracle's object_list reports.
                                //   SPAWN (out): the engine PUBLISHES the new slot's
                                //   handle here before clearing the flag.
        Obj_Req_Place:  u16,    // SPAWN: Load_Object's placement word — OEF flips in
                                //   bits 13/14, subtype in the low byte. The engine
                                //   masks it to $60FF, so no other bit can do anything.
        Obj_Req_Op:     u8,     // 1 = SPAWN, 2 = MOVE, 3 = DELETE. Anything else is
                                //   refused with status 1. NOT cleared by the ack — it
                                //   stays readable so a watchpoint can see what the last
                                //   request was.
        Obj_Req_Status: u8,     // engine result, valid when the flag reads 0:
                                //   0 OK · 1 bad op · 2 bad ObjDef · 3 pool full
                                //   4 bad slot handle · 5 slot owned by the entity window
        Obj_Req_Flag:   u8,     // 0 = idle / consumed (the ack); nonzero = pending

        // -----------------------------------------------
        // OJZ_Reels demo state (DEBUG shapes only) — EFFECTS-W1 item 10a
        // -----------------------------------------------
        // Independent per-strip ("reel") V-scroll demo. OJZ_Reel_Active gates
        // OJZ_Reels_Fill (games/sonic4/data/effects/ojz_effects.emp), which OVERRIDES
        // Parallax_Vscroll_Column_Buf's BG words for the frame right after
        // Parallax_Update fills it, composing REEL_BAND_COUNT independently-advancing
        // phase accumulators on top of Parallax_Current_Vscroll_BG. There is no hotkey
        // to set it: Debug_BandDemoHotkey's header enumerates every remaining pad chord
        // against this shape and finds none free. tools/reels_witness.py pokes this
        // cell directly instead (band_witness.py's pattern for OJZ_BandDemo).
        //
        // RAM TAIL + @shape_divergent, same reason as the two mailboxes above: chained
        // after every existing game var, so the DEBUG shape grows and release carries
        // none of it.
        OJZ_Reel_Active: u8,                     // 0 = normal parallax fill; nonzero = reels demo live
        OJZ_Reel_Phase:  [u8; REEL_BAND_COUNT],  // per-band phase accumulators (0..255, wraps)
        pad(1),                 // even-alignment pad for the odd byte run above

        // -----------------------------------------------
        // Effects-lab TIER NAME TAGS (DEBUG shapes only) — EFFECTS-W1 F4
        // -----------------------------------------------
        // The owner's ask, in his words: "can we get it to write out what it's
        // supposed to be in oracle like start + left/right does? This way I can
        // relay info back to the agent better." These three cells are what let
        // Debug_TierTags_Update (games/sonic4/test/ojz_scroll_test.emp) paint the
        // RASTER and BG-ANIMATION tiers' names without repainting them every frame.
        //
        // THE TWO `Shown` CELLS ARE MIRRORS, NOT CURSORS, and that is the whole
        // difference between this readout and the three above it. Debug_Scene_Index,
        // Debug_Raster_Index and Debug_Preset_Index are all documented as "a cursor,
        // NOT a mirror of the live channel" — which is exactly why a tag driven off
        // one of them would go stale the moment a section crossing re-installed a
        // preset through Effects_InstallPreset. Each of these holds the ENGINE value
        // the tag currently spells (Raster_Program / BgAnim_Table_Ptr), so the
        // painter's whole liveness test is a long compare against the live cell and
        // the tag cannot disagree with the machine for more than one frame.
        //
        // A DROPPED DMA DELIBERATELY LEAVES THESE UNWRITTEN. The painter queues one
        // Critical entry per glyph cell and bails on the first `dropped` carry
        // without updating the mirror, so the next frame's compare still differs and
        // the whole tag is re-queued. That converts a full DMA queue from "a name
        // with one wrong letter, forever" into "one frame of mixed letters".
        //
        // $FFFFFFFF IS THE ONE POISON VALUE, and it is written exactly once per boot:
        // on the frame the arming flag below latches. Boot clears Work RAM so both
        // mirrors read 0 — and 0 is a LEGAL value of both subjects ("no raster program
        // at all"), so without the poison a reviewer who first reached for the lab
        // while standing in a section that binds no raster program would see the
        // compare match, no tag built, and NOTHING on screen where the answer `NONE`
        // belongs. $FFFFFFFF is safe as the poison because it is neither 0 nor any
        // address in a 4 MB ROM.
        Debug_Raster_Shown: u32,   // the Raster_Program value the raster tag spells
        Debug_BgAnim_Shown: u32,   // the BgAnim_Table_Ptr value the BG-anim tag spells

        // Nonzero once the reviewer has HELD START or C at least once this boot —
        // i.e. once he has reached for the effects lab at all.
        //
        // IT EXISTS TO KEEP EVERY REPLAY FIXTURE AND EVERY BOOT FRAME BYTE-FOR-BYTE.
        // The tags are sprites; building them unconditionally would add two SAT
        // entries to every DEBUG frame from boot, which is precisely what the scene
        // readout's "built on first press, not at level init" rule exists to avoid.
        // Input_Source gates replays out on its own, so this flag is about LIVE
        // boot frames: until it is set, Debug_TierTags_Update reads two bytes and
        // returns, and the sprite table is exactly what it was before this parcel.
        Debug_Tags_Armed:   u8,
        Debug_Tags_Pad:     u8,    // even-alignment pad for the byte above
    }

    mark Game_RAM_End,
}
