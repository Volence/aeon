// -----------------------------------------------
// games.sonic4.sound_ids — the Sonic 4 sound ids + SFX priority ladder
// (SOLE DEFINITION)
//
// This module is the AUTHORITATIVE source of the Sonic 4 sound-id contract: the
// song ids (SND_REQ_MUSIC), the symbolic SFX ids (SND_REQ_SFX; the S3K source
// filenames so the transcoder's SfxTable index matches), the spindash-rev SFX
// special case, and the authored per-SFX priority ladder. Game `.emp` consumers
// read them via `use games.sonic4.sound_ids`; the residual AS and the game-
// AGNOSTIC engine `.emp` modules read them through the ownership-flip export —
// the build harvests every `pub const` here and injects it as a guarded AS `-D`
// define + link EquSym (`harvest_game_constants`, native.rs). So engine `.emp`
// modules that cannot `use` a specific game's module — sound_api's typed
// `SFXID_RING_*`/`SONG_MOVINGTRUCKS` mirrors, boot's `moveq #SONG_MOVINGTRUCKS`,
// sound_api's `assert.w d0, ls, #SONG_COUNT` — resolve against this authority via
// the link seam.
//
// Flipped from AS (config/sound_ids.asm) to `.emp` at conversion-tail Parcel F2
// (census #24). The typed newtype layer (SongId/SfxId) is a pre-ruled language-
// round deferral: the untyped id VALUES live HERE; the typed `: SfxId` /
// `: SongId` mirrors that carry the newtype enforcement stay local to their
// consumers (sound_api / mt_bank), each drift-guarded against this authority.
//
// The SFX BANK counts (SFX_ID_BASE / SFX_COUNT / SFX_TABLE_LEN) are NOT here:
// their authority is games/sonic4/data/sound/sfx/sfx_bank.emp — the module that
// owns the bank they count, where they are DERIVED from the SfxTable rows
// (SfxTable.min_key / .count / .len).

module games.sonic4.sound_ids

use engine.types.{SongId, SfxId}

// -----------------------------------------------
// Song ids (posted to SND_REQ_MUSIC; id 0 = stop, id 1..SONG_COUNT play).
// -----------------------------------------------
// SONG_MOVINGTRUCKS: the NATIVE "Moving Trucks" (B&R) port — a real sequencer
// playback of the song data (6 FM channels, DAC off). Its song + per-song pitch
// table + FmPatch bank form one bank-aligned 32KB streaming block.
pub const SONG_MOVINGTRUCKS : SongId = 1
// SONG_DRUMTEST: a DEBUG STREAM DAC-on song that fires $E2 kick/snare from the
// shared DAC bank while FM/PSG music streams — the integrated per-frame-bank-swap
// proof. Co-located in Moving Trucks' bank. DEBUG-only in use (fired only from
// game_debug, a Config-A module); the id value is unconditional here.
pub const SONG_DRUMTEST : SongId = 2
// SONG_HCZ2: the S3K Hydrocity Zone Act 2 import — a faithful native sequencer
// playback (9 channels, STREAM). Co-located in Moving Trucks' bank. DEBUG-only in
// use; the id value is unconditional here.
pub const SONG_HCZ2 : SongId = 3

// SONG_COUNT — number of songs in SongTable (id 1..SONG_COUNT; id 0 = stop). A
// bound, not a song id (stays a raw count). Shape-dependent: DEBUG adds DrumTest
// + HCZ2. sound_api's DEBUG song-id bounds assert reads it cross-seam (via the
// harvest EquSym) on BOTH the .asm-residual and .emp sides; mt_bank sizes
// SongTable/SongPatchTable by it.
pub const SONG_COUNT         = if DEBUG == 1 { 3 } else { 1 }   // MovingTrucks (+ DrumTest + HCZ2 in DEBUG)
ensure(SONG_COUNT < $FF, "SONG_COUNT must be < $FF ($FF is the stop sentinel)")

// -----------------------------------------------
// Symbolic SFX ids (posted to SND_REQ_SFX, disjoint from song ids).
// -----------------------------------------------
// Values are the S3K source filenames so the transcoder's SfxTable index matches
// (id -> SfxTable[id - SFX_ID_BASE] inside the contiguous SFX-id range).
pub const SFXID_RING_RIGHT : SfxId = $33
pub const SFXID_RING_LEFT  : SfxId = $34
pub const SFXID_DEATH      : SfxId = $35
pub const SFXID_SKID       : SfxId = $36
pub const SFXID_ROLL       : SfxId = $3C
pub const SFXID_JUMP       : SfxId = $62
pub const SFXID_SPINDASH   : SfxId = $AB
pub const SFXID_DASH       : SfxId = $B6
pub const SFXID_RINGLOSS   : SfxId = $B9

// SFXID_REV_LOOP — spindash-rev special case (Sfx_Frame's rev-loop retrigger).
// -1 = feature off (games without a spindash). Aliases the spindash id.
pub const SFXID_REV_LOOP   : SfxId = SFXID_SPINDASH

// -----------------------------------------------
// Per-SFX priority tiers (authored; S3K has none). Higher = wins.
// -----------------------------------------------
// Seeded from S2 zSFXPriority for shared sounds: death/hurt > spindash > skid/roll
// > jump > ring/UI. The transcoder bakes a priority byte into each SfxHeader keyed
// by id; these tiers are the source of that map (mirrored in tools/sfx_transcode.py).
// 7-BIT SCALE ($00-$7F): bit 7 of sfh_priority is RESERVED as the non-latching flag
// (plays but never latches the floor; Sfx_BeginSound masks it off for arbitration).
// Only relative ordering matters (all compares are `cp`), so these values carry rank
// only — keep them spaced and strictly < $80.
pub const SFXPRI_RING     = $10    // ring/UI — lowest; never ducks (authored sfh_duck = 0)
pub const SFXPRI_JUMP     = $20
pub const SFXPRI_ROLL     = $30
pub const SFXPRI_SKID     = $30
pub const SFXPRI_SPINDASH = $40
pub const SFXPRI_DASH     = $40
pub const SFXPRI_DEATH    = $60    // death/ring-loss — highest
pub const SFXPRI_RINGLOSS = $60

// Guard: every priority tier MUST fit in 7 bits so bit 7 stays free as the
// non-latching flag (and stays non-negative under signed compares). Mirrored by a
// test in tools/sfx_transcode.py.
ensure(((SFXPRI_RING | SFXPRI_JUMP | SFXPRI_ROLL | SFXPRI_SKID | SFXPRI_SPINDASH | SFXPRI_DASH | SFXPRI_DEATH | SFXPRI_RINGLOSS) & $80) == 0,
       "an SFXPRI_* tier has bit 7 set — priorities must be 7-bit ($00-$7F); bit 7 is the non-latching flag")
