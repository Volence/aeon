// Test emitter — spawns particles at a fixed interval.
// Placed in the test scene to demonstrate effect pool lifecycle.
module games.sonic4.test_emitter in test_emitter

use engine.objects.sst.{Sst}
use engine.objects.children.{SpawnDesc}
use engine.constants.{RF_COORDMODE, RF_PRIORITY_SHIFT}
use engine.objects.objdef.{vram_art}
use games.sonic4.constants.{VRAM_TEST_OBJ}
use games.sonic4.test_helpers.{EmitterV, test_obj_prolog}

// The spliced test_obj_prolog body resolves vram_art, VRAM_TEST_OBJ, and the
// RF_* bits in THIS module's scope (a comptime fn body resolves its free names
// at the splice site), so those imports stay here.

const EMITTER_INTERVAL = 30             // frames between spawns

// -----------------------------------------------
// TestEmitter — set up emitter (called as first-frame code_addr)
// In:  a0 = SST pointer (position set by spawn list)
// Clobbers: d0-d3, a1-a2 — the whole-object set (falls into Main below, whose
//   contract is CreateEffect_Normal(d0-d2/a1-a2) ∪ Draw_Sprite(d0-d3/a1)).
// -----------------------------------------------
pub proc TestEmitter (a0: *Sst) clobbers(d0-d3/a1-a2) falls_into TestEmitter_Main {
        test_obj_prolog(prio: 5, w: 16, h: 16, coordmode: true)  // frame 1 (color 2 square)
        move.w  #EMITTER_INTERVAL, EmitterV.timer(a0)
        move.w  #TestEmitter_Main - ObjCodeBase, code_addr(a0)
}

// -----------------------------------------------
// TestEmitter_Main — per-frame: countdown, spawn particle, draw self
// In:  a0 = SST pointer
// Clobbers: d0-d3, a1-a2 — CreateEffect_Normal(d0-d2/a1-a2) ∪ Draw_Sprite(d0-d3/a1).
// -----------------------------------------------
pub proc TestEmitter_Main (a0: *Sst) clobbers(d0-d3/a1-a2) {
        subq.w  #1, EmitterV.timer(a0)
        bne     .draw

        // Timer expired — spawn particle (particle sets its own velocity)
        move.w  #EMITTER_INTERVAL, EmitterV.timer(a0)
        lea     emitter_particle_desc(pc), a1
        jbsr    CreateEffect_Normal

.draw:
        jbra    Draw_Sprite
}

// Descriptor: one particle at emitter position (0,0 offset), then the zero-word
// terminator the CreateEffect_Normal walk stops on (children.emp's SpawnDesc).
data emitter_particle_desc: SpawnDesc = SpawnDesc {
        code:  extern("TestParticle") - extern("ObjCodeBase"),
        x_off: 0,
        y_off: 0,
}
// ADJACENCY-CRITICAL: this terminator must emit IMMEDIATELY after
// emitter_particle_desc (the CreateEffect_Normal walk reads records until this
// zero code word). Nothing may be declared between them — source-order layout is
// the only coupling. A `table` sentinel-record-list would fold this in (ledgered).
data emitter_particle_term: u16 = 0
