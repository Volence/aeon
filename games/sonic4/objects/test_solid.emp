// Test solid block — static platform with COLLISION_SOLID response
// Base fields set by Load_Object from ObjDef_Solid.
// Uses subtype as mapping_frame selector.
module games.sonic4.test_solid in test_solid

use engine.objects.sst.{Sst}

// The dispatch-store value: this object's Main routine as an offset from the
// object-code-bank base (engine.inc's ObjCodeBase — objroutine in the AS
// twin). `pub proc` labels export unmangled, so the module's own Main comes
// back through the shared link; the difference rides a `.w` link-time
// immediate. NOTE: equ names also land in the shared link namespace
// unmangled, so the alias carries the object's name to stay collision-free
// against its sibling modules.
equ SOLID_ROUTINE_MAIN = extern("TestSolid_Main") - extern("ObjCodeBase")

// -----------------------------------------------
// TestSolid_Init — set mapping frame from subtype
// In:  a0 = SST pointer (base fields set by Load_Object)
// -----------------------------------------------
pub proc TestSolid_Init (a0: *Sst) clobbers() falls_into TestSolid_Main {
        move.b  subtype(a0), mapping_frame(a0)
        move.w  #SOLID_ROUTINE_MAIN, code_addr(a0)
}

// -----------------------------------------------
// TestSolid_Main — display-only (collision handled by TouchResponse)
// In:  a0 = SST pointer
// Clobbers: d0-d3, a1 (Draw_Sprite's set — tail call)
// -----------------------------------------------
pub proc TestSolid_Main (a0: *Sst) {
        jbra    Draw_Sprite
}
