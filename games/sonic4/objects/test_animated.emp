// Test object — animated Sonic walk cycle with DPLC art streaming.
module games.sonic4.test_animated in test_animated

use engine.objects.sst.{Sst}
use engine.constants.{RF_PRIORITY_SHIFT}
use engine.objects.objdef.{vram_art, vram_bytes}
use engine.types.{VramTile}

// VRAM_TEST_SONIC — tile 960, character DPLC region (up to 25 tiles). A
// game-config value, imported from games.sonic4.constants below.
use games.sonic4.constants.{VRAM_TEST_SONIC}

// DplcV — the per-object DPLC state, overlaying sst_custom. This module owns the
// overlay now (test_player.asm's shared DplcV struct, the former drift target, is
// deleted); test_player.emp's TPlayerV carries the byte-identical dplc_ptr/art_base
// prefix ($2E/$32). The overlay's always-on window-overflow check subsumes the AS
// `objvarsCheck`.
vars DplcV: Sst.sst_custom {
        dplc_ptr: u32,                  // DPLC table pointer (ROM)
        art_base: u32,                  // uncompressed art base (ROM)
}

// -----------------------------------------------
// TestAnimated — init routine
// In:  a0 = SST pointer (slot already allocated)
// Clobbers: d0-d4, a1-a3 — falls into TestAnimated_Main (its whole set).
// -----------------------------------------------
pub proc TestAnimated (a0: *Sst) clobbers(d0-d4/a1-a3) falls_into TestAnimated_Main {
        move.l  #Map_Sonic, mappings(a0)
        move.w  #vram_art(VRAM_TEST_SONIC), art_tile(a0)
        move.l  #Ani_Sonic, anim_table(a0)
        move.l  #DPLC_Sonic, DplcV.dplc_ptr(a0)
        move.l  #Art_Sonic, DplcV.art_base(a0)
        move.b  #0, anim(a0)
        move.b  #$FF, prev_anim(a0)
        move.b  #$FF, prev_frame(a0)
        ori.b   #4<<RF_PRIORITY_SHIFT, render_flags(a0)
        move.w  #TestAnimated_Main - ObjCodeBase, code_addr(a0)
}

// -----------------------------------------------
// TestAnimated_Main — per-frame update
// In:  a0 = SST pointer
// Clobbers: d0-d4, a1-a3
// -----------------------------------------------
pub proc TestAnimated_Main (a0: *Sst) clobbers(d0-d4/a1-a3) {
        jbsr    AnimateSprite

        movea.l DplcV.dplc_ptr(a0), a2
        movea.l DplcV.art_base(a0), a3
        move.w  #vram_bytes(VRAM_TEST_SONIC), d1
        jbsr    Perform_DPLC

        jbra    Draw_Sprite
}
