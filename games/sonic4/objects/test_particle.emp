// Test particle — short-lived effect with velocity + gravity + auto-despawn
// Allocated from effect pool by emitters via CreateEffect_Normal/Simple.
// Sets its own velocity on init — emitter only controls spawn position.
module games.sonic4.test_particle in test_particle

use engine.objects.sst.{Sst, set_priority_band}
use engine.constants.{RF_COORDMODE, RF_PRIORITY_SHIFT, RF_PRIORITY_MASK}

const PARTICLE_GRAVITY = $20            // lighter than player gravity ($38)
const PARTICLE_X_VEL   = -$100          // initial horizontal velocity (leftward)
const PARTICLE_Y_VEL   = -$300          // initial vertical velocity (upward)

// Cross-seam link value: the animation table (games/sonic4/data/animations/
// particle_anims.emp — a `.l` link-time immediate). The dispatch-store offset
// (`TestParticle_Main - ObjCodeBase`, a `.w` one) is now written inline as a
// bare label difference at its store site below (C1 item 1).
equ ANI_PARTICLE          = extern("Ani_Particle")

// -----------------------------------------------
// TestParticle — init routine (called as first-frame code_addr)
// In:  a0 = SST pointer (position, mappings, art_tile set by CreateEffect)
// (clobbers is the whole-object set: the init frame falls into Main below)
// -----------------------------------------------
pub proc TestParticle (a0: *Sst) clobbers(d0-d3/a1-a2) falls_into TestParticle_Main {
        move.l  #ANI_PARTICLE, anim_table(a0)
        clr.b   anim(a0)                        // anim 0: flash
        move.b  #$FF, prev_anim(a0)
        move.b  #$FF, prev_frame(a0)
        set_priority_band(6)                    // C1c: the band-5-emitter union bug's own site
        move.b  #8, width_pixels(a0)
        move.b  #8, height_pixels(a0)
        bset    #RF_COORDMODE, render_flags(a0) // screen coords (no camera)
        move.w  #PARTICLE_X_VEL, x_vel(a0)
        move.w  #PARTICLE_Y_VEL, y_vel(a0)
        move.w  #TestParticle_Main - ObjCodeBase, code_addr(a0)
}

// -----------------------------------------------
// TestParticle_Main — per-frame update
// In:  a0 = SST pointer
// Clobbers: d0-d3, a1-a2 — the EXACT callee union:
//   ObjectMove(d0) ∪ AnimateSprite(d0-d2/a1-a2) ∪ Draw_Sprite(d0-d3/a1). The old
//   d0-d4/a1-a3 over-declared d4/a3 while claiming to be the union.
// -----------------------------------------------
pub proc TestParticle_Main (a0: *Sst) clobbers(d0-d3/a1-a2) preserves(a0) {
        // Apply gravity (read-modify-write — no register round-trip)
        addi.w  #PARTICLE_GRAVITY, y_vel(a0)

        // Move
        jbsr    ObjectMove

        // Animate (AF_DELETE handles despawn)
        jbsr    AnimateSprite

        // Draw
        jbra    Draw_Sprite
}
