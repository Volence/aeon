// Test parent — spawns 3 orbiting children, oscillates horizontally for
// PARENT_LIFETIME frames, then self-destructs (DeleteChildren + DeleteObject),
// freeing its children. Demonstrates CreateChild_Normal spawning, child
// orbit-follow via stored state, and the parent-lifecycle cascade. The life
// countdown (life_timer) is independent of the swing-phase counter (swing_phase),
// so it reaches 0 on schedule and the cascade fires (see TestParent_Main).
module games.sonic4.test_parent in test_parent

use engine.objects.sst.{Sst}
use engine.objects.children.{SpawnDesc}
use engine.constants.{RF_COORDMODE, RF_PRIORITY_SHIFT, RF_MULTISPRITE}
use engine.objects.objdef.{vram_art}
use engine.types.{VramTile, Angle}

// VRAM_TEST_OBJ — tile 992, test object art (8 tiles). A game-config value,
// imported from games.sonic4.constants below.
use games.sonic4.constants.{VRAM_TEST_OBJ}

// The spliced test_obj_prolog body resolves vram_art, VRAM_TEST_OBJ, and the
// RF_* bits in THIS module's scope (a comptime fn body resolves its free names
// at the splice site), so those imports stay above.
use games.sonic4.test_helpers.{test_obj_prolog}

const PARENT_LIFETIME      = 180        // frames before self-destruct (3 seconds)
const PARENT_SWING_PERIOD  = 180        // swing-phase counter start/reset (must exceed 2*PARENT_SWING_RANGE)
const PARENT_SPEED         = 1          // px/frame swing rate
const PARENT_SWING_RANGE   = 60         // pixels each side from start
const CHILD_ORBIT_SPEED    = 4          // angle units per frame (4 = ~90 deg/sec)
const CHILD_ORBIT_RADIUS   = 32         // pixels

// TParentV — the parent's per-object state, overlaying sst_custom. The overlay's
// always-on window-overflow check subsumes the AS `objvarsCheck`.
vars TParentV: Sst.sst_custom {
        life_timer:  u16,               // pure countdown to self-destruct
        swing_phase: u16,               // oscillation phase counter (decoupled from life)
        x_dir:       u8,                // 0 = right, 1 = left
}

// TOrbitChildV — the child's per-object state, overlaying the SAME sst_custom
// region with different fields (the child never coexists with the parent state
// in one slot). Its window-overflow check subsumes the AS `objvarsCheck`.
vars TOrbitChildV: Sst.sst_custom {
        orbit_angle:  u8,               // current orbit angle (0-255) — `orbit_`
                                        // prefixed: a bare `angle` overlay field
                                        // would shadow Sst's direct `angle`
        phase_offset: u8,               // initial phase (per-child)
        radius:       u16,              // orbit radius in pixels
}

// -----------------------------------------------
// TestChildPart — child init: derive starting angle from spawn offset, then
// fall into the orbit loop. Children orbit the parent at fixed radius, phase-
// offset 120 deg apart so they form an equilateral triangle.
// In:  a0 = SST pointer (position, mappings, art_tile set by CreateChild_Normal)
// Clobbers: d0-d3, a1 — its own d0-d2/a1 ∪ the orbit loop it falls into below.
// -----------------------------------------------
pub proc TestChildPart (a0: *Sst) clobbers(d0-d3/a1) falls_into TestChildPart_Main {
        ori.b   #3<<RF_PRIORITY_SHIFT, render_flags(a0)
        move.b  #16, width_pixels(a0)
        move.b  #16, height_pixels(a0)
        bset    #RF_COORDMODE, render_flags(a0)

        // Derive initial phase from spawn offset. CreateChild_Normal places us at
        // parent.pos + (x_off, y_off):
        //   left:  (-24,   0) -> angle 192 (270 deg / -X axis)
        //   right: ( 24,   0) -> angle  64 (90 deg / +X axis)
        //   above: (  0, -24) -> angle   0 (0 deg / -Y axis upward)
        // The sign of (dx, dy) picks the 90-deg quadrant.
        movea.w parent_ptr(a0), a1
        move.w  x_pos(a0), d1
        sub.w   Sst.x_pos(a1), d1                   // d1 = signed dx
        move.w  y_pos(a0), d2
        sub.w   Sst.y_pos(a1), d2                   // d2 = signed dy

        // Angle byte: 0=up, 64=right, 128=down, 192=left.
        moveq   #0, d0                          // default: above (-Y)
        tst.w   d2
        bmi     .save_angle                     // dy negative -> above -> keep 0
        tst.w   d1
        bmi     .set_left
        moveq   #64, d0                         // right (+X)
        jbra    .save_angle
.set_left:
        move.w  #192, d0                        // left (-X)
.save_angle:
        move.b  d0, TOrbitChildV.phase_offset(a0)
        move.b  d0, TOrbitChildV.orbit_angle(a0)
        move.w  #CHILD_ORBIT_RADIUS, TOrbitChildV.radius(a0)

        move.w  #TestChildPart_Main - ObjCodeBase, code_addr(a0)
}

// -----------------------------------------------
// TestChildPart_Main — orbit parent each frame
// (Draw_Sprite early-returns because parent has RF_MULTISPRITE; the sibling walk
//  in Render_Sprites picks up our updated x_pos/y_pos.)
// In:  a0 = SST pointer
// Clobbers: d0-d3, a1 — the tail Draw_Sprite set (d0-d3/a1); the orphan path is
//   DeleteObject (d0-d1). GetSineCosine preserves everything but its d0/d1 out.
// -----------------------------------------------
pub proc TestChildPart_Main (a0: *Sst) clobbers(d0-d3/a1) {
        movea.w parent_ptr(a0), a1
        move.l  a1, d0
        beq     .orphan_delete

        // Advance angle. The byte add wraps mod 256, so its result IS the 0-255
        // value GetSineCosine reads -> born Angle here for its typed d0 slot
        // (GetSineCosine's own leading `andi.w #$FF` clears any residual high-word
        // bits, so no caller-side mask is needed).
        move.b  TOrbitChildV.orbit_angle(a0), d0
        addq.b  #CHILD_ORBIT_SPEED, d0 as Angle
        move.b  d0, TOrbitChildV.orbit_angle(a0)

        // sin/cos at d0 -> d0=sin*$100, d1=cos*$100. No register save around the
        // call: GetSineCosine's contract is `clobbers()` (it preserves everything
        // but its d0/d1 outputs), so a1 survives it and d2-d3 are dead here anyway.
        jbsr    GetSineCosine

        // Scale: sine amplitude = $100 = 256, radius = 32 = 2^5.
        // offset = (sin * 32) / 256 = sin >> 3. Constant shift, no multiply.
        // (Stored radius is informational; the shift is hard-coded.)
        // Negate cos so angle 0 puts the child above parent (screen -Y is up).
        asr.w   #3, d0                          // d0.w = scaled X offset
        neg.w   d1
        asr.w   #3, d1                          // d1.w = scaled Y offset

        // Apply: child.pos = parent.pos + (dx, dy)
        add.w   Sst.x_pos(a1), d0
        move.w  d0, x_pos(a0)
        add.w   Sst.y_pos(a1), d1
        move.w  d1, y_pos(a0)

        jbra    Draw_Sprite

.orphan_delete:
        jbra    DeleteObject
}

// -----------------------------------------------
// TestParent — init routine: set up the parent, spawn 3 children, advance to the
// per-frame code. Branches over the child descriptor table to TestParent_Main.
// In:  a0 = SST pointer
// Clobbers: d0-d3, a1-a2 — CreateChild_Normal(d0-d3/a1-a2) ∪ the Main it branches to.
// -----------------------------------------------
pub proc TestParent (a0: *Sst) clobbers(d0-d3/a1-a2) {
        test_obj_prolog(prio: 3, w: 16, h: 16, coordmode: true, frame: 0)  // frame 0 (color 1 square)
        bset    #RF_MULTISPRITE, render_flags(a0)       // batched render
        move.w  #PARENT_LIFETIME, TParentV.life_timer(a0)
        move.w  #PARENT_SWING_PERIOD, TParentV.swing_phase(a0)

        // Spawn 3 children around parent
        lea     child_desc(pc), a1
        jbsr    CreateChild_Normal

        move.w  #TestParent_Main - ObjCodeBase, code_addr(a0)
        jbra    TestParent_Main
}

// Child descriptor: 3 children at offsets around parent, then the zero-word
// terminator the CreateChild_Normal walk stops on (children.emp's SpawnDesc).
data child_desc: [SpawnDesc; 3] = [
        SpawnDesc { code: extern("TestChildPart") - extern("ObjCodeBase"), x_off: -24, y_off:   0 },  // left of parent
        SpawnDesc { code: extern("TestChildPart") - extern("ObjCodeBase"), x_off:  24, y_off:   0 },  // right of parent
        SpawnDesc { code: extern("TestChildPart") - extern("ObjCodeBase"), x_off:   0, y_off: -24 },  // above parent
]
// ADJACENCY-CRITICAL: this terminator must emit IMMEDIATELY after child_desc (the
// walk reads records until it hits this zero code word). Nothing may be declared
// between them — source-order layout is the only thing coupling them today. A
// `table` sentinel-record-list would fold this in (gap-ledger, deferred).
data child_desc_term: u16 = 0

// -----------------------------------------------
// TestParent_Main — per-frame: count the life timer down and oscillate X.
// The self-destruct branch fires when life_timer reaches 0: the life countdown is
// a pure timer, independent of swing_phase (the oscillation counter), so it
// reaches 0 on schedule and the DeleteChildren + DeleteObject cascade runs,
// freeing the children.
// In:  a0 = SST pointer
// Clobbers: d0-d3, a1 — DeleteChildren(d0-d2/a1) ∪ Draw_Sprite(d0-d3/a1); the
//   delete tail is DeleteObject(d0-d1). (a2 is never touched here.)
// -----------------------------------------------
pub proc TestParent_Main (a0: *Sst) clobbers(d0-d3/a1) {
        subq.w  #1, TParentV.life_timer(a0)
        bne     .move

        // Self-destruct: kill children, then self.
        jbsr    DeleteChildren
        jbra    DeleteObject

.move:
        // Oscillate parent X. swing_phase is the phase counter (separate from the
        // life countdown above). x_dir: 0 = right, 1 = left.
        subq.w  #1, TParentV.swing_phase(a0)
        tst.b   TParentV.x_dir(a0)
        bne     .moving_left
        addq.w  #PARENT_SPEED, x_pos(a0)
        move.w  TParentV.swing_phase(a0), d0
        cmpi.w  #PARENT_SWING_PERIOD-PARENT_SWING_RANGE, d0
        bge     .draw
        move.b  #1, TParentV.x_dir(a0)
        jbra    .draw

.moving_left:
        subq.w  #PARENT_SPEED, x_pos(a0)
        move.w  TParentV.swing_phase(a0), d0
        cmpi.w  #PARENT_SWING_PERIOD-(2*PARENT_SWING_RANGE), d0
        bge     .draw
        move.b  #0, TParentV.x_dir(a0)
        // reset phase: bump the swing counter back so we swing right again
        move.w  #PARENT_SWING_PERIOD, TParentV.swing_phase(a0)

.draw:
        jbra    Draw_Sprite
}
