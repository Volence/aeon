// Dynamic-pool churn stressor — A2 mid-walk-compact soak vehicle.
//
// TestChurnObj is a self-replacing dynamic-pool object: each lives a short,
// staggered lifetime, then on expiry allocs a REPLACEMENT dynamic child
// (AllocDynamic, code_addr set immediately per the AllocDynamic caller
// invariant) and deletes ITSELF. Deletes zero their live-list entry but leave
// Dynamic_Live_Count unchanged until frame-end compaction, so a saturated pool
// (GameState_ObjectTestChurn spawns exactly NUM_DYNAMIC of these) rides
// Dynamic_Live_Count == NUM_DYNAMIC across a frame while deletions free stack
// slots mid-walk. When two churners expire in the same RunObjects .run_culled
// walk: the first's alloc finds the free stack empty (saturated) and fails, but
// its self-delete frees a slot; the second's alloc then finds count==NUM_DYNAMIC
// WITH a free slot -> AllocDynamic runs CompactDynamicLive mid-dispatch, the
// exact A2 precondition. In a DEBUG build the Dynamic_Live_Walking rail asserts.
module games.sonic4.test_churn in test_churn

use engine.objects.sst.{Sst}
use engine.constants.{COLLISION_TOUCH, RF_PRIORITY_SHIFT, RF_PRIORITY_MASK}
use engine.objects.objdef.{vram_art}
use games.sonic4.constants.{VRAM_TEST_OBJ}
use games.sonic4.test_helpers.{test_obj_prolog}

// The spliced test_obj_prolog body resolves vram_art, VRAM_TEST_OBJ, and
// RF_PRIORITY_SHIFT/RF_PRIORITY_MASK (via its set_priority_band splice) in THIS
// module's scope (a comptime fn body resolves its free names at the splice
// site), so those imports stay here.

const CHURN_MIN_LIFE = 4                // shortest lifetime (frames)
const CHURN_SPREAD   = 8                // lifetime stagger range (power of two)

// TChurnV — the per-object churn state, overlaying sst_custom. The overlay's
// always-on window-overflow check subsumes the AS `objvarsCheck`.
vars TChurnV: Sst.sst_custom {
        life: u16,                      // countdown to self-replace + delete
}

// -----------------------------------------------
// TestChurnObj — init (also the replacement code_addr)
// In:  a0 = SST pointer (slot allocated, x/y_pos already set by spawner)
// Clobbers: d0-d3, a1 — the whole-object set: init writes d0-d1 (lifetime
//   calc) + d2/a1 (the prolog's RefreshSpritePieceCount) and falls into Main,
//   whose contract is AllocDynamic(d0/a1) ∪ DeleteObject(d0-d1/a1) ∪ Draw_Sprite(d0-d3/a1).
// -----------------------------------------------
pub proc TestChurnObj (a0: *Sst) clobbers(d0-d3/a1) falls_into TestChurnObj_Main {
        test_obj_prolog(prio: 4, w: 16, h: 16, coordmode: false)
        // (piece count + frame_off cached by the prolog's refresh — the former
        // manual PopulateSpawnedPieceCount here was made redundant by it)
        move.b  #COLLISION_TOUCH, collision_resp(a0)   // TouchResponse work, non-lethal
        // Staggered lifetime = MIN + ((Frame_Counter + slot>>3) & (SPREAD-1)).
        // slot term spreads the initial batch across positions; Frame_Counter
        // term spreads successive replacement generations -> steady expiry.
        move.w  Frame_Counter, d0
        move.w  a0, d1
        lsr.w   #3, d1
        add.w   d1, d0
        andi.w  #CHURN_SPREAD-1, d0
        addi.w  #CHURN_MIN_LIFE, d0
        move.w  d0, TChurnV.life(a0)
        move.w  #TestChurnObj_Main - ObjCodeBase, code_addr(a0)
        // fall through to Main for first frame
}

// -----------------------------------------------
// TestChurnObj_Main — per-frame: countdown; on expiry replace + self-delete
// In:  a0 = SST pointer
// Out: none  (a0/d7 preserved for the RunObjects loop contract)
// Clobbers: d0-d3, a1 — AllocDynamic(d0/a1) ∪ DeleteObject(d0-d1/a1) ∪
//   Draw_Sprite(d0-d3/a1). Main never writes a2 (only the init frame does).
// a0 is net-PRESERVED (the ObjRoutine dispatch contract preserves(a0, d7)): the
// expiry path stack-saves self, restores it (pop), and self-deletes via
// DeleteObject (which itself preserves a0) before rts, so a0 exits == entry. The
// per-file byte gate cannot see DeleteObject's contract, so it DEFERS the
// trailing-call proof to the corpus closure, which credits DeleteObject's
// verified preserves(a0) through the callee-preserves oracle (§5).
// -----------------------------------------------
pub proc TestChurnObj_Main (a0: *Sst) clobbers(d0-d3/a1) preserves(a0) {
        subq.w  #1, TChurnV.life(a0)
        bne     .draw                   // still alive — draw

        // Expired: alloc a replacement (code_addr set immediately), then
        // delete self unconditionally (self-delete frees the stack slot a
        // sibling's replacement alloc consumes mid-walk).
        move.l  a0, -(sp)               // save self
        jbsr    AllocDynamic
        bne     .no_replace             // free stack empty (saturated) — skip
        move.w  #TestChurnObj - ObjCodeBase, Sst.code_addr(a1)  // invariant: set before any next alloc
        movea.l (sp), a0                // reload self for position inherit
        move.l  x_pos(a0), Sst.x_pos(a1)
        move.l  y_pos(a0), Sst.y_pos(a1)
.no_replace:
        movea.l (sp)+, a0               // restore self
        jbsr    DeleteObject            // self-delete (a0) — zeros entry, frees slot, sets dirty
        rts                             // SST now zeroed — do NOT draw

.draw:
        jbra    Draw_Sprite
}
