// games/sonic4/test/scene_equiv_proof.emp — THE SCENE EQUIVALENCE WITNESS.
//
// PERMANENT. Not a migration tick (spec docs/superpowers/specs/2026-08-17-scanline-services-design.md
// §8.1, "Lifetime (swept)"): a word-equality-pinned witness stays in the sonic4 test lane
// FOREVER, as the standing proof that the zero-capability lowering path still emits legacy
// bytes after P2/P3 interleave their capability conditionals into it. Deleting this module
// is a spec change, not a cleanup.
//
// WHAT IT PROVES. For each of the twenty shipped scenes: the authored scene model, lowered
// through engine/level/scene_dsl.emp's `scene_hdr()` / `scene_band()`, produces FIELD FOR
// FIELD the same `parallax_config` header and `band_entry` bands that
// games/sonic4/data/parallax/configs.emp's shipped `hdr()` / `cfg_band()` constructors
// produce from the shipped parameters. Plus the six deform tables, array-element-wise.
//
// IT IS A COMPTIME VALUE PROOF, NOT A BYTE COMPARISON. It compares struct values during
// elaboration; nothing here reads a ROM offset, and it cannot: this module emits zero
// bytes. Whole-image byte identity across the four shapes is a DIFFERENT gate (Task 10,
// the repin + `refreeze --freeze NAME --ab REF` ritual) and neither gate substitutes for
// the other — this one names the fixture and the field, that one covers packing, padding
// and placement.
//
// THE ORACLE IS A TRANSCRIPTION, AND THAT IS THE ONE THING TO KNOW BEFORE TRUSTING IT.
// Every `hdr(...)` / `cfg_band(...)` call below is a HAND COPY of the corresponding call
// in configs.emp, with that file's own line number cited beside it. The CONSTRUCTORS are
// imported (one definition, two consumers — a stale copy of the packing rules is
// impossible), but the ARGUMENTS are typed here. So this module proves
// "scene model == the shipped parameters as transcribed here"; the remaining link,
// "as transcribed here == what configs.emp actually holds", is what Task 10's byte
// identity closes. The plan's roster table was WRONG FOUR TIMES over these same values,
// which is exactly why every argument below was read off configs.emp and not off a table.
//
// REACHABILITY — READ THIS BEFORE EDITING ANY `use` LINE IN THIS FILE OR IN
// games/sonic4/test/ojz_scroll_test.emp. An .emp module that nothing reaches gets parse +
// scan coverage and ZERO body elaboration: `ensure(1 == 0)` in an unreached module builds
// GREEN with an unchanged CRC (measured, Task 3). Placement is the sigil registry — a Rust
// list in sigil crates/sigil-harness/src/native.rs — which only carries byte-emitting
// modules, and this module emits nothing, so it must never take a registry row. Its
// reachability is therefore ONE `use games.sonic4.scene_equiv_proof` edge out of
// ojz_scroll_test.emp, the game's one PLACED test-lane module. Cut that edge and every
// ensure below dies silently.
//
// TWO INDEPENDENT CONFIRMATIONS THAT IT IS ALIVE, both recorded because a witness nobody
// re-checks is how the dead-guard failure happens twice:
//   1. RED-FIRST, on a plain `DEBUG=1 ./build.sh` (not `--extra-entry`, which is the
//      expect-fail lane's per-poison invocation and would leave this module dark on a
//      normal build). Task 7 flipped one expected field in each of four different proofs
//      — Scene_OJZ_Default's header v_center, Scene_Haze_Uniform's band-0 dsa,
//      Scene_Rocking_Fast's header V-deform shift, Scene_SkyHaze's band-1 deform shift —
//      and the build FAILED each time, naming the config, the band and the field index.
//   2. sigil's `[module.unreachable]` warning enumerates every module outside the
//      profile's use closure AND counts its dead ensures. This module does not appear in
//      that list; check with `SIGIL_WARNINGS=full DEBUG=1 ./build.sh`. (Necessary, not
//      sufficient — it proves the closure, not that any particular ensure ran, which is
//      what (1) is for.)
//
// GLOB IMPORTS ARE MANDATORY for scene_dsl (its bodies' free names resolve at THIS call
// site and it is not a sigil COMPTIME_HELPER); the `use games.sonic4.ojz_scenes.*` glob
// re-evaluates that module's const initializers HERE, which is what makes the six
// `SceneSrc_DeformTable_*` comparisons below see ojz_scenes' own generator arguments.
module games.sonic4.scene_equiv_proof

use engine.structs.{parallax_config}
use engine.parallax.{band_entry}
// Named for the two `hdr()` guards that fire inside the ORACLE's body when it is called
// from here: a comptime fn's free names resolve at the call site. Both modules are sigil
// COMPTIME_HELPERS (so these would also arrive glob-injected), and both are named anyway —
// the resolution of a called body's constants is a silent-degrade axis, never a loud one.
use engine.constants.{MAX_PARALLAX_BANDS, PARALLAX_ANCHOR_NONE}
use engine.effects.raster_dsl.{RASTER_MAX_PATCH}
use engine.level.scene_dsl.*
use engine.level.parallax_dsl.*
// The twenty authored scenes + the six table source arrays (Task 6).
use games.sonic4.ojz_scenes.*
// THE ORACLE. A name list, not a glob, and `cfg_band` rather than `band`: a glob here
// collides with `engine.effects.raster_dsl.band` (glob-injected into every module by the
// harness), and .emp has no `as` alias, so configs.emp's constructor carries the
// disambiguating name. Task 9 MOVES these two functions into this file.
use games.sonic4.parallax_configs.{hdr, cfg_band}

// =====================================================================
// CFG FIELD INDEX — what a header failure message's number means. The order is
// engine/structs.emp's `parallax_config` declaration order (which is also its byte order).
//
//   0 pcfg_band_count          6 pcfg_transition         12 pcfg_v_deform_table_bg
//   1 pcfg_v_factor_bg         7 pcfg_deform_speed_fg    13 pcfg_v_deform_speed_bg
//   2 pcfg_v_factor_fg         8 pcfg_deform_speed_bg    14 pcfg_v_deform_shift_bg
//   3 pcfg_layer_mask          9 pcfg_anchor_ch          15 pcfg_anchor_dsa
//   4 pcfg_v_center_y         10 pcfg_deform_table_fg    16 pcfg_anchor_dsb
//   5 pcfg_v_offset           11 pcfg_deform_table_bg
//
// BAND FIELD INDEX — the same for `band_entry` (engine/level/parallax.emp).
//
//   0 band_top_cell            4 band_factor_b_s1         8 band_deform_shift_b
//   1 band_factor_a_s1         5 band_factor_b_s2         9 band_phase_offset
//   2 band_factor_a_s2         6 band_factor_b_op
//   3 band_factor_a_op         7 band_deform_shift_a
// =====================================================================

// ---------------------------------------------------------------------
// cfg_eq — -1 when the two headers are equal, else the index of the FIRST field that
// differs. An index rather than a bool because the message is the deliverable: "field 11"
// sends the reader to pcfg_deform_table_bg; "false" sends them to re-derive twenty records
// by hand.
//
// FLAT ACCUMULATOR, TESTED IN REVERSE FIELD ORDER, and neither half is style. The
// accumulator is because an `if` in BLOCK-TAIL position evaluates to UNIT silently in .emp
// (Task 3 measured it folding a capability mask to 0), so "return the first index" cannot
// be written as a nested if-expression chain. The reverse order is what makes it the FIRST
// differing field: later assignments win, so testing field 16 first and field 0 last
// leaves the lowest differing index standing.
//
// THE THREE Label FIELDS (10, 11, 12) ARE COMPARED, AND THE COMPARISON IS LIVE — measured,
// not assumed: swapping the oracle's BG table to a different SceneOut_ table reports field
// 11. Two properties of that axis are worth knowing. (a) Label equality is SYMBOL
// IDENTITY, not content: `DeformTable_Zero` and `SceneOut_DeformTable_Zero` hold the same
// 256 bytes and compare UNEQUAL (measured), which is why every oracle call below spells
// the SceneOut_ name while Tasks 6-8 emit both sets, and why table CONTENT is a separate,
// array-wise proof at the bottom of this file. (b) An UNKNOWN name in a Label position
// does not error — it silently becomes a link extern and compares unequal (measured) — so
// a typo'd table name shows up as a field-10/11/12 mismatch, not as "unknown name". Read
// those three indices as "wrong table OR misspelled table".
// ---------------------------------------------------------------------
pub comptime fn cfg_eq(a: parallax_config, b: parallax_config) -> int {
    comptime var idx = -1
    if a.pcfg_anchor_dsb != b.pcfg_anchor_dsb { idx = 16 }
    if a.pcfg_anchor_dsa != b.pcfg_anchor_dsa { idx = 15 }
    if a.pcfg_v_deform_shift_bg != b.pcfg_v_deform_shift_bg { idx = 14 }
    if a.pcfg_v_deform_speed_bg != b.pcfg_v_deform_speed_bg { idx = 13 }
    if a.pcfg_v_deform_table_bg != b.pcfg_v_deform_table_bg { idx = 12 }
    if a.pcfg_deform_table_bg != b.pcfg_deform_table_bg { idx = 11 }
    if a.pcfg_deform_table_fg != b.pcfg_deform_table_fg { idx = 10 }
    if a.pcfg_anchor_ch != b.pcfg_anchor_ch { idx = 9 }
    if a.pcfg_deform_speed_bg != b.pcfg_deform_speed_bg { idx = 8 }
    if a.pcfg_deform_speed_fg != b.pcfg_deform_speed_fg { idx = 7 }
    if a.pcfg_transition != b.pcfg_transition { idx = 6 }
    if a.pcfg_v_offset != b.pcfg_v_offset { idx = 5 }
    if a.pcfg_v_center_y != b.pcfg_v_center_y { idx = 4 }
    if a.pcfg_layer_mask != b.pcfg_layer_mask { idx = 3 }
    if a.pcfg_v_factor_fg != b.pcfg_v_factor_fg { idx = 2 }
    if a.pcfg_v_factor_bg != b.pcfg_v_factor_bg { idx = 1 }
    if a.pcfg_band_count != b.pcfg_band_count { idx = 0 }
    return idx
}

// ---------------------------------------------------------------------
// band_eq — the same for one band entry: -1, or the first differing field index.
//
// TWO ARGUMENTS, NOT THREE. The plan sketched `band_eq(a, b, i)`, but the band index has
// no work to do inside a field-wise compare — it belongs in the FAILURE MESSAGE, and the
// message lives at the call site, where the index is already a literal. A third parameter
// read by nothing would be a parameter every reader has to check for meaning.
// ---------------------------------------------------------------------
pub comptime fn band_eq(a: band_entry, b: band_entry) -> int {
    comptime var idx = -1
    if a.band_phase_offset != b.band_phase_offset { idx = 9 }
    if a.band_deform_shift_b != b.band_deform_shift_b { idx = 8 }
    if a.band_deform_shift_a != b.band_deform_shift_a { idx = 7 }
    if a.band_factor_b_op != b.band_factor_b_op { idx = 6 }
    if a.band_factor_b_s2 != b.band_factor_b_s2 { idx = 5 }
    if a.band_factor_b_s1 != b.band_factor_b_s1 { idx = 4 }
    if a.band_factor_a_op != b.band_factor_a_op { idx = 3 }
    if a.band_factor_a_s2 != b.band_factor_a_s2 { idx = 2 }
    if a.band_factor_a_s1 != b.band_factor_a_s1 { idx = 1 }
    if a.band_top_cell != b.band_top_cell { idx = 0 }
    return idx
}

// =====================================================================
// THE TWENTY PROOFS. Order is configs.emp's declaration order, which is also the registry
// order (scene_registry.emp's SCENES), so all three files read straight down together.
//
// EACH COMPARISON IS BOUND TO A `const` FIRST, then asserted. That is not ceremony: the
// message has to interpolate the differing index, and binding it means the oracle call is
// TRANSCRIBED ONCE. Spelling it twice (once in the ensure, once in the message) would put
// two hand copies of the same shipped parameters in the file, free to drift apart.
// A `const` emits nothing — the whole proof costs zero ROM bytes.
// =====================================================================

// ---- OJZ_Default — configs.emp:138 (4 bands, mask bridge $1F, flat-pathed zero table) --
const EQ_OJZ_Default_h = cfg_eq(scene_hdr(Scene_OJZ_Default),
    hdr(band_count: 4, layer_mask: $1F, v_factor_bg: 3, v_center: 512, v_offset: 0,
        deform_bg: SceneOut_DeformTable_Zero))
ensure(EQ_OJZ_Default_h == -1, "scene equivalence: Scene_OJZ_Default's lowered HEADER differs from ParallaxConfig_OJZ_Default's at cfg field {EQ_OJZ_Default_h} (index table at the top of this file)")
const EQ_OJZ_Default_b0 = band_eq(scene_band(Scene_OJZ_Default, 0),
    cfg_band(cell: 0, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15))
ensure(EQ_OJZ_Default_b0 == -1, "scene equivalence: Scene_OJZ_Default BAND 0 differs from ParallaxConfig_OJZ_Default's at band field {EQ_OJZ_Default_b0}")
const EQ_OJZ_Default_b1 = band_eq(scene_band(Scene_OJZ_Default, 1),
    cfg_band(cell: 8, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15))
ensure(EQ_OJZ_Default_b1 == -1, "scene equivalence: Scene_OJZ_Default BAND 1 differs at band field {EQ_OJZ_Default_b1}")
const EQ_OJZ_Default_b2 = band_eq(scene_band(Scene_OJZ_Default, 2),
    cfg_band(cell: 40, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15))
ensure(EQ_OJZ_Default_b2 == -1, "scene equivalence: Scene_OJZ_Default BAND 2 differs at band field {EQ_OJZ_Default_b2}")
const EQ_OJZ_Default_b3 = band_eq(scene_band(Scene_OJZ_Default, 3),
    cfg_band(cell: 48, fa: FACTOR_1, fb: FACTOR_1_2, dsa: 15, dsb: 15))
ensure(EQ_OJZ_Default_b3 == -1, "scene equivalence: Scene_OJZ_Default BAND 3 differs at band field {EQ_OJZ_Default_b3}")

