// =====================================================================
// THE SIX DEFORM TABLES — content, element by element.
//
// SEPARATE FROM THE RECORD PROOFS ON PURPOSE. The header comparison's Label fields prove
// WHICH table a scene attaches; they cannot prove WHAT IS IN IT, because Label equality is
// symbol identity and a Label's bytes are not readable at comptime. These six close that
// half: `SceneSrc_DeformTable_*` (ojz_scenes.emp — the named generator call each emitted
// `SceneOut_DeformTable_*` initialises from) against the generator call transcribed from
// configs.emp beside each shipped table.
//
// WHAT THIS CATCHES AND WHAT IT DOES NOT. It catches a wrong generator or a wrong argument
// on the SCENE side: the glob import re-evaluates ojz_scenes' initializer here, so the
// arguments compared are the ones that file actually spells. It does NOT read configs.emp
// (the right-hand sides are transcribed, the same standard as every oracle call above),
// and it does not compare emitted bytes — that is Task 10's job.
//
// PAIRED WITH A LENGTH CHECK, ALWAYS. `first_mismatch` walks only its FIRST argument's
// indices and returns -1 when that argument is a PREFIX of the second (raster_dsl.emp:1789
// says so at the definition), so a short table would pass unpaired. All six are [i8; 256].
// =====================================================================
const EQ_TBL_Zero = first_mismatch(SceneSrc_DeformTable_Zero, deform_zero())
ensure(SceneSrc_DeformTable_Zero.len == 256, "scene equivalence: SceneSrc_DeformTable_Zero is {SceneSrc_DeformTable_Zero.len} entries, not 256 — first_mismatch passes a short table as a prefix")
ensure(EQ_TBL_Zero == -1, "scene equivalence: SceneOut_DeformTable_Zero's source diverges from configs.emp:136's deform_zero() at index {EQ_TBL_Zero}")

const EQ_TBL_OJZ_Calm = first_mismatch(SceneSrc_DeformTable_OJZ_Calm, deform_sine(amplitude: 96, period: 64))
ensure(SceneSrc_DeformTable_OJZ_Calm.len == 256, "scene equivalence: SceneSrc_DeformTable_OJZ_Calm is {SceneSrc_DeformTable_OJZ_Calm.len} entries, not 256")
ensure(EQ_TBL_OJZ_Calm == -1, "scene equivalence: SceneOut_DeformTable_OJZ_Calm's source diverges from configs.emp:179's deform_sine(amplitude: 96, period: 64) at index {EQ_TBL_OJZ_Calm}")

const EQ_TBL_Shimmer = first_mismatch(SceneSrc_DeformTable_Shimmer, deform_sine(amplitude: 8, period: 32))
ensure(SceneSrc_DeformTable_Shimmer.len == 256, "scene equivalence: SceneSrc_DeformTable_Shimmer is {SceneSrc_DeformTable_Shimmer.len} entries, not 256")
ensure(EQ_TBL_Shimmer == -1, "scene equivalence: SceneOut_DeformTable_Shimmer's source diverges from configs.emp:192's deform_sine(amplitude: 8, period: 32) at index {EQ_TBL_Shimmer}")

const EQ_TBL_Haze = first_mismatch(SceneSrc_DeformTable_Haze, deform_sine(amplitude: 16, period: 64))
ensure(SceneSrc_DeformTable_Haze.len == 256, "scene equivalence: SceneSrc_DeformTable_Haze is {SceneSrc_DeformTable_Haze.len} entries, not 256")
ensure(EQ_TBL_Haze == -1, "scene equivalence: SceneOut_DeformTable_Haze's source diverges from configs.emp:210's deform_sine(amplitude: 16, period: 64) at index {EQ_TBL_Haze}")

const EQ_TBL_Rocking = first_mismatch(SceneSrc_DeformTable_Rocking, deform_sine(amplitude: 20, period: 64))
ensure(SceneSrc_DeformTable_Rocking.len == 256, "scene equivalence: SceneSrc_DeformTable_Rocking is {SceneSrc_DeformTable_Rocking.len} entries, not 256")
ensure(EQ_TBL_Rocking == -1, "scene equivalence: SceneOut_DeformTable_Rocking's source diverges from configs.emp:242's deform_sine(amplitude: 20, period: 64) at index {EQ_TBL_Rocking}")

const EQ_TBL_Perspective = first_mismatch(SceneSrc_DeformTable_Perspective, v_column_floor(center: 20, max_offset: 24))
ensure(SceneSrc_DeformTable_Perspective.len == 256, "scene equivalence: SceneSrc_DeformTable_Perspective is {SceneSrc_DeformTable_Perspective.len} entries, not 256")
ensure(EQ_TBL_Perspective == -1, "scene equivalence: SceneOut_DeformTable_Perspective's source diverges from configs.emp:261's v_column_floor(center: 20, max_offset: 24) at index {EQ_TBL_Perspective}")
