// OJZ horizontal scroll test state — the game ENTRY state (config/game.asm sets
// Game_Entry = GameState_OJZScroll_Init). Boots the level: palettes, FG art, the
// camera, Player_1, section streaming, parallax, then hands to a per-frame update
// that drives the camera off Player_1 and streams the world.
//
// Shape-DEPENDENT region: the two Debug_Scene_Freeze skip blocks, the DEBUG
// cheat-arm write, the three boot-position-override blocks in the init (§4.12b:
// the placement hook after Player_Init, the parallax-select override, the ack)
// and Debug_CharacterHotkey (whole proc, rts included) all emit only in the DEBUG
// shape. The override's shared clamp/camera templates are comptime and therefore
// declare no label at all — see their header for why that is load-bearing. As the boot state it is a LIVE oracle-A/B
// instrument: its two Debug_Scene_Freeze skips (camera + entity-scan) are the
// deterministic-cache-fill / frame-lock hooks the A/B soak uses, so the port
// keeps them bit-exact (any byte-gate-blind change names the oracle-A/B rider).
//
// C3 (VDP/DMA/timing) surface: setVDPReg mode2/mode3, Level_LoadArt,
// QueueDMA_Critical, CRAM palette copies, the VBlank-masked marker-tile VRAM copy
// (ints masked so a mid-copy VBlank cannot retarget the VDP address). Both
// Section_UpdateColumns calls are BARE: Section_RedrawPlanes owns the Z80
// posture for its own poke storm in both build shapes (engine-side). The
// per-frame VDP reg $0B (Mode Set 3) re-assert is owned by Parallax_Update
// (engine-side), which now skips the bus hold on unchanged-mode frames.
module games.sonic4.ojz_scroll_test in ojz_scroll_test

// vram_art — the packed art_tile word (tile | palette | priority) the DEBUG
// scene readout stamps into its two glyph objects (Debug_SceneReadout_Show).
use engine.objects.objdef.{vram_bytes, vram_art}
use engine.structs.{Act, Sec}
// Act_grid_w_lo / Act_grid_h_lo — the blessed low-byte views of the word grid dims
// (they live WITH the layout, engine.structs). Debug_PresetCycleHotkey reads the
// LIVE act's section count out of them rather than mirroring a constant, which is
// what keeps its cycle list from being able to drift from the act.
use engine.structs.{Act_grid_w_lo, Act_grid_h_lo}
// EffectsPreset — the preset tier's readout reads ep_patched / ep_raster / ep_cycle
// off the record the cursor names to decide its verdict glyph. Type-only import; the
// installer itself (Effects_InstallPreset) resolves as a link extern like every other
// engine proc this module calls.
use engine.effects.preset.{EffectsPreset}
// RASTER_MAX_PATCH / PATCH_ANCHOR_NONE — the patch-channel width the verdict loop
// walks, and the "this channel is not authored" sentinel it skips on.
use engine.effects.raster_dsl.{RASTER_MAX_PATCH, PATCH_ANCHOR_NONE}
use engine.constants.{SECTION_SIZE_SHIFT, SCREEN_WIDTH, SCREEN_HEIGHT, CAM_SCREEN_HALF_W, CAM_SCREEN_HALF_H, VDP_DATA, VDP_CTRL, BUTTON_A, BUTTON_B, BUTTON_C, BUTTON_UP, BUTTON_DOWN, INPUT_LIVE}
// BUTTON_START / LEFT / RIGHT — the DEBUG effects-lab hotkey's chord
// (Debug_SceneCycleHotkey, below).
use engine.constants.{BUTTON_START, BUTTON_LEFT, BUTTON_RIGHT}
// RF_COORDMODE / RF_PRIORITY_SHIFT — the render_flags bits the DEBUG scene
// readout's two glyph objects are built from (screen coords, front band).
// NUM_SYSTEM — the readout's two glyph cells are the TOP TWO System slots, and
// they are claimed by address (the System pool has no allocator).
use engine.constants.{RF_COORDMODE, RF_PRIORITY_SHIFT, NUM_SYSTEM}
use engine.constants.{PAGECACHE_AUDIT_INTERVAL, MAX_ACT_SECTIONS}
// VRAM_WATERLINE_STRIPS — the fixed VRAM run engine/level/bg_anim.emp's
// Waterline_Art_Update DMAs the row-gathered waterline strips into (EFFECTS-W1 item 9d).
// It is a BYTE address, engine-owned, and games/sonic4/vram.toml declares no VramTile
// constant for it (its `authority` is engine-side), so the lab's stamp derives the tile
// index itself — see VRAM_WLINE_STAMP at Debug_WaterlineStamp_Show.
use engine.constants.{VRAM_WATERLINE_STRIPS}
// WATERLINE_TILES — how many 8x8 tiles that run actually holds (WATERLINE_DST_BYTES / 32).
// The stamp draws ALL of them as one VDP sprite piece, so this is what its size nibble is
// pinned against: a change to WATERLINE_H must fail the build here rather than leave the
// stamp drawing half a picture and the tiles after it.
use engine.level.parallax_dsl.{WATERLINE_H, WATERLINE_TILES}
use engine.vdp.{VdpTarget, VdpOp, vdp_comm, VDP_MODE2_OFF, VDP_MODE3_OFF}
use engine.z80_bus.{z80_stopped}
use engine.irq.{ints_off}
use engine.types.{VramTile, GridX, GridY}
// TagRef.none ($FF, the option niche) — the live-object mailbox's DELETE arm tests
// a slot's entity-window ownership with it. Spelled through the type rather than as
// a raw #$FF so `[option.unguarded-use]` stays able to see the comparison.
use engine.types.{TagRef}
use engine.coords.{pixels_to_coord}

// VRAM_TEST_OBJ / VRAM_TEST_MARKER — sole authority is games.sonic4.constants
// (config/constants.emp). VRAM_TEST_MARKER = VRAM_RING_PLACEHOLDER+16 =
// VRAM_TEST_OBJ+$18. CHAR_COUNT is the roster length the DEBUG character-cycle
// hotkey wraps at.
// VRAM_DEBUG_LAB_NAME — the FOUR glyph cells (tiles 1020-1023) the effects lab's
// ENTRY NAME TAG repaints; VRAM_DEBUG_PRESET_READOUT — the two (957-958) the preset
// section digit and verdict glyph sit in. Both declared in games/sonic4/vram.toml like
// every other region, reserved in both shapes and written only in DEBUG.
// VRAM_DEBUG_RASTER_TAG / VRAM_DEBUG_BGANIM_TAG — the two NAME TAG strips
// (EFFECTS-W1 F4): four cells at tiles 1532-1535 for the live raster program's
// name, three at 1501-1503 for the BG-animation table's. Same authority, same
// generated block, same rule as every other region const.
//
// AN UNIMPORTED VRAM CONST IS NOT A BUILD ERROR AT ITS DEFINITION SITE, which is
// how this list is easy to forget: a bare name in `.emp` silently becomes a link
// extern (EMP_PITFALLS §2/§12's family). Measured on this parcel, 2026-09-04 —
// omitting the two names below built the generated block correctly and failed
// FOUR call sites with `a label is not a valid VramTile argument`, all inside
// Debug_TierTags_Update and none of them naming the missing `use`.
use games.sonic4.constants.{VRAM_TEST_OBJ, VRAM_TEST_MARKER, VRAM_DUST_PUFF, VRAM_RING_SPARKLE, CHEAT_DEBUG_FLY, CHAR_COUNT, PSTATE_AIR, VRAM_DEBUG_LAB_NAME, VRAM_DEBUG_PRESET_READOUT, VRAM_DEBUG_RASTER_TAG, VRAM_DEBUG_BGANIM_TAG}

// Sst — the object SST layout. The DEBUG warp consumer places the LEADER through
// Camera_Target (an SST pointer), not through the Player_1 absolutes above: the
// warp is a level-generic operation and the camera's own follow target is the
// engine's name for "the slot this level is about".
use engine.objects.sst.{Sst}

// The puff block's byte offset/length inside Art_Dust — owned by the format's
// module (data/dust_data.emp), so a re-export that moved the split is one edit
// there, not here.
use games.sonic4.dust_data.{DUST_PUFF_ART_OFF, DUST_PUFF_ART_LEN}
use games.sonic4.ring_sparkle.{Art_RingSparkle, RING_SPARKLE_ART_LEN}

// PlayerBlock — the player_block splice's stride is sizeof(PlayerBlock) and the
// splice expands in THIS module's scope, so the type has to resolve here.
use games.sonic4.ram.{PlayerBlock}

// THE SCENE EQUIVALENCE WITNESS'S REACHABILITY EDGE (scanline-P1 Task 7), and the reason
// it hangs off THIS module: an .emp module nothing reaches gets parse + scan coverage and
// ZERO body elaboration, so every `ensure` in games/sonic4/test/scene_equiv_proof.emp
// would be dead — `ensure(1 == 0)` in an unreached module builds GREEN with an unchanged
// CRC (measured, Task 3). Placement is the sigil registry (a Rust list in
// crates/sigil-harness/src/native.rs), which only carries byte-emitting modules; the
// witness emits nothing and must never take a registry row. So its reachability has to
// come from a `use` edge out of an already-placed module, and this is the only PLACED
// test-lane module in the game — the witness stays in the test lane rather than being
// dragged into shipped game data.
//
// WHOLE PATH, NO NAME LIST, deliberately: a selective `use ...{cfg_eq}` injects a CLONE
// whose initializer re-evaluates in THIS module's scope and never elaborates the callee
// (Task 5's probe). The edge, not the name, is what pulls a module into the closure.
// Nothing here calls into it — the witness is all module-level `ensure`s, which is exactly
// what an edge and nothing else is needed for. Verified red-first on a plain
// `DEBUG=1 ./build.sh` (Task 7 report): flipping one expected field in the witness fails
// the build and names the config and the differing field index.
use games.sonic4.scene_equiv_proof

// ---- THE TWENTY SHIPPED SCENE RECORDS + the registry's length ----
//
// Consumed by Debug_SceneCycleHotkey's `dc.l` table (DEBUG shapes only; the table
// sits inside the proc's `if DEBUG == 1 {}` and emits zero release bytes).
//
// EVERY NAME IS SPELLED OUT rather than left to resolve as a link extern, for the
// reason act_descriptor.emp:26 records: an unknown name in a Label position does not
// error in .emp, it silently becomes an extern. A misspelling in a twenty-entry
// pointer table would surface as a runtime wrong picture — or a jump into data — and
// never as a build failure. With the names imported, a rename in the registry breaks
// the build HERE.
//
// SCENE_CYCLE_COUNT is the registry's length, a mirror-with-a-pin held to `SCENES.len`
// by an `ensure` in scene_registry.emp (a direct `= SCENES.len` export cannot be
// imported — the initializer would re-evaluate in this module's scope, where SCENES is
// not a name). The table's ENTRY COUNT is held to it by
// tools/test_scene_cycle_table_lint.py, which the build's pytest lane runs.
use games.sonic4.scene_registry.{SCENE_CYCLE_COUNT}
use games.sonic4.scene_registry.{ParallaxConfig_OJZ_Default, ParallaxConfig_OJZ_Underwater,
    ParallaxConfig_OJZ_Windy, ParallaxConfig_Shimmer_Slow, ParallaxConfig_Shimmer,
    ParallaxConfig_Shimmer_Fast, ParallaxConfig_Haze_Slow, ParallaxConfig_Haze,
    ParallaxConfig_Haze_Fast, ParallaxConfig_Haze_Uniform, ParallaxConfig_Rocking_Slow,
    ParallaxConfig_Rocking, ParallaxConfig_Rocking_Fast, ParallaxConfig_Perspective_Subtle,
    ParallaxConfig_Perspective, ParallaxConfig_Perspective_Dramatic,
    ParallaxConfig_WindyHaze, ParallaxConfig_SkyHaze, ParallaxConfig_OJZ_Caves,
    ParallaxConfig_OJZ_LockedClouds, ParallaxConfig_Perspective_Floor}

// The raster programs Debug_BandDemoHotkey's `.raster_table` points at, imported
// BY NAME for the reason the scene-registry list above is: an unknown name in a Label
// position does not error in `.emp`, it silently becomes a link extern, so an
// unimported row would resolve to nothing the build ever complains about. Row 0 is
// hand-authored `.emp`; the rest are generated by tools/effects_gen.py from the preset
// documents in games/sonic4/data/editor/effects/presets/ and are the whole point of the
// cycle. `ojz_sec3_shimmer` joined with EFFECTS-W1 item 5: it is the document that also
// carries `cycles` and `variants`, and the DEBUG chord is what makes its BAND reachable
// — its cycle and variant descriptors are bound through the generated choosers in
// games/sonic4/data/effects/ojz_effects.emp instead, which is a different installer.
// `ramp_probe` joined with EFFECTS-W1 item 6 step 4: it is a `ramp` document, not a
// `bands` one — `Raster_Install` neither knows nor cares, since dispatch reads the OP
// byte at runtime from whatever `RasterRampProgram`/`[u16; N]` this table hands it — so
// the SAME chord and the SAME installer make a dense-tier program reviewable exactly as
// they do a sparse one, with NO section binding (this is the lab, not a level; see the
// header on `ramp_probe.json` for why it must stay unbound).
// `Raster_Program_None` and `Raster_Install` are engine names the OFF arm
// and both tails reach as externs, unchanged by this parcel.
use games.sonic4.ojz_effects.{OJZ_BandDemo, OJZ_BaseSwap}
// The three BG-animation tables the lab's fourth tier selects between. All three
// live in the SAME generated section and share one bank blob; they differ only in
// which scalar the step is read from (tools/inject_editor_bg.py's `default_off`
// block). BgAnim_Table is the act's own, and for this act its band count is 0 — it
// IS the OFF row, not a stand-in for one.
//
// THIS `use` IS UNCONDITIONAL IN EVERY SHAPE, INCLUDING PLAIN, and that is load-bearing
// rather than incidental: a `use` is resolved before any `if DEBUG == 1` is considered,
// so the plain link needs all four names to exist even though only the DEBUG shape can
// reach three of them. Until 2026-09-06 the emitter wrote the three view names for
// exactly ONE act document (single band, `default_off`, 64 px) and the other seven
// reachable shapes failed the PLAIN build with `has no pub name BgAnim_View_H`. They are
// now exported by every shape — a declining act exports them as count-0 (OFF) tables.
// If you add a name here, it must be one the emitter writes UNCONDITIONALLY;
// tools/test_bg_emit.py::TestBgAnimViewNamesAreShapeInvariant parses this very line and
// checks each name against every act shape, so it will tell you.
use games.sonic4.ojz_bg_anim_act1.{BgAnim_Table, BgAnim_View_H, BgAnim_View_V, BgAnim_View_T}
// Rows 3 and 4 — the VERTICAL-AXIS band and its horizontal-axis control — are NOT
// imported: they are declared at the FOOT OF THIS FILE (see the block there for why they
// could not be their own module). They do NOT come from the act's generated section and
// do NOT share its bank blob: they are debug-tier probe content with their own 2,048 B of
// vertically pre-shifted art, aimed at the BG region's unused band RESERVE ($A800) rather
// than at the authored canopy's slots.
use games.sonic4.ojz_effects_editor_act1.{EditorRaster_OJZ_Act1_authored_probe, EditorRaster_OJZ_Act1_aurora_ramp_witness, EditorRaster_OJZ_Act1_ojz_sec3_shimmer, EditorRaster_OJZ_Act1_ramp_probe}

// player_block — the per-slot PlayerBlock derivation splice; PlayerV — the
// player's SST overlay (the hotkey reads debug_flag off it). Both are
// player_common's, imported the way the player state files import them.
use games.sonic4.player_common.{PlayerV, player_block}

// Screen half-extents — the camera-center offsets for the Player_1 spawn. Their
// real home is engine/level/camera.asm (not exported by camera.emp), mirrored
// file-local with a drift guard.

// TestArt blob length — THIS module owns TestArt now (objtest-gate, 2026-08-05:
// ownership moved here from object_test_state when that module went DEBUG-only;
// the shipped OJZ init DMAs the blob and the release debug-fly cheat renders
// from it, so it must live in the plain shape — and the old length MIRROR this
// comment block used to describe is deleted with the move). Two 128-byte colour
// squares + the 512-byte ring blob; drift-guarded at the data block below. A
// pure-int comptime const (label-pair immediate arithmetic isn't an
// expressible EA).
// The ring blob (512 B) that tails the two 128-byte colour squares in TestArt.
const RingArt = embed("games/sonic4/test/ring_art.bin")
pub const RING_ART_LEN = 512
// Drift guard on the embedded blob's size (an `ensure` evaluates the embed in a
// sandbox-rooted context; a proc-body immediate does not, so TEST_ART_LEN below
// must stay pure-int). RING_ART_LEN feeds the DMA length.
ensure(RingArt.len == RING_ART_LEN, "games/sonic4/test/ring_art.bin size drifted from RING_ART_LEN")
pub const TEST_ART_LEN = 128 + 128 + RING_ART_LEN

// Player_1 SST-field absolute addresses (the extern-equ-sum idiom, camera.emp's
// PL_STATE_ADDR precedent) — the init writes the spawn position/velocity directly
// to (Player_1+field).w without holding the base in a register.
equ PLAYER_1_X_POS = extern("Player_1") + extern("SST_x_pos")
equ PLAYER_1_Y_POS = extern("Player_1") + extern("SST_y_pos")
equ PLAYER_1_X_VEL = extern("Player_1") + extern("SST_x_vel")
equ PLAYER_1_Y_VEL = extern("Player_1") + extern("SST_y_vel")

// -----------------------------------------------
// EXTERNAL PLACEMENT MAILBOXES — the two shared templates (DEBUG shapes)
// -----------------------------------------------
// This game has two external "put the player HERE" interfaces: the WARP mailbox,
// consumed at the top of a frame by Debug_Warp_Consume, and the BOOT-POSITION
// override, consumed by the init ladder below. They differ in everything except
// the two things a client can actually observe — the clamp and where the camera
// ends up — and those two are shared HERE so the pair cannot drift apart.
//
// THEY ARE COMPTIME TEMPLATES, NOT PROCS, and that is a hard constraint rather
// than a style choice. A `proc` whose body is wholly inside `if DEBUG == 1 {}`
// emits zero release BYTES but still declares a release LABEL, and the label
// reaches convsym's deb2 appendix: even parked at an address the appendix already
// carries (where only one symbol per address survives into the address table), the
// dropped duplicates still feed the appendix's name trie, so the appendix grows
// and every release CRC moves. Measured on this parcel: three parked zero-byte
// procs took s4.bin from d00dd11d/698411 to 84df688f/698409 — code identical
// through EndOfRom ($A11C0), appendix-only, and still a changed ROM. A comptime
// template declares no symbol at all, so sharing costs nothing anywhere.
// (The same reasoning is written out at the page-cache audit tick in
// GameState_OJZScroll_Update, which is inline for exactly this reason.)

// clamp_and_publish — clamp a mailbox's (X,Y) pair into the act and publish the
// clamped pair back into the same cells.
//
// Player_Bound_Right / Player_Bound_Bottom are the game's own act clamp edges,
// precomputed once per act by Player_BoundsInit and consumed every frame by
// Player_LevelBound — reused rather than re-deriving level_width/height, so one
// act-bounds formula stays. Signed compares throughout: the act grid ceiling is
// asserted <= $8000 px per axis (act_descriptor), so every legal world coordinate
// is positive and a request with bit 15 set is out of range by definition and
// clamps to 0. The publish-back is part of the clamp, not a separate step: both
// mailboxes promise a client that reading the pair after the ack tells it where
// the engine actually put the player.
//
// CALLER PRECONDITION: Player_Bound_* must already be live. The warp gets that
// for free (the act's init ran long ago); the boot override runs BEFORE the init
// ladder's own Player_BoundsInit and therefore calls it first — see there.
//
// In:  xcell/ycell = the mailbox's two u16 cells
// Out: both cells clamped in place; d0 = clamped X px, d1 = clamped Y px
comptime fn clamp_and_publish(xcell: Label, ycell: Label) -> Code {
    return asm {
        move.w  {xcell}, d0
        tst.w   d0
        bpl     .cap_x_lo
        moveq   #0, d0
    .cap_x_lo:
        cmp.w   Player_Bound_Right, d0          // (Player_Bound_Right).w
        ble     .cap_x_hi
        move.w  Player_Bound_Right, d0
    .cap_x_hi:
        move.w  d0, {xcell}                     // publish: the client reads back
        move.w  {ycell}, d1                     // where it actually landed
        tst.w   d1
        bpl     .cap_y_lo
        moveq   #0, d1
    .cap_y_lo:
        cmp.w   Player_Bound_Bottom, d1         // (Player_Bound_Bottom).w
        ble     .cap_y_hi
        move.w  Player_Bound_Bottom, d1
    .cap_y_hi:
        move.w  d1, {ycell}
    }
}

// center_camera_on — put the camera where the follow rule would put it for a
// leader standing at the (already clamped) pair in xcell/ycell, then apply the
// camera's own act clamp.
//
// This is Camera_Update's deadzone centre, so the first Camera_Update after a
// placement finds the leader inside the deadzone and takes no step. The ceilings
// are the ones Camera_Init precomputed for this act, so every caller must run
// after Camera_Init. Reads the cells rather than registers because both callers
// have just published them and neither can hold a register across the calls in
// between (Player_SetState on the warp path, Player_BoundsInit on the boot path).
//
// In:  xcell/ycell = the mailbox's two u16 cells (clamped world px)
// Out: Camera_X / Camera_Y written (16.16, fraction cleared). Clobbers d0.
comptime fn center_camera_on(xcell: Label, ycell: Label) -> Code {
    return asm {
        move.w  {xcell}, d0
        subi.w  #CAM_SCREEN_HALF_W, d0
        bpl     .ccam_x_lo
        moveq   #0, d0
    .ccam_x_lo:
        cmp.w   Camera_X_Max, d0                // (Camera_X_Max).w — Camera_Init's ceiling
        ble     .ccam_x_hi
        move.w  Camera_X_Max, d0
    .ccam_x_hi:
        {pixels_to_coord(d0)}
        move.l  d0, Camera_X                    // (Camera_X).w

        move.w  {ycell}, d0
        subi.w  #CAM_SCREEN_HALF_H, d0
        bpl     .ccam_y_lo
        moveq   #0, d0
    .ccam_y_lo:
        cmp.w   Camera_Y_Max, d0                // (Camera_Y_Max).w
        ble     .ccam_y_hi
        move.w  Camera_Y_Max, d0
    .ccam_y_hi:
        {pixels_to_coord(d0)}
        move.l  d0, Camera_Y                    // (Camera_Y).w
    }
}

// -----------------------------------------------
// LIVE-OBJECT MAILBOX — the third external mailbox (DEBUG shapes)
// -----------------------------------------------
// Op codes and status codes for the Obj_Req_* cells (games/sonic4/config/ram.emp).
// Protocol prose + the published field list: docs/ENGINE_ARCHITECTURE.md "§4.12c".
//
// THESE ARE MODULE-LOCAL `const`s, NOT `pub const`s in games/sonic4/config/
// constants.emp, and that is the same release-CRC constraint the two templates
// above are written for rather than a filing preference. Every `pub const` in the
// game constants module is harvested and RE-EXPORTED as a link EquSym (see that
// file's header), and a link symbol feeds convsym's deb2 appendix in EVERY shape —
// including release, where this whole feature is meant to be absent. A module-local
// const declares nothing at link, so it costs release exactly nothing. The values
// are published in the architecture doc instead, and tools/test_object_mailbox_
// contract.py holds the doc's table against this file and against ram.emp.
const OBJREQ_OP_SPAWN    = 1
const OBJREQ_OP_MOVE     = 2
const OBJREQ_OP_DELETE   = 3

const OBJREQ_OK          = 0    // request applied
const OBJREQ_ERR_OP      = 1    // Obj_Req_Op is not 1/2/3
const OBJREQ_ERR_DEF     = 2    // spawn: Obj_Req_Def failed the archetype-pointer rails
const OBJREQ_ERR_FULL    = 3    // spawn: the dynamic pool is exhausted — NOTHING was evicted
const OBJREQ_ERR_SLOT    = 4    // move/delete: Obj_Req_Slot is not a live dynamic slot
const OBJREQ_ERR_OWNED   = 5    // delete: that slot belongs to the entity window

// The cart address window ($000000-$3FFFFF). The spawn archetype pointer's upper
// rail, and it is deliberately the HARDWARE bound rather than the ROM's own end:
// this rail's job is "a `movea.l` here cannot walk off the addressable cart", which
// is a fact about the machine, not about how big today's build happens to be.
//
// SAY THE COST OUT LOUD RATHER THAN IMPLY IT AWAY: `extern("EndOfRom")` would be a
// STRICTLY TIGHTER rail for the same 6 bytes (measured $A801C in s4.debug.lst
// against this $400000), and games/sonic4/config/header.emp already resolves that
// symbol, so it is available here. It is not taken because the looser rail is the
// one that stays true when the ROM grows, and because the pointer this rail cannot
// reject — inside the cart window, past EndOfRom, reading open bus — is rejected by
// the code_addr rail below anyway in every case a garbage pointer produces a zero
// head word. What it does NOT do is make this parcel cross-seam-free: seven engine
// names are new to this module (Load_Object, DeleteObject, Dynamic_Live,
// Dynamic_Live_Count, TagRef, Sst.slot_tag, Sst.code_addr). One more would not have
// been the deciding cost, and reading this comment as if it were is the mistake.
const CART_WINDOW_END    = $400000

// The placement-word mask the engine applies to Obj_Req_Place: OEF flips in bits
// 13/14 and the subtype in the low byte are the only bits Load_Object reads
// (`rol.w #4` then `andi.b #$06`, plus `move.b d2, Sst.subtype`), so masking here
// makes the field TOTAL — no client value can reach a bit that means nothing.
const OBJREQ_PLACE_MASK  = $60FF

// objreq_consume — apply at most one live-object request, at the frame top.
//
// A COMPTIME TEMPLATE, NOT A PROC, for the reason spelled out at the two mailbox
// templates above: a `proc` whose body is wholly inside `if DEBUG == 1 {}` emits
// zero release BYTES but still declares a release LABEL, that label reaches
// convsym's deb2 appendix, and the appendix moves every release CRC. Measured on
// the boot-override parcel: three parked zero-byte procs took s4.bin from
// d00dd11d/698411 to 84df688f/698409 — code identical through EndOfRom and still a
// changed ROM. A template declares no symbol at all, so the DEBUG-only guarantee is
// structural rather than a placement trick that the next edit can break. It is
// instantiated ONCE (in GameState_OJZScroll_Update's frame top); the local labels
// below would collide at a second instantiation.
//
// WHERE THE SLOTS COME FROM, and why there is no allocator here. A spawn goes
// through Load_Object -> AllocDynamic, the engine's own dynamic-pool allocator,
// and takes its refusal verbatim. AllocDynamic pops the free stack, which by
// construction never contains a slot that is in use, so a debug spawn CANNOT land
// on a live gameplay object — the property this mailbox most needed is one the
// engine already had. When the pool is exhausted the request is REFUSED with
// OBJREQ_ERR_FULL and nothing is evicted, moved or reclaimed. The rejected
// alternatives are recorded in docs/ENGINE_ARCHITECTURE.md §4.12c; the short
// version is that a second allocator over one pool (a first-free scan) would hand
// out a slot the free stack still holds, and eviction is precisely the "a debug
// spawn silently killed a live object and the engine looked buggy an hour later"
// failure this interface exists to not have.
//
// WHY MOVE/DELETE VALIDATE BY SEARCHING Dynamic_Live. The client's slot handle is
// the low word of an SST address. Checking it by arithmetic would need the
// address to be Dynamic_Slots + k*sizeof(Sst), and sizeof(Sst) is $50 — not a
// power of two, so that check costs a divide. Searching Dynamic_Live instead
// costs at most NUM_DYNAMIC word compares on a cold path and proves MORE: slot
// alignment, pool membership and spawn-order liveness in one pass, against the
// engine's own occupancy list rather than a second restatement of it. The latch
// (Dynamic_Live_Pending) is deliberately NOT searched: RunObjects drains it at
// every frame end where it is non-empty, so it is always empty at the frame top
// where this runs. The consequence a client must know: a slot spawned through
// this mailbox is NOT movable or deletable on the same frame it was created —
// but since only one request is consumed per frame, no client can try.
//
// WHAT THIS INTERFACE DOES NOT DO, and none of it is an oversight. There is no
// registry, no debug-slot reservation, no lifetime tracking and no persistence: a
// spawned object is an ordinary dynamic slot that dies like any other. It does not
// survive InitObjectRAM, so a level re-init, a reset or a state change takes it
// with everything else. It IS untagged (AllocDynamic stamps TagRef.none), which is
// what keeps the entity window's Y-despawn band from harvesting it — the same
// treatment children and effects already get, not a special case built for this.
//
// In:  the Obj_Req_* cells, Obj_Req_Flag nonzero
// Out: Obj_Req_Status written, then Obj_Req_Flag cleared (the ack). On a spawn,
//      Obj_Req_Slot carries the new slot's handle.
// Clobbers: d0-d3/a0-a3 (Load_Object's and DeleteObject's closure)
comptime fn objreq_consume() -> Code {
    return asm {
        tst.b   Obj_Req_Flag                    // (Obj_Req_Flag).w
        beq     .objreq_idle                    // idle: one read and a branch

        cmpi.b  #OBJREQ_OP_SPAWN, Obj_Req_Op
        beq     .objreq_spawn
        cmpi.b  #OBJREQ_OP_MOVE, Obj_Req_Op
        beq     .objreq_slot_op
        cmpi.b  #OBJREQ_OP_DELETE, Obj_Req_Op
        beq     .objreq_slot_op
        move.b  #OBJREQ_ERR_OP, Obj_Req_Status
        jbra    .objreq_ack

        // -- SPAWN. The archetype pointer is the one field that can do real damage,
        //    so it gets four rails: nonzero (a cleared cell is not a request),
        //    EVEN (Load_Object burst-copies the template with `move.l (a2)+`, which
        //    ADDRESS ERRORs on an odd source), inside the cart window, and a nonzero
        //    ObjDef.code_addr (objroutine(0) resolves to ObjCodeBase's bare `rts`,
        //    i.e. a slot that dispatches into nothing). What stays unvalidated is
        //    whether the bytes at a plausible pointer are ACTUALLY an ObjDef — nothing
        //    in the format is self-describing. The damage is bounded structurally
        //    rather than by a rail: RunObjects dispatches `OBJ_CODE_BANK<<16 | word`,
        //    so ANY code_addr value, garbage included, lands inside the 64 KB object
        //    bank and cannot reach wild memory. --
    .objreq_spawn:
        move.l  Obj_Req_Def, d0                 // (Obj_Req_Def).w
        beq     .objreq_bad_def
        btst    #0, d0
        bne     .objreq_bad_def
        cmpi.l  #CART_WINDOW_END, d0
        bhs     .objreq_bad_def
        movea.l d0, a1
        tst.w   (a1)                            // ObjDef.code_addr, the record's head word
        beq     .objreq_bad_def

        move.w  Obj_Req_X, d0
        move.w  Obj_Req_Y, d1
        move.w  Obj_Req_Place, d2
        andi.w  #OBJREQ_PLACE_MASK, d2          // total: no other bit can mean anything
        jbsr    Load_Object                     // a1 = ObjDef in, new SST out; Z = success
        bne     .objreq_full
        move.w  a1, Obj_Req_Slot                // publish the handle the client will
        move.b  #OBJREQ_OK, Obj_Req_Status      //   move/delete with
        jbra    .objreq_ack
    .objreq_full:
        move.b  #OBJREQ_ERR_FULL, Obj_Req_Status
        jbra    .objreq_ack
    .objreq_bad_def:
        move.b  #OBJREQ_ERR_DEF, Obj_Req_Status
        jbra    .objreq_ack

        // -- MOVE and DELETE share the slot lookup, and share it by CODE PATH rather
        //    than by a second template instantiation: two instantiations inside one
        //    proc would declare the scan's local labels twice. So both ops land here,
        //    the handle is validated once, and the op is re-tested afterwards — one
        //    `cmpi.b` on a cold path, against ~20 duplicated bytes and a label-collision
        //    hazard the next reader would have to rediscover.
        //
        //    WHY THE VALIDATION IS A SEARCH OF Dynamic_Live: see the header. The zero
        //    check is not redundant with the search — DeleteObject ZEROES a deleted
        //    slot's live-list entry and the compaction that removes it is deferred to
        //    the frame end, so a stale zero entry is a legitimate list member and a
        //    client handle of 0 would match it. --
    .objreq_slot_op:
        move.w  Obj_Req_Slot, d1                // (Obj_Req_Slot).w
        beq     .objreq_bad_slot                // 0 would match a zeroed (deleted) entry
        move.w  Dynamic_Live_Count, d0
        beq     .objreq_bad_slot
        lea     Dynamic_Live, a1
        subq.w  #1, d0
    .objreq_scan:
        cmp.w   (a1)+, d1
        beq     .objreq_hit
        dbf     d0, .objreq_scan
    .objreq_bad_slot:
        move.b  #OBJREQ_ERR_SLOT, Obj_Req_Status
        jbra    .objreq_ack
    .objreq_hit:
        movea.w d1, a0                          // game RAM is $FFFFxxxx: the sign-extend
        tst.w   Sst.code_addr(a0)               //   IS the address. Dead-but-uncompacted
        beq     .objreq_bad_slot                //   entry: listed, but the slot is gone
        cmpi.b  #OBJREQ_OP_DELETE, Obj_Req_Op
        beq     .objreq_delete

        // -- MOVE. Position only: velocity, status, angle and animation are left
        //    exactly as they were, so a moved object keeps doing whatever it was
        //    doing from its new place. That is the opposite of the warp's leader
        //    placement (which zeroes the whole carried-motion row) and it is the
        //    right default here — a placement tool nudging a badnik must not also
        //    silently reset it. The fraction is cleared, as everywhere a pixel
        //    coordinate becomes a 16.16 one. NO clamp, deliberately: an out-of-act
        //    object is culled by RunObjects' camera-distance test and does nothing,
        //    where the player's own out-of-act position would reach SEC_VOID — which
        //    is the entire reason the warp clamps and this does not. --
        move.w  Obj_Req_X, d0
        {pixels_to_coord(d0)}
        move.l  d0, Sst.x_pos(a0)
        move.w  Obj_Req_Y, d1
        {pixels_to_coord(d1)}
        move.l  d1, Sst.y_pos(a0)
        move.b  #OBJREQ_OK, Obj_Req_Status
        jbra    .objreq_ack

        // -- DELETE, and the one asymmetry in this interface: it refuses a slot the
        //    ENTITY WINDOW owns. A window-spawned entity carries a slot_tag other
        //    than TagRef.none, and the window's own despawn path
        //    (EntityWindow_Y_Despawn, engine/objects/entity_window.emp) clears the
        //    entity's LOADED bit via EntityLoaded_Clear BEFORE it calls DeleteObject.
        //    A bare DeleteObject here would skip that clear, leaving the window
        //    believing the entity is still spawned — so it would never re-spawn while
        //    its section stays tracked. That is exactly the class of silent
        //    inconsistency that gets read as an engine bug weeks later, so the
        //    request is refused with OBJREQ_ERR_OWNED instead. Debug spawns, children
        //    and effects are all untagged and delete freely. MOVE has no such hazard
        //    (it touches no bookkeeping) and is allowed on any live dynamic slot.
        //
        //    DeleteObject cascades the slot's child chain itself, so a debug-spawned
        //    parent takes its children with it — no lifetime handling of our own. --
    .objreq_delete:
        cmpi.b  #TagRef.none, Sst.slot_tag(a0)
        bne     .objreq_owned
        jbsr    DeleteObject
        move.b  #OBJREQ_OK, Obj_Req_Status
        jbra    .objreq_ack
    .objreq_owned:
        move.b  #OBJREQ_ERR_OWNED, Obj_Req_Status

        // -- ACK, and it must be the LAST write of the consumption, exactly as the
        //    warp's and the boot override's are: the client polls this byte to learn
        //    the request was looked at, so clearing it before the status write would
        //    publish a result the client cannot trust. --
    .objreq_ack:
        clr.b   Obj_Req_Flag                    // (Obj_Req_Flag).w
    .objreq_idle:
    }
}

// -----------------------------------------------
// GameState_OJZScroll_Init — one-shot setup
// -----------------------------------------------
pub proc GameState_OJZScroll_Init () clobbers(d0-d7/a0-a6) preserves(sr.mask) {
        // -- arm the developer cheats (DEBUG shape only). This is the game's
        //    one-shot boot init (Game.entry), so the write lands exactly once per
        //    boot, before any state can read Cheat_Flags. Release/lean emit NOTHING
        //    here: boot clears all Work-RAM, so every cheat is already off, and
        //    debug-fly's B toggle (Player_Main / TestPlayer_Main) stays inert until
        //    a cheat code sets the bit. --
        if DEBUG == 1 {
                move.b  #CHEAT_DEBUG_FLY, Cheat_Flags   // (Cheat_Flags).w
        }

        // -- per-8-row HScroll mode (reg $0B bits 1:0 = %10) --
        move.b  #$02, VDP_Shadow_Table + VDP_MODE3_OFF   // shadow is the authority for reg $0B

        // -- load BGND palette (32 bytes, "SonicAndTails") into CRAM line 0 --
        // -- load OJZ palette (96 bytes, 3 pages) into CRAM lines 1-3 --
        // sonic_hack runtime layout: PalPtr_BGND -> line 0, PalPtr_OJZ -> line 1.
        //
        // Line 0 is the CHARACTER line, not a level line. It serves exactly
        // three things: the player sprite (Player_InitAssets writes the art word
        // as vram_art(tile,0,0) — palette 0 verbatim), the backdrop colour the
        // VDP reads out of CRAM entry 0, and the DEBUG test squares/marker.
        // Nothing in the act's own art is drawn on it — measured: every FG block
        // nametable word carrying palette bits 0 references tile $000, the blank
        // tile, and the Plane B nametable uses only lines 2 and 3 (the
        // magenta/pink clouds are on line 3). So a missing BGND load costs the
        // player and the backdrop, not the level.
        lea     BGND_Palette, a0
        lea     Palette_Buffer, a1                  // CRAM line 0 base — (Palette_Buffer).w
        moveq   #32/4 - 1, d0
.copy_bgnd:
        move.l  (a0)+, (a1)+
        dbf     d0, .copy_bgnd

        lea     OJZ_Palette, a0
        lea     Palette_Buffer + $20, a1            // CRAM line 1 base — (Palette_Buffer+$20).w
        moveq   #96/4 - 1, d0
.copy_ojz:
        move.l  (a0)+, (a1)+
        dbf     d0, .copy_ojz
        move.b  #$0F, Palette_Dirty                // (Palette_Dirty).w

        // -- load deduped FG tile pool via S4LZ -> VRAM (display still off) --
        lea     OJZ_Act1_Descriptor, a0            // (OJZ_Act1_Descriptor).l
        jbsr    Level_LoadArt

        // -- test object + ring placeholder art (TEST_ART_LEN = 768 B = 24 tiles
        //    at VRAM_TEST_OBJ: two 4-tile colour squares then the 16-tile ring
        //    blob, whose base is VRAM_RING_PLACEHOLDER = VRAM_TEST_OBJ+8) --
        move.l  #TestArt, d1
        move.w  #vram_bytes(VRAM_TEST_OBJ), d2
        move.w  #TEST_ART_LEN, d3               // TestArt_End - TestArt
        jbsr    QueueDMA_Critical @discards(dropped)   // test scene: a dropped DMA (queue full) is acceptable

        // -- dust puff block: 16 tiles RESIDENT at VRAM_DUST_PUFF for the whole
        //    act. Every puff frame must be live simultaneously (concurrent puffs
        //    sit on different frames), so this object never streams — this one
        //    DMA is its entire art cost. Source is the TAIL of Art_Dust; the
        //    leading 72 tiles are the charge dust's DPLC source. --
        move.l  #Art_Dust + DUST_PUFF_ART_OFF, d1
        move.w  #vram_bytes(VRAM_DUST_PUFF), d2
        move.w  #DUST_PUFF_ART_LEN, d3
        jbsr    QueueDMA_Critical @discards(dropped)   // level init: a dropped DMA is
                                                       // acceptable here exactly as for
                                                       // TestArt above

        // -- ring-collect sparkle: 4 tiles RESIDENT at VRAM_RING_SPARKLE for the
        //    whole act, the dust puff's strategy (concurrent sparkles sit on
        //    different frames). One 128-byte DMA is its entire art cost; the four
        //    frames are flip variants of this one piece. --
        move.l  #Art_RingSparkle, d1
        move.w  #vram_bytes(VRAM_RING_SPARKLE), d2
        move.w  #RING_SPARKLE_ART_LEN, d3
        jbsr    QueueDMA_Critical @discards(dropped)   // same policy as the two above

        // -- initialise camera first (Section_FillInitial reads Camera_X) --
        lea     OJZ_Act1_Descriptor, a0            // (OJZ_Act1_Descriptor).l
        jbsr    Camera_Init

        // -- init object system (must precede Player_1 setup and Section_Init) --
        jbsr    InitObjectRAM

        // -- initialise Player_1 at camera-center position so Camera_Update's
        //    deadzone tracking begins at rest (no jolt on first frame).
        //    Player_1.x_pos = Camera_X + CAM_SCREEN_HALF_W; same for Y.
        //    Camera_X/Y are WORLD coords (continuous-scroll), and the spawn
        //    derives purely from Camera_X — no SLOT_ORIGIN bias — so it is
        //    already world-correct. --
        move.w  Camera_X, d0                    // (Camera_X).w — high word of camera_x (16.16 -> integer px)
        addi.w  #CAM_SCREEN_HALF_W, d0
        pixels_to_coord(d0)
        move.l  d0, PLAYER_1_X_POS             // (Player_1+SST_x_pos).w
        move.w  Camera_Y, d0                    // (Camera_Y).w
        addi.w  #CAM_SCREEN_HALF_H, d0
        pixels_to_coord(d0)
        move.l  d0, PLAYER_1_Y_POS             // (Player_1+SST_y_pos).w
        clr.w   PLAYER_1_X_VEL                 // (Player_1+SST_x_vel).w
        clr.w   PLAYER_1_Y_VEL                 // (Player_1+SST_y_vel).w

        // -- name slot 0 the LEADER: the slot the camera follows and that the
        //    leader-following objects (path swap) track. Both read Camera_Target
        //    rather than a hardwired Player_1, so a roster that leads with
        //    another slot changes only this write. Stored off the `lea` because
        //    a link-time immediate cannot combine with a symbolic destination in
        //    one instruction.
        //
        //    ORDERING — the seed MUST precede the first read, and does by
        //    construction: this is the one-shot boot init (Game.entry), while
        //    BOTH readers live in the per-frame update state that only runs
        //    after it returns (Camera_Update from GameState_OJZScroll_Update;
        //    PathSwap_Init/_Main from RunObjects, their swappers spawned by
        //    EntityWindow_Scan). Nothing in this init spawns an object or runs
        //    the camera follow. Load-bearing, not tidiness: the cell boot-clears
        //    to 0, a NULL SST pointer into the vector table — not a benign
        //    "slot 0". --
        lea     Player_1, a0                    // (Player_1).w
        move.w  a0, Camera_Target               // (Camera_Target).w

        // -- set up Player_1 as the player (Sonic). Player_Init boots in
        //    debug-fly (yellow square) so the streaming-test workflow is
        //    unchanged — B drops into physics. --
        jbsr    Player_Init

        // -- THE BOOT-POSITION OVERRIDE (DEBUG shapes) — Aurora's "Build & Run at
        //    the editor cursor". The client writes Boot_At_X, Boot_At_Y, then
        //    Boot_At_Flag LAST (games/sonic4/config/ram.emp); this re-aims the
        //    authored start at it. Protocol prose: docs/ENGINE_ARCHITECTURE.md
        //    "§4.12", boot-override half.
        //
        //    WHY IT IS NOT A WARP, AND WHY THAT IS THE POINT. Booting at the
        //    authored start and warping afterwards costs the ~1.5 s the authored
        //    start takes to become playable plus a visible draw-then-jump, and it
        //    exposes the client to the whole mis-latch class §4.12 documents (every
        //    streaming latch has to be re-seeded after the fact, because the boot
        //    already seeded them somewhere else). This substitutes for the authored
        //    start AT THE POINT THE INIT CONSUMES IT, so there is nothing to
        //    re-seed: Section_Init, Player_BoundsInit, Tile_Cache_Init, the
        //    synchronous plane fill, Parallax_Init / BgAnim_Init / Parallax_Update
        //    all run exactly once, in exactly their authored order, already aimed at
        //    the override. NONE of Debug_Warp_Consume's reseed steps (4-7) appear
        //    here, and if one ever does, this has been hooked in the wrong place.
        //    Protocol prose: docs/ENGINE_ARCHITECTURE.md §4.12b.
        //
        //    HERE, AND NOT EARLIER OR LATER: this is the earliest point at which
        //    BOTH the camera seed (Camera_Init) and the leader's spawn position
        //    exist, and the last point before any consumer of either runs —
        //    Section_Init / Section_FillInitial / EntityWindow_Init /
        //    Tile_Cache_Init / Section_UpdateColumns all read Camera_X/Y and all of
        //    them are below. The authored Camera_Init + spawn are left to run
        //    untouched and are then overwritten, which costs a few dozen cycles once
        //    per boot and keeps the plain shape's ladder byte-identical.
        //
        //    TIMING — THE ONE PLACE THE NO-RACE CLAIM COULD HAVE BEEN WRONG, AND IT
        //    WAS. This mailbox CANNOT be written at the reset-paused machine the way
        //    the warp mailbox can be written at any paused frame: boot clears ALL
        //    64KB of Work RAM (engine/system/boot.emp `.clear_ram` — a ruling, there
        //    is no preserved region and none may be proposed), so a pre-resume write
        //    is zeroed before anything here can see it. The supported client window
        //    is AFTER the clear and BEFORE this init: a breakpoint on
        //    GameState_OJZScroll_Init (this proc — the game's Game.entry), write
        //    X/Y/flag on the hit, resume. Nothing has been displayed at that point —
        //    the display goes on at the bottom of this proc — so the FIRST VISIBLE
        //    FRAME is already the override's. Inside that window there is no race at
        //    all: the machine is stopped and the init is single-shot.
        //
        //    Idle (flag clear) this is two reads and a branch, and the boot is
        //    bit-identical to today's. Emits nothing in the plain shape. --
        if DEBUG == 1 {
                tst.b   Boot_At_Flag                    // (Boot_At_Flag).w
                beq     .no_boot_override               // idle: the authored start stands

                // The act clamp edges are not live yet: the ladder's own
                // Player_BoundsInit is BELOW this hook (it has to be — it reloads the
                // descriptor after Section_Init clobbers a0-a4). Run it here so the
                // override is clamped by the same edges the warp clamps against and
                // the same edges Player_LevelBound will enforce on frame 1. It is a
                // pure function of act-invariant descriptor fields, so the ladder's
                // later call recomputes the identical pair — idempotent by
                // construction, not by luck.
                lea     OJZ_Act1_Descriptor, a0         // (OJZ_Act1_Descriptor).l
                jbsr    Player_BoundsInit
                clamp_and_publish(Boot_At_X, Boot_At_Y) // d0/d1 = the clamped pair

                // Place the leader VERBATIM. No Player_SetState and none needed:
                // Player_Init has just run the full entry sequence (standing box,
                // PSTATE_AIR, physics row, debug-fly if armed) and this only moves
                // the result. That is also why §4.12's feet-planted-lift hazard
                // cannot arise on this path — there is no state transition after the
                // write. Velocities were zeroed by the spawn block above and
                // Player_Init does not disturb the position, so this is the only
                // placement write. Through Camera_Target, not the Player_1
                // absolutes: placement is a level-generic operation and the camera's
                // follow target is the engine's name for "the slot this level is
                // about" (Debug_Warp_Consume takes the same view).
                movea.w Camera_Target, a0               // (Camera_Target).w — leader SST
                pixels_to_coord(d0)                     // px -> 16.16, fraction cleared
                move.l  d0, Sst.x_pos(a0)
                pixels_to_coord(d1)
                move.l  d1, Sst.y_pos(a0)

                // Camera: the follow rule at rest, act-clamped. Overwrites
                // Camera_Init's authored seed before any consumer of it runs.
                center_camera_on(Boot_At_X, Boot_At_Y)
        .no_boot_override:
        }

        // -- write 4 marker tiles to VRAM (16x16 sprite = 2x2 tiles) at
        //    VRAM_TEST_MARKER, in the free gap below the BG region — the act
        //    art pool owns tiles 0..POOL_TILE_CEILING-1, so a low slot would
        //    stomp live FG art. All pixels colour 12 = solid block. Ints masked:
        //    a VBlank mid-copy retargets the VDP address and the tail longs land
        //    in the ISR's last write region (observed: 88/128 bytes arriving).
        //    Mirrors BG_Init's guard. --
        with ints_off {
            with z80_stopped {
                move.l  #vdp_comm(vram_bytes(VRAM_TEST_MARKER), VdpTarget.Vram, VdpOp.Write), VDP_CTRL   // (VDP_CTRL).l
                lea     PlayerMarkerTile(pc), a0
                moveq   #128/4 - 1, d0
            .copy_marker:
                move.l  (a0)+, VDP_DATA                // (VDP_DATA).l
                dbf     d0, .copy_marker
            }
        }

        // -- initialise section streaming (fills nametable over 3 VBlanks) --
        lea     OJZ_Act1_Descriptor, a0            // (OJZ_Act1_Descriptor).l
        jbsr    Section_Init

        // -- precompute the act-invariant player clamp edges (M3). Section_Init
        //    clobbers a0-a4, so reload the descriptor. --
        lea     OJZ_Act1_Descriptor, a0            // (OJZ_Act1_Descriptor).l
        jbsr    Player_BoundsInit

        // -- populate tile cache (must run AFTER Camera_Init + Section_Init so
        //    Camera_X and Current_Act_Ptr are valid) --
        jbsr    Tile_Cache_Init

        // -- synchronous plane fill: trigger Section_RedrawPlanes before display
        //    on so the nametable is fully populated from frame 1.
        //    WARP TWIN: Debug_Warp_Consume below repeats this two-line pair (and
        //    the Parallax boundary resolution further down). Both sites are
        //    ladders over the same pub procs; extracting the pair into a shared
        //    proc was rejected for this parcel because it would move RELEASE bytes
        //    and the parcel's hard gate is a byte-identical release ROM. If that
        //    constraint ever lifts, these are the two lines to hoist. Without this,
        //    Section_UpdateColumns gradually fills over ~3 frames, causing a
        //    visible snap when starting at non-zero X. --
        //    Section_RedrawPlanes owns its own Z80 posture in both build shapes
        //    (flag bracket with sound on, whole-storm bus hold with sound off),
        //    so this call is deliberately BARE — matching the per-frame call
        //    below. A caller-side bus hold here would be a FALSE lock:
        //    RedrawPlanes' internal flag bracket releases it on the way in, so
        //    the storm would run unheld anyway.
        st      Section_Plane_Dirty            // (Section_Plane_Dirty).w
        jbsr    Section_UpdateColumns

        // -- parallax init: pull the start section's parallax_config.
        //    Section_GetSecPtrXY handles the full grid math (sec_y included);
        //    runs after Section_Init so Current_Act_Ptr is valid. --
        lea     OJZ_Act1_Descriptor, a2            // (OJZ_Act1_Descriptor).l
        move.b  Act.start_sec_x(a2), d2 as GridX
        move.b  Act.start_sec_y(a2), d3 as GridY

        // -- BOOT-POSITION OVERRIDE, second and last consumer (DEBUG shapes): the
        //    only place below the placement block where the init still reads the
        //    AUTHORED start rather than the camera. An override into a different
        //    section must start on THAT section's parallax config — otherwise the
        //    first painted frame carries section (start_sec_x, start_sec_y)'s
        //    bands/palette and only the first Parallax_CheckBoundary of the update
        //    loop corrects it — as a lerp rather than a snap, since nothing here
        //    sets Parallax_Snap_Pending the way Debug_Warp_Consume does.
        //    Derived from the CLAMPED, already-published Boot_At_X/Y (the section
        //    containing the player), which is the same relation start_sec_* has to
        //    start_local_*.
        //
        //    WITNESSED since 2026-08-26 — this paragraph used to say the opposite
        //    and was made false by the work it predicted, so read the date before
        //    trusting any claim here about what is covered. What it said: every OJZ
        //    act 1 section bound `sec_parallax_config: default`, so poisoning this
        //    block changed no pixel, and tools/boot_override_gate.py asserted that
        //    PREMISE rather than imply coverage it did not have. Both halves ended:
        //    Aurora's first authored scene binds section 0, and the select below is
        //    now the shared three-way resolve (Sec.sec_parallax_config > the
        //    preset's ep_parallax > Act.act_parallax_config), so it reads the preset
        //    rung too. The gate now WITNESSES the select instead: it reads
        //    Parallax_Current_Config at the init's exit — before any
        //    Parallax_CheckBoundary can launder a wrong choice into a right one —
        //    against an expectation derived from the ROM's own section grid, and
        //    cross-checks the VDP reg $0B shadow and the band-scroll tail, which are
        //    written FROM the active config. Poisoning this block (DEBUG == 99) now
        //    fails it loudly on all three observables. Emits nothing in the plain
        //    shape. --
        if DEBUG == 1 {
                tst.b   Boot_At_Flag            // (Boot_At_Flag).w
                beq     .init_bootat_no_parallax
                move.w  Boot_At_X, d2           // (Boot_At_X).w — clamped world px
                lsr.w   #8, d2
                lsr.w   #SECTION_SIZE_SHIFT-8, d2 as GridX   // split 8+rest: max shift is 8/op
                move.w  Boot_At_Y, d3           // (Boot_At_Y).w
                lsr.w   #8, d3
                lsr.w   #SECTION_SIZE_SHIFT-8, d3 as GridY
        .init_bootat_no_parallax:
        }

        jbsr    Section_GetSecPtrXY             // a0 = start Sec ptr (Z set = none)
        beq     .init_use_act_config
        // The SAME resolution the crossing site uses (section > preset > act), so the
        // first painted frame and the first Parallax_CheckBoundary cannot disagree. This
        // used to be a private sec-else-act copy that never read the preset, while the
        // crossing read preset-else-act and never read the section — 2026-08-26.
        jbsr    Effects_ResolveParallax         // a0 = parallax_config*
        bra     .init_have_config
.init_use_act_config:
        movea.l Current_Act_Ptr, a0             // (Current_Act_Ptr).w
        movea.l Act.act_parallax_config(a0), a0
.init_have_config:
        jbsr    Parallax_Init
        jbsr    BgAnim_Init

        // -- prime HScroll/VScroll buffers so the first frame displays with
        //    correct scroll offsets (otherwise HScroll=0 for one frame) --
        jbsr    Parallax_Update

        // -- enable display now that VRAM and nametable are populated --
        move.b  #$74, VDP_Shadow_Table + VDP_MODE2_OFF   // shadow reg $01 = display/VBlank/DMA/M5 on

        // -- set VInt_Ptr to level handler --
        move.l  #VInt_Level, (VInt_Ptr).w   // explicit .w: link-imm source + relaxable dest can't share one instruction

        // The hand install of OJZ_WaterRaster that used to sit here is GONE (P-b Task 6),
        // and the reason it could not go earlier is now closed. It survived C2 Task 13 —
        // which deleted the Variant_Water_Deep bind beside it, since every OJZ preset
        // carries `variants: [Variant_Water_Deep, 0]` and Parallax_CheckBoundary's first
        // call binds section 0 before the first Update frame renders — purely because no
        // OJZ preset set ep_patched, making this the ONLY installer of a Buf_B program
        // anywhere in the tree. Task 7 gives a section preset a `patched:` binding, so the
        // preset path is now that installer and a hand install here would be a second,
        // competing one. Installing effects from a test's Init is exactly the "0 means keep
        // whatever the last section had" shape total binding exists to remove.

        // -- BOOT-POSITION OVERRIDE ack, and it must be the LAST write of the
        //    consumption, exactly as the warp's is: both consumers above read the
        //    flag, so clearing it earlier would half-apply the override. A client
        //    that reads Boot_At_Flag == 0 knows the whole init consumed it, and can
        //    read Boot_At_X/Y for the clamped origin the engine actually used.
        //    Emits nothing in the plain shape. --
        if DEBUG == 1 {
                clr.b   Boot_At_Flag            // (Boot_At_Flag).w
        }

        // -- transition to update loop --
        move.l  #GameState_OJZScroll_Update, (Game_State).w
        rts
}

// -----------------------------------------------
// GameState_OJZScroll_Update — per-frame update
// -----------------------------------------------
pub proc GameState_OJZScroll_Update () clobbers(d0-d7/a0-a6) {
        // -- FRAME TOP: the external warp mailbox. First thing in the frame's game
        //    work, before objects, camera follow and every streaming step, so a
        //    consumed warp is whole before anything can read the state it moved.
        //    Emits nothing in the plain shape. --
        if DEBUG == 1 {
                jbsr    Debug_Warp_Consume
        }

        // -- FRAME TOP: the external LIVE-OBJECT mailbox (spawn / move / delete),
        //    spliced INLINE because it is a comptime template rather than a proc —
        //    see objreq_consume's header for why that is a hard constraint and not a
        //    style choice.
        //
        //    ORDER AGAINST THE WARP IS LOAD-BEARING and it is this way round: a warp
        //    pending on the same frame lands FIRST, so a spawn issued with it takes
        //    effect at the destination rather than at the origin the warp is about to
        //    abandon. It also sits before RunObjects, so a spawn made this frame is
        //    dispatched this frame (unless AllocDynamic latched it at a full live
        //    list, which is the engine's ordinary saturated-frame behaviour and not
        //    something this mailbox alters), and before the camera follow, so a MOVE
        //    is already in place when the culling test reads it.
        //
        //    Emits nothing in the plain shape. --
        if DEBUG == 1 {
                objreq_consume()
        }

        // -- DEBUG character-cycle hotkey (A, while in debug mode). Polled before
        //    RunObjects, so the debug_flag it gates on is the state the player
        //    ENTERED this frame with — a B press later this same frame toggles
        //    after the poll, which is what makes B-then-A read as two frames.
        //    Emits nothing in the plain shape. --
        if DEBUG == 1 {
                jbsr    Debug_CharacterHotkey
        }

        // -- DEBUG effects-lab hotkey (START held + LEFT/RIGHT pressed): step the ONE
        //    list — scenes, raster programs (bands OFF among them) and per-section
        //    presets, in one ordered run — and install whatever the cursor lands on
        //    through that entry's own engine slot. Polled beside the character hotkey,
        //    before RunObjects, so the swap is whole before the camera moves and before
        //    Parallax_CheckBoundary runs later in the frame — an install made AFTER the
        //    boundary check would be re-decided by the check on the next crossing frame
        //    instead of surviving to be looked at.
        //
        //    IT REPLACED THREE CALLS HERE, not one: the scene cycle, the raster cycle
        //    and the preset cycle were three procs polled in a fixed order, and the
        //    order was load-bearing (the preset install writes every channel, so it had
        //    to run LAST or a same-frame scene press would land underneath it). One
        //    list of mutually-exclusive entries deletes that ordering problem outright —
        //    a press installs exactly one thing.
        //
        //    Emits nothing in the plain shape. --
        if DEBUG == 1 {
                jbsr    Debug_LabCycleHotkey
        }

        // -- DEBUG effects-lab BG-ANIMATION tier (START held + C pressed, no direction):
        //    step the BG tile-band animation OFF -> the Camera_X view -> the Camera_Y
        //    view -> the TIMER view -> the two off-screen axis probes -> OFF.
        //    Polled beside the other three because it is the same review session, and
        //    LAST because it is the only tier a preset install does NOT overwrite: the
        //    BG band table is not an EffectsPreset channel, so unlike the scene, raster
        //    and preset tiers this one survives a section crossing and is undone only by
        //    pressing it round. Ordering against the three above is therefore not
        //    load-bearing in either direction — they write disjoint state
        //    (BgAnim_Table_Ptr vs. Raster_Pending / Parallax_Active_Config / the palette
        //    channels) — and it is last so the read of the frame's chords ends with the
        //    one that outlives the frame. Emits nothing in the plain shape. --
        if DEBUG == 1 {
                jbsr    Debug_BgAnimViewHotkey
        }

        // -- DEBUG effects-lab NAME TAGS: spell out, in letters, which raster program
        //    and which BG-animation band table are actually live (EFFECTS-W1 F4, the
        //    owner's ask: "can we get it to write out what it's supposed to be in
        //    oracle like start + left/right does?").
        //
        //    LAST of the five, and unlike the four above it this is NOT a hotkey: it is
        //    a POLLER over two engine cells (Raster_Program, BgAnim_Table_Ptr). That is
        //    what makes it truthful where a cursor-driven label would not be — a section
        //    crossing re-installs a preset through Effects_InstallPreset and moves the
        //    raster channel without touching any lab cursor, and this proc follows it.
        //    See Debug_TierTags_Update's header for the whole argument.
        //
        //    Ordering IS load-bearing, in one direction only: it must run AFTER the four
        //    chords so an arming press is seen on the frame it happens rather than the
        //    next one. It reads engine state and writes only VRAM cells, two sprite
        //    slots and its own two mirrors, so nothing downstream in the frame depends
        //    on it. Emits nothing in the plain shape. --
        if DEBUG == 1 {
                jbsr    Debug_TierTags_Update
        }

        // -- initialize sprite system for this frame --
        jbsr    InitSpriteSystem

        // -- execute all objects (Player_Main handles its own movement) --
        jbsr    RunObjects

        // -- camera follows Player_1 (deadzone + preview-aware clamp).
        //    DEBUG scene-pin: skip so a write_memory Camera_X/Y stays put. --
        if DEBUG == 1 {
                tst.b   Debug_Scene_Freeze     // (Debug_Scene_Freeze).w
                bne     .skip_camera_update
        }
        jbsr    Camera_Update
        if DEBUG == 1 {
        .skip_camera_update:
        }

        // -- latch every patch channel's screen line from its world anchor. HERE, between
        //    Camera_Update and Parallax_Update, and not in VBlank: the parallax overlay reads
        //    it below in this same frame while Raster_BuildSchedule reads it from the VBlank that
        //    follows, so a VBlank-computed latch would reach the two of them one camera apart
        //    and pop every boundary transition. It runs OUTSIDE the Debug_Scene_Freeze gate on
        //    purpose — a hand-written Camera_Y still has to be latched, or the frozen scene
        //    renders against the camera it had before the write. --
        jbsr    Effects_LatchWorldLines

        // -- fill tile cache with new blocks as camera scrolls --
        jbsr    Tile_Cache_Fill

        // -- DEBUG: the page-cache residency audit's PERIODIC tick (fix F5 of the
        //    streaming-choke arc, 2026-08-19). A SIBLING of the fill, never a child
        //    of it.
        //
        //    WHY IT IS HERE AND NOT IN THE ENGINE. This gate used to sit at the top
        //    of Tile_Cache_Fill, which charged PageCache_Audit's ~110,000-cycle
        //    nametable walk to the fill's profiler row: 3,548 cyc/frame = 7,333
        //    cyc/tick amortised at sustained max-diagonal (6.9% of the fill), 80.3%
        //    of it at idle, and — because it fires on its own 128-pass phase — a
        //    contaminant in one DEBUG measurement window in four. Tile_Cache_Fill is
        //    the routine the whole streaming arc measures, so a DEBUG-only invariant
        //    check had to come out of it. It is scheduled HERE, by the level state,
        //    for the same reason Tile_Cache_Fill itself is: the tick owns its own
        //    schedule. The check, the interval and the counter all stay engine-owned
        //    (PageCache_Audit / PAGECACHE_AUDIT_INTERVAL / Page_Audit_Ticks); only
        //    the "when" is the state's. Spelled INLINE rather than as an engine
        //    proc on purpose — a new engine label, even a zero-byte DEBUG-only one,
        //    lands in the release deb2 appendix and moves demo.bin's CRC (measured:
        //    aae04929 -> 6710c1ac, appendix-only, everything before EndOfRom
        //    identical). Inline, both release shapes stay byte-identical.
        //
        //    CADENCE IS UNCHANGED. Tile_Cache_Fill's own once-per-physical-frame
        //    gate meant the old counter advanced once per LOGIC TICK, not once per
        //    frame (measured at idle: Page_Audit_Ticks 109 -> 11 over 30 ticks / 31
        //    frames). This runs once per tick from the same tick, so the audit still
        //    fires every PAGECACHE_AUDIT_INTERVAL = 128 ticks. What it audits is now
        //    the state THIS tick's fill produced rather than the previous one's —
        //    strictly fresher, never staler.
        //
        //    THE WITNESS IT PRESERVES. PageCache_Audit is the machine check on the
        //    §5 safety invariant: pf_refcount == live nametable words pointing at
        //    the frame, PF_EVICTABLE => assigned+rc0+unpinned, page<->frame is a
        //    bijection, no assigned-but-unreclaimable frame. Every one of those
        //    corruptions is MONOTONE — nothing re-derives pf_refcount from the
        //    nametable, so once the two disagree they stay disagreeing until the
        //    next act load (PageCache_Init) or warp (PageCache_ResetRefcounts). A
        //    drift is therefore never MISSED by a periodic audit, only reported
        //    late, and the maximum lateness is one interval: 128 ticks (~2.1 s at 60
        //    Hz, ~4.3 s while the streaming path lags at 2 frames/tick). That is
        //    exactly the window the in-fill gate had.
        //
        //    Emits nothing in the plain shape. --
        if DEBUG == 1 {
                addq.w  #1, Page_Audit_Ticks
                cmpi.w  #PAGECACHE_AUDIT_INTERVAL, Page_Audit_Ticks
                blo     .no_page_audit
                clr.w   Page_Audit_Ticks
                jbsr    PageCache_Audit
        .no_page_audit:
        }

        // -- continuous scroll: no per-frame teleport check. Camera/player/
        //    section streaming run in WORLD space; the level scrolls live with
        //    no section rebases. --

        // -- camera-driven entity scan (load/despawn rings + objects).
        //    DEBUG scene-pin: skip so a hand-placed ring isn't despawned/reloaded.
        //    (Despawn lives inside EntityWindow_Scan's body, so one gate covers both.) --
        if DEBUG == 1 {
                tst.b   Debug_Scene_Freeze     // (Debug_Scene_Freeze).w
                bne     .skip_entity_scan
        }
        jbsr    EntityWindow_Scan
        if DEBUG == 1 {
        .skip_entity_scan:
        }

        // -- per-column nametable streaming --
        jbsr    Section_UpdateColumns

        // -- collision detection --
        jbsr    TouchResponse

        // -- DEBUG-FLY RING GATE. In free flight the player is a camera, not a
        //    character: he passes through terrain and is exempt from the state
        //    machine, so flying across a ring must not bank it (and, worse,
        //    permanently mark it collected in Ring_Collected_Window — the ring
        //    does not come back when you leave debug mode).
        //
        //    WHY HERE AND NOT IN Player_Main. Player_Main's escape hatch
        //    (`tst.b PlayerV.debug_flag(a0); bne Player_DebugMove`) suspends the
        //    player's OWN physics, state dispatch and display tail — everything
        //    reached THROUGH the player object. Ring collection is not one of
        //    those things: RingCollision is a level-state pass that walks the ring
        //    buffer and reads the player slots from the outside, so it runs no
        //    matter what the player object does with its own frame. The hatch
        //    cannot suppress a caller it is not called from; the suppression has
        //    to happen at the call.
        //
        //    WHY HERE AND NOT INSIDE RingCollision. debug-fly is a SONIC 4
        //    concept: `debug_flag` is a byte in games/sonic4's PlayerV overlay of
        //    the SST custom window, and the engine has no name for it and must not
        //    grow one (ENGINE_ARCHITECTURE, "Engine/game contract" — the seam is
        //    the typed Game interface, and there is no hook here that could carry
        //    it: Game.ring_collected fires AFTER the collect is already banked, so
        //    it is a visual hook, not a veto). The engine offers the ring pass as
        //    a service; deciding when this game wants it run is the game's call,
        //    exactly like the Debug_Scene_Freeze skips above.
        //
        //    NOT `if DEBUG == 1`. Debug-fly is a runtime CHEAT, not build-time
        //    debug equipment (player_common.emp's Player_Main gate: the payload
        //    ships in every shape behind CHEAT_DEBUG_FLY in Cheat_Flags). A
        //    build-time gate would leave the bug live in exactly the shape where
        //    a cheat code arms the bit. These four instructions are release code.
        //
        //    ONE SLOT IS THE WHOLE ANSWER HERE, and that is derived, not assumed:
        //    RingCollision loops NUM_PLAYERS slots but skips any with code_addr
        //    == 0, and this state spawns the leader only (Player_1 — the same
        //    single-slot fact Debug_CharacterHotkey's `lea Player_1, a0` rests
        //    on). So testing the leader is exactly a per-player gate today. The
        //    day this state spawns Player_2, this becomes too broad: P1 flying
        //    would stop P2 collecting, and the gate then has to move inside the
        //    engine loop behind a generic per-SST "does not pick up" status bit
        //    the game sets. Booked in DEFERRED_WORK. --
        lea     Player_1, a0
        tst.b   PlayerV.debug_flag(a0)
        bne     .skip_rings
        jbsr    RingCollision
    .skip_rings:

        // -- build sprite table from priority bands + ring sprites.
        //    (Render_Sprites manages Sprite_Table_Dirty itself, including the
        //    zero-sprite terminator case — no forced dirty needed) --
        jbsr    Render_Sprites

        // -- Derive active flat section_id (2D-correct). flat_id = sec_y *
        //    grid_w + sec_x, computed once and reused. Continuous-scroll:
        //    Camera_X/Y are WORLD px, so the active section is the one under the
        //    camera CENTER — derive it straight from the world camera
        //    (camX+160 / camY+112 >> SECTION_SIZE_SHIFT), no slot map or
        //    SLOT_ORIGIN bias. Always in-grid (camera is clamped to the act), so
        //    Section_FlatIDXY needs no range check. --
        movea.l Current_Act_Ptr, a0             // (Current_Act_Ptr).w
        move.w  Camera_X, d2                    // (Camera_X).w — world X px
        addi.w  #SCREEN_WIDTH/2, d2
        moveq   #SECTION_SIZE_SHIFT, d0
        asr.w   d0, d2                          // d2 = sec_x of the camera center
        move.w  Camera_Y, d3                    // (Camera_Y).w — world Y px
        addi.w  #SCREEN_HEIGHT/2, d3
        asr.w   d0, d3 as GridY                 // d3 = sec_y of the camera center
        movea.l a0, a2                          // Section_FlatIDXY wants act ptr in a2
        jbsr    Section_FlatIDXY                // d0.w = flat section_id
        move.w  d0, d6                          // save flat_id for T14 + T15

        // -- per-section parallax: re-select the config on a section-boundary
        //    crossing. Edge-triggered inside Parallax_CheckBoundary (watches
        //    the section under the camera centre, same as flat_id above). --
        jbsr    Parallax_CheckBoundary

        // -- The per-frame Raster_PatchWaterWorldY call that used to sit here is GONE (P-b
        //    Task 6). PATCHING moved INTO Raster_VBlank (Raster_BuildSchedule) and that move is
        //    load-bearing, not tidying: every arm word is a RELATIVE gap, so a patch running
        //    from the main loop races Raster_HInt walking the same buffer during active
        //    display and desynchronises the whole tail of the chain. The single-word water
        //    patch got away with main-loop timing only because its one arm is consumed at
        //    the frame-top rewind, which made it structurally a next-frame write.
        //
        //    WHAT REPLACES IT, below: the AFFORDANCE that call provided — move a boundary
        //    live and watch it track — restored through the only interface that is
        //    race-safe. Writing an ANCHOR from the main loop is safe precisely because it
        //    is not a patch: it lands in RAM, and the next Raster_BuildSchedule converts every
        //    anchor to arm bytes in one pass at VBlank. That main-loop-write -> VBlank-
        //    conversion seam is the whole point of keeping anchors in RAM, and this is the
        //    only thing in the tree that crosses it.
        //
        //    C+UP / C+DOWN nudge channel 0's world anchor by one pixel per held frame,
        //    both directions so BOTH band clamps are reachable by hand. DEBUG-gated and
        //    INPUT-gated on purpose: a free-running counter would perturb every frame of
        //    every build of this scene, moving the visual baseline and risking a desync in
        //    the replay fixtures for no benefit. Input-gated code is inert by default — a
        //    replay that never presses the chord is bit-identical. C is unclaimed here
        //    (A is the character-cycle hotkey, B the debug toggle).
        //
        //    It is ALSO the only call site of Effects_SetWorldY in the tree, and that is
        //    why it exists rather than being convenience. The proc's four instructions are
        //    assembled either way — what an uncalled `pub proc` cannot pin is its CONTRACT:
        //    that d1 is WORLD space and not camera-relative, and that the proc and the
        //    preset seed loop agree on Effects_World_Y's base and element size. Widen the
        //    array or reshape the seed and an uncalled setter rots silently until the first
        //    content parcel inherits a broken handle. This is the same failure class that
        //    let fx_tint_band ship broken for two parcels, reached by drift instead of by
        //    never being elaborated.
    if DEBUG == 1 {
        move.b  Ctrl_1_Held, d0                 // held, not press — nudge per frame
        andi.b  #BUTTON_C, d0
        beq     .no_anchor_nudge
        moveq   #0, d1                          // d1 = signed step, 0 until a direction
        move.b  Ctrl_1_Held, d0
        btst    #BUTTON_UP_BIT, d0
        beq     .anchor_not_up
        moveq   #-1, d1
    .anchor_not_up:
        btst    #BUTTON_DOWN_BIT, d0
        beq     .anchor_not_down
        moveq   #1, d1
    .anchor_not_down:
        tst.w   d1
        beq     .no_anchor_nudge                // C alone, or C with both: no move
        add.w   Effects_World_Y, d1             // channel 0's current anchor + step

        // Clamp the nudge to channel 0's own declared raster band, converted into world
        // space. Two reasons, and the second is the load-bearing one:
        //
        //  1. Below the band the hotkey would otherwise drive the anchor somewhere
        //     Raster_BuildSchedule silently clamps anyway, so the palette boundary would stop
        //     tracking while the anchor kept moving — under the very instrument used to watch
        //     them track together. That is still true at the LO edge and the clamp stays there.
        //     IT IS NO LONGER TRUE AT THE HI EDGE. Past band_hi the builder does not clamp, it
        //     DROPS the record (the whole point of the local-removal parcel), so a hi clamp here
        //     would fence this instrument out of the one state it most needs to reach — the
        //     hotkey could never show the boundary going away. The hi clamp is therefore gone
        //     and the nudge may leave the band upward, into suppression.
        //  2. It is the ONLY call site of Raster_GetChannelBand. A `pub proc` is assembled
        //     whether or not anything calls it; what an uncalled one cannot pin is its
        //     CONTRACT — that d0 selects a channel, that d0=0 back means "no band declared",
        //     and that the returned pair is FIRE lines needing the +1 to reach screen space.
        //     Reshape any of those and an uncalled accessor rots silently until the first
        //     content parcel inherits a broken handle. Same failure class as fx_tint_band.
        //
        // d0-d3 are dead here (Section_FlatIDXY's sec_x/sec_y are consumed); d6 holds
        // flat_id for T15 below and is NOT touched.
        move.w  d1, -(sp)                       // candidate world Y
        moveq   #0, d0                          // channel 0
        jbsr    Raster_GetChannelBand           // d0 = found; d1/d2 = lo/hi FIRE lines
        tst.w   d0
        beq     .anchor_pop_unclamped           // no band declared -> no clamp is correct
        move.w  Camera_Y, d0                    // 16.16 -> the integer word
        addq.w  #1, d0                          // fire line -> screen line, once for both
        add.w   d0, d1                          // d1 = band lo in WORLD Y
        add.w   d0, d2                          // d2 = band hi in WORLD Y
        move.w  (sp)+, d0                       // d0 = candidate
        cmp.w   d1, d0
        bge     .anchor_lo_ok
        move.w  d1, d0                          // LO only — see 1. above; hi must stay reachable
    .anchor_lo_ok:
        move.w  d0, d1                          // d1 = clamped world Y
        jbra    .anchor_do_set
    .anchor_pop_unclamped:
        move.w  (sp)+, d1
    .anchor_do_set:
        moveq   #0, d0                          // channel 0
        jbsr    Effects_SetWorldY
    .no_anchor_nudge:

        // -- C+LEFT / C+RIGHT arm an APPROACH ramp on channel 0 and let go: the flood runs
        //    by itself from there, one pixel every four frames, until it arrives and stops.
        //    EFFECTS-W1 item 4's second motion term.
        //
        //    IT IS HERE FOR THE SAME REASON THE NUDGE ABOVE IS, and the reason is stated at
        //    length there: this is the ONLY call site of Effects_SetTargetY in the tree. The
        //    proc's ten instructions are assembled either way — what an uncalled `pub proc`
        //    cannot pin is its CONTRACT: that d1 is WORLD space, that d2 is a rate SHIFT and
        //    not a mask, and that the proc and the mover's loop agree on Effects_Target's and
        //    Effects_RateMask's bases and element size. Reshape any of those and an uncalled
        //    setter rots silently until the first content parcel inherits a broken handle.
        //
        //    AND IT IS WHY APPROACH IS NOT A DORMANT SCAFFOLD. The ramp has no authored seed
        //    — `ep_patch_motion` carries the SWEEP only, and the ramp's authoring surface is
        //    the same blocked contract change (docs/DEFERRED_WORK.md). What ships is the
        //    runtime handle a boss, a switch or a cutscene drives, exercised here.
        //
        //    THE TARGETS ARE THE CHANNEL'S OWN BAND EDGES, converted to world space by the
        //    same `+ Camera_Y + 1` the clamp above uses, so LEFT drains the water to the top
        //    of what the raster can express and RIGHT floods it to the bottom. Reusing the
        //    band means the ramp cannot be armed at a target the boundary could never reach.
        //
        //    RATE SHIFT 2 = one pixel every four frames = 0.25 px/frame, which is Ristar's
        //    monotone waterline rate ($4000 per frame on its 16.16 accumulator) to the frame.
        //    An integer px/frame speed — S.C.E.'s and stock S2's `Water_speed` — makes 1
        //    px/frame the SLOWEST possible flood, 60 px/s, the screen in under four seconds.
        move.b  Ctrl_1_Held, d0
        andi.b  #BUTTON_C, d0
        beq     .no_flood_arm
        move.b  Ctrl_1_Held, d0
        moveq   #0, d3                          // d3 = 0 none / -1 drain / +1 flood
        btst    #BUTTON_LEFT_BIT, d0
        beq     .flood_not_left
        moveq   #-1, d3
    .flood_not_left:
        btst    #BUTTON_RIGHT_BIT, d0
        beq     .flood_not_right
        moveq   #1, d3
    .flood_not_right:
        tst.w   d3
        beq     .no_flood_arm                   // C alone, or C with both: no arm
        moveq   #0, d0                          // channel 0
        jbsr    Raster_GetChannelBand           // d0 = found; d1/d2 = lo/hi FIRE lines
        tst.w   d0
        beq     .no_flood_arm                   // no band declared -> nothing to ramp toward
        move.w  Camera_Y, d0                    // 16.16 -> the integer word
        addq.w  #1, d0                          // fire line -> screen line, once for both
        tst.w   d3
        bmi     .flood_drain
        add.w   d2, d0                          // d0 = band HI in world Y
        jbra    .flood_have_target
    .flood_drain:
        add.w   d1, d0                          // d0 = band LO in world Y
    .flood_have_target:
        move.w  d0, d1                          // d1 = target world Y
        moveq   #2, d2                          // rate shift: 0.25 px/frame
        moveq   #0, d0                          // channel 0
        jbsr    Effects_SetTargetY
    .no_flood_arm:
    }


        // -- T15 diagnostic: per-section sky-color marker --
        move.w  d6, d0                          // flat section_id
        cmpi.b  #9, d0                          // clamp to grid size (3x3 = 9 sections)
        blo     .marker_id_ok
        moveq   #0, d0
.marker_id_ok:
        lea     OJZ_SectionMarkerColors(pc), a3
        add.w   d0, d0
        move.w  (a3, d0.w), d1                  // d1 = section's marker color
        move.w  d1, Palette_Buffer             // CRAM[0] = backdrop tint — (Palette_Buffer).w
        ori.b   #1, Palette_Dirty             // flag palette line 0 dirty — (Palette_Dirty).w

        // -- update HScroll buffer + Vscroll (parallax). Parallax_Update owns the
        //    per-frame VDP reg $0B (Mode Set 3) re-assert from the active config
        //    (shadow + direct hardware write), so the mode stays in lockstep with
        //    the HScroll/VSRAM buffers it builds here. --
        jbsr    Parallax_Update

        // -- DEBUG effects-lab tier: EFFECTS-W1 item 10a "reels" demo. Overrides the
        //    per-column V-scroll buffer Parallax_Update just filled, right after it
        //    fills it and before Vscroll_Write's VBlank DMA reads it — see
        //    OJZ_Reels_Fill's header (games/sonic4/data/effects/ojz_effects.emp) for
        //    what it writes and why. No hotkey installs it (Debug_BandDemoHotkey's
        //    header enumerates the exhausted pad chords): toggled only by
        //    tools/reels_witness.py poking OJZ_Reel_Active directly, the same pattern
        //    band_witness.py uses for OJZ_BandDemo. Emits nothing in the plain
        //    shape. --
        if DEBUG == 1 {
                tst.b   OJZ_Reel_Active         // (OJZ_Reel_Active).w
                beq     .skip_reels_fill
                jbsr    OJZ_Reels_Fill
        .skip_reels_fill:
        }

        // -- camera-driven BG tile animation (trunk cores) --
        jbsr    BgAnim_Update

        // -- the Hydrocity waterline's ART half (EFFECTS-W1 item 9d) --
        //    AFTER Parallax_Update, which is what publishes Waterline_Art_Row, and before
        //    VSync_Wait, for BgAnim_Update's reason: deferrable entries drain only in
        //    VInt_Level, which cannot run until VBlank_Ready is set.
        //
        //    UNCONDITIONAL, like the call above it, and gated INSIDE the proc on this
        //    game's CAP_ROW_REMAP. The source image is passed rather than looked up by a
        //    well-known name so that a game with no waterline emits no art (see the proc's
        //    header). It is the game's data because the ladder it is indexed by is the
        //    game's data — both live in data/effects/scene_registry.emp, emitted adjacently.
        lea     WaterlineStripArt, a0
        jbsr    Waterline_Art_Update
        rts
}

// -----------------------------------------------
// Debug_CharacterHotkey — inside debug mode, A cycles the active character
// (Sonic -> Tails -> Knuckles -> Sonic).
//
// THE BINDING: B enters and leaves debug mode (Player_Main's cheat-gated
// toggle, unchanged). While debug mode is ACTIVE, A cycles the character. C is
// untouched and stays a jump button; BUTTON_JUMP_MASK is not modified. In normal
// play A is a jump button and nothing here fires — the whole affordance lives
// behind the debug_flag gate. So the round trip is: B, A, B, and you are Tails.
//
// WHY A IS FREE — AND ONLY IN DEBUG MODE. Player_Main's debug escape hatch
// (`tst.b PlayerV.debug_flag(a0); bne Player_DebugMove`) sits BEFORE the jump
// latch, the physics and the state dispatch, so while debug_flag is set none of
// those ever see the pad. (It does NOT reach ring collection — this comment used
// to claim it did, and that claim is what let debug-fly bank rings for as long as
// it did. RingCollision is a level-state pass; its gate is at its call site in
// GameState_OJZScroll_Update.) What does run is Player_DebugMove, and it
// reads Ctrl_1_Held and tests LEFT/RIGHT/UP/DOWN only — A and C do nothing
// whatsoever in free flight. That is the whole safety argument, and it is why
// the gate is on debug_flag rather than on some free button: outside debug mode
// A keeps its jump meaning bit for bit.
//
// WHY IT LIVES IN THE LEVEL STATE. The canonical DEBUG shape binds NO game
// debug_tick: config/game.emp binds the hook only under SOUND_DEBUG_HOTKEYS,
// i.e. the off-canonical Config-A profile, so a hotkey hosted in game_debug.emp
// would emit zero bytes in the ROM this is actually played in. This scene is the
// de-facto game state and already carries DEBUG-gated work, so the affordance
// sits with the thing it affords. Move it to a proper debug hook the day the
// canonical debug shape binds one.
//
// DEBUG-shape only: the body — the rts included — sits inside `if DEBUG == 1 {}`,
// so the whole proc emits ZERO bytes in the plain shape (the Debug_AssertObjLoop
// idiom, engine/objects/core.emp).
//
// THE REPLAY GUARD IS LOAD-BEARING HERE. A is an ordinary main-pad bit, so
// unlike a 6-button extension bit it IS recorded in a fixture and IS replayed by
// Input_Tick's INPUT_PLAYBACK arm — and the slide fixture deliberately enters
// debug-fly to exercise vertical flight, so a recorded A press would land
// squarely inside the gate and swap characters mid-run. The hotkey is therefore
// LIVE-ONLY: it stands down for INPUT_PLAYBACK and, deliberately, for
// INPUT_RECORD too. Gating only playback would let a dev cycle characters while
// RECORDING, baking an A press into a fixture that playback then ignores — the
// recorded run and its replay would diverge, which is exactly the desync the net
// exists to catch. One `tst.b` covers both because INPUT_LIVE is 0 (asserted
// below).
//
// WHY A NARROW REFRESH AND NOT Player_Init. Player_Init is the LEVEL-ENTRY
// initializer: it forces PSTATE_AIR, clears ground speed / move lock / spindash
// charge / the whole status set, and tail-calls Player_DebugEnter whenever
// CHEAT_DEBUG_FLY is armed — which, since this only ever runs while already in
// debug mode, would re-enter free flight and clear the player's velocity every
// press. This touches only what varies per character.
//
// THE SWAP IS ALWAYS DEFERRED TO THE EXIT, and that is by construction, not an
// edge case: the gate means we only ever fire while the marker square owns the
// SST's art. So this updates the RECORD half — Player_Chardef and the slot's
// physics row — and Player_DebugExit does the visual half on the way out. It
// re-runs Player_InitAssets off the (now new) Player_Chardef, clears
// mapping_frame, re-caches the piece count, and sets prev_anim/prev_frame = $FF,
// which forces Player_Display's next pass to re-select the animation and re-run
// Player_LoadArt — the DPLC stream that actually re-DMAs the new character's
// tiles. Nothing is left for this routine to do, so it does not do it.
//
// THE APPENDAGE IS THE ONE THING THE NARROW REFRESH CANNOT LEAVE TO THE EXIT.
// Everything else that varies per character lives in the player's own SST, which
// Player_DebugExit rebuilds; Tails' twin tails are a SEPARATE OBJECT, so a swap
// away from him would leave it parented to a body that is no longer his. The
// reconcile call at the tail below owns both directions.
//
// In:  none (reads/writes Character_ID)
// Out: Character_ID advanced, Player_Chardef + the slot's physics row re-resolved,
//      the appendage object spawned/removed to match the new record
// Clobbers: d0-d2, a0-a2 — a1-a2 via Player_RefreshPhysics; d1-d2 via
//           TailsAppendage_Refresh (DeleteChildren's chain cursor).
// -----------------------------------------------
ensure(INPUT_LIVE == 0, "Debug_CharacterHotkey's live-only gate is a tst.b — INPUT_LIVE must be 0")

proc Debug_CharacterHotkey () clobbers(d0-d2/a0-a2) {
    if DEBUG == 1 {
        // Three gates, and nothing is written until all three pass — on any
        // other frame this routine is a few reads and a branch to the rts.
        tst.b   Input_Source                    // (Input_Source).w
        bne     .done                           // replaying or recording: stand down
        move.b  Ctrl_1_Press, d0                // tick-stable press latch
        move.b  d0, d1                          // keep the raw press for the B veto below
        andi.b  #BUTTON_A, d0
        beq     .done
        // B veto: a B press this frame is the free-flight TOGGLE (Player_DebugExit runs
        // later this frame). This poll reads the FRAME-ENTRY debug_flag, so B+A pressed
        // together would otherwise cycle the character on the very frame the player meant
        // to LEAVE debug-fly — the "A cycled unexpectedly" surprise. Fumbling B+A now
        // just exits fly, no cycle.
        andi.b  #BUTTON_B, d1
        bne     .done
        // ⚠ A THIRD VETO STOOD HERE UNTIL 2026-09-05 AND IS DELETED, not lost. It
        // vetoed START held, and it existed for exactly one reason: START+A was the
        // PRESET cycle's chord. The chord consolidation retired that chord — the preset
        // list is now rows of Debug_LabCycleHotkey's ONE list, walked with
        // START+LEFT/RIGHT — so nothing anywhere pairs START with A any more, and a veto
        // whose subject no longer exists is a dormant scaffold that quietly makes
        // START+A inert for the next person who tries to use it. A alone cycles
        // characters again, which is what it did before that chord was minted. The pad
        // space this frees is stated in Debug_LabCycleHotkey's header.
        //
        // C veto: C held is the effects lab's OTHER modifier — the anchor-nudge and
        // approach-ramp chords in this module, and (with START) the BG-animation cycle.
        // Same shape as the B veto above and for the same reason: a reviewer holding a
        // lab modifier who taps A means the lab, not a character swap.
        //
        // ⚠ ITS ORIGINAL REASON EXPIRED ON 2026-09-04 AND THE VETO WAS KEPT ANYWAY, so
        // read this before deleting it as dead (the START veto beside it, whose reason
        // expired the same way a day later, WAS deleted — the difference is that C is
        // still a live modifier and START+A is now nothing at all). It was planted for
        // C+A, which WAS the
        // BG-animation cycle's chord; that chord moved to START+C (see
        // Debug_BgAnimViewHotkey's header), so C+A now collides with nothing. What is
        // left is the sentence above, which was always the general form of the argument
        // and still holds on its own: C+UP/DOWN and C+LEFT/RIGHT are live chords, a
        // reviewer nudging with C who fumbles A would otherwise swap Sonic for Tails,
        // and that is the same surprise the B veto exists to remove.
        // HELD, not press, because C is a chord modifier and must still count on the
        // frames after the one it went down on; a reviewer not holding C pays nothing.
        // d2 is free here — the character index does not land in it until below.
        move.b  Ctrl_1_Held, d2                 // tick-stable held latch
        andi.b  #BUTTON_C, d2
        bne     .done
        lea     Player_1, a0                    // the leader slot — the only one this
                                                // state spawns
        // DEBUG-MODE gate: cycle ONLY while the player is actively in debug free-flight
        // (debug_flag), where A has no other meaning. In normal physics gameplay
        // debug_flag is 0 and A is the jump button — this is a DEBUG-MODE test, NOT a
        // raw CHEAT_DEBUG_FLY-armed check (the cheat can be armed while the player is in
        // physics; debug_flag is only set while actually flying).
        tst.b   PlayerV.debug_flag(a0)
        beq     .done                           // not in debug-fly: A is the jump button

        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.w  Character_ID, d0
        addq.w  #1, d0
        cmpi.w  #CHAR_COUNT, d0                 // the id only ever steps by one, so
        bne     .no_wrap                        // equality is the whole wrap condition
        moveq   #0, d0
    .no_wrap:
        assert.w d0, ls, #CHAR_COUNT-1          // id in roster range — Player_Init's guard,
                                                // checked BEFORE the store so a bad value
                                                // never reaches RAM
        move.w  d0, Character_ID

        // roster resolve — the same derivation Player_Init runs, repeated here
        // rather than reached through Player_Init because calling Player_Init is
        // the thing this routine exists to avoid (see the header). Every id in
        // 0..CHAR_COUNT-1 lands on a complete CharacterDef, so cycling past
        // Tails is safe.
        //
        // This used to say the CHAR_KNUCKLES row was still the Sonic record. It
        // has not been since the TEMP stub was removed — characters.emp binds
        // extern("CharDef_Knuckles") and says so right above the table. The
        // stale sentence was load-bearing in the wrong direction: on 2026-09-03
        // it is why a straddle measurement was abandoned as unreachable when
        // cycling to Knuckles would in fact have driven the counter positive,
        // which is what it then did (docs/measurements/2026-09-03-dma-split-
        // reserve-reading.md). Cycling here loads each character's REAL art.
        lsl.w   #2, d0                          // × sizeof(pointer); no scaled
                                                // indexing on the 68000
        lea     CharacterDefs, a1
        movea.l (a1,d0.w), a1
        move.l  a1, Player_Chardef

        player_block(a0, a2)                    // this slot's block — Refresh writes its row
        jbsr    Player_RefreshPhysics

        // THE APPENDAGE HALF OF THE SWAP, and it belongs to this routine rather
        // than to Player_DebugExit's visual half because it is a two-DIRECTION
        // reconcile: switching AWAY from Tails has to remove the tails, and
        // Player_DebugExit runs on every character's way out of free flight with
        // no knowledge of which record it left. TailsAppendage_Refresh is
        // idempotent in both directions (spawn only on an empty chain, delete
        // only on a non-empty one), so cycling Sonic -> Tails -> Knuckles ->
        // Sonic can neither duplicate the tails nor strand a pair on Knuckles.
        // a0 is still Player_1 — Player_RefreshPhysics preserves it. Tail call:
        // its rts returns to this routine's caller (§2.8), which also keeps the
        // growth this adds to a module that packs with zero slack as small as it
        // can be.
        jbra    TailsAppendage_Refresh
    .done:
        rts
    }
}

// -----------------------------------------------
// Debug_Warp_Consume — THE supported external warp entry point (DEBUG shapes).
//
// Aurora's "play from cursor" writes a destination into the warp mailbox
// (games/sonic4/config/ram.emp: Warp_Req_X, Warp_Req_Y, then Warp_Req_Flag LAST)
// and this consumer performs the whole warp at the top of a frame, then clears
// the flag as the completion ack. Protocol prose: docs/ENGINE_ARCHITECTURE.md
// "§4.12 External Warp Mailbox".
//
// WHY THE WARP IS NOT A CAMERA POKE. Everything downstream of the camera latches
// PER-FRAME DELTAS off it. Tile_Cache_Fill reads Cache_Prev_Cam_X / Cache_Prev_
// Cam_Row and, on a teleport-sized delta, blows straight through the 16px
// hysteresis and latches a prefetch DIRECTION from the jump instead of from the
// player's motion (engine/level/tile_cache.emp, the .cs_have_latch accumulator;
// Tile_Cache_Init:562 names the same hazard for the boot baseline). Worse, the
// cache WINDOW (Cache_Left_Col/Head_Col/Top_Row/Bottom_Row) still describes the
// old locality and only crawls at 1 column / 2 rows per frame, while every plane
// write is silently DROPPED outside it (Draw_TileColumn's bounds gate) — so the
// nametable keeps the pre-jump content until the crawl arrives. Measured
// client-side by Aurora (aurora master 64aee42, scratchpad/warp-tearing-
// harness.mjs): a bare camera poke from world (96,429) leaves 0 differing plane-A
// nametable words at 64/128/256 px, 73 at 512 px, 94 at 1024 px and 699 of 2048
// at 2048 px, with Cache_Prev_Cam_X still reading 96 while Camera_X read 2144 —
// the stale baseline, observed directly.
//
// THE LADDER IS THE BOOT LADDER. Every step below is a call to the same pub proc
// GameState_OJZScroll_Init calls, in the same order, so the two stay in sync by
// construction rather than by comment. The only steps spelled out rather than
// called are the ones that are INLINE in the init too (the plane-dirty pair, the
// parallax sentinel) — see the WARP TWIN note at the init's own copy.
//
// PLACEMENT (why the game state and not engine/system/game_loop.emp): the engine
// loop's frame top is the natural host, but it cannot gate a level-only consumer
// without a new REQUIRED Game contract const — demo links every engine.* module,
// so an ungated consumer would compile into a game with no act — and a new const
// member obliges both games to bind it AND breaks the sigil port harness (11
// tests lower game_loop.emp standalone against a synthetic contract env), i.e. a
// sigil change this parcel is not allowed to make. The other frame-top seam,
// Game.debug_tick, is already claimed by the off-canonical Config-A profile, so
// binding it here would move that profile's frozen bytes. The level state's first
// instruction is the same frame boundary with none of that: strictly before the
// object run, the camera follow, and every streaming step this warp reseeds.
//
// DEBUG-shape only: the body — the rts included — sits inside `if DEBUG == 1 {}`,
// so the whole proc emits ZERO bytes in the plain shape (the Debug_CharacterHotkey
// idiom above).
//
// PLACEMENT IS LOAD-BEARING — it sits immediately after Debug_CharacterHotkey, the
// module's other zero-release-byte DEBUG proc, and must stay in that pair. Zero
// release bytes is not by itself zero release CHANGE: both canonical shapes append
// the convsym deb2 symbol table, so a zero-byte release LABEL still lands in the
// appendix and moves the ROM CRC plus the header ROM-end/checksum words. Parked
// against the already-zero-byte hotkey, this proc's release label coincides with an
// address the appendix already carries and dedupes away, so s4.bin stays
// byte-identical (measured: cdabf8a3 before and after). Move it anywhere a real
// emitting symbol follows and the release ROM changes for a routine that emits
// nothing.
//
// In:  none (reads the mailbox)
// Out: leader + camera + streaming state coherent at the destination; the CLAMPED
//      destination written back into Warp_Req_X/Y; Warp_Req_Flag cleared (the ack)
// Clobbers: d0-d7/a0-a6 (Tile_Cache_Init / Section_UpdateColumns / Parallax_Update)
// -----------------------------------------------
proc Debug_Warp_Consume () clobbers(d0-d7/a0-a6) {
    if DEBUG == 1 {
        tst.b   Warp_Req_Flag                   // (Warp_Req_Flag).w
        beq     .done                           // idle: two reads and a branch

        // -- 1. clamp the request into the act (defence in depth: a warp must
        //    never land the player in SEC_VOID, whatever the client sent), then
        //    publish the clamp so the client can read back where it landed.
        //    clamp_and_publish is the shared template — see its header for why the
        //    edges are the game's own Player_Bound_* and why the compares are
        //    signed. It is SHARED with the boot-position override on purpose: the
        //    two mailboxes promise the client the same clamp, and two copies of a
        //    bounds formula is exactly how that promise drifts. --
        clamp_and_publish(Warp_Req_X, Warp_Req_Y)   // d0/d1 = the clamped pair

        // -- 2. place the leader. A NARROW refresh, not Player_Init: Player_Init
        //    is the LEVEL-ENTRY initializer and tail-calls Player_DebugEnter
        //    whenever CHEAT_DEBUG_FLY is armed (which the DEBUG shape does at
        //    boot), so warping while in physics would yank the player into free
        //    flight. Same reasoning, same shape as Debug_CharacterHotkey's
        //    "WHY A NARROW REFRESH AND NOT Player_Init" note below. What is
        //    touched is exactly what a teleport invalidates: position, both
        //    velocities, the terrain-derived status/angle, and the three carried
        //    ground quantities. PSTATE_AIR through Player_SetState is Player_Init's
        //    own seed — airborne, lands on frame 1 at the destination.
        //
        //    THE POSITION IS WRITTEN AFTER THE TRANSITION, AND THAT ORDER IS THE
        //    CONTRACT. Player_SetState(PSTATE_AIR) runs PHook_AirEnter ->
        //    PHook_EnsureStanding, which normalises the collision box to the
        //    character's standing box and applies the FEET-PLANTED lift that goes
        //    with it: y_pos -= (cd_stand_h - current_h) >> 1 (player_common.emp).
        //    That lift is correct for a state change in place — the feet must not
        //    move when the box grows — and WRONG for a teleport, where there is no
        //    "in place" to preserve. Written before the call, the origin came out
        //    11 px above the request on any warp taken out of debug-fly (Sonic:
        //    (39 - 16) >> 1) and 5 px above it on any warp taken while curled
        //    ((39 - 29) >> 1), i.e. the SAME request landed at different heights
        //    depending on what the player happened to be doing — measured, and the
        //    reason the first booking read it as terrain-dependent (the first warp
        //    of a DEBUG boot shifted, the second did not, because the first one had
        //    already normalised the box). Writing the placement last makes the
        //    hook's lift land on the pre-warp position and be overwritten, so the
        //    destination is VERBATIM in every regime — which is what §4.12 promises
        //    a client and the only semantics a placement tool can reason about.
        //
        //    d3/d4 carry the clamped destination across the call rather than d0-d2:
        //    Player_SetState's contract is clobbers(d1-d2/a1-a2) with d0 carrying
        //    the new state in, so d3-d7 and a0 are the registers that survive it. --
        movea.w Camera_Target, a0               // (Camera_Target).w — the leader SST
        move.w  d0, d3                          // clamped X px, held across SetState
        move.w  d1, d4                          // clamped Y px, held across SetState
        clr.w   Sst.x_vel(a0)
        clr.w   Sst.y_vel(a0)
        clr.b   Sst.status(a0)                  // ST_ROLLING etc. are terrain-derived
        clr.b   Sst.angle(a0)
        clr.w   PlayerV.ground_speed(a0)
        clr.w   PlayerV.move_lock(a0)
        clr.w   PlayerV.spindash_charge(a0)
        moveq   #PSTATE_AIR, d0
        jbsr    Player_SetState                 // d1/d2 clobbered from here — the
                                                // mailbox holds the clamped target
        pixels_to_coord(d3)                     // px -> 16.16, fraction cleared
        move.l  d3, Sst.x_pos(a0)
        pixels_to_coord(d4)
        move.l  d4, Sst.y_pos(a0)               // AFTER the hook — see above

        // -- 3. camera: centre on the leader, then the camera's own clamp
        //    against the ceilings Camera_Init precomputed for this act. This is
        //    the camera's follow rule at rest (Camera_Update's deadzone is
        //    centred on the same point), so the first post-warp Camera_Update
        //    finds the player inside the deadzone and takes no step. The template
        //    re-reads the mailbox rather than taking d3/d4: those were converted in
        //    place by pixels_to_coord above, so their PIXEL value now lives in the
        //    high word. SHARED with the boot-position override for the same reason
        //    the clamp is. --
        center_camera_on(Warp_Req_X, Warp_Req_Y)

        clr.b   Camera_Hold_Frames              // a spindash freeze must not survive
        clr.b   Camera_Art_Hold                 // the art soft-clamp; the refill below
                                                // recomputes it from the destination

        // -- 4. section trackers + entity window. Section_Init IS the pair (it
        //    re-stamps Current_Act_Ptr, then Section_FillInitial seeds the four
        //    Section_*_Written trackers one cell tight around the NEW camera, then
        //    EntityWindow_Init recentres the 3x3 collected window and falls into
        //    a scan). Same call, same act pointer, as the init ladder. --
        movea.l Current_Act_Ptr, a0             // (Current_Act_Ptr).w
        jbsr    Section_Init

        // -- 5. tile cache. Tile_Cache_Init reseeds EVERY streaming latch the
        //    teleport invalidated — the window bounds, the circular origins, the
        //    four resume sentinels, Cache_Prev_Cam_Row AND Cache_Prev_Cam_X (the
        //    stale baseline Aurora measured), the H-prefetch direction/accumulator,
        //    the $FFFF ahead-target sentinels — then invalidates block staging and
        //    refills the whole 80x60 window. It is the boot proc verbatim; the one
        //    thing it cannot do on a WARM cache is fix the page refcounts its own
        //    FillAll is about to orphan, which is what the call above it exists for
        //    (see PageCache_ResetRefcounts' header — it quotes FillAll's precondition).
        //    Tile_Cache_Init's DEBUG tail then runs PageCache_Audit, so the warp
        //    checks its own residency bookkeeping on every warp. --
        jbsr    PageCache_ResetRefcounts
        jbsr    Tile_Cache_Init

        // -- 6. planes. Drop any entry a pre-warp lag frame left undrained (it
        //    describes the OLD locality and VInt_DrawLevel would ship it into the
        //    new one), then force the synchronous full-plane redraw — the init
        //    ladder's own two lines. --
        jbsr    Plane_Buffer_Reset
        st      Section_Plane_Dirty             // (Section_Plane_Dirty).w
        jbsr    Section_UpdateColumns

        // -- 7. the section CROSSING. Not a duplicate of the crossing logic: the
        //    sentinel pair is exactly what Parallax_Init writes so the next
        //    Parallax_CheckBoundary cannot match, which makes the destination
        //    section read as a crossing and go through the ONE path a walked
        //    crossing takes — Effects_InstallPreset (palette, cycle, variants,
        //    raster) then Parallax_StartTransition. Snap_Pending on top so the
        //    bands snap to the destination instead of lerping across the world
        //    from the old section. BgAnim_Init forces a bank DMA on the next
        //    Update; the final Parallax_Update primes HScroll/VSRAM so the first
        //    displayed frame at the destination already scrolls correctly. --
        move.b  #$FF, Parallax_Prev_Sec_X       // (Parallax_Prev_Sec_X).w
        move.b  #$FF, Parallax_Prev_Sec_Y       // (Parallax_Prev_Sec_Y).w
        st      Parallax_Snap_Pending           // (Parallax_Snap_Pending).w
        jbsr    Parallax_CheckBoundary
        jbsr    BgAnim_Init
        jbsr    Parallax_Update

        // -- 8. ACK, and it must be the last write: the client polls this byte to
        //    learn the warp is complete, so clearing it earlier would publish a
        //    half-warped frame. --
        clr.b   Warp_Req_Flag                   // (Warp_Req_Flag).w
    .done:
        rts
    }
}

// -----------------------------------------------
// Debug_LabCycleHotkey — THE EFFECTS LAB, AND NOW THE WHOLE OF IT. One ordered list
// of everything this act can demonstrate, walked with one chord, with the entry's
// NAME on screen as you pass it.
//
//   START held + RIGHT pressed  -> the next entry  (wrapping)
//   START held + LEFT  pressed  -> the previous    (wrapping)
//
// ---- WHY IT IS ONE LIST NOW, IN THE OWNER'S WORDS ----
// "why are there 3 ways to do things now? start + left/right, start + up/down,
// start + a". He was right, and it happened by accretion rather than by design:
// START+LEFT/RIGHT walked the SCENE registry (parallax configs — how the layers
// move), START+UP/DOWN walked the RASTER program table (per-line effects — gradients,
// the plane swap), START+A walked the PRESET list (whole packages a section installs
// by itself). Three chords because they write three different ENGINE SLOTS — which is
// a reason that matters to the code and not to the person holding the pad. The ruling
// (2026-09-05, "This sounds best cleaning it up like that"): collapse them into one
// list of everything demonstrable, walked by START+LEFT/RIGHT, with the on-screen
// readout naming each entry as you pass it. The other two chords retire.
//
// ---- WHAT IS IN THE LIST, AND IN WHAT ORDER ----
//   rows 0 .. SCENE_CYCLE_COUNT-1                      the shipped SCENES, registry order
//   the next RASTER_CYCLE_COUNT+1 rows                 the lab's raster programs, then
//                                                      bands OFF as the last of them
//   the last rows                                      the act's per-section PRESETS
//
// THE SCENE ROWS KEEP THEIR OLD INDICES, deliberately: row 13 is still
// ParallaxConfig_Perspective_Subtle, so every note, gate and probe that names a scene
// by number still lands. `tools/fg_left_edge_gate.py` and `tools/left_edge_vsram_probe.py`
// both walk this cursor to a numbered scene and both keep working for that reason.
//
// ---- THE ENTRY TYPE IS DISCRIMINATED, NOT INFERRED FROM A RANGE ----
// Each row carries its KIND as a byte. A range split (scenes below N, raster below M)
// would have been two compares cheaper and would have made moving a row across a
// boundary silently change which engine slot it installs into — the exact class of
// silent-wrong-picture failure the tables in this file are gated against. So the byte
// is spelled per row, `tools/test_lab_index_lint.py` checks every row's kind against
// the sub-table its sub-index indexes, and the dispatch below asserts the kind is in
// range before it branches.
//
// ---- IT IS AN INDEX, NOT A REPLACEMENT FOR THE THREE TABLES ----
// `.lab_index` names a KIND and a SUB-INDEX into the table that kind dispatches
// through — `.scene_table` and `.raster_table` below, and for a preset the act's OWN
// section grid, which has no table here at all (the Sec* is
// `Act.sec_grid_ptr + sub * sizeof(Sec)`, `Section_GetSecPtrXY`'s own tail arithmetic).
// That is deliberate and it is the cheap half of this parcel: the sub-tables stay
// exactly what they were, so `tools/test_scene_cycle_table_lint.py` (which holds
// `.scene_table` to the scene registry, row for row, in emission order) and
// `tools/test_raster_cycle_table_lint.py` (which holds `.raster_table` to the preset
// documents on disk, in BOTH directions) keep measuring what they always measured.
// This proc changed the SELECTION SURFACE and nothing else: no installer moved, and
// `Parallax_StartTransition` / `Raster_Install` / `Effects_InstallPreset` are called
// with the arguments, in the orders, they were called with before.
//
// ---- WHAT EACH KIND INSTALLS, AND WHY THAT IS NOT A SECOND MECHANISM ----
//   SCENE   `Parallax_StartTransition` — the engine's own live scene-swap, the same
//           proc `Parallax_CheckBoundary` hands a resolved config to on every
//           section-boundary crossing. Picks snap vs. lerp from the new config's
//           `pcfg_transition`, re-writes the VDP $0B (Mode Set 3) shadow, sets
//           Parallax_Snap_Pending on the instant arm, no-ops on a re-select.
//           PALETTE AND RASTER ARE NOT TOUCHED, and that is correct rather than a
//           shortcut: a scene IS a parallax_config. Everything else a scene needs is
//           re-derived per frame FROM the config, so there is nothing else to re-seed.
//           `Parallax_Init` is deliberately NOT used — it re-seeds
//           Parallax_Prev_Sec_X/Y to $FF, which would make the very next
//           Parallax_CheckBoundary undo the swap on the following frame.
//   RASTER  `Raster_Install`, staging Raster_Pending for the next Raster_VBlank. The
//           LAST raster row is bands OFF, and it installs `Raster_Program_None` — the
//           EMPTY program, never 0: `Raster_Install` documents a0 = 0 as "nothing
//           staged this frame", i.e. KEEP whatever is live, so passing 0 to turn the
//           tier off would silently leave the bands running.
//   WLINE   `Parallax_StartTransition`, through the SAME arm as SCENE and with the same
//           kind of sub-index — a `.scene_table` row. This proc installs nothing else.
//           What makes the row different is that the WATERLINE STAMP exists while the
//           cursor is on it: Debug_TierTags_Update reads this row's KIND once a frame and
//           builds or retires one screen-space object drawing the eight tiles at
//           VRAM_WATERLINE_STRIPS. The decision lives there and not here because this
//           proc runs BEFORE Parallax_Update, so on the pressing frame the engine has not
//           yet published the row the stamp's honesty test reads.
//           It exists because EFFECTS-W1 item 9d's art half was resident, correct and
//           INVISIBLE: nothing in the shipped nametable references VRAM_WATERLINE_STRIPS
//           (the OJZ background has no water surface to promote), so the only evidence the
//           gather worked was tools/waterline_art_witness.py. This row is the picture.
//           The scene has to be the one carrying the `rowRemap:` ladder or the pass never
//           publishes a row and the strips are never gathered; tools/test_lab_index_lint.py
//           derives WHICH scene that is from ojz_scenes.emp and fails the build otherwise.
//   PRESET  `Effects_InstallPreset` then `Parallax_StartTransition` — the exact pair,
//           in the exact order, that `Parallax_CheckBoundary` runs on a real crossing
//           (parallax.emp: 989-990), with only the crossing DETECTION left out. Total
//           binding writes every channel (palette, cycle, variants, raster/patched,
//           the patch anchors and their sweeps) and returns the resolved parallax
//           config for the tail.
//
// ---- SCOPE OF EVERY OVERRIDE, AND WHY IT IS A FEATURE ----
// Unchanged from all three retired chords: the override survives until the camera
// crosses a section boundary, at which point Parallax_CheckBoundary installs that
// section's own scene/preset again. Stand still to review. A debug override can never
// leave the act permanently mis-configured.
//
// ---- ADVANCE-THEN-INSTALL, WHICH IS ONE ORDER WHERE THERE USED TO BE TWO ----
// The scene chord advanced first; the raster chord installed first (row 0 was a
// documented control that had to be what a cold boot's first press showed); the preset
// chord advanced first (a boot stands in section 0, so installing section 0 would have
// shown nothing). A BIDIRECTIONAL walk cannot express "install, then advance" — LEFT
// and RIGHT would install the same entry and diverge only afterwards — so the merged
// list advances first, which is what LEFT/RIGHT already did. The consequence, stated
// because it is a real change: the raster control OJZ_BandDemo is no longer what the
// first press of anything installs. It is a named row you step to (`BAND`), and the
// name tag says so when you arrive, which is a better answer to "which one am I
// looking at" than an ordering convention was.
//
// ---- WHAT THE READOUT SAYS ----
// The ENTRY NAME TAG — four letters, top-left, painted by Debug_TierTags_Update from
// this cursor. Four is the VDP's MAXIMUM sprite-piece width, so four characters is a
// hardware limit and not a taste call; every row's name is exactly four letters and
// `tools/test_lab_index_lint.py` fails the build if two rows spell the same word,
// because two entries that read the same on screen cannot be told apart by the person
// holding the pad — which is the whole purpose. Under it, on preset entries only, the
// PRESET readout's two cells (the section digit and the verdict glyph) say which
// section the preset came from and whether it can show anything HERE; on every other
// entry those two cells are BLANKED rather than left showing a previous preset's
// answer. Below both, the two TIER tags keep saying what is ACTUALLY INSTALLED in the
// raster and BG-animation channels, polled off the engine's own cells — see
// Debug_TierTags_Update's header for why that distinction is load-bearing and why this
// cursor could never serve it.
//
// ---- WHICH CHORDS THIS RETIRES, AND WHAT THAT FREES ----
// RETIRED: START+UP/DOWN (the raster tier) and START+A (the preset tier). Both are now
// unclaimed in this shape. The pad was measured EXHAUSTED when the BG-animation tier
// needed a chord — five spent, START+B and C+B both on CHEAT_DEBUG_FLY, START+C the
// only reachable pairing left — so a whole direction pair plus a face pairing coming
// back is the largest piece of pad this lab has ever had spare. Two consequences
// landed with the retirement:
//   * `Debug_CharacterHotkey`'s START veto is DELETED. It existed for one reason, and
//     the reason was START+A; with the preset tier gone, A alone cycles characters
//     again, which is what it did before that chord was minted.
//   * START+C (the BG-animation tier) STAYS ITS OWN CHORD and is deliberately NOT in
//     this list. Everything in the list is MUTUALLY EXCLUSIVE — each install evicts
//     the last, and a section crossing re-decides all of it. The BG-animation tier is
//     ORTHOGONAL: it is not an EffectsPreset channel, so it survives a crossing, and
//     it composes with whatever entry is selected. Folding it in would mean stepping
//     PAST an animation row to reach a scene turned the animation on, and turning it
//     off again meant walking the list back to the OFF row — the list would stop being
//     a selection of one thing and start being a set of latches. The owner also likes
//     that tier as it stands ("oh I see now, awesome great work"), and it answers a
//     different question: not "which effect am I looking at" but "is the band
//     animation running".
//
// ---- WHY A CHORD AND NOT A BARE BUTTON (the enumeration, unchanged) ----
// Over the canonical `DEBUG=1 ./build.sh` shape in live gameplay, START is the only
// free bit on a 3-button pad: A is jump plus the character-cycle hotkey, B is the
// CHEAT_DEBUG_FLY toggle armed at boot in this shape, C is in both jump masks plus the
// two nudge chords in this module plus the BG-animation cycle's button, and the
// directions are steering. START's only reader is engine/system/replay.emp:157,
// structurally unreachable with Input_Source == INPUT_LIVE. X/Y/Z/MODE were REJECTED
// again: they exist only when the pad enumerates as PAD_6BTN, so the chord would be
// silently INERT on a 3-button pad, which is the worst failure a review tool can have.
// The cost this chord accepts, unchanged: LEFT/RIGHT still steer while it is held.
//
// ---- CAPABILITY SAFETY ----
// Installing any scene at runtime is safe by CONSTRUCTION: scene_registry.emp folds
// every scene's demands into SceneRegistry_CapsFolded and holds it build-fatally to
// $001E and to a subset of Game.SCANLINE_CAPS ($005E), so the capability spans
// compiled into parallax.emp are present for every row.
//
// ---- LIVE INPUT ONLY ----
// REQUIRED, not defensive. START rides in the main controller byte that
// engine/system/replay.emp records whole (:250) and replays whole (:200) — a fixture
// holding START across a LEFT/RIGHT press would flip an entry during playback and
// desync every downstream check.
//
// DEBUG-shape only: the body — the rts AND all three tables included — sits inside
// `if DEBUG == 1 {}`, so the whole proc emits ZERO bytes in the plain shape. Its
// PLACEMENT is load-bearing: both canonical shapes append the convsym deb2 symbol
// table, so a zero-byte release LABEL still lands in the appendix and moves the ROM
// CRC plus the header ROM-end/checksum words. Parked as the THIRD member of this
// module's zero-release-byte run.
//
// In:  none (reads Ctrl_1_Held / Ctrl_1_Press / Input_Source / Debug_Lab_Index and,
//      on a preset row, Current_Act_Ptr)
// Out: Debug_Lab_Index advanced and the named entry installed through its own engine
//      slot, iff the chord fired this frame
// Clobbers: d0-d4, a0-a3 — Effects_InstallPreset's own declared set, which
//      Parallax_StartTransition (d0-d1), Raster_Install (nothing) and the two readout
//      calls all sit inside. Identical to Parallax_CheckBoundary's, which is the same
//      pair of calls.
// -----------------------------------------------
// The list's length, stated ONCE. The cursor wraps at this and then indexes
// `.lab_index`, so a mirror that drifted above the row count would read a KIND and a
// SUB-INDEX from past the table's end and dispatch on them.
// tools/test_lab_index_lint.py holds it to the rows, and holds every row's sub-index
// to the sub-table its kind names.
const LAB_CYCLE_COUNT = 38
// One row of `.lab_index`: the kind byte, the sub-index byte, then the four letters of
// the entry's name (indices into Debug_TierTags_Update's `.alphabet`).
//
// SIX BYTES, AND THE EVENNESS IS LOAD-BEARING: `.scene_table` follows this table and is
// `dc.l`, so an odd row size would leave it on the wrong parity and every pointer it
// holds would be fetched from an odd address. `.lab_index` itself starts on an even
// address by construction (it follows an `rts`, and every 68000 instruction is an even
// number of bytes). tools/test_lab_index_lint.py gates the product.
const LAB_ENTRY_SIZE = 6
const LAB_NAME_OFF   = 2        // the first name letter's offset within a row
const LAB_NAME_CELLS = 4        // the VDP's maximum sprite-piece width; see the header
// The kinds. DENSE from 0, because the dispatch asserts the kind is in range and then
// branches on it — a gap would let a corrupt byte pass the assert and fall through to
// the scene arm with a sub-index meant for another table.
const LAB_KIND_SCENE  = 0
const LAB_KIND_RASTER = 1
const LAB_KIND_PRESET = 2
// WLINE — a SCENE plus the waterline STAMP (EFFECTS-W1 item 9d). It is a fourth kind and
// not a scene row with a flag, because it installs into two places rather than one: the
// parallax slot (through the same Parallax_StartTransition every scene row uses) AND a
// System object slot. Its sub-index is a `.scene_table` index like a scene row's, and it
// has to name the scene that carries the ladder — tools/test_lab_index_lint.py derives
// WHICH scene that is out of ojz_scenes.emp's own `rowRemap:` and fails the build if this
// row names any other.
//
// WHY THIS ROW EXISTS AT ALL. The art half of the row remap has shipped and been proven
// resident since 9d landed — tools/waterline_art_witness.py reads the 256 bytes at
// VRAM_WATERLINE_STRIPS and matches them byte for byte against an independently spelled
// gather, POSITIVE 12/12 — and NOTHING ON SCREEN POINTED AT THEM. The OJZ background has
// no water surface to promote (item-9 design section 6.2), and the effect's own design
// forbids the engine writing a nametable cell for it. So the tiles were correct and
// invisible, and the only evidence was a witness. This row is the picture.
const LAB_KIND_WLINE  = 3
// The System slot the waterline stamp occupies. NUM_SYSTEM-2 is the slot the retired
// scene readout's TENS digit held, and Debug_TierTags_Update's header records it as FREE
// since the chord consolidation ("NUM_SYSTEM-2 is now free"). Taking it brings the lab
// back to SIX of the eight claimed and re-addresses nothing: the entry name tag keeps
// NUM_SYSTEM-1, the preset cells -3/-4, the tier tags -5/-6.
//
// Declared HERE, ahead of the hotkey, because the hotkey's dispatch RETIRES the stamp by
// address on every step — see the teardown in Debug_LabCycleHotkey below. Everything else
// about the stamp (its geometry, its art word, the object builder) lives with
// Debug_WaterlineStamp_Show further down.
equ DEBUG_WLINE_SST = extern("System_Slots") + sizeof(Sst) * (NUM_SYSTEM - 2)
// The number of `.raster_table` rows. Held to the rows themselves, and to the preset
// documents in games/sonic4/data/editor/effects/presets/, by
// tools/test_raster_cycle_table_lint.py — which the build's pytest lane runs. Nothing
// in sigil can see a `dc.l` run's length.
const RASTER_CYCLE_COUNT = 6
// The raster sub-index that means BANDS OFF: one past the last `.raster_table` row.
// Spelled as a constant rather than as a bare compare so the OFF row and the table's
// length cannot drift apart.
const LAB_RASTER_OFF = RASTER_CYCLE_COUNT
// The preset readout is ONE decimal digit, so a preset row's sub-index has to fit in
// one. Asserted at the readout rather than clamped here: the rows are authored, not
// computed, and tools/test_lab_index_lint.py checks every preset row's section against
// the act's own grid, so an out-of-range section fails the BUILD rather than showing
// its eleventh section as "1".
const PRESET_CYCLE_MAX = 10

proc Debug_LabCycleHotkey () clobbers(d0-d4/a0-a3) {
    if DEBUG == 1 {
        // Gate 1: live input only — see the header. A `tst.b` is the whole test
        // because INPUT_LIVE is 0; the same ensure Debug_CharacterHotkey declares
        // above pins that, and one statement of it covers both readers.
        tst.b   Input_Source                    // (Input_Source).w
        bne     .done                           // replaying or recording: stand down

        // Gate 2: the modifier. HELD, not press — START is the chord's shift key, so
        // it must still count on the frames after the one it went down on.
        move.b  Ctrl_1_Held, d0                 // tick-stable held latch
        andi.b  #BUTTON_START, d0
        beq     .done

        // Gate 3: the step, EDGE-triggered on the direction so a held pad steps once
        // rather than flipping through the whole list in as many frames.
        move.b  Ctrl_1_Press, d1                // tick-stable press latch
        moveq   #0, d2                          // d2 = signed step; 0 until a direction
        move.b  d1, d0
        andi.b  #BUTTON_RIGHT, d0
        beq     .not_forward
        moveq   #1, d2
    .not_forward:
        andi.b  #BUTTON_LEFT, d1
        beq     .not_back
        moveq   #-1, d2                         // LEFT wins a same-frame L+R chord; an
                                                // opposing pair is not a direction, and
                                                // stepping BACK from an ambiguous press
                                                // is the recoverable half
    .not_back:
        tst.w   d2
        beq     .done                           // START held with no fresh L/R this frame

        // -- advance the cursor, wrapping both ways over the list --
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  Debug_Lab_Index, d0             // (Debug_Lab_Index).w
        add.w   d2, d0
        bpl     .no_underflow                   // d2 is ±1, so the only underflow is 0-1
        moveq   #LAB_CYCLE_COUNT-1, d0
    .no_underflow:
        cmpi.w  #LAB_CYCLE_COUNT, d0            // the cursor only ever steps by one, so
        bne     .no_overflow                    // equality is the whole wrap condition
        moveq   #0, d0
    .no_overflow:
        assert.w d0, ls, #LAB_CYCLE_COUNT-1     // in table range — checked BEFORE the
                                                // store and before the indexed read, so
                                                // a bad cursor can neither reach RAM nor
                                                // fetch a row from past the table
        move.b  d0, Debug_Lab_Index             // (Debug_Lab_Index).w
                                                // The NAME is painted by
                                                // Debug_TierTags_Update, which polls this
                                                // byte — so it lands one frame later, and
                                                // it retries a dropped DMA instead of
                                                // showing three letters of a word that
                                                // was never true. See its header.

        // -- read the row the cursor names: its KIND and its SUB-INDEX --
        // mul_const elects between a shift/add chain and mulu at build time
        // (CODING_CONVENTIONS §2.1), so no four-point argument is owed for a stride of 6.
        mul_const.w d0, #LAB_ENTRY_SIZE, d1     // d0 = row byte offset (d1 scratch)
        lea     .lab_index(pc), a1
        adda.w  d0, a1                          // a1 = the row
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  (a1)+, d0                       // d0 = kind
        moveq   #0, d1
        move.b  (a1)+, d1                       // d1 = sub-index (the four name letters
                                                // follow; only the tag painter reads them)
        assert.w d0, ls, #LAB_KIND_WLINE        // a kind past the last one would fall
                                                // through to the scene arm with a
                                                // sub-index meant for another table.
                                                // ⚠ THIS BOUND IS ALSO WHAT KEEPS THE
                                                // FALL-THROUGH BELOW HONEST: a FIFTH kind
                                                // has to raise it, and whoever raises it
                                                // lands on the paragraph that says why
                                                // SCENE and WLINE share one arm
        cmpi.w  #LAB_KIND_RASTER, d0
        beq     .raster
        cmpi.w  #LAB_KIND_PRESET, d0
        beq     .preset

        // -- SCENE **and WLINE**: a parallax config, installed through the engine's own
        //    live swap. The two kinds share this arm because they do the same thing HERE:
        //    both sub-indices are `.scene_table` rows and both install through
        //    Parallax_StartTransition. THE DIFFERENCE IS NOT IN THIS PROC — the kind byte
        //    is read once a frame by Debug_TierTags_Update's stamp arm, which is what
        //    puts the waterline strips on screen and takes them off again. Installing the
        //    stamp from here was tried and is WRONG, and the reason is worth keeping:
        //    this proc runs BEFORE Parallax_Update in the frame (:986 vs :1377), so on the
        //    pressing frame Waterline_Art_Row still holds the PREVIOUS scene's value —
        //    usually 0 — and the honesty arm would have retired the object on the very
        //    frame the press built it, every time, silently. Deciding once a frame from
        //    the cursor and the engine's own cell has no such ordering to get wrong.
        //
        // -- installed through the engine's own live swap --
        // The preset cells are BLANKED first: they answer a question about a PRESET,
        // and on a scene row there is no preset to answer it about. Leaving the last
        // preset's digit and verdict standing would be the readout lying by staleness,
        // which is the whole defect this parcel exists to remove. The call clobbers
        // d0-d4/a0-a2, so the sub-index rides the stack across it.
        move.w  d1, -(sp)
        jbsr    Debug_PresetReadout_Blank
        move.w  (sp)+, d0
        assert.w d0, ls, #SCENE_CYCLE_COUNT-1   // in `.scene_table` range, checked before
                                                // the indexed read
        lsl.w   #2, d0                          // × sizeof(pointer); no scaled indexing
                                                // on the 68000
        lea     .scene_table(pc), a1
        movea.l (a1,d0.w), a0
        jbra    Parallax_StartTransition        // snap/lerp + mode shadow; tail call (§2.8)

    .raster:
        // -- RASTER: a per-line program, staged for the next Raster_VBlank --
        move.w  d1, -(sp)
        jbsr    Debug_PresetReadout_Blank
        move.w  (sp)+, d0
        assert.w d0, ls, #LAB_RASTER_OFF        // the OFF row is one PAST the last table
                                                // row, so `ls` against it and not `lo`
        cmpi.w  #LAB_RASTER_OFF, d0
        beq     .raster_off
        lsl.w   #2, d0                          // × sizeof(pointer)
        lea     .raster_table(pc), a1
        movea.l (a1,d0.w), a0                   // the program this row installs
        jbra    Raster_Install                  // tail call (§2.8); it clobbers nothing

    .raster_off:
        // BANDS OFF is the EMPTY program, never 0 — see the header.
        lea     Raster_Program_None, a0         // (Raster_Program_None).l
        jbra    Raster_Install

    .preset:
        // -- PRESET: a whole EffectsPreset, installed onto the section the camera is
        //    actually standing in, through the engine's own crossing path.
        //
        //    THE ROW'S SECTION IS CHECKED AGAINST THE LIVE ACT FIRST. The rows are
        //    authored here and the act's grid is data, so a row could name a section
        //    this act does not have — and `Act.sec_grid_ptr + sub * sizeof(Sec)` would
        //    happily resolve to whatever ROM follows the grid. tools/test_lab_index_lint.py
        //    fails the build on that, and this is the runtime backstop for an act loaded
        //    at runtime that the lint never saw. grid_w/grid_h's low bytes are the
        //    blessed sub-field view (engine.structs Act_grid_w_lo/Act_grid_h_lo), safe
        //    because the act constructor bounds both by MAX_ACT_SECTIONS; mul_bounded
        //    elects between a repeated-add loop and mulu at build time on the worst case,
        //    which is what CODING_CONVENTIONS §2.1 asks for in place of a hand-written
        //    multiply, so no four-point argument is owed. It runs once per PRESS.
        move.w  d1, d4                          // d4 = the section this row names
        movea.l Current_Act_Ptr, a2             // (Current_Act_Ptr).w
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  Act_grid_h_lo(a2), d0
        moveq   #0, d1
        move.b  Act_grid_w_lo(a2), d1
        mul_bounded.w d0, d1, #MAX_ACT_SECTIONS // d0 = grid_h * grid_w = section count
        cmp.w   d0, d4
        bhs     .done                           // this act has no such section

        // The Sec*: `Section_GetSecPtrXY`'s own tail arithmetic, minus the grid
        // decomposition — the sub-index IS the flat id. The stride is spelled
        // #sizeof(Sec) so it follows the struct, and adda.w sign-extends, which is safe
        // because the check above bounds the index by MAX_ACT_SECTIONS.
        movea.l Act.sec_grid_ptr(a2), a0
        move.w  d4, d0
        mul_const.w d0, #sizeof(Sec), d2        // d0 = section × the Sec stride (d2 scratch)
        adda.w  d0, a0                          // a0 = Sec*

        // This DEBUG block mirrors Parallax_CheckBoundary's: a section whose
        // sec_effects is 0 is a content bug, and Effects_InstallPreset would follow the
        // null into whatever ROM sits at offset 0. The crossing site raises there; here
        // we STAND DOWN instead, because a review tool must not be the thing that kills
        // the machine the review is running on — and the readout's own resolve would
        // fault on the same null.
        tst.l   Sec.sec_effects(a0)             // (Sec.sec_effects)(a0)
        beq     .done
        jbsr    Effects_InstallPreset           // a0 = Sec* in, resolved parallax out
        jbsr    Parallax_StartTransition        // snap/lerp + VDP $0B mode shadow

        // -- and say WHICH section it came from and WHETHER it can show here --
        // AFTER the install, not before it, and for a reason that is specific rather
        // than stylistic: the verdict reads Effects_Screen_L, and the only thing that
        // latches it against this preset's anchors is Effects_InstallPreset's own
        // Effects_LatchWorldLines call. Painting first would publish the PREVIOUS
        // preset's verdict beside this preset's section, which is worse than no verdict.
        jbra    Debug_PresetReadout_Show        // tail call (§2.8)

    .done:
        rts

        // ---- THE LIST ----
        // Every 68000 instruction is an even number of bytes, so the label after `rts`
        // is word-aligned by construction — no `align` directive, which would need
        // every preceding instruction size fixed (the game_debug.emp width-pin hazard)
        // for no gain. LAB_ENTRY_SIZE is even, so `.scene_table` below inherits that
        // parity; tools/test_lab_index_lint.py gates both facts.
        //
        // ONE ROW: kind, sub-index, then the four letters of the name. The NAME SITS
        // BESIDE THE ENTRY IT NAMES — that is the point of the row shape. The retired
        // three-chord lab kept its names in a separate parallel table
        // (`.rtag_names`, which survives for the LIVE-state raster tag and is a
        // different vocabulary), and a name table that can drift from the thing it names
        // is a readout that can lie.
        //
        // WHAT THE LINT HOLDS (tools/test_lab_index_lint.py, run by the build's pytest
        // lane): the row count against LAB_CYCLE_COUNT; every scene sub-index a dense
        // 0..SCENE_CYCLE_COUNT-1 run in order; every raster sub-index a dense
        // 0..RASTER_CYCLE_COUNT run with exactly one OFF row, last; every preset
        // sub-index a dense run inside the act's own grid_w × grid_h; every name exactly
        // four defined `LTR_*` glyphs; no two rows spelling the same word; and the
        // raster rows' names equal `.rtag_names`' rows for the same programs, so the
        // selection name and the live-state name for one program cannot disagree.
        //
        // EXPORTED (`export .name:`, §1.5) so Debug_TierTags_Update below can read a
        // row's four name letters out of it. Without the keyword the reference fails at
        // link and sigil names the fix in the diagnostic.
    export .lab_index:
        //       kind             sub  name
        dc.b    LAB_KIND_SCENE,    0,  LTR_D, LTR_F, LTR_L, LTR_T   //  0  OJZ_Default
        dc.b    LAB_KIND_SCENE,    1,  LTR_U, LTR_W, LTR_T, LTR_R   //  1  OJZ_Underwater
        dc.b    LAB_KIND_SCENE,    2,  LTR_W, LTR_N, LTR_D, LTR_Y   //  2  OJZ_Windy
        dc.b    LAB_KIND_SCENE,    3,  LTR_S, LTR_H, LTR_M, LTR_S   //  3  Shimmer_Slow
        dc.b    LAB_KIND_SCENE,    4,  LTR_S, LTR_H, LTR_M, LTR_R   //  4  Shimmer
        dc.b    LAB_KIND_SCENE,    5,  LTR_S, LTR_H, LTR_M, LTR_F   //  5  Shimmer_Fast
        dc.b    LAB_KIND_SCENE,    6,  LTR_H, LTR_A, LTR_Z, LTR_S   //  6  Haze_Slow
        dc.b    LAB_KIND_SCENE,    7,  LTR_H, LTR_A, LTR_Z, LTR_E   //  7  Haze
        dc.b    LAB_KIND_SCENE,    8,  LTR_H, LTR_A, LTR_Z, LTR_F   //  8  Haze_Fast
        dc.b    LAB_KIND_SCENE,    9,  LTR_H, LTR_A, LTR_Z, LTR_U   //  9  Haze_Uniform
        dc.b    LAB_KIND_SCENE,   10,  LTR_R, LTR_C, LTR_K, LTR_S   // 10  Rocking_Slow
        dc.b    LAB_KIND_SCENE,   11,  LTR_R, LTR_O, LTR_C, LTR_K   // 11  Rocking
        dc.b    LAB_KIND_SCENE,   12,  LTR_R, LTR_C, LTR_K, LTR_F   // 12  Rocking_Fast
        dc.b    LAB_KIND_SCENE,   13,  LTR_P, LTR_R, LTR_S, LTR_S   // 13  Perspective_Subtle
        dc.b    LAB_KIND_SCENE,   14,  LTR_P, LTR_R, LTR_S, LTR_P   // 14  Perspective
        dc.b    LAB_KIND_SCENE,   15,  LTR_P, LTR_R, LTR_S, LTR_D   // 15  Perspective_Dramatic
        dc.b    LAB_KIND_SCENE,   16,  LTR_W, LTR_N, LTR_H, LTR_Z   // 16  WindyHaze
        dc.b    LAB_KIND_SCENE,   17,  LTR_S, LTR_K, LTR_H, LTR_Z   // 17  SkyHaze
        dc.b    LAB_KIND_SCENE,   18,  LTR_C, LTR_A, LTR_V, LTR_E   // 18  OJZ_Caves
        dc.b    LAB_KIND_SCENE,   19,  LTR_L, LTR_C, LTR_L, LTR_D   // 19  OJZ_LockedClouds
        dc.b    LAB_KIND_SCENE,   20,  LTR_P, LTR_F, LTR_L, LTR_R   // 20  Perspective_Floor
        dc.b    LAB_KIND_RASTER,   0,  LTR_B, LTR_A, LTR_N, LTR_D   // 21  OJZ_BandDemo (control)
        dc.b    LAB_KIND_RASTER,   1,  LTR_S, LTR_W, LTR_A, LTR_P   // 22  OJZ_BaseSwap
        dc.b    LAB_KIND_RASTER,   2,  LTR_R, LTR_M, LTR_P, LTR_W   // 23  aurora_ramp_witness
        dc.b    LAB_KIND_RASTER,   3,  LTR_P, LTR_R, LTR_O, LTR_B   // 24  authored_probe
        dc.b    LAB_KIND_RASTER,   4,  LTR_S, LTR_H, LTR_I, LTR_M   // 25  ojz_sec3_shimmer
        dc.b    LAB_KIND_RASTER,   5,  LTR_R, LTR_A, LTR_M, LTR_P   // 26  ramp_probe
        dc.b    LAB_KIND_RASTER,   6,  LTR_N, LTR_O, LTR_N, LTR_E   // 27  bands OFF (LAB_RASTER_OFF)
        dc.b    LAB_KIND_PRESET,   0,  LTR_W, LTR_A, LTR_T, LTR_R   // 28  sec 0 patched water
        dc.b    LAB_KIND_PRESET,   1,  LTR_S, LTR_P, LTR_L, LTR_T   // 29  sec 1 sparse raster split
        dc.b    LAB_KIND_PRESET,   2,  LTR_D, LTR_E, LTR_N, LTR_S   // 30  sec 2 dense gradient ramp
        dc.b    LAB_KIND_PRESET,   3,  LTR_C, LTR_Y, LTR_C, LTR_L   // 31  sec 3 palette-cycling band
        dc.b    LAB_KIND_PRESET,   4,  LTR_D, LTR_P, LTR_T, LTR_H   // 32  sec 4 depth showcase
        dc.b    LAB_KIND_PRESET,   5,  LTR_S, LTR_R, LTR_E, LTR_F   // 33  sec 5 the sidecar rasterRef
        dc.b    LAB_KIND_PRESET,   6,  LTR_B, LTR_S, LTR_W, LTR_P   // 34  sec 6 nametable-base swap
        dc.b    LAB_KIND_PRESET,   7,  LTR_B, LTR_A, LTR_R, LTR_E   // 35  sec 7 plain, nothing bound
        dc.b    LAB_KIND_PRESET,   8,  LTR_G, LTR_R, LTR_N, LTR_D   // 36  sec 8 plain + the floor
        // APPENDED, and appended is the whole placement argument: every scene, raster and
        // preset row above keeps the index it had, so every note, gate and probe that
        // names a row by number still lands. The sub-index is 1 because `.scene_table`
        // row 1 is ParallaxConfig_OJZ_Underwater, the ONE scene in the registry that
        // carries `rowRemap:` — tools/test_lab_index_lint.py derives that from
        // ojz_scenes.emp rather than trusting this comment.
        dc.b    LAB_KIND_WLINE,    1,  LTR_W, LTR_L, LTR_I, LTR_N   // 37  waterline strips

        // ---- THE SCENE SUB-TABLE, IN SCENES[] ORDER ----
        // Unchanged by the consolidation, deliberately: it is what
        // tools/test_scene_cycle_table_lint.py holds to the registry's own `pub data
        // ParallaxConfig_X = lowerN(SCENES[i])` emission block, row for row, in order.
        // Adding a twenty-second scene means a row here, a `.lab_index` row, and a
        // SCENE_CYCLE_COUNT bump — and the two lints fail the build until all three land.
    .scene_table:
        dc.l    ParallaxConfig_OJZ_Default          //  0
        dc.l    ParallaxConfig_OJZ_Underwater       //  1
        dc.l    ParallaxConfig_OJZ_Windy            //  2
        dc.l    ParallaxConfig_Shimmer_Slow         //  3
        dc.l    ParallaxConfig_Shimmer              //  4
        dc.l    ParallaxConfig_Shimmer_Fast         //  5
        dc.l    ParallaxConfig_Haze_Slow            //  6
        dc.l    ParallaxConfig_Haze                 //  7
        dc.l    ParallaxConfig_Haze_Fast            //  8
        dc.l    ParallaxConfig_Haze_Uniform         //  9
        dc.l    ParallaxConfig_Rocking_Slow         // 10
        dc.l    ParallaxConfig_Rocking              // 11
        dc.l    ParallaxConfig_Rocking_Fast         // 12
        dc.l    ParallaxConfig_Perspective_Subtle   // 13
        dc.l    ParallaxConfig_Perspective          // 14
        dc.l    ParallaxConfig_Perspective_Dramatic // 15
        dc.l    ParallaxConfig_WindyHaze            // 16
        dc.l    ParallaxConfig_SkyHaze              // 17
        dc.l    ParallaxConfig_OJZ_Caves            // 18
        dc.l    ParallaxConfig_OJZ_LockedClouds     // 19
        dc.l    ParallaxConfig_Perspective_Floor    // 20  EFFECTS-W1 T2

        // ---- THE RASTER SUB-TABLE ----
        // Also unchanged: tools/test_raster_cycle_table_lint.py holds it to the preset
        // documents in games/sonic4/data/editor/effects/presets/ in BOTH directions —
        // every document must be reachable by a row here or by a `rasterRef` binding in
        // a section sidecar, and every editor row must name a document that exists.
        // Row 0 must be a hand-authored `pub data` in the game's effects library; that
        // arm survives the consolidation even though "row 0 is what the first press
        // shows" no longer does (see ADVANCE-THEN-INSTALL in the header), because the
        // control still has to BE a control.
        //
        // ROW ORDER IS HAND-AUTHORED FIRST, EDITOR-AUTHORED AFTER, the editor rows in
        // the generator's own emission order (sorted by preset id — tools/effects_gen.py
        // `render_module`), so the table and the generated module read in the same order.
        //
        // EXPORTED (`export .name:`, §1.5) so Debug_TierTags_Update below can SCAN it:
        // that proc turns the live `Raster_Program` pointer back into a row index, and
        // this table is the tree's only statement of which pointer is which row.
        //
        // IT IS LAST IN THIS PROC, and that is not arbitrary: two of the text lints that
        // read this file match a table's body as "the label, up to the next line that is
        // just a closing brace". A `dc.l` table between `.raster_table:` and the brace
        // would be read as raster rows.
    export .raster_table:
        dc.l    OJZ_BandDemo                            // 0 — HAND-authored (.emp)
        dc.l    OJZ_BaseSwap                            // 1 — HAND-authored (.emp), item 11a
        dc.l    EditorRaster_OJZ_Act1_aurora_ramp_witness // 2 — EDITOR-authored (JSON), item 6 ramp,
                                                                //     the AUTHORING-END witness document.
                                                                //     `aurora_local_` sorts BEFORE `authored_`
                                                                //     ('r' < 't'), which is why it leads the
                                                                //     editor rows — emission order, not taste.
        dc.l    EditorRaster_OJZ_Act1_authored_probe            // 3 — EDITOR-authored (JSON)
        dc.l    EditorRaster_OJZ_Act1_ojz_sec3_shimmer          // 4 — EDITOR-authored (JSON)
        dc.l    EditorRaster_OJZ_Act1_ramp_probe                // 5 — EDITOR-authored (JSON), item 6 ramp
    }
}

// -----------------------------------------------
// Debug_BgAnimViewHotkey — THE EFFECTS LAB'S BG-ANIMATION TIER.
//
//   START held + C pressed, NO DIRECTION HELD
//                       -> step the BG tile-band animation: OFF -> the horizontal
//                          (Camera_X) view -> the vertical (Camera_Y) view -> the TIMER
//                          view -> the vertical-axis probe -> its control -> OFF
//
// THE ASK, in the owner's words: "can we please just get rid of the animated tiles for
// now, they're so distracting? Maybe have one view for horizontal and one for vertical?"
// and, on the same pass, "it would be nice to see them perspective related instead of
// just timer right now" — then, a day later, having seen the result:
//
//   "I just ddidn't want the experimental animation bands right now for this, they showed
//    we can do horizontal and vertical movement on a timer, but it was on for every test
//    and distracting. It should be its own scene with start + button and should be tested
//    for perspective vs timer, that's all"
//
// TWO CHANGES CAME OUT OF THAT SECOND READING, and neither is a restatement of the first.
// "Tested for perspective vs timer" is a COMPARISON, and yesterday's parcel left only one
// arm of it in the ROM — both views were camera-driven, so there was nothing to compare
// them AGAINST. Row 3 below is the timer arm, restored at the rate the retired timer view
// actually ran at (tools/inject_editor_bg.py, BGANIM_VIEW_T_RATE_SHIFT: identity, not a
// fresh derivation, so the A/B varies the DRIVER and nothing else). And the chord moved
// from C+A to START+C, because he asked for START+button; see the enumeration below.
//
// ---- OFF IS NOT THIS CHORD'S DOING, AND THAT IS THE POINT ----
// The act boots SILENT, in every shape including release, because
// tools/inject_editor_bg.py emits `BgAnim_Table: u16 = 0` for a band marked
// `default_off` in games/sonic4/data/editor_bg_override.json. The "get rid of them"
// half therefore costs no code, no flag and no chord — `BgAnim_Update` walks a
// zero-count table and returns. This proc exists only so the DEBUG shape can put a view
// BACK, which is why row 0 of its table is the act's own table rather than a synthetic
// empty one: OFF and "what the game ships" are the same object here.
//
// ---- WHY THREE TABLES AND NOT THREE STATES ----
// A band's driver and rate are baked into its 44-byte ROM record, so "run this band off
// Camera_X", "run it off Camera_Y" and "run it off Logic_Tick" are three different
// TABLES. The emitter writes all four into one section sharing one bank blob (+138 bytes
// total, 8376 of the 20480 B ruled ceiling), and `BgAnim_SetTable`
// (engine/level/bg_anim.emp) says which one the walk uses. That selector is DEBUG-only:
// the plain shape keeps its `lea BgAnim_Table` and gains neither the cell nor the
// indirection.
//
// ---- WHICH VIEW IS WHICH, AND WHY THE RATES DIFFER ----
// H and V name the CAMERA AXIS rows 1 and 2 are driven by, not the band's own art axis —
// all three of those views move the same HORIZONTAL band. The rates are derived in the
// emitter, not picked: the Camera_X view matches the retired timer view's apparent speed
// at PHYS_TOP_SPEED, the Camera_Y view is tuned so one full pattern cycle costs about
// one screen height of vertical travel, and the TIMER view (row 3) is the retired view's
// own rate restored unchanged, so the A/B the owner asked for varies the driver and
// nothing else. See tools/inject_editor_bg.py's `default_off` block for all three.
//
// ---- WHAT "PERSPECTIVE VS TIMER" ACTUALLY LOOKS LIKE, so the reviewer knows ----
// Rows 1 and 3 are the comparison; row 2 is the vertical variant of row 1.
//   moving at PHYS_TOP_SPEED   row 1 = 0.375 px/frame   row 3 = 0.25 px/frame
//   standing still             row 1 = 0     px/frame   row 3 = 0.25 px/frame
// The tempos are within 1.5x of each other on purpose. The DIFFERENCE to judge is the
// second line: the camera arm stops when the player stops and the timer arm does not.
//
// ⚠ THE SENTENCE THAT USED TO SIT HERE WAS STALE AND IS CORRECTED (2026-09-04). It said a
// genuinely vertical band "needs vertically pre-shifted phase art and a ROW-MAJOR slot
// order in `layout`, neither of which any writer in this tree can produce today". The
// second clause is still true of the AUTHORED ACT — a band in the owner's background does
// need row-major layout words he has not authored — but the first was overtaken the day
// after it was written: `axis` is an emitter-understood band key, aurora shipped the
// column-wise shift-fill writer, and tools/bganim_vprobe_gen.py produces vertically
// pre-shifted banks right here. Rows 4 and 5 below are the consequence.
//
// ---- ROWS 4 AND 5: THE VERTICAL BAND AND ITS CONTROL ----
// (They were rows 3 and 4 until 2026-09-04, when the TIMER view was inserted at 3 so the
// owner's A/B is one press wide. Every mention of them below moved with them.)
// Row 4 is the first band in any ROM this project has built whose axis is VERTICAL: its
// own 2,048 B of art, rolled UP one pixel per bank, slots in row-major order, rotation
// unit COLS*32 = 64 B, period ROWS*8 = 32 px. Row 5 is the SAME art, driver and rate with
// the two axis-carrying fields set horizontally (unit 128 B, period 16 px) — it is not a
// band anyone would author, it is the control that makes row 4's witness mean something.
// Declared at the foot of this file.
//
// ⚠ ROWS 4 AND 5 PUT NOTHING ON THE SCREEN, BY CONSTRUCTION. They aim at the BG region's
// unused band reserve ($A800 = slot 1344; games/sonic4/vram.toml `band_reserve`), which
// no plane cell references. That keeps the owner's canopy intact and keeps a VRAM
// measurement unconfounded, and it means a reviewer pressing past row 3 sees the picture
// stop changing rather than a second animation. Making it visible needs plane cells in
// row-major order over those slots — an authoring change to the act's document, not an
// engine one.
//
// ---- WHY START+C, WITH THE PAD RE-ENUMERATED FROM THE CODE (2026-09-04) ----
// The owner asked for "start + button". Yesterday's header said no START+face pairing was
// reachable and settled on C+A; that paragraph was a DAY OLD and F4 had landed since, so
// the pad was walked again from the call sites rather than from the paragraph. Every line
// below was read out of this tree today, and the conclusion CHANGED — not because
// anything moved, but because the earlier pass rejected START+C on a collision that only
// exists WITH A DIRECTION HELD, which is a condition a gate can test.
//
// EVERY CONSUMER OF THE PAD IN THE SHAPE THIS LAB RUNS IN (canonical DEBUG, OJZ scene):
//   START + LEFT/RIGHT   Debug_SceneCycleHotkey     scene cycle       (direction PRESS)
//   START + UP/DOWN      Debug_BandDemoHotkey       raster cycle/off  (direction PRESS)
//   START + A            Debug_PresetCycleHotkey    preset cycle      (A PRESS)
//   C     + LEFT/RIGHT   this module, ~:1343        approach-ramp arm (direction HELD)
//   C     + UP/DOWN      this module, ~:1255        anchor nudge      (direction HELD)
//   A                    Debug_CharacterHotkey      character cycle   (A PRESS, in fly)
//   B                    Player_Main / TestPlayer_Main   CHEAT_DEBUG_FLY toggle (B PRESS)
//   START or C held      Debug_TierTags_Update      ARMS the two name tags (F4)
//   directions           Player_DebugMove           free flight — DIRECTIONS ONLY
// and nothing anywhere reads a C PRESS. (Debug_MusicToggle in games/sonic4/debug/ does
// claim A/B/C/UP/START, but config/game.emp binds `debug_tick` only under
// SOUND_DEBUG_HOTKEYS — the off-canonical Config-A profile — so it emits nothing in
// either canonical shape. In THAT profile a START+C press also fires its drum-test song,
// exactly as today's START+A also fires its music restart: a pre-existing property of a
// shape the lab is not played in, not something this chord introduces.)
//
// So the three modifier+face pairings, judged against that list:
//   START+A        SPENT — the preset tier. Not available, and moving it would change a
//                  chord the owner already uses to reach preset 6.
//   START+B        REJECTED, unchanged: the CHEAT_DEBUG_FLY toggle is on the B PRESS and
//                  is armed at boot in this shape, so the chord would drop the player out
//                  of free flight on its way here. Its readers live in
//                  games/sonic4/player/ and games/sonic4/objects/test_player.emp, so
//                  vetoing it would spread the lab across the player.
//   START+C        REACHABLE, and this is where the earlier pass was wrong. Its stated
//                  objection was "START+C+direction would nudge as well as cycle" — true,
//                  and it names its own remedy: the two C chords are the ONLY other
//                  readers of C, they are the two rows above marked "direction HELD", and
//                  BOTH of them already return without doing anything when no direction
//                  is held ("C alone, or C with both: no move"). A NO-DIRECTION-HELD veto
//                  on this chord therefore partitions C cleanly, with nothing to change
//                  outside this proc:
//                      START + C, no direction   this cycle, and only this
//                      C + direction             nudge / ramp, exactly as before
//                      START + direction         scene / raster, exactly as before
//                  One `andi.b #$0F` and a branch buy that. It is also the same mask the
//                  START+direction chords occupy, so the one veto covers both families.
// X/Y/Z/MODE were rejected for the fifth time for the reason the scene cycle records:
// they exist only when the pad enumerates as PAD_6BTN, so the chord would be silently
// INERT on a 3-button pad — the worst failure a review tool can have.
//
// TWO THINGS THE MOVE BUYS BEYOND ANSWERING THE ASK. START+C is already the gesture that
// ARMS F4's name tags (Debug_TierTags_Update reads `START|C` held), so the first press of
// this chord now also puts the readout on screen that says which view it just installed —
// the two used to need separate gestures. And Debug_CharacterHotkey's C veto stops being
// load-bearing for THIS chord; it is kept anyway, re-justified in place, because C is
// still a lab modifier and a reviewer nudging with C who taps A should still not swap
// characters.
//
// THE COST, STATED: outside debug free-flight C is a jump button, so START+C makes the
// player jump as well as step. That is the same cost every other chord in this module
// already accepts, and it is nothing in free flight, where Player_DebugMove reads
// directions only and C is inert.
//
// ---- WHAT REPLACED THE OLD SECOND MODIFIER GATE ----
// C+A needed a `START held` veto because START+A is the preset tier and a reviewer
// holding both modifiers would fire both. With the chord on START+C that veto is gone —
// START is now this chord's OWN modifier — and the direction veto above takes its place,
// doing the same job for the other overlap. The count of gates is unchanged at four.
//
// ---- OFF FREEZES THE BAND, IT DOES NOT REWIND IT ----
// Stated because it is visible and a reader would otherwise call it a bug. Turning a
// view off stops the walk; it does not re-DMA phase 0, so the slots keep whatever phase
// last landed. The band's phase 0 IS its slots' static rest state
// (`validate_band_coherence` asserts `phases[0] == tiles[base:base+n]`), so a cold boot
// is the only guaranteed phase-0 picture — after that OFF shows the art shifted by up to
// 63 px within its own 64 px pattern. Nothing in the act reads as broken, because the
// band's slots are deduped across the whole layout and shift together; rewinding would
// mean an extra DMA on a keypress for a debug view, which is not worth the code.
//
// ---- LIVE INPUT ONLY ----
// Required, not defensive, and the same gate for the same reason as its five siblings:
// START and C both ride in the main controller byte that engine/system/replay.emp records
// whole and replays whole, and the slide fixture deliberately enters debug-fly.
//
// DEBUG-shape only: the body — the rts AND the pointer table included — sits inside
// `if DEBUG == 1 {}`, so the whole proc emits ZERO bytes in the plain shape, and it is
// parked as the SIXTH member of this module's zero-release-byte run.
//
// In:  none (reads Ctrl_1_Held / Ctrl_1_Press / Input_Source / Debug_BgAnim_View)
// Out: Debug_BgAnim_View advanced and the named table handed to BgAnim_SetTable, iff
//      the chord fired this frame
// Clobbers: d0-d1 (the two input latches, then the cursor), a0 (the table pointer handed
//      to BgAnim_SetTable, which declares d0), a1 (the table cursor — the raster cycle's
//      a1, same job).
// -----------------------------------------------
// The row count, stated ONCE. The cursor wraps at this and then indexes the table, so a
// mirror drifting above it would fetch a pointer past the table's end and hand it to
// BgAnim_SetTable as a band table. Six rows: OFF, the Camera_X view, the Camera_Y view,
// the TIMER view, the VERTICAL-AXIS probe band, and that band's horizontal-axis control.
const BGANIM_VIEW_CYCLE_COUNT = 6

proc Debug_BgAnimViewHotkey () clobbers(d0-d1/a0-a1) {
    if DEBUG == 1 {
        // Gate 1: live input only — see the header. INPUT_LIVE is 0, so a `tst.b` is
        // the whole test; the ensure that pins that sits at Debug_CharacterHotkey.
        tst.b   Input_Source                    // (Input_Source).w
        bne     .done

        // Gate 2: the modifier, and Gate 3: the NO-DIRECTION veto that keeps this chord
        // disjoint from the four direction chords. Both read from ONE fetch of the held
        // latch into two registers, the idiom the raster cycle uses for its two
        // directions.
        //
        // THE VETO IS THE WHOLE REASON START+C IS AVAILABLE (see the header). C is also
        // the modifier for this module's anchor-nudge and approach-ramp chords, and
        // START is the modifier for the scene and raster cycles — every one of those
        // four needs a DIRECTION, and the two C ones already do nothing without one.
        // Standing this chord down whenever any direction is held therefore partitions
        // the pad with nothing to change outside this proc, and it is why no veto had to
        // be planted in a sibling hotkey the way C+A needed one in
        // Debug_CharacterHotkey.
        //
        // HELD for both halves, not press: START is a chord modifier and must still
        // count on the frames after it went down, and a direction the reviewer is
        // leaning on must keep vetoing for as long as he leans on it (a press-only test
        // would let a HELD direction through one frame later).
        move.b  Ctrl_1_Held, d0                 // tick-stable held latch
        move.b  d0, d1
        andi.b  #BUTTON_START, d0
        beq     .done                           // START is this chord's shift key
        andi.b  #BUTTON_UP|BUTTON_DOWN|BUTTON_LEFT|BUTTON_RIGHT, d1
        bne     .done                           // a direction is held: that is one of the
                                                // four direction chords, not this one

        // Gate 4: the button, EDGE-triggered so holding C does not re-install every
        // frame (which would poison BgAnim_LastStep every frame and re-DMA the band
        // continuously). Nothing else in this shape reads a C PRESS — the header's
        // enumeration is the check on that.
        move.b  Ctrl_1_Press, d0                // tick-stable press latch
        andi.b  #BUTTON_C, d0
        beq     .done

        // ADVANCE-THEN-INSTALL, the preset cycle's order and for its reason: boot
        // clears Work RAM so the cursor reads 0, and row 0 is OFF — which is already
        // what is on screen. Installing first would spend a reviewer's FIRST press
        // showing him no change at all.
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  Debug_BgAnim_View, d0           // (Debug_BgAnim_View).w
        assert.w d0, ls, #BGANIM_VIEW_CYCLE_COUNT-1  // in table range — checked BEFORE
                                                // the advance, so a corrupt cursor can
                                                // neither be written back nor fetch a
                                                // pointer from past the table
        addq.w  #1, d0                          // the cursor only ever steps by one, so
        cmpi.w  #BGANIM_VIEW_CYCLE_COUNT, d0    // equality is the whole wrap condition
        bne     .no_wrap
        moveq   #0, d0
    .no_wrap:
        move.b  d0, Debug_BgAnim_View           // (Debug_BgAnim_View).w

        // Tail call (§2.8): BgAnim_SetTable declares d0, which is inside this proc's
        // set, and nothing follows it on this arm.
        lsl.w   #2, d0                          // x sizeof(pointer); no scaled indexing
                                                // on the 68000
        lea     .view_table(pc), a1
        movea.l (a1,d0.w), a0                   // the table this press installs
        jbra    BgAnim_SetTable

    .done:
        rts

        // THE TABLE. Every 68000 instruction is an even number of bytes, so the label
        // after `rts` is word-aligned by construction — the reasoning `.raster_table`
        // and `.scene_table` both record above.
        //
        // THE ROWS ARE IMPORTED BY NAME (the `use` at the head of this file), for the
        // reason the raster cycle's header states: an unknown name in a Label position
        // does NOT error in `.emp`, it silently becomes a link extern, so a misspelled
        // row would resolve to nothing the build complains about and surface as a wild
        // band table handed to a DMA queue.
        // EXPORTED for `.raster_table`'s reason: Debug_TierTags_Update scans it to turn
        // the live `BgAnim_Table_Ptr` back into a row index for its name tag.
    export .view_table:
        dc.l    BgAnim_Table                    // 0 — OFF (this act's own table; its
                                                //     band count is 0, `default_off`)
        dc.l    BgAnim_View_H                   // 1 — Camera_X, the horizontal view
        dc.l    BgAnim_View_V                   // 2 — Camera_Y, the vertical view
        dc.l    BgAnim_View_T                   // 3 — Logic_Tick, the TIMER view: the
                                                //     other arm of "perspective vs timer".
                                                //     INSERTED here, not appended, so the
                                                //     A/B against row 1 is one press wide
        dc.l    BgAnim_View_Vert                // 4 — the VERTICAL-AXIS band (own art,
                                                //     $A800, off-screen — see the header)
        dc.l    BgAnim_View_VertCtl             // 5 — row 4's horizontal-axis control
    }
}


// -----------------------------------------------
// Debug_PresetReadout_Show — THE PRESET TIER'S READOUT, and the half of this parcel
// that answers the owner's actual complaint. Cycling without a label reproduces the
// problem it was built to fix ("there's like 6 in 1 section and I don't know what I'm
// looking for"), so the picture has to name itself AND has to admit when it is empty.
//
// Two 8x8 cells on a second row under the scene readout:
//
//   cell 0 (screen 12..19 x 28..35)   the SECTION whose preset is installed, one
//                                     decimal digit, from the scene readout's own
//                                     ten-glyph font — the same numbering the act
//                                     descriptor, the section markers and the owner
//                                     all already use
//   cell 1 (screen 20..27 x 28..35)   the VERDICT, one of FOUR glyphs
//
// ---- THE VERDICT IS THE POINT, AND HERE IS WHAT EACH GLYPH MEANS ----
//
//   bar  "-"    NOTHING IS BOUND, IN ANY CHANNEL THIS GLYPH CAN SEE — and since
//               2026-09-04 that includes the parallax channel (see the arrow below).
//               The preset carries no raster program, no patched program and no
//               palette cycle, AND the background scene the section resolves to is
//               the act's own default. Section 7 is this; it is the control. It is
//               not a failure; it is the difference between "I can't see it" and
//               "it isn't there", and a reviewer who cannot tell those apart will
//               hunt for minutes. (The owner just did.)
//
//   arrow "->"  PARALLAX, AND YOU HAVE TO MOVE. Nothing is bound in the three
//               channels above, but this section resolves a background scene of its
//               OWN — a `parallax_config` record that is not the act default — so
//               the preset does change the picture, through the one channel that
//               only expresses itself while the camera travels. Section 8 (the
//               perspective floor) is exactly this: at a standstill it is a picture
//               of a floor, and the recession only exists while you move.
//
//   X           BOUND BUT BLIND HERE. The preset installs a PATCHED program, whose
//               boundaries are WORLD Y anchors rather than screen lines, and after
//               the install every one of them latched outside 0..SCREEN_HEIGHT-1 at
//               this camera position. The effect is installed, the hardware is
//               configured, and it draws nothing you can see, because the line it
//               would draw on is above or below the screen. Section 0's preset is
//               exactly this anywhere but the top of the act: its two water
//               boundaries are anchored at world Y 224 and 314.
//
//   diamond     LIVE. Either a static raster program (whose bands are authored in
//               SCREEN space, so they are on screen by construction), or a palette
//               cycle (CRAM, visible wherever you stand), or a patched program with
//               at least one boundary currently on screen.
//
// THIS IS THE DEFECT THAT MOTIVATED THE WHOLE PARCEL, generalised. An effect can be
// structurally unable to draw where it is installed — a reels demo bound to a scene
// with per-column vertical scroll off, a water boundary anchored off the top of the
// screen — and the failure LOOKS EXACTLY LIKE a broken effect. "Selected but cannot
// show here" is the single most valuable sentence a review tool can say.
//
// ---- WHY THE ARROW EXISTS: THE SAME DEFECT, INVERTED ----
//
// The three-glyph vocabulary was blind to the parallax channel, and on 2026-09-03 that
// blindness produced the exact failure this readout exists to prevent, running the other
// way: section 8's perspective floor filled the bottom third of the screen while the
// glyph read the BAR — "nothing is bound". A reviewer trusting the glyph would skip the
// one preset that had something new to show. Under-reporting a live effect is strictly
// worse than the over-hunting the bar was invented to stop, because the reviewer never
// even looks.
//
// ---- HOW THE PARALLAX TRUTH IS DERIVED, AND WHY IT CANNOT BE THE PRESET RECORD ----
//
// SECTIONS 7 AND 8 SHARE ONE `EffectsPreset` — both bind `OJZ_Preset_Plain`
// (games/sonic4/data/levels/ojz/act1/act_descriptor.emp), whose `ep_parallax` is 0. The
// ONLY thing that differs is `Sec.sec_parallax_config`, which section 8 carries and
// section 7 does not. So reading `ep_parallax` off `a3` — the obvious spelling, and the
// one the other three channels use — gives BOTH sections the same answer and cannot tell
// the floor from the control. The question has to be asked of the SECTION.
//
// It is asked through `Effects_ResolveParallax` — the engine's ONE three-way resolution
// (Sec.sec_parallax_config > ep_parallax > Act.act_parallax_config), the same proc
// `Effects_InstallPreset` tail-calls to decide what actually gets installed. Reusing it
// rather than re-implementing the ladder is what stops the glyph and the install drifting
// apart; that pair already drifted once (2026-08-26, two sites reading different rungs),
// and the fix was to make there be one site.
//
// The BASELINE it is compared against is `Act.act_parallax_config`, read from the live
// act. NOTHING IS LISTED AND NOTHING IS NAMED: no section index appears in the test, so a
// scene attached to or detached from any section moves the glyph with it, and an act with
// different sections needs no edit here. A hand-written "presets 4 and 8 are parallax"
// table would have been wrong the first time a sidecar changed.
//
// WHAT THE ARROW PROMISES: this section resolves a parallax_config that is not the act's
// default, and the other three channels bind nothing.
// WHAT IT DOES NOT PROMISE, and each of these is real:
//   * That the scene LOOKS different from the act default. The test is record IDENTITY,
//     not record contents — an authored scene whose numbers happen to match the default
//     still reads the arrow. Nothing here reads a band.
//   * That any of it is on screen. Background bands are anchored to PLANE lines, and the
//     BG plane draws BEHIND the level's own terrain; the floor is invisible from ground
//     level and needs debug free-flight. This is the parallax analogue of the X state,
//     and it is deliberately NOT tested — a plane-line-to-screen-line answer would need
//     the same latch machinery the patch channels have and the bands do not.
//   * That anything moves while you stand still. The arrow is precisely the state that
//     says it will not.
//
// PRECEDENCE — the arrow OUTRANKS NOTHING. It is a refinement of the bar and only the
// bar: a preset that binds a raster program AND its own scene still reads the diamond,
// and section 0's water still reads X even though it also installs the underwater scene.
// One cell holds one glyph, and of the four the ranking is LIVE > BLIND > PARALLAX >
// NONE, because that is descending actionability — "look now" beats "move up or down
// until it flips" beats "travel sideways" beats "there is nothing here". The cost is
// stated rather than hidden: on a preset that binds both, the parallax half is not
// reported. Giving it its own cell is a VRAM allocation (a THIRD region — the free run
// beside `debug_readout` is spent), not a free change.
//
// ---- WHAT THE VERDICT DOES NOT CLAIM, WHICH MATTERS MORE THAN WHAT IT DOES ----
// It is a PRECONDITION test, not a proof of visibility. A diamond says the channel is
// installed and its boundary is on screen; it does not say the colours differ from
// the art behind them, that the band is taller than a scanline, or that the program
// does anything interesting. And it is computed ONCE, at the press, against the
// camera as it stood then — walk away and a diamond can go stale into an X without
// the glyph changing. Recomputing per frame would mean a VRAM DMA every frame for a
// debug label; the press is where the reviewer's question is asked, so the press is
// where it is answered. Both limits are real and both are why the glyph vocabulary is
// three states and not a green light.
//
// TWO PRECONDITIONS ARE MET BY CONSTRUCTION HERE, and are deliberately not tested:
// the VDP mode bits (per-column vscroll, $0B bit 2) and the parallax config arrive
// with the preset, because the lab installs the section's WHOLE preset and lets
// Parallax_StartTransition rewrite the mode shadow from the incoming config — the
// same tail a crossing takes. That is the structural fix for the reels class of
// defect; testing for it here would be testing this proc's own caller.
//
// ---- WHY IT REUSES THE SCENE READOUT'S MACHINERY ----
// The digit font (`.digit_font`) and the glyph-object builder (`.ensure_glyph`) are
// Debug_SceneReadout_Show's, referenced module-qualified (§1.5). Duplicating either
// would put 320 DEBUG bytes and a second copy of the System-slot claim rules in the
// tree for a readout that wants the same digits in the same style. Everything that
// header argues for its two cells holds unchanged for these two: System slots rather
// than the dynamic pool (RunObjects culls the dynamic pool on WORLD distance and would
// cull a screen-space object into invisibility), built on first press rather than at
// level init (so every replay fixture keeps its sprite table byte for byte), and DMA
// rather than a direct VDP write (the display is on here).
//
// The slots are the two BELOW the scene readout's, still counted from the top of the
// System pool, still claimed by address because the pool has no allocator.
//
// DEBUG-shape only: the body, the `rts` and the verdict font are all inside
// `if DEBUG == 1 {}`, so the whole proc emits ZERO bytes in the plain shape. Parked
// inside this module's zero-release-byte run — see Debug_PresetCycleHotkey's header
// above for what that buys (a byte-identical executable image) and what it does NOT
// (the appendix does not dedupe; this label is one of the two names in it that moved
// the release CRC).
//
// In:  none (reads Debug_Preset_Index, Current_Act_Ptr, Effects_World_Y,
//      Effects_Screen_L, the named preset's channels, and — through
//      Effects_ResolveParallax — the named SECTION's resolved parallax config)
// Out: the two glyph objects exist and the two VRAM cells are queued to show the
//      section digit and the verdict
// Clobbers: d0-d4, a0-a3 — d0-d4/a1-a2 is QueueDMA_Critical's declared set, d2/a1
//      also RefreshSpritePieceCount's, a3 holds the EffectsPreset* across the verdict,
//      and a0 is the SST cursor, then the anchor cursor OR the Sec* handed to
//      Effects_ResolveParallax (the two verdict arms are exclusive), then the font
//      base. a1 additionally parks the act-default config across that call, which is
//      safe because the callee declares a0 alone.
// -----------------------------------------------
// render_flags for every screen-space cell this lab draws — both preset cells here and
// both tier tags below — written WHOLE rather than or-ed in: front band (7) + screen
// coordinates. A whole-byte write has no C1c inherited-band hazard by construction
// (there is nothing to union with), and these objects' flags are owned here and nowhere
// else. Declared at this readout because the retired Debug_SceneReadout_Show, which
// declared them while the lab had a cursor-digit readout, is gone; the NAMES are kept as
// they were so nothing that greps for them has to be re-taught.
const DEBUG_READOUT_FLAGS = (7 << RF_PRIORITY_SHIFT) | (1 << RF_COORDMODE)
// Map_TestObj's third frame: one 8x8 piece at art_tile + 0. See
// games/sonic4/data/mappings/test_mappings.emp. The two tier tags below do NOT use it —
// they need a WIDER piece and carry their own hand-written frame records.
const DEBUG_READOUT_FRAME = 2
// Second row, 20 px under the entry name tag's. Map_TestObj frame 2 is
// `centered(half: 4, ...)`, so the object position is the CELL CENTRE: the digit
// covers screen x 12..19 and the verdict x 20..27, both y 28..35.
const DEBUG_PRESET_READOUT_X = 16
const DEBUG_PRESET_READOUT_Y = 32
// The two System slots the preset cells occupy — counted from the TOP of the pool and
// claimed by address (the System pool has no allocator; see Debug_TierTags_Update's
// header, which now carries that argument since the scene readout that first made it
// retired with the three-chord lab).
//
// THE SLOT NUMBERS DID NOT MOVE when the lab lost a readout. NUM_SYSTEM-2 — the scene
// readout's ones digit — is simply FREE now, and the four survivors keep the addresses
// they had, so nothing that inspected a slot by address in a debugger session has to be
// re-derived.
ensure(NUM_SYSTEM >= 4,
       "preset readout: the effects lab claims FOUR System slots by address (the entry name tag, the two preset cells, the two tier tags), but NUM_SYSTEM is {NUM_SYSTEM}")
equ DEBUG_PRESET_SST_SEC     = extern("System_Slots") + sizeof(Sst) * (NUM_SYSTEM - 4)
equ DEBUG_PRESET_SST_VERDICT = extern("System_Slots") + sizeof(Sst) * (NUM_SYSTEM - 3)
// The verdict glyph indices, which are also row numbers in `.verdict_font` below.
// APPENDED, NEVER RENUMBERED: PARALLAX took index 3 and BLANK took index 4, so every
// existing row keeps its bytes and its meaning. tools/test_preset_verdict_font_lint.py
// holds the count of these constants to the number of rows in the sheet — the index is
// used raw as a `lsl.w #5` table offset, so one more constant than row reads 32 bytes
// past the sheet and DMAs whatever follows it in ROM into the glyph cell.
const PRESET_VERDICT_NONE     = 0       // bar     — nothing bound, parallax channel included
const PRESET_VERDICT_BLIND    = 1       // X       — bound, but off screen here
const PRESET_VERDICT_LIVE     = 2       // diamond — bound and on screen
const PRESET_VERDICT_PARALLAX = 3       // arrow   — its own background scene; MOVE to see it
const PRESET_VERDICT_BLANK    = 4       // nothing — the lab cursor is not on a preset row
proc Debug_PresetReadout_Show () clobbers(d0-d4/a0-a3) {
    if DEBUG == 1 {
        // -- (1) make sure the two glyph objects exist --
        // Palette line 1 + priority 1, the pairing the scene readout and the debug-fly
        // marker both use: line 1 entry 12 is the bright yellow that is known to stay
        // legible over this act.
        move.l  #DEBUG_PRESET_READOUT_Y << 16, d4   // the row; d4 survives the builder
        movea.l #DEBUG_PRESET_SST_SEC, a0
        move.l  #DEBUG_PRESET_READOUT_X << 16, d1
        move.w  #vram_art(VRAM_DEBUG_PRESET_READOUT, 1, 1), d3     // section digit
        jbsr    .ensure_glyph
        movea.l #DEBUG_PRESET_SST_VERDICT, a0
        move.l  #(DEBUG_PRESET_READOUT_X + 8) << 16, d1
        move.w  #vram_art(VRAM_DEBUG_PRESET_READOUT + 1, 1, 1), d3 // verdict glyph
        jbsr    .ensure_glyph

        // -- (2) resolve the preset the cursor names --
        // The SECTION comes out of the lab list's own row, not out of a cursor of this
        // readout's own: `Debug_Lab_Index` names a row of `.lab_index`, and on a PRESET
        // row that row's sub-index IS the flat section id. Re-derived here rather than
        // passed in a register so this proc's contract stays "reads the cursor" — a
        // readout that had to be handed its subject could not be called from a tail, and
        // this one is.
        //
        // IT IS ONLY EVER CALLED ON A PRESET ROW (Debug_LabCycleHotkey's `.preset` arm);
        // every other row calls Debug_PresetReadout_Blank below instead. The assert on
        // the sub-index is what makes that a checked precondition rather than a comment:
        // a scene row's sub-index can reach 20, which is past this act's section count
        // and past the single digit this readout can draw.
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  Debug_Lab_Index, d0             // (Debug_Lab_Index).w
        mul_const.w d0, #LAB_ENTRY_SIZE, d1     // d0 = row byte offset (d1 scratch)
        lea     Debug_LabCycleHotkey.lab_index(pc), a1
        adda.w  d0, a1                          // a1 = the row
        moveq   #0, d0
        move.b  1(a1), d0                       // d0 = the row's sub-index = the section
        movea.l Current_Act_Ptr, a2             // (Current_Act_Ptr).w
        movea.l Act.sec_grid_ptr(a2), a0
        move.w  d0, d4                          // d4 = the digit, kept across the verdict
        mul_const.w d0, #sizeof(Sec), d1        // d0 = section x the Sec stride (d1 scratch)
        adda.w  d0, a0
        movea.l Sec.sec_effects(a0), a3         // a3 = EffectsPreset*

        // -- (3) the verdict. See the header for what each state means. --
        moveq   #PRESET_VERDICT_NONE, d3
        tst.l   EffectsPreset.ep_patched(a3)
        beq     .not_patched

        // A patched program's boundaries are WORLD anchors, so "is it on screen" is a
        // real question with a real answer, and this is where it is asked. BLIND until
        // proven otherwise: one visible boundary is enough, because one visible
        // boundary is something the reviewer can look at.
        //
        // Effects_Screen_L is `anchor - Camera_Y`, SIGNED and UNCLAMPED — that is the
        // whole reason the engine keeps it (engine/ram.emp): Raster_BuildSchedule's own
        // fire line is clamped into the record's band and therefore cannot express
        // "the boundary is above the screen", which is exactly the state this reads.
        // It was latched against THIS preset's anchors moments ago, by the
        // Effects_LatchWorldLines call inside Effects_InstallPreset.
        //
        // The PATCH_ANCHOR_NONE test is not redundant with the range test even though
        // $7FFF - Camera_Y is off screen for every camera this act can reach: an act
        // whose vertical extent approached $7FFF would fold an unauthored channel back
        // into range and report a boundary that does not exist. Cheaper to ask.
        moveq   #PRESET_VERDICT_BLIND, d3
        lea     Effects_World_Y, a0
        lea     Effects_Screen_L, a1
        moveq   #RASTER_MAX_PATCH-1, d0
    .verdict_loop:
        move.w  (a0)+, d1                       // this channel's world anchor
        move.w  (a1)+, d2                       // ... and its latched screen line
        cmpi.w  #PATCH_ANCHOR_NONE, d1
        beq     .verdict_next                   // channel not authored
        tst.w   d2
        bmi     .verdict_next                   // above the screen
        cmpi.w  #SCREEN_HEIGHT, d2
        bge     .verdict_next                   // below it
        moveq   #PRESET_VERDICT_LIVE, d3
        jbra    .verdict_done
    .verdict_next:
        dbf     d0, .verdict_loop
        jbra    .verdict_done

    .not_patched:
        // ep_raster and ep_patched are mutually exclusive (preset()'s own comptime
        // ensure), so this arm covers the static tier. A static program's bands are
        // authored in SCREEN space and are on screen by construction, so the only
        // question left is whether anything is bound at all — and the sentinels are
        // what answer it: a preset means "off" with the explicit empty program and the
        // empty cycle script, never with a 0 (a 0 would mean "keep", which is the
        // semantic total binding exists to delete).
        move.l  EffectsPreset.ep_raster(a3), d1
        cmpi.l  #Raster_Program_None, d1
        bne     .verdict_live
        move.l  EffectsPreset.ep_cycle(a3), d1
        cmpi.l  #Pal_Cycle_None, d1
        bne     .verdict_live

        // -- THE PARALLAX CHANNEL, asked last and only here. See the header for why the
        //    question is put to the SECTION rather than to the preset record (sections 7
        //    and 8 share one EffectsPreset and differ only in Sec.sec_parallax_config),
        //    and for exactly what the arrow does and does not promise.
        //
        //    a0 is STILL the Sec* resolved in step (2) — the patched arm is what
        //    repurposes it, and this arm never runs after that one. a2 is still
        //    Current_Act_Ptr. Effects_ResolveParallax declares a0 alone, so the baseline
        //    parked in a1 survives the call; a1 is inside this proc's declared set.
        //
        //    The baseline is read BEFORE the call and not after, because the callee's own
        //    act-default rung reloads Current_Act_Ptr into a0 — reading it afterwards
        //    would be reading it out of a register the callee has already overwritten.
        movea.l Act.act_parallax_config(a2), a1 // the act's own background: the baseline
        jbsr    Effects_ResolveParallax         // a0 = Sec* in, parallax_config* out
        cmpa.l  a1, a0
        beq     .verdict_done                   // the act default: nothing bound at all
        moveq   #PRESET_VERDICT_PARALLAX, d3
        jbra    .verdict_done
    .verdict_live:
        moveq   #PRESET_VERDICT_LIVE, d3
    .verdict_done:

        // -- (4) queue both cells. Two entries, not one: the sources are a row of the
        //    scene readout's digit sheet and a row of the verdict sheet below, which
        //    are two different tables in ROM. --
        // The digit first. d4 holds the cursor, which the clamp in the hotkey bounds
        // at 9, so it indexes the ten-glyph sheet directly with no tens split — the
        // one place this readout is simpler than the scene readout rather than the
        // same. The assert is the guard that keeps it that way if the clamp ever moves.
        assert.w d4, ls, #PRESET_CYCLE_MAX-1    // one digit — see PRESET_CYCLE_MAX, and
                                                // the precondition in step (2)
        move.w  d3, -(sp)                       // the verdict; d0-d4 do not survive the DMA
        lea     .digit_font(pc), a0
        lsl.w   #5, d4                          // digit x 32 bytes per glyph
        lea     (a0,d4.w), a1
        move.l  a1, d1                          // d1 = DMA source
        move.w  #vram_bytes(VRAM_DEBUG_PRESET_READOUT), d2
        moveq   #32, d3                         // one 8x8 4bpp tile
        jbsr    QueueDMA_Critical @discards(dropped)    // review tool: a dropped glyph
                                                        // costs one stale cell, never a
                                                        // missed preset install
        move.w  (sp)+, d0                       // the verdict index
        lea     .verdict_font(pc), a0
        lsl.w   #5, d0                          // verdict x 32
        lea     (a0,d0.w), a1
        move.l  a1, d1
        move.w  #vram_bytes(VRAM_DEBUG_PRESET_READOUT + 1), d2
        moveq   #32, d3
        jbra    QueueDMA_Critical @discards(dropped)    // tail call (§2.8)

        // -----------------------------------------------
        // .verdict_font — FOUR 8x8 4bpp tiles, 32 bytes each, in
        // PRESET_VERDICT_* order. Same form and same colour as the scene readout's
        // digit sheet: one hex nibble per pixel, left to right, colour index $C,
        // which on palette line 1 is the bright yellow the debug-fly marker uses.
        // The source IS the picture, for that sheet's stated reason.
        //
        // It lives INSIDE the `if DEBUG == 1` because a module-scope `data` item
        // cannot be shape-gated in `.emp` (§1.7), and 128 release bytes for a debug
        // glyph sheet is exactly what this parcel must not spend.
        //
        // THE ROW COUNT IS A GATE, not a comment: the verdict index reaches this sheet
        // as a raw `lsl.w #5` offset, so a PRESET_VERDICT_* constant with no row here
        // would DMA the 32 bytes that follow the sheet into the glyph cell — a garbage
        // tile, on the readout whose whole job is to be trusted. tools/
        // test_preset_verdict_font_lint.py counts both and fails the build's pytest
        // lane when they disagree.
        // -----------------------------------------------
    export .verdict_font:
        dc.l    $00000000, $00000000, $00000000, $0CCCCC00      // 0 — bar: nothing bound
        dc.l    $00000000, $00000000, $00000000, $00000000
        dc.l    $00000000, $0C0000C0, $00C00C00, $000CC000      // 1 — X: bound, blind here
        dc.l    $000CC000, $00C00C00, $0C0000C0, $00000000
        dc.l    $00000000, $000CC000, $00CCCC00, $0CCCCCC0      // 2 — diamond: live
        dc.l    $0CCCCCC0, $00CCCC00, $000CC000, $00000000
        // 3 — the MOVE arrow: its own background scene, and it only shows while you
        // travel. A right-pointing arrow rather than another abstract mark, because the
        // instruction ("go") IS the verdict, and because the two chords that satisfy it
        // are LEFT and RIGHT on the same pad. Shaft on row 3 across columns 1-6, tip at
        // column 6, barbs stepping back to column 4 — the same 6-px span and the same
        // one-pixel margin the bar and the diamond keep, so the four glyphs read as one
        // set at 8x8.
        dc.l    $00000000, $0000C000, $00000C00, $0CCCCCC0
        dc.l    $00000C00, $0000C000, $00000000, $00000000
        // 4 — BLANK: not a verdict at all, and that is what it says. The lab cursor is
        // standing on a SCENE or a RASTER row, so there is no preset for these two cells
        // to be about. An all-zero 4bpp tile is fully transparent, so both cells read as
        // empty screen rather than as an answer. It exists because the alternative —
        // leaving the last preset's digit and verdict standing while the cursor walks
        // away — is the readout lying by staleness, which is the one failure mode this
        // whole family of readouts exists to remove.
        dc.l    $00000000, $00000000, $00000000, $00000000
        dc.l    $00000000, $00000000, $00000000, $00000000

        // -----------------------------------------------
        // .ensure_glyph — build one glyph object into its System slot, once.
        // In:  a0 = the System slot's SST, d1 = screen X (16.16), d4 = screen Y
        //      (16.16), d3 = art_tile word
        // Out: that slot holds a live display-only screen-space object
        // Clobbers: d2 and a1, both via RefreshSpritePieceCount. a0/d1/d3/d4 survive,
        //      which is what lets the caller set up once per cell AND once per row.
        // -----------------------------------------------
        // IT MOVED HERE ON 2026-09-05 from the retired Debug_SceneReadout_Show, which
        // owned it while the lab had a two-digit cursor readout to draw with it. This
        // readout is now its only caller, so it lives with its caller. Everything about
        // it is unchanged, including `code_addr == 0` as the "not built yet" test: boot
        // clears all of Work RAM (engine/system/boot.emp `.clear_ram`), and nothing else
        // writes these two slots.
        //
        // WHY OBJECTS, AND WHY SYSTEM SLOTS — the argument in full, because its previous
        // home is gone. A sprite is the only surface here that does not scroll with the
        // level and does not have to be re-drawn every frame by hand: Plane A is the
        // streaming tile cache, Plane B is the background, and the window plane's
        // nametable base ($F000) is inside Plane B's own 64x64 table, so there is no free
        // window to point at. `AllocDynamic` is the trap: the dynamic pool is dispatched
        // by `RunObjects`' `.run_culled`, which culls on WORLD distance from the camera
        // and does not look at RF_COORDMODE at all — a screen-space object still carries
        // a world x_pos/y_pos for that test, so the readout would be culled everywhere in
        // the act except near the origin. System slots go through `.run_always` (and
        // through RunObjects_Frozen's fixed sweep, so the readout survives a frozen frame
        // too), which is exactly the contract a screen-space element needs.
        // `Touch_TestTargets` sweeps these slots but front-guards on collision_resp,
        // which is 0 on a slot we build ourselves, so they are inert to collision.
    .ensure_glyph:
        tst.w   (a0)                            // Sst.code_addr
        bne     .glyph_done                     // already built — leave it alone
        move.w  #TestStatic_Main - ObjCodeBase, Sst.code_addr(a0)
        move.l  #Map_TestObj, Sst.mappings(a0)
        move.b  #DEBUG_READOUT_FRAME, Sst.mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // mappings + mapping_frame written ->
                                                // re-cache frame_off/piece count (the
                                                // Sst.frame_off contract)
        move.w  d3, Sst.art_tile(a0)
        move.b  #DEBUG_READOUT_FLAGS, Sst.render_flags(a0)
        move.l  d1, Sst.x_pos(a0)
        move.l  d4, Sst.y_pos(a0)
    .glyph_done:
        rts

        // -----------------------------------------------
        // .digit_font — ten 8x8 4bpp tiles, '0' to '9', 32 bytes each.
        // -----------------------------------------------
        // ALSO MOVED HERE from Debug_SceneReadout_Show, and this readout's section digit
        // is now its only reader. A 5x7 glyph in an 8x8 cell: pixel columns 1-5, rows
        // 0-6, so consecutive cells leave a 3 px gap and the digits do not touch. Every
        // set pixel is colour index $C, which on palette line 1 is the same bright yellow
        // PlayerMarkerTile uses ($00EE) — one colour, so the glyphs stay legible over
        // whatever the act's line 1 happens to be doing elsewhere.
        //
        // ONE LONG PER PIXEL ROW, one hex nibble per pixel, left to right: the source IS
        // the picture. That is why this is a hand table and not a comptime expansion of a
        // packed 1bpp form — a bitmap you can read is worth more here than a bitmap you
        // have to decode, and there is nothing to derive it FROM (no font asset exists in
        // this tree outside the MD Debugger's own 1bpp blob, which is reachable only at a
        // blob offset).
        //
        // IT LIVES INSIDE THE `if DEBUG == 1`, exactly as `.verdict_font` above does,
        // because a module-scope `data` item cannot be shape-gated in `.emp` (§1.7) and
        // 320 release bytes for a debug readout is precisely what this module must not
        // spend.
        //
        // IT IS NOT MERGED WITH Debug_TierTags_Update's 26-letter `.alphabet`, and that
        // was a deliberate call rather than an oversight: merging would let a lab entry's
        // four-letter name carry a digit (`PLN7`), which is worth something, but it would
        // also renumber nothing and cost nothing — the two sheets are DMA'd from
        // different labels by different painters and neither indexes past its own end.
        // The reason to leave them apart is that `.alphabet`'s letter indices are a dense
        // A..Z run that tools/test_tier_tag_tables.py checks against the `LTR_*`
        // constants in alphabetical order; appending ten digits to it makes that check
        // stop being a statement about the alphabet. Preset rows 35 and 36 are named
        // `BARE` and `GRND` instead of `PLN7`/`PLN8` for exactly this reason.
    .digit_font:
        dc.l    $00CCC000, $0C000C00, $0C000C00, $0C000C00      // 0
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $000C0000, $00CC0000, $000C0000, $000C0000      // 1
        dc.l    $000C0000, $000C0000, $00CCC000, $00000000
        dc.l    $00CCC000, $0C000C00, $00000C00, $0000C000      // 2
        dc.l    $000C0000, $00C00000, $0CCCCC00, $00000000
        dc.l    $00CCC000, $0C000C00, $00000C00, $000CC000      // 3
        dc.l    $00000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0000C000, $000CC000, $00C0C000, $0C00C000      // 4
        dc.l    $0CCCCC00, $0000C000, $0000C000, $00000000
        dc.l    $0CCCCC00, $0C000000, $0CCCC000, $00000C00      // 5
        dc.l    $00000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $000CC000, $00C00000, $0C000000, $0CCCC000      // 6
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0CCCCC00, $00000C00, $0000C000, $000C0000      // 7
        dc.l    $00C00000, $00C00000, $00C00000, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000C00, $00CCC000      // 8
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000C00, $00CCCC00      // 9
        dc.l    $00000C00, $0000C000, $00CC0000, $00000000
    }
}

// -----------------------------------------------
// Debug_PresetReadout_Blank — WIPE the two preset cells, because the cursor has walked
// off the preset rows and there is nothing for them to be about.
//
// Called by Debug_LabCycleHotkey's SCENE and RASTER arms, once per press. The preset
// readout above is called by the PRESET arm. Between them, the two cells are repainted
// on EVERY step of the one list, so what they show is always about the row the cursor is
// standing on and never about a row it has left.
//
// ---- WHY THIS EXISTS AT ALL, WHICH IS NOT OBVIOUS UNTIL IT BITES ----
// Under the retired three-chord lab the preset cells could only ever be stale in one
// direction — a section crossing re-installed a preset without touching them — and that
// was documented and lived with. The ONE list makes staleness routine instead of rare: a
// reviewer who steps from `WATR` (section 0's patched water) to `HAZE` (a scene) would
// otherwise still be looking at a "0" and a diamond, and the diamond means "bound and on
// screen" about a preset he just walked away from. A readout that is confidently wrong
// is worse than no readout, and this is the whole defect the parcel it landed in exists
// to remove.
//
// ---- IT DOES NOT BUILD THE OBJECTS, DELIBERATELY ----
// If the two glyph objects have never been built, their cells are not drawn by anything,
// so there is nothing on screen to wipe and building them here would ADD two SAT entries
// for the sole purpose of drawing two transparent tiles. The VRAM write is unconditional
// because it is cheaper than the test and harmless either way: an unread tile that holds
// zeros is an unread tile.
//
// ---- A DROPPED GLYPH IS ACCEPTED, unlike a dropped LETTER of a name ----
// `@discards(dropped)`, the same call the readout above makes and for the same reason: a
// full DMA queue costs one press's worth of a stale cell, and blocking a review hotkey on
// queue pressure would be worse. A four-letter NAME cannot accept that (one stale cell of
// a word is a word that was never true), which is why Debug_TierTags_Update consumes its
// carry instead — see its header.
//
// DEBUG-shape only: the body and the rts sit inside `if DEBUG == 1 {}`, so the whole proc
// emits ZERO bytes in the plain shape, and it is parked inside this module's
// zero-release-byte run.
//
// In:  none
// Out: both preset cells queued to the blank glyph
// Clobbers: d0-d4, a0-a2 — QueueDMA_Critical's declared set.
// -----------------------------------------------
proc Debug_PresetReadout_Blank () clobbers(d0-d4/a0-a2) {
    if DEBUG == 1 {
        lea     Debug_PresetReadout_Show.verdict_font(pc), a0
        lea     PRESET_VERDICT_BLANK * 32(a0), a1   // the blank row of that sheet
        move.l  a1, d1                          // d1 = DMA source; a1 does not survive
        move.w  #vram_bytes(VRAM_DEBUG_PRESET_READOUT), d2
        moveq   #32, d3                         // one 8x8 4bpp tile
        jbsr    QueueDMA_Critical @discards(dropped)
        lea     Debug_PresetReadout_Show.verdict_font(pc), a0
        lea     PRESET_VERDICT_BLANK * 32(a0), a1
        move.l  a1, d1
        move.w  #vram_bytes(VRAM_DEBUG_PRESET_READOUT + 1), d2
        moveq   #32, d3
        jbra    QueueDMA_Critical @discards(dropped)    // tail call (§2.8)
    }
}
// -----------------------------------------------
// Debug_WaterlineStamp_Show — PUT THE WATERLINE STRIPS ON SCREEN. EFFECTS-W1 item 9d.
//
// ---- THE GAP THIS CLOSES, STATED AS IT WAS FOUND ----
// The row remap's ART half has shipped since 9d landed and has been proven correct in
// VRAM: tools/waterline_art_witness.py reads the 256 bytes at VRAM_WATERLINE_STRIPS and
// compares them, byte for byte, against a gather spelled independently in Python from the
// ladder row the engine published that frame — POSITIVE 12/12, CONTROL 12/12, GUARD
// 11 consistent. And that witness's own last paragraph says what it cannot say: "WHAT IT
// STILL DOES NOT SHOW: a picture. These 8 tiles are in VRAM and correct, and NO PLANE
// CELL POINTS AT THEM." The OJZ background has no water surface to promote (item-9 design
// section 6.2), and the effect's design forbids the engine writing a nametable cell for
// it in either half (engine/level/bg_anim.emp's banner states that as a PROHIBITION). So
// the art was resident, correct, and invisible. This object is the only thing in the tree
// that points at those tiles.
//
// ---- WHY A SPRITE AND NOT A NAMETABLE STAMP ----
// Three reasons, in the order they rule:
//   1. A nametable stamp would violate the prohibition above in spirit even from a debug
//      module — the whole point of the design note is that nobody should learn the effect
//      by reading a cell write. A sprite makes the tiles visible without ever teaching
//      that the effect writes a plane.
//   2. Plane A is the streaming tile cache and Plane B is the background; both are
//      re-written under the camera by the section streamer, so a one-shot cell stamp
//      would be scrubbed as soon as the reviewer moved — the exact motion the effect
//      needs to be seen. The window plane's nametable base ($F000) is inside Plane B's
//      own 64x64 table, so there is no free window to point at either. That argument is
//      Debug_PresetReadout_Show's `.ensure_glyph` header, and it holds here unchanged.
//   3. IT COSTS NO VRAM. The tiles are already resident and already refreshed by
//      Waterline_Art_Update's DMA; this object only names them. The VRAM map had ONE
//      free tile after the chord parcel, and this parcel spends ZERO.
//
// ---- ONE PIECE, AND THE VDP'S TILE ORDER IS WHY IT IS EXACTLY RIGHT ----
// A multi-cell VDP sprite piece reads consecutive tiles from its base COLUMN-MAJOR: down
// column 0, then down column 1, and so on. engine/level/bg_anim.emp's gather lands the
// four tile runs in VRAM in the order (strip0 col0, strip0 col1, strip1 col0, strip1
// col1), each column a contiguous H/8 tiles. Those are the same order. So ONE piece,
// WL_STAMP_CELLS_W x WL_STAMP_CELLS_H, based at the run's first tile, draws:
//
//      +----------------+----------------+
//      | ABOVE the      | BELOW the      |     32 x 16 px at H = 16
//      | surface        | surface        |
//      +----------------+----------------+
//
// with no reordering, no second object and no second SAT entry. That is not a coincidence
// worth trusting silently, which is why the geometry below is DERIVED from WATERLINE_H
// and WATERLINE_TILES rather than written as 4 and 2, and why the derivation fails the
// build the moment H stops fitting one piece.
//
// ---- WHAT IT DOES NOT DO ----
// It does not gather, does not DMA, and does not read Waterline_Art_Row. It builds one
// object and returns. Everything the picture DOES is the engine's own per-frame work
// (Waterline_Art_Update), which is the point: if the stamp shows a still picture while
// the reviewer walks, that is the effect being still, not the readout being late.
//
// ---- WHO CALLS IT, AND HOW IT STOPS BEING SHOWN ----
// ONE caller: Debug_TierTags_Update's per-frame stamp arm, which builds when BOTH the lab
// cursor is on a WLINE row AND `Waterline_Art_Row` is non-zero, and clears the slot
// otherwise. The existence of the object is recomputed from those two subjects every
// frame; there is no latch and no build-on-press. That arm's header carries the full
// argument, including why building from the hotkey CANNOT work (the hotkey runs before
// Parallax_Update, so the honesty test would read the previous scene's cell and retire the
// object on the frame the press built it).
//
// This proc is therefore IDEMPOTENT and called once a frame while the stamp is up: the
// `code_addr == 0` test at the top is what makes the repeat cost a load and a branch.
//
// DEBUG-shape only: the body, the `rts` and the mapping record all sit inside
// `if DEBUG == 1 {}`, so the whole proc emits ZERO bytes in the plain shape. Parked in
// this module's zero-release-byte run; a module-scope `data` item cannot be shape-gated
// in `.emp` (§1.7), which is why the frame record is written by hand inside the block
// exactly as `.tag_mappings` below is.
//
// In:  none
// Out: DEBUG_WLINE_SST holds a live screen-space object drawing the waterline run
// Clobbers: d0-d2, a0-a1 — d2/a1 is RefreshSpritePieceCount's declared set.
// -----------------------------------------------
// THE GEOMETRY, DERIVED. Nothing here is a 4, a 2 or an 8 typed from the picture above.
// A tile column is 8 px tall, so the strip is WATERLINE_H/8 cells tall; the run holds
// WATERLINE_TILES tiles in all, so it is that many cells wide. At H = 16 that is 4 x 2.
const WL_STAMP_CELLS_H = WATERLINE_H / 8
const WL_STAMP_CELLS_W = WATERLINE_TILES / WL_STAMP_CELLS_H
ensure(WL_STAMP_CELLS_W * WL_STAMP_CELLS_H == WATERLINE_TILES,
       "the waterline run holds {WATERLINE_TILES} tiles, which is not {WL_STAMP_CELLS_W} x {WL_STAMP_CELLS_H} — the stamp would draw a rectangle that is not the picture the gather wrote, and the cells past the end would be whatever VRAM follows the run")
ensure(WL_STAMP_CELLS_W >= 1 && WL_STAMP_CELLS_W <= 4 && WL_STAMP_CELLS_H >= 1 && WL_STAMP_CELLS_H <= 4,
       "the waterline stamp is {WL_STAMP_CELLS_W} x {WL_STAMP_CELLS_H} cells and a VDP sprite piece is at most 4 x 4. At WATERLINE_H = {WATERLINE_H} the strips no longer fit ONE piece, so the stamp needs a second piece (a second `MapPiece` in `.wl_frame`, linked) or a second object and a second System slot. It is NOT enough to widen the size nibble — the packing only has two bits per axis")
// The VDP size byte: (w-1) in bits 3:2, (h-1) in bits 1:0 — the packing
// engine/objects/mapping_dsl.emp pins with its own non-square `ensure`. $0D at 4 x 2.
const WL_STAMP_SIZE  = ((WL_STAMP_CELLS_W - 1) << 2) | (WL_STAMP_CELLS_H - 1)
const WL_STAMP_W_PX  = WL_STAMP_CELLS_W * 8
const WL_STAMP_H_PX  = WL_STAMP_CELLS_H * 8
// The run's first TILE. VRAM_WATERLINE_STRIPS is a BYTE address (engine-owned; the region
// in games/sonic4/vram.toml carries `authority = "engine-bytebase:..."` and therefore
// generates no VramTile constant), and `vram_art` takes a tile index — so the conversion
// happens once, here, with the round-trip checked rather than assumed.
const VRAM_WLINE_STAMP: VramTile = VRAM_WATERLINE_STRIPS / 32
ensure(VRAM_WLINE_STAMP * 32 == VRAM_WATERLINE_STRIPS,
       "VRAM_WATERLINE_STRIPS ({VRAM_WATERLINE_STRIPS}) is not a whole tile boundary, so the stamp's art word cannot name its first tile. A sprite base is a TILE index; there is no sub-tile form")
// Top-right, clear of the four readout rows down the left edge (x 12, y 12..68). Screen
// coordinates: the renderer's `.screen_pos` arm adds the +128 SAT offset to x_pos and
// nothing else (engine/objects/sprites.emp), and RF_COORDMODE objects skip the cull
// entirely, so these are literal screen pixels.
const DEBUG_WLINE_X  = 264
const DEBUG_WLINE_Y  = 16
// Palette line 1, the line every other element of this lab draws through and the one
// Debug_PresetReadout_Show's header calls "known to stay legible over this act". THE
// COLOURS ARE NOT WATER COLOURS and are not meant to be: the strip art is authored as
// colour indices 1..7 (above) and 8..14 (below) — see `waterline_px` in
// engine/level/parallax_dsl.emp — so what line 1 renders is a fourteen-step ramp of
// whatever that line holds. The stamp's subject is the SHAPE the gather produced and how
// it moves, not the hue.
const DEBUG_WLINE_PAL = 1
const DEBUG_WLINE_FRAME = 0     // the only frame in `.wl_mappings`
proc Debug_WaterlineStamp_Show () clobbers(d0-d2/a0-a1) {
    if DEBUG == 1 {
        // `code_addr == 0` is the "not built yet" test, the same one `.ensure_glyph` and
        // `.ensure_tag` use: boot clears all of Work RAM (engine/system/boot.emp
        // `.clear_ram`), and the only other writer of this slot is the pair of
        // retirements in the header, both of which clear that word.
        movea.l #DEBUG_WLINE_SST, a0
        tst.w   (a0)                            // Sst.code_addr
        bne     .built                          // already standing — leave it alone
        move.w  #TestStatic_Main - ObjCodeBase, Sst.code_addr(a0)
        lea     .wl_mappings(pc), a1            // `lea` + store, not `move.l #Label`
        move.l  a1, Sst.mappings(a0)
        move.b  #DEBUG_WLINE_FRAME, Sst.mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // mappings + mapping_frame written ->
                                                // re-cache frame_off/piece count (the
                                                // Sst.frame_off contract)
        move.w  #vram_art(VRAM_WLINE_STAMP, DEBUG_WLINE_PAL, 1), Sst.art_tile(a0)
        move.b  #DEBUG_READOUT_FLAGS, Sst.render_flags(a0)
        move.l  #DEBUG_WLINE_X << 16, Sst.x_pos(a0)
        move.l  #DEBUG_WLINE_Y << 16, Sst.y_pos(a0)
    .built:
        rts

        // -----------------------------------------------
        // .wl_mappings — the one frame this object draws, written by hand.
        // -----------------------------------------------
        // Same form and the same reason as `.tag_mappings` below: a frame INDEX (word
        // offsets from this label), then the frame — the 4-byte signed bounding box (far
        // edges), the piece count word, then that many 8-byte VDP pieces (Y offset,
        // size|link, tile attrs, X offset). `centered()` cannot express it (it forces a
        // square bbox and a centred offset; this frame's origin is its top-left corner)
        // and a module-scope `data` item cannot be shape-gated, so it is spelled here.
        //
        // ALIGNMENT: the label follows an `rts` and every 68000 instruction is an even
        // number of bytes, so `.wl_mappings` is word-aligned by construction; the index
        // is one word, so `.wl_frame` is even too.
    .wl_mappings:
        dc.w    .wl_frame - .wl_mappings        // frame 0 — DEBUG_WLINE_FRAME
    .wl_frame:
        dc.b    0, WL_STAMP_W_PX, 0, WL_STAMP_H_PX      // bbox x_min/x_max/y_min/y_max
        dc.w    1                               // one piece
        dc.w    0                               // piece y_off
        dc.b    WL_STAMP_SIZE, 0                // size (W x H cells), link
        dc.w    0                               // tile offset from art_tile
        dc.w    0                               // piece x_off
    }
}
// -----------------------------------------------
// Debug_TierTags_Update — THE EFFECTS LAB'S NAME TAGS. Spell out, in letters, WHERE
// THE LIST CURSOR IS and what the RASTER and BG-ANIMATION channels are actually
// running, so the picture on screen names its own cause instead of having to be
// inferred from a press count.
//
// ---- THE ASK, AND THE INVESTIGATION THAT PAID FOR IT ----
// The owner, in his words: "can we get it to write out what it's supposed to be in
// oracle like start + left/right does? This way I can relay info back to the agent
// better." That is not a cosmetic request. On 2026-09-04 he reported a plane-swap band
// missing and a full investigation followed; the installed raster program was a test
// gradient and the swap had simply never been selected. A tag reading `SWAP` or not
// reading it would have closed that in one glance. Everything below is sized against
// that one sentence: the tag must NAME the thing, and it must not be able to lie.
//
// ---- WHAT IT SAYS AND WHERE ----
// Four rows down the left edge. THREE of the four are this proc's, and that is new
// (2026-09-05): the entry name tag joined when the lab's three selection chords
// collapsed into one list and the two-digit cursor readout that used to own the top row
// retired.
//
//   y 12   the LIST CURSOR's entry name, four letters  <- this proc
//   y 32   the PRESET section digit + verdict glyph    (Debug_PresetReadout_Show /
//                                                       Debug_PresetReadout_Blank)
//   y 44   the RASTER program's name, four letters     <- this proc
//   y 60   the BG-ANIMATION table's name, three letters<- this proc
//
//   ENTRY     the four letters of `.lab_index[Debug_Lab_Index]`'s own name field —
//             DFLT / UWTR / ... / BAND / SWAP / ... / WATR / SPLT / ... — one word per
//             row of the one list, and the ONLY tag here whose subject is a CURSOR
//             rather than an engine cell. See the paragraphs below on why that
//             distinction is stated on screen rather than glossed.
//
//   RASTER    BAND  OJZ_BandDemo, the hand-authored control (cycle row 0)
//             SWAP  OJZ_BaseSwap, the plane-base swap       (cycle row 1)
//             RMPW  EditorRaster_OJZ_Act1_aurora_ramp_witness (row 2)
//             PROB  EditorRaster_OJZ_Act1_authored_probe      (row 3)
//             SHIM  EditorRaster_OJZ_Act1_ojz_sec3_shimmer    (row 4)
//             RAMP  EditorRaster_OJZ_Act1_ramp_probe          (row 5)
//             NONE  nothing installed (Raster_Program == 0)
//             PTCH  a PATCHED program is live — its world anchors are being tracked,
//                   so the live pointer is a working buffer and not a ROM template
//             PSET  a static program that is NOT a row of the cycle table: in this
//                   tree that means it arrived with an EffectsPreset, from the preset
//                   chord or from a section crossing
//
//   BG-ANIM   ACT   the act's own band table (this act authors it `default_off`)
//             CMX   the Camera_X view          (view cycle row 1)
//             CMY   the Camera_Y view          (row 2)
//             VRT   the vertical-axis probe band (row 3)
//             VCT   row 3's horizontal-axis control (row 4)
//             OTH   a table pointer that is not a row of the view cycle
//
// ---- WHY A NAME AND NOT A NUMBER, AND WHY THAT IS AFFORDABLE ----
// Debug_SceneReadout_Show's header rules names out for its own tier, and the half of
// that argument about the REGISTRY is still correct: `SCENES[]` carries no strings and
// nothing comptime can reach the `pub const` identifiers, so a scene name would need a
// hand-written twenty-row table. The half about VRAM does NOT survive contact with this
// tier and is corrected at that header: "26 letters plus 10 digits is 36 [tiles]"
// counts the ROM SHEET, not the resident cells, which is the very distinction that
// header's own next paragraph draws ("WHY IT COSTS TWO VRAM TILES AND NOT TEN"). Only
// the SELECTED glyphs are ever resident. A four-letter name costs FOUR tiles, the
// alphabet stays in ROM, and that is why this exists.
//
// The tiers here also have what the scene tier lacks: a small hand-written table that
// already enumerates every row (`.raster_table`, `.view_table`), so the name list is a
// sibling column of a list that exists, not a new registry.
//
// ---- ONE SYSTEM SLOT PER TAG, NOT ONE PER LETTER ----
// The System pool is eight slots and the two existing readouts claim four of them by
// address. Four letters as four objects would spend the rest on one tag. So each tag is
// ONE object drawing ONE VDP sprite piece four (or three) cells WIDE — `.tag_mappings`
// below, the frame records this file writes by hand. Four is the VDP's maximum piece
// width, and that is what fixes the raster tag at four characters; it is a hardware
// limit, not a taste call, and a fifth letter would cost a second object and a second
// slot. Everything else about the two objects is Debug_SceneReadout_Show's design and
// its header is the reference: System slots rather than the dynamic pool (RunObjects
// culls the dynamic pool on WORLD distance and would cull a screen-space object into
// invisibility), screen coordinates on the front band, `TestStatic_Main` as the code,
// and the DMA queue rather than a direct VDP write because the display is on here.
//
// The two slots are the pair BELOW the preset readout's, still counted from the top of
// the pool, still claimed by address because the System pool has no allocator.
//
// ---- THE ENTRY TAG IS THE ONE EXCEPTION, AND IT IS AN HONEST ONE ----
// Everything in the section below is about the two TIER tags and stands unchanged: their
// subjects are `Raster_Program` and `BgAnim_Table_Ptr`, the engine's own cells, because a
// tag driven off a cursor goes wrong the moment a section crossing re-installs a preset.
//
// The ENTRY tag's subject is `Debug_Lab_Index`, a cursor, and it could not be anything
// else: its question is "where in the list am I", and no engine cell knows that. So the
// two claims are deliberately different and the display keeps them apart BY ROW. The top
// row says what you last SELECTED. The two bottom rows say what is INSTALLED. After a
// section crossing they will disagree — the entry tag still reads `SWAP` while the raster
// tag has moved to whatever that section binds — and THAT DISAGREEMENT IS THE ANSWER, not
// a bug: it is the readout telling you the crossing took your override away. A single
// merged tag could not express it, which is why the tier tags were not simply retired
// when the entry tag arrived.
//
// ---- WHY IT IS DRIVEN BY THE ENGINE'S CELLS AND NOT BY THE CURSORS ----
// This is the whole reason the proc is a per-frame poller and not a call at the foot of
// each hotkey, and it is the difference between a tool and a liability.
//
// `Debug_Raster_Index` is documented in games/sonic4/config/ram.emp as "a CURSOR, NOT A
// MIRROR of the live raster channel": a section crossing re-installs that section's own
// program through Effects_InstallPreset and never touches the byte, and START+DOWN
// leaves it alone on purpose. A tag painted from it would therefore be WRONG every time
// the player walked across a boundary — reproducing, with more confidence and a nicer
// font, exactly the defect this parcel exists to remove.
//
// So the subject is `Raster_Program` — the engine's own installed-program cell
// (engine/ram.emp), written by Raster_VBlank from whatever Raster_Install staged and
// cleared when a program is torn down. Every installer in the tree passes through it:
// the raster chord, the preset chord, and a section crossing. `BgAnim_Table_Ptr` is the
// same kind of cell for the other tier. The tag compares the live cell against a mirror
// of what it currently spells and repaints on any difference, so it can be at most one
// frame behind the machine and cannot disagree with it at all.
//
// TWO CONSEQUENCES WORTH STATING, because both are visible:
//   * A chord press paints on the FOLLOWING frame, not the pressing one. Raster_Install
//     only STAGES (Raster_Pending); Raster_VBlank is what installs. Painting at the
//     press would publish what was REQUESTED — and the request loses to a same-frame
//     boundary crossing, which is documented behaviour. One frame late and true beats
//     instant and hopeful.
//   * PTCH and PSET are honest about the limit of the mechanism rather than papering
//     over it. A patched program's live pointer is a working BUFFER (Raster_Buf_A/B),
//     so it can never match a ROM row; `Raster_Patch_Tab` is what distinguishes it, and
//     it is read for that and nothing else.
//
// ---- WHY IT ARMS ON A CHORD AND DOES NOT SIMPLY RUN ----
// The tags are sprites. Building them unconditionally would add two SAT entries to
// every DEBUG frame from boot, which is the same cost Debug_SceneReadout_Show's
// "built on first press, not at level init" rule exists to refuse — a readout that
// perturbs the sprite table is a readout that can change the thing it reports. So
// `Debug_Tags_Armed` (games/sonic4/config/ram.emp) latches the first frame the reviewer
// HOLDS START or C, which is the moment he reaches for the effects lab at all. Until
// then this proc reads two bytes and returns, and the sprite table is byte-for-byte
// what it was before this parcel. Replays never arm it twice over: Input_Source gates
// them out first, exactly as it gates out all five hotkeys.
//
// Arming on the HELD modifier rather than inside the hotkeys is deliberate — it keeps
// the whole feature in one proc, and it makes the tags appear together, before the
// press that changes anything, so the reviewer sees the state he is about to leave.
//
// ---- A DROPPED DMA RETRIES INSTEAD OF LYING ----
// One Critical queue entry per glyph cell. The two existing readouts spend theirs with
// `@discards(dropped)` and accept "one stale digit"; a four-letter word cannot accept
// that, because one stale cell is not a stale name, it is a name that was never true
// (`BANP`). So the carry is CONSUMED here: the painter bails on the first drop and
// leaves the mirror unwritten, the next frame's compare therefore still differs, and
// the whole tag is re-queued. The cost of a full queue is one frame of mixed letters.
//
// ---- WHAT IT DELIBERATELY DOES NOT DO ----
//   * The entry tag does not say whether the entry it names is still INSTALLED. That is
//     what the two tier tags under it are for, and a preset's raster channel shows up
//     there anyway (as its row's name, or PSET, or PTCH) because their subject is the
//     engine cell rather than any cursor.
//   * It says nothing about whether the named program can DRAW where you are standing.
//     That is the preset readout's verdict glyph, and it is a different question with a
//     different answer; duplicating a weaker version of it here would be worse than the
//     silence.
//   * It does not name WHICH preset a PSET came from. The section digit on the row above
//     answers that when the preset chord put it there; after a crossing nothing in the
//     tree records it, and inventing an answer is the failure this whole parcel is
//     about.
//
// DEBUG-shape only: the body, the `rts`, the two local subroutines, the mapping records,
// the two name tables AND the alphabet are all inside `if DEBUG == 1 {}`, so the whole
// proc emits ZERO bytes in the plain shape. Parked as the SEVENTH member of this
// module's zero-release-byte run for the reason Debug_SceneCycleHotkey's header records.
//
// In:  none (reads Input_Source, Ctrl_1_Held, Debug_Tags_Armed, Debug_Lab_Index,
//      Raster_Program, Raster_Patch_Tab, BgAnim_Table_Ptr, Waterline_Art_Row and the
//      three mirror cells)
// Out: the three tag objects exist (once armed) and their VRAM cells are queued to spell
//      the list cursor's entry name and the live raster program's and band table's names;
//      each mirror follows ONLY on a fully-queued repaint of its own tag
// Clobbers: d0-d4, a0-a3 — d0-d4/a1-a2 is QueueDMA_Critical's declared set, d2/a1 also
//      RefreshSpritePieceCount's, a0 is the SST cursor then the name-table end, and a3
//      is the letter cursor (chosen because it is the one address register
//      QueueDMA_Critical does not clobber).
// -----------------------------------------------
// Both tags share the left edge of the two readouts above (Map_TestObj frame 2 is
// `centered(half: 4, ...)`, so their cells start at screen x 12). These two frames put
// x_off/y_off at ZERO instead, so the object position IS the tag's top-left corner —
// every field of the two hand-written frame records below is therefore non-negative,
// which is worth more here than symmetry with the readouts' centring.
const DEBUG_TAG_X          = 12
const DEBUG_LABNAME_TAG_Y  = 12
const DEBUG_RASTER_TAG_Y   = 44
const DEBUG_BGANIM_TAG_Y   = 60
// Frame indices into `.tag_mappings`.
const DEBUG_TAG_FRAME_4    = 0      // one 4x1 piece — the raster tag
const DEBUG_TAG_FRAME_3    = 1      // one 3x1 piece — the BG-animation tag
const RTAG_CELLS           = 4
const BTAG_CELLS           = 3
// The two System slots the tags occupy — the pair below the preset readout's, still
// counted from the TOP of the pool and still claimed by address (the System pool has no
// allocator; see Debug_SceneReadout_Show's header).
// The entry name tag takes NUM_SYSTEM-1 — the slot the retired scene readout's ONES
// digit held. Nothing else moved: the preset cells keep NUM_SYSTEM-3/-4 and the two tier
// tags keep NUM_SYSTEM-5/-6, so FIVE of the eight are claimed and NUM_SYSTEM-2 (the
// retired readout's TENS digit) is now free. That is the whole System-slot consequence
// of the chord consolidation: one slot back, and no surviving object re-addressed.
ensure(NUM_SYSTEM >= 6,
       "effects-lab tags: the lab claims FIVE System slots by address (the entry name tag at the top, the two preset cells, the two tier tags), and the tier tags are counted from NUM_SYSTEM-6, but NUM_SYSTEM is {NUM_SYSTEM}")
equ DEBUG_LABNAME_TAG_SST = extern("System_Slots") + sizeof(Sst) * (NUM_SYSTEM - 1)
equ DEBUG_RASTER_TAG_SST = extern("System_Slots") + sizeof(Sst) * (NUM_SYSTEM - 5)
equ DEBUG_BGANIM_TAG_SST = extern("System_Slots") + sizeof(Sst) * (NUM_SYSTEM - 6)
// The three synthetic raster rows, APPENDED after the cycle table's own rows so a row
// added to `.raster_table` keeps every existing index. tools/test_tier_tag_tables.py
// holds `.rtag_names` to RTAG_ROWS and `.btag_names` to BTAG_ROWS: the index reaches
// the name table as a raw multiply-by-cell-count offset, so one row short would read
// past the table's end and DMA whatever follows it into the tag — a garbage word, on
// the readout whose entire job is to be trusted.
const RTAG_NONE  = RASTER_CYCLE_COUNT           // nothing installed
const RTAG_PTCH  = RASTER_CYCLE_COUNT + 1       // a patched program is live
const RTAG_PSET  = RASTER_CYCLE_COUNT + 2       // a static program from a preset
const RTAG_ROWS  = RASTER_CYCLE_COUNT + 3
const BTAG_OTHER = BGANIM_VIEW_CYCLE_COUNT      // a table outside the view cycle
const BTAG_ROWS  = BGANIM_VIEW_CYCLE_COUNT + 1
// Letter indices into `.alphabet`. Named rather than numbered so the name tables below
// SPELL their words in the source — the whole point of this parcel is a readout you can
// read, and that has to start with the table.
const LTR_A = 0
const LTR_B = 1
const LTR_C = 2
const LTR_D = 3
const LTR_E = 4
const LTR_F = 5
const LTR_G = 6
const LTR_H = 7
const LTR_I = 8
const LTR_J = 9
const LTR_K = 10
const LTR_L = 11
const LTR_M = 12
const LTR_N = 13
const LTR_O = 14
const LTR_P = 15
const LTR_Q = 16
const LTR_R = 17
const LTR_S = 18
const LTR_T = 19
const LTR_U = 20
const LTR_V = 21
const LTR_W = 22
const LTR_X = 23
const LTR_Y = 24
const LTR_Z = 25
const ALPHABET_GLYPHS = 26
proc Debug_TierTags_Update () clobbers(d0-d4/a0-a3) {
    if DEBUG == 1 {
        // Gate 1: live input only. The same gate, for the same reason, as all five
        // hotkeys: a replay drives Input_Source != INPUT_LIVE, and a fixture that built
        // two extra sprites would re-stamp every downstream hash. INPUT_LIVE is 0, so a
        // `tst.b` is the whole test.
        tst.b   Input_Source                    // (Input_Source).w
        bne     .done

        // Gate 2: armed? Until the reviewer has held START or C at least once, this
        // proc costs two byte reads and a branch and the sprite table is untouched —
        // see "WHY IT ARMS ON A CHORD" above.
        tst.b   Debug_Tags_Armed                // (Debug_Tags_Armed).w
        bne     .armed
        move.b  Ctrl_1_Held, d0                 // tick-stable held latch
        andi.b  #BUTTON_START|BUTTON_C, d0
        beq     .done
        move.b  d0, Debug_Tags_Armed            // any nonzero value arms it
        // POISON BOTH MIRRORS ON THE ARMING FRAME, so both tags paint on it whatever
        // the engine cells happen to hold. Without this there is a silent hole with
        // exactly the shape this parcel exists to remove: boot clears Work RAM, so a
        // mirror reads 0 — and 0 is a LEGAL value of both subjects ("no raster program
        // at all"). A reviewer who first reached for the lab while standing in a
        // section that binds no raster program would see the compare match, no tag
        // built, and NOTHING on screen where the answer `NONE` belongs. $FFFFFFFF is
        // safe as the poison because it is neither 0 nor any address in a 4 MB ROM, so
        // it can never be a value either subject legitimately holds.
        moveq   #-1, d0
        move.l  d0, Debug_Raster_Shown          // (Debug_Raster_Shown).w
        move.l  d0, Debug_BgAnim_Shown          // (Debug_BgAnim_Shown).w
        move.b  d0, Debug_Lab_Shown             // (Debug_Lab_Shown).w — $FF, and the
                                                // cursor's range is 0..LAB_CYCLE_COUNT-1,
                                                // so it can never be a legal value either
    .armed:

        // -- THE WATERLINE STAMP. Not a tag — it paints no glyph — but it belongs here
        //    for the reason every tag below does: this is the lab's one per-frame poller,
        //    and the question is the same one. Is what is on screen still true?
        //
        //    IT IS DECLARATIVE, NOT LATCHED, and that is the whole design. Two facts are
        //    read every frame and the object's existence is their AND:
        //      1. the cursor is standing on a WLINE row  (the kind byte of `.lab_index`,
        //         read out of the row `Debug_Lab_Index` names — the same row shape the
        //         name tag reads its letters from);
        //      2. `Waterline_Art_Row` is non-zero — the engine is actually gathering.
        //    Either one false and the slot is cleared. There is no "shown" mirror, no
        //    build-on-press and no teardown at the hotkey: a state that is recomputed
        //    from its two subjects cannot go stale against either of them.
        //
        //    WHY THAT MATTERS RATHER THAN BEING TIDIER. The first shape of this parcel
        //    DID build on the press and retire here, and it could never have worked: this
        //    proc runs BEFORE Parallax_Update in the frame (:1023 vs :1377), so on the
        //    pressing frame `Waterline_Art_Row` still holds the PREVIOUS scene's value,
        //    which is 0 for every scene but this one — the arm would have retired the
        //    object on the frame the press built it, and the chord would have done
        //    nothing at all, silently, with every gate green. The declarative form has no
        //    such ordering to get wrong: at worst the stamp appears ONE FRAME after the
        //    press, exactly as the three tags below do, and for the same reason.
        //
        //    WHAT CONDITION 2 BUYS. When the remap pass marks no band it writes
        //    `Waterline_Art_Row` = 0 (engine/level/parallax.emp) and the eight tiles at
        //    VRAM_WATERLINE_STRIPS FREEZE at their last content. A section crossing does
        //    exactly that — it re-installs the section's own scene over the lab's — and a
        //    stamp left standing would be a still picture confidently about a state the
        //    machine has left. It also covers the transition: a lerping scene swap
        //    publishes no row until it arrives, and the stamp simply waits.
        //
        //    The `clr.w` is unconditional on the false arm rather than guarded by a
        //    `tst.w`: it is idempotent, this module is the slot's only writer, and a
        //    branch to save one word write on a DEBUG frame is not a trade worth making.
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  Debug_Lab_Index, d0             // (Debug_Lab_Index).w
        mul_const.w d0, #LAB_ENTRY_SIZE, d1     // d0 = row byte offset (d1 scratch)
        lea     Debug_LabCycleHotkey.lab_index(pc), a1          // §1.5
        adda.w  d0, a1                          // a1 = the row; (a1) is its KIND
        cmpi.b  #LAB_KIND_WLINE, (a1)
        bne     .wl_retire                      // the cursor is somewhere else
        tst.l   Waterline_Art_Row               // (Waterline_Art_Row).w
        beq     .wl_retire                      // nothing is being gathered to look at
        jbsr    Debug_WaterlineStamp_Show       // idempotent — builds once, then no-ops
        jbra    .lab_tier
    .wl_retire:
        movea.l #DEBUG_WLINE_SST, a0
        clr.w   (a0)                            // Sst.code_addr — RunObjects' `.run_always`
                                                // `beq`s past a zero slot, so this is the
                                                // whole retirement

    .lab_tier:
        // -- the ENTRY NAME tag. Its subject is the LIST CURSOR, which is the one thing
        //    here no engine cell knows; see the header for why that exception is stated
        //    on screen by row rather than glossed. --
        moveq   #0, d0                          // index-register hygiene (2.5b)
        move.b  Debug_Lab_Index, d0             // (Debug_Lab_Index).w
        cmp.b   Debug_Lab_Shown, d0             // (Debug_Lab_Shown).w
        beq     .raster_tier                    // already spelled — nothing to do
        jbsr    .paint_labname

    .raster_tier:
        // -- the RASTER tag. The subject is the ENGINE's installed-program cell, never
        //    the cycle cursor; see the header for why that distinction is the parcel. --
        move.l  Raster_Program, d0              // (Raster_Program).w
        cmp.l   Debug_Raster_Shown, d0
        beq     .bganim                         // already spelled — nothing to do
        jbsr    .paint_raster

    .bganim:
        // -- the BG-ANIMATION tag, same shape against the other tier's engine cell. --
        move.l  BgAnim_Table_Ptr, d0            // (BgAnim_Table_Ptr).w
        cmp.l   Debug_BgAnim_Shown, d0
        beq     .done
        jbsr    .paint_bganim

    .done:
        rts

        // -----------------------------------------------
        // .paint_labname — spell the list cursor's entry name.
        // In:  d0 = the live Debug_Lab_Index value
        // Out: the entry tag spells that row's four-letter name; Debug_Lab_Shown follows
        //      ONLY if every cell was queued
        //
        // NO NAME TABLE OF ITS OWN, and that is the point of `.lab_index`'s row shape:
        // the four letters live IN the row, two bytes past its kind and sub-index, so
        // the name and the entry it names cannot drift apart. The two tier tags below
        // DO have parallel name tables, because their subject is a POINTER they have to
        // scan back to a row first, and because their vocabularies include states that
        // are not rows at all (PTCH, PSET, OTH).
        // -----------------------------------------------
    .paint_labname:
        move.w  d0, -(sp)                       // the row; d0-d4 do not survive the DMA

        movea.l #DEBUG_LABNAME_TAG_SST, a0
        move.l  #DEBUG_TAG_X << 16, d1
        move.l  #DEBUG_LABNAME_TAG_Y << 16, d4
        move.w  #vram_art(VRAM_DEBUG_LAB_NAME, 1, 1), d3        // palette line 1 +
        moveq   #DEBUG_TAG_FRAME_4, d2                          // priority 1, the
        jbsr    .ensure_tag                                     // debug-fly marker's
                                                                // known-legible pairing

        move.w  (sp), d0
        mul_const.w d0, #LAB_ENTRY_SIZE, d1     // d0 = row byte offset (d1 scratch)
        lea     Debug_LabCycleHotkey.lab_index(pc), a3          // 1.5
        adda.w  d0, a3
        addq.l  #LAB_NAME_OFF, a3               // past the kind and sub-index bytes
        lea     LAB_NAME_CELLS(a3), a0          // a0 = one past the last letter
        move.w  #vram_bytes(VRAM_DEBUG_LAB_NAME), d2
        jbsr    .paint_cells
        bcs     .labname_dropped
        move.w  (sp)+, d0
        move.b  d0, Debug_Lab_Shown             // the tag now spells THIS row
        rts
    .labname_dropped:
        addq.l  #2, sp                          // mirror UNWRITTEN on purpose: the next
        rts                                     // frame's compare still differs and the
                                                // whole word is re-queued

        // -----------------------------------------------
        // .paint_raster — resolve Raster_Program to a name and blit it.
        // In:  d0 = the live Raster_Program value (0 = nothing installed)
        // Out: the raster tag spells that program's name; Debug_Raster_Shown follows
        //      ONLY if every cell was queued
        // -----------------------------------------------
    .paint_raster:
        move.l  d0, -(sp)                       // d0-d4 do not survive the DMA below

        // -- (1) the tag object, built once (boot clears Work RAM, so code_addr == 0
        //    is a reliable "not built yet" — Debug_SceneReadout_Show's test). --
        movea.l #DEBUG_RASTER_TAG_SST, a0
        move.l  #DEBUG_TAG_X << 16, d1
        move.l  #DEBUG_RASTER_TAG_Y << 16, d4
        move.w  #vram_art(VRAM_DEBUG_RASTER_TAG, 1, 1), d3      // palette line 1 +
        moveq   #DEBUG_TAG_FRAME_4, d2                          // priority 1: the
        jbsr    .ensure_tag                                     // debug-fly marker's
                                                                // known-legible pairing

        // -- (2) which name. Rows first, so a program that IS a cycle row is named by
        //    its row whatever installed it; the three synthetic rows are the fallbacks
        //    and are ordered NONE (no program at all) > PTCH (a live patch table, so
        //    the pointer is a working buffer and could not have matched) > PSET. --
        move.l  (sp), d0
        moveq   #RTAG_NONE, d1
        tst.l   d0
        beq     .rtag_named
        lea     Debug_LabCycleHotkey.raster_table(pc), a1       // §1.5, the preset
        moveq   #0, d1                                          // readout's spelling
    .rtag_scan:
        cmp.l   (a1)+, d0
        beq     .rtag_named
        addq.w  #1, d1
        cmpi.w  #RASTER_CYCLE_COUNT, d1
        blo     .rtag_scan
        moveq   #RTAG_PSET, d1
        tst.l   Raster_Patch_Tab                // (Raster_Patch_Tab).w
        beq     .rtag_named
        moveq   #RTAG_PTCH, d1
    .rtag_named:

        // -- (3) blit it. RTAG_CELLS is 4, so the row offset is a shift; no multiply. --
        lsl.w   #2, d1                          // name index x RTAG_CELLS
        lea     .rtag_names(pc), a3
        adda.w  d1, a3                          // a3 = this name's first letter
        lea     RTAG_CELLS(a3), a0              // a0 = one past its last
        move.w  #vram_bytes(VRAM_DEBUG_RASTER_TAG), d2
        jbsr    .paint_cells
        bcs     .rtag_dropped
        move.l  (sp)+, Debug_Raster_Shown       // the tag now spells THIS value
        rts
    .rtag_dropped:
        addq.l  #4, sp                          // mirror UNWRITTEN on purpose: the next
        rts                                     // frame's compare still differs and the
                                                // whole tag is re-queued

        // -----------------------------------------------
        // .paint_bganim — resolve BgAnim_Table_Ptr to a name and blit it.
        // In:  d0 = the live BgAnim_Table_Ptr value
        // Out: the BG-animation tag spells that table's name; Debug_BgAnim_Shown
        //      follows ONLY if every cell was queued
        // -----------------------------------------------
    .paint_bganim:
        move.l  d0, -(sp)
        movea.l #DEBUG_BGANIM_TAG_SST, a0
        move.l  #DEBUG_TAG_X << 16, d1
        move.l  #DEBUG_BGANIM_TAG_Y << 16, d4
        move.w  #vram_art(VRAM_DEBUG_BGANIM_TAG, 1, 1), d3
        moveq   #DEBUG_TAG_FRAME_3, d2
        jbsr    .ensure_tag

        move.l  (sp), d0
        lea     Debug_BgAnimViewHotkey.view_table(pc), a1
        moveq   #0, d1
    .btag_scan:
        cmp.l   (a1)+, d0
        beq     .btag_named
        addq.w  #1, d1
        cmpi.w  #BGANIM_VIEW_CYCLE_COUNT, d1
        blo     .btag_scan
        moveq   #BTAG_OTHER, d1
    .btag_named:
        // BTAG_CELLS is 3, so the row offset is x2 + x1 rather than a shift — an add
        // pair, not a `mulu` (CODING_CONVENTIONS §2.1: no casual hardware multiply).
        move.w  d1, d0
        add.w   d1, d1
        add.w   d0, d1                          // name index x BTAG_CELLS
        lea     .btag_names(pc), a3
        adda.w  d1, a3
        lea     BTAG_CELLS(a3), a0
        move.w  #vram_bytes(VRAM_DEBUG_BGANIM_TAG), d2
        jbsr    .paint_cells
        bcs     .btag_dropped
        move.l  (sp)+, Debug_BgAnim_Shown
        rts
    .btag_dropped:
        addq.l  #4, sp
        rts

        // -----------------------------------------------
        // .ensure_tag — build one tag object into its System slot, once.
        // In:  a0 = the System slot's SST, d1 = screen X (16.16), d4 = screen Y
        //      (16.16), d3 = art_tile word, d2 = mapping frame index
        // Out: that slot holds a live display-only screen-space object
        // Clobbers: d2 and a1, both via RefreshSpritePieceCount. a0/d1/d3/d4 survive.
        //
        // It is NOT Debug_SceneReadout_Show.ensure_glyph and could not be: that builder
        // hard-codes `Map_TestObj` frame 2, the existing one-cell frame, and the whole
        // point of these two objects is a WIDER piece. Everything else about it is that
        // builder's, including `code_addr == 0` as the "not built yet" test.
        // -----------------------------------------------
    .ensure_tag:
        tst.w   (a0)                            // Sst.code_addr
        bne     .tag_built                      // already built — leave it alone
        move.w  #TestStatic_Main - ObjCodeBase, Sst.code_addr(a0)
        lea     .tag_mappings(pc), a1           // `lea` + store, not a `move.l #Label`
        move.l  a1, Sst.mappings(a0)            // (bg_anim.emp's BgAnim_Table_Ptr note)
        move.b  d2, Sst.mapping_frame(a0)
        jbsr    RefreshSpritePieceCount         // mappings + mapping_frame written ->
                                                // re-cache frame_off/piece count
        move.w  d3, Sst.art_tile(a0)
        move.b  #DEBUG_READOUT_FLAGS, Sst.render_flags(a0)
        move.l  d1, Sst.x_pos(a0)
        move.l  d4, Sst.y_pos(a0)
    .tag_built:
        rts

        // -----------------------------------------------
        // .paint_cells — queue one glyph per cell of a tag, left to right.
        // In:  a3 = the name's first letter index, a0 = one past its last,
        //      d2 = the VRAM byte address of the leftmost cell
        // Out: carry CLEAR = every cell queued; carry SET = the queue was full and
        //      the caller must NOT advance its mirror
        // Clobbers: d0-d4, a1-a2 (QueueDMA_Critical's set); a3 advances to a0.
        //
        // Cells are queued as separate 32-byte entries because their SOURCES are
        // arbitrary rows of one alphabet and are contiguous only by accident — the same
        // reason the scene readout's two digits are two entries.
        // -----------------------------------------------
    .paint_cells:
        move.w  d2, -(sp)                       // the running VRAM destination; d0-d4
                                                // do not survive the queue call
    .cell:
        moveq   #0, d0                          // index-register hygiene (§2.5b)
        move.b  (a3)+, d0                       // this cell's letter
        lsl.w   #5, d0                          // x 32 bytes per glyph
        lea     .alphabet(pc), a1
        adda.w  d0, a1                          // §7: address-register destination
        move.l  a1, d1                          // d1 = DMA source
        move.w  (sp), d2                        // d2 = DMA destination
        moveq   #32, d3                         // one 8x8 4bpp tile
        jbsr    QueueDMA_Critical
        bcs     .cell_dropped
        addi.w  #32, (sp)                       // the next cell is the next VRAM tile
        cmpa.l  a0, a3
        blo     .cell
        addq.l  #2, sp
        andi.b  #$FE, ccr                       // carry CLEAR: the whole word is queued
        rts
    .cell_dropped:
        addq.l  #2, sp                          // (this addq is what forces the ccr
        ori.b   #$01, ccr                       //  write to come AFTER the pop)
        rts

        // -----------------------------------------------
        // .tag_mappings — the two frame records these objects draw, written by hand.
        // -----------------------------------------------
        // A frame INDEX (word offsets from this label), then the frames: the 4-byte
        // signed bounding box (far edges), the piece count word, then that many 8-byte
        // VDP pieces (Y offset, size|link, tile attrs, X offset) — engine.objects
        // .mapping_dsl's `MapFrame1`/`MapPiece`, spelled out.
        //
        // WHY BY HAND AND NOT THROUGH `centered()` / a new `Map_TestObj` frame: both
        // would emit in the PLAIN shape. A module-scope `data`/`offsets` item cannot be
        // shape-gated in `.emp` (§1.7), and this module's whole run of debug procs is
        // built on emitting zero release bytes; ~32 bytes of mapping for a debug tag is
        // exactly what it must not spend. `centered()` additionally cannot express these
        // frames — it forces a square bbox and a centred offset, and both of these are
        // 1 cell tall with the origin at the top-left corner.
        //
        // The size byte is the VDP packing (w-1) in bits 3:2, (h-1) in bits 1:0, which
        // mapping_dsl.emp pins with its own non-square `ensure`: $0C = 4 wide x 1 tall,
        // $08 = 3 wide x 1 tall. A multi-cell piece reads CONSECUTIVE VRAM tiles from
        // the object's art_tile, which is why both tag regions are declared contiguous
        // and in order in games/sonic4/vram.toml.
        //
        // ALIGNMENT: the label follows an `rts`, and every 68000 instruction is an even
        // number of bytes, so it is word-aligned by construction — the reasoning
        // `.raster_table` and `.scene_table` both record. Each frame record is 14 bytes
        // and the index is 4, so every label below is even as well.
    .tag_mappings:
        dc.w    .tag_frame_4 - .tag_mappings    // frame 0 — the 4-cell tag
        dc.w    .tag_frame_3 - .tag_mappings    // frame 1 — the 3-cell tag
    .tag_frame_4:
        dc.b    0, 32, 0, 8                     // bbox x_min/x_max/y_min/y_max
        dc.w    1                               // one piece
        dc.w    0                               // piece y_off
        dc.b    $0C, 0                          // size (4x1), link
        dc.w    0                               // tile offset from art_tile
        dc.w    0                               // piece x_off
    .tag_frame_3:
        dc.b    0, 24, 0, 8
        dc.w    1
        dc.w    0
        dc.b    $08, 0                          // size (3x1), link
        dc.w    0
        dc.w    0

        // -----------------------------------------------
        // .rtag_names — one four-letter name per raster row, cycle rows first.
        // -----------------------------------------------
        // ROW ORDER IS `.raster_table`'s, and it has to be: the scan above returns the
        // row index and this table is indexed with it raw. The three synthetic rows are
        // APPENDED so adding a cycle row never renumbers an existing name.
        // 36 bytes — even, so `.btag_names` below starts word-aligned with no padding.
        // (`.btag_names` itself is odd and carries its own `.btag_pad` byte.)
    .rtag_names:
        dc.b    LTR_B, LTR_A, LTR_N, LTR_D      // 0 — OJZ_BandDemo, the control
        dc.b    LTR_S, LTR_W, LTR_A, LTR_P      // 1 — OJZ_BaseSwap, the plane-base swap
        dc.b    LTR_R, LTR_M, LTR_P, LTR_W      // 2 — aurora_ramp_witness (RaMP Witness)
        dc.b    LTR_P, LTR_R, LTR_O, LTR_B      // 3 — authored_probe
        dc.b    LTR_S, LTR_H, LTR_I, LTR_M      // 4 — ojz_sec3_shimmer
        dc.b    LTR_R, LTR_A, LTR_M, LTR_P      // 5 — ramp_probe
        dc.b    LTR_N, LTR_O, LTR_N, LTR_E      // 6 — RTAG_NONE: no program installed
        dc.b    LTR_P, LTR_T, LTR_C, LTR_H      // 7 — RTAG_PTCH: a patched program
        dc.b    LTR_P, LTR_S, LTR_E, LTR_T      // 8 — RTAG_PSET: came with a preset

        // -----------------------------------------------
        // .btag_names — one three-letter name per BG-animation view row.
        // -----------------------------------------------
        // ROW ORDER IS `.view_table`'s, for `.rtag_names`' reason. 21 bytes — ODD, so it
        // is followed by `.btag_pad`; see the note at the foot of the table.
    .btag_names:
        dc.b    LTR_A, LTR_C, LTR_T             // 0 — BgAnim_Table, the act's own
        dc.b    LTR_C, LTR_M, LTR_X             // 1 — BgAnim_View_H, the Camera_X view
        dc.b    LTR_C, LTR_M, LTR_Y             // 2 — BgAnim_View_V, the Camera_Y view
        dc.b    LTR_T, LTR_M, LTR_R             // 3 — BgAnim_View_T, the Logic_Tick view
        dc.b    LTR_V, LTR_R, LTR_T             // 4 — BgAnim_View_Vert, the vertical band
        dc.b    LTR_V, LTR_C, LTR_T             // 5 — BgAnim_View_VertCtl, its control
        dc.b    LTR_O, LTR_T, LTR_H             // 6 — BTAG_OTHER: outside the cycle

        // -----------------------------------------------
        // .btag_pad — ONE BYTE, AND IT IS LOAD-BEARING.
        // -----------------------------------------------
        // Seven three-letter rows are 21 bytes, ODD. `.alphabet` below is `dc.l` art
        // that `.paint_cells` DMAs from a `lsl.w #5` offset off its own label, and a
        // VDP DMA source is a WORD address — an odd `.alphabet` base does not fail
        // loudly, it paints shifted garbage on the readout whose whole job is to be
        // trusted. This file's own "36 bytes — even" / "18 bytes — even" notes were the
        // previous, MANUAL form of the same guarantee, and the row added on 2026-09-04
        // is what broke the parity they were quietly relying on.
        //
        // A BYTE AND NOT `align 2`, measured rather than assumed: `align` is a
        // module-scope directive and is not a mnemonic inside a proc body — sigil
        // rejects it with "`align` is not a recognized 68000 mnemonic". (It is spelled
        // at module scope in games/sonic4/debug/game_debug.emp:193 and
        // engine/system/boot_data.emp:214; neither of those is inside a proc.)
        //
        // IT HAS ITS OWN LABEL so it is not inside `.btag_names`: that table is parsed
        // by tools/test_tier_tag_tables.py as "one LTR_ triple per row", and a bare
        // `dc.b 0` in the middle of it would be read as a fourth letter. The label ends
        // the block for that parser and names the byte for a human at the same time.
        // The gate on the parity itself is that file's
        // test_name_tables_leave_the_alphabet_word_aligned.
    .btag_pad:
        dc.b    0

        // -----------------------------------------------
        // .alphabet — twenty-six 8x8 4bpp tiles, 'A' to 'Z', 32 bytes each.
        // -----------------------------------------------
        // Same form, same geometry and same colour as Debug_SceneReadout_Show's
        // `.digit_font`, so the two readouts and the two tags read as one display: a
        // 5x7 glyph in an 8x8 cell (pixel columns 1-5, rows 0-6), ONE LONG PER PIXEL
        // ROW and one hex nibble per pixel, left to right — the source IS the picture.
        // Every set pixel is colour index $C, which on palette line 1 is the bright
        // yellow PlayerMarkerTile uses ($00EE).
        //
        // IT LIVES INSIDE THE `if DEBUG == 1`, exactly as `.digit_font` and
        // `.verdict_font` do, because a module-scope `data` item cannot be shape-gated
        // in `.emp` (§1.7) and 832 release bytes for a debug alphabet is precisely what
        // this module must not spend.
        //
        // ALL TWENTY-SIX ARE HERE even though eighteen would cover today's fourteen
        // names: the letter index is a raw `lsl.w #5` offset into this sheet, so a sparse
        // sheet would put a hole exactly where a future name lands, and the whole cost
        // of the other eight is 256 DEBUG-only bytes in a section that already carries
        // two kilobytes of probe art. tools/test_tier_tag_tables.py counts the rows.
    .alphabet:
        dc.l    $00CCC000, $0C000C00, $0C000C00, $0CCCCC00      // A (index 0)
        dc.l    $0C000C00, $0C000C00, $0C000C00, $00000000
        dc.l    $0CCCC000, $0C000C00, $0C000C00, $0CCCC000      // B (index 1)
        dc.l    $0C000C00, $0C000C00, $0CCCC000, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000000, $0C000000      // C (index 2)
        dc.l    $0C000000, $0C000C00, $00CCC000, $00000000
        dc.l    $0CCCC000, $0C000C00, $0C000C00, $0C000C00      // D (index 3)
        dc.l    $0C000C00, $0C000C00, $0CCCC000, $00000000
        dc.l    $0CCCCC00, $0C000000, $0C000000, $0CCCC000      // E (index 4)
        dc.l    $0C000000, $0C000000, $0CCCCC00, $00000000
        dc.l    $0CCCCC00, $0C000000, $0C000000, $0CCCC000      // F (index 5)
        dc.l    $0C000000, $0C000000, $0C000000, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000000, $0C0CCC00      // G (index 6)
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0C000C00, $0C000C00, $0C000C00, $0CCCCC00      // H (index 7)
        dc.l    $0C000C00, $0C000C00, $0C000C00, $00000000
        dc.l    $0CCCCC00, $000C0000, $000C0000, $000C0000      // I (index 8)
        dc.l    $000C0000, $000C0000, $0CCCCC00, $00000000
        dc.l    $000CCC00, $00000C00, $00000C00, $00000C00      // J (index 9)
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0C000C00, $0C00C000, $0C0C0000, $0CC00000      // K (index 10)
        dc.l    $0C0C0000, $0C00C000, $0C000C00, $00000000
        dc.l    $0C000000, $0C000000, $0C000000, $0C000000      // L (index 11)
        dc.l    $0C000000, $0C000000, $0CCCCC00, $00000000
        dc.l    $0C000C00, $0CC0CC00, $0C0C0C00, $0C000C00      // M (index 12)
        dc.l    $0C000C00, $0C000C00, $0C000C00, $00000000
        dc.l    $0C000C00, $0CC00C00, $0C0C0C00, $0C00CC00      // N (index 13)
        dc.l    $0C000C00, $0C000C00, $0C000C00, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000C00, $0C000C00      // O (index 14)
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0CCCC000, $0C000C00, $0C000C00, $0CCCC000      // P (index 15)
        dc.l    $0C000000, $0C000000, $0C000000, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000C00, $0C000C00      // Q (index 16)
        dc.l    $0C0C0C00, $0C00C000, $00CC0C00, $00000000
        dc.l    $0CCCC000, $0C000C00, $0C000C00, $0CCCC000      // R (index 17)
        dc.l    $0C0C0000, $0C00C000, $0C000C00, $00000000
        dc.l    $00CCC000, $0C000C00, $0C000000, $00CCC000      // S (index 18)
        dc.l    $00000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0CCCCC00, $000C0000, $000C0000, $000C0000      // T (index 19)
        dc.l    $000C0000, $000C0000, $000C0000, $00000000
        dc.l    $0C000C00, $0C000C00, $0C000C00, $0C000C00      // U (index 20)
        dc.l    $0C000C00, $0C000C00, $00CCC000, $00000000
        dc.l    $0C000C00, $0C000C00, $0C000C00, $0C000C00      // V (index 21)
        dc.l    $0C000C00, $00C0C000, $000C0000, $00000000
        dc.l    $0C000C00, $0C000C00, $0C000C00, $0C000C00      // W (index 22)
        dc.l    $0C0C0C00, $0CC0CC00, $0C000C00, $00000000
        dc.l    $0C000C00, $0C000C00, $00C0C000, $000C0000      // X (index 23)
        dc.l    $00C0C000, $0C000C00, $0C000C00, $00000000
        dc.l    $0C000C00, $0C000C00, $00C0C000, $000C0000      // Y (index 24)
        dc.l    $000C0000, $000C0000, $000C0000, $00000000
        dc.l    $0CCCCC00, $00000C00, $0000C000, $000C0000      // Z (index 25)
        dc.l    $00C00000, $0C000000, $0CCCCC00, $00000000
    }
}

// -----------------------------------------------
// Per-section sky tint table — referenced by the marker code in Update. CRAM
// colors (BGR, 9-bit). Section_id indexes into this array, so the backdrop
// visibly differs per section. T15 diagnostic only.
// -----------------------------------------------
data OJZ_SectionMarkerColors: [u16; 9] = [
        $000E,          // Sec0 (0,0): bright red
        $00E0,          // Sec1 (1,0): bright green
        $0E00,          // Sec2 (2,0): bright blue
        $00EE,          // Sec3 (0,1): yellow
        $0E0E,          // Sec4 (1,1): magenta
        $0EE0,          // Sec5 (2,1): cyan
        $0EEE,          // Sec6 (0,2): white
        $0888,          // Sec7 (1,2): gray
        $060E,          // Sec8 (2,2): orange
]

// -----------------------------------------------
// PlayerMarkerTile — 4 x 8x8 tiles, all pixels colour 12 (128 bytes). Pal 1
// entry 12 = $00EE = bright yellow. Written to VRAM_TEST_MARKER at level init.
// 2x2 layout matches Map_TestObj_F0 (16x16).
// -----------------------------------------------
data PlayerMarkerTile: [u32; 32] = [
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
        $CCCCCCCC, $CCCCCCCC, $CCCCCCCC, $CCCCCCCC,
]

// -----------------------------------------------
// Test art — two 16x16 colored squares (4 tiles each = 128 bytes each) then the
// ring blob. TestArt is the DMA source; TestArt_End - TestArt = TEST_ART_LEN.
// Owned HERE (objtest-gate, 2026-08-05): the shipped OJZ init DMAs it to
// VRAM_TEST_OBJ and the release debug-fly cheat's marker renders from it, so
// the blob ships in the plain shape; the DEBUG-only object-test scene imports
// the label cross-module for its own re-DMA.
// -----------------------------------------------
// Square 1 — palette 0, color index 1 (solid fill)
pub data TestArt: [u32; 32] = [
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
        $11111111, $11111111, $11111111, $11111111,
]
// Square 2 — palette 0, color index 2
data TestArt_Square2: [u32; 32] = [
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
        $22222222, $22222222, $22222222, $22222222,
]
// Ring art — S3K ring, 4 spin frames × 4 tiles (2×2) = 16 tiles, at
// VRAM_RING_PLACEHOLDER (= VRAM_TEST_OBJ+8). Source: skdisasm Ring.bin
// (Nemesis, 14 tiles): F0 full / F1 narrower / F2 thin-edge (centred) /
// F3 narrower-mirrored, in VDP 2×2 column-major order per frame.
// Rings draw on PALETTE LINE 1, not line 0: RING_ART_ATTR is
// vram_art(VRAM_RING_PLACEHOLDER, 1, 1) (engine/objects/rings.emp) — line 1,
// high priority — and line 1 holds OJZ palette page 0, not the character line.
// The blob's pixels use colour indices 5/6/12/13 only, so it is line 1's
// entries 5/6/12/13 that colour the ring.
// DrawRings picks a frame with base + Ring_Anim_Frame×4.
data TestArt_Ring = RingArt


// ===============================================================================
// THE VERTICAL-AXIS BgAnim BAND — THE FIRST ONE IN ANY ROM THIS PROJECT HAS BUILT —
// plus its horizontal-axis CONTROL over the same art. DEBUG shape only; zero release bytes.
//
// EFFECTS-W1 item 8's engine half has been done since 2026-09-02 and moves no bytes —
// `BgAnim_Update` never knew which way a band travels. What was still open on 2026-09-04
// is smaller and entirely empirical: **no ROM had ever been built containing a band whose
// axis is vertical, and nobody had looked at one.** This module is that ROM's content.
//
// ---- WHY THIS IS A SEPARATE MODULE AND NOT A BAND IN THE ACT ----
// The act's band table is generated by tools/inject_editor_bg.py from the owner's
// authored background document (games/sonic4/data/editor_bg_override.json). Inserting a
// band there means inserting slots at the FRONT of that 110 KB document and renumbering
// all 4,096 of its layout words — rewriting his content blind. tools/forest_bg_gen.py
// already refuses by name to rewrite a document carrying `anims`, and that refusal is
// this repo's own statement that the document is not a tool's to regenerate. So this
// band is authored HERE instead, as debug-tier probe content that touches nothing of his.
// Whether a vertical band goes into the authored act, and how big, stays the owner's
// question (his 2026-08-24 grant permits editing the background for testing, but the
// document is not this lane's to renumber).
//
// ---- WHERE IT LANDS IN VRAM, AND WHY NOT THE ACT'S BAND BASE ----
// `VPROBE_VRAM_DEST` = $A800 = slot 1344 — the BG region's BAND RESERVE.
// games/sonic4/vram.toml pins `bg_region` at slot 1024 for 448 tiles with
// `band_reserve = 128` withheld from the static importer, and the shipped static blob is
// 320 tiles (bg_tiles.bin = 2 + 320*32), so slots 1344..1471 are reserved and NO OTHER
// WRITER TOUCHES THEM. The act's own debug view twins aim at $8000 and therefore repaint
// live canopy tiles; this one deliberately does not, which keeps the owner's picture
// intact and keeps a VRAM witness free of a confound.
//
// ⚠ THE CONSEQUENCE, STATED SO NOBODY READS MORE INTO THIS THAN IT SAYS: no plane cell
// points at slots 1344..1471 today, so installing this view puts a vertically scrolling
// band in VRAM and NOTHING on the screen. That is a LAYOUT fact, not an engine one — the
// missing half is plane cells in row-major order over the band's slots, which is the
// authored document's job (and is the same "slot-order obligation is unchecked" note
// tools/EFFECTS_CONSUMER_CONTRACT.md §1.2 already books). What this module demonstrates
// is that the engine's vertical arm runs end to end into VRAM; what it does NOT
// demonstrate is a picture on a screen.
//
// ---- THE TWO RECORDS ARE A MATCHED PAIR, AND THAT IS THE POINT ----
// Row 3 and row 4 of the view cycle are the SAME art, the SAME driver, the SAME rate and
// the SAME destination. They differ in exactly the two fields that carry the axis:
//
//   arm          col_shift              step_mask                coarse positions
//   vertical     log2(COLS*32) = 6      ROWS*8 - 1 = 31          4
//   horizontal   log2(ROWS*32) = 7      COLS*8 - 1 = 15          2
//
// so a witness can ask the sharp question — does the band move on the axis its record
// DECLARES — rather than the weak one, does it move at all. tools/bganim_vprobe_witness.py
// runs both arms and requires the vertical prediction to hold on row 3 and to FAIL on
// row 4. Without row 4 a green witness would say nothing.
//
// ---- THE GEOMETRY NUMBERS ARE GATED, NOT SYNCHRONISED BY HAND ----
// tools/bganim_vprobe_gen.py derives COLS/ROWS/col_shift/step_mask/tile_count/vram_dest
// and generates the banks from them; tools/test_bganim_vprobe.py reads BOTH this file's
// records and that generator and fails the build's pytest lane on any disagreement.
// This is the same lockstep the generated act table keeps with engine/level/bg_anim.emp.
//
// ---- SHAPE GATING ----
// Every declaration below is sized by `BGANIM_VPROBE_EMIT`, so the plain shape emits
// ZERO bytes — the idiom the act's own view twins use (see the generated
// games/sonic4/data/generated/ojz/act1/bg_anim.emp). It rides in the `ojz_scroll_test`
// section, which sits in the ROM TAIL after the Z80 banks, so its 2,140 debug bytes
// cannot push `Art_Sonic` toward the `dac_banks` anchor and cannot spend any of the
// act's ruled 12,288 B `ojz_bg_anim` authoring budget.
// ===============================================================================

// ---- WHY THIS LIVES AT THE FOOT OF THIS FILE AND NOT IN ITS OWN MODULE ----
// It was written as one (`games/sonic4/test/bganim_vprobe.emp`, module
// `games.sonic4.bganim_vprobe in ojz_scroll_test`) and that build was REFUSED, twice,
// under both module spellings tried:
//
//   [layout.undeclared-alignment] section `ojz_scroll_test`
//     (head label `BgAnim_VProbe_Banks`) has NO declared alignment in
//     `sigil_harness::section_align::DECLARED`
//
// A section's head label is its LOWEST-OFFSET label (sigil `native.rs::head_label`) and
// `section_align::DECLARED` is keyed BY THAT LABEL (`GameState_OJZScroll_Init`, row at
// `section_align.rs:163`). A second module joining the section landed its data at offset
// 0 regardless of module or file name, which renames the section's head and so takes it
// out of a table that lives in the frozen assembler — not this repo's to edit. Inside a
// single module, emission follows DECLARATION order (the four `data` items above are
// already proof: they sit after every proc and the head label is still the entry point),
// so the foot of this file is the one place this art can live without moving a section
// head. The failure mode is loud, which is why the arrangement is safe to rely on.

const BGANIM_VPROBE_EMIT = if DEBUG == 1 { 1 } else { 0 }

// The bank blob: 8 phases x 8 tiles x 32 B = 2,048 B, each phase the previous one rolled
// UP by one pixel within the band's 32 px height, every phase serialised in ROW-MAJOR
// slot order. Generated by tools/bganim_vprobe_gen.py — see that file for why bank k
// must roll toward DECREASING y (it has to carry the same sign as the coarse rotate).
const _vprobe_banks = embed("games/sonic4/data/generated/bganim_vprobe_banks.bin")
pub data BgAnim_VProbe_Banks = if DEBUG == 1 { _vprobe_banks } else { Data.empty }

// ---- row 3 of the view cycle: the VERTICAL band ----
// driver 2 = Logic_Tick low word (lag-immune, and the one driver a headless witness can
// predict without touching the player); rate_shift 3 = 1 px per 8 ticks, which gives a
// witness an 8-frame plateau to sample inside and a reviewer ~7.5 px/s to look at.
pub data BgAnim_View_Vert: [u16; BGANIM_VPROBE_EMIT] = if DEBUG == 1 { [1] } else { [] }
data _VProbe_V_hdr: [u16; BGANIM_VPROBE_EMIT * 6] = if DEBUG == 1 { [2, 3, 31, 6, 8, $A800] } else { [] }
data _VProbe_V_banks: [*u8; BGANIM_VPROBE_EMIT * 8] = if DEBUG == 1 {
    [extern("BgAnim_VProbe_Banks") + 0,   extern("BgAnim_VProbe_Banks") + 256,
     extern("BgAnim_VProbe_Banks") + 512, extern("BgAnim_VProbe_Banks") + 768,
     extern("BgAnim_VProbe_Banks") + 1024, extern("BgAnim_VProbe_Banks") + 1280,
     extern("BgAnim_VProbe_Banks") + 1536, extern("BgAnim_VProbe_Banks") + 1792]
} else { [] }

// ---- row 4 of the view cycle: the HORIZONTAL-AXIS CONTROL over the same art ----
// Not a band anyone would author — its banks are rolled on the wrong axis for it and its
// slots are in the wrong order for it. It exists so the witness's vertical predicate has
// something it must REFUSE. Same art, same driver, same rate, same destination; only
// `step_mask` and `col_shift` change.
pub data BgAnim_View_VertCtl: [u16; BGANIM_VPROBE_EMIT] = if DEBUG == 1 { [1] } else { [] }
data _VProbe_H_hdr: [u16; BGANIM_VPROBE_EMIT * 6] = if DEBUG == 1 { [2, 3, 15, 7, 8, $A800] } else { [] }
data _VProbe_H_banks: [*u8; BGANIM_VPROBE_EMIT * 8] = if DEBUG == 1 {
    [extern("BgAnim_VProbe_Banks") + 0,   extern("BgAnim_VProbe_Banks") + 256,
     extern("BgAnim_VProbe_Banks") + 512, extern("BgAnim_VProbe_Banks") + 768,
     extern("BgAnim_VProbe_Banks") + 1024, extern("BgAnim_VProbe_Banks") + 1280,
     extern("BgAnim_VProbe_Banks") + 1536, extern("BgAnim_VProbe_Banks") + 1792]
} else { [] }
