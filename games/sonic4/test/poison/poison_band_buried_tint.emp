// games/sonic4/test/poison/poison_band_buried_tint.emp — POISON (see README).
//
// TARGETS: C-A, the equal-span-partner composition guard (spec §4.2).
// EXPECTED FRAGMENT: "would bury"
//
// A band whose OFF edge would bury an unrelated earlier tint. The restore at line
// 140 writes BASE over CRAM $48..$4D. Two earlier fires touch that span:
//
//   line 100  stream_cram($48, 3 words)  -> $48..$4D  — EQUAL span: the band's own
//                                                       ON op, the legal partner
//   line 120  stream_cram($4A, 2 words)  -> $4A..$4D  — intersects, NOT equal
//
// The second is the defect. From line 140 down its two colours are replaced by the
// frame's base palette, so an effect the author scheduled for the bottom of the
// screen silently stops at 140 — and nothing at runtime can report that, because
// the restore is doing exactly what a restore does.
//
// THE UNEQUAL SPAN IS DELIBERATE and the poison does not work without it. An
// intersecting op with the SAME span is a partner candidate, so a second $48-span
// 3-word fire would trip the partners == 1 count instead and never reach the
// sentence this poison is for. $4A..$4D intersects $48..$4D and cannot be anyone's
// equal-span partner, which is exactly the shape the guard is written against.
//
// NO IMPORTS — see poison_two_restores.emp's note.
module games.sonic4.test.poison.poison_band_buried_tint

const POISON_BAND_BURIED_TINT = [
    fire(100, [stream_cram($48, [$0EEE, $0AAA, $0666])]),
    fire(120, [stream_cram($4A, [$0E00, $0A00])]),
    fire(140, [pal_restore($48, 3)]),
]

ensure(raster_program(POISON_BAND_BURIED_TINT).len > 0,
       "poison_band_buried_tint: raster_program returned nothing — this poison no longer reaches the guard it targets")
