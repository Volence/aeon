// games/sonic4/test/poison/poison_patchable_band_fire.emp — POISON (see README).
//
// TARGETS: rule 6 half 1 / claim E-A — the restore's carrying fire must be static
//          (spec §4.2).
// EXPECTED FRAGMENT: "must be static"
//
// THE SWEEP-5 K1 WITNESS. A legal-looking band — a static ON op at line 50 and its
// equal-span restore — with the restore's fire marked `patchable`. Every span check
// passes: the partner's span is $48..$4D and so is the restore's.
//
// What it spells is a band whose BOTTOM edge moves, and local removal makes that a
// silent failure rather than a clamped one. Past band_hi, Raster_BuildSchedule does
// not emit the record at all (engine/effects/raster.emp, .suppress) — so the ON op
// at line 50 still runs and the restore simply never does, and the tint runs to the
// bottom of the screen with nothing to turn it off. A moving-bottom band is spelled
// by moving the ON op instead, which keeps the OFF edge where the restore can always
// reach it.
//
// NO IMPORTS — see poison_two_restores.emp's note.
module games.sonic4.test.poison.poison_patchable_band_fire

const POISON_PATCHABLE_BAND_FIRE = compose([
    [ fire(50, [stream_cram($48, [$0EEE, $0AAA, $0666])]) ],
    patchable([ fire(100, [pal_restore($48, 3)]) ], ch: 0, lo: 100, hi: 150),
])

ensure(raster_program(POISON_PATCHABLE_BAND_FIRE).len > 0,
       "poison_patchable_band_fire: raster_program returned nothing — this poison no longer reaches the guard it targets")
